@page "/purchase-orders"
@using System.Net.Http.Json
@inject HttpClient Http

<div class="container-fluid mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="text-primary m-0 mb-1">📋 طلب احتياج خامات / أمر توريد داخلي</h3>
            <span class="text-muted">تسجيل الأصناف والكميات المطلوبة لتحويلها لقسم المشتريات للتسعير وتحديد الموردين والمخزن</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") fw-bold shadow-sm">
            @(isSuccess ? "✅ " : "❌ ") @feedbackMessage
        </div>
    }

    <!-- بيانات الطلب الأساسية -->
    <div class="card shadow-sm border-0 border-top border-primary border-4 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="m-0 fw-bold text-dark">📄 بيانات الطلب</h5>
        </div>
        <div class="card-body bg-light">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">رقم الطلب / الأمر</label>
                    <input class="form-control fw-bold" @bind="newPo.OrderNumber" placeholder="توليد تلقائي (مثال: PO-2026-001)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">تاريخ الطلب</label>
                    <input type="date" class="form-control fw-bold" @bind="newPo.OrderDate" />
                </div>
            </div>
        </div>
    </div>

    <!-- بنود الأصناف المطلوبة -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="m-0 fw-bold text-secondary">📦 الأصناف والكميات المطلوبة</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end mb-4 bg-light p-3 rounded">
                <div class="col-md-7">
                    <label class="form-label fw-bold small">اختر الخامة / الصنف المطلوب *</label>
                    <select class="form-select border-primary fw-bold" @bind="selectedItemId">
                        <option value="0">-- اختر الصنف من الدليل --</option>
                        @foreach (var item in items)
                        {
                            <option value="@item.Id">[@item.ItemCode] - @item.ItemName (@item.Unit)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small">الكمية المطلوبة *</label>
                    <input type="number" step="0.01" class="form-control fw-bold text-center border-primary" @bind="currentQuantity" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-primary fw-bold w-100 py-2" @onclick="AddLineToOrder">
                        ➕ إضافة للطلب
                    </button>
                </div>
            </div>

            <!-- جدول بنود الطلب -->
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 15%;">كود الصنف</th>
                            <th class="text-start ps-3" style="width: 50%;">اسم الخامة / الصنف</th>
                            <th style="width: 15%;">الوحدة</th>
                            <th style="width: 15%;">الكمية المطلوبة</th>
                            <th style="width: 5%;">إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (newPo.Lines.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-muted py-4">لم يتم إضافة أصناف حتى الآن. حدد الخامة والكمية أعلاه واضغط (إضافة للطلب).</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var line in newPo.Lines)
                            {
                                var item = items.FirstOrDefault(i => i.Id == line.ItemId);
                                <tr>
                                    <td><span class="badge bg-light text-dark border">@(item?.ItemCode ?? "N/A")</span></td>
                                    <td class="text-start ps-3 fw-bold text-primary">@(item?.ItemName ?? "خامة")</td>
                                    <td><span class="badge bg-secondary">@(item?.Unit ?? "-")</span></td>
                                    <td style="width: 160px;">
                                        <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold" @bind="line.Quantity" />
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveLine(line)">🗑️</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-success fw-bold px-5 py-2 shadow" @onclick="SavePurchaseOrder" disabled="@(newPo.Lines.Count == 0 || isSubmitting)">
                    @(isSubmitting ? "⏳ جاري الإرسال..." : "🚀 إرسال الطلب إلى إدارة المشتريات والتسعير")
                </button>
            </div>
        </div>
    </div>

    <!-- سجل الطلبات الصادرة -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-dark">📜 سجل طلبات الاحتياج الصادرة</h6>
            <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="LoadOrders">🔄 تحديث القائمة</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>رقم الطلب</th>
                            <th>تاريخ الإصدار</th>
                            <th>عدد البنود</th>
                            <th>حالة الطلب لدى المشتريات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ordersList == null)
                        {
                            <tr><td colspan="4" class="py-4">⏳ جاري التحميل...</td></tr>
                        }
                        else if (!ordersList.Any())
                        {
                            <tr><td colspan="4" class="text-muted py-4">لا توجد طلبات مسجلة حتى الآن.</td></tr>
                        }
                        else
                        {
                            @foreach (var o in ordersList)
                            {
                                <tr>
                                    <td class="fw-bold">@o.OrderNumber</td>
                                    <td>@o.OrderDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-secondary">@(o.Lines?.Count ?? 1) بنود</span></td>
                                    <td>
                                        @if (o.Status == "Pending_Procurement")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">⏳ بانتظار تسعير وتحديد الموردين</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">@o.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ItemLookupDto> items = new();
    private List<PurchaseOrderDto>? ordersList;

    private PurchaseOrderCreateDto newPo = new() { OrderDate = DateTime.Today, Status = "Pending_Procurement", SupplierId = 0, WarehouseId = 1 };

    private long selectedItemId = 0;
    private decimal currentQuantity = 1;

    private string feedbackMessage = "";
    private bool isSuccess = false;
    private bool isSubmitting = false;

    private string apiBase = "https://localhost:7273/api";

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadOrders();
    }

    private async Task LoadLookups()
    {
        try
        {
            var itmList = await Http.GetFromJsonAsync<List<ItemLookupDto>>($"{apiBase}/Items");
            if (itmList != null) items = itmList;
        }
        catch { }
    }

    private async Task LoadOrders()
    {
        try
        {
            ordersList = await Http.GetFromJsonAsync<List<PurchaseOrderDto>>($"{apiBase}/PurchaseOrders");
        }
        catch { }
    }

    private void AddLineToOrder()
    {
        if (selectedItemId <= 0 || currentQuantity <= 0)
        {
            isSuccess = false;
            feedbackMessage = "يرجى اختيار الصنف وتحديد كمية صالحة.";
            return;
        }

        var existing = newPo.Lines.FirstOrDefault(l => l.ItemId == selectedItemId);
        if (existing != null)
        {
            existing.Quantity += currentQuantity;
        }
        else
        {
            newPo.Lines.Add(new PurchaseOrderLineCreateDto
            {
                ItemId = selectedItemId,
                Quantity = currentQuantity,
                UnitPrice = 0
            });
        }

        selectedItemId = 0;
        currentQuantity = 1;
        feedbackMessage = "";
    }

    private void RemoveLine(PurchaseOrderLineCreateDto line)
    {
        newPo.Lines.Remove(line);
    }

    private async Task SavePurchaseOrder()
    {
        feedbackMessage = "";

        if (newPo.Lines.Count == 0)
        {
            isSuccess = false;
            feedbackMessage = "يرجى إضافة الأصناف المطلوبة أولاً.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPo.OrderNumber))
        {
            newPo.OrderNumber = $"PO-{DateTime.Now:yyyyMMdd}-{new Random().Next(100, 999)}";
        }

        isSubmitting = true;
        try
        {
            newPo.CompanyId = 1;
            newPo.SupplierId = 0; // إرسال 0 كرقم Int64 صريح لتفادي خطأ تحويل JSON
            newPo.WarehouseId = 1;
            newPo.Status = "Pending_Procurement";

            var response = await Http.PostAsJsonAsync($"{apiBase}/PurchaseOrders", newPo);

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                feedbackMessage = "تم إصدار وإرسال الطلب بنجاح إلى إدارة المشتريات والتسعير!";
                newPo = new PurchaseOrderCreateDto { OrderDate = DateTime.Today, Status = "Pending_Procurement", SupplierId = 0, WarehouseId = 1 };
                await LoadOrders();
            }
            else
            {
                isSuccess = false;
                feedbackMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            feedbackMessage = "خطأ في الاتصال: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class PurchaseOrderDto
    {
        public long Id { get; set; }
        public string OrderNumber { get; set; } = string.Empty;
        public DateTime OrderDate { get; set; }
        public string Status { get; set; } = string.Empty;
        public List<PurchaseOrderDetailDto>? Lines { get; set; }
    }

    public class PurchaseOrderDetailDto
    {
        public long Id { get; set; }
        public long ItemId { get; set; }
        public decimal Quantity { get; set; }
    }

    public class PurchaseOrderCreateDto
    {
        public long CompanyId { get; set; } = 1;
        public long SupplierId { get; set; } = 0;
        public long WarehouseId { get; set; } = 1;
        public string OrderNumber { get; set; } = string.Empty;
        public DateTime OrderDate { get; set; } = DateTime.Today;
        public string Status { get; set; } = "Pending_Procurement";
        public List<PurchaseOrderLineCreateDto> Lines { get; set; } = new();
    }

    public class PurchaseOrderLineCreateDto
    {
        public long ItemId { get; set; }
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; } = 0;
    }

    public class ItemLookupDto
    {
        public long Id { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
    }
}