@page "/purchase-orders"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة وأزرار التصدير والاستيراد -->
    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border-start border-primary border-4">
        <div>
            <h4 class="mb-1 text-dark fw-bold">📋 طلب احتياج خامات / أمر توريد داخلي</h4>
            <small class="text-muted">تسجيل الأصناف والكميات المطلوبة وملاحظاتها لتحويلها لقسم المشتريات للتسعير وتحديد الموردين</small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportOrdersToExcelAsync">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير سجل الطلبات
            </button>
            <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadItemsTemplateAsync">
                <i class="bi bi-download me-1"></i> تحميل قالب بنود الطلب
            </button>
            <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد بنود من إكسيل
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadOrders">
                <i class="bi bi-arrow-clockwise"></i> تحديث
            </button>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 fw-bold shadow-sm" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i> @feedbackMessage
            <button type="button" class="btn-close py-2" @onclick="() => feedbackMessage = null"></button>
        </div>
    }

    <!-- بيانات الطلب الأساسية -->
    <div class="card shadow-sm border-0 border-top border-primary border-3 mb-3 bg-white">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0 fw-bold text-primary">📄 بيانات الطلب</h6>
        </div>
        <div class="card-body p-3 bg-light">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">رقم الطلب / الأمر</label>
                    <input class="form-control form-control-sm fw-bold font-monospace" @bind="newPo.OrderNumber" placeholder="توليد تلقائي (مثال: PO-2026-001)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">تاريخ الطلب</label>
                    <input type="date" class="form-control form-control-sm fw-bold font-monospace" @bind="newPo.OrderDate" />
                </div>
            </div>
        </div>
    </div>

    <!-- بنود الأصناف المطلوبة مع فلتر نوع الخامة وخانة الملاحظات -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-secondary">📦 الأصناف والكميات المطلوبة (@newPo.Lines.Count بنود مسجلة)</h6>
            <button type="button" class="btn btn-outline-success btn-sm py-0 px-2 fw-bold" @onclick="OpenImportModal">
                <i class="bi bi-file-earmark-excel me-1"></i> رفع شيت كميات
            </button>
        </div>
        <div class="card-body p-3">
            
            <!-- شريط اختيار وتصفية الخامة وإضافة الملاحظات -->
            <div class="row g-2 align-items-end mb-3 bg-light p-3 rounded border">
                
                <!-- 1. فلتر نوعية الخامة المطلوبة -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-secondary">🏷️ نوعية الخامة / الصنف</label>
                    <select class="form-select form-select-sm border-primary fw-bold" @bind="selectedItemTypeFilter">
                        <option value="all">-- كل الأنواع والمواد --</option>
                        <option value="خامات">🌾 خامات ومستلزمات</option>
                        <option value="مواد تعبئة وتغليف">📦 مواد تعبئة وتغليف</option>
                        <option value="نصف مصنع">🥣 نصف مصنع / خلطات</option>
                        <option value="أصول / حاويات تداول">🛒 أصول وحاويات تداول</option>
                        <option value="منتج تام">🍰 منتج تام</option>
                    </select>
                </div>

                <!-- 2. قائمة اختيار الصنف المفلترة -->
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-secondary">اختر الخامة / الصنف المطلوب *</label>
                    <select class="form-select form-select-sm border-primary fw-bold" @bind="selectedItemId">
                        <option value="0">-- اختر الصنف (@FilteredSelectableItems.Count() صنف متاح) --</option>
                        @foreach (var item in FilteredSelectableItems)
                        {
                            <option value="@item.Id">[@item.ItemCode] - @item.ItemName (@item.Unit) - @item.ItemType</option>
                        }
                    </select>
                </div>

                <!-- 3. الكمية المطلوبة -->
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-secondary">الكمية المطلوبة *</label>
                    <input type="number" step="0.01" class="form-control form-control-sm fw-bold text-center border-primary font-monospace" @bind="currentQuantity" />
                </div>

                <!-- 4. ملاحظات الصنف وزر الإضافة -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-secondary">ملاحظات على البند (اختياري)</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control border-primary" placeholder="مثال: توريد عاجل / مواصفات خاصة..." 
                               @bind="currentLineNotes" />
                        <button type="button" class="btn btn-primary fw-bold px-3" @onclick="AddLineToOrder">
                            ➕ إضافة
                        </button>
                    </div>
                </div>

            </div>

            <!-- جدول بنود الطلب متضمناً خانة الملاحظات -->
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle text-center mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 12%;">كود الصنف</th>
                            <th class="text-start ps-3" style="width: 25%;">اسم الخامة / الصنف</th>
                            <th style="width: 13%;">نوع الصنف</th>
                            <th style="width: 8%;">الوحدة</th>
                            <th style="width: 12%;">الكمية المطلوبة</th>
                            <th class="text-start ps-3" style="width: 23%;">ملاحظات البند</th>
                            <th style="width: 7%;">إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (newPo.Lines.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-muted py-4">لم يتم إضافة أصناف حتى الآن. حدد الخامة والكمية أعلاه واضغط (إضافة) أو استورد من ملف إكسيل.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var line in newPo.Lines)
                            {
                                var item = items.FirstOrDefault(i => i.Id == line.ItemId);
                                <tr>
                                    <td><span class="badge bg-light text-dark border font-monospace">@(item?.ItemCode ?? "N/A")</span></td>
                                    <td class="text-start ps-3 fw-bold text-primary">@(item?.ItemName ?? "خامة")</td>
                                    <td>
                                        <span class="badge @GetTypeBadgeClass(item?.ItemType)">
                                            @(item?.ItemType ?? "خامات")
                                        </span>
                                    </td>
                                    <td><span class="badge bg-secondary">@(item?.Unit ?? "-")</span></td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold font-monospace" @bind="line.Quantity" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm text-start" placeholder="ملاحظات البند..." @bind="line.Notes" />
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm py-0 px-2" @onclick="() => RemoveLine(line)">🗑️</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                <span class="small fw-bold text-muted">إجمالي البنود: (@newPo.Lines.Count) خامة | إجمالي الكميات: (@newPo.Lines.Sum(l => l.Quantity).ToString("N2"))</span>
                <button class="btn btn-success fw-bold px-4 py-2 shadow-sm" @onclick="SavePurchaseOrder" disabled="@(newPo.Lines.Count == 0 || isSubmitting)">
                    @(isSubmitting ? "⏳ جاري الإرسال..." : "🚀 إرسال الطلب إلى إدارة المشتريات والتسعير")
                </button>
            </div>
        </div>
    </div>

    <!-- سجل الطلبات الصادرة -->
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold small">📜 سجل طلبات الاحتياج الصادرة</h6>
            <span class="badge bg-primary">المعروض: @(ordersList?.Count ?? 0) طلب</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle text-center small">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%;">رقم الطلب</th>
                            <th style="width: 20%;">تاريخ الإصدار</th>
                            <th style="width: 20%;">عدد البنود</th>
                            <th style="width: 35%;">حالة الطلب لدى المشتريات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ordersList == null)
                        {
                            <tr><td colspan="4" class="py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري التحميل...</td></tr>
                        }
                        else if (!ordersList.Any())
                        {
                            <tr><td colspan="4" class="text-muted py-4">لا توجد طلبات مسجلة حتى الآن.</td></tr>
                        }
                        else
                        {
                            @foreach (var o in ordersList)
                            {
                                <tr @key="o.Id">
                                    <td class="fw-bold font-monospace text-primary">@o.OrderNumber</td>
                                    <td class="font-monospace text-muted">@o.OrderDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-light text-dark border">@(o.Lines?.Count ?? 1) بنود</span></td>
                                    <td>
                                        @if (o.Status == "Pending_Procurement")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-1">⏳ بانتظار تسعير وتحديد الموردين</span>
                                        }
                                        else if (o.Status == "Partially_Received")
                                        {
                                            <span class="badge bg-info text-dark px-3 py-1">📦 مستلم جزئياً</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-1">@o.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- نافذة استيراد بنود الخامات من إكسيل مع قراءة الملاحظات -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد بنود طلب الاحتياج من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> 
                        يتعرف النظام تلقائياً على أعمدة الكود، اسم الخامة، الكمية، والملاحظات ويقوم بمطابقتها مباشرة مع دليل الأصناف.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewLines.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة بنود الخامات المقروءة من الملف (@importedPreviewLines.Count بند):</span>
                            <span class="badge bg-success">جاهز للإضافة</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>كود الخامة</th>
                                        <th class="text-start">اسم الخامة المقروءة</th>
                                        <th>الخامة المطابقة بالدليل</th>
                                        <th>النوع</th>
                                        <th>الكمية المطلوبة</th>
                                        <th>الملاحظات المقروءة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewLines)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@row.ItemCode</td>
                                            <td class="text-start fw-bold">@row.RawItemName</td>
                                            <td>
                                                @if (row.MatchedItem != null)
                                                {
                                                    <span class="text-success fw-bold">✔ @row.MatchedItem.ItemName (@row.MatchedItem.Unit)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger fw-bold">✖ غير مسجل بالدليل</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @GetTypeBadgeClass(row.MatchedItem?.ItemType)">
                                                    @(row.MatchedItem?.ItemType ?? "-")
                                                </span>
                                            </td>
                                            <td class="font-monospace fw-bold text-primary">@row.Quantity.ToString("N2")</td>
                                            <td class="text-muted text-start ps-2">@(string.IsNullOrEmpty(row.Notes) ? "-" : row.Notes)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@(!importedPreviewLines.Any(l => l.MatchedItem != null))" 
                            @onclick="ApplyImportedLinesToOrder">
                        <i class="bi bi-check-circle"></i> إضافة البنود المطابقة إلى مسودة الطلب (@importedPreviewLines.Count(l => l.MatchedItem != null))
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private List<ItemLookupDto> items = new();
    private List<PurchaseOrderDto>? ordersList;

    private PurchaseOrderCreateDto newPo = new() { OrderDate = DateTime.Today, Status = "Pending_Procurement", SupplierId = 0, WarehouseId = 1 };

    private string selectedItemTypeFilter = "all";
    private long selectedItemId = 0;
    private decimal currentQuantity = 1;
    private string currentLineNotes = string.Empty;

    private string? feedbackMessage;
    private bool isSuccess = false;
    private bool isSubmitting = false;
    private bool isImportModalOpen = false;

    public class OrderImportLinePreview
    {
        public string ItemCode { get; set; } = string.Empty;
        public string RawItemName { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public string Notes { get; set; } = string.Empty;
        public ItemLookupDto? MatchedItem { get; set; }
    }

    private List<OrderImportLinePreview> importedPreviewLines = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadOrders();
    }

    private async Task LoadLookups()
    {
        try
        {
            var itmList = await Http.GetFromJsonAsync<List<ItemLookupDto>>("api/items");
            if (itmList != null) items = itmList;
        }
        catch { }
    }

    private async Task LoadOrders()
    {
        try
        {
            ordersList = await Http.GetFromJsonAsync<List<PurchaseOrderDto>>("api/purchaseorders");
        }
        catch { }
    }

    private IEnumerable<ItemLookupDto> FilteredSelectableItems =>
        selectedItemTypeFilter == "all"
            ? items
            : items.Where(i => i.ItemType.Equals(selectedItemTypeFilter, StringComparison.OrdinalIgnoreCase) ||
                               i.ItemType.Contains(selectedItemTypeFilter, StringComparison.OrdinalIgnoreCase));

    private string GetTypeBadgeClass(string? type) => type switch
    {
        "خامات" => "bg-success",
        "مواد تعبئة وتغليف" => "bg-info text-dark",
        "نصف مصنع" => "bg-warning text-dark",
        "أصول / حاويات تداول" => "bg-secondary",
        "منتج تام" => "bg-primary",
        _ => "bg-dark"
    };

    private void AddLineToOrder()
    {
        if (selectedItemId <= 0 || currentQuantity <= 0)
        {
            isSuccess = false;
            feedbackMessage = "يرجى اختيار الصنف وتحديد كمية صالحة.";
            return;
        }

        var existing = newPo.Lines.FirstOrDefault(l => l.ItemId == selectedItemId);
        if (existing != null)
        {
            existing.Quantity += currentQuantity;
            if (!string.IsNullOrWhiteSpace(currentLineNotes))
            {
                existing.Notes = string.IsNullOrWhiteSpace(existing.Notes) 
                    ? currentLineNotes.Trim() 
                    : $"{existing.Notes} | {currentLineNotes.Trim()}";
            }
        }
        else
        {
            newPo.Lines.Add(new PurchaseOrderLineCreateDto
            {
                ItemId = selectedItemId,
                Quantity = currentQuantity,
                UnitPrice = 0,
                Notes = currentLineNotes.Trim()
            });
        }

        selectedItemId = 0;
        currentQuantity = 1;
        currentLineNotes = string.Empty;
        feedbackMessage = null;
    }

    private void RemoveLine(PurchaseOrderLineCreateDto line) => newPo.Lines.Remove(line);

    private async Task SavePurchaseOrder()
    {
        feedbackMessage = null;
        if (newPo.Lines.Count == 0)
        {
            isSuccess = false;
            feedbackMessage = "يرجى إضافة الأصناف المطلوبة أولاً.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPo.OrderNumber))
        {
            newPo.OrderNumber = $"PO-{DateTime.Now:yyyyMMdd}-{new Random().Next(100, 999)}";
        }

        isSubmitting = true;
        try
        {
            newPo.CompanyId = 1;
            newPo.SupplierId = 0;
            newPo.WarehouseId = 1;
            newPo.Status = "Pending_Procurement";

            var response = await Http.PostAsJsonAsync("api/purchaseorders", newPo);
            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                feedbackMessage = "تم إصدار وإرسال الطلب بنجاح إلى إدارة المشتريات والتسعير!";
                newPo = new PurchaseOrderCreateDto { OrderDate = DateTime.Today, Status = "Pending_Procurement", SupplierId = 0, WarehouseId = 1 };
                await LoadOrders();
            }
            else
            {
                isSuccess = false;
                feedbackMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            feedbackMessage = "خطأ في الاتصال: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ExportOrdersToExcelAsync()
    {
        if (ordersList == null || !ordersList.Any()) return;
        var sb = new StringBuilder();
        sb.AppendLine("رقم_الطلب,تاريخ_الإصدار,عدد_البنود,حالة_الطلب");
        foreach (var o in ordersList)
        {
            sb.AppendLine($"{o.OrderNumber},{o.OrderDate:yyyy-MM-dd},{o.Lines?.Count ?? 1},{o.Status}");
        }
        await TriggerBrowserDownload($"سجل_الطلبات_{DateTime.Now:yyyyMMdd}.csv", sb.ToString());
    }

    private async Task DownloadItemsTemplateAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine("كود_الخامة,اسم_الخامة,نوع_الخامة,الكمية_المطلوبة,الملاحظات");
        sb.AppendLine("101001,سكر أبيض ناعم,خامات,500,درجة نقاء أولى لمصنع الحلويات");
        sb.AppendLine("501001,كرتونة شحن وتوصيل,مواد تعبئة وتغليف,1000,مقاس 30*30 مع طباعة الشعار");
        await TriggerBrowserDownload("قالب_بنود_طلب_الاحتياج_أبو_عادل.csv", sb.ToString());
    }

    private async Task TriggerBrowserDownload(string fileName, string content)
    {
        var utf8WithBom = "\uFEFF" + content;
        var jsCommand = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", jsCommand);
    }

    private void OpenImportModal()
    {
        importedPreviewLines.Clear();
        isImportModalOpen = true;
    }

    private void CloseImportModal()
    {
        isImportModalOpen = false;
        importedPreviewLines.Clear();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewLines.Clear();
        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1) return;

            var headerCols = lines[0].Split(',');
            int codeIdx = 0, nameIdx = 1, qtyIdx = 2, notesIdx = -1;

            for (int i = 0; i < headerCols.Length; i++)
            {
                var h = headerCols[i].Trim().ToLower();
                if (h.Contains("كود")) codeIdx = i;
                else if (h.Contains("اسم")) nameIdx = i;
                else if (h.Contains("كمي")) qtyIdx = i;
                else if (h.Contains("ملاحظ")) notesIdx = i;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = line.Split(',');
                if (cols.Length >= 2)
                {
                    string code = codeIdx < cols.Length ? cols[codeIdx].Trim() : "";
                    string name = nameIdx < cols.Length ? cols[nameIdx].Trim() : "";
                    decimal.TryParse(qtyIdx < cols.Length ? cols[qtyIdx].Trim() : "1", out var qty);
                    if (qty <= 0) qty = 1;

                    string notes = (notesIdx != -1 && notesIdx < cols.Length) ? cols[notesIdx].Trim() : "";

                    var matched = items.FirstOrDefault(it => 
                        (!string.IsNullOrEmpty(code) && it.ItemCode.Trim().Equals(code, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(name) && it.ItemName.Trim().Contains(name, StringComparison.OrdinalIgnoreCase)));

                    importedPreviewLines.Add(new OrderImportLinePreview
                    {
                        ItemCode = code,
                        RawItemName = !string.IsNullOrEmpty(name) ? name : (matched?.ItemName ?? code),
                        Quantity = qty,
                        Notes = notes,
                        MatchedItem = matched
                    });
                }
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"فشل قراءة الملف: {ex.Message}";
        }
    }

    private void ApplyImportedLinesToOrder()
    {
        int added = 0;
        foreach (var preview in importedPreviewLines.Where(l => l.MatchedItem != null))
        {
            var existing = newPo.Lines.FirstOrDefault(l => l.ItemId == preview.MatchedItem!.Id);
            if (existing != null)
            {
                existing.Quantity += preview.Quantity;
                if (!string.IsNullOrWhiteSpace(preview.Notes))
                {
                    existing.Notes = string.IsNullOrWhiteSpace(existing.Notes) 
                        ? preview.Notes 
                        : $"{existing.Notes} | {preview.Notes}";
                }
            }
            else
            {
                newPo.Lines.Add(new PurchaseOrderLineCreateDto
                {
                    ItemId = preview.MatchedItem!.Id,
                    Quantity = preview.Quantity,
                    UnitPrice = 0,
                    Notes = preview.Notes
                });
            }
            added++;
        }

        isSuccess = true;
        feedbackMessage = $"تم إدراج ({added}) خامة بنجاح مع ملاحظاتها من ملف الإكسيل إلى مسودة الطلب الحالية!";
        CloseImportModal();
    }

