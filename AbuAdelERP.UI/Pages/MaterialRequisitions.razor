            feedbackMessage = "لا توجد بيانات مطابقة لتصديرها.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("رقم_الطلب,تاريخ_الطلب,الصالة,المشرف,كود_الخامة,اسم_الخامة,الوحدة,الكمية_المطلوبة,المنصرف,رقم_اللوط,تاريخ_الصلاحية,المستلم_بالصالة,الهالك_العجز,حالة_النزاع,سبب_الخلاف,قرار_التسوية,رصيد_الصالة_قبل_الطلب,رصيد_الصالة_بعد_الاعتماد,الرصيد_الفعلي_الحالي_بالصالة");

            foreach (var r in auditRows)
            {
                var expDate = r.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-";
                var discReason = (r.DiscrepancyReason ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");
                var resNotes = (r.ResolutionNotes ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");

                sb.AppendLine($"{EscapeCsv(r.RequisitionNumber)},{r.RequestDate:yyyy-MM-dd HH:mm},{EscapeCsv(r.DepartmentName)},{EscapeCsv(r.RequestedBy)},{EscapeCsv(r.ItemCode)},{EscapeCsv(r.ItemName)},{EscapeCsv(r.Unit)},{r.RequestedQty:F2},{r.DispatchedQty:F2},{EscapeCsv(r.BatchNumber)},{expDate},{r.FinalApprovedQty:F2},{r.ScrapOrLossQty:F2},{EscapeCsv(r.DisputeStatusTitle)},{EscapeCsv(discReason)},{EscapeCsv(resNotes)},{r.FloorStockBefore:F2},{r.FloorStockAfter:F2},{r.CurrentFloorStock:F2}");
            }

            var fileName = $"تقرير_الأثر_الرقابي_لدورة_الخامات_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            feedbackMessage = $"✅ تم تصدير بيانات ({auditRows.Count}) حركة بنجاح.";
        }
        catch (Exception ex)
        {
            feedbackMessage = $"❌ فشل التصدير: {ex.Message}";
        }
    }

