@page "/material-requisitions"
@page "/material-requisition"
@using AbuAdelERP.UI.Models
@using AbuAdelERP.UI.Services
@using System.Net.Http.Json
@using System.Text
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS
@inject AppState State

<PageTitle>طلب وصرف خامات الصالات (Floor Stock Handshake) - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة التنفيذي -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-warning">🥐 طلب وصرف واستلام خامات الصالة الإنتاجية</h4>
                    <span class="badge bg-warning text-dark px-2 py-1 small fw-bold">Floor Stock Handshake & Traceability</span>
                </div>
                <small class="text-light text-opacity-75">
                    دورة تسليم مغلقة ومحكومة بالهوية: صرف خامات من المستودع الرئيسي بنظام FEFO، استلام ومطابقة الصالات، وتقارير تتبع الأثر المخزني لحظياً.
                </small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportRequisitionsToExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير سجل الطلبات (CSV)
                </button>
                <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                    <i class="bi bi-download me-1"></i> تحميل قالب الطلب
                </button>
                @if (State.HasAnyPermission("Requisition.Create", "Production.OperationsHub"))
                {
                    <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد من إكسيل
                    </button>
                }
                <button class="btn btn-outline-light btn-sm fw-bold shadow-sm" @onclick="LoadRequisitions">
                    🔄 تحديث
                </button>
            </div>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert alert-info border-0 shadow-sm alert-dismissible fade show py-2 mb-3 fw-bold" role="alert">
            @feedbackMessage
            <button type="button" class="btn-close py-2" @onclick='() => feedbackMessage = ""'></button>
        </div>
    }

    <!-- بطاقات المؤشرات اللحظية (KPIs) -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي طلبات الصرف</small>
                <h4 class="mb-0 fw-bold text-primary mt-1 font-monospace">@requisitions.Count طلب</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 p-3 bg-white">
                <small class="text-muted fw-bold">بانتظار الصرف وتخصيص اللوطات</small>
                <h4 class="mb-0 fw-bold text-warning mt-1 font-monospace">@requisitions.Count(r => r.Status == "SUBMITTED") طلب</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-info border-4 p-3 bg-white">
                <small class="text-muted fw-bold">شحنات واردة بانتظار فحص الصالة</small>
                <h4 class="mb-0 fw-bold text-info mt-1 font-monospace">@requisitions.Count(r => r.Status == "DISPATCHED") شحنة</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-danger border-4 p-3 bg-white">
                <small class="text-muted fw-bold">نزاعات كميات معلقة</small>
                <h4 class="mb-0 fw-bold text-danger mt-1 font-monospace">@requisitions.Count(r => r.Status == "DISPUTED") نزاع</h4>
            </div>
        </div>
    </div>

    <!-- أزرار التبديل بين محطات العمل الـ 5 -->
    <ul class="nav nav-pills mb-3 bg-light p-2 rounded shadow-sm border">
        @if (State.HasAnyPermission("Requisition.Create", "Production.OperationsHub", "Production.Execution"))
        {
            <li class="nav-item">
                <button class="nav-link fw-bold @(activeTab == "REQUEST" ? "active" : "")" @onclick='() => ChangeTab("REQUEST")'>
                    ✍️️ 1. طلب خامات (مشرف الصالة)
                </button>
            </li>
        }
        @if (State.HasAnyPermission("Requisition.Issue", "Warehouse.View"))
        {
            <li class="nav-item">
                <button class="nav-link fw-bold @(activeTab == "DISPATCH" ? "active" : "")" @onclick='() => ChangeTab("DISPATCH")'>
                    📦 2. صرف المخازن وتخصيص اللوطات (FEFO)
                    @if (requisitions.Any(r => r.Status == "SUBMITTED"))
                    {
                        <span class="badge bg-warning text-dark ms-1">@(requisitions.Count(r => r.Status == "SUBMITTED")) طلب جديد</span>
                    }
                </button>
            </li>
        }
        @if (State.HasAnyPermission("Requisition.Receive", "Production.Execution", "Production.OperationsHub"))
        {
            <li class="nav-item">
                <button class="nav-link fw-bold @(activeTab == "RECEIVE" ? "active" : "")" @onclick='() => ChangeTab("RECEIVE")'>
                    🔍 3. استلام الصالة والمطابقة المزدوجة
                    @if (requisitions.Any(r => r.Status == "DISPATCHED"))
                    {
                        <span class="badge bg-info text-dark ms-1">@(requisitions.Count(r => r.Status == "DISPATCHED")) بانتظار الفحص</span>
                    }
                </button>
            </li>
        }
        @if (State.HasAnyPermission("Transfers.SettleDispute", "Warehouse.View", "Roles.Manage"))
        {
            <li class="nav-item">
                <button class="nav-link fw-bold @(activeTab == "DISPUTE" ? "active bg-danger text-white" : "text-danger")" @onclick='() => ChangeTab("DISPUTE")'>
                    ⚖️️ 4. فض النزاعات وتسوية الفروق
                    @if (requisitions.Any(r => r.Status == "DISPUTED"))
                    {
                        <span class="badge bg-white text-danger fw-bold ms-1">@(requisitions.Count(r => r.Status == "DISPUTED")) نزاع</span>
                    }
                </button>
            </li>
        }
        <li class="nav-item">
            <button class="nav-link fw-bold @(activeTab == "AUDIT" ? "active bg-success text-white" : "text-success")" @onclick='() => ChangeTab("AUDIT")'>
                📊 5. تقرير دورة حياة الخامات وأرصدة الصالات
            </button>
        </li>
    </ul>

    <!-- ======================================================== -->
    <!-- محطة 1: تسجيل طلب جديد                                  -->
    <!-- ======================================================== -->
    @if (activeTab == "REQUEST" && State.HasAnyPermission("Requisition.Create", "Production.OperationsHub", "Production.Execution"))
    {
        <div class="card shadow-sm border-0 border-top border-primary border-4 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-primary m-0">➕ تسجيل طلب احتياج خامات للوردية الحالية</h5>
                <span class="text-muted small">المشرف يحدد الخامات فقط، وكل خامة ستُصرف من مستودعها الخاص بنظام FEFO</span>
            </div>
            <div class="card-body bg-light">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-dark">الصالة الإنتاجية الطالبة *</label>
                        <select class="form-select border-primary fw-bold" @bind="newReq.DepartmentId">
                            <option value="0">-- اختر الصالة الإنتاجية الطالبة --</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.Id">@d.DepartmentName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-dark d-flex justify-content-between align-items-center">
                            <span>اسم المشرف المسؤول:</span>
                            <span class="badge bg-secondary font-monospace">🔒 موثق تلقائياً</span>
                        </label>
                        <input type="text" class="form-control border-primary fw-bold bg-white text-primary"
                               value="@CurrentSupervisorDisplayName"
                               readonly disabled />
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white py-2 fw-bold text-dark d-flex justify-content-between align-items-center">
                        <span class="text-primary">🧂 قائمة الخامات المطلوبة للتشغيل (@newReq.Lines.Count خامات):</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-info fw-bold" @onclick="DownloadTemplateAsync">
                                <i class="bi bi-download me-1"></i> تحميل قالب الإكسيل
                            </button>
                            <button class="btn btn-sm btn-outline-success fw-bold" @onclick="OpenImportModal">
                                <i class="bi bi-file-earmark-excel me-1"></i> استيراد من إكسيل
                            </button>
                            <button class="btn btn-sm btn-success fw-bold" @onclick="AddReqLine">
                                ➕ إضافة سطر خامة
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-bordered mb-0 align-middle text-center small">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 55%;">اسم الخامة أو المكون النصف مصنع *</th>
                                    <th style="width: 35%;">الكمية المطلوبة</th>
                                    <th style="width: 10%;">حذف</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in newReq.Lines)
                                {
                                    <tr>
                                        <td>
                                            <select class="form-select form-select-sm fw-bold" @bind="line.ItemId">
                                                <option value="0">-- اختر الخامة أو المكون --</option>
                                                @foreach (var itm in rawMaterials)
                                                {
                                                    <option value="@itm.Id">@itm.ItemName (@itm.ItemCode) - @itm.Unit</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold text-primary font-monospace" @bind="line.RequestedQty" />
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => newReq.Lines.Remove(line)">🗑️</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <button class="btn btn-primary fw-bold px-4 py-2 shadow-sm" @onclick="SubmitRequisition">
                    🚀 إرسال الطلب للمخازن المركزية
                </button>
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- محطة 2: صرف المخزن وتخصيص اللوطات                         -->
    <!-- ======================================================== -->
    @if (activeTab == "DISPATCH" && State.HasAnyPermission("Requisition.Issue", "Warehouse.View"))
    {
        <div class="card shadow-sm border-0 border-top border-warning border-4 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold text-dark m-0">📦 طلبات التشغيل الجديدة بانتظار الصرف وتخصيص اللوطات (FEFO)</h5>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم الطلب</th>
                            <th>الصالة الطالبة</th>
                            <th>المشرف الطالب الموثق</th>
                            <th>تاريخ الطلب</th>
                            <th>الحالة</th>
                            <th>الإجراء المخزني</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredRequisitions.Any(r => r.Status == "SUBMITTED"))
                        {
                            <tr>
                                <td colspan="6" class="text-muted py-4 fw-bold">لا توجد طلبات جديدة بانتظار الصرف حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var req in FilteredRequisitions.Where(r => r.Status == "SUBMITTED"))
                            {
                                <tr>
                                    <td class="fw-bold text-primary font-monospace">@req.RequisitionNumber</td>
                                    <td class="fw-bold">@req.DepartmentName</td>
                                    <td><span class="badge bg-light text-dark border">@(!string.IsNullOrEmpty(req.RequestedBy) ? req.RequestedBy : "مشرف الصالة")</span></td>
                                    <td class="font-monospace">@req.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><span class="badge bg-warning text-dark">بانتظار الصرف</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-warning text-dark fw-bold px-3 shadow-sm py-0" @onclick="() => SelectForDispatch(req)">
                                            🏷️ صرف خامات اللوطات
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (selectedDispatchReq != null)
        {
            <div class="card shadow-sm border-warning border-2 mb-4 bg-light">
                <div class="card-header bg-warning text-dark py-2 fw-bold d-flex justify-content-between align-items-center">
                    <span>📦 صرف أسطر الإذن: @selectedDispatchReq.RequisitionNumber (صالة: @selectedDispatchReq.DepartmentName)</span>
                    <button class="btn btn-sm btn-dark py-0" @onclick="() => selectedDispatchReq = null">إغلاق</button>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3 align-items-center">
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-dark mb-1 d-flex justify-content-between align-items-center">
                                <span>اسم القائم بالصرف (أمين المخزن):</span>
                                <span class="badge bg-dark font-monospace">🔒 موثق تلقائياً</span>
                            </label>
                            <input type="text" class="form-control form-control-sm fw-bold border-primary bg-white text-primary"
                                   value="@CurrentStorekeeperDisplayName"
                                   readonly disabled />
                        </div>
                        <div class="col-md-7">
                            <div class="alert alert-info py-2 px-3 mb-0 small border-0">
                                💡 <strong>ملاحظة:</strong> تم حصر المخازن في <strong>المخزن الرئيسي وإدارة المخازن</strong> فقط، مع اقتراح تشغيلة FEFO الأقرب انتهاءً تلقائياً.
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered bg-white text-center align-middle small mb-3">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 22%;">الخامة المطلوبة</th>
                                    <th style="width: 10%;">المطلوب</th>
                                    <th style="width: 22%;">مخزن الصرف المعتمد *</th>
                                    <th style="width: 12%;">الكمية المصروفة</th>
                                    <th style="width: 15%;">رقم التشغيلة (Batch)</th>
                                    <th style="width: 11%;">تاريخ الصلاحية</th>
                                    <th style="width: 8%;">التكلفة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in dispatchLinesView)
                                {
                                    var originLine = selectedDispatchReq.Lines.First(x => x.Id == l.LineId);
                                    <tr>
                                        <td class="fw-bold text-start ps-2">@originLine.ItemName</td>
                                        <td class="fw-bold text-primary font-monospace">@originLine.RequestedQty.ToString("N2") @originLine.Unit</td>
                                        <td>
                                            <select class="form-select form-select-sm fw-bold border-primary"
                                                    value="@l.WarehouseId"
                                                    @onchange="(e) => OnLineWarehouseChanged(l, e)">
                                                @foreach (var w in warehouses)
                                                {
                                                    <option value="@w.Id">@w.WarehouseName</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold font-monospace text-success" @bind="l.DispatchedQty" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm text-center font-monospace" @bind="l.BatchNumber" placeholder="LOT-..." />
                                        </td>
                                        <td>
                                            <input type="date" class="form-control form-control-sm text-center font-monospace" @bind="l.ExpiryDate" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center font-monospace" @bind="l.UnitCost" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-success fw-bold px-4 py-2 shadow-sm" @onclick="ConfirmDispatch">
                        ✅ اعتماد خروج الشحنة من المخازن المحددة بنظام FEFO
                    </button>
                </div>
            </div>
        }
    }

    <!-- ======================================================== -->
    <!-- محطة 3: استلام ومطابقة الصالة                            -->
    <!-- ======================================================== -->
    @if (activeTab == "RECEIVE" && State.HasAnyPermission("Requisition.Receive", "Production.Execution", "Production.OperationsHub"))
    {
        <div class="card shadow-sm border-0 border-top border-success border-4 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold text-success m-0">🔍 استلام الخامات بصالة الإنتاج والمطابقة المزدوجة صنفاً بصنف</h5>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم الطلب</th>
                            <th>الصالة</th>
                            <th>تاريخ الخروج</th>
                            <th>حالة الشحنة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredRequisitions.Any(r => r.Status == "DISPATCHED" || r.Status == "DISPUTED"))
                        {
                            <tr>
                                <td colspan="5" class="text-muted py-4 fw-bold">لا توجد شحنات واردة للصالة بانتظار الفحص حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var req in FilteredRequisitions.Where(r => r.Status == "DISPATCHED" || r.Status == "DISPUTED"))
                            {
                                <tr>
                                    <td class="fw-bold text-primary font-monospace">@req.RequisitionNumber</td>
                                    <td class="fw-bold">@req.DepartmentName</td>
                                    <td class="font-monospace">@req.DispatchedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @if (req.Status == "DISPUTED")
                                        {
                                            <span class="badge bg-danger">⚠️ نزاع كميات معلق عند المخزن</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">شحنة واردة بالصالة</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-primary fw-bold px-3 py-0" @onclick="() => SelectForReceiving(req)">
                                            🔎 فحص واستلام بالصنف
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (selectedReceiveReq != null)
        {
            <div class="card shadow-sm border-success border-2 mb-4 bg-light">
                <div class="card-header bg-success text-white py-2 fw-bold d-flex justify-content-between align-items-center">
                    <span>مطابقة أسطر الإذن: @selectedReceiveReq.RequisitionNumber (صالة: @selectedReceiveReq.DepartmentName)</span>
                    <button class="btn btn-sm btn-light py-0" @onclick="() => selectedReceiveReq = null">إغلاق</button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered bg-white text-center align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>الخامة</th>
                                    <th>المخزن المنصرف منه</th>
                                    <th>المصروف</th>
                                    <th>التشغيلة والصلاحية</th>
                                    <th>الكمية المستلمة فعلياً</th>
                                    <th>سبب الاختلاف (إن وجد)</th>
                                    <th>الحالة</th>
                                    <th>إجراء المشرف</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedReceiveReq.Lines)
                                {
                                    <tr class="@(line.LineStatus == "ACCEPTED" ? "table-success" : line.LineStatus == "DISPUTED" ? "table-danger" : "")">
                                        <td class="fw-bold text-start ps-3">@line.ItemName (@line.ItemCode)</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @(!string.IsNullOrEmpty(selectedReceiveReq.FromWarehouseName) ? selectedReceiveReq.FromWarehouseName : "مخزن الخامات الرئيسي")
                                            </span>
                                        </td>
                                        <td class="fw-bold text-primary font-monospace">@line.DispatchedQty.ToString("N2") @line.Unit</td>
                                        <td>
                                            <code class="fw-bold">@line.BatchNumber</code>
                                            <br />
                                            <small class="text-muted font-monospace">صلاحية: @line.ExpiryDate?.ToString("yyyy-MM-dd")</small>
                                        </td>
                                        <td style="width: 15%;">
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold font-monospace" @bind="line.ReceivedQty" disabled="@(line.LineStatus != "PENDING" && line.LineStatus != "DISPATCHED")" />
                                        </td>
                                        <td style="width: 20%;">
                                            <input type="text" class="form-control form-control-sm" @bind="line.DiscrepancyReason" placeholder="اذكر سبب العجز أو الزيادة..." disabled="@(line.LineStatus != "PENDING" && line.LineStatus != "DISPATCHED")" />
                                        </td>
                                        <td>
                                            @if (line.LineStatus == "ACCEPTED")
                                            {
                                                <span class="badge bg-success">تم القبول والمطابقة ✓</span>
                                                @if (!string.IsNullOrWhiteSpace(line.WarehouseNotes))
                                                {
                                                    <div class="text-muted small mt-1">ملاحظة المخزن: @line.WarehouseNotes</div>
                                                }
                                            }
                                            else if (line.LineStatus == "DISPUTED")
                                            {
                                                <span class="badge bg-danger">خلاف معلق عند المخزن</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">قيد الفحص</span>
                                            }
                                        </td>
                                        <td>
                                            @if (line.LineStatus == "PENDING" || line.LineStatus == "DISPATCHED")
                                            {
                                                <div class="d-flex gap-1 justify-content-center">
                                                    <button class="btn btn-sm btn-success fw-bold py-0 px-2" title="الكمية مطابقة تماماً" @onclick="() => AcceptLine(line, true)">
                                                        ✓ مطابقة
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger fw-bold py-0 px-2" title="تسجيل فرق وعجز" @onclick="() => AcceptLine(line, false)">
                                                        ⚠️ إثبات فرق
                                                    </button>
                                                </div>
                                            }
                                            else if (line.LineStatus == "DISPUTED")
                                            {
                                                <small class="text-danger fw-bold">⏳ بانتظار تسوية المخزن</small>
                                            }
                                            else
                                            {
                                                <span class="text-success fw-bold">✓ معتمد ومقفل</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ======================================================== -->
    <!-- محطة 4: فض النزاعات وتسوية الفروق                         -->
    <!-- ======================================================== -->
    @if (activeTab == "DISPUTE" && State.HasAnyPermission("Transfers.SettleDispute", "Warehouse.View", "Roles.Manage"))
    {
        <div class="card shadow-sm border-0 border-top border-danger border-4 mb-4">
            <div class="card-header bg-danger text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0">⚖️ صندوق مراجعة وفض النزاعات المخزنية وإثبات التسوية (Dispute Resolution)</h5>
                <span class="badge bg-white text-danger fw-bold">صلاحية أمين المخزن / الإدارة</span>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>رقم الإذن</th>
                            <th>الصالة الإنتاجية</th>
                            <th>الأصناف المتنازع عليها</th>
                            <th>تاريخ الخروج</th>
                            <th>الإجراء المطلوب</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredRequisitions.Any(r => r.Status == "DISPUTED"))
                        {
                            <tr>
                                <td colspan="5" class="text-success py-5 fw-bold fs-6">
                                    🎉 ممتاز! لا توجد أي نزاعات أو خلافات كميات معلقة حالياً بين المخزن والصالات.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var disReq in FilteredRequisitions.Where(r => r.Status == "DISPUTED"))
                            {
                                <tr>
                                    <td class="fw-bold text-primary font-monospace">@disReq.RequisitionNumber</td>
                                    <td class="fw-bold">@disReq.DepartmentName</td>
                                    <td>
                                        @foreach (var dl in disReq.Lines.Where(l => l.LineStatus == "DISPUTED"))
                                        {
                                            <span class="badge bg-warning text-dark m-1 p-2 font-monospace">
                                                @dl.ItemName: منصرف (@dl.DispatchedQty.ToString("N2")) ⟵ مستلم بالصالة (@dl.ReceivedQty.ToString("N2"))
                                            </span>
                                        }
                                    </td>
                                    <td class="font-monospace">@disReq.DispatchedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <button class="btn btn-sm btn-danger fw-bold px-3 shadow-sm py-0" @onclick="() => SelectForDisputeResolution(disReq)">
                                            ⚖️ فتح تسوية النزاع
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (selectedDisputeReq != null)
        {
            <div class="card shadow-sm border-danger border-2 mb-4 bg-white">
                <div class="card-header bg-dark text-white py-2 fw-bold d-flex justify-content-between align-items-center">
                    <span>⚖️ مراجعة وتسوية خلاف الإذن رقم: @selectedDisputeReq.RequisitionNumber</span>
                    <button class="btn btn-sm btn-outline-light py-0" @onclick="() => selectedDisputeReq = null">إغلاق</button>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning border-0 small mb-3">
                        ℹ️ <strong>تعليمات التسوية:</strong> راجع سبب العجز المسجل من المشرف، ثم عدّل "الكمية المعتمدة نهائياً" واكتب سبب التسوية، ثم اضغط زر "اعتماد التسوية وترحيل الرصيد".
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered text-center align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>الخامة</th>
                                    <th>المنصرف بالمخزن</th>
                                    <th>المستلم بالصالة</th>
                                    <th>سبب العجز / الاختلاف</th>
                                    <th style="width: 18%;">الكمية المعتمدة نهائياً</th>
                                    <th style="width: 25%;">ملاحظات أمين المخزن</th>
                                    <th>الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dLine in selectedDisputeReq.Lines.Where(l => l.LineStatus == "DISPUTED"))
                                {
                                    <tr>
                                        <td class="fw-bold text-start ps-3">@dLine.ItemName (@dLine.ItemCode)</td>
                                        <td class="fw-bold text-primary font-monospace">@dLine.DispatchedQty.ToString("N2") @dLine.Unit</td>
                                        <td class="fw-bold text-danger font-monospace">@dLine.ReceivedQty.ToString("N2") @dLine.Unit</td>
                                        <td class="text-danger small fw-bold">@dLine.DiscrepancyReason</td>
                                        <td>
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold border-success font-monospace" @bind="dLine.ReceivedQty" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm border-primary" placeholder="مثال: تم إقرار عجز الشكارة واعتماده كهدر نقل" @bind="dLine.WarehouseNotes" />
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-success fw-bold px-3 shadow-sm py-0" @onclick="() => ConfirmResolveDiscrepancy(dLine)">
                                                ✅ اعتماد التسوية وترحيل الرصيد
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ================================================================= -->
    <!-- محطة 5: التقرير الرقابي الشامل لدورة حياة الخامات وأرصدة الصالات -->
    <!-- ================================================================= -->
    @if (activeTab == "AUDIT")
    {
        <div class="card shadow-sm border-0 border-top border-success border-4 mb-4">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="fw-bold text-success m-0">📊 المسار الرقابي لدورة حياة الخامات وأثر رصيد الصالة التراكمي</h5>
                    <small class="text-muted">كشف حساب تاريخي تراكمي لحركات الصالات: الطلب، الصرف، استلام المطابقة، محاضر فض النزاعات، وأرصدة الصالة قبل وبعد كل حركة</small>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportAuditReportToCsv">
                        <i class="bi bi-file-earmark-excel me-1"></i> تصدير التقرير الرقابي (CSV)
                    </button>
                    <button class="btn btn-success btn-sm fw-bold shadow-sm" @onclick="LoadAuditReport">
                        🔍 تحديث واستخراج البيانات
                    </button>
                </div>
            </div>

            <div class="card-body bg-light">
                <!-- فلاتر التقرير المتقدمة -->
                <div class="row g-2 mb-3 align-items-end">
                    <div class="col-md-2">
                        <label class="small fw-bold text-secondary">من تاريخ:</label>
                        <input type="date" class="form-control form-control-sm font-monospace" @bind="auditStartDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-secondary">إلى تاريخ:</label>
                        <input type="date" class="form-control form-control-sm font-monospace" @bind="auditEndDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="small fw-bold text-secondary">صالة الإنتاج:</label>
                        <select class="form-select form-select-sm fw-bold" @bind="auditDeptFilter">
                            <option value="0">-- كل الصالات الإنتاجية --</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.Id">@d.DepartmentName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="small fw-bold text-secondary">خامة محددة:</label>
                        <select class="form-select form-select-sm fw-bold" @bind="auditItemFilter">
                            <option value="0">-- كل الخامات والمكونات --</option>
                            @foreach (var itm in rawMaterials)
                            {
                                <option value="@itm.Id">@itm.ItemName (@itm.ItemCode)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary btn-sm w-100 fw-bold" @onclick="LoadAuditReport">
                            تطبيق الفلترة
                        </button>
                    </div>
                </div>

                <!-- إحصائيات التقرير اللحظية -->
                <div class="row g-2 mb-3 text-center">
                    <div class="col-md-3">
                        <div class="p-2 border rounded bg-white shadow-sm">
                            <small class="text-muted d-block">إجمالي المطلوب بالصالات</small>
                            <strong class="text-primary fs-6 font-monospace">@auditRows.Sum(x => x.RequestedQty).ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-2 border rounded bg-white shadow-sm">
                            <small class="text-muted d-block">إجمالي المنصرف من المستودع</small>
                            <strong class="text-warning fs-6 font-monospace">@auditRows.Sum(x => x.DispatchedQty).ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-2 border rounded bg-white shadow-sm">
                            <small class="text-muted d-block">إجمالي المعتمد والمستلم بالصالات</small>
                            <strong class="text-success fs-6 font-monospace">@auditRows.Sum(x => x.FinalApprovedQty).ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-2 border rounded bg-white shadow-sm">
                            <small class="text-muted d-block">إجمالي هالك النقل والنزاع</small>
                            <strong class="text-danger fs-6 font-monospace">@auditRows.Sum(x => x.ScrapOrLossQty).ToString("N2")</strong>
                        </div>
                    </div>
                </div>

                <!-- جدول التقرير الرقابي الشامل المنقح والمضبوط -->
                <div class="table-responsive bg-white rounded border shadow-sm" style="max-height: 520px;">
                    <table class="table table-bordered table-hover align-middle text-center small mb-0">
                        <thead class="table-dark sticky-top">
                            <tr>
                                <th>رقم الإذن</th>
                                <th>تاريخ الطلب</th>
                                <th>الصالة الطالبة والمشرف</th>
                                <th>الخامة المطلوبة</th>
                                <th>المطلوب</th>
                                <th>المنصرف واللوط (FEFO)</th>
                                <th>المستلم بالصالة</th>
                                <th>الهالك / العجز</th>
                                <th class="table-secondary text-dark">حالة ومسار النزاع</th>
                                <th class="table-light text-dark">قرار ومحضر تسوية النزاع</th>
                                <th class="table-primary text-dark">رصيد الصالة قبل الطلب</th>
                                <th class="table-success text-dark">رصيد الصالة بعد الاعتماد</th>
                                <th class="table-info text-dark">الرصيد الفعلي الحالي بالصالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!auditRows.Any())
                            {
                                <tr>
                                    <td colspan="13" class="text-muted py-4 fw-bold">لا توجد حركات مطابقة لشروط البحث المحددة.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in auditRows)
                                {
                                    <tr>
                                        <td><code class="fw-bold font-monospace">@row.RequisitionNumber</code></td>
                                        <td class="font-monospace">@row.RequestDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-start ps-2">
                                            <span class="badge bg-light text-dark border d-block mb-1">@row.DepartmentName</span>
                                            <small class="text-muted">المشرف: @row.RequestedBy</small>
                                        </td>
                                        <td class="text-start ps-2 fw-bold text-dark">
                                            @row.ItemName
                                            <span class="d-block text-muted font-monospace small">@row.ItemCode</span>
                                        </td>
                                        <td class="fw-bold font-monospace">@row.RequestedQty.ToString("N2") @row.Unit</td>
                                        <td>
                                            @if (row.DispatchedQty > 0)
                                            {
                                                <span class="text-warning fw-bold font-monospace">@row.DispatchedQty.ToString("N2")</span>
                                                <div class="small font-monospace text-muted">لوط: @row.BatchNumber</div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">لم يُصرف بعد</span>
                                            }
                                        </td>
                                        <td>
                                            @if (row.FinalApprovedQty > 0)
                                            {
                                                <span class="text-success fw-bold font-monospace">@row.FinalApprovedQty.ToString("N2")</span>
                                                <span class="badge bg-success d-block small mt-1">معتمد ✓</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted font-monospace">@row.ReceivedQty.ToString("N2")</span>
                                            }
                                        </td>
                                        <td>
                                            @if (row.ScrapOrLossQty > 0)
                                            {
                                                <span class="badge bg-danger font-monospace">عجز: @row.ScrapOrLossQty.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>

                                        <!-- حالة ومسار النزاع -->
                                        <td>
                                            @if (row.DisputeStatusTitle.Contains("معلق"))
                                            {
                                                <span class="badge bg-danger">@row.DisputeStatusTitle</span>
                                            }
                                            else if (row.DisputeStatusTitle.Contains("فض النزاع"))
                                            {
                                                <span class="badge bg-info text-dark">@row.DisputeStatusTitle</span>
                                            }
                                            else if (row.DisputeStatusTitle.Contains("مطابق"))
                                            {
                                                <span class="badge bg-success">@row.DisputeStatusTitle</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">@row.DisputeStatusTitle</span>
                                            }
                                        </td>

                                        <!-- قرار ومحضر تسوية النزاع -->
                                        <td class="text-start ps-2">
                                            @if (!string.IsNullOrWhiteSpace(row.DiscrepancyReason) || !string.IsNullOrWhiteSpace(row.ResolutionNotes))
                                            {
                                                @if (!string.IsNullOrWhiteSpace(row.DiscrepancyReason))
                                                {
                                                    <div class="text-danger small fw-bold">⚠️ سبب المشرف: @row.DiscrepancyReason</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(row.ResolutionNotes))
                                                {
                                                    <div class="text-success small fw-bold mt-1">⚖️ قرار اللجنة: @row.ResolutionNotes</div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">مطابق 100%</span>
                                            }
                                        </td>

                                        <!-- رصيد الصالة قبل الطلب (تراكمي تاريخي حقيقي) -->
                                        <td class="table-primary fw-bold font-monospace text-dark">
                                            @row.FloorStockBefore.ToString("N2") @row.Unit
                                        </td>

                                        <!-- رصيد الصالة بعد الاعتماد (تراكمي) -->
                                        <td class="table-success fw-bold font-monospace text-success">
                                            @row.FloorStockAfter.ToString("N2") @row.Unit
                                        </td>

                                        <!-- الرصيد الفعلي الحالي التراكمي في مخزن الصالة -->
                                        <td class="table-info fw-bold font-monospace text-primary">
                                            @row.CurrentFloorStock.ToString("N2") @row.Unit
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>

<!-- مودال استيراد خامات الطلب من إكسيل -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد كشف الخامات المطلوبة للوردية من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        يتعرف النظام تلقائياً على كود الخامة أو اسمها، ويطابقها مع دليل الخامات المعتمدة، ثم يدرج الكميات مباشرة في جدول الطلب الحالي.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة الخامات المقروءة من الملف (@importedPreviewList.Count خامة):</span>
                            <span class="badge bg-success">جاهز للإدراج</span>
                        </div>
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>كود الخامة المقروء</th>
                                        <th>اسم الخامة المقروء</th>
                                        <th>الخامة المطابقة بالنظام</th>
                                        <th>الكمية المطلوبة</th>
                                        <th>الوحدة</th>
                                        <th>حالة المطابقة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@row.RawCode</td>
                                            <td class="fw-bold text-start ps-2">@row.RawName</td>
                                            <td class="text-start ps-2">
                                                @if (row.MatchedItemId > 0)
                                                {
                                                    <span class="text-success fw-bold">✔ @row.MatchedItemName (@row.MatchedItemCode)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger fw-bold">✖ غير مطابق</span>
                                                }
                                            </td>
                                            <td class="font-monospace fw-bold text-primary">@row.RequestedQty.ToString("N2")</td>
                                            <td><span class="badge bg-light text-dark border">@row.Unit</span></td>
                                            <td>
                                                @if (row.MatchedItemId > 0)
                                                {
                                                    <span class="badge bg-success">مطابق وصالح</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">يحتاج مراجعة</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm"
                            disabled="@(!importedPreviewList.Any(r => r.MatchedItemId > 0))"
                            @onclick="ApplyImportedLines">
                        <i class="bi bi-check-circle me-1"></i> تطبيق وإدراج الخامات (@importedPreviewList.Count(r => r.MatchedItemId > 0))
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "REQUEST";
    private string feedbackMessage = "";

    private List<RequisitionDetailDto> requisitions = new();
    private List<DepartmentOptionDto> departments = new();
    private List<WarehouseOptionDto> warehouses = new();
    private List<ItemOptionDto> rawMaterials = new();
    private List<RequisitionImportRowPreview> importedPreviewList = new();

    private CreateRequisitionDto newReq = new()
    {
        Lines = new List<CreateRequisitionLineDto> { new CreateRequisitionLineDto() }
    };

    private RequisitionDetailDto? selectedDispatchReq;
    private DispatchRequisitionDto dispatchModel = new();
    private List<DispatchLineViewModel> dispatchLinesView = new();

    private RequisitionDetailDto? selectedReceiveReq;
    private RequisitionDetailDto? selectedDisputeReq;
    private bool isImportModalOpen = false;

    private string searchTerm = "";
    private long selectedDeptFilter = 0;

    // بيانات التقرير الرقابي الشامل المنقحة
    private List<RequisitionLifecycleAuditDto> auditRows = new();
    private DateTime auditStartDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
