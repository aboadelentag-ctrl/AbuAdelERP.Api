    protected override async Task OnInitializedAsync()
    {
        InitializeDefaultActiveTab();
        await LoadDropdowns();
        await LoadRequisitions();

        newReq.RequestedBy = CurrentSupervisorDisplayName;
        if (State.DepartmentId.HasValue && departments.Any(d => d.Id == State.DepartmentId.Value))
        {
            newReq.DepartmentId = State.DepartmentId.Value;
        }

        await LoadAuditReport();
    }

    private void InitializeDefaultActiveTab()
    {
        if (State.HasAnyPermission("Requisition.Create", "Production.OperationsHub")) activeTab = "REQUEST";
        else if (State.HasAnyPermission("Requisition.Issue", "Warehouse.View")) activeTab = "DISPATCH";
        else if (State.HasAnyPermission("Requisition.Receive", "Production.Execution")) activeTab = "RECEIVE";
        else if (State.HasAnyPermission("Transfers.SettleDispute", "Warehouse.View")) activeTab = "DISPUTE";
        else activeTab = "AUDIT";
    }

    private async Task ChangeTab(string tab)
    {
        activeTab = tab;
        selectedDispatchReq = null;
        selectedReceiveReq = null;
        selectedDisputeReq = null;

        if (tab == "AUDIT")
        {
            await LoadAuditReport();
        }
    }

    private async Task LoadDropdowns()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<LookupsResponseDto>("api/MaterialRequisitions/lookups");
            if (res != null)
            {
                departments = res.Departments ?? new();
                warehouses = res.Warehouses ?? new();
                rawMaterials = res.RawMaterials ?? new();
            }
        }
        catch { }
    }

    private async Task LoadRequisitions()
    {
        try
        {
            var data = await Http.GetFromJsonAsync<List<RequisitionDetailDto>>("api/MaterialRequisitions");
            if (data != null) requisitions = data;
        }
        catch (Exception ex)
        {
            feedbackMessage = "خطأ في الاتصال: " + ex.Message;
        }
    }

    private async Task LoadAuditReport()
    {
        try
        {
            var url = $"api/MaterialRequisitions/audit-lifecycle-report?startDate={auditStartDate:yyyy-MM-dd}&endDate={auditEndDate:yyyy-MM-dd}&departmentId={auditDeptFilter}&itemId={auditItemFilter}";
            var data = await Http.GetFromJsonAsync<List<RequisitionLifecycleAuditDto>>(url);
            if (data != null)
            {
                auditRows = data;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"خطأ في استخراج التقرير الرقابي: {ex.Message}";
        }
    }

    private IEnumerable<RequisitionDetailDto> FilteredRequisitions
    {
        get
        {
            var query = requisitions.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(r =>
                    r.RequisitionNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    r.DepartmentName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(r.FromWarehouseName) && r.FromWarehouseName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    r.Lines.Any(l => l.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                    (!string.IsNullOrEmpty(l.BatchNumber) && l.BatchNumber.Contains(term, StringComparison.OrdinalIgnoreCase))));
            }

            if (selectedDeptFilter > 0)
            {
                query = query.Where(r => r.DepartmentId == selectedDeptFilter);
            }

            return query;
        }
    }

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(searchTerm) || selectedDeptFilter > 0;

    private void ResetFilters()
    {
        searchTerm = "";
        selectedDeptFilter = 0;
    }

    private void AddReqLine() => newReq.Lines.Add(new CreateRequisitionLineDto());

    private async Task SubmitRequisition()
    {
        if (newReq.DepartmentId == 0)
        {
            feedbackMessage = "⚠️ يرجى تحديد الصالة الإنتاجية الطالبة أولاً.";
            return;
        }

        newReq.Lines.RemoveAll(l => l.ItemId == 0 || l.RequestedQty <= 0);
        if (!newReq.Lines.Any())
        {
            feedbackMessage = "⚠️ يرجى اختيار خامة واحدة على الأقل بكمية صالحة أكبر من الصفر.";
            return;
        }

        newReq.RequestedBy = CurrentSupervisorDisplayName;
        if (newReq.FromWarehouseId == 0)
        {
            newReq.FromWarehouseId = warehouses.FirstOrDefault()?.Id ?? 1;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/MaterialRequisitions", newReq);
            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = "✅ تم إرسال طلب الخامات للمخازن بنجاح! بانتظار فحص وتحديد المستودعات من أمين المخزن.";
                newReq = new CreateRequisitionDto
                {
                    DepartmentId = State.DepartmentId ?? 0,
                    RequestedBy = CurrentSupervisorDisplayName,
                    Lines = new List<CreateRequisitionLineDto> { new CreateRequisitionLineDto() }
                };
                await LoadRequisitions();
                if (State.HasAnyPermission("Requisition.Issue", "Warehouse.View"))
                {
                    await ChangeTab("DISPATCH");
                }
            }
            else
            {
                feedbackMessage = "❌ فشل إرسال الطلب: " + await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = "❌ خطأ أثناء الإرسال: " + ex.Message;
        }
    }

    private async Task SelectForDispatch(RequisitionDetailDto req)
    {
        selectedDispatchReq = req;
        dispatchLinesView.Clear();

        long defaultWhId = warehouses.FirstOrDefault(w => w.WarehouseName.Contains("خامات") || w.WarehouseName.Contains("رئيسي"))?.Id
                           ?? (warehouses.FirstOrDefault()?.Id ?? (req.FromWarehouseId > 0 ? req.FromWarehouseId : 1));

        foreach (var l in req.Lines)
        {
            var lineModel = new DispatchLineViewModel
            {
                LineId = l.Id,
                ItemId = l.ItemId,
                WarehouseId = defaultWhId,
                DispatchedQty = l.RequestedQty,
                BatchNumber = "LOT-DEFAULT",
                ExpiryDate = DateTime.Today.AddYears(1),
                UnitCost = 5.0m
            };

            await FetchFefoForLine(lineModel);
            dispatchLinesView.Add(lineModel);
        }

        dispatchModel = new DispatchRequisitionDto
        {
            RequisitionId = req.Id,
            DispatchedBy = CurrentStorekeeperDisplayName,
            Lines = new List<DispatchLineDto>()
        };
    }

    private async Task OnLineWarehouseChanged(DispatchLineViewModel line, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var newWhId) && newWhId > 0)
        {
            line.WarehouseId = newWhId;
            await FetchFefoForLine(line);
        }
    }

    private async Task FetchFefoForLine(DispatchLineViewModel line)
    {
        try
        {
            var fefo = await Http.GetFromJsonAsync<List<FefoBatchSuggestionDto>>($"api/MaterialRequisitions/fefo-suggestions?itemId={line.ItemId}&warehouseId={line.WarehouseId}");
            var topFefo = fefo?.FirstOrDefault();
            if (topFefo != null)
            {
                line.BatchNumber = topFefo.BatchNumber;
                line.ExpiryDate = topFefo.ExpiryDate ?? DateTime.Today.AddYears(1);
                line.UnitCost = topFefo.UnitCost;
            }
            else
            {
                line.BatchNumber = $"LOT-{DateTime.Now:yyyyMMdd}";
                line.ExpiryDate = DateTime.Today.AddYears(1);
                line.UnitCost = 1.0m;
            }
        }
        catch { }
    }

    private async Task ConfirmDispatch()
    {
        if (selectedDispatchReq == null) return;

        dispatchModel.DispatchedBy = CurrentStorekeeperDisplayName;
        dispatchModel.Lines = dispatchLinesView.Select(l => new DispatchLineDto
        {
            LineId = l.LineId,
            DispatchedQty = l.DispatchedQty,
            BatchNumber = l.BatchNumber,
            ExpiryDate = l.ExpiryDate,
            UnitCost = l.UnitCost
        }).ToList();

        try
        {
            var response = await Http.PostAsJsonAsync("api/MaterialRequisitions/dispatch", dispatchModel);
            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = "✅ تم اعتماد خروج الشحنة من المخازن المحددة بنجاح!";
                selectedDispatchReq = null;
                await LoadRequisitions();
                await ChangeTab("RECEIVE");
            }
            else
            {
                feedbackMessage = "❌ فشل صرف الشحنة: " + await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = "❌ خطأ أثناء الصرف: " + ex.Message;
        }
    }

    private void SelectForReceiving(RequisitionDetailDto req)
    {
        selectedReceiveReq = req;
        foreach (var l in selectedReceiveReq.Lines)
        {
            if (l.ReceivedQty == 0) l.ReceivedQty = l.DispatchedQty;
        }
    }

    private async Task AcceptLine(RequisitionLineDetailDto line, bool isExact)
    {
        var dto = new ReceiveLineItemDto
        {
            LineId = line.Id,
            ReceivedQty = isExact ? line.DispatchedQty : line.ReceivedQty,
            IsAccepted = isExact,
            DiscrepancyReason = isExact ? null : line.DiscrepancyReason,
            ReceivedBy = CurrentSupervisorDisplayName
        };

        try
        {
            var response = await Http.PostAsJsonAsync("api/MaterialRequisitions/receive-line", dto);
            if (response.IsSuccessStatusCode)
            {
                line.LineStatus = isExact ? "ACCEPTED" : "DISPUTED";
                if (isExact) line.ReceivedQty = line.DispatchedQty;
                feedbackMessage = isExact ? "✅ تم قبول السطر والمطابقة بنجاح." : "⚠️ تم قيد الفرق وإشعار أمين المخزن في (تبويب فض النزاعات) لحله.";

                await LoadRequisitions();

                if (selectedReceiveReq != null && selectedReceiveReq.Lines.All(l => l.LineStatus == "ACCEPTED"))
                {
                    selectedReceiveReq = null;
                }
            }
            else
            {
                feedbackMessage = "❌ فشل تسجيل استلام السطر: " + await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = "❌ خطأ: " + ex.Message;
        }
    }

    private void SelectForDisputeResolution(RequisitionDetailDto req) => selectedDisputeReq = req;

    private async Task ConfirmResolveDiscrepancy(RequisitionLineDetailDto line)
    {
        try
        {
            var dto = new ResolveDiscrepancyDto
            {
                LineId = line.Id,
                FinalApprovedQty = line.ReceivedQty,
                WarehouseResolutionNotes = !string.IsNullOrWhiteSpace(line.WarehouseNotes) ? line.WarehouseNotes : $"تمت التسوية والاعتماد بواسطة {CurrentStorekeeperDisplayName}"
            };

            var response = await Http.PostAsJsonAsync("api/MaterialRequisitions/resolve-discrepancy", dto);
            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = $"✅ تم فض النزاع واعتماد الكمية النهائية ({line.ReceivedQty:N2} {line.Unit}) وتم ترحيل وخصم الرصيد بنجاح!";
                selectedDisputeReq = null;
                selectedReceiveReq = null;
                await LoadRequisitions();
            }
            else
            {
                feedbackMessage = "❌ فشل اعتماد التسوية: " + await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"❌ خطأ: {ex.Message}";
        }
    }

