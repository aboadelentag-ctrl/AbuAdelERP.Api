@code {
    [SupplyParameterFromQuery(Name = "branchId")]
    public long? BranchId { get; set; }

    private List<SalesInvoiceViewDto> invoices = new();
    private SalesLookupsDto? lookups;
    private SalesInvoiceCreateDto newInvoice = new();
    private string selectedPaymentMethod = "CASH";

    private bool showCreateModal = false;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessage;

    // حالة الطباعة والمعاينة
    private bool showPrintModal = false;
    private SalesInvoiceViewDto? selectedInvoiceForPrint;
    private string printFormat = "POS"; // "POS" أو "A4"

    // حالة إضافة عميل سريع
    private bool showQuickCustomerModal = false;
    private bool isSavingCustomer = false;
    private string? quickCustomerError;
    private string newCustomerName = "";
    private string newCustomerCode = "";
    private string newCustomerPhone = "";

    private long CurrentBranchId => BranchContext.CurrentBranch?.Id ?? BranchId ?? 2;

    private IEnumerable<SalesInvoiceViewDto> FilteredInvoices =>
        invoices.Where(inv => inv.BranchId == CurrentBranchId);

    private decimal CurrentInvoiceTotal => newInvoice.InvoiceLines?.Sum(l => l.Quantity * l.UnitPrice) ?? 0;

    private string CurrentCustomerName
    {
        get
        {
            var c = lookups?.Customers?.FirstOrDefault(x => x.Id == newInvoice.CustomerId);
            return c != null ? c.CustomerName : "العميل المحدد";
        }
    }

    private string ActiveBranchDisplayName
    {
        get
        {
            if (BranchContext.HasActiveBranch && BranchContext.CurrentBranch != null)
                return BranchContext.CurrentBranch.NameAr;

            var br = lookups?.Branches?.FirstOrDefault(b => b.Id == CurrentBranchId);
            return br != null ? br.BranchName : "فرع المبيعات";
        }
    }

    private SalesWarehouseLookupDto? ActiveBranchWarehouse
    {
        get
        {
            if (lookups?.Warehouses == null || !lookups.Warehouses.Any())
                return null;

            var wh = lookups.Warehouses.FirstOrDefault(w => w.BranchId == CurrentBranchId);
            if (wh != null) return wh;

            wh = lookups.Warehouses.FirstOrDefault(w => w.WarehouseName.Contains(ActiveBranchDisplayName));
            if (wh != null) return wh;

            return lookups.Warehouses.FirstOrDefault();
        }
    }

    private string ActiveWarehouseDisplayName => ActiveBranchWarehouse != null
        ? $"{ActiveBranchWarehouse.WarehouseName} ({ActiveBranchWarehouse.WarehouseCode})"
        : "المستودع الرئيسي للفرع (مقفل)";

    protected override async Task OnInitializedAsync()
    {
        await BranchContext.LoadSavedBranchAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            await Task.WhenAll(LoadInvoices(), LoadLookups());
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadInvoices() => invoices = await SalesService.GetAllInvoicesAsync();
    private async Task LoadLookups() => lookups = await SalesService.GetLookupsAsync();

    private void OpenCreateModal()
    {
        var targetWh = ActiveBranchWarehouse;

        newInvoice = new SalesInvoiceCreateDto
        {
            BranchId = CurrentBranchId,
            WarehouseId = targetWh?.Id,
            InvoiceLines = new List<SalesInvoiceLineDto>
            {
                new SalesInvoiceLineDto { Quantity = 1, UnitPrice = 0 }
            }
        };
        selectedPaymentMethod = "CASH";
        showCreateModal = true;
        errorMessage = null;
    }

    private void CloseCreateModal() => showCreateModal = false;
    private void AddLine() => newInvoice.InvoiceLines.Add(new SalesInvoiceLineDto { Quantity = 1, UnitPrice = 0 });

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < newInvoice.InvoiceLines.Count)
            newInvoice.InvoiceLines.RemoveAt(index);
    }

    private void OnItemSelected(int index, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out long itemId) && itemId > 0)
        {
            newInvoice.InvoiceLines[index].ItemId = itemId;
            var selectedItem = lookups?.FinishedItems?.FirstOrDefault(x => x.Id == itemId);
            if (selectedItem != null)
            {
                newInvoice.InvoiceLines[index].UnitPrice = selectedItem.SellingPrice;
            }
            else
            {
                newInvoice.InvoiceLines[index].UnitPrice = 0;
            }
        }
    }

    // فتح نافذة المعاينة والطباعة
    private void OpenPrintPreview(SalesInvoiceViewDto inv)
    {
        selectedInvoiceForPrint = inv;
        printFormat = "POS";
        showPrintModal = true;
    }

    // استدعاء أمر الطباعة المباشر من المتصفح
    private async Task TriggerBrowserPrint()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void OpenQuickCustomerModal()
    {
        newCustomerName = "";
        newCustomerPhone = "";
        newCustomerCode = $"CUST-{DateTime.Now:yyMMddHHmm}";
        quickCustomerError = null;
        showQuickCustomerModal = true;
    }

    private async Task SaveQuickCustomer()
    {
        if (string.IsNullOrWhiteSpace(newCustomerName))
        {
            quickCustomerError = "يرجى كتابة اسم العميل.";
            return;
        }

        isSavingCustomer = true;
        quickCustomerError = null;
        try
        {
            var customerDto = new CustomerItemDto
            {
                CustomerName = newCustomerName.Trim(),
                CustomerCode = newCustomerCode,
                Phone = newCustomerPhone.Trim(),
                Active = true
            };

            var success = await SalesService.SaveCustomerAsync(customerDto);
            if (success)
            {
                await LoadLookups();
                var newlyAdded = lookups?.Customers?.FirstOrDefault(c => c.CustomerCode == newCustomerCode);
                if (newlyAdded != null)
                {
                    newInvoice.CustomerId = newlyAdded.Id;
                }
                showQuickCustomerModal = false;
            }
            else
            {
                quickCustomerError = "تعذر حفظ العميل على الخادم.";
            }
        }
        catch (Exception ex)
        {
            quickCustomerError = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSavingCustomer = false;
        }
    }

    private async Task SubmitInvoice()
    {
        errorMessage = null;
        if (newInvoice.CustomerId <= 0)
        {
            errorMessage = "يجب اختيار العميل أولاً.";
            return;
        }

        if (!newInvoice.WarehouseId.HasValue || newInvoice.WarehouseId.Value <= 0)
        {
            var targetWh = ActiveBranchWarehouse;
            if (targetWh != null)
            {
                newInvoice.WarehouseId = targetWh.Id;
            }
            else
            {
                errorMessage = "تعذر تحديد المستودع المقفل للفرع في النظام.";
                return;
            }
        }

        var validLines = newInvoice.InvoiceLines
            .Where(l => l.ItemId > 0 && l.Quantity > 0 && l.UnitPrice > 0)
            .ToList();

        if (!validLines.Any())
        {
            errorMessage = "يجب اختيار صنف معتمد بكمية وسعر أكبر من صفر.";
            return;
        }

        newInvoice.InvoiceLines = validLines;
        isSubmitting = true;
        try
        {
            var payload = new
            {
                newInvoice.BranchId,
                newInvoice.CustomerId,
                newInvoice.WarehouseId,
                newInvoice.InvoiceLines,
                PaymentMethod = selectedPaymentMethod
            };

            var response = await Http.PostAsJsonAsync("api/Sales/create-invoice", payload);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SalesInvoiceResultDto>();
                successMessage = result?.Message ?? "تم إصدار وترحيل الفاتورة بنجاح!";
                CloseCreateModal();
                await LoadInvoices();

                // فتح الفاتورة الحديثة للمعاينة والطباعة مباشرة للكاشير
                var latestInv = invoices.FirstOrDefault(x => x.Id == result?.InvoiceId)
                                ?? invoices.FirstOrDefault();
                if (latestInv != null)
                {
                    OpenPrintPreview(latestInv);
                }
            }
            else
            {
                var errorObj = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                errorMessage = errorObj?.Error ?? "تعذر إصدار الفاتورة.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ اتصال: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleLogout()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public class ErrorResponse
    {
        public string? Error { get; set; }
    }
}