@page "/sales-invoices"
@page "/SalesInvoices"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@using AbuAdelERP.UI.DTOs
@using AbuAdelERP.UI.Services
@inject ISalesClientService SalesService
@inject IBranchContextService BranchContext
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS
@inject AppState State

<PageTitle>إدارة فواتير المبيعات - منصة كيان السحابية</PageTitle>

<div class="kayan-invoices-viewport" dir="rtl">

    <!-- 1. الشريط التنفيذي الموحد -->
    <header class="kayan-executive-topbar shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <div class="brand-tag-box" @onclick="@(() => Navigation.NavigateTo("/workspace"))" title="العودة لمساحة العمل">
                <span class="brand-tag">KAYAN</span>
                <span class="brand-sub">ENTERPRISE</span>
            </div>

            <span class="tenant-badge">
                <span class="pulse-dot"></span>
                <span>@(!string.IsNullOrEmpty(State.TenantName) ? State.TenantName : "مجموعة حلواني أبو عادل")</span>
            </span>

            <button class="topbar-btn" @onclick="@(() => Navigation.NavigateTo("/workspace"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                </svg>
                <span>مساحة العمل</span>
            </button>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="text-end">
                <div class="user-name-title">
                    👤 @(!string.IsNullOrEmpty(State.FullName) ? State.FullName : "أحمد عبدالعزيز (زيزو)")
                </div>
                <div class="d-flex gap-1 justify-content-end align-items-center mt-1">
                    <span class="badge bg-secondary" style="font-size: 10px;">@State.DepartmentName</span>
                    <span class="badge bg-primary" style="font-size: 10px;">@State.Role</span>
                </div>
            </div>

            <button class="logout-red-btn" @onclick="HandleLogout">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                <span>تسجيل الخروج</span>
            </button>
        </div>
    </header>

    <!-- 2. جسم صفحة الفواتير -->
    <main class="container-fluid py-4 px-4">

        @if (BranchContext.HasActiveBranch || BranchId.HasValue)
        {
            <div class="branch-lock-banner d-flex justify-content-between align-items-center shadow-sm py-2 px-3 mb-4 rounded-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-primary px-2 py-1 fs-6">سياق التشغيل المعزول</span>
                    <span class="fw-bold fs-5 text-white">📍 @ActiveBranchDisplayName</span>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success">
                        الخزينة ومستودع الصرف مقفلان على هذا الفرع حصراً ✓
                    </span>
                </div>
                <div>
                    <span class="text-muted small fw-bold">نظام الرقابة المالية الصارم</span>
                </div>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-2">
            <div>
                <h3 class="fw-bold text-dark mb-1">
                    <i class="bi bi-receipt me-2 text-primary"></i>إدارة فواتير المبيعات والترحيل المالي
                </h3>
                <p class="text-muted small mb-0">إصدار الفواتير مع الترحيل التلقائي للمخزون وشجرة الحسابات ومديونيات التجار</p>
            </div>
            <button class="btn btn-primary px-4 shadow-sm fw-bold" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle me-1"></i> فاتورة مبيعات جديدة
            </button>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm fw-bold py-2" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                <button type="button" class="btn-close py-2" @onclick="() => successMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm fw-bold py-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                <button type="button" class="btn-close py-2" @onclick="() => errorMessage = null"></button>
            </div>
        }

        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-dark">
                    سجل الفواتير الصادرة (@FilteredInvoices.Count() فاتورة)
                    <span class="badge bg-primary ms-2">خاصة بـ @ActiveBranchDisplayName</span>
                </h5>
                <button class="btn btn-sm btn-outline-secondary fw-bold" @onclick="LoadInvoices" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise me-1"></i> تحديث
                </button>
            </div>
            <div class="card-body p-0">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2 mb-0">جاري تحميل بيانات الفواتير والقيود...</p>
                    </div>
                }
                else if (!FilteredInvoices.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        لا توجد فواتير مبيعات مسجلة لهذا الفرع حتى الآن.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-center small">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th>#</th>
                                    <th>رقم الفاتورة</th>
                                    <th>تاريخ الإصدار</th>
                                    <th>الفرع</th>
                                    <th>العميل / المنفذ</th>
                                    <th>عدد البنود</th>
                                    <th>إجمالي الفاتورة</th>
                                    <th>الأثر المالي والمخزني</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in FilteredInvoices)
                                {
                                    <tr>
                                        <td>@inv.Id</td>
                                        <td class="fw-bold font-monospace text-primary">@inv.InvoiceNumber</td>
                                        <td class="font-monospace text-muted">@inv.InvoiceDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                        <td><span class="badge bg-info text-dark">@inv.BranchName</span></td>
                                        <td><span class="badge bg-light text-dark border px-2 py-1 fw-bold">@inv.CustomerName</span></td>
                                        <td><span class="badge bg-secondary font-monospace">@inv.ItemsCount أصناف</span></td>
                                        <td class="fw-bold text-success fs-6 font-monospace">@inv.TotalAmount.ToString("N2") ج.م</td>
                                        <td><span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">مرحل مالياً ومخزنياً ✓</span></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-dark fw-bold px-2 py-1 shadow-sm"
                                                    @onclick="() => OpenPrintPreview(inv)" title="معاينة وطباعة الفاتورة">
                                                <i class="bi bi-printer me-1"></i> طباعة / معاينة
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </main>
</div>

<!-- ========================================== -->
<!-- نافذة 1: إصدار فاتورة مبيعات جديدة         -->
<!-- ========================================== -->
@if (showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" dir="rtl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-plus-circle me-2 text-primary"></i>إصدار فاتورة مبيعات وترحيل الأثر المخزني والمالي
                    </h6>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="row g-3 mb-3 p-3 bg-white rounded-3 border shadow-sm">
                        <!-- الفرع -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">فرع الإصدار (مقفل)</label>
                            <input type="text" class="form-control form-control-sm fw-bold bg-light border-primary"
                                   value="@ActiveBranchDisplayName" readonly />
                        </div>

                        <!-- العميل -->
                        <div class="col-md-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold mb-0">العميل / التاجر المستلم <span class="text-danger">*</span></label>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-bold"
                                        @onclick="OpenQuickCustomerModal" title="إضافة عميل جديد فوراً">
                                    <i class="bi bi-plus-lg"></i> + عميل جديد
                                </button>
                            </div>
                            <select class="form-select form-select-sm fw-bold border-primary" @bind="newInvoice.CustomerId">
                                <option value="0">-- اختر العميل --</option>
                                @if (lookups?.Customers != null)
                                {
                                    @foreach (var c in lookups.Customers)
                                    {
                                        <option value="@c.Id">@c.CustomerName (@c.CustomerCode)</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- طريقة السداد -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">طريقة السداد والأثر المالي <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm fw-bold border-success" @bind="selectedPaymentMethod">
                                <option value="CASH">💵 نقدي (خزينة الفرع)</option>
                                <option value="CREDIT">📋 آجل (حساب التاجر)</option>
                            </select>
                        </div>

                        <!-- مستودع الصرف -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">مستودع الصرف (مقفل ومحدد آلياً)</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted border-secondary">
                                    <i class="bi bi-lock-fill text-warning"></i>
                                </span>
                                <input type="text" class="form-control form-control-sm fw-bold bg-light border-secondary text-dark"
                                       value="@ActiveWarehouseDisplayName" readonly />
                            </div>
                        </div>
                    </div>

                    <!-- جدول الأصناف -->
                    <div class="card p-3 border-0 shadow-sm bg-white mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark">📦 بنود الفاتورة:</h6>
                            <button type="button" class="btn btn-sm btn-outline-success fw-bold" @onclick="AddLine">
                                <i class="bi bi-plus-lg me-1"></i> إضافة صنف
                            </button>
                        </div>

                        <div class="table-responsive border rounded-3">
                            <table class="table table-bordered align-middle mb-0 text-center small">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 45%;">المنتج التام</th>
                                        <th style="width: 15%;">الكمية المباعة</th>
                                        <th style="width: 20%;">سعر الوحدة (ج.م) [مقفل من كارت الصنف]</th>
                                        <th style="width: 15%;">الإجمالي</th>
                                        <th style="width: 5%;">حذف</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!newInvoice.InvoiceLines.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="py-4 text-muted">لم يتم إضافة أصناف بعد.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @for (int i = 0; i < newInvoice.InvoiceLines.Count; i++)
                                        {
                                            var index = i;
                                            var line = newInvoice.InvoiceLines[index];
                                            <tr>
                                                <td>
                                                    <select class="form-select form-select-sm text-end fw-bold"
                                                            value="@line.ItemId"
                                                            @onchange="(e) => OnItemSelected(index, e)">
                                                        <option value="0">-- اختر المنتج --</option>
                                                        @if (lookups?.FinishedItems != null)
                                                        {
                                                            @foreach (var item in lookups.FinishedItems)
                                                            {
                                                                <option value="@item.Id">@item.ItemName (@item.ItemCode)</option>
                                                            }
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="number" step="1" class="form-control form-control-sm text-center fw-bold" min="1"
                                                           @bind="line.Quantity" @bind:event="oninput" />
                                                </td>
                                                <td>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control form-control-sm text-center fw-bold text-success font-monospace bg-light border-0"
                                                               value="@line.UnitPrice.ToString("N2")" readonly />
                                                        <span class="input-group-text bg-light text-muted border-0 py-0 px-2" title="السعر معتمد ومقفل من بطاقة الصنف">
                                                            <i class="bi bi-lock-fill text-secondary"></i>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td class="fw-bold text-primary font-monospace fs-6">
                                                    @((line.Quantity * line.UnitPrice).ToString("N2"))
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => RemoveLine(index)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold fs-6">إجمالي الفاتورة:</td>
                                        <td colspan="2" class="text-center fw-bold text-success fs-5 font-monospace">
                                            @CurrentInvoiceTotal.ToString("N2") ج.م
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- معاينة القيد المحاسبي -->
                    <div class="card p-3 border-0 shadow-sm bg-white border-start border-4 border-info">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-info small m-0">⚖️ معاينة القيد المحاسبي الآلي بالأستاذ العام:</h6>
                            <span class="badge bg-success">متزن 100% ✓</span>
                        </div>
                        <table class="table table-sm table-bordered text-center align-middle small mb-0 font-monospace">
                            <thead class="table-light">
                                <tr>
                                    <th>طرف القيد</th>
                                    <th>كود الحساب</th>
                                    <th>اسم الحساب</th>
                                    <th>مدين</th>
                                    <th>دائن</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-success">من حـ/ (مدين)</td>
                                    <td>@(selectedPaymentMethod == "CASH" ? "1212" : "1221")</td>
                                    <td>@(selectedPaymentMethod == "CASH" ? $"خزينة [{ActiveBranchDisplayName}]" : $"ذمم العملاء [{CurrentCustomerName}]")</td>
                                    <td class="fw-bold text-success">@CurrentInvoiceTotal.ToString("N2")</td>
                                    <td>0.00</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-primary">إلى حـ/ (دائن)</td>
                                    <td>41</td>
                                    <td>إيرادات مبيعات التوزيع والطلبيات</td>
                                    <td>0.00</td>
                                    <td class="fw-bold text-primary">@CurrentInvoiceTotal.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="CloseCreateModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="SubmitInvoice" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري الترحيل المالي والمخزني...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>
                            <span>اعتماد وترحيل الفاتورة</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- نافذة 2: معاينة وطباعة الفاتورة (POS / A4) -->
<!-- ========================================== -->
@if (showPrintModal && selectedInvoiceForPrint != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered @(printFormat == "POS" ? "modal-sm" : "modal-lg")" dir="rtl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2 px-3 no-print">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-printer-fill text-warning"></i>
                        <span class="fw-bold small">طباعة فاتورة: @selectedInvoiceForPrint.InvoiceNumber</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 ms-0 me-auto">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn @(printFormat == "POS" ? "btn-primary" : "btn-outline-light") py-0 px-2" @onclick='() => printFormat = "POS"'>
                                إيصال كاشير (80mm)
                            </button>
                            <button type="button" class="btn @(printFormat == "A4" ? "btn-primary" : "btn-outline-light") py-0 px-2" @onclick='() => printFormat = "A4"'>
                                رسمي (A4)
                            </button>
                        </div>
                        <button type="button" class="btn-close btn-close-white ms-2" @onclick="() => showPrintModal = false"></button>
                    </div>
                </div>

                <!-- مساحة الفاتورة القابلة للطباعة -->
                <div class="modal-body p-3 bg-white" id="invoice-printable-area">
                    @if (printFormat == "POS")
                    {
                        <!-- قالب إيصال الكاشير الحراري (POS Thermal Receipt) -->
                        <div class="pos-receipt text-center font-monospace">
                            <div class="fw-bold fs-5">حلواني أبو عادل</div>
                            <div class="small text-muted">KAYAN ENTERPRISE ERP</div>
                            <div class="small fw-bold border-bottom pb-2 mb-2">فرع: @selectedInvoiceForPrint.BranchName</div>

                            <div class="text-start small mb-2">
                                <div><strong>رقم الفاتورة:</strong> @selectedInvoiceForPrint.InvoiceNumber</div>
                                <div><strong>التاريخ:</strong> @selectedInvoiceForPrint.InvoiceDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                                <div><strong>العميل:</strong> @selectedInvoiceForPrint.CustomerName</div>
                            </div>

                            <table class="table table-sm table-borderless text-end small mb-2 border-top border-bottom">
                                <thead>
                                    <tr class="border-bottom">
                                        <th>الصنف</th>
                                        <th class="text-center">الكمية</th>
                                        <th class="text-start">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in selectedInvoiceForPrint.Lines)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width: 140px;">@line.ItemName</td>
                                            <td class="text-center">@line.Quantity</td>
                                            <td class="text-start fw-bold">@line.LineTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="d-flex justify-content-between fw-bold fs-6 border-bottom pb-2 mb-2">
                                <span>الإجمالي النهائي:</span>
                                <span>@selectedInvoiceForPrint.TotalAmount.ToString("N2") ج.م</span>
                            </div>

                            <div class="small text-muted mb-2">فاتورة مبيعات إلكترونية معتمدة ✓</div>
                            <div class="small text-muted">شكراً لزيارتكم!</div>
                        </div>
                    }
                    else
                    {
                        <!-- قالب الفاتورة الرسمية (A4) -->
                        <div class="p-3 border rounded-3 font-monospace">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                                <div>
                                    <h4 class="fw-bold text-primary mb-0">مجموعة حلواني أبو عادل</h4>
                                    <span class="text-muted small">سجل تجاري: 482910 | بطاقة ضريبية: 712-345-998</span>
                                    <div class="fw-bold text-dark mt-1">فرع الإصدار: @selectedInvoiceForPrint.BranchName</div>
                                </div>
                                <div class="text-end">
                                    <h5 class="fw-bold text-dark mb-1">فاتورة مبيعات ضريبية</h5>
                                    <span class="badge bg-dark font-monospace fs-6">@selectedInvoiceForPrint.InvoiceNumber</span>
                                </div>
                            </div>

                            <div class="row g-2 mb-3 small">
                                <div class="col-6"><strong>تاريخ الفاتورة:</strong> @selectedInvoiceForPrint.InvoiceDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</div>
                                <div class="col-6"><strong>العميل / التاجر:</strong> @selectedInvoiceForPrint.CustomerName</div>
                                <div class="col-6"><strong>حالة الترحيل:</strong> مرحل مالياً ومخزنياً بالأستاذ العام ✓</div>
                                <div class="col-6"><strong>المستودع المنصرف منه:</strong> @ActiveWarehouseDisplayName</div>
                            </div>

                            <table class="table table-bordered table-sm text-center align-middle mb-3 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>كود الصنف</th>
                                        <th>اسم المنتج التام</th>
                                        <th>الكمية المباعة</th>
                                        <th>سعر الوحدة</th>
                                        <th>الإجمالي (ج.م)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < selectedInvoiceForPrint.Lines.Count; i++)
                                    {
                                        var line = selectedInvoiceForPrint.Lines[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>@line.ItemCode</td>
                                            <td class="text-end fw-bold">@line.ItemName</td>
                                            <td>@line.Quantity @line.Unit</td>
                                            <td>@line.UnitPrice.ToString("N2")</td>
                                            <td class="fw-bold text-primary">@line.LineTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-light fw-bold fs-6">
                                        <td colspan="5" class="text-end">الإجمالي الصافي للفاتورة:</td>
                                        <td class="text-success font-monospace">@selectedInvoiceForPrint.TotalAmount.ToString("N2") ج.م</td>
                                    </tr>
                                </tfoot>
                            </table>

                            <div class="d-flex justify-content-between align-items-center border-top pt-3 text-muted small">
                                <div>المستلم: ................................</div>
                                <div>المحاسب المسؤول: @(!string.IsNullOrEmpty(State.FullName) ? State.FullName : "أحمد عبدالعزيز")</div>
                                <div>الختم والاعتماد: ................................</div>
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between no-print">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => showPrintModal = false">إغلاق</button>
                    <button type="button" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="TriggerBrowserPrint">
                        <i class="bi bi-printer me-1"></i> طباعة الفاتورة الآن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- نافذة 3: إضافة عميل جديد سريع (+)          -->
<!-- ========================================== -->
@if (showQuickCustomerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1080;">
        <div class="modal-dialog modal-dialog-centered" dir="rtl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-person-plus-fill me-2"></i>إضافة عميل / تاجر جديد للنظام
                    </h6>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="() => showQuickCustomerModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    @if (!string.IsNullOrEmpty(quickCustomerError))
                    {
                        <div class="alert alert-danger py-1 small fw-bold mb-2">@quickCustomerError</div>
                    }
                    <div class="mb-2">
                        <label class="form-label small fw-bold">اسم العميل / المنفذ <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" placeholder="مثال: هايبر ماركت البركة" @bind="newCustomerName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">كود العميل (تلقائي)</label>
                        <input type="text" class="form-control form-control-sm bg-light" @bind="newCustomerCode" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">رقم الهاتف / الموبايل</label>
                        <input type="text" class="form-control form-control-sm" placeholder="01xxxxxxxxx" @bind="newCustomerPhone" />
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showQuickCustomerModal = false">إلغاء</button>
                    <button type="button" class="btn btn-primary btn-sm fw-bold" @onclick="SaveQuickCustomer" disabled="@isSavingCustomer">
                        @if (isSavingCustomer)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <span>حفظ وتعيين العميل فوراً</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

