        public string? Barcode { get; set; }
    }

    public class UomConversionDto
    {
        public long Id { get; set; }
        public long? ItemId { get; set; }
        public string ItemName { get; set; } = string.Empty;
        public string FromUnit { get; set; } = string.Empty;
        public string ToUnit { get; set; } = string.Empty;
        public decimal ConversionFactor { get; set; }
        public string Notes { get; set; } = string.Empty;
    }

    public class UomConversionCreateDto
    {
        public long? ItemId { get; set; }
        public string FromUnit { get; set; } = string.Empty;
        public string ToUnit { get; set; } = string.Empty;
        public decimal ConversionFactor { get; set; }
        public string Notes { get; set; } = string.Empty;
    }

    public class DepartmentLookupDto
    {
        public long Id { get; set; }
        public string? Name { get; set; }
        public string? DepartmentName { get; set; }
        public string DisplayName => !string.IsNullOrWhiteSpace(DepartmentName) ? DepartmentName : (!string.IsNullOrWhiteSpace(Name) ? Name : "قسم");
    }

    public class BulkResponseDto
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
    }
}