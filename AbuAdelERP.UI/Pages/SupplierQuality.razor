@page "/supplier-quality"
@using System.Net.Http.Json
@using System.Text
@using System.IO
@using AbuAdelERP.UI.Services
@inject HttpClient Http
@inject AppState State
@inject IJSRuntime JS

<PageTitle>تقييم جودة الموردين وفحص الخامات المستلمة - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الشاشة التنفيذي -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-success">🛡️ تقييم جودة الموردين وفحص استلام الخامات (GMP/QA)</h4>
                    <span class="badge bg-success text-white px-2 py-1 small fw-bold">إدارة توكيد الجودة</span>
                </div>
                <small class="text-light text-opacity-75">
                    التحقق المخبري والظاهري من شحنات الموردين، تقييم درجات الامتثال والمطابقة، وربط شهادات التحليل (COA).
                </small>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-success fw-bold btn-sm px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenNewEvaluationModal">
                    <i class="bi bi-clipboard-check-fill"></i> تقييم وفحص شحنة جديدة
                </button>
                <button class="btn btn-outline-light btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="ExportToExcel">
                    <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> تصدير إكسيل
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") border-0 shadow-sm alert-dismissible fade show py-2 mb-3 fw-bold" role="alert">
            @feedbackMessage
            <button type="button" class="btn-close py-2" @onclick='() => feedbackMessage = ""'></button>
        </div>
    }

    <!-- بطاقات المؤشرات اللحظية -->
    <div class="row g-2 mb-3">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-success text-center">
                <small class="text-muted fw-bold">شحنات مطابقة 100% (معتمدة)</small>
                <h4 class="fw-bold text-success mt-1 mb-0 font-monospace">@evaluationsList.Count(e => e.Result == "APPROVED") شحنة</h4>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-warning text-center">
                <small class="text-muted fw-bold">قبول مشروط / تحت الفحص</small>
                <h4 class="fw-bold text-warning mt-1 mb-0 font-monospace">@evaluationsList.Count(e => e.Result == "CONDITIONAL") شحنة</h4>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-danger text-center">
                <small class="text-muted fw-bold">شحنات مرفوضة (مردودة للمورد)</small>
                <h4 class="fw-bold text-danger mt-1 mb-0 font-monospace">@evaluationsList.Count(e => e.Result == "REJECTED") شحنة</h4>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-dark text-center">
                <small class="text-muted fw-bold">إجمالي الشحنات المفحوصة</small>
                <h4 class="fw-bold text-dark mt-1 mb-0 font-monospace">@evaluationsList.Count تقييم</h4>
            </div>
        </div>
    </div>

    <!-- جدول الفحوصات والتقييمات -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 400px;">
                <input type="text" class="form-control form-control-sm" placeholder="بحث باسم المورد، كود الشحنة، الخامة..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <span class="badge bg-dark font-monospace">سجل الجودة المعتمد</span>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                <thead class="table-light">
                    <tr>
                        <th>رقم التقرير</th>
                        <th>تاريخ الفحص</th>
                        <th>اسم المورد</th>
                        <th>الخامة المفحوصة</th>
                        <th>رقم التشغيلة / اللوت</th>
                        <th>درجة المطابقة</th>
                        <th>نتيجة فحص الجودة</th>
                        <th>المسؤول عن الفحص</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredEvaluations.Any())
                    {
                        <tr><td colspan="8" class="text-muted py-4 fw-bold">لا توجد سجلات فحص تطابق البحث.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in FilteredEvaluations)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@item.ReportNumber</td>
                                <td class="font-monospace">@item.InspectionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-bold text-start ps-3 text-dark">@item.SupplierName</td>
                                <td class="text-start ps-2">@item.ItemName</td>
                                <td class="font-monospace text-muted">@item.BatchNumber</td>
                                <td>
                                    <div class="fw-bold font-monospace @(item.ComplianceScore >= 85 ? "text-success" : item.ComplianceScore >= 65 ? "text-warning" : "text-danger")">
                                        @item.ComplianceScore %
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @GetResultBadge(item.Result) px-2 py-1">
                                        @TranslateResult(item.Result)
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.InspectedByName</div>
                                    <small class="text-muted font-monospace">[@item.InspectedByCode]</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal تقييم شحنة مورد جديدة -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">🛡️ تقييم وفحص شحنة خامات مورد جديدة</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">اسم المورد المعتمد *</label>
                            <input type="text" class="form-control fw-bold" @bind="newEval.SupplierName" placeholder="مثال: مطاحن ومخابز شمال القاهرة" />
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">الخامة أو الصنف المستلم *</label>
                            <input type="text" class="form-control fw-bold" @bind="newEval.ItemName" placeholder="مثال: دقيق فاخر 72%، زبدة نيوزيلندي..." />
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">رقم التشغيلة (Batch/Lot) *</label>
                            <input type="text" class="form-control font-monospace" @bind="newEval.BatchNumber" placeholder="LOT-2026-X" />
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">نسبة المطابقة والمواصفة (%) *</label>
                            <input type="number" class="form-control font-monospace fw-bold text-center text-primary" @bind="newEval.ComplianceScore" min="0" max="100" />
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">قرار واعتماد الجودة *</label>
                            <select class="form-select fw-bold" @bind="newEval.Result">
                                <option value="APPROVED">مطابق ومعتمد للاستخدام ✓</option>
                                <option value="CONDITIONAL">قبول مشروط بتشغيل عاجل ⚠️</option>
                                <option value="REJECTED">مرفوض تماماً (مرتجع للمورد) ⛔</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="small fw-bold text-dark mb-1">ملاحظات الفحص الظاهري والمخبري (COA)</label>
                            <textarea class="form-control" rows="2" @bind="newEval.Notes" placeholder="اكتب حالة التغليف، الرائحة، درجة الحرارة، أو نتائج التحليل..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isModalOpen = false">إلغاء</button>
                    <button class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="SaveEvaluation">💾 حفظ واعتماد الفحص</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public class SupplierQualityDto
    {
        public long Id { get; set; }
        public string ReportNumber { get; set; } = string.Empty;
        public DateTime InspectionDate { get; set; } = DateTime.Now;
        public string SupplierName { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string BatchNumber { get; set; } = string.Empty;
        public int ComplianceScore { get; set; } = 95;
        public string Result { get; set; } = "APPROVED";
        public string InspectedByCode { get; set; } = string.Empty;
        public string InspectedByName { get; set; } = string.Empty;
        public string? Notes { get; set; }
    }

    private List<SupplierQualityDto> evaluationsList = new();
    private string searchTerm = "";
    private bool isModalOpen = false;
    private SupplierQualityDto newEval = new();
    private string feedbackMessage = "";
    private bool isSuccess = true;

    protected override void OnInitialized()
    {
        evaluationsList = new List<SupplierQualityDto>
        {
            new() { Id = 1, ReportNumber = "QA-2026-081", InspectionDate = DateTime.Now.AddHours(-2), SupplierName = "شركة الزيوت والدهون النقية", ItemName = "سمن بلدي طبيعي 100%", BatchNumber = "LOT-SMN-88", ComplianceScore = 98, Result = "APPROVED", InspectedByCode = State.EmployeeCode, InspectedByName = State.FullName, Notes = "مطابق لجميع الاشتراطات القياسية وشهادة COA معتمدة" },
            new() { Id = 2, ReportNumber = "QA-2026-080", InspectionDate = DateTime.Now.AddDays(-1), SupplierName = "مطاحن ومخابز القاهرة", ItemName = "دقيق فاخر استخراج 72%", BatchNumber = "LOT-FL-104", ComplianceScore = 92, Result = "APPROVED", InspectedByCode = "EMP-012", InspectedByName = "أحمد محمد أحمد", Notes = "فحص الجلوتين والرطوبة مطابق للمواصفة" },
            new() { Id = 3, ReportNumber = "QA-2026-079", InspectionDate = DateTime.Now.AddDays(-2), SupplierName = "مؤسسة الألبان الطازجة", ItemName = "كريمة لباني طبيعية", BatchNumber = "LOT-CRM-03", ComplianceScore = 55, Result = "REJECTED", InspectedByCode = "EMP-045", InspectedByName = "فتحي حميده", Notes = "ارتفاع درجة حرارة الشحنة أثناء النقل وتم رفض الاستلام" }
        };
    }

    private IEnumerable<SupplierQualityDto> FilteredEvaluations => evaluationsList.Where(e =>
        string.IsNullOrWhiteSpace(searchTerm) ||
        e.SupplierName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        e.ItemName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        e.ReportNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        e.BatchNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private void OpenNewEvaluationModal()
    {
        newEval = new SupplierQualityDto
        {
            ReportNumber = $"QA-{DateTime.Now:yyyyMMdd}-{new Random().Next(100, 999)}",
            InspectionDate = DateTime.Now,
            ComplianceScore = 95,
            Result = "APPROVED",
            InspectedByCode = State.EmployeeCode,
            InspectedByName = State.FullName
        };
        isModalOpen = true;
    }

    private void SaveEvaluation()
    {
        if (string.IsNullOrWhiteSpace(newEval.SupplierName) || string.IsNullOrWhiteSpace(newEval.ItemName))
        {
            feedbackMessage = "⚠️ يرجى إدخال اسم المورد والخامة المفحوصة!";
            isSuccess = false;
            return;
        }

        newEval.Id = evaluationsList.Any() ? evaluationsList.Max(x => x.Id) + 1 : 1;
        evaluationsList.Insert(0, newEval);
        feedbackMessage = $"✅ تم تسجيل محضر فحص الجودة ({newEval.ReportNumber}) بنجاح!";
        isSuccess = true;
        isModalOpen = false;
    }

    private async Task ExportToExcel()
    {
        var sb = new StringBuilder();
        sb.AppendLine("رقم التقرير,التاريخ,المورد,الخامة,رقم التشغيلة,نسبة المطابقة,النتيجة,القائم بالفحص");

        foreach (var item in FilteredEvaluations)
        {
            sb.AppendLine($"\"{item.ReportNumber}\",\"{item.InspectionDate:yyyy-MM-dd HH:mm}\",\"{item.SupplierName}\",\"{item.ItemName}\",\"{item.BatchNumber}\",{item.ComplianceScore}%,\"{TranslateResult(item.Result)}\",\"{item.InspectedByName}\"");
        }

        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        var base64 = Convert.ToBase64String(bytes);

        var js = $@"
            const link = document.createElement('a');
            link.href = 'data:text/csv;charset=utf-8;base64,{base64}';
            link.download = 'سجل_تقييم_جودة_الموردين_{DateTime.Now:yyyyMMdd_HHmm}.csv';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ";
        await JS.InvokeVoidAsync("eval", js);
    }

    private string GetResultBadge(string r) => r switch
    {
        "APPROVED" => "bg-success",
        "CONDITIONAL" => "bg-warning text-dark",
        "REJECTED" => "bg-danger",
        _ => "bg-secondary"
    };

    private string TranslateResult(string r) => r switch
    {
        "APPROVED" => "مطابق ومعتمد ✓",
        "CONDITIONAL" => "قبول مشروط ⚠️",
        "REJECTED" => "مرفوض تماماً ⛔",
        _ => r
    };
}