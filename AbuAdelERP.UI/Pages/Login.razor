@page "/login"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using AbuAdelERP.UI.Services
@using Blazored.LocalStorage
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject AppState State
@inject NavigationManager Nav

<PageTitle>تسجيل الدخول - نظام كيان السحابي</PageTitle>

<div class="kayan-login-viewport" dir="rtl">
    <!-- تأثير الشبكة العصبية المظلمة -->
    <div class="login-bg-grid"></div>

    <div class="login-box-card">
        <!-- ترويسة الشعار والمنصة -->
        <div class="login-brand-header">
            <div class="glowing-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                </svg>
            </div>
            <h2 class="system-title">KAYAN ENTERPRISE</h2>
            <div class="tenant-badge">
                <span class="dot"></span>
                <span>بوابة تشغيل: مجموعة حلواني أبو عادل</span>
            </div>
            <p class="subtitle">سجّل دخولك للوصول إلى مساحة العمل والصلاحيات المعتمدة</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-notification">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <span>@errorMessage</span>
            </div>
        }

        <!-- نموذج تسجيل الدخول -->
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <div class="form-group mb-3">
                <label class="field-label">اسم المستخدم (Username)</label>
                <div class="input-container">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    <input type="text" class="custom-input" placeholder="اسم المستخدم"
                           @bind-value="loginModel.Username" autofocus required />
                </div>
            </div>

            <div class="form-group mb-4">
                <label class="field-label">كلمة المرور (Password)</label>
                <div class="input-container">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input type="password" class="custom-input" placeholder="••••••••"
                           @bind-value="loginModel.Password" required />
                </div>
            </div>

            <button type="submit" class="submit-btn" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="btn-spinner"></span>
                    <span>جاري التحقق من الصلاحيات والربط السحابي...</span>
                }
                else
                {
                    <span>تسجيل الدخول للنظام</span>
                    <span class="arrow">←</span>
                }
            </button>
        </EditForm>

        <div class="login-footer">
            <span>منصة كيان السحابية • Antigravity Edition v2.0</span>
            <span>حماية البيانات والتحقق وفق معيار JWT / Neon Cloud</span>
        </div>
    </div>
</div>

<style>
    .kayan-login-viewport {
        position: relative;
        min-height: 100vh;
        width: 100vw;
        background-color: #030712;
        background-image: radial-gradient(circle at 50% 30%, rgba(99, 102, 241, 0.15) 0%, transparent 60%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        box-sizing: border-box;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }

    .login-bg-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(147, 51, 234, 0.25) 1px, transparent 1px);
        background-size: 50px 50px;
        opacity: 0.5;
        pointer-events: none;
    }

    .login-box-card {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 440px;
        background: rgba(17, 24, 39, 0.85);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 2.5rem 2rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        color: #FFFFFF;
    }

    .login-brand-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .glowing-logo {
        width: 60px;
        height: 60px;
        margin: 0 auto 1.25rem auto;
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.3), rgba(99, 102, 241, 0.2));
        border: 1px solid rgba(192, 132, 252, 0.4);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #C084FC;
        box-shadow: 0 0 25px rgba(168, 85, 247, 0.3);
    }

        .glowing-logo svg {
            width: 32px;
            height: 32px;
        }

    .system-title {
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        margin: 0;
        color: #FFFFFF;
    }

    .tenant-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        font-size: 0.8rem;
        color: #CBD5E1;
        margin: 0.75rem 0 0.5rem 0;
    }

        .tenant-badge .dot {
            width: 7px;
            height: 7px;
            background: #10B981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10B981;
        }

    .subtitle {
        font-size: 0.85rem;
        color: #94A3B8;
        margin: 0.25rem 0 0 0;
    }

    .field-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #CBD5E1;
        margin-bottom: 0.4rem;
    }

    .input-container {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        right: 1rem;
        width: 18px;
        height: 18px;
        color: #64748B;
    }

    .custom-input {
        width: 100%;
        background: #0B0F17;
        border: 1px solid #1F2937;
        border-radius: 10px;
        padding: 0.75rem 2.8rem 0.75rem 1rem;
        color: #FFFFFF;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .custom-input:focus {
            border-color: #6366F1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }

    .submit-btn {
        width: 100%;
        background: linear-gradient(135deg, #4F46E5, #6366F1);
        border: none;
        border-radius: 10px;
        padding: 0.85rem;
        color: #FFFFFF;
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .submit-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(79, 70, 229, 0.4);
        }

        .submit-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .btn-spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #FFFFFF;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .error-notification {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #FCA5A5;
        padding: 0.6rem 0.85rem;
        border-radius: 8px;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

        .error-notification svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

    .login-footer {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.75rem;
        color: #64748B;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    public class LoginDto
    {
        public string Username { get; set; } = "admin";
        public string Password { get; set; } = "123456";
    }

    public class AuthResponse
    {
        public string Message { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;
        public long UserId { get; set; }
        public string Username { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string DepartmentName { get; set; } = string.Empty;
        public List<string> Permissions { get; set; } = new();
        public string? Error { get; set; }
    }

    private LoginDto loginModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponse>();

                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    await LocalStorage.SetItemAsync("authToken", result.Token);
                    await LocalStorage.SetItemAsync("username", result.Username);
                    await LocalStorage.SetItemAsync("fullName", result.FullName);
                    await LocalStorage.SetItemAsync("userRole", result.Role);
                    await LocalStorage.SetItemAsync("departmentName", result.DepartmentName);
                    await LocalStorage.SetItemAsync("userPermissions", result.Permissions);

                    State.SetUserSession(result.UserId, result.Username, result.Username, result.FullName, result.Role, null, result.DepartmentName, result.Permissions);
                    Nav.NavigateTo("/workspace", forceLoad: true);
                }
                else
                {
                    errorMessage = "فشل في معالجة استجابة تسجيل الدخول.";
                }
            }
            else
            {
                errorMessage = "اسم المستخدم أو كلمة المرور غير صحيحة، أو تم تجميد الحساب.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في الاتصال بالخادم: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}