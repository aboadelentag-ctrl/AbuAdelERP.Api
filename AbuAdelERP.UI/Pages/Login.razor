@page "/login"
@layout EmptyLayout
@using System.Net.Http.Json
@using AbuAdelERP.UI.Services
@using Blazored.LocalStorage
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject AppState State
@inject NavigationManager Nav

<PageTitle>تسجيل الدخول - حلواني أبو عادل ERP</PageTitle>

<div class="login-wrapper vh-100 d-flex justify-content-center align-items-center" dir="rtl">
    <div class="card border-0 shadow-lg p-4 rounded-4 login-card bg-white" style="width: 100%; max-width: 440px;">

        <div class="text-center mb-4">
            <div class="brand-icon mx-auto mb-2 text-danger">
                <i class="bi bi-shield-lock-fill" style="font-size: 3.5rem;"></i>
            </div>
            <h4 class="fw-bold text-dark m-0">مؤسسة حلواني أبو عادل</h4>
            <span class="badge bg-danger text-white px-3 py-1 mt-1 small">نظام إدارة العمليات والإنتاج (ERP)</span>
            <p class="text-muted small mt-2">يرجى تسجيل الدخول لبدء جلسة العمل المعتمدة</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 small fw-bold border-0 shadow-sm text-center mb-3" role="alert">
                ⚠️ @errorMessage
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <div class="mb-3">
                <label class="form-label fw-bold small text-dark">اسم المستخدم (Username)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person-fill"></i></span>
                    <input type="text" class="form-control border-start-0 font-monospace fw-bold"
                           placeholder="اسم المستخدم"
                           @bind-value="loginModel.Username"
                           autofocus required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold small text-dark">كلمة المرور (Password)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key-fill"></i></span>
                    <input type="password" class="form-control border-start-0 font-monospace fw-bold"
                           placeholder="••••••••"
                           @bind-value="loginModel.Password"
                           required />
                </div>
            </div>

            <button type="submit" class="btn btn-danger w-100 py-2 fw-bold shadow-sm d-flex justify-content-center align-items-center gap-2" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>جاري التحقق من الصلاحيات...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-left fs-5"></i>
                    <span>تسجيل الدخول للنظام</span>
                }
            </button>
        </EditForm>

        <div class="text-center mt-4 pt-3 border-top text-muted" style="font-size: 11px;">
            <div>إصدار الإنتاج الصناعي v2.5 | 2026 - 2027</div>
            <div class="text-secondary mt-1">معايير توكيد الجودة وسلامة الغذاء (ISO 22000 / GMP)</div>
        </div>

    </div>
</div>

<style>
    .login-wrapper {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    }

    .login-card {
        border-top: 5px solid #dc3545 !important;
    }
</style>

@code {
    public class LoginDto
    {
        public string Username { get; set; } = "admin";
        public string Password { get; set; } = "123456";
    }

    public class AuthResponse
    {
        public string Message { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;
        public long UserId { get; set; }
        public string Username { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string DepartmentName { get; set; } = string.Empty;
        public List<string> Permissions { get; set; } = new();
        public string? Error { get; set; }
    }

    private LoginDto loginModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponse>();

                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    await LocalStorage.SetItemAsync("authToken", result.Token);
                    await LocalStorage.SetItemAsync("username", result.Username);
                    await LocalStorage.SetItemAsync("fullName", result.FullName);
                    await LocalStorage.SetItemAsync("userRole", result.Role);
                    await LocalStorage.SetItemAsync("departmentName", result.DepartmentName);
                    await LocalStorage.SetItemAsync("userPermissions", result.Permissions);

                    State.SetUserSession(result.Username, result.FullName, result.Role, result.DepartmentName, result.Permissions);
                    Nav.NavigateTo("", forceLoad: true);
                }
                else
                {
                    errorMessage = "فشل في معالجة استجابة تسجيل الدخول.";
                }
            }
            else
            {
                errorMessage = "اسم المستخدم أو كلمة المرور غير صحيحة، أو تم تجميد الحساب.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في الاتصال بالخادم: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}