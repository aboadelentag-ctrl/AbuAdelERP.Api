    private async Task SaveNewBillAsync()
    {
        if (newBill.Category == "SUPPLIER_PURCHASE" && (newBill.SupplierId == null || newBill.SupplierId == 0))
        {
            statusMessage = "⚠️ يرجى اختيار المورد المعتمد من القائمة.";
            isSuccess = false;
            return;
        }

        if (newBill.TotalAmount <= 0 || string.IsNullOrWhiteSpace(newBill.Title))
        {
            statusMessage = "⚠️ يرجى إدخال عنوان ومبلغ الفاتورة بشكل صحيح.";
            isSuccess = false;
            return;
        }

        try
        {
            var res = await Http.PostAsJsonAsync("api/ExpensesPayables", newBill);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = "✅ تم تسجيل استحقاق الفاتورة وربطها بسجل المورد بنجاح!";
                isSuccess = true;
                isAddModalOpen = false;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
    }

    private void OpenPayModal(ExpensePayableDto bill)
    {
        activeBillToPay = bill;
        paymentAmountInput = bill.RemainingAmount;
        isPayModalOpen = true;
    }

    private async Task ConfirmPaymentAsync()
    {
        if (activeBillToPay == null || paymentAmountInput <= 0) return;

        try
        {
            var res = await Http.PostAsJsonAsync($"api/ExpensesPayables/{activeBillToPay.Id}/pay", paymentAmountInput);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = "✅ تم إثبات السداد وتحديث التزام المورد بنجاح!";
                isSuccess = true;
                isPayModalOpen = false;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
    }

