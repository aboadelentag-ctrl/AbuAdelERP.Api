@page "/branch-transfers"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using AbuAdelERP.UI.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject AppState State
@inject NavigationManager Navigation

<PageTitle>حوكمة إمداد الفروع والمنافسط اللوجستي - كيان Enterprise</PageTitle>

<div class="kayan-transfers-viewport" dir="rtl">
    <!-- الشريط العلوي -->
    <header class="transfers-header-bar d-print-none">
        <div class="d-flex align-items-center gap-3">
            <button class="back-home-btn" @onclick='() => Navigation.NavigateTo("/workspace")' title="العودة لمساحة العمل">
                <i class="bi bi-arrow-right fs-5"></i>
            </button>
            <div>
                <h4 class="mb-0 text-white fw-bold">🚚 حوكمة تحويل وإمداد الفروع واستلام المنافذ</h4>
                <span class="text-muted small">شحن متعدد الأصناف ⇦ مانيفست التوزيع ⇦ متابعة السرافيس والأسبات ⇦ لجنة فض المنازعات • @State.TenantName</span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-success btn-sm fw-bold" @onclick="ExportToExcel" title="تصدير كشف الشحنات إلى Excel">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير Excel
            </button>
            <button class="btn btn-outline-light btn-sm fw-bold" @onclick="LoadData" disabled="@isProcessing">
                <i class="bi bi-arrow-clockwise me-1"></i> تحديث لحظي
            </button>
            <span class="badge bg-dark border border-secondary px-3 py-2 text-info">
                @State.FullName (@State.Role)
            </span>
        </div>
    </header>

    <!-- رسائل التنبيه -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="container-fluid px-4 pt-3 d-print-none">
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show border-0 shadow-sm py-2" role="alert">
                <strong>@(isSuccess ? "✓ " : "⚠️ ")</strong> @alertMessage
                <button type="button" class="btn-close py-2" @onclick="() => alertMessage = string.Empty"></button>
            </div>
        </div>
    }

    <!-- شريط التبويبات الرئيسي -->
    <div class="container-fluid px-4 pt-3 d-print-none">
        <ul class="nav nav-pills custom-pills-bar gap-2">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "list" ? "active" : "")" @onclick='() => activeTab = "list"'>
                    📋 سجل الشحنات والمنافسط (@GroupedManifests.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "dispatch" ? "active" : "")" @onclick='() => activeTab = "dispatch"'>
                    🚚 1. شحن وتوجيه مانيفست متعدد الأصناف
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "receive" ? "active" : "") position-relative" @onclick='() => activeTab = "receive"'>
                    📥 2. استلام ومطابقة عهدة الفرع
                    @if (InTransitItemsCount > 0)
                    {
                        <span class="badge rounded-pill bg-warning text-dark ms-1">@InTransitItemsCount صنف</span>
                    }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "dispute" ? "active" : "") position-relative" @onclick='() => activeTab = "dispute"'>
                    ⚖️ 3. لجنة فض منازعات عجز النقل
                    @if (DisputedItemsCount > 0)
                    {
                        <span class="badge rounded-pill bg-danger ms-1">@DisputedItemsCount نزاع</span>
                    }
                </button>
            </li>
        </ul>
    </div>

    <!-- شريط فلاتر البحث المتقدم -->
    @if (activeTab == "list")
    {
        <div class="container-fluid px-4 pt-3 d-print-none">
            <div class="content-card p-3 mb-2">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                               placeholder="بحث برقم الشحنة، السائق، الصنف..." @bind="searchTerm" @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="filterBranchId">
                            <option value="0">كل الفروع المستلمة</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id">@b.BranchName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="filterStatus">
                            <option value="">كل الحالات</option>
                            <option value="IN_TRANSIT">في الطريق 🚚</option>
                            <option value="IN_DISPUTE">نزاع عجز 🚨</option>
                            <option value="COMPLETED">مكتمل ومستلم ✓</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" class="form-control form-control-sm bg-dark text-white border-secondary font-monospace" @bind="filterDateFrom" />
                    </div>
                    <div class="col-md-2">
                        <input type="date" class="form-control form-control-sm bg-dark text-white border-secondary font-monospace" @bind="filterDateTo" />
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- محتوى التبويبات -->
    <main class="container-fluid px-4 py-3 d-print-none">
        @if (isProcessing && !transfers.Any())
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">جاري تحميل بيانات الشحنات والمستودعات...</p>
            </div>
        }
        else if (activeTab == "list")
        {
            <!-- ========================================== -->
            <!-- تبويب 1: السجل العام للشحنات والمنافسط     -->
            <!-- ========================================== -->
            <div class="content-card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 text-center small border-secondary">
                        <thead class="table-secondary text-dark fw-bold">
                            <tr>
                                <th>رقم الشحنة</th>
                                <th>تاريخ الشحن</th>
                                <th>المستودع المصدر</th>
                                <th>الفرع المستلم</th>
                                <th>السائق والسيارة</th>
                                <th>عدد الأصناف</th>
                                <th>إجمالي المشحون</th>
                                <th>إجمالي المستلم</th>
                                <th>الأوعية المحملة</th>
                                <th>الحالة العامة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!GroupedManifests.Any())
                            {
                                <tr><td colspan="11" class="text-muted py-5 fw-bold">لا توجد شحنات مطابقة للبحث المحدد.</td></tr>
                            }
                            else
                            {
                                @foreach (var m in GroupedManifests)
                                {
                                    <tr>
                                        <td class="fw-bold text-info font-monospace fs-6">@m.ManifestBaseNumber</td>
                                        <td class="font-monospace text-muted">@m.TransferDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-light">@m.SourceWarehouseName</td>
                                        <td class="fw-bold text-warning">@m.DestinationBranchName</td>
                                        <td>
                                            <div class="text-light">@(m.DriverName ?? "---")</div>
                                            <small class="text-muted font-monospace">@(m.VehicleNumber ?? "")</small>
                                        </td>
                                        <td><span class="badge bg-secondary font-monospace">@m.Lines.Count أصناف</span></td>
                                        <td class="fw-bold text-primary font-monospace">@m.TotalDispatchedQty.ToString("N1")</td>
                                        <td class="fw-bold font-monospace @(m.TotalReceivedQty < m.TotalDispatchedQty ? "text-danger" : "text-success")">
                                            @m.TotalReceivedQty.ToString("N1")
                                        </td>
                                        <td class="small">
                                            <span class="badge bg-dark border border-secondary text-info">@m.TotalInnerCount أوعية</span>
                                            <span class="badge bg-dark border border-secondary text-warning">@m.TotalCrateCount سبت</span>
                                        </td>
                                        <td>
                                            @if (m.OverallStatus == "IN_TRANSIT")
                                            {
                                                <span class="badge bg-warning text-dark px-2 py-1">🚚 في الطريق</span>
                                            }
                                            else if (m.OverallStatus == "IN_DISPUTE")
                                            {
                                                <span class="badge bg-danger px-2 py-1">🚨 نزاع عجز</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success px-2 py-1">✓ مكتمل الاستلام</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-info" title="عرض تفاصيل الشحنة" @onclick="() => OpenManifestDetails(m)">
                                                    <i class="bi bi-eye"></i> تفاصيل
                                                </button>
                                                <button class="btn btn-outline-light" title="طباعة مانيفست الشحن A4" @onclick="() => PrintManifest(m)">
                                                    <i class="bi bi-printer"></i> طباعة
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == "dispatch")
        {
            <!-- ========================================== -->
            <!-- تبويب 2: شحن مانيفست متعدد الأصناف والأوعية -->
            <!-- ========================================== -->
            <div class="content-card p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="text-primary fw-bold mb-1"><i class="bi bi-truck-front-fill me-2"></i>إصدار إذن شحن ومانيفست توزيع (حلويات تامة وأوعية النقل)</h5>
                        <span class="text-muted small">يتم ربط الصنف باللوط تلقائياً وتحديد السرافيس، الصواني، والأسبات بشكل منفصل.</span>
                    </div>
                    <button class="btn btn-sm btn-success fw-bold" @onclick="AddNewDispatchLine">
                        <i class="bi bi-plus-circle me-1"></i> إضافة صنف للشحنة
                    </button>
                </div>

                <!-- ترويسة الشحنة -->
                <div class="row g-3 mb-4 bg-dark bg-opacity-50 p-3 rounded-3 border border-secondary border-opacity-50">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">الفرع المستهدف <span class="text-danger">*</span></label>
                        <select class="form-select bg-dark text-white border-secondary" value="@multiDispatch.DestinationBranchId" @onchange="OnDispatchBranchChanged">
                            <option value="0">-- اختر الفرع --</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id">@b.BranchName (@b.BranchCode)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">مستودع الفرع المستلم <span class="text-danger">*</span></label>
                        <select class="form-select bg-dark text-white border-secondary" @bind="multiDispatch.DestinationWarehouseId">
                            <option value="0">-- اختر المستودع --</option>
                            @foreach (var w in branchWarehouses)
                            {
                                <option value="@w.Id">@w.WarehouseName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">اسم السائق / المندوب <span class="text-danger">*</span></label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="اسم السائق المسؤول" @bind="multiDispatch.DriverName" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">رقم لوحة السيارة</label>
                        <input type="text" class="form-control bg-dark text-white border-secondary font-monospace" placeholder="مثال: أ ب ج 512" @bind="multiDispatch.VehicleNumber" />
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-light">ملاحظات خط سير الشحنة</label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="توجيهات التسليم والتفريغ..." @bind="multiDispatch.Notes" />
                    </div>
                </div>

                <!-- جدول أصناف المانيفست والأوعية -->
                <div class="table-responsive mb-3">
                    <table class="table table-dark table-bordered align-middle text-center small mb-0 border-secondary">
                        <thead class="table-secondary text-dark fw-bold">
                            <tr>
                                <th style="width: 25%;">المنتج التام (حلويات فقط)</th>
                                <th style="width: 15%;">رقم التشغيلة (اللوط)</th>
                                <th style="width: 12%;">الكمية المشحونة</th>
                                <th style="width: 13%;">نوع الوعاء الداخلي</th>
                                <th style="width: 12%;">عدد (سرافيس / صواني)</th>
                                <th style="width: 12%;">عدد الأسبات الحاملة</th>
                                <th style="width: 6%;">حذف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!multiDispatch.Items.Any())
                            {
                                <tr><td colspan="7" class="py-4 text-muted">انقر على "إضافة صنف للشحنة" لإدراج المنتجات.</td></tr>
                            }
                            @foreach (var itemRow in multiDispatch.Items)
                            {
                                <tr>
                                    <td>
                                        <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                                value="@itemRow.ItemId"
                                                @onchange="(e) => OnItemSelected(itemRow, e)">
                                            <option value="0">-- اختر المنتج التام --</option>
                                            @foreach (var itm in finishedItems)
                                            {
                                                <option value="@itm.Id">@itm.ItemName (@itm.ItemCode)</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary font-monospace text-center"
                                               placeholder="لوط التشغيل" @bind="itemRow.BatchNumber" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.5" class="form-control form-control-sm bg-dark text-white border-secondary font-monospace fw-bold text-primary text-center"
                                               @bind="itemRow.DispatchedQty" min="0.1" />
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm bg-dark text-white border-secondary fw-bold" @bind="itemRow.ContainerType">
                                            <option value="سرفيس">سرفيس (جاتوه/سواريه)</option>
                                            <option value="صاج/صينية">صاج / صينية (شرقي/نواشف)</option>
                                            <option value="علبة/كرتونة">علبة / كرتونة (تورت)</option>
                                            <option value="بدون وعاء">بدون وعاء (فرط)</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary font-monospace text-center fw-bold"
                                               @bind="itemRow.InnerCount" min="0" placeholder="سرفيس/صاج" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary font-monospace text-center fw-bold text-warning"
                                               @bind="itemRow.CrateCount" min="0" placeholder="أسبات" />
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => multiDispatch.Items.Remove(itemRow)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        @if (multiDispatch.Items.Any())
                        {
                            <tfoot class="border-top border-secondary">
                                <tr class="fw-bold text-light">
                                    <td colspan="2" class="text-end pe-3">إجمالي حمولة الشحنة:</td>
                                    <td class="text-primary font-monospace fs-6">@multiDispatch.Items.Sum(i => i.DispatchedQty).ToString("N1")</td>
                                    <td></td>
                                    <td class="text-info font-monospace fs-6">@multiDispatch.Items.Sum(i => i.InnerCount) وعاء</td>
                                    <td class="text-warning font-monospace fs-6">@multiDispatch.Items.Sum(i => i.CrateCount) سبت</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>

                <!-- زر اعتماد الشحن محمي بالصلاحية -->
                <div class="d-flex justify-content-end gap-2">
                    <AuthorizeAction Permission="Logistics.Transfers.Dispatch">
                        <button class="btn btn-primary px-4 fw-bold shadow-sm" @onclick="SubmitMultiDispatch" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <span>🚚 اعتماد الشحن وخصم جميع الأصناف وتوجيه المانيفست</span>
                        </button>
                    </AuthorizeAction>
                </div>
            </div>
        }
        else if (activeTab == "receive")
        {
            <!-- ========================================== -->
            <!-- تبويب 3: استلام الفرع صنفاً بصنف          -->
            <!-- ========================================== -->
            <div class="content-card shadow-sm p-3">
                <h5 class="text-warning fw-bold mb-3"><i class="bi bi-inbox-fill me-2"></i>شحنات في الطريق بانتظار فحص واستلام عهدة الفرع والأوعية</h5>
                @if (!InTransitManifests.Any())
                {
                    <div class="text-center text-muted py-5 fw-bold">لا توجد شحنات معلقة على الطريق للفروع حالياً.</div>
                }
                else
                {
                    @foreach (var m in InTransitManifests)
                    {
                        <div class="p-3 mb-4 bg-dark bg-opacity-60 border border-secondary border-opacity-50 rounded-3">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 border-bottom border-secondary border-opacity-25 pb-2">
                                <div>
                                    <h5 class="fw-bold text-info font-monospace d-inline mb-0">@m.ManifestBaseNumber</h5>
                                    <span class="badge bg-primary ms-2">متجه إلى: @m.DestinationBranchName</span>
                                    <span class="text-muted small ms-2">السائق: @m.DriverName (@m.VehicleNumber)</span>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-dark table-bordered align-middle text-center small mb-0 border-secondary">
                                    <thead class="table-secondary text-dark fw-bold">
                                        <tr>
                                            <th>الصنف</th>
                                            <th>اللوط</th>
                                            <th>المشحون</th>
                                            <th>الأوعية المشحونة</th>
                                            <th style="width: 14%;">الكمية المستلمة فعلياً</th>
                                            <th style="width: 10%;">سرافيس/صواني</th>
                                            <th style="width: 10%;">أسبات مستلمة</th>
                                            <th style="width: 20%;">ملاحظات الفرع</th>
                                            <th>الإجراء</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in m.Lines.Where(l => l.Status == "IN_TRANSIT"))
                                        {
                                            <tr>
                                                <td class="text-start ps-3 fw-bold text-white">@item.ItemName</td>
                                                <td class="font-monospace text-muted">@(item.BatchNumber ?? "---")</td>
                                                <td class="fw-bold font-monospace text-primary">@item.DispatchedQty.ToString("N1") @item.Unit</td>
                                                <td class="small">
                                                    <div>@item.InnerCount @item.ContainerType</div>
                                                    <small class="text-warning font-monospace">@item.CrateCount سبت</small>
                                                </td>
                                                <td>
                                                    <input type="number" step="0.5" class="form-control form-control-sm bg-dark text-white border-success font-monospace fw-bold text-center"
                                                           @bind="item.TempReceivedQty" />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary font-monospace text-center"
                                                           @bind="item.TempReceivedInnerCount" />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary font-monospace text-center"
                                                           @bind="item.TempReceivedCrateCount" />
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                                           placeholder="أي ملاحظات أو كسر..." @bind="item.TempNotes" />
                                                </td>
                                                <td>
                                                    <!-- زر اعتماد البند محمي بصلاحية الاستلام -->
                                                    <AuthorizeAction Permission="Logistics.Transfers.Receive">
                                                        <button class="btn btn-success btn-sm px-3 fw-bold" @onclick="() => SubmitReceiveSingleLine(item)" disabled="@isProcessing">
                                                            ✓ اعتماد البند
                                                        </button>
                                                    </AuthorizeAction>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (activeTab == "dispute")
        {
            <!-- ========================================== -->
            <!-- تبويب 4: لجنة فض المنازعات صنفاً بصنف     -->
            <!-- ========================================== -->
            <div class="content-card shadow-sm p-3">
                <h5 class="text-danger fw-bold mb-3"><i class="bi bi-hammer me-2"></i>لجنة فض منازعات عجز وتلف الشحن بين الكنترول والفروع</h5>
                @if (!DisputedItems.Any())
                {
                    <div class="text-center text-muted py-5 fw-bold">لا توجد أي أصناف متنازع عليها حالياً. جميع الاستلامات مطابقة!</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-bordered align-middle text-center small mb-0 border-secondary">
                            <thead class="table-danger text-dark fw-bold">
                                <tr>
                                    <th>رقم الشحنة</th>
                                    <th>الفرع المستلم</th>
                                    <th>الصنف المتأثر</th>
                                    <th>المشحون</th>
                                    <th>العجز المثبت</th>
                                    <th style="width: 14%;">الكمية المقبولة للفرع</th>
                                    <th style="width: 20%;">تحميل مسؤولية العجز</th>
                                    <th>قرار اللجنة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trf in DisputedItems)
                                {
                                    <tr>
                                        <td class="font-monospace text-info fw-bold">@trf.TransferNumber</td>
                                        <td>@trf.DestinationBranchName</td>
                                        <td class="fw-bold text-white">@trf.ItemName</td>
                                        <td class="font-monospace">@trf.DispatchedQty.ToString("N1") @trf.Unit</td>
                                        <td class="font-monospace text-danger fw-bold">
                                            @((trf.DispatchedQty - (trf.ReceivedQty ?? 0)).ToString("N1")) @trf.Unit
                                        </td>
                                        <td>
                                            <input type="number" step="0.5" class="form-control form-control-sm bg-dark text-white border-success fw-bold font-monospace text-center"
                                                   @bind="trf.TempFinalQty" />
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm bg-dark text-white border-secondary fw-bold" @bind="trf.TempChargeTo">
                                                <option value="عهدة سائق التوزيع">عهدة سائق التوزيع</option>
                                                <option value="هدر وكسر أثناء النقل">هدر وكسر أثناء النقل</option>
                                                <option value="جفاف وفقد طبيعي">جفاف وفقد طبيعي</option>
                                                <option value="تسوية جردية معتمدة">تسوية جردية معتمدة</option>
                                            </select>
                                        </td>
                                        <td>
                                            <!-- زر حسم النزاع محمي بصلاحية فض المنازعات -->
                                            <AuthorizeAction Permission="Logistics.Transfers.DisputeResolve">
                                                <button class="btn btn-danger btn-sm px-3 fw-bold" @onclick="() => SubmitResolveDispute(trf)" disabled="@isProcessing">
                                                    ⚖️ اعتماد وترصيد
                                                </button>
                                            </AuthorizeAction>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </main>

