@code {
    private string activeTab = "list";
    private string alertMessage = "";
    private bool isSuccess = false;
    private bool isProcessing = false;

    private string searchTerm = "";
    private long filterBranchId = 0;
    private string filterStatus = "";
    private DateTime? filterDateFrom;
    private DateTime? filterDateTo;

    private List<BranchTransferViewItem> transfers = new();
    private List<BranchLookupDto> branches = new();
    private List<WarehouseDto> allWarehouses = new();
    private List<WarehouseDto> branchWarehouses = new();
    private List<ItemDto> finishedItems = new();

    private MultiDispatchFormModel multiDispatch = new();

    private bool showDetailsModal = false;
    private ManifestGroupModel? selectedManifest;

    private bool showPrintModal = false;
    private ManifestGroupModel? selectedManifestForPrint;

    private List<ManifestGroupModel> GroupedManifests
    {
        get
        {
            var query = transfers.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                string term = searchTerm.Trim();
                query = query.Where(t =>
                    t.TransferNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (t.DriverName ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    t.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (filterBranchId > 0)
                query = query.Where(t => t.DestinationBranchId == filterBranchId);

            if (!string.IsNullOrWhiteSpace(filterStatus))
                query = query.Where(t => t.Status == filterStatus);

            if (filterDateFrom.HasValue)
                query = query.Where(t => t.TransferDate >= DateOnly.FromDateTime(filterDateFrom.Value));

            if (filterDateTo.HasValue)
                query = query.Where(t => t.TransferDate <= DateOnly.FromDateTime(filterDateTo.Value));

            return query
                .GroupBy(t => GetBaseManifestNumber(t.TransferNumber))
                .Select(g => new ManifestGroupModel
                {
                    ManifestBaseNumber = g.Key,
                    TransferDate = g.First().TransferDate,
                    SourceWarehouseName = g.First().SourceWarehouseName,
                    DestinationBranchName = g.First().DestinationBranchName,
                    DestinationWarehouseName = g.First().DestinationWarehouseName,
                    DriverName = g.First().DriverName,
                    VehicleNumber = g.First().VehicleNumber,
                    Lines = g.ToList(),
                    TotalDispatchedQty = g.Sum(x => x.DispatchedQty),
                    TotalReceivedQty = g.Sum(x => x.ReceivedQty ?? 0),
                    TotalInnerCount = g.Sum(x => x.InnerCount),
                    TotalCrateCount = g.Sum(x => x.CrateCount),
                    OverallStatus = g.Any(x => x.Status == "IN_DISPUTE") ? "IN_DISPUTE" :
                                    g.Any(x => x.Status == "IN_TRANSIT") ? "IN_TRANSIT" : "COMPLETED"
                })
                .ToList();
        }
    }

    private string GetBaseManifestNumber(string fullNumber)
    {
        if (string.IsNullOrEmpty(fullNumber)) return "";
        var parts = fullNumber.Split('-');
        if (parts.Length >= 4) return $"{parts[0]}-{parts[1]}-{parts[2]}";
        return fullNumber;
    }

    private IEnumerable<ManifestGroupModel> InTransitManifests =>
        GroupedManifests.Where(m => m.Lines.Any(l => l.Status == "IN_TRANSIT"));

    private IEnumerable<BranchTransferViewItem> DisputedItems =>
        transfers.Where(t => t.Status == "IN_DISPUTE");

    private int InTransitItemsCount => transfers.Count(t => t.Status == "IN_TRANSIT");
    private int DisputedItemsCount => transfers.Count(t => t.Status == "IN_DISPUTE");

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadData();
        AddNewDispatchLine();
    }

    private async Task LoadLookups()
    {
        try
        {
            long cId = State?.CompanyId > 0 ? State.CompanyId : 1;
            var res = await Http.GetFromJsonAsync<TransfersLookupsResult>($"api/BranchTransfers/lookups?companyId={cId}");
            if (res != null)
            {
                branches = res.Branches ?? new();
                finishedItems = res.Items ?? new();
                allWarehouses = res.Warehouses ?? new();
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        isProcessing = true;
        try
        {
            long cId = State?.CompanyId > 0 ? State.CompanyId : 1;
            var data = await Http.GetFromJsonAsync<List<BranchTransferViewItem>>($"api/BranchTransfers?companyId={cId}");
            transfers = data ?? new();

            foreach (var t in transfers)
            {
                if (t.TempReceivedQty == 0) t.TempReceivedQty = t.DispatchedQty;
                if (t.TempReceivedInnerCount == 0) t.TempReceivedInnerCount = t.InnerCount;
                if (t.TempReceivedCrateCount == 0) t.TempReceivedCrateCount = t.CrateCount;
                if (t.TempFinalQty == 0) t.TempFinalQty = t.ReceivedQty ?? t.DispatchedQty;
                if (string.IsNullOrEmpty(t.TempChargeTo)) t.TempChargeTo = "عهدة سائق التوزيع";
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void OnDispatchBranchChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out long bId))
        {
            multiDispatch.DestinationBranchId = bId;
            if (bId > 0)
            {
                branchWarehouses = allWarehouses.Where(w => w.BranchId == bId).ToList();
                multiDispatch.DestinationWarehouseId = branchWarehouses.FirstOrDefault()?.Id ?? 0;
            }
            else
            {
                branchWarehouses.Clear();
                multiDispatch.DestinationWarehouseId = 0;
            }
        }
    }

    private void AddNewDispatchLine()
    {
        multiDispatch.Items.Add(new DispatchItemRowModel());
    }

    private async Task OnItemSelected(DispatchItemRowModel row, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out long itemId))
        {
            row.ItemId = itemId;
            if (itemId > 0)
            {
                var itm = finishedItems.FirstOrDefault(x => x.Id == itemId);
                if (itm != null)
                {
                    if (itm.ItemName.Contains("جاتوه") || itm.ItemName.Contains("سواريه"))
                        row.ContainerType = "سرفيس";
                    else if (itm.ItemName.Contains("تورت"))
                        row.ContainerType = "علبة/كرتونة";
                    else
                        row.ContainerType = "صاج/صينية";

                    try
                    {
                        var batchRes = await Http.GetFromJsonAsync<BatchLookupResult>($"api/BranchTransfers/item-batch/{itemId}");
                        if (batchRes != null && !string.IsNullOrEmpty(batchRes.BatchNumber))
                        {
                            row.BatchNumber = batchRes.BatchNumber;
                        }
                        else
                        {
                            row.BatchNumber = $"LOT-{DateTime.Today:yyyyMMdd}-{itemId:D2}";
                        }
                    }
                    catch
                    {
                        row.BatchNumber = $"LOT-{DateTime.Today:yyyyMMdd}-{itemId:D2}";
                    }
                }
            }
            else
            {
                row.BatchNumber = "";
            }
        }
    }

    private async Task SubmitMultiDispatch()
    {
        if (multiDispatch.DestinationBranchId <= 0 || multiDispatch.DestinationWarehouseId <= 0)
        {
            alertMessage = "يرجى تحديد الفرع ومستودع الفرع المستلم.";
            isSuccess = false;
            return;
        }

        if (!multiDispatch.Items.Any(i => i.ItemId > 0 && i.DispatchedQty > 0))
        {
            alertMessage = "يجب إضافة صنف واحد على الأقل بكمية صالحة.";
            isSuccess = false;
            return;
        }

        isProcessing = true;
        try
        {
            var controlWh = allWarehouses.FirstOrDefault(w => (w.WarehouseName ?? "").Contains("كنترول") || (w.WarehouseName ?? "").Contains("رئيسي")) ?? allWarehouses.FirstOrDefault();
            multiDispatch.SourceWarehouseId = controlWh?.Id ?? 1;
            multiDispatch.DispatcherName = State?.FullName ?? "مسؤول الكنترول";
            multiDispatch.CompanyId = State?.CompanyId > 0 ? State.CompanyId : 1;

            var res = await Http.PostAsJsonAsync("api/BranchTransfers/dispatch-multi", multiDispatch);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = "✓ تم شحن المانيفست بالكامل بنجاح!";
                isSuccess = true;
                multiDispatch = new MultiDispatchFormModel();
                AddNewDispatchLine();
                activeTab = "list";
                await LoadData();
            }
            else
            {
                alertMessage = await res.Content.ReadAsStringAsync();
                isSuccess = false;
            }
        }
        catch (Exception ex) { alertMessage = ex.Message; isSuccess = false; }
        finally { isProcessing = false; }
    }

    private async Task SubmitReceiveSingleLine(BranchTransferViewItem item)
    {
        isProcessing = true;
        try
        {
            var body = new
            {
                TransferId = item.Id,
                ReceivedQty = item.TempReceivedQty,
                ReceivedInnerCount = item.TempReceivedInnerCount,
                ReceivedCrateCount = item.TempReceivedCrateCount,
                ReceiverName = State?.FullName ?? "أمين مستودع الفرع",
                Notes = item.TempNotes
            };

            var res = await Http.PostAsJsonAsync("api/BranchTransfers/receive-line", body);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = $"✓ تم تسجيل استلام صنف ({item.ItemName}) بنجاح!";
                isSuccess = true;
                await LoadData();
            }
        }
        catch (Exception ex) { alertMessage = ex.Message; isSuccess = false; }
        finally { isProcessing = false; }
    }

    private async Task SubmitResolveDispute(BranchTransferViewItem trf)
    {
        isProcessing = true;
        try
        {
            var body = new
            {
                TransferId = trf.Id,
                FinalAcceptedQty = trf.TempFinalQty,
                ChargeTo = trf.TempChargeTo,
                ResolvedBy = State?.FullName ?? "اللجنة المشتركة",
                Notes = "تم حسم النزاع واعتماد التسوية المخزنية للصنف"
            };

            var res = await Http.PostAsJsonAsync("api/BranchTransfers/resolve-dispute", body);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = $"✓ تم فض نزاع ({trf.ItemName}) وترصيد الكمية بنجاح!";
                isSuccess = true;
                await LoadData();
            }
        }
        catch (Exception ex) { alertMessage = ex.Message; isSuccess = false; }
        finally { isProcessing = false; }
    }

    private void OpenManifestDetails(ManifestGroupModel m)
    {
        selectedManifest = m;
        showDetailsModal = true;
    }

    private void PrintManifest(ManifestGroupModel m)
    {
        selectedManifestForPrint = m;
        showPrintModal = true;
    }

    private async Task TriggerBrowserPrint() => await JS.InvokeVoidAsync("window.print");

    private async Task ExportToExcel()
    {
        try
        {
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("رقم الشحنة,تاريخ الشحن,المستودع المصدر,الفرع المستلم,الصنف,اللوط,الكمية المشحونة,الوعاء الداخلي,عدد السرافيس_الصواني,عدد الأسبات,الكمية المستلمة,السائق,السيارة,الحالة");

            foreach (var t in transfers)
            {
                csv.AppendLine($"\"{t.TransferNumber ?? ""}\",\"{t.TransferDate:yyyy-MM-dd}\",\"{t.SourceWarehouseName ?? ""}\",\"{t.DestinationBranchName ?? ""}\",\"{t.ItemName ?? ""}\",\"{t.BatchNumber ?? ""}\",{t.DispatchedQty},\"{t.ContainerType ?? ""}\",{t.InnerCount},{t.CrateCount},\"{t.ReceivedQty}\",\"{t.DriverName ?? ""}\",\"{t.VehicleNumber ?? ""}\",\"{t.Status ?? ""}\"");
            }

            var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8;base64,{base64}'; a.download = 'BranchTransfers_{DateTime.Now:yyyyMMdd_HHmm}.csv'; a.click();");
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ في تصدير Excel: {ex.Message}";
            isSuccess = false;
        }
    }

