    private async Task ExportToExcelAsync()
    {
        if (!employees.Any())
        {
            errorMessage = "لا يوجد عمال مسجلين لتصديرهم.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("كود_العامل,اسم_العامل,القسم_التابع_له,المسمى_الوظيفي,الحالة");

            foreach (var emp in employees)
            {
                var deptName = departments.FirstOrDefault(d => d.Id == emp.DepartmentId)?.DepartmentName ?? "غير محدد";
                var titleName = emp.DisplayJobTitle;
                var status = emp.Active ? "نشط" : "معطل";
                sb.AppendLine($"{EscapeCsv(emp.DisplayCode)},{EscapeCsv(emp.DisplayName)},{EscapeCsv(deptName)},{EscapeCsv(titleName)},{status}");
            }

            var fileName = $"كشف_القوة_العاملة_أبو_عادل_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            successMessage = "تم تصدير كشف العمال إلى إكسيل بنجاح.";
        }
        catch (Exception ex)
        {
            errorMessage = $"حدث خطأ أثناء التصدير: {ex.Message}";
        }
    }

