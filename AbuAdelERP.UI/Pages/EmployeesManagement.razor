    private async Task SaveEmployeeAsync()
    {
        if (string.IsNullOrWhiteSpace(currentEmp.Name) || currentEmp.DepartmentId == null || currentEmp.DepartmentId <= 0)
        {
            errorMessage = "يرجى كتابة اسم العامل واختيار القسم التابع له.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        try
        {
            var code = currentEmp.DisplayCode.Trim();
            var payload = new
            {
                Id = currentEmp.Id,
                CompanyId = currentEmp.CompanyId,
                DepartmentId = currentEmp.DepartmentId,
                JobTitleId = currentEmp.JobTitleId > 0 ? currentEmp.JobTitleId : null,
                Name = currentEmp.Name.Trim(),
                WorkerCode = code,
                EmployeeCode = code,
                Active = currentEmp.Active
            };

            HttpResponseMessage res;
            if (currentEmp.Id > 0)
            {
                res = await Http.PutAsJsonAsync($"api/employees/{currentEmp.Id}", payload);
            }
            else
            {
                res = await Http.PostAsJsonAsync("api/employees", payload);
            }

            if (res.IsSuccessStatusCode)
            {
                successMessage = currentEmp.Id > 0 ? "تم تحديث بيانات العامل بنجاح." : "تم تسجيل العامل الجديد بنجاح.";
                ResetForm();
                await LoadDataAsync();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                errorMessage = $"فشل الحفظ: {err}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء الاتصال: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

