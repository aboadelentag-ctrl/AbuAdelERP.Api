    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        errorMessage = null;

        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1)
            {
                errorMessage = "الملف المرفوع فارغ أو لا يحتوي على صفوف بيانات.";
                return;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = ParseCsvLine(line);
                if (cols.Count >= 2)
                {
                    importedPreviewList.Add(new EmployeeImportRowDto
                    {
                        EmployeeCode = cols[0].Trim(),
                        Name = cols[1].Trim(),
                        DepartmentNameOrCode = cols.Count > 2 ? cols[2].Trim() : "",
                        JobTitleName = cols.Count > 3 ? cols[3].Trim() : "",
                        Active = cols.Count <= 4 || (cols[4].Trim() == "1" || cols[4].Trim().Equals("نشط", StringComparison.OrdinalIgnoreCase) || cols[4].Trim().Equals("مفعل", StringComparison.OrdinalIgnoreCase) || cols[4].Trim().Equals("true", StringComparison.OrdinalIgnoreCase))
                    });
                }
            }

            if (!importedPreviewList.Any())
            {
                errorMessage = "تعذر استخراج بيانات من الملف. يرجى التأكد من التنسيق.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل قراءة الملف: {ex.Message}";
        }
    }

    private List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var curVal = new StringBuilder();

        foreach (char c in line)
        {
            if (c == '\"') inQuotes = !inQuotes;
            else if (c == ',' && !inQuotes)
            {
                result.Add(curVal.ToString());
                curVal.Clear();
            }
            else curVal.Append(c);
        }
        result.Add(curVal.ToString());
        return result;
    }

    private async Task ProcessAndSaveImportAsync()
    {
        if (!importedPreviewList.Any()) return;

        isSavingImport = true;
        errorMessage = null;

        try
        {
            int updatedCount = 0;
            int createdCount = 0;

            foreach (var row in importedPreviewList)
            {
                var matchedDept = FindMatchingDepartment(row.DepartmentNameOrCode);
                var matchedTitle = FindMatchingJobTitle(row.JobTitleName);
                long? assignedTitleId = matchedTitle?.Id;

                if (assignedTitleId == null && !string.IsNullOrWhiteSpace(row.JobTitleName))
                {
                    try
                    {
                        var newTitleReq = new { TitleName = row.JobTitleName.Trim(), JobGrade = 10, HourlyRate = 25m };
                        var titleRes = await Http.PostAsJsonAsync("api/employees/job-titles", newTitleReq);
                        if (titleRes.IsSuccessStatusCode)
                        {
                            var titleJson = await titleRes.Content.ReadFromJsonAsync<JsonElement>();
                            if (titleJson.TryGetProperty("id", out var idProp) || titleJson.TryGetProperty("Id", out idProp))
                            {
                                assignedTitleId = idProp.GetInt64();
                            }
                            await LoadJobTitlesAsync();
                        }
                    }
                    catch { }
                }

                var existingEmp = employees.FirstOrDefault(e => 
                    (!string.IsNullOrWhiteSpace(row.EmployeeCode) && e.DisplayCode == row.EmployeeCode.Trim()) ||
                    NormalizeArabic(e.DisplayName) == NormalizeArabic(row.Name));

                long finalDeptId = matchedDept?.Id 
                                ?? existingEmp?.DepartmentId 
                                ?? departments.FirstOrDefault()?.Id 
                                ?? 1;

                if (existingEmp != null)
                {
                    var updatePayload = new
                    {
                        Id = existingEmp.Id,
                        Name = row.Name.Trim(),
                        WorkerCode = !string.IsNullOrWhiteSpace(row.EmployeeCode) ? row.EmployeeCode.Trim() : existingEmp.DisplayCode,
                        EmployeeCode = !string.IsNullOrWhiteSpace(row.EmployeeCode) ? row.EmployeeCode.Trim() : existingEmp.DisplayCode,
                        DepartmentId = finalDeptId,
                        JobTitleId = assignedTitleId ?? existingEmp.JobTitleId,
                        Active = row.Active
                    };
                    await Http.PutAsJsonAsync($"api/employees/{existingEmp.Id}", updatePayload);
                    updatedCount++;
                }
                else
                {
                    var insertPayload = new
                    {
                        Name = row.Name.Trim(),
                        WorkerCode = row.EmployeeCode.Trim(),
                        EmployeeCode = row.EmployeeCode.Trim(),
                        DepartmentId = finalDeptId,
                        JobTitleId = assignedTitleId,
                        Active = row.Active
                    };
                    await Http.PostAsJsonAsync("api/employees", insertPayload);
                    createdCount++;
                }
            }

            successMessage = $"اكتملت المعالجة: تم تحديث ({updatedCount}) وتوليد ({createdCount}) عاملاً مع ضبط صالاتهم ومسمياتهم بدقة.";
            CloseImportModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء حفظ العمال: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }
