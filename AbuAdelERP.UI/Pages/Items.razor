<!-- 3. نافذة استيراد الأصناف                                                                 -->
<!-- ========================================================================================= -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد دليل الأصناف من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> 
                        يدعم الاستيراد ربط الصنف بصالته الإنتاجية تلقائياً، وتعيين حالته كمفعل لتفادي حظر الأصناف بعد الاستيراد.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة الأصناف المقروءة من الملف (@importedPreviewList.Count صنف):</span>
                            <span class="badge bg-success">جاهز للاستيراد</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>الكود</th>
                                        <th class="text-start">اسم الصنف</th>
                                        <th>النوع</th>
                                        <th>القسم / الصالة</th>
                                        <th>الوحدة</th>
                                        <th>سعر البيع</th>
                                        <th>الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@row.ItemCode</td>
                                            <td class="text-start fw-bold">@row.ItemName</td>
                                            <td>@row.ItemType</td>
                                            <td class="fw-bold text-primary">@(!string.IsNullOrEmpty(row.DepartmentNameOrCode) ? row.DepartmentNameOrCode : "غير محدد")</td>
                                            <td>@row.Unit</td>
                                            <td class="font-monospace">@row.SalePrice.ToString("N2")</td>
                                            <td>
                                                <span class="badge @(row.Active ? "bg-success" : "bg-secondary")">
                                                    @(row.Active ? "مفعل" : "معطل")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@(isSavingImport || !importedPreviewList.Any())" 
                            @onclick="ProcessAndSaveImportAsync">
                        @if (isSavingImport)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري حفظ الأصناف وربطها بالصالات...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check-circle"></i> تأكيد واستيراد كافة الأصناف (@importedPreviewList.Count)</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    public class ItemDto
    {
        public long Id { get; set; }
        public long CompanyId { get; set; } = 1;
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string ItemType { get; set; } = "منتج تام";
        public string Unit { get; set; } = "كجم";
        public string? Barcode { get; set; }
        public string? Description { get; set; }
        public long? DepartmentId { get; set; }
        public string? DepartmentName { get; set; }
        public long? CategoryId { get; set; }
        public decimal SalePrice { get; set; } = 0;
        public decimal BasePrice { get; set; } = 0;
        public decimal PurchasePrice { get; set; } = 0;
        public decimal SafetyStockLevel { get; set; } = 0;
        public decimal ReorderPoint { get; set; } = 0;
        public bool Active { get; set; } = true;

        public bool HasVariants { get; set; } = false;
        public bool IsComposite { get; set; } = false;

        public DepartmentItemDto? Department { get; set; }
        public CategoryDto? Category { get; set; }

        public List<ItemUnitConversionDto> UnitsHierarchy { get; set; } = new();
        public List<ItemVariantDto> Variants { get; set; } = new();
    }

    public class ItemUnitConversionDto
    {
        public string UnitName { get; set; } = string.Empty;
        public decimal ConversionFactor { get; set; } = 1;
        public string? Barcode { get; set; }
    }

    public class ItemVariantDto
    {
        public long Id { get; set; }
        public string VariantCode { get; set; } = string.Empty;
        public string VariantName { get; set; } = string.Empty;
        public decimal? PriceOverride { get; set; }
        public string? Barcode { get; set; }
    }

    public class CategoryDto
    {
        public long Id { get; set; }
        public long CompanyId { get; set; } = 1;
        public string CategoryCode { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public string ItemType { get; set; } = "منتج تام";
        public string? Description { get; set; }
        public bool Active { get; set; } = true;
    }

    public class DepartmentItemDto
    {
        public long Id { get; set; }
        public string DepartmentCode { get; set; } = string.Empty;
        public string DepartmentName { get; set; } = string.Empty;
    }

    public class ItemImportRowDto
    {
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string ItemType { get; set; } = "منتج تام";
        public string DepartmentNameOrCode { get; set; } = string.Empty;
        public string Unit { get; set; } = "كجم";
        public decimal SalePrice { get; set; } = 0;
        public bool Active { get; set; } = true;
    }

    private List<ItemDto> items = new();
    private List<CategoryDto> categories = new();
    private List<DepartmentItemDto> departments = new();
    private ItemDto currentItem = new();
    private CategoryDto currentCategory = new();
    private List<ItemImportRowDto> importedPreviewList = new();

    private HashSet<long> expandedItemIds = new();

    private bool isLoading = true;
    private bool isSavingItem = false;
    private bool isSavingCategory = false;
    private bool isSavingImport = false;
    private bool isItemModalOpen = false;
    private bool isCategoriesModalOpen = false;
    private bool isImportModalOpen = false;
    private int itemModalActiveTab = 1;

    private string? selectedTypeFilter = null;
    private string searchTerm = "";
    private long selectedCategoryFilter = 0;
    private long selectedDeptFilter = 0;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            departments = await Http.GetFromJsonAsync<List<DepartmentItemDto>>("api/departments") ?? new();
        }
        catch { }

        try
        {
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/itemcategories") ?? new();
        }
        catch { }

        try
        {
            items = await Http.GetFromJsonAsync<List<ItemDto>>("api/items") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب الأصناف: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleExpand(long itemId)
    {
        if (expandedItemIds.Contains(itemId))
        {
            expandedItemIds.Remove(itemId);
        }
        else
        {
            expandedItemIds.Add(itemId);
        }
    }

    private IEnumerable<ItemDto> FilteredItems
    {
        get
        {
            var query = items.AsEnumerable();

            if (!string.IsNullOrEmpty(selectedTypeFilter))
            {
                query = query.Where(i => i.ItemType == selectedTypeFilter);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(i => 
                    i.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    i.ItemCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(i.Barcode) && i.Barcode.Contains(term)) ||
                    i.Variants.Any(v => v.VariantName.Contains(term, StringComparison.OrdinalIgnoreCase) || v.VariantCode.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (selectedCategoryFilter > 0)
            {
                query = query.Where(i => i.CategoryId == selectedCategoryFilter);
            }

            if (selectedDeptFilter > 0)
            {
                query = query.Where(i => i.DepartmentId == selectedDeptFilter);
            }

            return query;
        }
    }

    private void FilterByType(string? type) => selectedTypeFilter = type;

    private void ResetFilters()
    {
        selectedTypeFilter = null;
        searchTerm = "";
        selectedCategoryFilter = 0;
        selectedDeptFilter = 0;
    }

    private string GetDisplayDeptName(ItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.DepartmentName) && item.DepartmentName != "-")
            return item.DepartmentName;

        if (item.Department != null && !string.IsNullOrWhiteSpace(item.Department.DepartmentName))
            return item.Department.DepartmentName;

        if (item.DepartmentId.HasValue && item.DepartmentId.Value > 0)
        {
            var found = departments.FirstOrDefault(d => d.Id == item.DepartmentId.Value);
            if (found != null) return found.DepartmentName;
        }

        return "-";
    }

    private string GetTypeBadgeClass(string type) => type switch
    {
        "منتج تام" => "bg-primary",
        "نصف مصنع" => "bg-warning text-dark",
        "خامات" => "bg-success",
        "مواد تعبئة وتغليف" => "bg-info text-dark",
        "أصول / حاويات تداول" => "bg-secondary",
        _ => "bg-dark"
    };

    private void OpenCreateItemModal()
    {
        currentItem = new ItemDto
        {
            CompanyId = 1,
            ItemType = selectedTypeFilter ?? "منتج تام",
            DepartmentId = departments.FirstOrDefault()?.Id,
            Unit = "كجم",
            Active = true
        };
        itemModalActiveTab = 1;
        isItemModalOpen = true;
    }

    private void EditItem(ItemDto item)
    {
        currentItem = new ItemDto
        {
            Id = item.Id,
            CompanyId = item.CompanyId,
            ItemCode = item.ItemCode,
            ItemName = item.ItemName,
            ItemType = item.ItemType,
            Unit = item.Unit,
            Barcode = item.Barcode,
            Description = item.Description,
            DepartmentId = item.DepartmentId,
            DepartmentName = item.DepartmentName,
            CategoryId = item.CategoryId,
            SalePrice = item.SalePrice > 0 ? item.SalePrice : item.BasePrice,
            BasePrice = item.BasePrice,
            PurchasePrice = item.PurchasePrice,
            SafetyStockLevel = item.SafetyStockLevel,
            ReorderPoint = item.ReorderPoint,
            Active = item.Active,
            HasVariants = item.HasVariants || item.Variants.Any(),
            IsComposite = item.IsComposite,
            UnitsHierarchy = item.UnitsHierarchy.Select(u => new ItemUnitConversionDto { UnitName = u.UnitName, ConversionFactor = u.ConversionFactor, Barcode = u.Barcode }).ToList(),
            Variants = item.Variants.Select(v => new ItemVariantDto { Id = v.Id, VariantCode = v.VariantCode, VariantName = v.VariantName, PriceOverride = v.PriceOverride, Barcode = v.Barcode }).ToList()
        };
        itemModalActiveTab = 1;
        isItemModalOpen = true;
    }

    private void CloseItemModal()
    {
        isItemModalOpen = false;
        currentItem = new ItemDto();
    }

    private void AddNewUnitRow()
    {
        currentItem.UnitsHierarchy.Add(new ItemUnitConversionDto
        {
            UnitName = "",
            ConversionFactor = 12
        });
    }

    private void AddNewVariantRow()
    {
        var suffix = (currentItem.Variants.Count + 1).ToString("D2");
        currentItem.Variants.Add(new ItemVariantDto
        {
            VariantCode = $"{currentItem.ItemCode}-{suffix}",
            VariantName = "",
            PriceOverride = currentItem.SalePrice,
            Barcode = currentItem.Barcode
        });
    }

    private async Task SaveItemAsync()
    {
        if (string.IsNullOrWhiteSpace(currentItem.ItemName) || string.IsNullOrWhiteSpace(currentItem.ItemCode))
        {
            errorMessage = "يرجى إدخال كود واسم الصنف بشكل صحيح.";
            return;
        }

        isSavingItem = true;
        errorMessage = null;

        try
        {
            var dept = departments.FirstOrDefault(d => d.Id == currentItem.DepartmentId);
            var payload = new
            {
                Id = currentItem.Id,
                CompanyId = currentItem.CompanyId > 0 ? currentItem.CompanyId : 1,
                ItemCode = currentItem.ItemCode.Trim(),
                ItemName = currentItem.ItemName.Trim(),
                ItemType = currentItem.ItemType,
                Unit = currentItem.Unit.Trim(),
                Barcode = currentItem.Barcode,
                Description = currentItem.Description,
                DepartmentId = currentItem.DepartmentId,
                DepartmentName = dept?.DepartmentName ?? currentItem.DepartmentName,
                CategoryId = currentItem.CategoryId > 0 ? currentItem.CategoryId : 1,
                SalePrice = currentItem.SalePrice,
                BasePrice = currentItem.SalePrice,
                PurchasePrice = currentItem.PurchasePrice,
                SafetyStock = currentItem.SafetyStockLevel,
                SafetyStockLevel = currentItem.SafetyStockLevel,
                ReorderLevel = currentItem.ReorderPoint,
                ReorderPoint = currentItem.ReorderPoint,
                Active = currentItem.Active,
                HasVariants = currentItem.HasVariants,
                IsComposite = currentItem.IsComposite,
                UnitsHierarchy = currentItem.UnitsHierarchy,
                Variants = currentItem.Variants
            };

            HttpResponseMessage res;
            if (currentItem.Id > 0)
            {
                res = await Http.PutAsJsonAsync($"api/items/{currentItem.Id}", payload);
            }
            else
            {
                res = await Http.PostAsJsonAsync("api/items", payload);
            }

            if (res.IsSuccessStatusCode)
            {
                successMessage = currentItem.Id > 0 ? "تم تحديث بيانات الصنف ونكهاته بنجاح." : "تمت إضافة الصنف ونكهاته بنجاح.";
                if (currentItem.Id > 0) expandedItemIds.Add(currentItem.Id);
                CloseItemModal();
                await LoadDataAsync();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                errorMessage = $"فشل حفظ الصنف: {err}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في الاتصال: {ex.Message}";
        }
        finally
        {
            isSavingItem = false;
        }
    }

