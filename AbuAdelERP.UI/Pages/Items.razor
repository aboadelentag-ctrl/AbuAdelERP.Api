@page "/items"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>مركز إدارة الأصناف والمواد الشامل - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">
    
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border-start border-warning border-4 flex-wrap gap-2">
        <div>
            <h4 class="mb-1 text-dark fw-bold">📦 مركز إدارة الأصناف والمواد الشامل (Item Master Hub)</h4>
            <small class="text-muted">إدارة موحدة لجميع الأصناف: منتجات تامة، نصف مصنع، خامات، مواد تعبئة، وحاويات التداول</small>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-warning btn-sm fw-bold shadow-sm" @onclick="OpenCreateItemModal">
                <i class="bi bi-plus-circle me-1"></i> إضافة صنف جديد
            </button>
            <button class="btn btn-outline-dark btn-sm fw-bold shadow-sm" @onclick="OpenCategoriesModal">
                <i class="bi bi-tags me-1"></i> 🏷️ تصنيفات الأصناف
            </button>
            <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportToExcelAsync">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل
            </button>
            <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                <i class="bi bi-download me-1"></i> قالب الاستيراد
            </button>
            <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد إكسيل
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadDataAsync">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-1"></i> @successMessage
            <button type="button" class="btn-close py-2" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
            <button type="button" class="btn-close py-2" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- بطاقات التصفية السريعة حسب نوع الصنف -->
    <div class="card shadow-sm mb-3 border-0 bg-white">
        <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
            <span class="fw-bold text-secondary me-2 small">التصفية السريعة:</span>
            <button class="btn btn-sm @(selectedTypeFilter == null ? "btn-dark" : "btn-outline-dark") rounded-pill px-3" 
                    @onclick="() => FilterByType(null)">
                الكل (@items.Count)
            </button>
            <button class="btn btn-sm @(selectedTypeFilter == "منتج تام" ? "btn-primary fw-bold" : "btn-outline-primary") rounded-pill px-3" 
                    @onclick='() => FilterByType("منتج تام")'>
                🍰 منتج تام (@items.Count(i => i.ItemType == "منتج تام"))
            </button>
            <button class="btn btn-sm @(selectedTypeFilter == "نصف مصنع" ? "btn-warning text-dark fw-bold" : "btn-outline-warning text-dark") rounded-pill px-3" 
                    @onclick='() => FilterByType("نصف مصنع")'>
                🥣 نصف مصنع / خلطات (@items.Count(i => i.ItemType == "نصف مصنع"))
            </button>
            <button class="btn btn-sm @(selectedTypeFilter == "خامات" ? "btn-success fw-bold" : "btn-outline-success") rounded-pill px-3" 
                    @onclick='() => FilterByType("خامات")'>
                🌾 خامات ومستلزمات (@items.Count(i => i.ItemType == "خامات"))
            </button>
            <button class="btn btn-sm @(selectedTypeFilter == "مواد تعبئة وتغليف" ? "btn-info text-dark fw-bold" : "btn-outline-info text-dark") rounded-pill px-3" 
                    @onclick='() => FilterByType("مواد تعبئة وتغليف")'>
                📦 مواد تعبئة وتغليف (@items.Count(i => i.ItemType == "مواد تعبئة وتغليف"))
            </button>
            <button class="btn btn-sm @(selectedTypeFilter == "أصول / حاويات تداول" ? "btn-secondary fw-bold" : "btn-outline-secondary") rounded-pill px-3" 
                    @onclick='() => FilterByType("أصول / حاويات تداول")'>
                🛒 أصول وحاويات تداول (@items.Count(i => i.ItemType == "أصول / حاويات تداول"))
            </button>
        </div>
    </div>

    <!-- شريط البحث والفلترة -->
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body p-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" class="form-control form-control-sm" placeholder="بحث بالاسم، الكود، أو الباركود..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="selectedCategoryFilter">
                        <option value="0">-- كل التصنيفات --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="selectedDeptFilter">
                        <option value="0">-- كل الأقسام والصالات --</option>
                        @foreach (var dept in departments)
                        {
                            <option value="@dept.Id">@dept.DepartmentName</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-danger btn-sm w-100" title="تفريغ الفلاتر" @onclick="ResetFilters">✕</button>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول عرض الأصناف الشامل -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center small">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;">الكود</th>
                        <th class="text-start">اسم الصنف</th>
                        <th>النوع</th>
                        <th>القسم / الصالة</th>
                        <th>الوحدة</th>
                        <th>سعر البيع</th>
                        <th>حد الأمان</th>
                        <th>حد الطلب</th>
                        <th>الخصائص</th>
                        <th>الحالة</th>
                        <th style="width: 140px;">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="11" class="py-4 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري تحميل مركز الأصناف...
                            </td>
                        </tr>
                    }
                    else if (!FilteredItems.Any())
                    {
                        <tr>
                            <td colspan="11" class="py-4 text-muted">لا توجد أصناف مطابقة للبحث أو التصفية الحالية.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in FilteredItems)
                        {
                            <tr @key="item.Id">
                                <td class="font-monospace fw-bold text-secondary">@item.ItemCode</td>
                                <td class="text-start fw-bold text-dark">
                                    @item.ItemName
                                    @if (item.Variants.Any())
                                    {
                                        <button class="btn btn-sm @(expandedItemIds.Contains(item.Id) ? "btn-info text-dark" : "btn-outline-info") py-0 px-2 ms-2 fw-bold" 
                                                style="font-size: 0.72rem;" @onclick="() => ToggleExpand(item.Id)">
                                            @(expandedItemIds.Contains(item.Id) ? "▲ إخفاء النكهات" : $"▼ عرض النكهات ({item.Variants.Count})")
                                        </button>
                                    }
                                </td>
                                <td>
                                    <span class="badge @GetTypeBadgeClass(item.ItemType)">
                                        @item.ItemType
                                    </span>
                                </td>
                                <td class="fw-bold text-primary">
                                    @GetDisplayDeptName(item)
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.Unit</span></td>
                                <td class="fw-bold font-monospace text-primary">@(item.SalePrice > 0 ? $"{item.SalePrice:N2} ج.م" : (item.BasePrice > 0 ? $"{item.BasePrice:N2} ج.م" : "-"))</td>
                                <td class="font-monospace text-muted">@item.SafetyStockLevel.ToString("N2")</td>
                                <td class="font-monospace text-muted">@item.ReorderPoint.ToString("N2")</td>
                                <td>
                                    @if (item.HasVariants || item.Variants.Any())
                                    {
                                        <span class="badge bg-info text-dark fw-bold" title="صنف يحتوي على نكهات أو مقاسات متعددة">
                                            متنوع (@item.Variants.Count)
                                        </span>
                                    }
                                    @if (item.UnitsHierarchy.Any())
                                    {
                                        <span class="badge bg-secondary ms-1" title="له وحدات فرعية متعددة">وحدات متعددة</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(item.Active ? "bg-success" : "bg-danger")">
                                        @(item.Active ? "مفعل" : "معطل")
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm py-0 px-2 fw-bold me-1" @onclick="() => EditItem(item)">
                                        تعديل
                                    </button>
                                    <button class="btn btn-outline-@(item.Active ? "danger" : "success") btn-sm py-0 px-2 fw-bold" @onclick="() => ToggleItemStatus(item)">
                                        @(item.Active ? "إيقاف" : "تفعيل")
                                    </button>
                                </td>
                            </tr>

                            @if (expandedItemIds.Contains(item.Id) && item.Variants.Any())
                            {
                                @foreach (var v in item.Variants)
                                {
                                    <tr class="table-light text-muted">
                                        <td class="font-monospace fw-bold text-primary pe-4">↳ @v.VariantCode</td>
                                        <td class="text-start pe-4">
                                            <span class="fw-bold text-dark">@v.VariantName</span>
                                            <span class="badge bg-white text-secondary border font-monospace ms-2">باركود: @(!string.IsNullOrEmpty(v.Barcode) ? v.Barcode : "-")</span>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">نكهة / مقاس</span></td>
                                        <td>@GetDisplayDeptName(item)</td>
                                        <td>@item.Unit</td>
                                        <td class="font-monospace text-success fw-bold">@(v.PriceOverride > 0 ? $"{v.PriceOverride:N2} ج.م" : $"{item.SalePrice:N2} ج.م")</td>
                                        <td colspan="4" class="text-muted small">نوع فرعي تابع لـ: (@item.ItemName)</td>
                                        <td>-</td>
                                    </tr>
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================================================================= -->
<!-- 1. نافذة الصنف الكبرى التفاعلية: التبويبات الأربعة                                         -->
<!-- ========================================================================================= -->
@if (isItemModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                
                <div class="modal-header bg-dark text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        @(currentItem.Id > 0 ? $"✏️ تعديل الصنف: {currentItem.ItemName}" : "➕ إضافة صنف جديد إلى المنظومة")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseItemModal"></button>
                </div>

                <div class="bg-light border-bottom px-3 pt-2">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <button class="nav-link @(itemModalActiveTab == 1 ? "active fw-bold text-primary" : "text-secondary")" 
                                    @onclick="() => itemModalActiveTab = 1">
                                1. البيانات الأساسية والتصنيف
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(itemModalActiveTab == 2 ? "active fw-bold text-primary" : "text-secondary")" 
                                    @onclick="() => itemModalActiveTab = 2">
                                2. منظومة الوحدات والأوزان (@currentItem.UnitsHierarchy.Count وحدات)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(itemModalActiveTab == 3 ? "active fw-bold text-primary" : "text-secondary")" 
                                    @onclick="() => itemModalActiveTab = 3">
                                3. الأرصدة ومحددات المخزون
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(itemModalActiveTab == 4 ? "active fw-bold text-primary" : "text-secondary")" 
                                    @onclick="() => itemModalActiveTab = 4">
                                4. التشكيلات المركبة والخصائص والأنواع المتعددة (@currentItem.Variants.Count أنواع)
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="modal-body p-3">
                    <!-- TAB 1: البيانات الأساسية -->
                    @if (itemModalActiveTab == 1)
                    {
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-secondary">كود الصنف <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm font-monospace fw-bold" placeholder="مثال: 301001" 
                                       @bind="currentItem.ItemCode" />
                            </div>

                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-secondary">اسم الصنف الكامل <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm fw-bold" placeholder="مثال: بسبوسة سادة / دقيق فاخر" 
                                       @bind="currentItem.ItemName" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-secondary">نوع الصنف في دورة الإنتاج <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm fw-bold" @bind="currentItem.ItemType">
                                    <option value="منتج تام">🍰 منتج تام (حلويات وتام)</option>
                                    <option value="نصف مصنع">🥣 نصف مصنع / خلطات وتجهيزات</option>
                                    <option value="خامات">🌾 خامات ومستلزمات</option>
                                    <option value="مواد تعبئة وتغليف">📦 مواد تعبئة وتغليف</option>
                                    <option value="أصول / حاويات تداول">🛒 أصول / حاويات تداول (أسبات وصواني)</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-secondary">القسم / الصالة المسؤولة <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" @bind="currentItem.DepartmentId">
                                    <option value="">-- اختر الصالة أو القسم --</option>
                                    @foreach (var d in departments)
                                    {
                                        <option value="@d.Id">@d.DepartmentName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-secondary">تصنيف الصنف</label>
                                <select class="form-select form-select-sm" @bind="currentItem.CategoryId">
                                    <option value="">-- اختر التصنيف --</option>
                                    @foreach (var c in categories)
                                    {
                                        <option value="@c.Id">@c.CategoryName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-secondary">الباركود الرئيسي (Barcode)</label>
                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="مثال: 6221234567890" 
                                       @bind="currentItem.Barcode" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-secondary">وصف الصنف وملاحظات التشغيل</label>
                                <input type="text" class="form-control form-control-sm" placeholder="ملاحظات توجيهية عن الصنف وطريقة حفظه..." 
                                       @bind="currentItem.Description" />
                            </div>

                            <div class="col-md-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" id="itemActiveCheck" @bind="currentItem.Active" />
                                    <label class="form-check-label small fw-bold" for="itemActiveCheck">حالة الصنف: مفعل ومتاح في حركة المخازن والتشغيل</label>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- TAB 2: منظومة الوحدات والأوزان المتعددة -->
                    @if (itemModalActiveTab == 2)
                    {
                        <div class="card p-3 bg-light border-0 mb-3">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-dark">الوحدة الأساسية للمخزون (Base Unit) <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm fw-bold text-primary" placeholder="مثال: قطعة / كجم" 
                                           @bind="currentItem.Unit" />
                                    <small class="text-muted">أصغر وحدة يتعامل بها الجرد وحساب التكاليف</small>
                                </div>
                                <div class="col-md-8">
                                    <div class="alert alert-info py-2 px-3 small mb-0">
                                        <i class="bi bi-info-circle me-1"></i> يمكنك إضافة وحدات متعددة (مثل: كرتونة، علبة، دستة، شيكارة) وتحديد معامل التحويل المباشر مع الوحدة الأساسية.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border mb-2">
                            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                                <span class="small fw-bold text-dark">جدول الوحدات البديلة والتحويلات</span>
                                <button type="button" class="btn btn-outline-success btn-sm py-0 px-2 fw-bold" @onclick="AddNewUnitRow">
                                    ➕ إضافة وحدة جديدة
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm text-center mb-0 small align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>اسم الوحدة البديلة</th>
                                            <th>تساوي كم من الوحدة الأساسية (@currentItem.Unit)</th>
                                            <th>الباركود الخاص بهذه الوحدة</th>
                                            <th style="width: 80px;">إجراء</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!currentItem.UnitsHierarchy.Any())
                                        {
                                            <tr>
                                                <td colspan="4" class="py-3 text-muted">لم يتم تعريف وحدات بديلة بعد. يتعامل النظام حالياً بوحدة: (@currentItem.Unit) فقط.</td>
                                            </tr>
                                        }
                                        @foreach (var u in currentItem.UnitsHierarchy)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="text" class="form-control form-control-sm text-center fw-bold" placeholder="مثال: كرتونة" 
                                                           @bind="u.UnitName" />
                                                </td>
                                                <td>
                                                    <div class="input-group input-group-sm">
                                                        <input type="number" step="0.01" class="form-control text-center fw-bold text-primary" 
                                                               @bind="u.ConversionFactor" />
                                                        <span class="input-group-text">@currentItem.Unit</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control form-control-sm font-monospace text-center" placeholder="باركود العبوة" 
                                                           @bind="u.Barcode" />
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" @onclick="() => currentItem.UnitsHierarchy.Remove(u)">
                                                        🗑️
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <!-- TAB 3: الأرصدة ومحددات المخزون والتسعير -->
                    @if (itemModalActiveTab == 3)
                    {
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-secondary">سعر البيع الافتراضي (ج.م)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm font-monospace fw-bold text-success" 
                                       @bind="currentItem.SalePrice" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-secondary">سعر الشراء / التكلفة المعيارية (ج.م)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm font-monospace" 
                                       @bind="currentItem.PurchasePrice" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-secondary">حد الأمان (Safety Stock)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm font-monospace text-danger" 
                                       @bind="currentItem.SafetyStockLevel" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-secondary">نقطة إعادة الطلب (Reorder Point)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm font-monospace text-warning" 
                                       @bind="currentItem.ReorderPoint" />
                            </div>
                        </div>
                    }

                    <!-- TAB 4: التشكيلات المركبة والأنواع المتعددة (VARIANTS) -->
                    @if (itemModalActiveTab == 4)
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-check form-switch p-3 border rounded bg-light">
                                    <input class="form-check-input ms-2" type="checkbox" id="varCheck" @bind="currentItem.HasVariants" />
                                    <label class="form-check-label fw-bold text-dark small" for="varCheck">
                                        صنف متنوع (له نكهات أو مقاسات متعددة)
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check form-switch p-3 border rounded bg-light">
                                    <input class="form-check-input ms-2" type="checkbox" id="comboCheck" @bind="currentItem.IsComposite" />
                                    <label class="form-check-label fw-bold text-dark small" for="comboCheck">
                                        صنف تشكيلة مركبة (ميكس / صينية شرقي مشكل)
                                    </label>
                                </div>
                            </div>
                        </div>

                        @if (currentItem.HasVariants)
                        {
                            <div class="card border border-primary border-2 shadow-sm">
                                <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold">
                                        <i class="bi bi-diagram-3 me-1"></i> جدول الأنواع والنكهات والمقاسات التابعة للصنف (@currentItem.Variants.Count نوع)
                                    </span>
                                    <button type="button" class="btn btn-light btn-sm py-0 px-2 fw-bold text-primary" @onclick="AddNewVariantRow">
                                        ➕ إضافة نكهة / مقاس جديد
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm text-center mb-0 small align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 140px;">الكود الفرعي (SKU)</th>
                                                <th>النوع / النكهة / المقاس <span class="text-danger">*</span></th>
                                                <th style="width: 130px;">سعر البيع الخاص</th>
                                                <th>الباركود الخاص</th>
                                                <th style="width: 70px;">إجراء</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!currentItem.Variants.Any())
                                            {
                                                <tr>
                                                    <td colspan="5" class="py-3 text-muted">
                                                        اضغط زر "إضافة نكهة / مقاس جديد" لتسجيل تفريعات هذا الصنف.
                                                    </td>
                                                </tr>
                                            }
                                            @foreach (var v in currentItem.Variants)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="text" class="form-control form-control-sm font-monospace text-center" 
                                                               placeholder="تلقائي" @bind="v.VariantCode" />
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control form-control-sm fw-bold text-start" 
                                                               placeholder="مثال: نكهة شيكولاتة / مقاس كبير" @bind="v.VariantName" />
                                                    </td>
                                                    <td>
                                                        <input type="number" step="0.5" class="form-control form-control-sm text-center font-monospace text-success fw-bold" 
                                                               placeholder="@currentItem.SalePrice" @bind="v.PriceOverride" />
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control form-control-sm font-monospace text-center" 
                                                               placeholder="باركود النوع" @bind="v.Barcode" />
                                                    </td>
                                                    <td>
                                                        <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" @onclick="() => currentItem.Variants.Remove(v)">
                                                            🗑️
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseItemModal">إلغاء</button>
                    <button type="button" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@isSavingItem" @onclick="SaveItemAsync">
                        @if (isSavingItem)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check-circle"></i> @(currentItem.Id > 0 ? "تحديث بيانات الصنف" : "حفظ الصنف بالمنظومة")</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

