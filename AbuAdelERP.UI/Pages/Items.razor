    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        errorMessage = null;

        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1)
            {
                errorMessage = "الملف فارغ أو لا يحتوي على صفوف بيانات.";
                return;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = ParseCsvLine(line);
                if (cols.Count >= 2)
                {
                    string itemCode = cols[0].Trim();
                    string itemName = cols[1].Trim();
                    string itemType = cols.Count > 2 ? cols[2].Trim() : "منتج تام";
                    string deptText = cols.Count > 3 ? cols[3].Trim() : "";
                    string unit = cols.Count > 4 ? cols[4].Trim() : "كجم";
                    
                    decimal.TryParse(cols.Count > 5 ? cols[5].Trim() : "0", out var price);

                    importedPreviewList.Add(new ItemImportRowDto
                    {
                        ItemCode = itemCode,
                        ItemName = itemName,
                        ItemType = itemType,
                        DepartmentNameOrCode = deptText,
                        Unit = unit,
                        SalePrice = price,
                        Active = true
                    });
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل قراءة الملف: {ex.Message}";
        }
    }

    private List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var curVal = new StringBuilder();

        foreach (char c in line)
        {
            if (c == '\"') inQuotes = !inQuotes;
            else if (c == ',' && !inQuotes)
            {
                result.Add(curVal.ToString());
                curVal.Clear();
            }
            else curVal.Append(c);
        }
        result.Add(curVal.ToString());
        return result;
    }

    private async Task ProcessAndSaveImportAsync()
    {
        if (!importedPreviewList.Any()) return;

        isSavingImport = true;
        errorMessage = null;

        try
        {
            int count = 0;
            foreach (var row in importedPreviewList)
            {
                var existing = items.FirstOrDefault(i => i.ItemCode.Equals(row.ItemCode, StringComparison.OrdinalIgnoreCase));
                var matchedDept = MatchDepartment(row.DepartmentNameOrCode);

                var payload = new
                {
                    Id = existing?.Id ?? 0,
                    CompanyId = 1,
                    ItemCode = row.ItemCode.Trim(),
                    ItemName = row.ItemName.Trim(),
                    ItemType = row.ItemType,
                    DepartmentId = matchedDept?.Id ?? existing?.DepartmentId,
                    DepartmentName = matchedDept?.DepartmentName ?? row.DepartmentNameOrCode,
                    Unit = row.Unit,
                    SalePrice = row.SalePrice,
                    BasePrice = row.SalePrice,
                    Active = true
                };

                HttpResponseMessage res;
                if (existing != null)
                {
                    res = await Http.PutAsJsonAsync($"api/items/{existing.Id}", payload);
                }
                else
                {
                    res = await Http.PostAsJsonAsync("api/items", payload);
                }

                if (res.IsSuccessStatusCode) count++;
            }

            successMessage = $"تم استيراد ومعالجة ({count}) صنفاً بنجاح مع ربط الصالات والحالة المفعلة.";
            CloseImportModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء حفظ الأصناف: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }
