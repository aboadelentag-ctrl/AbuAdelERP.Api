<!-- 2. نافذة تصنيفات الأصناف المدمجة                                                          -->
<!-- ========================================================================================= -->
@if (isCategoriesModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                
                <div class="modal-header bg-warning text-dark py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        🏷️ إدارة تصنيفات الأصناف والمواد (Category Center)
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => isCategoriesModalOpen = false"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="row g-3">
                        <div class="col-lg-7">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-dark text-white py-1 px-3 small fw-bold">
                                    قائمة التصنيفات المسجلة (@categories.Count تصنيف)
                                </div>
                                <div class="table-responsive" style="max-height: 450px;">
                                    <table class="table table-hover align-middle text-center small mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>الكود</th>
                                                <th class="text-start">اسم التصنيف</th>
                                                <th>النوع المرتبط</th>
                                                <th>الحالة</th>
                                                <th>إجراءات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in categories)
                                            {
                                                <tr class="@(c.Id == currentCategory.Id ? "table-warning" : "")">
                                                    <td class="font-monospace fw-bold">@c.CategoryCode</td>
                                                    <td class="text-start fw-bold">@c.CategoryName</td>
                                                    <td><span class="badge @GetTypeBadgeClass(c.ItemType)">@c.ItemType</span></td>
                                                    <td>
                                                        <span class="badge @(c.Active ? "bg-success" : "bg-danger")">
                                                            @(c.Active ? "مفعل" : "موقوف")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <button class="btn btn-outline-primary btn-sm py-0 px-2" @onclick="() => EditCategory(c)">
                                                            تعديل
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="card border border-warning shadow-sm">
                                <div class="card-header bg-light py-2 fw-bold text-dark small">
                                    @(currentCategory.Id > 0 ? "✏️ تعديل بيانات تصنيف" : "➕ إضافة تصنيف جديد")
                                </div>
                                <div class="card-body p-3">
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold text-secondary">كود التصنيف <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm font-monospace fw-bold" placeholder="مثال: CAT-01" 
                                               @bind="currentCategory.CategoryCode" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold text-secondary">اسم التصنيف <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm fw-bold" placeholder="مثال: خامات التعبئة / حلويات شرقية" 
                                               @bind="currentCategory.CategoryName" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold text-secondary">نوع الأصناف في هذا التصنيف</label>
                                        <select class="form-select form-select-sm" @bind="currentCategory.ItemType">
                                            <option value="منتج تام">منتج تام</option>
                                            <option value="نصف مصنع">نصف مصنع</option>
                                            <option value="خامات">خامات</option>
                                            <option value="مواد تعبئة وتغليف">مواد تعبئة وتغليف</option>
                                            <option value="أصول / حاويات تداول">أصول / حاويات تداول</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-secondary">الوصف / ملاحظات</label>
                                        <textarea class="form-control form-control-sm" rows="2" @bind="currentCategory.Description"></textarea>
                                    </div>
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="catActive" @bind="currentCategory.Active" />
                                        <label class="form-check-label small fw-bold" for="catActive">التصنيف مفعل ومتاح للاستخدام</label>
                                    </div>
                                    <div class="d-flex gap-2">
                                        @if (currentCategory.Id > 0)
                                        {
                                            <button type="button" class="btn btn-secondary btn-sm flex-fill" @onclick="() => currentCategory = new()">إلغاء</button>
                                        }
                                        <button type="button" class="btn btn-warning btn-sm flex-fill fw-bold shadow-sm" 
                                                disabled="@isSavingCategory" @onclick="SaveCategoryAsync">
                                            <i class="bi bi-check2-circle"></i> @(currentCategory.Id > 0 ? "تحديث التصنيف" : "إضافة التصنيف")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => isCategoriesModalOpen = false">إغلاق</button>
                </div>

            </div>
        </div>
    </div>
}

