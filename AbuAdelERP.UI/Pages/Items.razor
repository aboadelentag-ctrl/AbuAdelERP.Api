    private string NormalizeArabic(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        return text.Trim()
            .Replace("أ", "ا")
            .Replace("إ", "ا")
            .Replace("آ", "ا")
            .Replace("ة", "ه")
            .Replace("ى", "ي")
            .Replace("ـ", "")
            .ToLower();
    }

    private DepartmentItemDto? MatchDepartment(string? text)
    {
        if (string.IsNullOrWhiteSpace(text) || !departments.Any()) return null;
        var norm = NormalizeArabic(text);

        var byCode = departments.FirstOrDefault(d => d.DepartmentCode.Trim() == text.Trim() || d.Id.ToString() == text.Trim());
        if (byCode != null) return byCode;

        var exact = departments.FirstOrDefault(d => NormalizeArabic(d.DepartmentName) == norm);
        if (exact != null) return exact;

        return departments.FirstOrDefault(d => NormalizeArabic(d.DepartmentName).Contains(norm) || norm.Contains(NormalizeArabic(d.DepartmentName)));
    }

    private async Task ExportToExcelAsync()
    {
        var list = FilteredItems.ToList();
        if (!list.Any())
        {
            errorMessage = "لا توجد أصناف لتصديرها.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("كود_الصنف,اسم_الصنف,النوع,القسم,الوحدة,سعر_البيع,الحالة");

            foreach (var i in list)
            {
                var deptName = GetDisplayDeptName(i);
                var status = i.Active ? "مفعل" : "معطل";
                var price = i.SalePrice > 0 ? i.SalePrice : i.BasePrice;
                sb.AppendLine($"{EscapeCsv(i.ItemCode)},{EscapeCsv(i.ItemName)},{EscapeCsv(i.ItemType)},{EscapeCsv(deptName)},{EscapeCsv(i.Unit)},{price},{status}");
            }

            var fileName = $"دليل_الأصناف_أبو_عادل_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            successMessage = $"تم تصدير ({list.Count}) صنفاً إلى إكسيل بنجاح.";
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل التصدير: {ex.Message}";
        }
    }

