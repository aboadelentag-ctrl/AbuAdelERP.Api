                new() { Id = 4, FullName = "م. خالد منصور", DepartmentName = "إدارة الصيانة", JobTitle = "مدير الصيانة" },
                new() { Id = 5, FullName = "فني أحمد سمير", DepartmentName = "إدارة الصيانة", JobTitle = "فني ميكانيكا" },
                new() { Id = 6, FullName = "فني طارق علي", DepartmentName = "إدارة الصيانة", JobTitle = "فني كهرباء وتحكم" },
                new() { Id = 7, FullName = "أ. ياسر عثمان", DepartmentName = "إدارة الإشراف الداخلي", JobTitle = "مشرف النظافة والتعقيم" },
                new() { Id = 8, FullName = "كيميائي مصطفى زكي", DepartmentName = "إدارة الجودة", JobTitle = "أخصائي سلامة الغذاء" },
