                new() { Id = 1, FullName = "أحمد عبد العزيز", DepartmentName = "إدارة الإنتاج", JobTitle = "منسق إنتاج" },
                new() { Id = 2, FullName = "شيف محمود ربيع", DepartmentName = "قسم الشرقي", JobTitle = "شيف الصالة" },
