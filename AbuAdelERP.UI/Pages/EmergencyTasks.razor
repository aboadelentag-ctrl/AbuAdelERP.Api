    private bool isSuccessFeedback = true;
    private bool isSubmitting = false;

    // فلاتر البحث
    private string searchTerm = "";
    private string selectedDeptFilter = "";
    private string selectedPriorityFilter = "";
    private string selectedStatusFilter = "";

    // متغيرات النوافذ
