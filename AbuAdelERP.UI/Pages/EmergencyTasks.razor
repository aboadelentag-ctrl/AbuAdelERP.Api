@page "/emergency-tasks"
@using System.Net.Http.Json
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>غرفة عمليات المهام الطارئة - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-danger">🚨 غرفة عمليات المهام الطارئة والاستجابة السريعة</h4>
                    <span class="badge bg-danger px-2 py-1 small">نظام الطوارئ الحي (SOS)</span>
                </div>
                <small class="text-light text-opacity-75">
                    إدارة بلاغات الصيانة، نظافة الصالات (GMP/ISO)، ومخالفات الجودة مع التكليف الفوري وإرفاق الوسائط والربط المباشر مع سجل الأقسام والموظفين.
                </small>
            </div>
            <div class="d-flex gap-2">
                <a href="emergency-tasks-reports" class="btn btn-outline-light btn-sm fw-bold px-3 py-2 shadow-sm">
                    📊 تقارير ومؤشرات الإنجاز (SLA)
                </a>
                <button class="btn btn-danger fw-bold px-4 py-2 shadow-sm fs-6" @onclick="OpenNewTaskModal">
                    ➕ إطلاق بلاغ طارئ جديد (SOS)
                </button>
            </div>
        </div>
    </div>

    <!-- رسائل التنبيه والخطأ -->
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccessFeedback ? "alert-success" : "alert-danger") border-0 shadow-sm alert-dismissible fade show py-2 mb-3 fw-bold" role="alert">
            @feedbackMessage
            <button type="button" class="btn-close py-2" @onclick='() => feedbackMessage = ""'></button>
        </div>
    }

    <!-- بطاقات المؤشرات اللحظية -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-danger border-4">
                <small class="text-muted fw-bold">جديدة (بانتظار الإجراء)</small>
                <h4 class="fw-bold text-danger mt-1 mb-0 font-monospace">@tasksList.Count(t => t.Status == "PENDING") بلاغ</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-primary border-4">
                <small class="text-muted fw-bold">محالة ومكلفة لفني</small>
                <h4 class="fw-bold text-primary mt-1 mb-0 font-monospace">@tasksList.Count(t => t.Status == "ASSIGNED") بلاغ</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-warning border-4">
                <small class="text-muted fw-bold">قيد التنفيذ الميداني</small>
                <h4 class="fw-bold text-warning mt-1 mb-0 font-monospace">@tasksList.Count(t => t.Status == "IN_PROGRESS") بلاغ</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-success border-4">
                <small class="text-muted fw-bold">مغلقة ومؤكدة بالدليل</small>
                <h4 class="fw-bold text-success mt-1 mb-0 font-monospace">@tasksList.Count(t => t.Status == "CLOSED") بلاغ</h4>
            </div>
        </div>
    </div>

    <!-- شريط فلاتر البحث المتقدم -->
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="بحث برقم البلاغ، العنوان، الموظف، أو التفاصيل..." @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="selectedDeptFilter">
                        <option value="">-- كل الأقسام والإدارات --</option>
                        @foreach (var d in dbDepartments)
                        {
                            <option value="@d.DisplayName">@d.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="selectedPriorityFilter">
                        <option value="">-- كل الأولويات --</option>
                        <option value="CRITICAL">حرجة جداً 🔥</option>
                        <option value="HIGH">عالية ⚡</option>
                        <option value="NORMAL">عادية</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="selectedStatusFilter">
                        <option value="">-- كل الحالات --</option>
                        <option value="PENDING">جديدة</option>
                        <option value="ASSIGNED">محالة لفني</option>
                        <option value="IN_PROGRESS">قيد التنفيذ</option>
                        <option value="CLOSED">مغلقة ومؤكدة</option>
                    </select>
                </div>
                <div class="col-md-1 text-center">
                    <button class="btn btn-outline-secondary btn-sm w-100 fw-bold" @onclick="ResetFilters">إلغاء</button>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول عرض البلاغات والمهام الطارئة -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-dark m-0">📋 سجل بلاغات الأقسام (المعروض: @FilteredTasks.Count())</h6>
            <button class="btn btn-outline-primary btn-sm fw-bold" @onclick="LoadTasks">🔄 تحديث السجل</button>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                <thead class="table-dark">
                    <tr>
                        <th>رقم البلاغ</th>
                        <th>عنوان المشكلة</th>
                        <th>القسم / الراسل</th>
                        <th>القسم المسؤول / الفني المكلف</th>
                        <th>المرفقات</th>
                        <th>الأولوية</th>
                        <th>التوقيت والمهلة</th>
                        <th>الحالة</th>
                        <th>إجراءات التكليف والاستجابة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredTasks.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-muted py-5 fw-bold">
                                لا توجد بلاغات طارئة مطابقة لشروط البحث.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in FilteredTasks)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@t.TaskNumber</td>
                                <td class="fw-bold text-start ps-2">@t.Title</td>
                                <td class="text-start ps-2">
                                    <span class="badge bg-light text-dark border">@t.SenderDepartment</span>
                                    <div class="small text-muted">بواسطة: <strong>@(!string.IsNullOrEmpty(t.SenderEmployeeName) ? t.SenderEmployeeName : "مشرف القسم")</strong></div>
                                </td>
                                <td class="text-start ps-2">
                                    <span class="badge bg-secondary">@t.TargetDepartment</span>
                                    @if (!string.IsNullOrEmpty(t.AssignedTechnicianName))
                                    {
                                        <div class="small text-primary fw-bold">المكلف: @t.AssignedTechnicianName 🛠️</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.MediaUrl))
                                    {
                                        <button class="btn btn-sm btn-outline-info py-0 px-2 fw-bold" @onclick="() => OpenPreviewMediaModal(t.MediaUrl, t.MediaType)">
                                            @if (t.MediaType == "IMAGE") { <span>🖼️ صورة</span> }
                                            else if (t.MediaType == "AUDIO") { <span>🎤 صوت</span> }
                                            else if (t.MediaType == "VIDEO") { <span>🎥 فيديو</span> }
                                            else { <span>📎 ملف</span> }
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">نص فقط</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(t.Priority == "CRITICAL" ? "bg-danger" : t.Priority == "HIGH" ? "bg-warning text-dark" : "bg-info text-dark")">
                                        @TranslatePriority(t.Priority)
                                    </span>
                                </td>
                                <td class="font-monospace">
                                    <div>@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                    <small class="badge bg-light text-secondary border">مهلة: @t.TargetResolutionMinutes دقيقة</small>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(t.Status) px-2 py-1">
                                        @TranslateStatus(t.Status)
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        @if (t.Status == "PENDING")
                                        {
                                            <button class="btn btn-sm btn-primary fw-bold py-0 px-2" title="تحويل وتكليف فني" @onclick="() => OpenDelegateModal(t)">
                                                🛠️ تكليف
                                            </button>
                                            <button class="btn btn-sm btn-warning fw-bold py-0 px-2" title="بدء العمل مباشرة" @onclick="() => RespondToTask(t.Id)">
                                                ⚡ تنفيذ
                                            </button>
                                        }
                                        else if (t.Status == "ASSIGNED")
                                        {
                                            <button class="btn btn-sm btn-warning fw-bold py-0 px-2" @onclick="() => RespondToTask(t.Id)">
                                                ⚡ بدء التنفيذ
                                            </button>
                                        }
                                        else if (t.Status == "IN_PROGRESS")
                                        {
                                            <button class="btn btn-sm btn-success fw-bold py-0 px-2" @onclick="() => OpenCompleteModal(t)">
                                                ✅ إغلاق بالدليل
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-dark fw-bold py-0 px-2" @onclick="() => OpenFullDetailsModal(t)">
                                            🔍 التفاصيل الكاملة
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- 1. نافذة إطلاق بلاغ طارئ جديد (SOS) -->
@if (isNewTaskModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">🚨 إطلاق بلاغ طارئ واستدعاء فوري (SOS)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseNewTaskModal"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">عنوان المشكلة أو العطل *</label>
                        <input type="text" class="form-control border-danger fw-bold" @bind="newTask.Title" placeholder="مثال: توقف مفاجئ لفرن الدوار في صالة الشرقي والمخبوزات" />
                    </div>

                    <div class="row g-3 mb-3 bg-white p-3 rounded border">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-primary">القسم الطالب (صاحب الطلب) *</label>
                            <select class="form-select border-primary fw-bold" value="@selectedSenderDeptId" @onchange="OnSenderDeptChanged">
                                <option value="0">-- اختر القسم الطالب من الهيكل --</option>
                                @foreach (var d in dbDepartments)
                                {
                                    <option value="@d.Id">@d.DisplayName (@d.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-primary">الموظف الراسل / المشرف *</label>
                            <select class="form-select border-primary fw-bold" @bind="newTask.SenderEmployeeName">
                                <option value="">-- اختر اسم الموظف التابع للقسم --</option>
                                @foreach (var emp in senderFilteredEmployees)
                                {
                                    <option value="@emp.DisplayName">@emp.DisplayName @(!string.IsNullOrEmpty(emp.JobTitle) ? $"({emp.JobTitle})" : "")</option>
                                }
                            </select>
                            @if (!senderFilteredEmployees.Any() && selectedSenderDeptId > 0)
                            {
                                <small class="text-muted d-block mt-1">لا يوجد موظفون مسجلون بهذا القسم، يمكنك كتابة الاسم يدوياً:</small>
                                <input type="text" class="form-control form-control-sm mt-1" placeholder="اكتب اسم المشرف" @bind="newTask.SenderEmployeeName" />
                            }
                        </div>

                        <div class="col-md-6 mt-3">
                            <label class="form-label fw-bold small text-danger">القسم المسؤول (الموجّه إليه البلاغ) *</label>
                            <select class="form-select border-danger fw-bold" value="@selectedTargetDeptId" @onchange="OnTargetDeptChanged">
                                <option value="0">-- اختر الإدارة المسؤولة --</option>
                                @foreach (var d in dbDepartments)
                                {
                                    <option value="@d.Id">@d.DisplayName (@d.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="form-label fw-bold small text-danger">مدير الإدارة / الموظف المستلم (اختياري)</label>
                            <select class="form-select border-danger fw-bold" @bind="newTask.TargetEmployeeName">
                                <option value="">-- اختر المسؤول بالإدارة المستهدفة --</option>
                                @foreach (var emp in targetFilteredEmployees)
                                {
                                    <option value="@emp.DisplayName">@emp.DisplayName @(!string.IsNullOrEmpty(emp.JobTitle) ? $"({emp.JobTitle})" : "")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">درجة الأولوية والخطورة *</label>
                            <select class="form-select border-danger fw-bold" @bind="newTask.Priority">
                                <option value="CRITICAL">حرجة جداً 🔥 (توقف إنتاج أو تلوث)</option>
                                <option value="HIGH">عالية الأهمية ⚡</option>
                                <option value="NORMAL">عادية</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">المهلة المستهدفة للإنجاز (بالدقائق)</label>
                            <input type="number" class="form-control" @bind="newTask.TargetResolutionMinutes" />
                        </div>
                    </div>

                    <!-- إرفاق ملف وسائط (صور، فيديو، صوت) -->
                    <div class="card border border-2 border-primary mb-3 bg-white p-3 rounded">
                        <label class="form-label fw-bold small text-primary mb-1">
                            📸 إرفاق وسائط للبلاغ (صور العطل، تسجيل صوتي، أو مقطع فيديو):
                        </label>
                        <InputFile OnChange="HandleFileUpload" class="form-control form-control-sm mb-2" accept="image/*,video/*,audio/*" />

                        @if (!string.IsNullOrEmpty(newTask.MediaUrl))
                        {
                            <div class="p-2 border rounded bg-light text-center">
                                @if (newTask.MediaType == "IMAGE")
                                {
                                    <img src="@newTask.MediaUrl" class="img-fluid rounded" style="max-height: 180px;" />
                                }
                                else if (newTask.MediaType == "AUDIO")
                                {
                                    <audio controls src="@newTask.MediaUrl" class="w-100 mt-1"></audio>
                                }
                                else if (newTask.MediaType == "VIDEO")
                                {
                                    <video controls src="@newTask.MediaUrl" class="w-100" style="max-height: 200px;"></video>
                                }
                                <div class="mt-1 small text-success fw-bold">✓ تم إرفاق الملف بنجاح (@newTask.MediaFileName)</div>
                            </div>
                        }
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small">التفاصيل الكاملة للمشكلة أو الملاحظة</label>
                        <textarea class="form-control" rows="3" @bind="newTask.Description" placeholder="اكتب تفاصيل إضافية للمساعدة في سرعة التعامل مع الحالة..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseNewTaskModal">إلغاء</button>
                    <button type="button" class="btn btn-danger btn-sm px-4 fw-bold shadow-sm" disabled="@isSubmitting" @onclick="SubmitNewTask">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري الإرسال...</span>
                        }
                        else
                        {
                            <span>🚀 إرسال البلاغ الطارئ فوراً</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 2. نافذة إحالة وتكليف فني بالمهمة -->
@if (isDelegateModalOpen && selectedTaskToDelegate != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" dir="rtl">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">🛠️ إحالة وتكليف فني بالمهمة (@selectedTaskToDelegate.TargetDepartment)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDelegateModal"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        بصفتك مسؤول الإدارة، يمكنك تكليف فني معتمد لمباشرة: <strong>@selectedTaskToDelegate.Title</strong>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">اسم الفني أو المسؤول المكلف ميدانياً *</label>
                        <select class="form-select border-primary fw-bold" @bind="assignedTechnicianInput">
                            <option value="">-- اختر الفني المسؤول من الإدارة --</option>
                            @foreach (var emp in delegationFilteredEmployees)
                            {
                                <option value="@emp.DisplayName">@emp.DisplayName @(!string.IsNullOrEmpty(emp.JobTitle) ? $"({emp.JobTitle})" : "")</option>
                            }
                        </select>
                        @if (!delegationFilteredEmployees.Any())
                        {
                            <small class="text-muted d-block mt-1">يمكنك كتابة اسم الفني المكلف يدوياً:</small>
                            <input type="text" class="form-control form-control-sm mt-1" placeholder="اسم الفني" @bind="assignedTechnicianInput" />
                        }
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold small">توجيهات وتعليمات الإدارة للفني</label>
                        <textarea class="form-control" rows="3" @bind="assignmentNotesInput" placeholder="اكتب توجيهات الصيانة أو إجراءات النظافة المطلوبة فوراً..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseDelegateModal">إلغاء</button>
                    <button type="button" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="ConfirmDelegateTask">
                        ✓ اعتماد التكليف وتوجيه المهمة
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 3. نافذة إغلاق المهمة وتوثيق الإنجاز بالدليل -->
@if (isCompleteModalOpen && completingTask != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" dir="rtl">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">✅ إغلاق البلاغ الطارئ وتوثيق الإنجاز</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCompleteModal"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark d-flex justify-content-between">
                            <span>الفني المنفذ / القائم بالإغلاق المعتمد *</span>
                            @if (!string.IsNullOrEmpty(completingTask.AssignedTechnicianName))
                            {
                                <span class="badge bg-primary">مرتبط تلقائياً بالمكلف بالمهمة ✔</span>
                            }
                        </label>
                        <input type="text" class="form-control border-success fw-bold bg-white" @bind="closedByInput" placeholder="اسم الفني أو المشرف المعتمد" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">بيان ما تم تنفيذه / تقرير الإصلاح أو التنظيف *</label>
                        <textarea class="form-control border-success" rows="3" @bind="closureNotes" placeholder="اكتب تفاصيل ما تم إنجازه..."></textarea>
                    </div>
                    <div class="card border border-success bg-white p-2 mb-2">
                        <label class="form-label fw-bold small text-success mb-1">📸 إرفاق دليل الإنجاز (صورة الماكينة بعد الإصلاح أو الصالة بعد التنظيف):</label>
                        <InputFile OnChange="HandleClosureProofUpload" class="form-control form-control-sm" accept="image/*,video/*" />
                        @if (!string.IsNullOrEmpty(closureProofUrl))
                        {
                            <div class="text-success small fw-bold mt-1">✓ تم إرفاق دليل الإنجاز بنجاح</div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseCompleteModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="ConfirmCompleteTask">
                        ✔ تأكيد إغلاق المهمة واعتمادها
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 4. نافذة الاستعراض التفصيلي الشامل لكل بلاغ (Task Dossier Modal) -->
@if (isFullDetailsModalOpen && detailedTask != null)
{
