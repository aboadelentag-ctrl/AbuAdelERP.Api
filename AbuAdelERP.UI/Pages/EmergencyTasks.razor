    private async Task LoadTasks()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<EmergencyTaskDto>>("api/EmergencyTasks");
            if (res != null)
            {
                tasksList = res;
                feedbackMessage = "";
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"تنبيه: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

    private void OnSenderDeptChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var deptId))
        {
            selectedSenderDeptId = deptId;
            var dept = dbDepartments.FirstOrDefault(d => d.Id == deptId);
            newTask.SenderDepartment = dept?.DisplayName ?? "";

            senderFilteredEmployees = allEmployees.Where(emp =>
                (emp.DepartmentId.HasValue && emp.DepartmentId == deptId) ||
                (!string.IsNullOrEmpty(emp.DepartmentName) && dept != null && emp.DepartmentName.Contains(dept.DisplayName, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(dept?.DisplayName) && !string.IsNullOrEmpty(emp.DepartmentName) && dept.DisplayName.Contains(emp.DepartmentName, StringComparison.OrdinalIgnoreCase))
            ).ToList();

            newTask.SenderEmployeeName = senderFilteredEmployees.FirstOrDefault()?.DisplayName ?? "";
        }
    }

    private void OnTargetDeptChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var deptId))
        {
            selectedTargetDeptId = deptId;
            var dept = dbDepartments.FirstOrDefault(d => d.Id == deptId);
            newTask.TargetDepartment = dept?.DisplayName ?? "";

            targetFilteredEmployees = allEmployees.Where(emp =>
                (emp.DepartmentId.HasValue && emp.DepartmentId == deptId) ||
                (!string.IsNullOrEmpty(emp.DepartmentName) && dept != null && emp.DepartmentName.Contains(dept.DisplayName, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(dept?.DisplayName) && !string.IsNullOrEmpty(emp.DepartmentName) && dept.DisplayName.Contains(emp.DepartmentName, StringComparison.OrdinalIgnoreCase))
            ).ToList();

            newTask.TargetEmployeeName = targetFilteredEmployees.FirstOrDefault()?.DisplayName ?? "";
        }
    }

    private IEnumerable<EmergencyTaskDto> FilteredTasks
    {
        get
        {
            var list = tasksList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                list = list.Where(t =>
                    (!string.IsNullOrEmpty(t.TaskNumber) && t.TaskNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    t.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    t.SenderDepartment.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    t.SenderEmployeeName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(t.AssignedTechnicianName) && t.AssignedTechnicianName.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrEmpty(selectedDeptFilter))
            {
                list = list.Where(t => t.SenderDepartment == selectedDeptFilter || t.TargetDepartment == selectedDeptFilter);
            }

            if (!string.IsNullOrEmpty(selectedPriorityFilter))
            {
                list = list.Where(t => t.Priority == selectedPriorityFilter);
            }

            if (!string.IsNullOrEmpty(selectedStatusFilter))
            {
                list = list.Where(t => t.Status == selectedStatusFilter);
            }

            return list;
        }
    }

    private void ResetFilters()
    {
        searchTerm = "";
        selectedDeptFilter = "";
        selectedPriorityFilter = "";
        selectedStatusFilter = "";
    }

    private void OpenNewTaskModal()
    {
        var firstDept = dbDepartments.FirstOrDefault();
        var secondDept = dbDepartments.Skip(1).FirstOrDefault() ?? firstDept;

        newTask = new EmergencyTaskDto
        {
            TaskNumber = $"EMG-{DateTime.Now:yyyyMMdd}-{Guid.NewGuid().ToString().Substring(0, 4).ToUpper()}",
            Priority = "NORMAL",
            TargetResolutionMinutes = 30
        };

        if (firstDept != null)
        {
            selectedSenderDeptId = firstDept.Id;
            newTask.SenderDepartment = firstDept.DisplayName;
            OnSenderDeptChanged(new ChangeEventArgs { Value = firstDept.Id });
        }

        if (secondDept != null)
        {
            selectedTargetDeptId = secondDept.Id;
            newTask.TargetDepartment = secondDept.DisplayName;
            OnTargetDeptChanged(new ChangeEventArgs { Value = secondDept.Id });
        }

        isNewTaskModalOpen = true;
    }

    private void CloseNewTaskModal() => isNewTaskModalOpen = false;

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            newTask.MediaFileName = file.Name;
            var ctype = file.ContentType.ToLower();
            newTask.MediaUrl = $"data:{ctype};base64,{base64}";

            if (ctype.StartsWith("image")) newTask.MediaType = "IMAGE";
            else if (ctype.StartsWith("audio")) newTask.MediaType = "AUDIO";
            else if (ctype.StartsWith("video")) newTask.MediaType = "VIDEO";
            else newTask.MediaType = "OTHER";
        }
        catch (Exception ex)
        {
            feedbackMessage = $"خطأ في قراءة ملف الوسائط: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

    private async Task HandleClosureProofUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            closureProofUrl = $"data:{file.ContentType.ToLower()};base64,{base64}";
        }
        catch { }
    }

    private async Task SubmitNewTask()
    {
        if (string.IsNullOrWhiteSpace(newTask.Title))
        {
            feedbackMessage = "⚠️ يرجى كتابة عنوان المشكلة أو العطل أولاً!";
            isSuccessFeedback = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(newTask.SenderDepartment))
        {
            feedbackMessage = "⚠️ يرجى اختيار القسم الطالب من القائمة.";
            isSuccessFeedback = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(newTask.TargetDepartment))
        {
            feedbackMessage = "⚠️ يرجى اختيار الإدارة المسؤولة الموجه إليها البلاغ.";
            isSuccessFeedback = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(newTask.TaskNumber))
        {
            newTask.TaskNumber = $"EMG-{DateTime.Now:yyyyMMdd}-{Guid.NewGuid().ToString().Substring(0, 4).ToUpper()}";
        }

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/EmergencyTasks", newTask);
            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = "✅ تم إطلاق البلاغ الطارئ وإشعار الإدارة المستهدفة بنجاح!";
                isSuccessFeedback = true;
                CloseNewTaskModal();
                await LoadTasks();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                feedbackMessage = $"❌ تعذر الإرسال ({response.StatusCode}): {err}";
                isSuccessFeedback = false;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"❌ خطأ في الاتصال: {ex.Message}";
            isSuccessFeedback = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenDelegateModal(EmergencyTaskDto task)
    {
        selectedTaskToDelegate = task;
        assignedTechnicianInput = "";
        assignmentNotesInput = "";

        delegationFilteredEmployees = allEmployees.Where(emp =>
            (!string.IsNullOrEmpty(emp.DepartmentName) && !string.IsNullOrEmpty(task.TargetDepartment) &&
             (emp.DepartmentName.Contains(task.TargetDepartment, StringComparison.OrdinalIgnoreCase) ||
              task.TargetDepartment.Contains(emp.DepartmentName, StringComparison.OrdinalIgnoreCase)))
        ).ToList();

        isDelegateModalOpen = true;
    }

    private void CloseDelegateModal() => isDelegateModalOpen = false;

    private async Task ConfirmDelegateTask()
    {
        if (selectedTaskToDelegate == null || string.IsNullOrWhiteSpace(assignedTechnicianInput))
        {
            feedbackMessage = "⚠️ يرجى اختيار اسم الفني أو المسؤول المكلف بالمهمة.";
            isSuccessFeedback = false;
            return;
        }

        try
        {
            var dto = new DelegateTaskDto
            {
                TechnicianName = assignedTechnicianInput,
                Notes = assignmentNotesInput
            };

            var response = await Http.PostAsJsonAsync($"api/EmergencyTasks/{selectedTaskToDelegate.Id}/delegate", dto);
            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = $"✅ تم تكليف ({assignedTechnicianInput}) من إدارة ({selectedTaskToDelegate.TargetDepartment}) بمباشرة المهمة!";
                isSuccessFeedback = true;
                CloseDelegateModal();
                await LoadTasks();
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"خطأ: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

    private async Task RespondToTask(long id)
    {
        try
        {
            var response = await Http.PostAsync($"api/EmergencyTasks/{id}/respond", null);
            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = "⚡ تم بدء التنفيذ وتسجيل وقت الاستجابة الميدانية!";
                isSuccessFeedback = true;
                await LoadTasks();
            }
        }
        catch { }
    }

    private void OpenCompleteModal(EmergencyTaskDto task)
    {
        completingTask = task;
        closureNotes = "";
        closureProofUrl = "";

        // ربط الاسم تلقائياً بالفني المكلف بالمهمة أو الموظف المستهدف
        if (!string.IsNullOrWhiteSpace(task.AssignedTechnicianName))
        {
            closedByInput = task.AssignedTechnicianName;
        }
        else if (!string.IsNullOrWhiteSpace(task.TargetEmployeeName))
        {
            closedByInput = task.TargetEmployeeName;
        }
        else
        {
            closedByInput = "";
        }

        isCompleteModalOpen = true;
    }

    private void CloseCompleteModal() => isCompleteModalOpen = false;

    private async Task ConfirmCompleteTask()
    {
        if (completingTask == null || string.IsNullOrWhiteSpace(closureNotes))
        {
            feedbackMessage = "⚠️ يرجى كتابة بيان ما تم تنفيذه لإغلاق البلاغ.";
            isSuccessFeedback = false;
            return;
        }

        try
        {
            var dto = new CompleteTaskDto
            {
                ClosureNotes = closureNotes,
                ClosureProofMediaUrl = closureProofUrl,
                ClosedBy = closedByInput
            };

            var response = await Http.PostAsJsonAsync($"api/EmergencyTasks/{completingTask.Id}/complete", dto);
            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = "✅ تم توثيق إنجاز وإغلاق البلاغ بالدليل بنجاح!";
                isSuccessFeedback = true;
                CloseCompleteModal();
                await LoadTasks();
            }
        }
        catch { }
    }

    private void OpenFullDetailsModal(EmergencyTaskDto task)
    {
        detailedTask = task;
        isFullDetailsModalOpen = true;
    }

    private void OpenPreviewMediaModal(string url, string type)
    {
        previewMediaUrl = url;
        previewMediaType = type;
        isPreviewModalOpen = true;
    }

    private string TranslatePriority(string p) => p switch
    {
        "CRITICAL" => "حرجة جداً 🔥",
        "HIGH" => "عالية ⚡",
        _ => "عادية"
    };

    private string TranslateStatus(string s) => s switch
    {
        "PENDING" => "جديدة (بانتظار الإجراء)",
        "ASSIGNED" => "محالة لفني 🛠️",
        "IN_PROGRESS" => "قيد التنفيذ ⚡",
        "CLOSED" => "مغلقة ومؤكدة ✓",
        _ => s
    };

    private string GetStatusBadgeClass(string s) => s switch
    {
        "PENDING" => "bg-danger",
        "ASSIGNED" => "bg-primary",
        "IN_PROGRESS" => "bg-warning text-dark",
        "CLOSED" => "bg-success",
        _ => "bg-secondary"
    };
