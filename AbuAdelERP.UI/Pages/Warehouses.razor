    private async Task SaveWarehouse()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(currentWarehouse.WarehouseCode))
        {
            errorMessage = "⚠️ يرجى إدخال كود المخزن."; return;
        }
        if (string.IsNullOrWhiteSpace(currentWarehouse.WarehouseName))
        {
            errorMessage = "⚠️ يرجى إدخال اسم المخزن."; return;
        }
        if (string.IsNullOrWhiteSpace(currentWarehouse.WarehouseType))
        {
            errorMessage = "⚠️ يرجى اختيار أو كتابة نوع المخزن."; return;
        }

        isSubmitting = true;
        try
        {
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await Http.PutAsJsonAsync($"{apiUrl}/{currentWarehouse.Id}", currentWarehouse);
            }
            else
            {
                response = await Http.PostAsJsonAsync(apiUrl, currentWarehouse);
            }

            if (response.IsSuccessStatusCode)
            {
                successMessage = isEditMode ? "✅ تم تعديل بيانات المخزن بنجاح!" : "✅ تم إضافة المخزن الجديد بنجاح!";
                await LoadWarehouses();
                ResetForm();
            }
            else
            {
                errorMessage = "❌ " + await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "❌ حدث خطأ أثناء الحفظ: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void EditWarehouse(WarehouseDto w)
    {
        currentWarehouse = new WarehouseDto
        {
            Id = w.Id,
            WarehouseCode = w.WarehouseCode,
            WarehouseName = w.WarehouseName,
            WarehouseType = w.WarehouseType,
            ParentWarehouseId = w.ParentWarehouseId,
            Description = w.Description,
            Active = w.Active
        };

        // فحص هل النوع موجود في الخيارات الجاهزة أم نوع مخصص
        var standardTypes = new[] { "صالة تشغيل", "كنترول", "خامات", "منتج تام", "نصف مصنع", "تعبئة وتغليف", "أصول وحاويات تداول", "ثلاجة تبريد", "حجر صحي", "معارض ومنافذ بيع", "قطع غيار", "هالك" };
        if (standardTypes.Contains(w.WarehouseType))
        {
            selectedWarehouseTypeOption = w.WarehouseType;
            isCustomTypeSelected = false;
        }
        else
        {
            selectedWarehouseTypeOption = "CUSTOM";
            isCustomTypeSelected = true;
        }

        isEditMode = true;
        errorMessage = "";
        successMessage = "";
    }

    private async Task DeleteWarehouse(long id)
    {
        errorMessage = "";
        successMessage = "";

        try
        {
            var response = await Http.DeleteAsync($"{apiUrl}/{id}");
            if (response.IsSuccessStatusCode)
            {
                successMessage = "✅ تم حذف المخزن بنجاح!";
                await LoadWarehouses();
                if (isEditMode && currentWarehouse.Id == id) ResetForm();
            }
            else
            {
                errorMessage = "⚠️ " + await response.Content.ReadAsStringAsync();
            }
        }
        catch
        {
            errorMessage = "❌ حدث خطأ أثناء محاولة الحذف.";
        }
    }

    private void ResetForm()
    {
        currentWarehouse = new WarehouseDto { Active = true };
        selectedWarehouseTypeOption = "";
        isCustomTypeSelected = false;
        isEditMode = false;
        errorMessage = "";
        successMessage = "";
    }

    // ==========================================
    // تصدير واستيراد الإكسيل
    // ==========================================
    private async Task ExportWarehousesToExcelAsync()
    {
        var list = FilteredWarehouses.ToList();
        if (!list.Any())
        {
            errorMessage = "لا توجد مخازن لتصديرها.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("كود_المخزن,اسم_المخزن,نوع_المخزن,المخزن_الرئيسي_التابع_له,الحالة,الوصف");

            foreach (var w in list)
            {
                var parent = !string.IsNullOrEmpty(w.ParentWarehouseName) ? w.ParentWarehouseName : "مخزن رئيسي مستقل";
                var status = w.Active ? "مفعل" : "موقوف";
                var desc = (w.Description ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");
                sb.AppendLine($"{EscapeCsv(w.WarehouseCode)},{EscapeCsv(w.WarehouseName)},{EscapeCsv(w.WarehouseType)},{EscapeCsv(parent)},{status},{EscapeCsv(desc)}");
            }

            var fileName = $"الهيكل_الشجري_للمخازن_أبو_عادل_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            successMessage = $"تم تصدير ({list.Count}) مخزن بنجاح.";
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل التصدير: {ex.Message}";
        }
    }

