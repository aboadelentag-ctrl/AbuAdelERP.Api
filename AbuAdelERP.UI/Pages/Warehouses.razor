    private void OpenImportModal()
    {
        importedPreviewList.Clear();
        isImportModalOpen = true;
    }

    private void CloseImportModal()
    {
        isImportModalOpen = false;
        importedPreviewList.Clear();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1) return;

            var header = lines[0].Split(',');
            int codeIdx = 0, nameIdx = 1, typeIdx = 2, parentIdx = 3, statusIdx = 4, descIdx = 5;

            for (int i = 0; i < header.Length; i++)
            {
                var h = header[i].Trim().ToLower();
                if (h.Contains("كود") || h.Contains("code")) codeIdx = i;
                else if (h.Contains("اسم") || h.Contains("name")) nameIdx = i;
                else if (h.Contains("نوع") || h.Contains("type")) typeIdx = i;
                else if (h.Contains("رئيس") || h.Contains("تابع") || h.Contains("parent")) parentIdx = i;
                else if (h.Contains("حالة") || h.Contains("status")) statusIdx = i;
                else if (h.Contains("وصف") || h.Contains("desc")) descIdx = i;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = line.Split(',');
                if (cols.Length >= 2)
                {
                    string code = codeIdx < cols.Length ? cols[codeIdx].Trim() : "";
                    string name = nameIdx < cols.Length ? cols[nameIdx].Trim() : "";
                    string type = typeIdx < cols.Length ? cols[typeIdx].Trim() : "خامات";
                    string parent = parentIdx < cols.Length ? cols[parentIdx].Trim() : "";
                    string statusStr = statusIdx < cols.Length ? cols[statusIdx].Trim() : "مفعل";
                    string desc = descIdx < cols.Length ? cols[descIdx].Trim() : "";

                    bool active = !statusStr.Contains("موقوف") && !statusStr.Equals("false", StringComparison.OrdinalIgnoreCase);

                    if (!string.IsNullOrEmpty(code) && !string.IsNullOrEmpty(name))
                    {
                        importedPreviewList.Add(new WarehouseImportRow
                        {
                            WarehouseCode = code,
                            WarehouseName = name,
                            WarehouseType = !string.IsNullOrEmpty(type) ? type : "خامات",
                            ParentWarehouseCodeOrName = parent,
                            Active = active,
                            Description = desc
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في قراءة ملف الإكسيل: {ex.Message}";
        }
    }

    private async Task ProcessAndSaveImportAsync()
    {
        if (!importedPreviewList.Any()) return;

        isSavingImport = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/Warehouses/bulk-import", importedPreviewList);
            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<ImportResultDto>();
                successMessage = result?.Message ?? "تم استيراد وتحديث المخازن بنجاح!";
                CloseImportModal();
                await LoadWarehouses();
            }
            else
            {
                errorMessage = "❌ " + await res.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء حفظ البيانات: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }

    public class ImportResultDto
    {
        public bool Success { get; set; }
        public int CreatedCount { get; set; }
        public int UpdatedCount { get; set; }
        public string? Message { get; set; }
    }

    private async Task TriggerBrowserDownload(string fileName, string content)
    {
        var utf8WithBom = "\uFEFF" + content;
        var jsCommand = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", jsCommand);
    }

    private string EscapeCsv(string val)
    {
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n"))
            return $"\"{val.Replace("\"", "\"\"")}\"";
        return val;
    }
