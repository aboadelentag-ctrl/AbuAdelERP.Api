@page "/warehouses"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة وأزرار التصدير والاستيراد والتحديث -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-start border-primary border-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="text-primary mb-1 fw-bold">🏢 إدارة المخازن والمستودعات (الهيكل الشجري)</h4>
                <small class="text-muted">تعريف المخازن الرئيسية والفرعية، تصنيف أنواعها التشغيلية، ومراقبة حالتها</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportWarehousesToExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير الهيكل الشجري (إكسيل)
                </button>
                <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                    <i class="bi bi-download me-1"></i> تحميل قالب استيراد المخازن
                </button>
                <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                    <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد مخازن من إكسيل
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadWarehouses">
                    <i class="bi bi-arrow-clockwise"></i> تحديث
                </button>
            </div>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger fw-bold shadow-sm mb-3 py-2 alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
            <button type="button" class="btn-close py-2" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success fw-bold shadow-sm mb-3 py-2 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @successMessage
            <button type="button" class="btn-close py-2" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    <!-- بطاقات المؤشرات اللحظية (KPIs) -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي المخازن والصالات</small>
                <h4 class="mb-0 fw-bold text-primary mt-1">@warehousesList.Count مخزن</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-info border-4 p-3 bg-white">
                <small class="text-muted fw-bold">المخازن الرئيسية المستقلة</small>
                <h4 class="mb-0 fw-bold text-dark mt-1">@warehousesList.Count(w => !w.ParentWarehouseId.HasValue || w.ParentWarehouseId == 0) مخزن</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-secondary border-4 p-3 bg-white">
                <small class="text-muted fw-bold">الصالات والمستودعات الفرعية</small>
                <h4 class="mb-0 fw-bold text-secondary mt-1">@warehousesList.Count(w => w.ParentWarehouseId.HasValue && w.ParentWarehouseId > 0) صالة / فرعي</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3 bg-white">
                <small class="text-muted fw-bold">المخازن المفعلة (النشطة)</small>
                <h4 class="mb-0 fw-bold text-success mt-1">@warehousesList.Count(w => w.Active) مفعل</h4>
            </div>
        </div>
    </div>

    <!-- شريط فلاتر البحث المتقدمة -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-top border-primary border-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <!-- 1. بحث بالاسم أو الكود -->
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-secondary mb-1">🔍 البحث بكود أو اسم المخزن</label>
                    <input type="text" class="form-control form-control-sm" placeholder="اكتب اسم المخزن أو الكود..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>

                <!-- 2. فلتر نوع المخزن الموسع -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">🏷️ نوع المخزن</label>
                    <select class="form-select form-select-sm fw-bold" @bind="selectedTypeFilter">
                        <option value="all">-- كل أنواع المخازن والصالات --</option>
                        <option value="خامات">خامات ومستلزمات</option>
                        <option value="صالة تشغيل">صالة تشغيل / قسم إنتاجي</option>
                        <option value="كنترول">كنترول وتحويلات</option>
                        <option value="منتج تام">منتج تام</option>
                        <option value="نصف مصنع">نصف مصنع / وسيط</option>
                        <option value="تعبئة وتغليف">تعبئة وتغليف</option>
                        <option value="أصول وحاويات تداول">أصول وحاويات (أسبات وصواني)</option>
                        <option value="ثلاجة تبريد">ثلاجة تبريد / تجميد</option>
                        <option value="حجر صحي">حجر صحي وفحص جودة</option>
                        <option value="معارض ومنافذ بيع">معارض ومنافذ بيع</option>
                        <option value="قطع غيار">قطع غيار ومهمات</option>
                        <option value="هالك">هالك وتوالف</option>
                    </select>
                </div>

                <!-- 3. فلتر التبعية للمخزن الرئيسي -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">🏢 التبعية الشجرية</label>
                    <select class="form-select form-select-sm" @bind="selectedParentFilter">
                        <option value="all">-- كل المخازن (رئيسية وفرعية) --</option>
                        <option value="main_only">المخازن الرئيسية فقط</option>
                        <option value="sub_only">المستودعات والصالات الفرعية فقط</option>
                        @foreach (var parent in warehousesList.Where(w => !w.ParentWarehouseId.HasValue || w.ParentWarehouseId == 0))
                        {
                            <option value="@parent.Id">تابع لـ: @parent.WarehouseName</option>
                        }
                    </select>
                </div>

                <!-- 4. فلتر الحالة وزر الإلغاء -->
                <div class="col-md-2 d-flex align-items-end gap-1">
                    <select class="form-select form-select-sm flex-fill" @bind="selectedStatusFilter">
                        <option value="all">كل الحالات</option>
                        <option value="active">مفعل فقط</option>
                        <option value="inactive">موقوف فقط</option>
                    </select>
                    <button class="btn btn-outline-danger btn-sm" title="إلغاء الفلاتر" @onclick="ResetFilters">✕</button>
                </div>
            </div>

            @if (HasActiveFilters)
            {
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    <span class="small text-primary fw-bold">
                        <i class="bi bi-funnel-fill me-1"></i> نتائج التصفية: (@FilteredWarehouses.Count() مخزن مطابق من أصل @warehousesList.Count)
                    </span>
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" style="font-size: 0.78rem;" @onclick="ResetFilters">
                        عرض الكل
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <!-- 1. نموذج الإضافة والتعديل مع قائمة الأنواع الموسعة -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-top border-primary border-4">
                <div class="card-header bg-white py-3">
                    <h5 class="text-primary m-0 fw-bold">@(isEditMode ? "✏️ تعديل بيانات المخزن" : "➕ إضافة مخزن جديد")</h5>
                </div>
                <div class="card-body bg-light">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">كود المخزن *</label>
                        <input type="text" class="form-control border-primary fw-bold font-monospace" @bind="currentWarehouse.WarehouseCode" placeholder="مثال: WH-FLR-400" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">اسم المخزن / الصالة *</label>
                        <input type="text" class="form-control border-primary fw-bold" @bind="currentWarehouse.WarehouseName" placeholder="مثال: مخزن صالة قسم الجاتوه الاسبيشيال" />
                    </div>

                    <!-- قائمة أنواع المخازن الموسعة بالكامل -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">نوع المخزن / الصالة *</label>
                        <select class="form-select border-primary fw-bold" @bind="selectedWarehouseTypeOption" @bind:after="OnWarehouseTypeOptionChanged">
                            <option value="">-- اختر نوع المخزن --</option>
                            <option value="صالة تشغيل">🏭 صالة تشغيل / قسم إنتاجي</option>
                            <option value="كنترول">⚖️ مخزن كنترول وتحويلات</option>
                            <option value="خامات">🌾 مخزن خامات ومستلزمات</option>
                            <option value="منتج تام">🎂 مخزن منتج تام</option>
                            <option value="نصف مصنع">🥣 مخزن نصف مصنع / وسيط (عجائن وحشوات)</option>
                            <option value="تعبئة وتغليف">📦 مخزن تعبئة وتغليف</option>
                            <option value="أصول وحاويات تداول">🛒 مخزن أصول وحاويات تداول (أسبات وصواني)</option>
                            <option value="ثلاجة تبريد">❄️ ثلاجة تبريد / تجميد</option>
                            <option value="حجر صحي">🛡️ حجر صحي وفحص جودة (Quarantine)</option>
                            <option value="معارض ومنافذ بيع">🏪 معارض ومنافذ بيع / فروع</option>
                            <option value="قطع غيار">🔧 مستودع قطع غيار ومهمات</option>
                            <option value="هالك">🗑️ مخزن هالك وتوالف</option>
                            <option value="CUSTOM">✍️ نوع مخصص / إدخال يدوي...</option>
                        </select>
                    </div>

                    <!-- حقل إدخال نوع مخصص إذا اختار المستخدم نوع يدوي -->
                    @if (isCustomTypeSelected)
                    {
                        <div class="mb-3 p-2 border rounded bg-white">
                            <label class="form-label fw-bold small text-primary">اكتب مسمى النوع المخصص *</label>
                            <input type="text" class="form-control form-control-sm border-primary fw-bold" 
                                   @bind="currentWarehouse.WarehouseType" placeholder="مثال: مخزن هدايا، مخزن تشوين..." />
                        </div>
                    }

                    <!-- قائمة اختيار المخزن الرئيسي الشجري -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">يتبع مخزن رئيسي (اختياري)</label>
                        <select class="form-select border-primary" @bind="currentWarehouse.ParentWarehouseId">
                            <option value="">-- مخزن رئيسي مستقل (لا يتبع أحداً) --</option>
                            @foreach (var w in warehousesList.Where(w => w.Id != currentWarehouse.Id))
                            {
                                <option value="@w.Id">@w.WarehouseName (@w.WarehouseCode)</option>
                            }
                        </select>
                        <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">حدد هذا الخيار إذا كان هذا مخزناً فرعياً أو صالة تابعة لمخزن رئيسي.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">وصف إضافي (اختياري)</label>
                        <textarea class="form-control" rows="2" @bind="currentWarehouse.Description" placeholder="ملاحظات حول موقع المخزن أو استخدامه..."></textarea>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="activeSwitch" @bind="currentWarehouse.Active">
                        <label class="form-check-label fw-bold @(currentWarehouse.Active ? "text-success" : "text-danger")" for="activeSwitch">
                            @(currentWarehouse.Active ? "المخزن مفعل (يعمل)" : "المخزن موقوف")
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary fw-bold w-100 shadow" @onclick="SaveWarehouse" disabled="@isSubmitting">
                            @(isSubmitting ? "⏳ جاري الحفظ..." : "💾 حفظ البيانات")
                        </button>
                        @if (isEditMode)
                        {
                            <button class="btn btn-outline-secondary fw-bold shadow-sm" @onclick="ResetForm">إلغاء</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. جدول عرض المخازن -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold small">📋 الشجرة التنظيمية للمخازن</h6>
                    <span class="badge bg-primary">المعروض: @FilteredWarehouses.Count() مخزن</span>
                </div>
                <div class="card-body p-0 table-responsive">
                    @if (isLoading)
                    {
                        <div class="p-5 text-center text-primary fw-bold">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            جاري تحميل المخازن...
                        </div>
                    }
                    else if (!FilteredWarehouses.Any())
                    {
                        <div class="p-5 text-center text-muted fw-bold">⚠️ لا توجد مخازن مطابقة لخيارات الفلترة والبحث.</div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0 text-center align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%;">الكود</th>
                                    <th class="text-start ps-3" style="width: 25%;">اسم المخزن</th>
                                    <th style="width: 17%;">النوع</th>
                                    <th style="width: 18%;">يتبع لـ (المخزن الرئيسي)</th>
                                    <th style="width: 12%;">الحالة</th>
                                    <th style="width: 13%;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in FilteredWarehouses)
                                {
                                    <tr @key="w.Id">
                                        <td class="fw-bold font-monospace text-primary">@w.WarehouseCode</td>
                                        <td class="fw-bold text-start ps-3 text-dark">@w.WarehouseName</td>
                                        <td>
                                            <span class="badge @GetTypeBadgeClass(w.WarehouseType)">@w.WarehouseType</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(w.ParentWarehouseName))
                                            {
                                                <span class="badge bg-secondary">@w.ParentWarehouseName</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">مخزن رئيسي</span>
                                            }
                                        </td>
                                        <td>
                                            @if (w.Active)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">مفعل</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">موقوف</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary fw-bold me-1 py-0 px-2" @onclick="() => EditWarehouse(w)" title="تعديل">✏️</button>
                                            <button class="btn btn-sm btn-outline-danger fw-bold py-0 px-2" @onclick="() => DeleteWarehouse(w.Id)" title="حذف">🗑️</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- نافذة استيراد المخازن من ملف إكسيل (IMPORT MODAL)              -->
<!-- ============================================================== -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد وتحديث هيكل المخازن من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> 
                        يتعرف النظام تلقائياً على كود المخزن، اسمه، نوعه، والمخزن الرئيسي التابع له. يتم إنشاء المخازن الجديدة وتحديث المسجلة مسبقاً تلقائياً.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة المخازن المقروءة من الملف (@importedPreviewList.Count مخزن):</span>
                            <span class="badge bg-success">جاهز للاستيراد</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>كود المخزن</th>
                                        <th>اسم المخزن</th>
                                        <th>نوع المخزن</th>
                                        <th>يتبع لمخزن رئيسي</th>
                                        <th>الحالة</th>
                                        <th>الوصف</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold text-primary">@row.WarehouseCode</td>
                                            <td class="fw-bold text-start ps-2">@row.WarehouseName</td>
                                            <td><span class="badge @GetTypeBadgeClass(row.WarehouseType)">@row.WarehouseType</span></td>
                                            <td>@(string.IsNullOrEmpty(row.ParentWarehouseCodeOrName) ? "مخزن رئيسي مستقل" : row.ParentWarehouseCodeOrName)</td>
                                            <td>
                                                <span class="badge @(row.Active ? "bg-success" : "bg-danger")">
                                                    @(row.Active ? "مفعل" : "موقوف")
                                                </span>
                                            </td>
                                            <td class="text-muted text-start ps-2">@row.Description</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@(isSavingImport || !importedPreviewList.Any())" 
                            @onclick="ProcessAndSaveImportAsync">
                        @if (isSavingImport)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري معالجة واستيراد المخازن...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check-circle"></i> تأكيد استيراد وتحديث المخازن (@importedPreviewList.Count)</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    public class WarehouseDto
    {
        public long Id { get; set; }
        public string WarehouseCode { get; set; } = string.Empty;
        public string WarehouseName { get; set; } = string.Empty;
        public string WarehouseType { get; set; } = string.Empty;
        public long? ParentWarehouseId { get; set; }
        public string? ParentWarehouseName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool Active { get; set; } = true;
    }

    public class WarehouseImportRow
    {
        public string WarehouseCode { get; set; } = string.Empty;
        public string WarehouseName { get; set; } = string.Empty;
        public string WarehouseType { get; set; } = "خامات";
        public string? ParentWarehouseCodeOrName { get; set; }
        public string? Description { get; set; }
        public bool Active { get; set; } = true;
    }

    private List<WarehouseDto> warehousesList = new();
    private WarehouseDto currentWarehouse = new WarehouseDto { Active = true };
    private List<WarehouseImportRow> importedPreviewList = new();

    private string selectedWarehouseTypeOption = "";
    private bool isCustomTypeSelected = false;

    private bool isEditMode = false;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isSavingImport = false;
    private bool isImportModalOpen = false;

    private string errorMessage = "";
    private string successMessage = "";
    private string apiUrl = "api/Warehouses";

    // فلاتر البحث
    private string searchTerm = "";
    private string selectedTypeFilter = "all";
    private string selectedParentFilter = "all";
    private string selectedStatusFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehouses();
    }

    private async Task LoadWarehouses()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            warehousesList = await Http.GetFromJsonAsync<List<WarehouseDto>>(apiUrl) ?? new();
        }
        catch
        {
            errorMessage = "❌ تعذر الاتصال بالخادم لجلب بيانات المخازن.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnWarehouseTypeOptionChanged()
    {
        if (selectedWarehouseTypeOption == "CUSTOM")
        {
            isCustomTypeSelected = true;
            currentWarehouse.WarehouseType = "";
        }
        else
        {
            isCustomTypeSelected = false;
            currentWarehouse.WarehouseType = selectedWarehouseTypeOption;
        }
    }

    // ==========================================
    // محرك الفلترة المتعددة
    // ==========================================
    private IEnumerable<WarehouseDto> FilteredWarehouses
    {
        get
        {
            var query = warehousesList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(w =>
                    w.WarehouseName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    w.WarehouseCode.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedTypeFilter != "all")
            {
                query = query.Where(w => w.WarehouseType.Equals(selectedTypeFilter, StringComparison.OrdinalIgnoreCase) ||
                                         w.WarehouseType.Contains(selectedTypeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedParentFilter == "main_only")
            {
                query = query.Where(w => !w.ParentWarehouseId.HasValue || w.ParentWarehouseId == 0);
            }
            else if (selectedParentFilter == "sub_only")
            {
                query = query.Where(w => w.ParentWarehouseId.HasValue && w.ParentWarehouseId > 0);
            }
            else if (long.TryParse(selectedParentFilter, out var parentId) && parentId > 0)
            {
                query = query.Where(w => w.ParentWarehouseId == parentId);
            }

            if (selectedStatusFilter == "active")
            {
                query = query.Where(w => w.Active);
            }
            else if (selectedStatusFilter == "inactive")
            {
                query = query.Where(w => !w.Active);
            }

            return query;
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        selectedTypeFilter != "all" ||
        selectedParentFilter != "all" ||
        selectedStatusFilter != "all";

    private void ResetFilters()
    {
        searchTerm = "";
        selectedTypeFilter = "all";
        selectedParentFilter = "all";
        selectedStatusFilter = "all";
    }

