@page "/supplier-prices"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة وأزرار التصدير والاستيراد -->
    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border-start border-warning border-4">
        <div>
            <h4 class="mb-1 text-dark fw-bold">🏷️ قوائم أسعار التوريد (Supplier Price Lists)</h4>
            <small class="text-muted">إدارة عروض وأسعار التوريد للأصناف وربطها بالموردين المعتمدين ومدة التوريد</small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportToExcelAsync">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل
            </button>
            <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                <i class="bi bi-download me-1"></i> تحميل قالب الإكسيل
            </button>
            <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد من إكسيل
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadDataAsync">
                <i class="bi bi-arrow-clockwise"></i> تحديث
            </button>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-1"></i> @successMessage
            <button type="button" class="btn-close py-2" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
            <button type="button" class="btn-close py-2" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- بطاقة تسجيل / تعديل سعر توريد جديد -->
    <div class="card shadow-sm border-0 border-top border-primary border-3 mb-3 bg-white">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-primary">
                @(editId > 0 ? "✏️ تعديل سعر توريد مسجل" : "➕ تسجيل سعر توريد جديد")
            </h6>
            @if (editId > 0)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="ResetForm">إلغاء التعديل</button>
            }
        </div>
        <div class="card-body p-3">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">المورد <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm fw-bold" @bind="selectedSupplierId">
                        <option value="0">-- اختر المورد --</option>
                        @foreach (var sup in suppliers)
                        {
                            <option value="@sup.Id">@sup.SupplierName</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">الصنف / الخامة <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm fw-bold" @bind="selectedItemId">
                        <option value="0">-- اختر الصنف --</option>
                        @foreach (var item in items)
                        {
                            <option value="@item.Id">@item.ItemName (@item.Unit)</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">سعر التوريد * (ج.م)</label>
                    <input type="number" step="0.01" class="form-control form-control-sm font-monospace fw-bold text-success" 
                           @bind="inputPrice" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">مدة التوريد (أيام)</label>
                    <input type="number" class="form-control form-control-sm font-monospace text-center" 
                           @bind="inputDeliveryDays" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">تاريخ السريان</label>
                    <input type="date" class="form-control form-control-sm font-monospace" 
                           @bind="inputEffectiveDate" />
                </div>

                <div class="col-md-8">
                    <label class="form-label small fw-bold text-secondary mb-1">ملاحظات العرض / شروط التسليم</label>
                    <input type="text" class="form-control form-control-sm" placeholder="مثال: شامل النقل والتوصيل حتى مخزن المصنع..." 
                           @bind="inputNotes" />
                </div>

                <div class="col-md-2 d-flex align-items-center pt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="prefCheck" @bind="inputIsPreferred" />
                        <label class="form-check-label small fw-bold text-warning" for="prefCheck">
                            ⭐ مورد مفضل للصنف
                        </label>
                    </div>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm" 
                            disabled="@isSaving" @onclick="SavePriceAsync">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-save me-1"></i> @(editId > 0 ? "تحديث السعر" : "تسجيل السعر")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- شريط فلاتر البحث المتقدمة -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-top border-warning border-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-secondary mb-1">🔍 بحث بالاسم أو الملاحظات</label>
                    <input type="text" class="form-control form-control-sm" placeholder="ابحث باسم المورد، الخامة، أو شروط العرض..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">🏢 فلترة بالمورد</label>
                    <select class="form-select form-select-sm" @bind="selectedSupplierFilter">
                        <option value="0">-- كل الموردين --</option>
                        @foreach (var sup in suppliers)
                        {
                            <option value="@sup.Id">@sup.SupplierName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">📦 فلترة بالصنف / الخامة</label>
                    <select class="form-select form-select-sm" @bind="selectedItemFilter">
                        <option value="0">-- كل الأصناف والخامات --</option>
                        @foreach (var item in items)
                        {
                            <option value="@item.Id">@item.ItemName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">⭐ التفضيل</label>
                    <select class="form-select form-select-sm" @bind="selectedPreferenceFilter">
                        <option value="all">كل العروض</option>
                        <option value="preferred">⭐ مورد مفضل فقط</option>
                        <option value="alternative">بديل</option>
                    </select>
                </div>
            </div>

            @if (HasActiveFilters)
            {
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    <span class="small text-primary fw-bold">
                        <i class="bi bi-funnel-fill me-1"></i> نتائج التصفية: (@FilteredPrices.Count() من إجمالي @priceList.Count عرض مسجل)
                    </span>
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" style="font-size: 0.78rem;" @onclick="ResetFilters">
                        ✕ إلغاء الفلاتر وعرض الكل
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- جدول سجل الأسعار وعروض التوريد المسجلة -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <span class="small fw-bold">📋 سجل الأسعار وعروض التوريد المسجلة</span>
            <span class="badge bg-primary">المعروض: @FilteredPrices.Count() عرض</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center small">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">المورد</th>
                        <th>الصنف / المادة الخام</th>
                        <th>الوحدة</th>
                        <th>سعر التوريد</th>
                        <th>مدة التوريد</th>
                        <th>تاريخ السريان</th>
                        <th>التفضيل</th>
                        <th>الملاحظات</th>
                        <th style="width: 140px;">إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="9" class="py-4 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري تحميل قوائم الأسعار...
                            </td>
                        </tr>
                    }
                    else if (!FilteredPrices.Any())
                    {
                        <tr>
                            <td colspan="9" class="py-4 text-muted">لا توجد عروض أسعار مطابقة لشروط البحث والفلترة.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in FilteredPrices)
                        {
                            <tr class="@(row.Id == editId ? "table-primary" : "")" @key="row.Id">
                                <td class="text-start fw-bold text-dark">@(string.IsNullOrEmpty(row.SupplierName) ? GetSupplierName(row.SupplierId) : row.SupplierName)</td>
                                <td class="fw-bold text-primary">@(string.IsNullOrEmpty(row.ItemName) ? GetItemName(row.ItemId) : row.ItemName)</td>
                                <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(row.Unit) ? GetItemUnit(row.ItemId) : row.Unit)</span></td>
                                <td class="fw-bold font-monospace text-success">EGP @row.Price.ToString("N2")</td>
                                <td>@row.DeliveryDays يوم</td>
                                <td class="font-monospace text-muted">@row.EffectiveDate</td>
                                <td>
                                    <span class="badge @(row.IsPreferred ? "bg-warning text-dark" : "bg-light text-secondary border")">
                                        @(row.IsPreferred ? "⭐ مورد مفضل" : "بديل")
                                    </span>
                                </td>
                                <td class="text-muted text-truncate" style="max-width: 180px;">@(string.IsNullOrEmpty(row.Notes) ? "-" : row.Notes)</td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm py-0 px-2 fw-bold me-1" @onclick="() => EditPrice(row)">
                                        تعديل
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" @onclick="() => DeletePriceAsync(row)">
                                        حذف
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- نافذة استيراد عروض الأسعار من إكسيل (مطابقة الهيدر بدقة 100%) -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد عروض أسعار التوريد من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> 
                        يتعرف النظام تلقائياً على أعمدة السعر والخامة والمورد من الملف المرفوع سواء تم تصديره من المنظومة أو من ملف خارجي.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة الأسعار المقروءة من الملف (@importedPreviewList.Count عرض):</span>
                            <span class="badge bg-success">جاهز للاستيراد</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>المورد</th>
                                        <th>الصنف / المادة الخام</th>
                                        <th>سعر التوريد</th>
                                        <th>مدة التوريد</th>
                                        <th>تاريخ السريان</th>
                                        <th>التفضيل</th>
                                        <th>الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="text-start fw-bold">@row.SupplierName</td>
                                            <td class="fw-bold text-primary">@row.ItemName</td>
                                            <td class="font-monospace text-success fw-bold">@row.Price.ToString("N2") ج.م</td>
                                            <td>@row.DeliveryDays يوم</td>
                                            <td class="font-monospace text-muted">@row.EffectiveDate</td>
                                            <td>
                                                <span class="badge @(row.IsPreferred ? "bg-warning text-dark" : "bg-light text-secondary border")">
                                                    @(row.IsPreferred ? "مفضل" : "بديل")
                                                </span>
                                            </td>
                                            <td class="text-muted">@row.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@(isSavingImport || !importedPreviewList.Any())" 
                            @onclick="ProcessAndSaveImportAsync">
                        @if (isSavingImport)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري معالجة وتحديث الأسعار...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check-circle"></i> تأكيد واستيراد كافة الأسعار (@importedPreviewList.Count)</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    public class SupplierPriceDto
    {
        public long Id { get; set; }
        public long SupplierId { get; set; }
        public string SupplierName { get; set; } = string.Empty;
        public string SupplierCode { get; set; } = string.Empty;
        public long ItemId { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public string Currency { get; set; } = "EGP";

        [JsonPropertyName("leadTimeDays")]
        public int LeadTimeDays { get; set; } = 1;

        [JsonPropertyName("deliveryDays")]
        public int DeliveryDays { get; set; } = 1;

        [JsonPropertyName("effectiveDate")]
        public string EffectiveDate { get; set; } = string.Empty;

        public bool IsPreferred { get; set; }
        public string? Notes { get; set; }
    }

    public class SupplierItemLookupDto
    {
        public long Id { get; set; }
        public string SupplierName { get; set; } = string.Empty;
    }

    public class ItemLookupDto
    {
        public long Id { get; set; }
        public string ItemName { get; set; } = string.Empty;
        public string Unit { get; set; } = "كجم";
    }

    public class PriceImportRowDto
    {
        public string SupplierName { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int DeliveryDays { get; set; } = 1;
        public string EffectiveDate { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        public bool IsPreferred { get; set; } = false;
        public string Notes { get; set; } = string.Empty;
    }

    private List<SupplierPriceDto> priceList = new();
    private List<SupplierItemLookupDto> suppliers = new();
    private List<ItemLookupDto> items = new();
    private List<PriceImportRowDto> importedPreviewList = new();

    // حقول النموذج المباشرة
    private long editId = 0;
    private long selectedSupplierId = 0;
    private long selectedItemId = 0;
    private decimal inputPrice = 0;
    private int inputDeliveryDays = 1;
    private DateTime inputEffectiveDate = DateTime.Today;
    private bool inputIsPreferred = false;
    private string inputNotes = string.Empty;

    // الفلاتر
    private string searchTerm = "";
    private long selectedSupplierFilter = 0;
    private long selectedItemFilter = 0;
    private string selectedPreferenceFilter = "all";

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isSavingImport = false;
    private bool isImportModalOpen = false;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            suppliers = await Http.GetFromJsonAsync<List<SupplierItemLookupDto>>("api/suppliers") ?? new();
        }
        catch { }

        try
        {
            items = await Http.GetFromJsonAsync<List<ItemLookupDto>>("api/items") ?? new();
        }
        catch { }

        try
        {
            priceList = await Http.GetFromJsonAsync<List<SupplierPriceDto>>("api/SupplierPrices") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب قوائم الأسعار: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetSupplierName(long supId) => suppliers.FirstOrDefault(s => s.Id == supId)?.SupplierName ?? "غير محدد";
    private string GetItemName(long itemId) => items.FirstOrDefault(i => i.Id == itemId)?.ItemName ?? "غير محدد";
    private string GetItemUnit(long itemId) => items.FirstOrDefault(i => i.Id == itemId)?.Unit ?? "كجم";

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        selectedSupplierFilter > 0 ||
        selectedItemFilter > 0 ||
        selectedPreferenceFilter != "all";

    private void ResetFilters()
    {
        searchTerm = "";
        selectedSupplierFilter = 0;
        selectedItemFilter = 0;
        selectedPreferenceFilter = "all";
    }

    private IEnumerable<SupplierPriceDto> FilteredPrices
    {
        get
        {
            var query = priceList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(p =>
                    p.SupplierName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(p.Notes) && p.Notes.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (selectedSupplierFilter > 0)
                query = query.Where(p => p.SupplierId == selectedSupplierFilter);

            if (selectedItemFilter > 0)
                query = query.Where(p => p.ItemId == selectedItemFilter);

            if (selectedPreferenceFilter == "preferred")
                query = query.Where(p => p.IsPreferred);
            else if (selectedPreferenceFilter == "alternative")
                query = query.Where(p => !p.IsPreferred);

            return query;
        }
    }

    private void EditPrice(SupplierPriceDto p)
    {
        editId = p.Id;
        selectedSupplierId = p.SupplierId;
        selectedItemId = p.ItemId;
        inputPrice = p.Price;
        inputDeliveryDays = p.DeliveryDays > 0 ? p.DeliveryDays : p.LeadTimeDays;
        if (DateTime.TryParse(p.EffectiveDate, out var dt))
            inputEffectiveDate = dt;
        else
            inputEffectiveDate = DateTime.Today;

        inputIsPreferred = p.IsPreferred;
        inputNotes = p.Notes ?? "";
        errorMessage = null;
    }

    private void ResetForm()
    {
        editId = 0;
        selectedSupplierId = 0;
        selectedItemId = 0;
        inputPrice = 0;
        inputDeliveryDays = 1;
        inputEffectiveDate = DateTime.Today;
        inputIsPreferred = false;
        inputNotes = string.Empty;
        errorMessage = null;
    }

    private async Task SavePriceAsync()
    {
        if (selectedSupplierId <= 0 || selectedItemId <= 0 || inputPrice <= 0)
        {
            errorMessage = "يرجى تحديد المورد والصنف وتحديد سعر توريد أكبر من الصفر.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var payload = new
            {
                SupplierId = selectedSupplierId,
                ItemId = selectedItemId,
                Price = inputPrice,
                Currency = "EGP",
                LeadTimeDays = inputDeliveryDays,
                DeliveryDays = inputDeliveryDays,
                EffectiveDate = inputEffectiveDate.ToString("yyyy-MM-dd"), // إرسال yyyy-MM-dd لمنع خطأ تحويل DateOnly
                IsPreferred = inputIsPreferred,
                Notes = inputNotes
            };

            HttpResponseMessage res;
            if (editId > 0)
            {
                res = await Http.PutAsJsonAsync($"api/SupplierPrices/{editId}", payload);
            }
            else
            {
                res = await Http.PostAsJsonAsync("api/SupplierPrices", payload);
            }

            if (res.IsSuccessStatusCode)
            {
                successMessage = editId > 0 ? "تم تحديث سعر التوريد بنجاح." : "تم تسجيل سعر التوريد بنجاح.";
                ResetForm();
                await LoadDataAsync();
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                errorMessage = $"فشل الحفظ: {body}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في الاتصال: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePriceAsync(SupplierPriceDto p)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف سعر توريد ({p.ItemName}) من المورد ({p.SupplierName})؟");
        if (!confirm) return;

        try
        {
            var res = await Http.DeleteAsync($"api/SupplierPrices/{p.Id}");
            if (res.IsSuccessStatusCode)
            {
                priceList.RemoveAll(x => x.Id == p.Id);
                successMessage = "تم حذف سعر التوريد بنجاح.";
                StateHasChanged();
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                errorMessage = $"تعذر الحذف: {body}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء الحذف: {ex.Message}";
        }
    }

    // ==========================================
    // محرك التصدير والاستيراد للإكسيل
    // ==========================================
    private async Task ExportToExcelAsync()
    {
        var list = FilteredPrices.ToList();
        if (!list.Any())
        {
            errorMessage = "لا توجد أسعار مسجلة لتصديرها.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("المورد,الصنف_الخامة,الوحدة,سعر_التوريد,مدة_التوريد_ايام,تاريخ_السريان,التفضيل,الملاحظات");

            foreach (var p in list)
            {
                var sup = !string.IsNullOrEmpty(p.SupplierName) ? p.SupplierName : GetSupplierName(p.SupplierId);
                var item = !string.IsNullOrEmpty(p.ItemName) ? p.ItemName : GetItemName(p.ItemId);
                var unit = !string.IsNullOrEmpty(p.Unit) ? p.Unit : GetItemUnit(p.ItemId);
                var pref = p.IsPreferred ? "مورد مفضل" : "بديل";
                var notes = (p.Notes ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");
                var days = p.DeliveryDays > 0 ? p.DeliveryDays : p.LeadTimeDays;
                sb.AppendLine($"{EscapeCsv(sup)},{EscapeCsv(item)},{EscapeCsv(unit)},{p.Price},{days},{p.EffectiveDate},{pref},{EscapeCsv(notes)}");
            }

            var fileName = $"عروض_أسعار_الموردين_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            successMessage = $"تم تصدير ({list.Count}) عرض سعر إلى إكسيل بنجاح.";
        }
        catch (Exception ex)
        {
            errorMessage = $"حدث خطأ أثناء التصدير: {ex.Message}";
        }
    }

