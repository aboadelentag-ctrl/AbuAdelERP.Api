    private async Task TriggerBrowserDownload(string fileName, string content)
    {
        var utf8WithBom = "\uFEFF" + content;
        var jsCommand = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", jsCommand);
    }

    private string EscapeCsv(string val)
    {
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n"))
            return $"\"{val.Replace("\"", "\"\"")}\"";
        return val;
    }

    private void OpenImportModal()
    {
        importedPreviewList.Clear();
        errorMessage = null;
        isImportModalOpen = true;
    }

    private void CloseImportModal()
    {
        isImportModalOpen = false;
        importedPreviewList.Clear();
    }

    // مطابقة الهيدر بدقة لمنع ترحيل الأعمدة
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        errorMessage = null;

        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1)
            {
                errorMessage = "الملف فارغ أو لا يحتوي على صفوف بيانات.";
                return;
            }

            var headerCols = ParseCsvLine(lines[0]);
            int supIdx = -1, itemIdx = -1, priceIdx = -1, daysIdx = -1, dateIdx = -1, prefIdx = -1, notesIdx = -1;

            for (int i = 0; i < headerCols.Count; i++)
            {
                var h = headerCols[i].Trim().ToLower();
                if (h.Contains("مورد") || h.Contains("supplier")) supIdx = i;
                else if (h.Contains("صنف") || h.Contains("خام") || h.Contains("item")) itemIdx = i;
                else if (h.Contains("سعر") || h.Contains("price")) priceIdx = i;
                else if (h.Contains("مد") || h.Contains("days") || h.Contains("lead")) daysIdx = i;
                else if (h.Contains("تاريخ") || h.Contains("date")) dateIdx = i;
                else if (h.Contains("تفضيل") || h.Contains("مفضل") || h.Contains("pref")) prefIdx = i;
                else if (h.Contains("ملاحظ") || h.Contains("notes")) notesIdx = i;
            }

            // Fallback في حال غياب الهيدر
            if (supIdx == -1) supIdx = 0;
            if (itemIdx == -1) itemIdx = 1;
            if (priceIdx == -1) priceIdx = headerCols.Count > 3 ? 3 : 2;
            if (daysIdx == -1) daysIdx = headerCols.Count > 4 ? 4 : 3;
            if (dateIdx == -1) dateIdx = headerCols.Count > 5 ? 5 : -1;
            if (prefIdx == -1) prefIdx = headerCols.Count > 6 ? 6 : -1;
            if (notesIdx == -1) notesIdx = headerCols.Count > 7 ? 7 : -1;

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = ParseCsvLine(line);
                if (cols.Count >= 2)
                {
                    string supName = supIdx < cols.Count ? cols[supIdx].Trim() : "";
                    string itmName = itemIdx < cols.Count ? cols[itemIdx].Trim() : "";

                    decimal price = 0;
                    if (priceIdx != -1 && priceIdx < cols.Count)
                    {
                        var cleanPrice = cols[priceIdx].Replace("EGP", "").Replace("ج.م", "").Trim();
                        decimal.TryParse(cleanPrice, out price);
                    }

                    int days = 1;
                    if (daysIdx != -1 && daysIdx < cols.Count)
                    {
                        var cleanDays = cols[daysIdx].Replace("يوم", "").Trim();
                        int.TryParse(cleanDays, out days);
                        if (days <= 0) days = 1;
                    }

                    string effDate = DateTime.Today.ToString("yyyy-MM-dd");
                    if (dateIdx != -1 && dateIdx < cols.Count && DateTime.TryParse(cols[dateIdx].Trim(), out var pDate))
                    {
                        effDate = pDate.ToString("yyyy-MM-dd");
                    }

                    bool isPref = false;
                    if (prefIdx != -1 && prefIdx < cols.Count)
                    {
                        var pStr = cols[prefIdx].Trim();
                        isPref = pStr == "1" || pStr.Contains("مفضل") || pStr.Equals("true", StringComparison.OrdinalIgnoreCase);
                    }

                    string notes = notesIdx != -1 && notesIdx < cols.Count ? cols[notesIdx].Trim() : "";

                    importedPreviewList.Add(new PriceImportRowDto
                    {
                        SupplierName = supName,
                        ItemName = itmName,
                        Price = price,
                        DeliveryDays = days,
                        EffectiveDate = effDate,
                        IsPreferred = isPref,
                        Notes = notes
                    });
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل قراءة الملف: {ex.Message}";
        }
    }

    private List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var curVal = new StringBuilder();

        foreach (char c in line)
        {
            if (c == '\"') inQuotes = !inQuotes;
            else if (c == ',' && !inQuotes)
            {
                result.Add(curVal.ToString());
                curVal.Clear();
            }
            else curVal.Append(c);
        }
        result.Add(curVal.ToString());
        return result;
    }

    private async Task ProcessAndSaveImportAsync()
    {
        if (!importedPreviewList.Any()) return;

        isSavingImport = true;
        errorMessage = null;

        try
        {
            int updatedCount = 0;
            int createdCount = 0;

            foreach (var row in importedPreviewList)
            {
                var sup = suppliers.FirstOrDefault(s => s.SupplierName.Trim().Equals(row.SupplierName.Trim(), StringComparison.OrdinalIgnoreCase) || s.SupplierName.Contains(row.SupplierName.Trim()));
                var itm = items.FirstOrDefault(i => i.ItemName.Trim().Equals(row.ItemName.Trim(), StringComparison.OrdinalIgnoreCase) || i.ItemName.Contains(row.ItemName.Trim()));

                if (sup == null || itm == null || row.Price <= 0) continue;

                var existing = priceList.FirstOrDefault(p => p.SupplierId == sup.Id && p.ItemId == itm.Id);

                var payload = new
                {
                    SupplierId = sup.Id,
                    ItemId = itm.Id,
                    Price = row.Price,
                    Currency = "EGP",
                    LeadTimeDays = row.DeliveryDays,
                    DeliveryDays = row.DeliveryDays,
                    EffectiveDate = row.EffectiveDate,
                    IsPreferred = row.IsPreferred,
                    Notes = row.Notes
                };

                HttpResponseMessage res;
                if (existing != null)
                {
                    res = await Http.PutAsJsonAsync($"api/SupplierPrices/{existing.Id}", payload);
                    if (res.IsSuccessStatusCode) updatedCount++;
                }
                else
                {
                    res = await Http.PostAsJsonAsync("api/SupplierPrices", payload);
                    if (res.IsSuccessStatusCode) createdCount++;
                }
            }

            successMessage = $"اكتمل الاستيراد: تم تحديث ({updatedCount}) وإضافة ({createdCount}) عرض سعر جديد بنجاح.";
            CloseImportModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء حفظ الأسعار: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }
