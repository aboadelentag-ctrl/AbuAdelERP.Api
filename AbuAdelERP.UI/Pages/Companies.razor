@page "/companies"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@inject HttpClient Http
@using System.Net.Http.Json

<div class="container-fluid mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="text-primary m-0 mb-1">🏢 إدارة الشركات</h3>
            <span class="text-muted">تعريف الشركات والمؤسسات داخل النظام (الكيان الأساسي)</span>
        </div>
    </div>

    <div class="row">
        <!-- نموذج الإضافة / التعديل -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-top border-primary border-4">
                <div class="card-header bg-white py-3">
                    <h5 class="text-primary m-0 fw-bold">@(isEditMode ? "تعديل بيانات الشركة" : "إضافة شركة جديدة")</h5>
                </div>
                <div class="card-body bg-light">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger fw-bold shadow-sm" style="font-size: 0.9rem;">@errorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success fw-bold shadow-sm">@successMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">كود الشركة</label>
                        <input type="text" class="form-control border-primary" @bind="currentCompany.CompanyCode" placeholder="مثال: COMP-01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">اسم الشركة</label>
                        <input type="text" class="form-control border-primary" @bind="currentCompany.CompanyName" placeholder="مثال: مؤسسة حلواني أبو عادل" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">رقم الهاتف</label>
                        <input type="text" class="form-control" @bind="currentCompany.Phone" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">البريد الإلكتروني</label>
                        <input type="email" class="form-control" @bind="currentCompany.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">العنوان</label>
                        <textarea class="form-control" @bind="currentCompany.Address" rows="2"></textarea>
                    </div>

                    <div class="mb-4 form-check mt-3">
                        <input type="checkbox" class="form-check-input border-primary" id="isActive" @bind="currentCompany.Active" style="transform: scale(1.4); margin-left: 10px;" />
                        <label class="form-check-label fw-bold text-dark" for="isActive">الشركة مفعلة</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary fw-bold shadow" @onclick="SaveCompany">
                            @(isEditMode ? "💾 حفظ التعديلات" : "➕ إضافة الشركة")
                        </button>
                        @if (isEditMode)
                        {
                            <button class="btn btn-outline-secondary fw-bold" @onclick="ResetForm">❌ إلغاء التعديل</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- جدول العرض -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0 table-responsive">
                    @if (isLoading)
                    {
                        <div class="p-5 text-center text-primary fw-bold">⏳ جاري تحميل الشركات...</div>
                    }
                    else if (companies == null || !companies.Any())
                    {
                        <div class="p-5 text-center text-muted fw-bold">⚠️ لا توجد شركات مسجلة حالياً.</div>
                    }
                    else
                    {
                        <table class="table table-hover table-bordered mb-0 text-center align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>رقم (ID)</th> <!-- تمت إضافة هذا العمود -->
                                    <th>الكود</th>
                                    <th>الاسم</th>
                                    <th>الهاتف</th>
                                    <th>العنوان</th>
                                    <th>الحالة</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comp in companies)
                                {
                                    <tr class="@(comp.Active ? "" : "bg-light text-muted")">
                                        <td class="fw-bold text-danger">@comp.Id</td> <!-- عرض الرقم الفعلي للشركة -->
                                        <td class="fw-bold">@comp.CompanyCode</td>
                                        <td class="text-primary fw-bold">@comp.CompanyName</td>
                                        <td dir="ltr">@comp.Phone</td>
                                        <td>@comp.Address</td>
                                        <td>
                                            @if (comp.Active)
                                            {
                                                <span class="badge bg-success">مفعل</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-danger">موقوف</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary m-1" @onclick="() => EditCompany(comp)">✏️ تعديل</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CompanyDto> companies = new();
    private CompanyDto currentCompany = new CompanyDto { Active = true };
    private bool isLoading = true;
    private bool isEditMode = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string apiUrl = "https://localhost:7273/api/Companies";

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
    }

    private async Task LoadCompanies()
    {
        isLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<CompanyDto>>(apiUrl);
            if (result != null) companies = result;
        }
        catch (Exception ex) { errorMessage = "خطأ في الاتصال: " + ex.Message; }
        isLoading = false;
    }

    private async Task SaveCompany()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(currentCompany.CompanyName) || string.IsNullOrWhiteSpace(currentCompany.CompanyCode))
        {
            errorMessage = "الرجاء إدخال اسم وكود الشركة.";
            return;
        }

        try
        {
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await Http.PutAsJsonAsync($"{apiUrl}/{currentCompany.Id}", currentCompany);
            }
            else
            {
                response = await Http.PostAsJsonAsync(apiUrl, currentCompany);
            }

            if (response.IsSuccessStatusCode)
            {
                successMessage = "✅ تم الحفظ بنجاح!";
                await LoadCompanies();
                ResetForm();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex) { errorMessage = "خطأ: " + ex.Message; }
    }

    private void EditCompany(CompanyDto comp)
    {
        currentCompany = new CompanyDto
        {
            Id = comp.Id,
            CompanyCode = comp.CompanyCode,
            CompanyName = comp.CompanyName,
            Phone = comp.Phone,
            Email = comp.Email,
            Address = comp.Address,
            Active = comp.Active
        };
        isEditMode = true;
        errorMessage = "";
        successMessage = "";
    }

    private void ResetForm()
    {
        currentCompany = new CompanyDto { Active = true };
        isEditMode = false;
    }

    public class CompanyDto
    {
        public long Id { get; set; }
        public string CompanyName { get; set; } = string.Empty;
        public string CompanyCode { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public bool Active { get; set; }
    }
}