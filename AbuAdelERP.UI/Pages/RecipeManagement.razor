    private void OpenImportModal()
    {
        importedPreviewList.Clear();
        isImportModalOpen = true;
    }

    private void CloseImportModal()
    {
        isImportModalOpen = false;
        importedPreviewList.Clear();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1) return;

            var header = lines[0].Split(',');
            int codeIdx = 0, nameIdx = 1, prodIdx = 2, bQtyIdx = 3, bUnitIdx = 4, pcsIdx = 5, yieldIdx = 6, wasteIdx = 7, timeIdx = 8;
            int matCodeIdx = 9, matNameIdx = 10, mQtyIdx = 11, mUnitIdx = 12, mWasteIdx = 13, notesIdx = 14;

            for (int i = 0; i < header.Length; i++)
            {
                var h = header[i].Trim().ToLower();
                if (h.Contains("كود_الوصفة") || h.Contains("recipe_code")) codeIdx = i;
                else if (h.Contains("اسم_الخلطة") || h.Contains("معيار")) nameIdx = i;
                else if (h.Contains("منتج") || h.Contains("product")) prodIdx = i;
                else if (h.Contains("حجم_الوجبة") || h.Contains("batch_qty")) bQtyIdx = i;
                else if (h.Contains("وحدة_الوجبة") || h.Contains("batch_unit")) bUnitIdx = i;
                else if (h.Contains("قطع") || h.Contains("pieces")) pcsIdx = i;
                else if (h.Contains("خرج") || h.Contains("yield")) yieldIdx = i;
                else if (h.Contains("فاقد_التشغيل") || h.Contains("general_waste")) wasteIdx = i;
                else if (h.Contains("وقت") || h.Contains("time")) timeIdx = i;
                else if (h.Contains("كود_المكون") || h.Contains("كود_الخام")) matCodeIdx = i;
                else if (h.Contains("اسم_المكون") || h.Contains("اسم_الخام")) matNameIdx = i;
                else if (h.Contains("كمية_المكون") || h.Contains("كمية_الخام")) mQtyIdx = i;
                else if (h.Contains("وحدة_المكون") || h.Contains("وحدة_الخام")) mUnitIdx = i;
                else if (h.Contains("فاقد_المكون") || h.Contains("فاقد_الخام")) mWasteIdx = i;
                else if (h.Contains("ملاحظ") || h.Contains("notes")) notesIdx = i;
            }

            var tempRows = new List<(string Code, string Name, string Prod, decimal BQty, string BUnit, decimal Yield, decimal Pcs, decimal Waste, int Time, string MCode, string MName, decimal MQty, string MUnit, decimal MWaste, string Notes)>();

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;
                var cols = line.Split(',');

                if (cols.Length >= 3)
                {
                    string rCode = codeIdx < cols.Length ? cols[codeIdx].Trim() : "";
                    string rName = nameIdx < cols.Length ? cols[nameIdx].Trim() : "";
                    string rProd = prodIdx < cols.Length ? cols[prodIdx].Trim() : "";
                    decimal.TryParse(bQtyIdx < cols.Length ? cols[bQtyIdx].Trim() : "10", out var bQty);
                    string bUnit = bUnitIdx < cols.Length ? cols[bUnitIdx].Trim() : "كجم";
                    decimal.TryParse(pcsIdx < cols.Length ? cols[pcsIdx].Trim() : "0", out var pcs);
                    decimal.TryParse(yieldIdx < cols.Length ? cols[yieldIdx].Trim() : "10", out var yieldQty);
                    decimal.TryParse(wasteIdx < cols.Length ? cols[wasteIdx].Trim() : "0", out var waste);
                    int.TryParse(timeIdx < cols.Length ? cols[timeIdx].Trim() : "60", out var timeVal);

                    string mCode = matCodeIdx < cols.Length ? cols[matCodeIdx].Trim() : "";
                    string mName = matNameIdx < cols.Length ? cols[matNameIdx].Trim() : "";
                    decimal.TryParse(mQtyIdx < cols.Length ? cols[mQtyIdx].Trim() : "1", out var mQty);
                    string mUnit = mUnitIdx < cols.Length ? cols[mUnitIdx].Trim() : "كجم";
                    decimal.TryParse(mWasteIdx < cols.Length ? cols[mWasteIdx].Trim() : "0", out var mWaste);
                    string notes = notesIdx < cols.Length ? cols[notesIdx].Trim() : "";

                    tempRows.Add((rCode, rName, rProd, bQty, bUnit, yieldQty, pcs, waste, timeVal, mCode, mName, mQty, mUnit, mWaste, notes));
                }
            }

            var grouped = tempRows.GroupBy(x => !string.IsNullOrEmpty(x.Code) ? x.Code : x.Name).ToList();

            foreach (var g in grouped)
            {
                var first = g.First();

                var matchedProduct = targetProductsList.FirstOrDefault(p =>
                    (!string.IsNullOrEmpty(first.Prod) && (p.ItemCode.Equals(first.Prod, StringComparison.OrdinalIgnoreCase) || p.ItemName.Contains(first.Prod, StringComparison.OrdinalIgnoreCase))));

                var recipePreview = new RecipeImportPreviewDto
                {
                    RecipeCode = !string.IsNullOrEmpty(first.Code) ? first.Code : $"BOM-{DateTime.Now:yyyyMMdd}-{new Random().Next(100, 999)}",
                    RecipeName = !string.IsNullOrEmpty(first.Name) ? first.Name : (matchedProduct != null ? $"معيار {matchedProduct.ItemName}" : "خلطة جديدة"),
                    RawProductName = first.Prod,
                    ProductItemId = matchedProduct?.Id ?? 0,
                    MatchedProductName = matchedProduct?.ItemName ?? "غير مطابق",
                    BatchQuantity = first.BQty > 0 ? first.BQty : 10,
                    BatchUnit = !string.IsNullOrEmpty(first.BUnit) ? first.BUnit : "كجم",
                    YieldQuantity = first.Yield > 0 ? first.Yield : 10,
                    PiecesPerBatch = first.Pcs,
                    WastePercentage = first.Waste,
                    PreparationTimeMinutes = first.Time > 0 ? first.Time : 60,
                    Lines = new List<RecipeLineDto>()
                };

                foreach (var lineRow in g)
                {
                    if (string.IsNullOrEmpty(lineRow.MCode) && string.IsNullOrEmpty(lineRow.MName)) continue;

                    var matchedMaterial = allIngredientsList.FirstOrDefault(m =>
                        (!string.IsNullOrEmpty(lineRow.MCode) && m.ItemCode.Equals(lineRow.MCode, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(lineRow.MName) && m.ItemName.Contains(lineRow.MName, StringComparison.OrdinalIgnoreCase)));

                    recipePreview.Lines.Add(new RecipeLineDto
                    {
                        ComponentItemId = matchedMaterial?.Id ?? 0,
                        ComponentItemCode = matchedMaterial?.ItemCode ?? lineRow.MCode,
                        ComponentItemName = matchedMaterial?.ItemName ?? lineRow.MName,
                        Quantity = lineRow.MQty > 0 ? lineRow.MQty : 1,
                        Unit = !string.IsNullOrEmpty(lineRow.MUnit) ? lineRow.MUnit : (matchedMaterial?.Unit ?? "كجم"),
                        WastePercentage = lineRow.MWaste,
                        Notes = lineRow.Notes
                    });
                }

                importedPreviewList.Add(recipePreview);
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"خطأ في قراءة ملف الإكسيل: {ex.Message}";
        }
    }

    private async Task ProcessAndSaveImportAsync()
    {
        var validRecipes = importedPreviewList.Where(r => r.ProductItemId > 0).ToList();
        if (!validRecipes.Any()) return;

        isSavingImport = true;
        try
        {
            var payloads = validRecipes.Select(r => new SaveRecipeDto
            {
                ProductItemId = r.ProductItemId,
                RecipeCode = r.RecipeCode,
                RecipeName = r.RecipeName,
                BatchQuantity = r.BatchQuantity,
                BatchUnit = r.BatchUnit,
                YieldQuantity = r.YieldQuantity,
                YieldUnit = r.BatchUnit,
                PiecesPerBatch = r.PiecesPerBatch,
                WastePercentage = r.WastePercentage,
                PreparationTimeMinutes = r.PreparationTimeMinutes,
                Active = true,
                Lines = r.Lines.Where(l => l.ComponentItemId > 0).ToList()
            }).ToList();

            var res = await Http.PostAsJsonAsync($"{apiBase}/recipes/bulk-import", payloads);
            if (res.IsSuccessStatusCode)
            {
                isSuccess = true;
                statusMessage = $"تم استيراد وحفظ وتحديث ({validRecipes.Count}) معيار خلطة BOM بنجاح!";
                CloseImportModal();
                await LoadData();
            }
            else
            {
                int savedCount = 0;
                foreach (var item in payloads)
                {
                    var r = await Http.PostAsJsonAsync($"{apiBase}/recipes", item);
                    if (r.IsSuccessStatusCode) savedCount++;
                }

                isSuccess = true;
                statusMessage = $"تم استيراد وحفظ ({savedCount}) معيار خلطة بنجاح!";
                CloseImportModal();
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"خطأ أثناء حفظ المعايير: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }

    private async Task TriggerBrowserDownload(string fileName, string content)
    {
        var utf8WithBom = "\uFEFF" + content;
        var jsCommand = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", jsCommand);
    }

    private string EscapeCsv(string val)
    {
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n"))
            return $"\"{val.Replace("\"", "\"\"")}\"";
        return val;
    }
