    {
        viewingTransfer = tr;
        isDetailsModalOpen = true;
    }

    private void CloseTransferDetailsModal()
    {
        viewingTransfer = null;
        isDetailsModalOpen = false;
    }

    private async Task PrintTransferDocument() => await JS.InvokeVoidAsync("eval", "window.print();");

    private void AddTransferLine() => transferLinesView.Add(new TransferLineViewModel());

    private async Task OnFromWarehouseChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var whId))
        {
            newTransfer.FromWarehouseId = whId;
            foreach (var line in transferLinesView.Where(l => l.ItemId > 0))
            {
                await ReloadBatchesForLine(line);
            }
        }
    }

    private async Task OnLineItemChanged(TransferLineViewModel line, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var itmId) && itmId > 0)
        {
            line.ItemId = itmId;
            var itm = allItems.FirstOrDefault(i => i.Id == itmId);
            line.ItemCode = itm?.ItemCode ?? "";
            line.ItemName = itm?.ItemName ?? "";
            line.Unit = !string.IsNullOrEmpty(itm?.Unit) ? itm.Unit : "كجم";

            await ReloadBatchesForLine(line);
        }
        else
        {
            line.ItemId = 0;
            line.AvailableStock = 0;
            line.AvailableBatches.Clear();
            line.BatchNumber = "";
            line.ExpiryDate = null;
            line.UnitCost = 0;
        }
    }

    private async Task ReloadBatchesForLine(TransferLineViewModel line)
    {
        if (newTransfer.FromWarehouseId <= 0 || line.ItemId <= 0) return;

        try
        {
            var info = await Http.GetFromJsonAsync<AvailableStockInfoDto>($"api/StockTransfers/available-batches?itemId={line.ItemId}&warehouseId={newTransfer.FromWarehouseId}");
            if (info != null)
            {
                line.AvailableStock = info.TotalAvailableQty;
                line.AvailableBatches = info.Batches;

                var topBatch = info.Batches.FirstOrDefault();
                if (topBatch != null)
                {
                    line.BatchNumber = topBatch.BatchNumber;
                    line.ExpiryDate = topBatch.ExpiryDate;
                    line.UnitCost = topBatch.UnitCost;
                }
                else
                {
                    line.BatchNumber = $"LOT-{DateTime.Now:yyyyMMdd}";
                    line.ExpiryDate = DateTime.Today.AddYears(1);
                    line.UnitCost = 0;
                }
            }
        }
        catch { }
    }

    private void OnBatchSelected(TransferLineViewModel line, ChangeEventArgs e)
    {
        var batchStr = e.Value?.ToString();
        line.BatchNumber = batchStr ?? "";

        var matched = line.AvailableBatches.FirstOrDefault(b => b.BatchNumber == batchStr);
        if (matched != null)
        {
            line.ExpiryDate = matched.ExpiryDate;
            line.UnitCost = matched.UnitCost;
        }
    }

    private async Task SubmitTransfer()
    {
        if (newTransfer.FromWarehouseId <= 0 || newTransfer.ToWarehouseId <= 0)
        {
            feedbackMessage = "⚠️ يرجى تحديد المخزن الراسل والمخزن المستقبل أولاً.";
            isSuccessFeedback = false;
            return;
        }

        if (newTransfer.FromWarehouseId == newTransfer.ToWarehouseId)
        {
            feedbackMessage = "⚠️ لا يمكن التحويل لنفس المخزن، يرجى اختيار مستودعين مختلفين.";
            isSuccessFeedback = false;
            return;
        }

        var validLines = transferLinesView.Where(l => l.ItemId > 0 && l.DispatchedQty > 0).ToList();
        if (!validLines.Any())
        {
            feedbackMessage = "⚠️️ يرجى اختيار صنف واحد على الأقل به رصيد وبكمية صالحة أكبر من الصفر.";
            isSuccessFeedback = false;
            return;
        }

        if (validLines.Any(l => l.DispatchedQty > l.AvailableStock))
        {
            feedbackMessage = "⚠️ توجد أصناف تتجاوز الكمية المطلوبة رصيدها الفعلي المتاح بالمخزن!";
            isSuccessFeedback = false;
            return;
        }

        isSubmitting = true;
        try
        {
            newTransfer.DispatchedBy = CurrentDispatcherDisplayName; // ربط هوية القائم بالصرف تلقائياً
            newTransfer.Lines = validLines.Select(l => new CreateStockTransferLineDto
            {
                ItemId = l.ItemId,
                DispatchedQty = l.DispatchedQty,
                BatchNumber = !string.IsNullOrWhiteSpace(l.BatchNumber) ? l.BatchNumber : $"LOT-{DateTime.Now:yyyyMMdd}",
                ExpiryDate = l.ExpiryDate ?? DateTime.Today.AddYears(1),
                UnitCost = l.UnitCost
            }).ToList();

            var response = await Http.PostAsJsonAsync("api/StockTransfers", newTransfer);

            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = "✅ تم إنشاء إذن التحويل وصرف الشحنة بنجاح! البضاعة الآن في الطريق بانتظار فحص واستلام المخزن المستقبل.";
                isSuccessFeedback = true;
                newTransfer = new CreateStockTransferDto();
                transferLinesView.Clear();
                AddTransferLine();
                await LoadTransfers();
                ChangeTab("IN_TRANSIT");
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                feedbackMessage = "❌ فشل إرسال التحويل: " + (!string.IsNullOrWhiteSpace(err) ? err : $"كود الخطأ ({response.StatusCode})");
                isSuccessFeedback = false;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"❌ خطأ في الاتصال: {ex.Message}";
            isSuccessFeedback = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void SelectForReceiving(StockTransferDetailDto tr)
    {
        selectedReceiveTransfer = tr;
        foreach (var l in selectedReceiveTransfer.Lines)
        {
            if (l.ReceivedQty == 0) l.ReceivedQty = l.DispatchedQty;
        }
    }

    private async Task ConfirmLineReceive(StockTransferLineDetailDto line, bool isExact)
    {
        var dto = new ConfirmTransferLineReceiveDto
        {
            LineId = line.Id,
            ReceivedQty = isExact ? line.DispatchedQty : line.ReceivedQty,
            IsAccepted = isExact,
            DiscrepancyReason = isExact ? null : line.DiscrepancyReason,
            ReceivedBy = CurrentDispatcherDisplayName // توثيق هوية المستلم تلقائياً من جلسة الدخول
        };

        var response = await Http.PostAsJsonAsync("api/StockTransfers/receive-line", dto);

        if (response.IsSuccessStatusCode)
        {
            line.LineStatus = isExact ? "ACCEPTED" : "DISPUTED";
            if (isExact) line.ReceivedQty = line.DispatchedQty;
            feedbackMessage = isExact ? "✅ تم تأكيد استلام ومطابقة الصنف بنجاح." : "⚠️ تم قيد العجز/الفرق وإحالة الشحنة إلى (لجنة فض المنازعات).";
            isSuccessFeedback = true;
            
            await LoadTransfers();

            if (selectedReceiveTransfer != null && selectedReceiveTransfer.Lines.All(l => l.LineStatus == "ACCEPTED"))
            {
                selectedReceiveTransfer = null;
            }
        }
        else
        {
            feedbackMessage = "❌ فشل تسجيل استلام الصنف: " + await response.Content.ReadAsStringAsync();
            isSuccessFeedback = false;
        }
    }

    private void SelectForDisputeResolution(StockTransferDetailDto tr) => selectedDisputeTransfer = tr;

    private async Task ConfirmResolveDispute(StockTransferLineDetailDto line)
    {
        try
        {
            decimal diff = line.DispatchedQty - line.ReceivedQty;
            var dto = new ResolveTransferDisputeDto
            {
                LineId = line.Id,
                FinalApprovedQty = line.ReceivedQty,
                LossQty = diff > 0 ? diff : 0,
                ResolutionNotes = !string.IsNullOrWhiteSpace(line.ResolutionNotes) 
                    ? line.ResolutionNotes 
                    : $"تمت المراجعة واعتماد عجز النقل من اللجنة بواسطة {CurrentDispatcherDisplayName}",
                ResolvedBy = CurrentDispatcherDisplayName // توثيق توقيع عضو اللجنة تلقائياً
            };

            var response = await Http.PostAsJsonAsync("api/StockTransfers/resolve-dispute", dto);

            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = $"✅ تم فض النزاع واعتماد الكمية النهائية ({line.ReceivedQty:N2} {line.Unit}) وترحيل الرصيد بنجاح!";
                isSuccessFeedback = true;
                selectedDisputeTransfer = null;
                selectedReceiveTransfer = null;
                await LoadTransfers();
            }
            else
            {
                feedbackMessage = "❌ فشل اعتماد قرار اللجنة: " + await response.Content.ReadAsStringAsync();
                isSuccessFeedback = false;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"❌ خطأ: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

    private async Task ExportTransfersToExcelAsync()
    {
        var list = FilteredTransfers.ToList();
        if (!list.Any())
        {
            feedbackMessage = "لا توجد تحويلات لتصديرها.";
            isSuccessFeedback = false;
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("رقم_التحويل,المخزن_الراسل,المخزن_المستقبل,المندوب_السائق,رقم_السيارة,تاريخ_الإرسال,الحالة,كود_الصنف,اسم_الصنف,الوحدة,الكمية_المرسلة,الكمية_المستلمة,هالك_النقل,رقم_التشغيلة_LOT,تاريخ_الصلاحية,حالة_السطر,سبب_الخلاف,قرار_اللجنة");

            foreach (var tr in list)
            {
                if (tr.Lines != null && tr.Lines.Any())
                {
                    foreach (var l in tr.Lines)
                    {
                        var expDate = l.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-";
                        var discReason = (l.DiscrepancyReason ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");
                        var resNotes = (l.ResolutionNotes ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");

                        sb.AppendLine($"{EscapeCsv(tr.TransferNumber)},{EscapeCsv(tr.FromWarehouseName)},{EscapeCsv(tr.ToWarehouseName)},{EscapeCsv(tr.DriverName ?? "نقل داخلي")},{EscapeCsv(tr.VehicleNumber ?? "-")},{tr.CreatedAt:yyyy-MM-dd HH:mm},{EscapeCsv(TranslateStatus(tr.Status))},{EscapeCsv(l.ItemCode)},{EscapeCsv(l.ItemName)},{EscapeCsv(l.Unit)},{l.DispatchedQty:F2},{l.ReceivedQty:F2},{l.LossQty:F2},{EscapeCsv(l.BatchNumber ?? "-")},{expDate},{EscapeCsv(l.LineStatus)},{EscapeCsv(discReason)},{EscapeCsv(resNotes)}");
                    }
                }
                else
                {
                    sb.AppendLine($"{EscapeCsv(tr.TransferNumber)},{EscapeCsv(tr.FromWarehouseName)},{EscapeCsv(tr.ToWarehouseName)},{EscapeCsv(tr.DriverName ?? "-")},{EscapeCsv(tr.VehicleNumber ?? "-")},{tr.CreatedAt:yyyy-MM-dd HH:mm},{EscapeCsv(TranslateStatus(tr.Status))},-,-,-,0,0,0,-,-,-,-,-");
                }
            }

            var fileName = $"سجل_التحويلات_بين_المخازن_أبو_عادل_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            feedbackMessage = $"✅ تم تصدير بيانات ({list.Count}) إذن تحويل إلى إكسيل بنجاح.";
            isSuccessFeedback = true;
        }
        catch (Exception ex)
        {
            feedbackMessage = $"❌ فشل التصدير: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

