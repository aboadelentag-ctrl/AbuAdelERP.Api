@page "/stock-transfers"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using AbuAdelERP.UI.Services
@inject HttpClient Http
@inject AppState State
@inject NavigationManager Navigation

<PageTitle>حوكمة إمداد الفروع واستلام المنافذ - كيان Enterprise</PageTitle>

<div class="kayan-transfers-viewport" dir="rtl">
    <!-- الشريط العلوي الموحد -->
    <header class="transfers-header-bar">
        <div class="d-flex align-items-center gap-3">
            <button class="back-home-btn" @onclick='() => Navigation.NavigateTo("/workspace")' title="العودة لمساحة العمل">
                <i class="bi bi-arrow-right fs-5"></i>
            </button>
            <div>
                <h4 class="mb-0 text-white fw-bold">حوكمة إمداد الفروع واستلام المنافذ 🚚</h4>
                <span class="text-muted small">الربط اللوجستي: الكنترول المركزي ⇦ سيارات التوزيع ⇦ الفروع والمعارض • @State.TenantName</span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-light btn-sm fw-bold" @onclick="LoadData" disabled="@isProcessing">
                <i class="bi bi-arrow-clockwise me-1"></i> تحديث الشحنات
            </button>
            <span class="badge bg-dark border border-secondary px-3 py-2 text-info">
                @State.FullName (@State.Role)
            </span>
        </div>
    </header>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="container-fluid px-4 pt-3">
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show border-0 shadow-sm py-2" role="alert">
                <strong>@(isSuccess ? "✓ " : "⚠️ ")</strong> @alertMessage
                <button type="button" class="btn-close py-2" @onclick="() => alertMessage = string.Empty"></button>
            </div>
        </div>
    }

    <!-- شريط التبويبات الرئيسي -->
    <div class="container-fluid px-4 pt-3">
        <ul class="nav nav-pills custom-pills-bar gap-2">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "list" ? "active" : "")" @onclick='() => activeTab = "list"'>
                    📋 سجل الشحنات العامة (@transfers.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "dispatch" ? "active" : "")" @onclick='() => activeTab = "dispatch"'>
                    🚚 1. شحن وتوجيه من الكنترول للفرع
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "receive" ? "active" : "") position-relative" @onclick='() => activeTab = "receive"'>
                    📥 2. استلام ومطابقة عهدة الفرع
                    @if (InTransitCount > 0)
                    {
                        <span class="badge rounded-pill bg-warning text-dark ms-1">@InTransitCount</span>
                    }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "dispute" ? "active" : "") position-relative" @onclick='() => activeTab = "dispute"'>
                    ⚖️ 3. لجنة فض منازعات عجز النقل
                    @if (DisputeCount > 0)
                    {
                        <span class="badge rounded-pill bg-danger ms-1">@DisputeCount</span>
                    }
                </button>
            </li>
        </ul>
    </div>

    <!-- جسم الشاشة التفاعلي -->
    <main class="container-fluid px-4 py-3">
        @if (isProcessing && !transfers.Any())
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">جاري مزامنة خط سير الشحنات اللوجستية...</p>
            </div>
        }
        else if (activeTab == "list")
        {
            <!-- ========================================== -->
            <!-- تبويب 1: السجل العام للشحنات               -->
            <!-- ========================================== -->
            <div class="content-card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 text-center small border-secondary">
                        <thead class="table-secondary text-dark fw-bold">
                            <tr>
                                <th>رقم الشحنة</th>
                                <th>التاريخ</th>
                                <th>المستودع المصدر</th>
                                <th>الفرع المستلم</th>
                                <th>الصنف والتشغيلة</th>
                                <th>الكمية المشحونة</th>
                                <th>الكمية المستلمة</th>
                                <th>السائق والسيارة</th>
                                <th>الحالة اللوجستية</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!transfers.Any())
                            {
                                <tr><td colspan="9" class="text-muted py-5 fw-bold">لا توجد شحنات مسجلة بالمنشأة حتى الآن.</td></tr>
                            }
                            else
                            {
                                @foreach (var t in transfers)
                                {
                                    <tr>
                                        <td class="fw-bold text-info font-monospace">@t.TransferNumber</td>
                                        <td class="font-monospace text-muted">@t.TransferDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-light">@t.SourceWarehouseName</td>
                                        <td class="fw-bold text-warning">@t.DestinationBranchName</td>
                                        <td class="text-start ps-3">
                                            <div class="fw-bold text-white">@t.ItemName</div>
                                            <small class="text-muted font-monospace">لوط: @(t.BatchNumber ?? "بدون")</small>
                                        </td>
                                        <td class="fw-bold text-primary font-monospace fs-6">@t.DispatchedQty.ToString("N1") @t.Unit</td>
                                        <td class="fw-bold font-monospace fs-6">
                                            @(t.ReceivedQty.HasValue ? $"{t.ReceivedQty.Value:N1} {t.Unit}" : "في الانتظار")
                                        </td>
                                        <td>
                                            <div class="text-light">@(t.DriverName ?? "---")</div>
                                            <small class="text-muted font-monospace">@(t.VehicleNumber ?? "")</small>
                                        </td>
                                        <td>
                                            @if (t.Status == "IN_TRANSIT")
                                            {
                                                <span class="badge bg-warning text-dark px-2 py-1">🚚 في الطريق</span>
                                            }
                                            else if (t.Status == "IN_DISPUTE")
                                            {
                                                <span class="badge bg-danger px-2 py-1">🚨 نزاع عجز</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success px-2 py-1">✓ تم الاستلام</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == "dispatch")
        {
            <!-- ========================================== -->
            <!-- تبويب 2: شحن وإمداد من الكنترول            -->
            <!-- ========================================== -->
            <div class="content-card p-4 shadow-sm">
                <h5 class="text-primary fw-bold mb-3"><i class="bi bi-box-seam me-2"></i>إصدار إذن شحن وإمداد فرع جديد</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">الفرع المستهدف <span class="text-danger">*</span></label>
                        <select class="form-select bg-dark text-white border-secondary" value="@newDispatch.DestinationBranchId" @onchange="OnBranchSelected">
                            <option value="0">-- اختر الفرع --</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id">@b.BranchName (@b.BranchCode)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">مستودع الفرع المستلم <span class="text-danger">*</span></label>
                        <select class="form-select bg-dark text-white border-secondary" @bind="newDispatch.DestinationWarehouseId">
                            <option value="0">-- اختر المستودع --</option>
                            @foreach (var w in branchWarehouses)
                            {
                                <option value="@w.Id">@w.WarehouseName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">المنتج التام المشحون <span class="text-danger">*</span></label>
                        <select class="form-select bg-dark text-white border-secondary" @bind="newDispatch.ItemId">
                            <option value="0">-- اختر المنتج --</option>
                            @foreach (var itm in finishedItems)
                            {
                                <option value="@itm.Id">@itm.ItemName (@itm.ItemCode)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">الكمية المشحونة <span class="text-danger">*</span></label>
                        <input type="number" step="0.5" class="form-control bg-dark text-white border-secondary fw-bold text-primary font-monospace" @bind="newDispatch.DispatchedQty" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">عدد الصواني / الأقفاص</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary font-monospace" @bind="newDispatch.DispatchedCount" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">اسم السائق / المندوب <span class="text-danger">*</span></label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="مثال: حسن رجب" @bind="newDispatch.DriverName" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">رقم سيارة التوزيع</label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="مثال: أ ب ج 512" @bind="newDispatch.VehicleNumber" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-light">رقم التشغيلة (اللوط)</label>
                        <input type="text" class="form-control bg-dark text-white border-secondary font-monospace" placeholder="مثال: LOT-2026-10" @bind="newDispatch.BatchNumber" />
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-light">ملاحظات وتوجيهات الشحنة</label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="أي ملاحظات تخص الشحن..." @bind="newDispatch.Notes" />
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary px-4 fw-bold shadow-sm" @onclick="SubmitDispatch" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span>🚚 اعتماد الشحن وخصم الرصيد من الكنترول</span>
                    </button>
                </div>
            </div>
        }
        else if (activeTab == "receive")
        {
            <!-- ========================================== -->
            <!-- تبويب 3: استلام ومطابقة عهدة الفرع         -->
            <!-- ========================================== -->
            <div class="content-card shadow-sm p-3">
                <h5 class="text-warning fw-bold mb-3"><i class="bi bi-inbox-fill me-2"></i>شحنات في الطريق بانتظار مطابقة واستلام الفرع</h5>
                @if (!InTransitList.Any())
                {
                    <div class="text-center text-muted py-5 fw-bold">لا توجد شحنات معلقة على الطريق للفروع حالياً.</div>
                }
                else
                {
                    @foreach (var trf in InTransitList)
                    {
                        <div class="p-3 mb-3 bg-dark bg-opacity-50 border border-secondary border-opacity-50 rounded-3">
                            <div class="row align-items-center g-3">
                                <div class="col-md-3">
                                    <h6 class="fw-bold text-info font-monospace mb-1">@trf.TransferNumber</h6>
                                    <div class="fw-bold text-white">@trf.ItemName</div>
                                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary">متجه إلى: @trf.DestinationBranchName</span>
                                </div>
                                <div class="col-md-3 border-start border-secondary border-opacity-25">
                                    <small class="text-muted d-block">المشحون من الكنترول:</small>
                                    <span class="fw-bold fs-6 font-monospace text-primary">@trf.DispatchedQty.ToString("N1") @trf.Unit</span> |
                                    <span class="fw-bold font-monospace text-light">@trf.DispatchedCount قفص/صاج</span>
                                    <small class="d-block text-muted mt-1">السائق: @trf.DriverName (@trf.VehicleNumber)</small>
                                </div>
                                <div class="col-md-4">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="small fw-bold text-success">الكمية المستلمة فعلياً *</label>
                                            <input type="number" step="0.5" class="form-control form-control-sm bg-dark text-white border-success fw-bold font-monospace" @bind="trf.TempReceivedQty" />
                                        </div>
                                        <div class="col-6">
                                            <label class="small fw-bold text-light">العدد المستلم *</label>
                                            <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary font-monospace" @bind="trf.TempReceivedCount" />
                                        </div>
                                    </div>
                                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary mt-2" placeholder="ملاحظات أمين مخزن الفرع..." @bind="trf.TempNotes" />
                                </div>
                                <div class="col-md-2 text-center">
                                    <button class="btn btn-success btn-sm w-100 fw-bold py-2 shadow-sm" @onclick="() => SubmitReceive(trf)" disabled="@isProcessing">
                                        ✓ اعتماد استلام الفرع
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (activeTab == "dispute")
        {
            <!-- ========================================== -->
            <!-- تبويب 4: لجنة فض منازعات عجز النقل         -->
            <!-- ========================================== -->
            <div class="content-card shadow-sm p-3">
                <h5 class="text-danger fw-bold mb-3"><i class="bi bi-hammer me-2"></i>شحنات متنازع عليها بانتظار قرار لجنة فض المنازعات</h5>
                @if (!DisputeList.Any())
                {
                    <div class="text-center text-muted py-5 fw-bold">لا توجد أي شحنات متنازع عليها. جميع الاستلامات مطابقة!</div>
                }
                else
                {
                    @foreach (var trf in DisputeList)
                    {
                        <div class="p-3 mb-3 bg-danger bg-opacity-10 border border-danger border-opacity-50 rounded-3">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <div>
                                    <h6 class="fw-bold text-danger d-inline font-monospace">@trf.TransferNumber</h6>
                                    <span class="fw-bold text-white ms-2">@trf.ItemName</span>
                                    <span class="badge bg-dark border border-secondary ms-2">فرع: @trf.DestinationBranchName</span>
                                </div>
                                <span class="badge bg-danger p-2">سبب النزاع: @trf.DisputeReason</span>
                            </div>
                            <div class="row align-items-center g-3">
                                <div class="col-md-3">
                                    <small class="text-muted d-block">المشحون أصلاً:</small>
                                    <span class="fw-bold font-monospace text-light">@trf.DispatchedQty.ToString("N1") @trf.Unit</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="small fw-bold text-light">الكمية النهائية المقبولة للفرع *</label>
                                    <input type="number" step="0.5" class="form-control form-control-sm bg-dark text-white border-success fw-bold font-monospace" @bind="trf.TempFinalQty" />
                                </div>
                                <div class="col-md-3">
                                    <label class="small fw-bold text-light">تحميل مسؤولية العجز *</label>
                                    <select class="form-select form-select-sm bg-dark text-white border-secondary fw-bold" @bind="trf.TempChargeTo">
                                        <option value="عهدة سائق التوزيع">عهدة سائق التوزيع</option>
                                        <option value="هدر وكسر أثناء النقل">هدر وكسر أثناء النقل</option>
                                        <option value="جفاف وفقد طبيعي">جفاف وفقد طبيعي</option>
                                        <option value="تسوية جردية معتمدة">تسوية جردية معتمدة</option>
                                    </select>
                                </div>
                                <div class="col-md-3 text-center">
                                    <button class="btn btn-danger btn-sm w-100 fw-bold py-2 shadow-sm" @onclick="() => SubmitResolveDispute(trf)" disabled="@isProcessing">
                                        ⚖️ اعتماد قرار اللجنة وترصيد الفرع
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </main>
</div>

<style>
    .kayan-transfers-viewport {
        min-height: 100vh;
        width: 100vw;
        background-color: #030712;
        color: #F8FAFC;
        font-family: system-ui, -apple-system, sans-serif;
        overflow-x: hidden;
    }

    .transfers-header-bar {
        background: rgba(17, 24, 39, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.85rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .back-home-btn {
        background: #1E293B;
        border: 1px solid #334155;
        color: #CBD5E1;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

        .back-home-btn:hover {
            background: #334155;
            color: #FFF;
        }

    .custom-pills-bar .nav-link {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #94A3B8;
        border-radius: 10px;
        padding: 0.55rem 1.25rem;
        font-weight: 600;
        font-size: 0.88rem;
    }

        .custom-pills-bar .nav-link.active {
            background: #4F46E5;
            border-color: #6366F1;
            color: #FFF;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.35);
        }

    .content-card {
        background: rgba(17, 24, 39, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        backdrop-filter: blur(16px);
    }
</style>

@code {
    private string activeTab = "list";
    private string alertMessage = "";
    private bool isSuccess = false;
    private bool isProcessing = false;

    private List<BranchTransferViewItem> transfers = new();
    private List<BranchLookupDto> branches = new();
    private List<WarehouseDto> allWarehouses = new();
    private List<WarehouseDto> branchWarehouses = new();
    private List<ItemDto> finishedItems = new();

    private DispatchFormModel newDispatch = new();

    private IEnumerable<BranchTransferViewItem> InTransitList => transfers.Where(t => t.Status == "IN_TRANSIT");
    private IEnumerable<BranchTransferViewItem> DisputeList => transfers.Where(t => t.Status == "IN_DISPUTE");
    private int InTransitCount => InTransitList.Count();
    private int DisputeCount => DisputeList.Count();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadData();
    }

    private async Task LoadLookups()
    {
        try
        {
            long cId = State.CompanyId > 0 ? State.CompanyId : 1;
            var res = await Http.GetFromJsonAsync<TransfersLookupsResult>($"api/BranchTransfers/lookups?companyId={cId}");
            if (res != null)
            {
                branches = res.Branches;
                finishedItems = res.Items;
                allWarehouses = res.Warehouses;
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        isProcessing = true;
        try
        {
            long cId = State.CompanyId > 0 ? State.CompanyId : 1;
            transfers = await Http.GetFromJsonAsync<List<BranchTransferViewItem>>($"api/BranchTransfers?companyId={cId}") ?? new();
            foreach (var t in transfers)
            {
                if (t.TempReceivedQty == 0) t.TempReceivedQty = t.DispatchedQty;
                if (t.TempReceivedCount == 0) t.TempReceivedCount = t.DispatchedCount;
                if (t.TempFinalQty == 0) t.TempFinalQty = t.ReceivedQty ?? t.DispatchedQty;
                if (string.IsNullOrEmpty(t.TempChargeTo)) t.TempChargeTo = "عهدة سائق التوزيع";
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ في جلب الشحنات: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void OnBranchSelected(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out long bId) && bId > 0)
        {
            newDispatch.DestinationBranchId = bId;
            branchWarehouses = allWarehouses.Where(w => w.BranchId == bId).ToList();
            newDispatch.DestinationWarehouseId = branchWarehouses.FirstOrDefault()?.Id ?? 0;
        }
    }

    private async Task SubmitDispatch()
    {
        if (newDispatch.DestinationBranchId <= 0 || newDispatch.DestinationWarehouseId <= 0 || newDispatch.ItemId <= 0 || newDispatch.DispatchedQty <= 0)
        {
            alertMessage = "يرجى تحديد الفرع، المستودع، الصنف والكمية المشحونة.";
            isSuccess = false;
            return;
        }

        isProcessing = true;
        try
        {
            var controlWh = allWarehouses.FirstOrDefault(w => w.WarehouseName.Contains("كنترول") || w.WarehouseName.Contains("رئيسي")) ?? allWarehouses.FirstOrDefault();
            newDispatch.SourceWarehouseId = controlWh?.Id ?? 1;
            newDispatch.DispatcherName = State.FullName ?? "مسؤول الكنترول";
            newDispatch.CompanyId = State.CompanyId > 0 ? State.CompanyId : 1;

            var res = await Http.PostAsJsonAsync("api/BranchTransfers/dispatch", newDispatch);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = "تم شحن البضاعة وخصم الرصيد بنجاح، وهي الآن في الطريق للفرع!";
                isSuccess = true;
                newDispatch = new DispatchFormModel();
                activeTab = "receive";
                await LoadData();
            }
            else
            {
                alertMessage = await res.Content.ReadAsStringAsync();
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            alertMessage = ex.Message;
            isSuccess = false;
        }
        finally { isProcessing = false; }
    }

    private async Task SubmitReceive(BranchTransferViewItem trf)
    {
        isProcessing = true;
        try
        {
            var body = new
            {
                TransferId = trf.Id,
                ReceivedQty = trf.TempReceivedQty,
                ReceivedCount = trf.TempReceivedCount,
                ReceiverName = State.FullName ?? "أمين مستودع الفرع",
                Notes = trf.TempNotes
            };

            var res = await Http.PostAsJsonAsync("api/BranchTransfers/receive", body);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = "تمت معالجة استلام الفرع بنجاح!";
                isSuccess = true;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            alertMessage = ex.Message;
            isSuccess = false;
        }
        finally { isProcessing = false; }
    }

    private async Task SubmitResolveDispute(BranchTransferViewItem trf)
    {
        isProcessing = true;
        try
        {
            var body = new
            {
                TransferId = trf.Id,
                FinalAcceptedQty = trf.TempFinalQty,
                ChargeTo = trf.TempChargeTo,
                ResolvedBy = State.FullName ?? "اللجنة المشتركة",
                Notes = "تم حسم النزاع واعتماد التسوية المخزنية"
            };

            var res = await Http.PostAsJsonAsync("api/BranchTransfers/resolve-dispute", body);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = "تم فض النزاع وترصيد الكمية بمستودع الفرع وتسوية الهالك بنجاح!";
                isSuccess = true;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            alertMessage = ex.Message;
            isSuccess = false;
        }
        finally { isProcessing = false; }
    }

