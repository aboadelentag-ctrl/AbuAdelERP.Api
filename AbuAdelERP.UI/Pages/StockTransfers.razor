    private string activeTab = "CREATE";
    private string feedbackMessage = "";
    private bool isSuccessFeedback = true;
    private bool isSubmitting = false;

    private List<StockTransferDetailDto> transfersList = new();
    private List<WarehouseOptionDto> warehouses = new();
    private List<ItemOptionDto> allItems = new();
    private List<TransferImportRowPreview> importedPreviewList = new();

    private CreateStockTransferDto newTransfer = new();
    private List<TransferLineViewModel> transferLinesView = new();

    private StockTransferDetailDto? selectedReceiveTransfer;
    private StockTransferDetailDto? selectedDisputeTransfer;
    private StockTransferDetailDto? viewingTransfer;
    
    private bool isImportModalOpen = false;
    private bool isDetailsModalOpen = false;
    private string searchTerm = "";

    // هوية المستخدم المسجلة المربوطة تلقائياً بجلسة الدخول
    private string CurrentDispatcherDisplayName => 
        !string.IsNullOrWhiteSpace(State.FullName) 
            ? $"{State.FullName} [{(!string.IsNullOrWhiteSpace(State.EmployeeCode) ? State.EmployeeCode : State.Username)}]" 
            : "أمين المخزن المعتمد";

    protected override async Task OnInitializedAsync()
    {
        InitializeDefaultActiveTab();
        await LoadDropdowns();
        await LoadTransfers();
        AddTransferLine();
    }

    private void InitializeDefaultActiveTab()
    {
        if (State.HasAnyPermission("Transfers.Create", "Warehouse.View", "StockTransfers.View")) activeTab = "CREATE";
        else if (State.HasAnyPermission("Transfers.Receive", "Warehouse.View")) activeTab = "IN_TRANSIT";
        else if (State.HasAnyPermission("Transfers.SettleDispute", "Warehouse.View")) activeTab = "DISPUTE";
        else if (State.HasAnyPermission("Transfers.View", "Reports.View")) activeTab = "HISTORY";
    }

    private void ChangeTab(string tab)
    {
        activeTab = tab;
        selectedReceiveTransfer = null;
        selectedDisputeTransfer = null;
        isDetailsModalOpen = false;
    }

    private async Task LoadDropdowns()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<LookupsResponseDto>("api/StockTransfers/lookups");
            if (res != null)
            {
                warehouses = res.Warehouses ?? new();
                allItems = res.Items ?? new();
            }
        }
        catch
        {
            // fallback احتياطي في حال الاستدعاء المباشر
            try { warehouses = await Http.GetFromJsonAsync<List<WarehouseOptionDto>>("api/Warehouses") ?? new(); } catch { }
            try { allItems = await Http.GetFromJsonAsync<List<ItemOptionDto>>("api/Items") ?? new(); } catch { }
        }
    }

    private async Task LoadTransfers()
    {
        try
        {
            var response = await Http.GetAsync("api/StockTransfers");
            if (response.IsSuccessStatusCode)
            {
                transfersList = await response.Content.ReadFromJsonAsync<List<StockTransferDetailDto>>() ?? new();
                feedbackMessage = "";
            }
            else
            {
                var errDetail = await response.Content.ReadAsStringAsync();
                feedbackMessage = $"خطأ من السيرفر ({response.StatusCode}): {errDetail}";
                isSuccessFeedback = false;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = "خطأ في الاتصال: " + ex.Message;
            isSuccessFeedback = false;
        }
    }

    private IEnumerable<StockTransferDetailDto> FilteredTransfers
    {
        get
        {
            var query = transfersList.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(t =>
                    t.TransferNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    t.FromWarehouseName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    t.ToWarehouseName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(t.DriverName) && t.DriverName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    t.Lines.Any(l => l.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase) || 
                                    (!string.IsNullOrEmpty(l.BatchNumber) && l.BatchNumber.Contains(term, StringComparison.OrdinalIgnoreCase))));
            }
            return query;
        }
    }

