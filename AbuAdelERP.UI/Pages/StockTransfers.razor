@page "/stock-transfers"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using AbuAdelERP.UI.DTOs
@inject HttpClient Http

<PageTitle>التحويلات المخزنية وفض المنازعات - حلواني أبو عادل</PageTitle>

<div class="container-fluid py-4" dir="rtl">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-arrow-left-right me-2"></i>التحويلات المخزنية وفض المنازعات ⚖️
            </h3>
            <p class="text-muted small mb-0">نقل البضائع بين المستودعات والفروع، متابعة الشحنات على الطريق، وتوثيق استلامات التوالف والعجز</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary px-4 shadow-sm fw-bold" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle me-1"></i> إذن تحويل جديد 🚚
            </button>
            <button class="btn btn-outline-secondary px-3" @onclick="LoadTransfers" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- التنبيهات -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- تبويبات الحالة وفلاتر البحث -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="btn-group w-100" role="group">
                        <button type="button" class="btn btn-sm @(selectedStatus == null ? "btn-primary" : "btn-outline-primary")" 
                                @onclick="() => FilterByStatus(null)">الكل</button>
                        <button type="button" class="btn btn-sm @(selectedStatus == "IN_TRANSIT" ? "btn-warning" : "btn-outline-warning")" 
                                @onclick='() => FilterByStatus("IN_TRANSIT")'>في الطريق 🚚</button>
                        <button type="button" class="btn btn-sm @(selectedStatus == "DISPUTED" ? "btn-danger" : "btn-outline-danger")" 
                                @onclick='() => FilterByStatus("DISPUTED")'>نزاع / عجز ⚖️</button>
                        <button type="button" class="btn btn-sm @(selectedStatus == "COMPLETED" ? "btn-success" : "btn-outline-success")" 
                                @onclick='() => FilterByStatus("COMPLETED")'>مكتمل ومستلم ✅</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <input type="text" class="form-control form-control-sm" placeholder="بحث برقم الإذن، السائق، أو المستودع..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </div>

    <!-- جدول أذون التحويل -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2 mb-0">جاري تحميل سجلات التحويل...</p>
                </div>
            }
            else if (!FilteredTransfers.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-truck fs-1 d-block mb-2"></i>
                    لا توجد أذون تحويل مطابقة للبحث المحدد.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center small">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th>رقم الإذن</th>
                                <th>التاريخ</th>
                                <th>من مستودع</th>
                                <th>إلى مستودع</th>
                                <th>السائق والسيارة</th>
                                <th>عدد البنود</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in FilteredTransfers)
                            {
                                <tr>
                                    <td class="fw-bold font-monospace text-primary">@t.TransferNumber</td>
                                    <td class="small text-muted font-monospace">@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-start ps-3 fw-bold small">
                                        <i class="bi bi-box-arrow-up-right text-danger me-1"></i>@t.FromWarehouseName
                                    </td>
                                    <td class="text-start ps-3 fw-bold small">
                                        <i class="bi bi-box-arrow-in-down-left text-success me-1"></i>@t.ToWarehouseName
                                    </td>
                                    <td class="small">
                                        <div>@(string.IsNullOrWhiteSpace(t.DriverName) ? "---" : t.DriverName)</div>
                                        <div class="text-muted font-monospace small">@(t.VehicleNumber ?? "")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@t.Lines.Count أصناف</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadge(t.Status) px-2 py-1">
                                            @GetStatusLabel(t.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-info py-0 px-2 fw-bold" @onclick="() => OpenDetailsModal(t.Id)">
                                            <i class="bi bi-eye me-1"></i> فحص واستلام
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- Modal 1: إنشاء إذن تحويل وصرفه              -->
<!-- ========================================== -->
@if (showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" dir="rtl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-truck me-2"></i>إنشاء إذن صرف وتحويل بضائع
                    </h6>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@modalError</div>
                    }

                    <div class="row g-3 mb-4 bg-light p-3 rounded-3 border">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">المستودع الراسل (المصدر) <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm border-primary fw-bold" @bind="newTransfer.FromWarehouseId" @bind:after="OnSourceWarehouseChanged">
                                <option value="0">-- اختر المستودع المصدر --</option>
                                @foreach (var w in lookups.Warehouses)
                                {
                                    <option value="@w.Id">@w.WarehouseName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">المستودع المستقبل (الوجهة) <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm border-primary fw-bold" @bind="newTransfer.ToWarehouseId">
                                <option value="0">-- اختر المستودع الوجهة --</option>
                                @foreach (var w in lookups.Warehouses.Where(w => w.Id != newTransfer.FromWarehouseId))
                                {
                                    <option value="@w.Id">@w.WarehouseName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">اسم السائق / المندوب</label>
                            <input type="text" class="form-control form-control-sm" placeholder="اسم السائق المسؤول عن النقل" @bind="newTransfer.DriverName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">رقم لوحة السيارة</label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="مثال: أ ب ج 1234" @bind="newTransfer.VehicleNumber" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">ملاحظات التحويل</label>
                            <input type="text" class="form-control form-control-sm" placeholder="سبب النقل أو توجيهات الشحن..." @bind="newTransfer.Notes" />
                        </div>
                    </div>

                    <!-- جدول إضافة البنود -->
                    <div class="card border border-light-subtle rounded-3">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                            <h6 class="mb-0 fw-bold text-dark">أصناف الشحنة والكميات</h6>
                            <button type="button" class="btn btn-sm btn-outline-success fw-bold" @onclick="AddNewLine" disabled="@(newTransfer.FromWarehouseId == 0)">
                                <i class="bi bi-plus-circle me-1"></i> إضافة صنف للشحنة
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0 text-center small">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-start ps-3" style="width: 30%;">الصنف</th>
                                            <th>الرصيد المتاح</th>
                                            <th style="width: 15%;">الكمية المحولة</th>
                                            <th>التشغيلة (اللوط)</th>
                                            <th>تاريخ الصلاحية</th>
                                            <th>حذف</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!newTransfer.Lines.Any())
                                        {
                                            <tr>
                                                <td colspan="6" class="py-4 text-muted">انقر على "إضافة صنف للشحنة" لإدراج الأصناف.</td>
                                            </tr>
                                        }
                                        @foreach (var line in newTransfer.Lines)
                                        {
                                            <tr>
                                                <td class="text-start ps-3">
                                                    <select class="form-select form-select-sm" @bind="line.ItemId" @bind:after="() => OnItemChanged(line)">
                                                        <option value="0">-- اختر الصنف --</option>
                                                        @foreach (var itm in lookups.Items)
                                                        {
                                                            <option value="@itm.Id">@itm.ItemName (@itm.ItemCode)</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <span class="badge @(line.AvailableStock > 0 ? "bg-info text-dark" : "bg-danger") font-monospace">
                                                        @line.AvailableStock.ToString("N1")
                                                    </span>
                                                </td>
                                                <td>
                                                    <input type="number" step="0.5" class="form-control form-control-sm text-center fw-bold text-primary font-monospace" 
                                                           @bind="line.DispatchedQty" max="@line.AvailableStock" min="0.1" />
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="رقم اللوط" @bind="line.BatchNumber" />
                                                </td>
                                                <td>
                                                    <input type="date" class="form-control form-control-sm font-monospace" @bind="line.ExpiryDate" />
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => newTransfer.Lines.Remove(line)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => showCreateModal = false">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="SaveAndDispatchTransfer" disabled="@isSaving">
                        @(isSaving ? "جاري الصرف والترحيل..." : "✓ اعتماد وصرف الشحنة")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- Modal 2: تفاصيل وفحص واستلام الشحنة        -->
<!-- ========================================== -->
@if (showDetailsModal && selectedTransfer != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" dir="rtl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-card-checklist me-2"></i>تفاصيل وفحص الشحنة: @selectedTransfer.TransferNumber
                    </h6>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="() => showDetailsModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-4 small bg-light p-3 rounded-3 border">
                        <div class="col-md-3"><strong>المستودع المصدر:</strong> @selectedTransfer.FromWarehouseName</div>
                        <div class="col-md-3"><strong>المستودع المستلم:</strong> @selectedTransfer.ToWarehouseName</div>
                        <div class="col-md-3"><strong>السائق:</strong> @(selectedTransfer.DriverName ?? "---")</div>
                        <div class="col-md-3"><strong>الحالة العامة:</strong> <span class="badge @GetStatusBadge(selectedTransfer.Status)">@GetStatusLabel(selectedTransfer.Status)</span></div>
                    </div>

                    <h6 class="fw-bold mb-3">بنود الشحنة والاستلام الميداني:</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start ps-3">الصنف</th>
                                    <th>التشغيلة (اللوط)</th>
                                    <th>الكمية المنصرفة</th>
                                    <th>الكمية المستلمة</th>
                                    <th>العجز / الهالك</th>
                                    <th>حالة البند</th>
                                    <th>الإجراءات الميدانية</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedTransfer.Lines)
                                {
                                    <tr>
                                        <td class="text-start ps-3 fw-bold">
                                            @line.ItemName
                                            <div class="small text-muted font-monospace">@line.ItemCode</div>
                                        </td>
                                        <td class="font-monospace small">@(line.BatchNumber ?? "---")</td>
                                        <td class="fw-bold fs-6 font-monospace">@line.DispatchedQty.ToString("N1") @line.Unit</td>
                                        <td class="fw-bold fs-6 text-success font-monospace">
                                            @(line.LineStatus == "PENDING" ? "في الانتظار" : $"{line.ReceivedQty:N1} {line.Unit}")
                                        </td>
                                        <td class="text-danger fw-bold font-monospace">
                                            @(line.LossQty > 0 ? $"{line.LossQty:N1} {line.Unit}" : "---")
                                        </td>
                                        <td>
                                            <span class="badge @GetLineStatusBadge(line.LineStatus) px-2 py-1">
                                                @GetLineStatusLabel(line.LineStatus)
                                            </span>
                                            @if (!string.IsNullOrEmpty(line.DiscrepancyReason))
                                            {
                                                <div class="small text-danger mt-1">@line.DiscrepancyReason</div>
                                            }
                                        </td>
                                        <td>
                                            @if (line.LineStatus == "PENDING")
                                            {
                                                <button class="btn btn-sm btn-success py-0 px-2 fw-bold me-1" @onclick="() => QuickAcceptLine(line)">
                                                    <i class="bi bi-check2"></i> قبول كامل
                                                </button>
                                                <button class="btn btn-sm btn-outline-warning py-0 px-2 fw-bold" @onclick="() => OpenDisputeLineModal(line)">
                                                    <i class="bi bi-exclamation-triangle"></i> إثبات عجز
                                                </button>
                                            }
                                            else if (line.LineStatus == "DISPUTED")
                                            {
                                                <button class="btn btn-sm btn-danger py-0 px-2 fw-bold" @onclick="() => OpenResolveModal(line)">
                                                    <i class="bi bi-hammer"></i> فض النزاع
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-success small fw-bold"><i class="bi bi-check-all"></i> معتمد</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => showDetailsModal = false">إغلاق</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- Modal 3: إثبات عجز أو نزاع في استلام سطر  -->
<!-- ========================================== -->
@if (showDisputeModal && activeDisputeLine != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered" dir="rtl">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-warning text-dark py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>محضر إثبات عجز أو تلف استلام
                    </h6>
                    <button type="button" class="btn-close ms-0 me-auto" @onclick="() => showDisputeModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">الصنف والكمية المنصرفة الأصلية:</label>
                        <div class="fw-bold">@activeDisputeLine.ItemName (@activeDisputeLine.DispatchedQty @activeDisputeLine.Unit)</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">الكمية السليمة المستلمة فعلياً <span class="text-danger">*</span></label>
                        <input type="number" step="0.5" class="form-control form-control-sm font-monospace fw-bold" @bind="receiveDto.ReceivedQty" max="@activeDisputeLine.DispatchedQty" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">سبب العجز أو النزاع <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="2" placeholder="مثال: تلف أثناء النقل / كراتين مفقودة..." @bind="receiveDto.DiscrepancyReason"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="() => showDisputeModal = false">إلغاء</button>
                    <button type="button" class="btn btn-warning btn-sm px-4 fw-bold" @onclick="SubmitDisputedLine">تسجيل النزاع</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- Modal 4: قرار لجنة فض المنازعات            -->
<!-- ========================================== -->
@if (showResolveModal && activeResolveLine != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered" dir="rtl">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-hammer me-2"></i>اعتماد قرار لجنة تسوية وفض النزاع
                    </h6>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="() => showResolveModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3 small bg-light p-2 rounded border">
                        <div><strong>الصنف:</strong> @activeResolveLine.ItemName</div>
                        <div><strong>الكمية المنصرفة:</strong> @activeResolveLine.DispatchedQty @activeResolveLine.Unit</div>
                        <div><strong>سبب النزاع المسجل:</strong> <span class="text-danger">@activeResolveLine.DiscrepancyReason</span></div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small">الكمية المعتمدة للاستلام:</label>
                            <input type="number" step="0.5" class="form-control form-control-sm font-monospace fw-bold" @bind="resolveDto.FinalApprovedQty" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">كمية الهالك المعتمدة:</label>
                            <input type="number" step="0.5" class="form-control form-control-sm text-danger fw-bold font-monospace" @bind="resolveDto.LossQty" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">ملاحظات وقرار اللجنة:</label>
                        <textarea class="form-control" rows="2" placeholder="مثال: خصم قيمة الهالك من السائق / اعتماد هالك طريق مسموح به..." @bind="resolveDto.ResolutionNotes"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="() => showResolveModal = false">إلغاء</button>
                    <button type="button" class="btn btn-danger btn-sm px-4 fw-bold" @onclick="SubmitResolveDispute">اعتماد القرار وترحيل الهالك</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<StockTransferDetailDto> transfers = new();
    private StockTransferLookupsDto lookups = new();
    private StockTransferDetailDto? selectedTransfer;
    private CreateStockTransferDto newTransfer = new();

    private string? selectedStatus;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? statusMessage;
    private string? errorMessage;
    private string? modalError;

    private bool showCreateModal = false;
    private bool showDetailsModal = false;
    private bool showDisputeModal = false;
    private bool showResolveModal = false;

    private StockTransferLineDetailDto? activeDisputeLine;
    private ConfirmTransferLineReceiveDto receiveDto = new();

    private StockTransferLineDetailDto? activeResolveLine;
    private ResolveTransferDisputeDto resolveDto = new();

    private IEnumerable<StockTransferDetailDto> FilteredTransfers =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? transfers
            : transfers.Where(t => (t.TransferNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                                || (t.DriverName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                                || (t.FromWarehouseName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                                || (t.ToWarehouseName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadTransfers();
    }

    private async Task LoadLookups()
    {
        try
        {
            lookups = await Http.GetFromJsonAsync<StockTransferLookupsDto>("api/stocktransfers/lookups") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lookups: {ex.Message}");
        }
    }

    private async Task LoadTransfers()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            string url = string.IsNullOrEmpty(selectedStatus) 
                ? "api/stocktransfers" 
                : $"api/stocktransfers?status={selectedStatus}";
            transfers = await Http.GetFromJsonAsync<List<StockTransferDetailDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب بيانات التحويلات: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FilterByStatus(string? status)
    {
        selectedStatus = status;
        await LoadTransfers();
    }

    private void OpenCreateModal()
    {
        newTransfer = new CreateStockTransferDto
        {
            Lines = new List<CreateStockTransferLineDto>()
        };
        modalError = null;
        showCreateModal = true;
    }

    private void OnSourceWarehouseChanged()
    {
        newTransfer.Lines.Clear();
    }

    private void AddNewLine()
    {
        newTransfer.Lines.Add(new CreateStockTransferLineDto());
    }

    private async Task OnItemChanged(CreateStockTransferLineDto line)
    {
        if (line.ItemId <= 0 || newTransfer.FromWarehouseId <= 0) return;

        try
        {
            var stockInfo = await Http.GetFromJsonAsync<AvailableStockInfoDto>(
                $"api/stocktransfers/available-batches?itemId={line.ItemId}&warehouseId={newTransfer.FromWarehouseId}");

            if (stockInfo != null)
            {
                line.AvailableStock = stockInfo.TotalAvailableQty;
                var firstBatch = stockInfo.Batches.FirstOrDefault();
                if (firstBatch != null)
                {
                    line.BatchNumber = firstBatch.BatchNumber;
                    line.ExpiryDate = firstBatch.ExpiryDate;
                    line.UnitCost = firstBatch.UnitCost;
                }
            }
        }
        catch
        {
            line.AvailableStock = 0;
        }
    }

    private async Task SaveAndDispatchTransfer()
    {
        if (newTransfer.FromWarehouseId <= 0 || newTransfer.ToWarehouseId <= 0)
        {
            modalError = "يرجى تحديد المستودع المصدر والمستودع الوجهة.";
            return;
        }
        if (newTransfer.FromWarehouseId == newTransfer.ToWarehouseId)
        {
            modalError = "لا يمكن التحويل لنفس المستودع.";
            return;
        }
        if (!newTransfer.Lines.Any(l => l.ItemId > 0 && l.DispatchedQty > 0))
        {
            modalError = "يجب إضافة صنف واحد على الأقل بكمية صالحة.";
            return;
        }

        isSaving = true;
        modalError = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/stocktransfers", newTransfer);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = "تم إنشاء وصرف إذن التحويل بنجاح، والشحنة الآن قيد النقل 🚚";
                showCreateModal = false;
                await LoadTransfers();
            }
            else
            {
                modalError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            modalError = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OpenDetailsModal(long id)
    {
        try
        {
            selectedTransfer = await Http.GetFromJsonAsync<StockTransferDetailDto>($"api/stocktransfers/{id}");
            showDetailsModal = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب تفاصيل التحويل: {ex.Message}";
        }
    }

    private async Task QuickAcceptLine(StockTransferLineDetailDto line)
    {
        var dto = new ConfirmTransferLineReceiveDto
        {
            LineId = line.Id,
            ReceivedQty = line.DispatchedQty,
            IsAccepted = true
        };

        var response = await Http.PostAsJsonAsync("api/stocktransfers/receive-line", dto);
        if (response.IsSuccessStatusCode)
        {
            statusMessage = "تم قبول واستلام البند بنجاح.";
            if (selectedTransfer != null) await OpenDetailsModal(selectedTransfer.Id);
            await LoadTransfers();
        }
    }

    private void OpenDisputeLineModal(StockTransferLineDetailDto line)
    {
        activeDisputeLine = line;
        receiveDto = new ConfirmTransferLineReceiveDto
        {
            LineId = line.Id,
            ReceivedQty = line.DispatchedQty,
            IsAccepted = false
        };
        showDisputeModal = true;
    }

    private async Task SubmitDisputedLine()
    {
        if (receiveDto.ReceivedQty < 0 || string.IsNullOrWhiteSpace(receiveDto.DiscrepancyReason))
        {
            return;
        }

        var response = await Http.PostAsJsonAsync("api/stocktransfers/receive-line", receiveDto);
        if (response.IsSuccessStatusCode)
        {
            statusMessage = "تم إثبات العجز والنزاع في الشحنة بنجاح.";
            showDisputeModal = false;
            if (selectedTransfer != null) await OpenDetailsModal(selectedTransfer.Id);
            await LoadTransfers();
        }
    }

    private void OpenResolveModal(StockTransferLineDetailDto line)
    {
        activeResolveLine = line;
        resolveDto = new ResolveTransferDisputeDto
        {
            LineId = line.Id,
            FinalApprovedQty = line.ReceivedQty,
            LossQty = line.DispatchedQty - line.ReceivedQty
        };
        showResolveModal = true;
    }

    private async Task SubmitResolveDispute()
    {
        var response = await Http.PostAsJsonAsync("api/stocktransfers/resolve-dispute", resolveDto);
        if (response.IsSuccessStatusCode)
        {
            statusMessage = "تم اعتماد قرار لجنة فض النزاع وترحيل الهالك بنجاح.";
            showResolveModal = false;
            if (selectedTransfer != null) await OpenDetailsModal(selectedTransfer.Id);
            await LoadTransfers();
        }
    }

    private string GetStatusBadge(string status) => status switch
    {
        "IN_TRANSIT" => "bg-warning text-dark",
        "DISPUTED" => "bg-danger text-white",
        "COMPLETED" => "bg-success text-white",
        _ => "bg-secondary text-white"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "IN_TRANSIT" => "في الطريق 🚚",
        "DISPUTED" => "قيد النزاع ⚖️",
        "COMPLETED" => "مكتمل ومستلم ✅",
        _ => status
    };

    private string GetLineStatusBadge(string status) => status switch
    {
        "ACCEPTED" => "bg-success text-white",
        "DISPUTED" => "bg-danger text-white",
        _ => "bg-warning text-dark"
    };

    private string GetLineStatusLabel(string status) => status switch
    {
        "ACCEPTED" => "مقبول",
        "DISPUTED" => "عجز / نزاع",
        _ => "قيد النقل"
    };
}