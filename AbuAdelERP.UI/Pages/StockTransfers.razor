@page "/stock-transfers"
@using AbuAdelERP.UI.Services
@using System.Net.Http.Json
@using System.Text
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS
@inject AppState State

<PageTitle>التحويلات بين المخازن وفض المنازعات - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة التنفيذي -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-warning">🚚 التحويلات بين المخازن ولجان فض المنازعات (Inter-Warehouse Transfers)</h4>
                    <span class="badge bg-warning text-dark px-2 py-1 small fw-bold">حلقة تسليم مغلقة بنظام FEFO</span>
                </div>
                <small class="text-light text-opacity-75">
                    التحويل باللوطات والصلاحيات الفعلية المتاحة، قفل هوية المُسلّم والمستلم تلقائياً لمنع التلاعب، ومحاضر رسمية لتسوية عجز النقل.
                </small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportTransfersToExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير سجل التحويلات (CSV)
                </button>
                <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                    <i class="bi bi-download me-1"></i> تحميل قالب إكسيل
                </button>
                @if (State.HasAnyPermission("Transfers.Create", "Warehouse.View"))
                {
                    <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد أصناف من إكسيل
                    </button>
                }
                <button class="btn btn-outline-light btn-sm fw-bold shadow-sm" @onclick="LoadTransfers">
                    🔄 تحديث البيانات
                </button>
            </div>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccessFeedback ? "alert-success" : "alert-danger") border-0 shadow-sm alert-dismissible fade show py-2 mb-3 fw-bold" role="alert">
            @feedbackMessage
            <button type="button" class="btn-close py-2" @onclick='() => feedbackMessage = ""'></button>
        </div>
    }

    <!-- بطاقات المؤشرات اللحظية (KPIs) -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي أذون التحويل</small>
                <h4 class="mb-0 fw-bold text-primary mt-1 font-monospace">@transfersList.Count إذن</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 p-3 bg-white">
                <small class="text-muted fw-bold">شحنات بالطريق (بانتظار الاستلام)</small>
                <h4 class="mb-0 fw-bold text-warning mt-1 font-monospace">@transfersList.Count(t => t.Status == "IN_TRANSIT") شحنة</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-danger border-4 p-3 bg-white">
                <small class="text-muted fw-bold">نزاعات كميات معلقة للجنة</small>
                <h4 class="mb-0 fw-bold text-danger mt-1 font-monospace">@transfersList.Count(t => t.Status == "DISPUTED") نزاع</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3 bg-white">
                <small class="text-muted fw-bold">تحويلات مكتملة ومرحلة بالكامل</small>
                <h4 class="mb-0 fw-bold text-success mt-1 font-monospace">@transfersList.Count(t => t.Status == "COMPLETED") مكتمل</h4>
            </div>
        </div>
    </div>

    <!-- أزرار التبديل بين المحطات الأربع مشروطة بالصلاحيات -->
    <ul class="nav nav-pills mb-3 bg-light p-2 rounded shadow-sm border">
        @if (State.HasAnyPermission("Transfers.Create", "Warehouse.View", "StockTransfers.View"))
        {
            <li class="nav-item">
                <button class="nav-link fw-bold @(activeTab == "CREATE" ? "active" : "")" @onclick='() => ChangeTab("CREATE")'>
                    📤 1. إنشاء وإرسال إذن تحويل
                </button>
            </li>
        }
        @if (State.HasAnyPermission("Transfers.Receive", "Warehouse.View"))
        {
            <li class="nav-item">
                <button class="nav-link fw-bold @(activeTab == "IN_TRANSIT" ? "active" : "")" @onclick='() => ChangeTab("IN_TRANSIT")'>
                    🚚 2. شحنات بالطريق واستلام وفحص بالصنف
                    @if (transfersList.Any(t => t.Status == "IN_TRANSIT"))
                    {
                        <span class="badge bg-warning text-dark ms-1">@(transfersList.Count(t => t.Status == "IN_TRANSIT")) شحنة بالطريق</span>
                    }
                </button>
            </li>
        }
        @if (State.HasAnyPermission("Transfers.SettleDispute", "Warehouse.View", "Roles.Manage"))
        {
            <li class="nav-item">
                <button class="nav-link fw-bold @(activeTab == "DISPUTE" ? "active bg-danger text-white" : "text-danger")" @onclick='() => ChangeTab("DISPUTE")'>
                    ⚖️️ 3. لجنة فض المنازعات وتسوية الفروق
                    @if (transfersList.Any(t => t.Status == "DISPUTED"))
                    {
                        <span class="badge bg-white text-danger fw-bold ms-1">@(transfersList.Count(t => t.Status == "DISPUTED")) نزاع معلق</span>
                    }
                </button>
            </li>
        }
        @if (State.HasAnyPermission("Transfers.View", "Reports.View", "StockTransfers.View"))
        {
            <li class="nav-item">
                <button class="nav-link fw-bold @(activeTab == "HISTORY" ? "active" : "")" @onclick='() => ChangeTab("HISTORY")'>
                    📜 4. سجل وتقارير التحويلات الشاملة (مراجعة وطباعة)
                </button>
            </li>
        }
    </ul>

    <!-- ======================================================== -->
    <!-- المحطة 1: إنشاء وإرسال إذن تحويل جديد                    -->
    <!-- ======================================================== -->
    @if (activeTab == "CREATE" && State.HasAnyPermission("Transfers.Create", "Warehouse.View", "StockTransfers.View"))
    {
        <div class="card shadow-sm border-0 border-top border-primary border-4 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold text-primary m-0">➕ إصدار إذن نقل وتحويل بضاعة بين المستودعات</h5>
            </div>
            <div class="card-body bg-light">
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-dark">المخزن الراسل (المنصرف منه) *</label>
                        <select class="form-select border-primary fw-bold" value="@newTransfer.FromWarehouseId" @onchange="OnFromWarehouseChanged">
                            <option value="0">-- اختر المخزن الراسل --</option>
                            @foreach (var w in warehouses)
                            {
                                <option value="@w.Id">@w.WarehouseName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-dark">المخزن المستقبل (المحول إليه) *</label>
                        <select class="form-select border-primary fw-bold" @bind="newTransfer.ToWarehouseId">
                            <option value="0">-- اختر المخزن المستقبل --</option>
                            @foreach (var w in warehouses.Where(x => x.Id != newTransfer.FromWarehouseId))
                            {
                                <option value="@w.Id">@w.WarehouseName</option>
                            }
                        </select>
                    </div>

                    <!-- المسؤول القائم بالتحويل والصرف: مقفول ومربوط تلقائياً بجلسة الدخول -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-dark d-flex justify-content-between align-items-center">
                            <span>القائم بالصرف (المسؤول):</span>
                            <span class="badge bg-secondary font-monospace">🔒 موثق تلقائياً</span>
                        </label>
                        <input type="text" class="form-control fw-bold bg-white text-primary" 
                               value="@CurrentDispatcherDisplayName" readonly disabled />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary">مندوب الاستلام / السائق</label>
                        <input type="text" class="form-control" placeholder="اسم السائق أو مندوب الاستلام" @bind="newTransfer.DriverName" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary">رقم السيارة / وسيلة النقل</label>
                        <input type="text" class="form-control font-monospace" placeholder="مثال: ط د 1234" @bind="newTransfer.VehicleNumber" />
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white py-2 fw-bold text-dark d-flex justify-content-between align-items-center">
                        <span class="text-primary">📦 قائمة الأصناف المحولة (@transferLinesView.Count أصناف):</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-info fw-bold" @onclick="DownloadTemplateAsync">
                                <i class="bi bi-download me-1"></i> تحميل قالب الإكسيل
                            </button>
                            <button class="btn btn-sm btn-outline-success fw-bold" @onclick="OpenImportModal">
                                <i class="bi bi-file-earmark-excel me-1"></i> استيراد من إكسيل
                            </button>
                            <button class="btn btn-sm btn-success fw-bold" @onclick="AddTransferLine">
                                ➕ إضافة سطر صنف
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-bordered mb-0 align-middle text-center small">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 28%;">اسم الصنف *</th>
                                    <th style="width: 14%;">الرصيد المتاح بالمخزن</th>
                                    <th style="width: 14%;">الكمية المحولة *</th>
                                    <th style="width: 20%;">التشغيلة / اللوط الفعلي (FEFO) *</th>
                                    <th style="width: 12%;">تاريخ الصلاحية</th>
                                    <th style="width: 8%;">تكلفة الوحدة</th>
                                    <th style="width: 4%;">حذف</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in transferLinesView)
                                {
                                    bool isOverStock = line.DispatchedQty > line.AvailableStock && line.AvailableStock > 0;
                                    bool isNoStock = line.ItemId > 0 && line.AvailableStock <= 0;

                                    <tr class="@(isOverStock || isNoStock ? "table-danger" : "")">
                                        <td>
                                            <select class="form-select form-select-sm fw-bold border-primary" 
                                                    value="@line.ItemId" 
                                                    @onchange="(e) => OnLineItemChanged(line, e)">
                                                <option value="0">-- اختر الصنف --</option>
                                                @foreach (var itm in allItems)
                                                {
                                                    <option value="@itm.Id">@itm.ItemName (@itm.ItemCode) - @itm.Unit</option>
                                                }
                                            </select>
                                        </td>
                                        
                                        <td>
                                            @if (line.ItemId > 0)
                                            {
                                                <span class="badge @(line.AvailableStock > 0 ? "bg-success" : "bg-danger") px-2 py-1 font-monospace">
                                                    @(line.AvailableStock > 0 ? $"{line.AvailableStock:N2} {line.Unit}" : "رصيد 0")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>

                                        <td>
                                            <input type="number" step="0.01" 
                                                   class="form-control form-control-sm text-center fw-bold font-monospace @(isOverStock ? "border-danger text-danger bg-warning-subtle" : "border-success text-primary")" 
                                                   @bind="line.DispatchedQty" @bind:event="oninput" />
                                            @if (isOverStock)
                                            {
                                                <small class="text-danger fw-bold d-block" style="font-size: 0.72rem;">تجاوز الرصيد المتاح!</small>
                                            }
                                        </td>

                                        <td>
                                            @if (line.AvailableBatches.Any())
                                            {
                                                <select class="form-select form-select-sm fw-bold border-success font-monospace" 
                                                        value="@line.BatchNumber" 
                                                        @onchange="(e) => OnBatchSelected(line, e)">
                                                    @foreach (var b in line.AvailableBatches)
                                                    {
                                                        <option value="@b.BatchNumber">@b.BatchNumber (متاح: @b.AvailableQty.ToString("N1"))</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">اختر صنفاً به رصيد</span>
                                            }
                                        </td>

                                        <td>
                                            <input type="text" class="form-control form-control-sm text-center font-monospace bg-light" 
                                                   value="@(line.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")" readonly />
                                        </td>

                                        <td>
                                            <input type="text" class="form-control form-control-sm text-center font-monospace bg-light" 
                                                   value="@line.UnitCost.ToString("N2")" readonly />
                                        </td>

                                        <td>
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => transferLinesView.Remove(line)">🗑️</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button class="btn btn-primary fw-bold px-4 py-2 shadow-sm" 
                            disabled="@(isSubmitting || transferLinesView.Any(l => l.DispatchedQty <= 0 || l.DispatchedQty > l.AvailableStock || l.AvailableStock <= 0))" 
                            @onclick="SubmitTransfer">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري تحريك الشحنة وخصم الأرصدة...</span>
                        }
                        else
                        {
                            <span>🚀 إرسال وتحريك الشحنة (خصم من المخزن الراسل وتوجيهها للمستقبل)</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- المحطة 2: شحنات بالطريق والاستلام بالصنف                  -->
    <!-- ======================================================== -->
    @if (activeTab == "IN_TRANSIT" && State.HasAnyPermission("Transfers.Receive", "Warehouse.View"))
    {
        <div class="card shadow-sm border-0 border-top border-warning border-4 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold text-dark m-0">🚚 شحنات بالطريق واردة بانتظار فحص واستلام المخزن المستقبل</h5>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم التحويل</th>
                            <th>من مخزن</th>
                            <th>إلى مخزن</th>
                            <th>القائم بالصرف</th>
                            <th>المندوب / السائق</th>
                            <th>رقم السيارة</th>
                            <th>تاريخ الإرسال</th>
                            <th>الحالة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!transfersList.Any(t => t.Status == "IN_TRANSIT"))
                        {
                            <tr>
                                <td colspan="9" class="text-muted py-4 fw-bold">لا توجد شحنات بالطريق بانتظار الاستلام حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var tr in transfersList.Where(t => t.Status == "IN_TRANSIT"))
                            {
                                <tr>
                                    <td class="fw-bold text-primary font-monospace">@tr.TransferNumber</td>
                                    <td class="fw-bold">@tr.FromWarehouseName</td>
                                    <td class="fw-bold text-success">@tr.ToWarehouseName</td>
                                    <td><span class="badge bg-light text-dark border">@(!string.IsNullOrEmpty(tr.CreatedBy) ? tr.CreatedBy : "أمين المخزن")</span></td>
                                    <td>@(!string.IsNullOrEmpty(tr.DriverName) ? tr.DriverName : "نقل مباشر")</td>
                                    <td>@(!string.IsNullOrEmpty(tr.VehicleNumber) ? tr.VehicleNumber : "-")</td>
                                    <td class="font-monospace">@tr.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><span class="badge bg-warning text-dark">بالطريق (In-Transit)</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-primary fw-bold px-3 py-0 shadow-sm" @onclick="() => SelectForReceiving(tr)">
                                            🔎 فحص واستلام بالصنف
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (selectedReceiveTransfer != null)
        {
            <div class="card shadow-sm border-success border-2 mb-4 bg-light">
                <div class="card-header bg-success text-white py-2 fw-bold d-flex justify-content-between align-items-center">
                    <span>مطابقة وفحص أسطر إذن التحويل: @selectedReceiveTransfer.TransferNumber (المحول إلى: @selectedReceiveTransfer.ToWarehouseName)</span>
                    <button class="btn btn-sm btn-light py-0" @onclick="() => selectedReceiveTransfer = null">إغلاق</button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered bg-white text-center align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>الصنف المحول</th>
                                    <th>المنصرف من الراسل</th>
                                    <th>التشغيلة والصلاحية</th>
                                    <th>الكمية المستلمة فعلياً</th>
                                    <th>سبب الاختلاف / العجز (إن وجد)</th>
                                    <th>الحالة</th>
                                    <th>إجراء الاستلام</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedReceiveTransfer.Lines)
                                {
                                    <tr class="@(line.LineStatus == "ACCEPTED" ? "table-success" : line.LineStatus == "DISPUTED" ? "table-danger" : "")">
                                        <td class="fw-bold text-start ps-3">@line.ItemName (@line.ItemCode)</td>
                                        <td class="fw-bold text-primary font-monospace">@line.DispatchedQty.ToString("N2") @line.Unit</td>
                                        <td>
                                            <code class="fw-bold">@line.BatchNumber</code>
                                            <br />
                                            <small class="text-muted font-monospace">صلاحية: @line.ExpiryDate?.ToString("yyyy-MM-dd")</small>
                                        </td>
                                        <td style="width: 15%;">
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold font-monospace" @bind="line.ReceivedQty" disabled="@(line.LineStatus != "PENDING")" />
                                        </td>
                                        <td style="width: 25%;">
                                            <input type="text" class="form-control form-control-sm" @bind="line.DiscrepancyReason" placeholder="اذكر سبب العجز، الكسر، أو الزيادة..." disabled="@(line.LineStatus != "PENDING")" />
                                        </td>
                                        <td>
                                            @if (line.LineStatus == "ACCEPTED")
                                            {
                                                <span class="badge bg-success">تم الاستلام والمطابقة ✓</span>
                                            }
                                            else if (line.LineStatus == "DISPUTED")
                                            {
                                                <span class="badge bg-danger">خلاف معلق للجنة</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">قيد الفحص</span>
                                            }
                                        </td>
                                        <td>
                                            @if (line.LineStatus == "PENDING")
                                            {
                                                <div class="d-flex gap-1 justify-content-center">
                                                    <button class="btn btn-sm btn-success fw-bold py-0 px-2" title="الكمية مطابقة تماماً" @onclick="() => ConfirmLineReceive(line, true)">
                                                        ✓ مطابقة كاملة
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger fw-bold py-0 px-2" title="تسجيل فرق وعجز" @onclick="() => ConfirmLineReceive(line, false)">
                                                        ⚠️ إثبات عجز/فرق
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-success fw-bold">✓ تم الإثبات</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ======================================================== -->
    <!-- المحطة 3: لجنة فض المنازعات وتسوية الفروق                 -->
    <!-- ======================================================== -->
    @if (activeTab == "DISPUTE" && State.HasAnyPermission("Transfers.SettleDispute", "Warehouse.View", "Roles.Manage"))
    {
        <div class="card shadow-sm border-0 border-top border-danger border-4 mb-4">
            <div class="card-header bg-danger text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0">⚖️ لجنة فض منازعات التحويل وتسوية الفروق وعجز النقل</h5>
                <span class="badge bg-white text-danger fw-bold">صلاحية لجنة المنازعات / الإدارة المالية</span>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>رقم التحويل</th>
                            <th>من مخزن</th>
                            <th>إلى مخزن</th>
                            <th>الأصناف المتنازع عليها</th>
                            <th>تاريخ الإرسال</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!transfersList.Any(t => t.Status == "DISPUTED"))
                        {
                            <tr>
                                <td colspan="6" class="text-success py-5 fw-bold fs-6">
                                    🎉 ممتاز! لا توجد أي منازعات تحويل معلقة حالياً بين المستودعات.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var tr in transfersList.Where(t => t.Status == "DISPUTED"))
                            {
                                <tr>
                                    <td class="fw-bold text-primary font-monospace">@tr.TransferNumber</td>
                                    <td class="fw-bold">@tr.FromWarehouseName</td>
                                    <td class="fw-bold text-danger">@tr.ToWarehouseName</td>
                                    <td>
                                        @foreach (var dl in tr.Lines.Where(l => l.LineStatus == "DISPUTED"))
                                        {
                                            <span class="badge bg-warning text-dark m-1 p-2 font-monospace">
                                                @dl.ItemName: مرسل (@dl.DispatchedQty.ToString("N2")) ⟵ مستلم (@dl.ReceivedQty.ToString("N2"))
                                            </span>
                                        }
                                    </td>
                                    <td class="font-monospace">@tr.DispatchedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <button class="btn btn-sm btn-danger fw-bold px-3 shadow-sm py-0" @onclick="() => SelectForDisputeResolution(tr)">
                                            ⚖️ فتح محضر تسوية النزاع
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (selectedDisputeTransfer != null)
        {
            <div class="card shadow-sm border-danger border-2 mb-4 bg-white">
                <div class="card-header bg-dark text-white py-2 fw-bold d-flex justify-content-between align-items-center">
                    <span>⚖️ محضر تسوية خلاف التحويل رقم: @selectedDisputeTransfer.TransferNumber</span>
                    <button class="btn btn-sm btn-outline-light py-0" @onclick="() => selectedDisputeTransfer = null">إغلاق</button>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning border-0 small mb-3">
                        ℹ️ <strong>تعليمات اللجنة:</strong> حدد "الكمية المعتمدة نهائياً" للمخزن المستقبل، وسيتم قيد الفارق آلياً كـ <strong>«هالك نقل / عجز شحنة»</strong> مع ترحيل الأرصدة المخزنية والمالية فور الاعتماد، وتوثيق توقيع العضو: <strong>@CurrentDispatcherDisplayName</strong>.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered text-center align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>الصنف</th>
                                    <th>المرسل</th>
                                    <th>المستلم بالمستقبل</th>
                                    <th>سبب الخلاف</th>
                                    <th style="width: 15%;">الكمية المعتمدة للمستقبل *</th>
                                    <th style="width: 15%;">كمية العجز المقررة (هالك)</th>
                                    <th style="width: 25%;">قرار وملاحظات اللجنة *</th>
                                    <th>الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dLine in selectedDisputeTransfer.Lines.Where(l => l.LineStatus == "DISPUTED"))
                                {
                                    <tr>
                                        <td class="fw-bold text-start ps-3">@dLine.ItemName</td>
                                        <td class="fw-bold text-primary font-monospace">@dLine.DispatchedQty.ToString("N2") @dLine.Unit</td>
                                        <td class="fw-bold text-danger font-monospace">@dLine.ReceivedQty.ToString("N2") @dLine.Unit</td>
                                        <td class="text-danger small fw-bold">@dLine.DiscrepancyReason</td>
                                        <td>
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold border-success font-monospace" @bind="dLine.ReceivedQty" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold text-danger font-monospace" 
                                                   value="@(dLine.DispatchedQty - dLine.ReceivedQty)" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm border-primary" placeholder="مثال: تم إقرار عجز النقل وخصمه كهالك تشغيل" @bind="dLine.ResolutionNotes" />
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-success fw-bold px-3 shadow-sm py-0" @onclick="() => ConfirmResolveDispute(dLine)">
                                                ✅ اعتماد التسوية وترحيل الرصيد
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ======================================================== -->
    <!-- المحطة 4: سجل وتقارير التحويلات الشاملة                   -->
    <!-- ======================================================== -->
    @if (activeTab == "HISTORY" && State.HasAnyPermission("Transfers.View", "Reports.View", "StockTransfers.View"))
    {
        <div class="card shadow-sm border-0 border-top border-secondary border-3 mb-4">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark m-0">📜 الأرشيف التاريخي للتحويلات (للمراجعة والتدقيق والطباعة)</h6>
                <span class="badge bg-primary">المعروض: @FilteredTransfers.Count() إذن</span>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-striped mb-0 text-center align-middle small">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم التحويل</th>
                            <th>من مخزن</th>
                            <th>إلى مخزن</th>
                            <th>المندوب / السائق</th>
                            <th>عدد الأصناف</th>
                            <th>تاريخ الإرسال</th>
                            <th>تاريخ الإقفال</th>
                            <th>الحالة</th>
                            <th>إجراءات التدقيق</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredTransfers.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-muted py-4 fw-bold">لا توجد أذون تحويل مطابقة لشروط البحث.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var t in FilteredTransfers)
                            {
                                <tr>
                                    <td><code class="fw-bold font-monospace">@t.TransferNumber</code></td>
                                    <td class="fw-bold">@t.FromWarehouseName</td>
                                    <td class="fw-bold text-success">@t.ToWarehouseName</td>
                                    <td>@(!string.IsNullOrEmpty(t.DriverName) ? t.DriverName : "نقل داخلي")</td>
                                    <td><span class="badge bg-secondary">@t.Lines.Count أصناف</span></td>
                                    <td class="font-monospace">@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="font-monospace">@(t.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>
                                        <span class="badge @(t.Status == "COMPLETED" ? "bg-success" : t.Status == "DISPUTED" ? "bg-danger" : "bg-warning text-dark") px-2 py-1">
                                            @TranslateStatus(t.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary fw-bold px-3 py-0 shadow-sm" @onclick="() => OpenTransferDetailsModal(t)">
                                            🔍 تفاصيل وطباعة
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

<!-- نافذة عرض تفاصيل إذن التحويل والطباعة الرسمية -->
@if (isDetailsModalOpen && viewingTransfer != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-text me-1"></i> استعراض إذن نقل وتحويل بضاعة — رقم (@viewingTransfer.TransferNumber)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseTransferDetailsModal"></button>
                </div>

                <div class="modal-body p-4 bg-light" id="printable-transfer-area">
                    <div class="bg-white p-4 rounded shadow-sm border">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                            <div>
                                <h4 class="fw-bold text-primary m-0">مؤسسة حلواني أبو عادل</h4>
                                <small class="text-muted">للحلويات الشرقية والغربية والمخبوزات — إدارة سلاسل الإمداد والمستودعات</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-secondary fs-6 font-monospace mb-1">@viewingTransfer.TransferNumber</span>
                                <br />
                                <small class="text-muted">تاريخ الإصدار: @viewingTransfer.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </div>
                        </div>

                        <div class="row g-3 mb-4 small bg-light p-3 rounded border">
                            <div class="col-md-4">
                                <span class="text-muted d-block">المخزن الراسل (المنصرف منه):</span>
                                <strong class="text-dark fs-6">@viewingTransfer.FromWarehouseName</strong>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted d-block">المخزن المستقبل (المحول إليه):</span>
                                <strong class="text-success fs-6">@viewingTransfer.ToWarehouseName</strong>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted d-block">الحالة التشغيلية والمحاسبية:</span>
                                <span class="badge @(viewingTransfer.Status == "COMPLETED" ? "bg-success" : viewingTransfer.Status == "DISPUTED" ? "bg-danger" : "bg-warning text-dark") px-2 py-1">
                                    @TranslateStatus(viewingTransfer.Status)
                                </span>
                            </div>
                            <div class="col-md-6 border-top pt-2">
                                <span class="text-muted">السائق / مندوب الاستلام:</span> <strong>@(!string.IsNullOrEmpty(viewingTransfer.DriverName) ? viewingTransfer.DriverName : "نقل داخلي مباشر")</strong>
                            </div>
                            <div class="col-md-6 border-top pt-2">
                                <span class="text-muted">رقم السيارة / وسيلة النقل:</span> <strong class="font-monospace">@(!string.IsNullOrEmpty(viewingTransfer.VehicleNumber) ? viewingTransfer.VehicleNumber : "-")</strong>
                            </div>
                        </div>

                        <div class="table-responsive mb-3">
                            <table class="table table-bordered align-middle text-center small mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>م</th>
                                        <th>كود الصنف</th>
                                        <th>اسم الصنف ووحدة القياس</th>
                                        <th>رقم التشغيلة (Batch)</th>
                                        <th>تاريخ الصلاحية</th>
                                        <th>الكمية المحولة</th>
                                        <th>الكمية المستلمة</th>
                                        <th>هالك / عجز النقل</th>
                                        <th>حالة السطر</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int idx = 1; }
                                    @foreach (var ln in viewingTransfer.Lines)
                                    {
                                        <tr>
                                            <td>@(idx++)</td>
                                            <td class="font-monospace fw-bold">@ln.ItemCode</td>
                                            <td class="fw-bold text-start ps-3">@ln.ItemName</td>
                                            <td><code class="fw-bold font-monospace">@ln.BatchNumber</code></td>
                                            <td class="font-monospace">@(ln.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                            <td class="font-monospace fw-bold text-primary">@ln.DispatchedQty.ToString("N2") @ln.Unit</td>
                                            <td class="font-monospace fw-bold text-success">@ln.ReceivedQty.ToString("N2") @ln.Unit</td>
                                            <td class="font-monospace fw-bold text-danger">@(ln.LossQty > 0 ? $"{ln.LossQty:N2} {ln.Unit}" : "-")</td>
                                            <td>
                                                <span class="badge @(ln.LineStatus == "ACCEPTED" ? "bg-success" : ln.LineStatus == "DISPUTED" ? "bg-danger" : "bg-warning text-dark")">
                                                    @(ln.LineStatus == "ACCEPTED" ? "مطابق" : ln.LineStatus == "DISPUTED" ? "نزاع معلق" : "قيد الفحص")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!string.IsNullOrEmpty(viewingTransfer.Notes))
                        {
                            <div class="p-2 bg-light rounded border small mb-3">
                                <span class="fw-bold text-dark">ملاحظات الإذن:</span> @viewingTransfer.Notes
                            </div>
                        }

                        <div class="row mt-5 pt-4 border-top text-center small">
                            <div class="col-4">
                                <span class="d-block text-muted mb-4">أمين المخزن الراسل (المسؤول)</span>
                                <strong class="border-top pt-1 d-inline-block px-4">@viewingTransfer.CreatedBy</strong>
                            </div>
                            <div class="col-4">
                                <span class="d-block text-muted mb-4">السائق / مندوب الاستلام</span>
                                <strong class="border-top pt-1 d-inline-block px-4">@(!string.IsNullOrEmpty(viewingTransfer.DriverName) ? viewingTransfer.DriverName : "معتمد")</strong>
                            </div>
                            <div class="col-4">
                                <span class="d-block text-muted mb-4">أمين المخزن المستقبل / لجنة التسوية</span>
                                <strong class="border-top pt-1 d-inline-block px-4">@(!string.IsNullOrEmpty(viewingTransfer.ReceivedBy) ? viewingTransfer.ReceivedBy : "بانتظار الاعتماد")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseTransferDetailsModal">إغلاق</button>
                    <button type="button" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="PrintTransferDocument">
                        <i class="bi bi-printer me-1"></i> طباعة إذن التحويل الرسمي
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- نافذة استيراد أصناف التحويل من إكسيل -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد قائمة أصناف التحويل من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> 
                        يتعرف النظام تلقائياً على كود الصنف أو اسمه، ويطابقه مع دليل الأصناف لإدراجه في إذن التحويل الحالي.
                    </div>
                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>
                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة الأصناف المقروءة من الملف (@importedPreviewList.Count صنف):</span>
                            <span class="badge bg-success">جاهز للإدراج</span>
                        </div>
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>كود الصنف</th>
                                        <th>اسم الصنف</th>
                                        <th>الصنف المطابق بالنظام</th>
                                        <th>الكمية المحولة</th>
                                        <th>حالة المطابقة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@row.RawCode</td>
                                            <td class="fw-bold text-start ps-2">@row.RawName</td>
                                            <td class="text-start ps-2">
                                                @if (row.MatchedItemId > 0)
                                                {
                                                    <span class="text-success fw-bold">✔ @row.MatchedItemName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger fw-bold">✖ غير مطابق</span>
                                                }
                                            </td>
                                            <td class="font-monospace fw-bold text-primary">@row.Qty.ToString("N2")</td>
                                            <td>
                                                @if (row.MatchedItemId > 0)
                                                {
                                                    <span class="badge bg-success">مطابق وصالح</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">يحتاج مراجعة</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@(!importedPreviewList.Any(r => r.MatchedItemId > 0))" 
                            @onclick="ApplyImportedLines">
                        <i class="bi bi-check-circle me-1"></i> تطبيق وإدراج الأصناف في الإذن الحالي (@importedPreviewList.Count(r => r.MatchedItemId > 0))
                    </button>
                </div>
            </div>
        </div>
    </div>
}

