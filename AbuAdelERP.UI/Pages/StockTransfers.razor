    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1) return;

            var header = lines[0].Split(',');
            int codeIdx = 0, nameIdx = 1, qtyIdx = 2;

            for (int i = 0; i < header.Length; i++)
            {
                var h = header[i].Trim().ToLower();
                if (h.Contains("كود") || h.Contains("code")) codeIdx = i;
                else if (h.Contains("اسم") || h.Contains("item")) nameIdx = i;
                else if (h.Contains("كمي") || h.Contains("qty")) qtyIdx = i;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;
                var cols = line.Split(',');

                if (cols.Length >= 2)
                {
                    string code = codeIdx < cols.Length ? cols[codeIdx].Trim() : "";
                    string name = nameIdx < cols.Length ? cols[nameIdx].Trim() : "";
                    decimal.TryParse(qtyIdx < cols.Length ? cols[qtyIdx].Trim() : "1", out var qty);

                    var matched = allItems.FirstOrDefault(m =>
                        (!string.IsNullOrEmpty(code) && m.ItemCode.Equals(code, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(name) && m.ItemName.Contains(name, StringComparison.OrdinalIgnoreCase)));

                    importedPreviewList.Add(new TransferImportRowPreview
                    {
                        RawCode = code,
                        RawName = name,
                        MatchedItemId = matched?.Id ?? 0,
                        MatchedItemName = matched?.ItemName ?? "غير مطابق",
                        Qty = qty > 0 ? qty : 1
                    });
                }
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"خطأ في قراءة ملف الإكسيل: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

    private async Task ApplyImportedLines()
    {
        var valid = importedPreviewList.Where(l => l.MatchedItemId > 0 && l.Qty > 0).ToList();
        if (!valid.Any()) return;

        transferLinesView.RemoveAll(l => l.ItemId == 0 && l.DispatchedQty <= 0);

        foreach (var v in valid)
        {
            var lineModel = new TransferLineViewModel
            {
                ItemId = v.MatchedItemId,
                DispatchedQty = v.Qty
            };
            var itm = allItems.FirstOrDefault(i => i.Id == v.MatchedItemId);
            lineModel.ItemCode = itm?.ItemCode ?? "";
            lineModel.ItemName = itm?.ItemName ?? "";
            lineModel.Unit = itm?.Unit ?? "كجم";

            await ReloadBatchesForLine(lineModel);
            transferLinesView.Add(lineModel);
        }

        feedbackMessage = $"✅ تم إدراج ({valid.Count}) صنف من ملف الإكسيل ومطابقة لوطاتها بنجاح!";
        isSuccessFeedback = true;
        CloseImportModal();
    }

    private string TranslateStatus(string? status) => status switch
    {
        "IN_TRANSIT" => "بالطريق (بانتظار الاستلام)",
        "COMPLETED" => "مكتمل ومطابق ✓",
        "DISPUTED" => "نزاع كميات معلق ⚠️",
        "CANCELLED" => "ملغي",
        _ => status ?? "غير محدد"
    };

    private async Task TriggerBrowserDownload(string fileName, string content)
    {
        var utf8WithBom = "\uFEFF" + content;
        var jsCommand = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", jsCommand);
    }

    private string EscapeCsv(string val)
    {
        if (string.IsNullOrEmpty(val)) return "";
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n") || val.Contains("\r"))
            return $"\"{val.Replace("\"", "\"\"")}\"";
        return val;
    }
