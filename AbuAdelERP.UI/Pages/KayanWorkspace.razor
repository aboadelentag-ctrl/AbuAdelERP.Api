@page "/"
@page "/workspace"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@inject NavigationManager Navigation

<PageTitle>نظام كيان - مساحة العمل المركزية (Antigravity Edition)</PageTitle>

<div class="kayan-space-viewport" dir="rtl">
    <!-- خلفية النجوم والشبكة العصبية الهندسية التفاعلية -->
    <div class="network-canvas-bg"></div>

    <!-- شريط معلومات الهوية والمنصة العلوي -->
    <header class="top-system-bar">
        <div class="system-id">
            <span class="live-status-pulse"></span>
            <span>نظام كيان السحابي • Antigravity Enterprise v2.0</span>
        </div>
        <div class="tenant-tag">
            <span>المنشأة النشطة: مجموعة حلواني أبو عادل</span>
        </div>
    </header>

    <!-- المحتوى المركزي: الشعار والعنوان والشبكة -->
    <main class="center-content-flow">
        <div class="branding-group">
            <div class="glowing-logo-container">
                <svg class="kayan-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                </svg>
            </div>
            <h1 class="main-system-title">مساحة عمل كيان</h1>
            <p class="edition-caption">Antigravity Edition</p>
        </div>

        <!-- شبكة قطاعات الأعمال المركزية الستة (Clean & Optimized) -->
        <div class="modules-action-grid">
            
            <!-- 1. الإنتاج والتحويل الصناعي -->
            <button type="button" class="action-card" @onclick='() => NavigateTo("/finished-goods-transfer")' title="تحويل وتسليم المنتج التام">
                <div class="card-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                        <rect x="6" y="14" width="12" height="8" rx="1" />
                        <path d="M12 2v4" />
                        <path d="M8 6h8" />
                    </svg>
                </div>
                <span class="card-label">الإنتاج والتحويل</span>
            </button>

            <!-- 2. الرقابة والمخزون اللحظي -->
            <button type="button" class="action-card" @onclick='() => NavigateTo("/stock-balances")' title="أرصدة المخازن وكروت الأصناف">
                <div class="card-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M3 3v18h18" />
                        <path d="m19 9-5 5-4-4-3 3" />
                        <circle cx="19" cy="9" r="1.5" />
                    </svg>
                </div>
                <span class="card-label">الرقابة والمخزون</span>
            </button>

            <!-- 3. إمداد وتحويلات الفروع -->
            <button type="button" class="action-card" @onclick='() => NavigateTo("/branch-transfers")' title="شحن واستلام بضاعة الفروع وفض النزاعات">
                <div class="card-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                        <polyline points="10 9 9 9 8 9" />
                    </svg>
                </div>
                <span class="card-label">إمداد الفروع</span>
            </button>

            <!-- 4. بوابة العمليات المركزية (الفروع والمبيعات المعزولة) -->
            <button type="button" class="action-card highlight-glow" @onclick='() => NavigateTo("/branches-portal")' title="بوابة فروع ومنافذ التشغيل">
                <div class="card-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="2" y="3" width="20" height="14" rx="2" />
                        <line x1="8" y1="21" x2="16" y2="21" />
                        <line x1="12" y1="17" x2="12" y2="21" />
                    </svg>
                </div>
                <span class="card-label">بوابة العمليات</span>
            </button>

            <!-- 5. دليل الأصناف والخامات -->
            <button type="button" class="action-card" @onclick='() => NavigateTo("/items")' title="إدارة كروت الأصناف والخامات">
                <div class="card-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                        <line x1="12" y1="22.08" x2="12" y2="12" />
                    </svg>
                </div>
                <span class="card-label">الأصناف</span>
            </button>

            <!-- 6. الإعدادات والشركات -->
            <button type="button" class="action-card" @onclick='() => NavigateTo("/companies")' title="إعدادات النظام والشركات">
                <div class="card-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                </div>
                <span class="card-label">الإعدادات</span>
            </button>

        </div>
    </main>
</div>

<style>
    .kayan-space-viewport {
        position: relative;
        min-height: 100vh;
        width: 100vw;
        background-color: #030712;
        background-image: 
            radial-gradient(circle at 50% 30%, rgba(99, 102, 241, 0.12) 0%, transparent 60%),
            radial-gradient(circle at 80% 80%, rgba(168, 85, 247, 0.08) 0%, transparent 50%),
            radial-gradient(circle at 20% 70%, rgba(37, 99, 235, 0.08) 0%, transparent 50%);
        color: #F9FAFB;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
    }

    .network-canvas-bg {
        position: absolute;
        inset: 0;
        background-image: 
            radial-gradient(rgba(147, 51, 234, 0.25) 1px, transparent 1px),
            radial-gradient(rgba(99, 102, 241, 0.18) 1px, transparent 1px);
        background-size: 60px 60px, 120px 120px;
        background-position: 0 0, 30px 30px;
        opacity: 0.65;
        pointer-events: none;
    }

    .top-system-bar {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 2.5rem;
        font-size: 0.85rem;
        color: #9CA3AF;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .system-id {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 500;
        letter-spacing: 0.02em;
    }

    .live-status-pulse {
        width: 8px;
        height: 8px;
        background: #10B981;
        border-radius: 50%;
        box-shadow: 0 0 10px #10B981;
    }

    .tenant-tag {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.35rem 0.9rem;
        border-radius: 9999px;
        color: #E5E7EB;
    }

    .center-content-flow {
        position: relative;
        z-index: 2;
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem 4rem 1.5rem;
    }

    .branding-group {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    .glowing-logo-container {
        width: 72px;
        height: 72px;
        margin: 0 auto 1.5rem auto;
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.25), rgba(99, 102, 241, 0.15));
        border: 1px solid rgba(192, 132, 252, 0.4);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #C084FC;
        box-shadow: 0 0 35px rgba(168, 85, 247, 0.35), inset 0 0 15px rgba(192, 132, 252, 0.2);
    }

    .kayan-icon-svg {
        width: 38px;
        height: 38px;
    }

    .main-system-title {
        font-size: 2.75rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.02em;
        color: #FFFFFF;
        text-shadow: 0 0 40px rgba(255, 255, 255, 0.3);
    }

    .edition-caption {
        font-size: 0.95rem;
        color: #9CA3AF;
        margin-top: 0.5rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .modules-action-grid {
        display: grid;
        grid-template-columns: repeat(3, 200px);
        gap: 1.5rem;
        max-width: 900px;
        justify-content: center;
    }

    @@media (max-width: 860px) {
        .modules-action-grid {
            grid-template-columns: repeat(2, 160px);
        }
    }

    .action-card {
        background: rgba(17, 24, 39, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 2rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        color: inherit;
        outline: none;
    }

    .action-card:hover {
        transform: translateY(-6px);
        background: rgba(30, 41, 59, 0.85);
        border-color: rgba(168, 85, 247, 0.45);
        box-shadow: 0 16px 35px -10px rgba(0, 0, 0, 0.6), 0 0 20px rgba(147, 51, 234, 0.25);
    }

    .action-card.highlight-glow {
        border-color: rgba(99, 102, 241, 0.3);
    }

    .action-card.highlight-glow:hover {
        border-color: rgba(99, 102, 241, 0.8);
        box-shadow: 0 16px 35px -10px rgba(0, 0, 0, 0.6), 0 0 25px rgba(99, 102, 241, 0.35);
    }

    .card-icon-wrapper {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94A3B8;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .card-icon-wrapper svg {
        width: 32px;
        height: 32px;
    }

    .action-card:hover .card-icon-wrapper {
        color: #C084FC;
        transform: scale(1.1);
    }

    .action-card.highlight-glow:hover .card-icon-wrapper {
        color: #818CF8;
    }

    .card-label {
        font-size: 1.05rem;
        font-weight: 600;
        color: #E2E8F0;
    }
</style>

@code {
    private void NavigateTo(string url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            Navigation.NavigateTo(url);
        }
    }
}