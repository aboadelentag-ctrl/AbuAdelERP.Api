@page "/production-orders"
@using AbuAdelERP.UI.Models
@using System.Net.Http.Json
@inject HttpClient Http

<div class="container-fluid p-0" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-1 text-primary">🏭 أوامر التشغيل والإنتاج اليومي</h4>
            <small class="text-muted">إصدار أوامر الإنتاج وربط الصرف بمخازن تشغيل الصالات الإنتاجية وتصفية الأصناف المرتبطة بها</small>
        </div>
        <button class="btn btn-primary fw-bold shadow-sm" @onclick="PrepareNewOrder">
            ➕ إصدار أمر تشغيل جديد
        </button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mb-3" role="alert">
            <strong>@(isSuccess ? "✓ نجاح: " : "⚠️ تنبيه: ")</strong> @statusMessage
            <button type="button" class="btn-close" @onclick='() => statusMessage = string.Empty'></button>
        </div>
    }

    @if (isCreating)
    {
        <div class="card shadow border-primary mb-4">
            <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fs-6 fw-bold">إصدار أمر تشغيل لوردية إنتاج</h5>
                <button class="btn btn-sm btn-light text-primary fw-bold" @onclick="() => isCreating = false">إغلاق</button>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark">رقم أمر التشغيل (تلقائي)</label>
                        <input class="form-control form-control-sm bg-light fw-bold text-primary" readonly @bind="newOrder.OrderNumber" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark">تاريخ التشغيل *</label>
                        <input type="date" class="form-control form-control-sm" @bind="newOrder.OrderDate" />
                    </div>

                    <!-- اختيار القسم الإنتاجي المسئول -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-danger">القسم الإنتاجي المسؤول *</label>
                        <select class="form-select form-select-sm border-primary fw-bold" @bind="selectedDepartmentId" @bind:after="OnDepartmentSelected">
                            <option value="0">-- اختر القسم الإنتاجي المسؤول --</option>
                            @if (productionDepartments != null)
                            {
                                @foreach (var dept in productionDepartments)
                                {
                                    <option value="@dept.Id">@dept.DisplayName (@dept.DisplayCode)</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- اختيار مخزن صرف الخامات (يتم ضبطه آلياً على مخزن تشغيل القسم) -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark">مخزن صرف الخامات (صالة التشغيل) *</label>
                        <select class="form-select form-select-sm border-success fw-bold" @bind="newOrder.WarehouseId">
                            <option value="0">-- حدد مخزن صالة التشغيل --</option>
                            @if (filteredWarehouses != null && filteredWarehouses.Any())
                            {
                                @foreach (var w in filteredWarehouses)
                                {
                                    <option value="@w.Id">🏢 @(!string.IsNullOrEmpty(w.WarehouseName) ? w.WarehouseName : w.Name)</option>
                                }
                            }
                            else if (warehouses != null)
                            {
                                @foreach (var w in warehouses)
                                {
                                    <option value="@w.Id">🏢 @(!string.IsNullOrEmpty(w.WarehouseName) ? w.WarehouseName : w.Name)</option>
                                }
                            }
                        </select>
                        @if (isAutoMatchedWarehouse)
                        {
                            <small class="text-success fw-bold d-block mt-1">✓ تم التوجيه تلقائياً لمخزن صالة القسم</small>
                        }
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-12">
                        <label class="form-label small fw-bold text-muted">ملاحظات الوردية وبيانات التشغيل</label>
                        <input class="form-control form-control-sm" placeholder="مثال: وردية صباحية - تشغيل طلبيات فروع" @bind="newOrder.Notes" />
                    </div>
                </div>

                <!-- جدول الأصناف المستهدفة بناء على القسم المختار -->
                <div class="d-flex justify-content-between align-items-center mb-2 mt-4 pt-3 border-top">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">🍰 الأصناف المطلوب تصنيعها:</h6>
                        <small class="text-muted">
                            @(selectedDepartmentId == 0 ? "يرجى اختيار القسم الإنتاجي أعلاه لتحميل الأصناف المرتبطة به" : $"معروض أصناف: [{selectedDepartmentName}]")
                        </small>
                    </div>
                    <button class="btn btn-outline-success btn-sm fw-bold" disabled="@(selectedDepartmentId == 0)" @onclick="AddOrderItem">
                        ➕ إضافة صنف للتشغيل
                    </button>
                </div>

                <table class="table table-bordered table-sm align-middle mb-3">
                    <thead class="table-secondary text-center">
                        <tr>
                            <th style="width: 45%;">المنتج التام / خلطة التشغيل (BOM) *</th>
                            <th style="width: 25%;">الكمية المخططة *</th>
                            <th style="width: 15%;">الوحدة</th>
                            <th style="width: 15%;">حذف</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (newOrder.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">
                                    @(selectedDepartmentId == 0 ? "اختر القسم الإنتاجي أولاً للبدء بإضافة الأصناف." : "اضغط «إضافة صنف للتشغيل» لاختيار الصنف وتحديد الكمية.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var itm in newOrder.Items)
                            {
                                <tr>
                                    <td>
                                        <select class="form-select form-select-sm" @bind="itm.ItemId" @bind:after="() => OnProductItemChanged(itm)">
                                            <option value="0">-- اختر المنتج المطلوب تصنيعه --</option>
                                            @foreach (var prod in filteredProducts)
                                            {
                                                <option value="@prod.Id">@prod.ItemName (@prod.ItemCode)</option>
                                            }
                                        </select>
                                        @if (itm.RecipeId > 0)
                                        {
                                            <small class="text-success fw-bold d-block mt-1">✓ مرتبطة بخلطة معتمدة: @itm.RecipeName</small>
                                        }
                                        else if (itm.ItemId > 0)
                                        {
                                            <small class="text-warning fw-bold d-block mt-1">⚠️ لا توجد بطاقة خلطة (BOM) مسجلة لهذا الصنف</small>
                                        }
                                    </td>
                                    <td>
                                        <input type="number" step="1" class="form-control form-control-sm text-center fw-bold text-primary" @bind="itm.PlannedQuantity" />
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-3 py-1">@itm.Unit</span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-danger btn-sm px-2 py-0" @onclick="() => newOrder.Items.Remove(itm)">❌</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                    <button class="btn btn-secondary px-4" @onclick="() => isCreating = false">إلغاء</button>
                    <button class="btn btn-success px-5 fw-bold shadow-sm" @onclick="SubmitProductionOrder">
                        ✓ اعتماد أمر التشغيل واحتساب الخامات
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- كشف مقادير الخامات لأمر محدد -->
    @if (selectedOrderDetails != null)
    {
        <div class="card shadow border-info mb-4">
            <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">📋 كشف مقادير الخامات المعيارية لأمر التشغيل: [@selectedOrderDetails.OrderNumber]</h6>
                <button class="btn btn-sm btn-light text-dark fw-bold" @onclick="() => selectedOrderDetails = null">إغلاق الكشف</button>
            </div>
            <div class="card-body p-3">
                @foreach (var d in selectedOrderDetails.Details)
                {
                    <div class="p-3 bg-light border rounded mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <span class="badge bg-primary fs-6 me-2">@d.ItemName</span>
                                <small class="text-muted">الخلطة: <strong>@d.RecipeName</strong> | الكمية: <strong>@d.PlannedQuantity @d.Unit</strong></small>
                            </div>
                            <span class="badge bg-dark">تشغيلة المنتج التام: @d.BatchNumber</span>
                        </div>

                        <table class="table table-bordered table-sm mb-0 align-middle">
                            <thead class="table-light text-center">
                                <tr>
                                    <th>كود الخامة</th>
                                    <th>اسم الخامة</th>
                                    <th>إجمالي المقدار المطلوب صرفه</th>
                                    <th>الوحدة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (d.Materials.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-2">لا توجد خامات مسجلة في هذا البند.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var m in d.Materials)
                                    {
                                        <tr>
                                            <td class="text-center"><code>@m.ItemCode</code></td>
                                            <td class="fw-bold">@m.ItemName</td>
                                            <td class="text-center fw-bold text-danger">@m.RequiredQuantity</td>
                                            <td class="text-center">@m.Unit</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <!-- جدول أوامر التشغيل المعتمدة -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">سجل أوامر التشغيل الصادرة</h6>
            <span class="badge bg-secondary">@(ordersList?.Count ?? 0) أوامر</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>رقم الأمر</th>
                        <th>تاريخ التشغيل</th>
                        <th>مخزن الصرف (الصالة)</th>
                        <th>عدد الأصناف</th>
                        <th>الحالة</th>
                        <th>القسم / ملاحظات</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ordersList == null || ordersList.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                لا توجد أوامر تشغيل حالياً. اضغط على «إصدار أمر تشغيل جديد» للبدء.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ord in ordersList)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary">@ord.OrderNumber</td>
                                <td class="text-center">@ord.OrderDate</td>
                                <td class="text-center fw-bold text-dark">@ord.WarehouseName</td>
                                <td class="text-center"><span class="badge bg-info text-dark">@ord.ItemsCount أصناف</span></td>
                                <td class="text-center">
                                    <span class="badge @(ord.Status == "Pending_Execution" ? "bg-warning text-dark" : "bg-success")">
                                        @(ord.Status == "Pending_Execution" ? "جاهز للتنفيذ والصرف" : ord.Status)
                                    </span>
                                </td>
                                <td>@ord.Notes</td>
                                <td class="text-center">
                                    <button class="btn btn-outline-info btn-sm px-2 py-1" @onclick="() => ViewOrderDetails(ord.Id)">
                                        🔍 كشف الخامات
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    public class ItemLookupDto
    {
        public long Id { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string ItemType { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public long? DepartmentId { get; set; }
    }

    public class DepartmentLookupDto
    {
        public long Id { get; set; }
        public string? Code { get; set; }
        public string? DepartmentCode { get; set; }
        public string? Name { get; set; }
        public string? DepartmentName { get; set; }
        public long? ParentDepartmentId { get; set; }
        public long? ParentId { get; set; }

        public string DisplayName => !string.IsNullOrWhiteSpace(DepartmentName)
            ? DepartmentName
            : (!string.IsNullOrWhiteSpace(Name) ? Name : "قسم إنتاجي");

        public string DisplayCode => !string.IsNullOrWhiteSpace(DepartmentCode)
            ? DepartmentCode
            : (!string.IsNullOrWhiteSpace(Code) ? Code : Id.ToString());
    }

    public class WarehouseDto
    {
        public long Id { get; set; }
        public string WarehouseName { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public long? DepartmentId { get; set; }
        public string? WarehouseType { get; set; }
    }

    private List<ProductionOrderListDto>? ordersList = new();
    private List<RecipeDto> availableRecipes = new();
    private List<ItemLookupDto> allFinishedProducts = new();
    private List<ItemLookupDto> filteredProducts = new();
    private List<DepartmentLookupDto> productionDepartments = new();
    private List<WarehouseDto> warehouses = new();
    private List<WarehouseDto> filteredWarehouses = new();

    private CreateProductionOrderDto newOrder = new();
    private ProductionOrderListDto? selectedOrderDetails;
    private long selectedDepartmentId = 0;
    private string selectedDepartmentName = string.Empty;
    private bool isCreating = false;
    private bool isAutoMatchedWarehouse = false;
    private string statusMessage = string.Empty;
    private bool isSuccess = false;

    private string apiBase = "https://localhost:7273/api";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        // 1. جلب أقسام الإنتاج الفعلية
        try
        {
            var depts = await Http.GetFromJsonAsync<List<DepartmentLookupDto>>($"{apiBase}/departments");
            if (depts != null && depts.Any())
            {
                productionDepartments = depts
                    .Where(d => d.ParentDepartmentId == 2
                             || d.ParentId == 2
                             || d.DisplayCode == "300"
                             || d.DisplayCode == "400"
                             || (d.DisplayName.StartsWith("قسم") && !d.DisplayName.Contains("العليا")))
                    .ToList();

                if (!productionDepartments.Any())
                {
                    productionDepartments = depts.Where(d => !d.DisplayName.Contains("العليا")).ToList();
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"Depts error: {ex.Message}"); }

        // 2. جلب كافة المخازن
        try
        {
            var wh = await Http.GetFromJsonAsync<List<WarehouseDto>>($"{apiBase}/warehouses");
            if (wh != null && wh.Any()) warehouses = wh;
        }
        catch { warehouses = new List<WarehouseDto>(); }

        // 3. جلب كافة المنتجات التامة والوسيطة
        try
        {
            var items = await Http.GetFromJsonAsync<List<ItemLookupDto>>($"{apiBase}/items");
            if (items != null)
            {
                allFinishedProducts = items.Where(i => i.ItemType == "منتج تام" || i.ItemType == "منتج وسيط").ToList();
            }
        }
        catch (Exception ex) { Console.WriteLine($"Items error: {ex.Message}"); }

        // 4. جلب بطاقات الخلطات (BOM)
        try
        {
            var recs = await Http.GetFromJsonAsync<List<RecipeDto>>($"{apiBase}/recipes");
            if (recs != null) availableRecipes = recs;
        }
        catch (Exception ex) { Console.WriteLine($"Recipes error: {ex.Message}"); }

        // 5. جلب سجل الأوامر السابقة
        try
        {
            ordersList = await Http.GetFromJsonAsync<List<ProductionOrderListDto>>($"{apiBase}/productionorders");
        }
        catch (Exception ex) { Console.WriteLine($"Orders error: {ex.Message}"); }
    }

    private void PrepareNewOrder()
    {
        newOrder = new CreateProductionOrderDto
        {
            OrderNumber = $"PRD-{DateTime.UtcNow:yyyyMMdd}-{new Random().Next(100, 999)}",
            OrderDate = DateOnly.FromDateTime(DateTime.Today),
            WarehouseId = 0,
            Items = new List<ProductionOrderItemInputDto>()
        };
        selectedDepartmentId = 0;
        selectedDepartmentName = string.Empty;
        filteredProducts.Clear();
        filteredWarehouses.Clear();
        isAutoMatchedWarehouse = false;
        isCreating = true;
    }

    private void OnDepartmentSelected()
    {
        isAutoMatchedWarehouse = false;
        var dept = productionDepartments.FirstOrDefault(d => d.Id == selectedDepartmentId);
        if (dept != null)
        {
            selectedDepartmentName = dept.DisplayName;

            // 1. التحديد الآلي لمخزن تشغيل الصالة المرتبط بالقسم
            var matchedWarehouse = warehouses.FirstOrDefault(w =>
                (w.DepartmentId.HasValue && w.DepartmentId.Value == dept.Id) ||
                (!string.IsNullOrEmpty(w.WarehouseName) && dept.DisplayName.Contains("الشرقي") && w.WarehouseName.Contains("شرقي")) ||
                (!string.IsNullOrEmpty(w.WarehouseName) && (dept.DisplayName.Contains("الاسبشيال") || dept.DisplayName.Contains("الغربي")) && (w.WarehouseName.Contains("اسبشيال") || w.WarehouseName.Contains("غربي") || w.WarehouseName.Contains("جاتوه"))) ||
                (!string.IsNullOrEmpty(w.WarehouseName) && w.WarehouseName.Contains(dept.DisplayName))
            );

            // تصفية قائمة المخازن لتشمل مخزن القسم أو مخازن التشغيل
            filteredWarehouses = warehouses.Where(w =>
                (w.DepartmentId.HasValue && w.DepartmentId.Value == dept.Id) ||
                (!string.IsNullOrEmpty(w.WarehouseName) && (w.WarehouseName.Contains("تشغيل") || w.WarehouseName.Contains("صالة") || w.WarehouseName.Contains(dept.DisplayName))) ||
                (!string.IsNullOrEmpty(w.WarehouseType) && w.WarehouseType == "FLOOR_STOCK")
            ).ToList();

            if (!filteredWarehouses.Any())
            {
                filteredWarehouses = new List<WarehouseDto>(warehouses);
            }

            if (matchedWarehouse != null)
            {
                newOrder.WarehouseId = matchedWarehouse.Id;
                isAutoMatchedWarehouse = true;
            }
            else if (filteredWarehouses.Any())
            {
                newOrder.WarehouseId = filteredWarehouses.First().Id;
            }

            // 2. فلترة الأصناف المرتبطة بالقسم
            filteredProducts = allFinishedProducts
                .Where(p => (p.DepartmentId.HasValue && p.DepartmentId.Value == dept.Id)
                         || (dept.DisplayName.Contains("الشرقي") && (p.ItemName.Contains("بسبوسة") || p.ItemName.Contains("كنافة") || p.ItemName.Contains("بقلاوة") || p.ItemName.Contains("كعك")))
                         || ((dept.DisplayName.Contains("الاسبشيال") || dept.DisplayName.Contains("الغربي")) && (p.ItemName.Contains("جاتوه") || p.ItemName.Contains("تورت") || p.ItemName.Contains("سويسرول"))))
                .ToList();

            if (!filteredProducts.Any())
            {
                filteredProducts = new List<ItemLookupDto>(allFinishedProducts);
            }

            newOrder.Items.Clear();
            AddOrderItem();
        }
        else
        {
            selectedDepartmentName = string.Empty;
            filteredProducts.Clear();
            filteredWarehouses.Clear();
            newOrder.WarehouseId = 0;
            newOrder.Items.Clear();
        }
    }

    private void AddOrderItem()
    {
        newOrder.Items.Add(new ProductionOrderItemInputDto
        {
            PlannedQuantity = 10,
            Unit = "صاج"
        });
    }

    private void OnProductItemChanged(ProductionOrderItemInputDto itm)
    {
        var product = allFinishedProducts.FirstOrDefault(p => p.Id == itm.ItemId);
        if (product != null)
        {
            itm.ItemName = product.ItemName;

            var recipe = availableRecipes.FirstOrDefault(r => r.ProductItemId == product.Id);
            if (recipe != null)
            {
                itm.RecipeId = recipe.Id;
                itm.RecipeName = recipe.RecipeName;
                itm.Unit = !string.IsNullOrWhiteSpace(recipe.BatchUnit) ? recipe.BatchUnit : (!string.IsNullOrWhiteSpace(product.Unit) ? product.Unit : "صاج");
            }
            else
            {
                itm.RecipeId = 0;
                itm.RecipeName = string.Empty;
                itm.Unit = !string.IsNullOrWhiteSpace(product.Unit) ? product.Unit : "صاج";
            }
        }
    }

    private async Task ViewOrderDetails(long orderId)
    {
        try
        {
            selectedOrderDetails = await Http.GetFromJsonAsync<ProductionOrderListDto>($"{apiBase}/productionorders/{orderId}");
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"خطأ في جلب تفاصيل الأمر: {ex.Message}";
        }
    }

    private async Task SubmitProductionOrder()
    {
        if (selectedDepartmentId <= 0)
        {
            isSuccess = false;
            statusMessage = "يرجى اختيار القسم الإنتاجي المسؤول أولاً.";
            return;
        }

        if (newOrder.WarehouseId <= 0)
        {
            isSuccess = false;
            statusMessage = "يرجى تحديد مخزن صالة التشغيل لصرف الخامات.";
            return;
        }

        if (newOrder.Items.Count == 0 || newOrder.Items.Any(i => i.ItemId <= 0 || i.PlannedQuantity <= 0))
        {
            isSuccess = false;
            statusMessage = "يجب اختيار الصنف وتحديد كمية أكبر من الصفر لكل بند.";
            return;
        }

        newOrder.Notes = $"[{selectedDepartmentName}] {(newOrder.Notes ?? "")}".Trim();

        try
        {
            var res = await Http.PostAsJsonAsync($"{apiBase}/productionorders", newOrder);
            if (res.IsSuccessStatusCode)
            {
                isSuccess = true;
                statusMessage = $"تم اعتماد أمر تشغيل [{selectedDepartmentName}] بنجاح، وربطه بمخزن الصالة وتوليد مقادير الخامات!";
                isCreating = false;
                await LoadData();
            }
            else
            {
                isSuccess = false;
                var err = await res.Content.ReadAsStringAsync();
                statusMessage = !string.IsNullOrWhiteSpace(err) ? err : $"فشل الإصدار (كود: {res.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"خطأ في الاتصال: {ex.Message}";
        }
    }
}