@page "/productivity-dashboard"
@inject HttpClient Http
@using System.Net.Http.Json

<div class="container-fluid mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="text-primary m-0 mb-1">📊 لوحة قياس إنتاجية الأقسام (KPIs)</h3>
            <span class="text-muted">مراقبة كفاءة التشغيل ومعدل الإنتاج بالساعة لكل قسم</span>
        </div>
    </div>

    <!-- فلاتر البحث -->
    <div class="card shadow-sm border-0 bg-light mb-4">
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">من تاريخ:</label>
                    <input type="date" class="form-control fw-bold" @bind="startDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">إلى تاريخ:</label>
                    <input type="date" class="form-control fw-bold" @bind="endDate" />
                </div>
                <div class="col-md-4 text-start">
                    <button class="btn btn-primary fw-bold px-4 w-100 shadow-sm" @onclick="LoadKPIs" disabled="@isLoading">
                        @(isLoading ? "⏳ جاري الحساب..." : "🔍 عرض تقرير الكفاءة")
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger fw-bold shadow-sm">❌ @errorMessage</div>
    }

    <!-- عرض النتائج والمؤشرات -->
    @if (kpiData != null && kpiData.Any())
    {
        <div class="row mb-4">
            <!-- كارت ملخص: أعلى قسم إنتاجية -->
            <div class="col-md-12 mb-3">
                <div class="card bg-dark text-white shadow border-0">
                    <div class="card-body d-flex justify-content-between align-items-center p-4">
                        <div>
                            <h5 class="text-warning mb-1">🏆 أعلى قسم إنتاجية (نجم الشهر)</h5>
                            <h2 class="m-0 fw-bold">@topDepartment?.DepartmentName</h2>
                        </div>
                        <div class="text-center">
                            <span class="fs-6 text-light">معدل الإنتاج في الساعة</span>
                            <h2 class="text-success m-0 fw-bold" dir="ltr">@topDepartment?.ProductivityPerHour <small class="fs-6">وحدة/ساعة</small></h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 border-top border-primary border-4">
            <div class="card-header bg-white py-3">
                <h6 class="text-primary m-0 fw-bold">تفاصيل أداء الأقسام</h6>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover mb-0 text-center align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%;">القسم</th>
                            <th style="width: 25%;">إجمالي الساعات الفعلية (ساعة)</th>
                            <th style="width: 25%;">إجمالي الإنتاج التام (وحدة)</th>
                            <th style="width: 25%;">معدل الإنتاجية (وحدة / ساعة)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kpi in kpiData.OrderByDescending(k => k.ProductivityPerHour))
                        {
                            <tr>
                                <td class="fw-bold text-dark fs-5">@kpi.DepartmentName</td>
                                <td class="fw-bold text-secondary">@kpi.TotalHours</td>
                                <td class="fw-bold text-primary">@kpi.TotalProduced</td>
                                <td>
                                    <!-- تلوين المؤشر بناءً على قوة الإنتاجية -->
                                    <span class="badge @GetProductivityColor(kpi.ProductivityPerHour) fs-5 px-4 py-2 rounded-pill shadow-sm">
                                        @kpi.ProductivityPerHour
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (!isLoading && kpiData != null && !kpiData.Any())
    {
        <div class="alert alert-warning fw-bold text-center p-4 shadow-sm">
            ⚠️ لا توجد بيانات إنتاجية مسجلة للأقسام في هذه الفترة المحددة.
        </div>
    }
</div>

@code {
    private DateTime startDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime endDate = DateTime.Now;

    private List<DepartmentKpiDto> kpiData = new();
    private DepartmentKpiDto? topDepartment;

    private bool isLoading = false;
    private string errorMessage = "";

    private string apiUrl = "https://localhost:7273/api/Productivity";

    protected override async Task OnInitializedAsync()
    {
        // يمكننا تحميل البيانات تلقائياً عند فتح الشاشة
        // await LoadKPIs();
    }

    private async Task LoadKPIs()
    {
        isLoading = true;
        errorMessage = "";
        kpiData.Clear();
        topDepartment = null;

        try
        {
            string url = $"{apiUrl}/department-kpi?startDate={startDate:yyyy-MM-dd}&endDate={endDate:yyyy-MM-dd}";
            kpiData = await Http.GetFromJsonAsync<List<DepartmentKpiDto>>(url) ?? new();

            if (kpiData.Any())
            {
                topDepartment = kpiData.OrderByDescending(k => k.ProductivityPerHour).First();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل في استخراج التقرير: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // دالة لتلوين المؤشر (لون أخضر لو الإنتاجية عالية، أصفر للمتوسط، أحمر للضعيف)
    private string GetProductivityColor(decimal productivity)
    {
        if (productivity >= 50) return "bg-success"; // إنتاج ممتاز (أكثر من 50 وحدة بالساعة) - يمكنك تعديل الرقم حسب طبيعة المصنع
        if (productivity >= 20) return "bg-warning text-dark"; // إنتاج متوسط
        return "bg-danger"; // إنتاج ضعيف
    }

    public class DepartmentKpiDto
    {
        public string DepartmentName { get; set; } = string.Empty;
        public decimal TotalHours { get; set; }
        public decimal TotalProduced { get; set; }
        public decimal ProductivityPerHour { get; set; }
    }
}