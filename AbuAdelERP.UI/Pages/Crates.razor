@page "/crates"
@page "/crates-management"
@using System.Net.Http.Json
@using System.Text
@using AbuAdelERP.UI.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject AppState State

<PageTitle>حوكمة عهدة الصاجات والأسبتة والفوارغ - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الشاشة التنفيذي -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-warning">🧺 حوكمة عهدة الصاجات والأسبتة والفوارغ</h4>
                    <span class="badge bg-warning text-dark px-2 py-1 small fw-bold">Two-Party Handshake & Custody</span>
                </div>
                <small class="text-light text-opacity-75">
                    الرقابة الميدانية المغلقة: صرف الفوارغ ⇦ الاستلام وفصل المهام ⇦ فض نزاعات العجز والكسر ⇦ عهد العملاء والفروع.
                </small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-light btn-sm fw-bold shadow-sm" @onclick="LoadAllData" disabled="@isLoading">
                    🔄 تحديث البيانات اللحظية
                </button>
            </div>
        </div>
    </div>

    <!-- شريط التنبيهات -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mb-3 py-2 fw-bold" role="alert">
            <strong>@(isSuccess ? "✓ نجاح: " : "⚠️ تنبيه: ")</strong> @alertMessage
            <button type="button" class="btn-close py-2" @onclick="() => alertMessage = string.Empty"></button>
        </div>
    }

    <!-- التبويبات الرئيسية -->
    <ul class="nav nav-pills mb-3 bg-light p-2 rounded shadow-sm border">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "containers" ? "active fw-bold" : "")" @onclick='() => activeTab = "containers"'>
                🏭 1. دورة الصاجات والأسبتة (المصنع والفروع والسائقين)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "clients" ? "active fw-bold" : "")" @onclick='() => activeTab = "clients"'>
                👥 2. عهد عملاء الجملة والتوزيع الخارجي (@(clients?.Count ?? 0))
            </button>
        </li>
    </ul>

    <!-- ======================================================== -->
    <!-- Tab 1: دورة الصاجات والأسبتة بين المصنع والفروع          -->
    <!-- ======================================================== -->
    @if (activeTab == "containers")
    {
        <!-- كروت الأرصدة اللحظية للحاويات -->
        <div class="row g-3 mb-4">
            @foreach (var c in containersInventory)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-3 bg-white border-top border-4 border-primary p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-dark m-0">@c.ContainerName</h6>
                            <span class="badge bg-primary font-monospace fs-6">إجمالي المصنع: @c.TotalFactoryQuantity</span>
                        </div>
                        <small class="text-muted d-block mb-3">المواصفات: @c.Specification</small>
                        <div class="row g-2 text-center small">
                            <div class="col-4">
                                <div class="bg-success bg-opacity-10 p-2 rounded">
                                    <span class="text-muted d-block">بمخزن التعبئة</span>
                                    <strong class="text-success fs-6 font-monospace">@c.InPackagingWarehouseQuantity</strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-info bg-opacity-10 p-2 rounded">
                                    <span class="text-muted d-block">مع الفروع/السائقين</span>
                                    <strong class="text-primary fs-6 font-monospace">@c.WithDriversAndBranchesQuantity</strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-danger bg-opacity-10 p-2 rounded">
                                    <span class="text-muted d-block">عجز / تالف</span>
                                    <strong class="text-danger fs-6 font-monospace">@(c.DisputedQuantity + c.DamagedQuantity)</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- شريط أدوات الحركات -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold m-0 text-dark">📋 سجل حركة الصاجات والأسبتة والمصافحة الميدانية</h5>
            <button class="btn btn-primary btn-sm fw-bold shadow-sm px-3" @onclick="OpenDispatchModal">
                ➕ إصدار إذن صرف فوارغ (طرف أول)
            </button>
        </div>

        <!-- جدول الحركات الميدانية -->
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 align-middle text-center small">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم الحركة</th>
                            <th>التاريخ</th>
                            <th>نوع الحركة</th>
                            <th>نوع الفوارغ</th>
                            <th>المصروف</th>
                            <th>المستلم</th>
                            <th>العجز / التالف</th>
                            <th>من ⇦ إلى</th>
                            <th>المسلِّم ⇦ المستلم</th>
                            <th>الحالة الرقابية</th>
                            <th>الإجراء الميداني</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!containerMovements.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-muted py-4 fw-bold">لا توجد حركات فوارغ مسجلة حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var m in containerMovements)
                            {
                                <tr>
                                    <td class="font-monospace fw-bold text-primary">@m.MovementNumber</td>
                                    <td class="font-monospace text-muted">@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <span class="badge @(m.MovementType == "DISPATCH_BRANCH" ? "bg-warning text-dark" : "bg-info text-dark")">
                                            @(m.MovementType == "DISPATCH_BRANCH" ? "صرف للفرع" : "مرتجع للمصنع")
                                        </span>
                                    </td>
                                    <td class="fw-bold">@m.ContainerName</td>
                                    <td class="fw-bold fs-6 font-monospace text-primary">@m.DispatchedQuantity</td>
                                    <td class="fw-bold fs-6 font-monospace text-success">@(m.ReceivedQuantity > 0 ? m.ReceivedQuantity : "-")</td>
                                    <td>
                                        @if (m.ShortageQuantity > 0 || m.DamagedCount > 0)
                                        {
                                            <span class="badge bg-danger font-monospace">عجز: @m.ShortageQuantity | كسر: @m.DamagedCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold">@m.SourceLocation</div>
                                        <small class="text-muted">⇦ @m.DestinationLocation</small>
                                    </td>
                                    <td>
                                        <div class="small fw-bold">@m.DispatchedByName</div>
                                        <small class="text-muted">@(string.IsNullOrEmpty(m.ReceivedByName) ? "قيد الانتظار" : $"⇦ {m.ReceivedByName}")</small>
                                    </td>
                                    <td>
                                        @if (m.Status == "PENDING_RECEIPT")
                                        {
                                            <span class="badge bg-warning text-dark">⏳ بانتظار تأكيد المستلم</span>
                                        }
                                        else if (m.Status == "DISPUTED")
                                        {
                                            <span class="badge bg-danger">🚨 نزاع: عجز أو تلف</span>
                                        }
                                        else if (m.Status == "COMPLETED")
                                        {
                                            <span class="badge bg-success">✓ تم الاستلام والترصيد</span>
                                        }
                                        else if (m.Status == "RESOLVED")
                                        {
                                            <span class="badge bg-secondary">⚖️ حُسم بقرار تحكيم</span>
                                        }
                                    </td>
                                    <td>
                                        @if (m.Status == "PENDING_RECEIPT")
                                        {
                                            <button class="btn btn-success btn-sm py-0 px-2 fw-bold" @onclick="() => OpenReceiveModal(m)">
                                                📥 تأكيد الاستلام
                                            </button>
                                        }
                                        else if (m.Status == "DISPUTED")
                                        {
                                            <button class="btn btn-danger btn-sm py-0 px-2 fw-bold" @onclick="() => OpenDisputeModal(m)">
                                                ⚖️ فض النزاع
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">مكتمل</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- Tab 2: عهد عملاء الجملة والتوزيع الخارجي                 -->
    <!-- ======================================================== -->
    @if (activeTab == "clients")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="badge bg-dark fs-6 shadow-sm">🏭 رصيد المصنع الداخلي للإسبات: <strong class="text-warning font-monospace">@factoryBalance</strong> سبت</span>
            </div>
            <button class="btn btn-success btn-sm fw-bold shadow-sm" @onclick="ShowAddClientForm">
                ➕ إضافة عميل / مندوب جديد
            </button>
        </div>

        @if (showClientForm)
        {
            <div class="card shadow-sm mb-4 border-primary border-2">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="m-0 fw-bold">@(currentClient.Id == 0 ? "إضافة عميل جديد" : "تعديل بيانات العميل")</h6>
                </div>
                <div class="card-body bg-light p-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">اسم العميل / المندوب <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" @bind="currentClient.Name" placeholder="أدخل اسم العميل..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">الرصيد الافتتاحي</label>
                            <input type="number" class="form-control form-control-sm" @bind="currentClient.CrateBalance" />
                        </div>
                        <div class="col-md-2 d-flex gap-1">
                            <button class="btn btn-primary btn-sm flex-fill fw-bold" @onclick="SaveClient">💾 حفظ</button>
                            <button class="btn btn-secondary btn-sm" @onclick="() => showClientForm = false">إلغاء</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم</th>
                            <th>اسم العميل / المندوب</th>
                            <th>رصيد الإسبات الحالي</th>
                            <th>إدارة العهدة والحركات</th>
                            <th>إعدادات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (clients == null || !clients.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-muted py-4 fw-bold">لا يوجد عملاء مسجلون حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var c in clients)
                            {
                                <tr>
                                    <td>@c.Id</td>
                                    <td class="fw-bold text-dark text-start ps-3">@c.Name</td>
                                    <td>
                                        <span class="badge @(c.CrateBalance > 0 ? "bg-danger" : "bg-success") fs-6 font-monospace px-3 py-1">
                                            @c.CrateBalance
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-primary py-0 px-2 fw-bold" @onclick="() => ShowTransactionForm(c)">
                                            📦 صرف / استلام
                                        </button>
                                        <button class="btn btn-sm btn-info py-0 px-2 fw-bold text-white ms-1" @onclick="() => ShowHistory(c)">
                                            📜 كشف الحساب
                                        </button>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => EditClient(c)">✏️</button>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2 ms-1" @onclick="() => DeleteClient(c.Id)">🗑️</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- Modals: نوافذ الحركات والتحكيم                           -->
    <!-- ======================================================== -->
    <!-- نافذة صرف الفوارغ للمصنع والفروع (Dispatch Modal) -->
    @if (showDispatchModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-primary shadow-lg">
                    <div class="modal-header bg-primary text-white py-2 px-3">
                        <h6 class="modal-title fw-bold">➕ إصدار إذن صرف صاجات / أسبتة (طرف أول)</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showDispatchModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">نوع الحركة *</label>
                            <select class="form-select form-select-sm fw-bold" @bind="dispatchDto.MovementType">
                                <option value="DISPATCH_BRANCH">صرف من المصنع إلى الفرع / السائق</option>
                                <option value="RETURN_FACTORY">إرجاع فوارغ من الفرع إلى المصنع</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">نوع الصاجات / الحاويات *</label>
                            <select class="form-select form-select-sm fw-bold" @bind="dispatchDto.ContainerName">
                                @foreach (var cn in lookups.Containers)
                                {
                                    <option value="@cn.ContainerName">@cn.ContainerName (@cn.Specification)</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold">موقع المصدر (المُسلِّم) *</label>
                                <input type="text" class="form-control form-control-sm" @bind="dispatchDto.SourceLocation" placeholder="مثال: مخزن التعبئة المركزي" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">موقع الوجهة (المستلم) *</label>
                                <input type="text" class="form-control form-control-sm" @bind="dispatchDto.DestinationLocation" placeholder="مثال: فرع مصدق - الدقي" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">العدد المنصرف *</label>
                            <input type="number" class="form-control text-center fw-bold fs-5 text-primary font-monospace" @bind="dispatchDto.DispatchedQuantity" min="1" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">ملاحظات الإذن</label>
                            <input type="text" class="form-control form-control-sm" placeholder="بيانات السائق أو السيارة..." @bind="dispatchDto.Notes" />
                        </div>
                    </div>
                    <div class="modal-footer py-2 bg-light d-flex justify-content-between">
                        <button class="btn btn-secondary btn-sm" @onclick="() => showDispatchModal = false">إلغاء</button>
                        <button class="btn btn-primary btn-sm fw-bold px-3 shadow-sm" @onclick="SubmitDispatch" disabled="@isProcessing">
                            @(isProcessing ? "⏳ جاري الإصدار..." : "✓ إصدار الإذن وإرساله للمستلم")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- نافذة استلام الفوارغ الميداني ومطابقة العجز (Receive Modal) -->
    @if (selectedMovementToReceive != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-success shadow-lg">
                    <div class="modal-header bg-success text-white py-2 px-3">
                        <h6 class="modal-title fw-bold">📥 تأكيد الاستلام الميداني: @selectedMovementToReceive.MovementNumber</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => selectedMovementToReceive = null"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-light border small mb-3">
                            <div><strong>الحاوية:</strong> @selectedMovementToReceive.ContainerName</div>
                            <div><strong>المصروف من المصدر:</strong> <strong class="fs-6 font-monospace text-primary">@selectedMovementToReceive.DispatchedQuantity</strong></div>
                            <div><strong>المُسلِّم:</strong> @selectedMovementToReceive.DispatchedByName</div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-success">العدد المستلم فعلياً *</label>
                                <input type="number" class="form-control text-center fw-bold fs-5 font-monospace border-success" @bind="receiveDto.ActualReceivedQuantity" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-danger">المكسور والتالف من العدد المستلم</label>
                                <input type="number" class="form-control text-center fw-bold fs-5 font-monospace border-danger" @bind="receiveDto.DamagedCount" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">ملاحظات الاستلام والمطابقة</label>
                            <textarea class="form-control" rows="2" placeholder="ملاحظات العجز أو التلف..." @bind="receiveDto.ReceiveNotes"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer py-2 bg-light d-flex justify-content-between">
                        <button class="btn btn-secondary btn-sm" @onclick="() => selectedMovementToReceive = null">إلغاء</button>
                        <button class="btn btn-success btn-sm fw-bold px-3 shadow-sm" @onclick="SubmitReceive" disabled="@isProcessing">
                            @(isProcessing ? "⏳ جاري التأكيد..." : "✓ تأكيد الاستلام وترصيد العهدة")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- نافذة فض النزاع والتحكيم (Dispute Modal) -->
    @if (selectedMovementToDispute != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-danger shadow-lg">
                    <div class="modal-header bg-danger text-white py-2 px-3">
                        <h6 class="modal-title fw-bold">⚖️ اجتماع لجنة التحكيم - تسوية نزاع الصاجات: @selectedMovementToDispute.MovementNumber</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => selectedMovementToDispute = null"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-light border small mb-3">
                            <div><strong>الحاوية:</strong> @selectedMovementToDispute.ContainerName</div>
                            <div><strong>المنصرف:</strong> @selectedMovementToDispute.DispatchedQuantity | <strong>المستلم:</strong> @selectedMovementToDispute.ReceivedQuantity</div>
                            <div class="text-danger fw-bold">العجز: @selectedMovementToDispute.ShortageQuantity | التالف: @selectedMovementToDispute.DamagedCount</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">قرار اللجنة وتوجيه المسؤولية *</label>
                            <select class="form-select form-select-sm fw-bold" @bind="disputeDto.ArbitrationDecision">
                                <option value="تحميل غرامة مالية على السائق">تحميل غرامة مالية على السائق</option>
                                <option value="تحميل غرامة مالية على أمين مخزن الفرع">تحميل غرامة مالية على أمين مخزن الفرع</option>
                                <option value="إهلاك كسر طبيعي على عهدة المصنع">إهلاك كسر طبيعي على عهدة المصنع</option>
                                <option value="إعادة الصاجات المعثور عليها لمخزن التعبئة">إعادة الصاجات المعثور عليها لمخزن التعبئة</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">الغرامة المالية المقررة (ج.م)</label>
                            <input type="number" step="0.01" class="form-control form-control-sm font-monospace fw-bold" @bind="disputeDto.FinancialPenalty" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">محضر وتفاصيل القرار</label>
                            <textarea class="form-control" rows="2" placeholder="محضر اجتماع اللجنة..." @bind="disputeDto.ArbitrationText"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer py-2 bg-light d-flex justify-content-between">
                        <button class="btn btn-secondary btn-sm" @onclick="() => selectedMovementToDispute = null">إلغاء</button>
                        <button class="btn btn-danger btn-sm fw-bold px-3 shadow-sm" @onclick="SubmitSettleDispute" disabled="@isProcessing">
                            ✓ اعتماد قرار التحكيم وتسوية العهدة
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- نافذة تسجيل حركة عميل (منصرف/مستلم) -->
    @if (showTransactionModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-primary shadow-lg">
                    <div class="modal-header bg-primary text-white py-2 px-3">
                        <h6 class="modal-title fw-bold">تسجيل حركة إسبات: @selectedClient?.Name</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showTransactionModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">نوع الحركة *</label>
                            <select class="form-select border-primary fw-bold" @bind="newTransaction.TransactionType">
                                <option value="منصرف للعميل">🔴 منصرف للعميل (خروج إسبات من المصنع)</option>
                                <option value="مستلم من العميل">🟢 مستلم من العميل (رجوع إسبات للمصنع)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">عدد الإسبات *</label>
                            <input type="number" class="form-control text-center fs-4 fw-bold text-primary font-monospace" @bind="newTransaction.Quantity" min="1" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">اسم السائق / المندوب</label>
                            <input type="text" class="form-control form-control-sm" placeholder="اسم السائق الناقل..." @bind="newTransactionDriver" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">ملاحظات</label>
                            <textarea class="form-control" rows="2" placeholder="ملاحظات الحركة..." @bind="newTransaction.Notes"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer py-2 bg-light d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showTransactionModal = false">إلغاء</button>
                        <button type="button" class="btn btn-primary btn-sm fw-bold px-3 shadow-sm" @onclick="SaveTransaction" disabled="@isProcessing">
                            💾 حفظ واعتماد الحركة
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- نافذة كشف حساب العميل (History Modal) -->
    @if (showHistoryModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content border-info shadow-lg">
                    <div class="modal-header bg-info text-white py-2 px-3">
                        <h6 class="modal-title fw-bold">📜 كشف حساب إسبات: @selectedClient?.Name</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showHistoryModal = false"></button>
                    </div>
                    <div class="modal-body p-0">
                        @if (clientHistory == null)
                        {
                            <div class="p-4 text-center text-muted">جاري تحميل السجل...</div>
                        }
                        else if (!clientHistory.Any())
                        {
                            <div class="p-4 text-center text-muted">لا توجد حركات مسجلة لهذا العميل حتى الآن.</div>
                        }
                        else
                        {
                            <table class="table table-striped table-hover mb-0 text-center align-middle small">
                                <thead class="table-light">
                                    <tr>
                                        <th>التاريخ والوقت</th>
                                        <th>نوع الحركة</th>
                                        <th>الكمية</th>
                                        <th>السائق / الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var trans in clientHistory)
                                    {
                                        <tr>
                                            <td class="font-monospace text-muted">@trans.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td class="fw-bold @(trans.TransactionType == "منصرف للعميل" ? "text-danger" : "text-success")">
                                                @trans.TransactionType
                                            </td>
                                            <td class="fw-bold fs-6 font-monospace">@trans.Quantity</td>
                                            <td class="text-muted text-start ps-3">@trans.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <div class="modal-footer py-2 bg-light d-flex justify-content-between">
                        <span class="fw-bold fs-6 text-primary">الرصيد الحالي: @selectedClient?.CrateBalance سبت</span>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showHistoryModal = false">إغلاق</button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private string activeTab = "containers";
    private string alertMessage = string.Empty;
    private bool isSuccess = false;
    private bool isLoading = false;
    private bool isProcessing = false;

    // --- بيانات حاويات المصنع والفروع ---
    private List<CirculatingContainerViewDto> containersInventory = new();
    private List<CrateMovementViewDto> containerMovements = new();
    private CrateLookupsDto lookups = new();

    private bool showDispatchModal = false;
    private DispatchCrateDto dispatchDto = new();

    private CrateMovementViewDto? selectedMovementToReceive;
    private ReceiveCrateDto receiveDto = new();

    private CrateMovementViewDto? selectedMovementToDispute;
    private SettleDisputeDto disputeDto = new();

    // --- بيانات عملاء التوزيع الخارجي ---
    private int factoryBalance = 0;
    private List<CrateClient>? clients;
    private bool showClientForm = false;
    private CrateClient currentClient = new();

    private bool showTransactionModal = false;
    private bool showHistoryModal = false;
    private CrateClient? selectedClient;
    private CrateClientTransaction newTransaction = new();
    private string newTransactionDriver = string.Empty;
    private List<CrateClientTransactionViewDto>? clientHistory;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        isLoading = true;
        try
        {
            // 1. جلب بيانات الحاويات والصاجات
            lookups = await Http.GetFromJsonAsync<CrateLookupsDto>("api/Crates/lookups") ?? new();
            containersInventory = await Http.GetFromJsonAsync<List<CirculatingContainerViewDto>>("api/Crates/inventory") ?? new();
            containerMovements = await Http.GetFromJsonAsync<List<CrateMovementViewDto>>("api/Crates/movements") ?? new();

            // 2. جلب بيانات العملاء
            clients = await Http.GetFromJsonAsync<List<CrateClient>>("api/CrateClients") ?? new();
            factoryBalance = await Http.GetFromJsonAsync<int>("api/CrateClientTransactions/factory-balance");
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ في جلب البيانات: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    // ==========================================
    // معالجة حركات الصاجات والأسبتة
    // ==========================================
    private void OpenDispatchModal()
    {
        dispatchDto = new DispatchCrateDto
        {
            MovementType = "DISPATCH_BRANCH",
            ContainerName = lookups.Containers.FirstOrDefault()?.ContainerName ?? "صاج ألومنيوم 40×60",
            SourceLocation = "مخزن التعبئة المركزي",
            DestinationLocation = lookups.Warehouses.FirstOrDefault() ?? "فرع مصدق",
            DispatchedQuantity = 50,
            DispatchedByCode = State.EmployeeCode,
            DispatchedByName = State.FullName
        };
        showDispatchModal = true;
    }

    private async Task SubmitDispatch()
    {
        if (dispatchDto.DispatchedQuantity <= 0)
        {
            alertMessage = "يجب إدخال عدد صحيح أكبر من الصفر.";
            isSuccess = false;
            return;
        }

        isProcessing = true;
        try
        {
            dispatchDto.DispatchedByCode = State.EmployeeCode;
            dispatchDto.DispatchedByName = State.FullName;

            var res = await Http.PostAsJsonAsync("api/Crates/dispatch", dispatchDto);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = "تم إصدار إذن الصرف بنجاح وبانتظار تأكيد الاستلام من الطرف الثاني.";
                isSuccess = true;
                showDispatchModal = false;
                await LoadAllData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                alertMessage = $"فشل إصدار الإذن: {err}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void OpenReceiveModal(CrateMovementViewDto m)
    {
        selectedMovementToReceive = m;
        receiveDto = new ReceiveCrateDto
        {
            ActualReceivedQuantity = m.DispatchedQuantity,
            DamagedCount = 0,
            ReceivedByCode = State.EmployeeCode,
            ReceivedByName = State.FullName,
            ReceiveNotes = string.Empty
        };
    }

    private async Task SubmitReceive()
    {
        if (selectedMovementToReceive == null) return;

        isProcessing = true;
        try
        {
            receiveDto.ReceivedByCode = State.EmployeeCode;
            receiveDto.ReceivedByName = State.FullName;

            var res = await Http.PostAsJsonAsync($"api/Crates/movements/{selectedMovementToReceive.Id}/receive", receiveDto);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = "تم تأكيد الاستلام الميداني وتحديث الأرصدة بنجاح.";
                isSuccess = true;
                selectedMovementToReceive = null;
                await LoadAllData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                alertMessage = $"فشل تأكيد الاستلام: {err}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void OpenDisputeModal(CrateMovementViewDto m)
    {
        selectedMovementToDispute = m;
        disputeDto = new SettleDisputeDto
        {
            ArbitrationDecision = "تحميل غرامة مالية على السائق",
            FinancialPenalty = (m.ShortageQuantity + m.DamagedCount) * 150m,
            ArbitrationText = $"تسوية عجز ({m.ShortageQuantity}) وتالف ({m.DamagedCount}) صاج.",
            ArbitratedByCode = State.EmployeeCode,
            ArbitratedByName = State.FullName
        };
    }

    private async Task SubmitSettleDispute()
    {
        if (selectedMovementToDispute == null) return;

        isProcessing = true;
        try
        {
            disputeDto.ArbitratedByCode = State.EmployeeCode;
            disputeDto.ArbitratedByName = State.FullName;

            var res = await Http.PostAsJsonAsync($"api/Crates/movements/{selectedMovementToDispute.Id}/settle-dispute", disputeDto);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = "تم اعتماد قرار لجنة التحكيم وتسوية العهدة بنجاح.";
                isSuccess = true;
                selectedMovementToDispute = null;
                await LoadAllData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                alertMessage = $"فشل فض النزاع: {err}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    // ==========================================
    // معالجة عملاء التوزيع الخارجي
    // ==========================================
    private void ShowAddClientForm()
    {
        currentClient = new CrateClient();
        showClientForm = true;
    }

    private void EditClient(CrateClient client)
    {
        currentClient = new CrateClient { Id = client.Id, Name = client.Name, CrateBalance = client.CrateBalance };
        showClientForm = true;
    }

    private async Task SaveClient()
    {
        if (string.IsNullOrWhiteSpace(currentClient.Name))
        {
            alertMessage = "يرجى كتابة اسم العميل أولاً.";
            isSuccess = false;
            return;
        }

        try
        {
            HttpResponseMessage res;
            if (currentClient.Id == 0)
                res = await Http.PostAsJsonAsync("api/CrateClients", currentClient);
            else
                res = await Http.PutAsJsonAsync($"api/CrateClients/{currentClient.Id}", currentClient);

            if (res.IsSuccessStatusCode)
            {
                alertMessage = "تم حفظ بيانات العميل بنجاح.";
                isSuccess = true;
                showClientForm = false;
                await LoadAllData();
            }
            else
            {
                alertMessage = "رفض السيرفر الحفظ.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task DeleteClient(int id)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/CrateClients/{id}");
            if (res.IsSuccessStatusCode)
            {
                alertMessage = "تم حذف العميل بنجاح.";
                isSuccess = true;
                await LoadAllData();
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
    }

    private void ShowTransactionForm(CrateClient client)
    {
        selectedClient = client;
        newTransaction = new CrateClientTransaction
        {
            CrateClientId = client.Id,
            TransactionType = "منصرف للعميل",
            Quantity = 1
        };
        newTransactionDriver = string.Empty;
        showTransactionModal = true;
    }

    private async Task SaveTransaction()
    {
        if (newTransaction.Quantity <= 0)
        {
            alertMessage = "يجب إدخال كمية صحيحة أكبر من الصفر.";
            isSuccess = false;
            return;
        }

        isProcessing = true;
        try
        {
            var dto = new
            {
                CrateClientId = newTransaction.CrateClientId,
                TransactionType = newTransaction.TransactionType,
                Quantity = newTransaction.Quantity,
                DriverName = newTransactionDriver,
                Notes = newTransaction.Notes
            };

            var res = await Http.PostAsJsonAsync("api/CrateClientTransactions", dto);
            if (res.IsSuccessStatusCode)
            {
                alertMessage = "تم تسجيل وترصيد حركة الإسبات للعميل بنجاح.";
                isSuccess = true;
                showTransactionModal = false;
                await LoadAllData();
            }
            else
            {
                alertMessage = "حدث خطأ أثناء تسجيل الحركة في السيرفر.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ShowHistory(CrateClient client)
    {
        selectedClient = client;
        clientHistory = null;
        showHistoryModal = true;

        try
        {
            clientHistory = await Http.GetFromJsonAsync<List<CrateClientTransactionViewDto>>($"api/CrateClientTransactions/client/{client.Id}");
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ في جلب كشف الحساب: {ex.Message}";
            clientHistory = new();
        }
    }

    // ==========================================
    // كلاسات ونماذج العرض الميداني
    // ==========================================
    public class CrateLookupsDto
    {
        public List<ContainerLookupDto> Containers { get; set; } = new();
        public List<string> Departments { get; set; } = new();
        public List<string> Warehouses { get; set; } = new();
    }

    public class ContainerLookupDto
    {
        public long Id { get; set; }
        public string ContainerName { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public int TotalFactoryQuantity { get; set; }
    }

    public class CirculatingContainerViewDto
    {
        public long Id { get; set; }
        public string ContainerName { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public int TotalFactoryQuantity { get; set; }
        public int InPackagingWarehouseQuantity { get; set; }
        public int WithDriversAndBranchesQuantity { get; set; }
        public int DisputedQuantity { get; set; }
        public int DamagedQuantity { get; set; }
    }

    public class CrateMovementViewDto
    {
        public long Id { get; set; }
        public string MovementNumber { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public string MovementType { get; set; } = string.Empty;
        public string ContainerName { get; set; } = string.Empty;
        public int DispatchedQuantity { get; set; }
        public int ReceivedQuantity { get; set; }
        public int ShortageQuantity { get; set; }
        public int DamagedCount { get; set; }
        public string SourceLocation { get; set; } = string.Empty;
        public string DestinationLocation { get; set; } = string.Empty;
        public string DispatchedByCode { get; set; } = string.Empty;
        public string DispatchedByName { get; set; } = string.Empty;
        public string ReceivedByCode { get; set; } = string.Empty;
        public string ReceivedByName { get; set; } = string.Empty;
        public DateTime? ReceivedAt { get; set; }
        public string? ReceiveNotes { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? ArbitrationDecision { get; set; }
        public string? ArbitrationText { get; set; }
        public string? FinancialPenalty { get; set; }
    }

    public class DispatchCrateDto
    {
        public string MovementType { get; set; } = "DISPATCH_BRANCH";
        public string ContainerName { get; set; } = string.Empty;
        public int DispatchedQuantity { get; set; }
        public string SourceLocation { get; set; } = string.Empty;
        public string DestinationLocation { get; set; } = string.Empty;
        public string? DispatchedByCode { get; set; }
        public string? DispatchedByName { get; set; }
        public string? Notes { get; set; }
    }

    public class ReceiveCrateDto
    {
        public int ActualReceivedQuantity { get; set; }
        public int DamagedCount { get; set; }
        public string? ReceivedByCode { get; set; }
        public string? ReceivedByName { get; set; }
        public string? ReceiveNotes { get; set; }
    }

    public class SettleDisputeDto
    {
        public string ArbitrationDecision { get; set; } = string.Empty;
        public string ArbitrationText { get; set; } = string.Empty;
        public decimal FinancialPenalty { get; set; }
        public string? ArbitratedByCode { get; set; }
        public string? ArbitratedByName { get; set; }
    }

    public class CrateClient
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int CrateBalance { get; set; }
    }

    public class CrateClientTransaction
    {
        public int Id { get; set; }
        public int CrateClientId { get; set; }
        public string TransactionType { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public DateTime TransactionDate { get; set; }
        public string? Notes { get; set; }
    }

    public class CrateClientTransactionViewDto
    {
        public int Id { get; set; }
        public int CrateClientId { get; set; }
        public string ClientName { get; set; } = string.Empty;
        public string TransactionType { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public DateTime TransactionDate { get; set; }
        public string? Notes { get; set; }
        public string DriverName { get; set; } = string.Empty;
        public int ClientCurrentBalance { get; set; }
    }
}