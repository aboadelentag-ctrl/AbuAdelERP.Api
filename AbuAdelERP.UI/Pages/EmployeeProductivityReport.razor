@page "/productivity/employee-report"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container mt-4" dir="rtl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i> تقرير كفاءة وإنتاجية الموظف</h4>
        </div>
        <div class="card-body">

            <!-- قسم اختيار الموظف -->
            <div class="row align-items-end mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold">اختر الموظف:</label>
                    <select class="form-select" @bind="selectedEmployeeId">
                        <option value="0">-- الرجاء اختيار موظف --</option>
                        @if (employees != null)
                        {
                            @foreach (var emp in employees)
                            {
                                <option value="@emp.Id">@emp.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6 mt-3 mt-md-0 d-flex gap-2">
                    <button class="btn btn-primary px-4" @onclick="LoadReport" disabled="@(selectedEmployeeId == 0 || isLoading)">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        عرض التقرير
                    </button>

                    <button class="btn btn-success px-4" @onclick="DownloadExcel" disabled="@(selectedEmployeeId == 0 || reportData == null || isDownloading)">
                        @if (isDownloading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        <i class="bi bi-file-earmark-excel me-1"></i> تحميل إكسيل
                    </button>
                </div>
            </div>

            <!-- رسائل الخطأ -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <!-- عرض بطاقة التقرير -->
            @if (reportData != null && !isLoading)
            {
                <div class="card border-primary mb-3">
                    <div class="card-header bg-light">
                        <div class="row">
                            <div class="col-md-4"><strong>اسم الموظف:</strong> @reportData.EmployeeName</div>
                            <div class="col-md-4"><strong>كود الموظف:</strong> @reportData.EmployeeCode</div>
                            <div class="col-md-4"><strong>القسم:</strong> @reportData.Department</div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-3 mb-3">
                                <div class="p-3 border rounded bg-light">
                                    <h6 class="text-muted">أوامر الإنتاج المنفذة</h6>
                                    <h3 class="text-primary">@reportData.ProductivityReport.TotalOrdersExecuted</h3>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="p-3 border rounded bg-light">
                                    <h6 class="text-muted">الكمية الكلية المنتجة</h6>
                                    <h3 class="text-success">@reportData.ProductivityReport.TotalQuantityProduced <small class="fs-6">كجم</small></h3>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="p-3 border rounded bg-light">
                                    <h6 class="text-muted">ساعات العمل الكلية</h6>
                                    <h3 class="text-info">@reportData.ProductivityReport.TotalWorkingHours <small class="fs-6">ساعة</small></h3>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="p-3 border rounded bg-light">
                                    <h6 class="text-muted">معدل الإنتاج بالساعة</h6>
                                    <h3 class="text-warning">@reportData.ProductivityReport.ProductionPerHour <small class="fs-6">كجم/ساعة</small></h3>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        إجمالي الهالك
                                        <span class="badge bg-danger rounded-pill fs-6">@reportData.ProductivityReport.TotalWaste كجم</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        نسبة الهالك
                                        <span class="badge bg-warning text-dark rounded-pill fs-6">@reportData.ProductivityReport.WastePercentage</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6 mt-3 mt-md-0 text-center">
                                <h5 class="text-muted mb-2">التقييم الفني</h5>
                                @if (reportData.ProductivityReport.Evaluation.Contains("ممتاز"))
                                {
                                    <h4 class="text-success fw-bold"><i class="bi bi-star-fill text-warning"></i> @reportData.ProductivityReport.Evaluation</h4>
                                }
                                else if (reportData.ProductivityReport.Evaluation.Contains("يحتاج مراجعة"))
                                {
                                    <h4 class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> @reportData.ProductivityReport.Evaluation</h4>
                                }
                                else
                                {
                                    <h4 class="text-warning fw-bold">@reportData.ProductivityReport.Evaluation</h4>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<EmployeeLookupDto> employees;
    private long selectedEmployeeId = 0;
    private EmployeeReportResult reportData;

    private bool isLoading = false;
    private bool isDownloading = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // استدعاء الموظفين لملء القائمة المنسدلة
            employees = await Http.GetFromJsonAsync<List<EmployeeLookupDto>>("api/productivity/lookup/employees");
        }
        catch (Exception ex)
        {
            errorMessage = "حدث خطأ أثناء تحميل بيانات الموظفين.";
        }
    }

    private async Task LoadReport()
    {
        if (selectedEmployeeId == 0) return;

        isLoading = true;
        errorMessage = string.Empty;
        reportData = null;

        try
        {
            var response = await Http.GetAsync($"api/productivity/employee/{selectedEmployeeId}/report");
            if (response.IsSuccessStatusCode)
            {
                reportData = await response.Content.ReadFromJsonAsync<EmployeeReportResult>();

                // التأكد من أن الموظف لديه بيانات فعلاً
                if (!string.IsNullOrEmpty(reportData?.Message))
                {
                    errorMessage = reportData.Message;
                    reportData = null;
                }
            }
            else
            {
                errorMessage = "حدث خطأ أثناء جلب بيانات التقرير.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "فشل الاتصال بالخادم.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DownloadExcel()
    {
        if (selectedEmployeeId == 0) return;

        isDownloading = true;
        errorMessage = string.Empty;

        try
        {
            // استدعاء ملف الإكسيل كـ Byte Array من الـ API
            var response = await Http.GetAsync($"api/productivity/employee/{selectedEmployeeId}/export-excel");

            if (response.IsSuccessStatusCode)
            {
                var fileBytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(fileBytes);
                var fileName = $"ProductivityReport_Employee_{selectedEmployeeId}_{DateTime.Now:yyyyMMdd}.xlsx";

                // استدعاء دالة الجافاسكريبت لبدء التحميل في المتصفح
                await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
            }
            else
            {
                errorMessage = "حدث خطأ أثناء محاولة إنشاء ملف الإكسيل.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "فشل تحميل الملف.";
        }
        finally
        {
            isDownloading = false;
        }
    }

    // ==========================================
    // الكلاسات المساعدة (DTOs) الخاصة بالشاشة
    // ==========================================

    public class EmployeeLookupDto
    {
        public long Id { get; set; }
        public string Name { get; set; }
    }

    public class EmployeeReportResult
    {
        public string Message { get; set; } // في حالة وجود خطأ من السيرفر
        public string EmployeeName { get; set; }
        public string EmployeeCode { get; set; }
        public string Department { get; set; }
        public ProductivityReportDetails ProductivityReport { get; set; }
    }

    public class ProductivityReportDetails
    {
        public int TotalOrdersExecuted { get; set; }
        public decimal TotalQuantityProduced { get; set; }
        public decimal TotalWorkingHours { get; set; }
        public decimal ProductionPerHour { get; set; }
        public decimal TotalWaste { get; set; }
        public string WastePercentage { get; set; }
        public string Evaluation { get; set; }
    }
}