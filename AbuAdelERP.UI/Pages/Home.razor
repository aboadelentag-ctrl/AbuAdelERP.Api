@page "/"

<PageTitle>الرئيسية - حلواني أبو عادل</PageTitle>

<div class="container mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">لوحة تحكم الإنتاج</h2>
        <span class="badge bg-success fs-6">النظام متصل</span>
    </div>

    <p class="lead text-muted mb-5">مرحباً بك في نظام إدارة موارد مؤسسة حلواني أبو عادل (ERP). اختر القسم للمتابعة:</p>

    <div class="row g-4">
        <!-- قسم الشرقي والمخبوزات -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0 border-start border-primary border-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-primary">الشرقي والمخبوزات</h5>
                    <p class="card-text text-muted small">متابعة أوامر التشغيل وحساب إنتاجية العمال بالساعة.</p>
                    <a href="productivity" class="btn btn-outline-primary btn-sm w-100">عرض التفاصيل</a>
                </div>
            </div>
        </div>

        <!-- قسم الجاتوه والتورت -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0 border-start border-info border-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-info">الجاتوه والتورت</h5>
                    <p class="card-text text-muted small">متابعة معدلات سحب الخامات والإنتاج التام.</p>
                    <button class="btn btn-outline-info btn-sm w-100">عرض التفاصيل</button>
                </div>
            </div>
        </div>

        <!-- قسم الإسفنجي والنواشف -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0 border-start border-success border-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-success">الإسفنجي والنواشف</h5>
                    <p class="card-text text-muted small">تسجيل حركات الإنتاج ومطابقة معايير الجودة.</p>
                    <button class="btn btn-outline-success btn-sm w-100">عرض التفاصيل</button>
                </div>
            </div>
        </div>

        <!-- نظام حركة الإسبات -->
        <div class="col-md-6 mt-4">
            <div class="card shadow-sm h-100 border-0 bg-light">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-dark mb-1">إدارة حركة الإسبات</h5>
                        <p class="card-text text-muted small mb-0">تتبع أرصدة العهد البلاستيكية لدى العملاء والمصنع</p>
                    </div>
                    <a href="crates" class="btn btn-warning px-4 shadow">إدارة الأرصدة</a>
                </div>
            </div>
        </div>

        <!-- تقارير الإصلاح وخطة 2027 -->
        <div class="col-md-6 mt-4">
            <div class="card shadow-sm h-100 border-0 bg-dark text-white">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold mb-1">مشروع إصلاح الإنتاج</h5>
                        <p class="card-text text-light small mb-0">الخطة التفصيلية المرفوعة للإدارة العليا</p>
                    </div>
                    <button class="btn btn-light px-4">استعراض الخطة</button>
                </div>
            </div>
        </div>
    </div>
</div>