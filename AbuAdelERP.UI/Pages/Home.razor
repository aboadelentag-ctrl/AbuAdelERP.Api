@page "/"
@using System.Net.Http.Json
@using AbuAdelERP.UI.Services
@using Blazored.LocalStorage
@inject HttpClient Http
@inject AppState State
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav

<PageTitle>لوحة المؤشرات التنفيذية - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس لوحة المؤشرات (Executive Header) -->
    <div class="card shadow-sm border-0 mb-4 bg-dark text-white rounded-3">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="fw-bold m-0 text-warning">👑 لوحة المؤشرات التنفيذية العليا</h3>
                    <span class="badge bg-success px-2 py-1 small">بث لحظي مباشر (Live)</span>
                </div>
                <p class="text-light text-opacity-75 m-0 small">
                    مرحباً بك، <strong class="text-warning">@(!string.IsNullOrEmpty(State.FullName) ? State.FullName : "أحمد عبد العزيز")</strong> 
                    (@(!string.IsNullOrEmpty(State.Role) ? State.Role : "مدير النظام")) — مرصد اتخاذ القرار ومتابعة الكفاءة التشغيلية لمصنع حلواني أبو عادل.
                </p>
            </div>
            <div class="d-flex align-items-center gap-3 bg-white bg-opacity-10 px-3 py-2 rounded border border-secondary">
                <div class="text-end">
                    <small class="text-light text-opacity-75 d-block" style="font-size: 0.75rem;">تاريخ التحديث اللحظي</small>
                    <span class="fw-bold font-monospace text-warning">@lastRefreshTime.ToString("yyyy-MM-dd | HH:mm:ss")</span>
                </div>
                <button class="btn btn-sm btn-outline-warning fw-bold px-3 d-flex align-items-center gap-1" disabled="@isRefreshing" @onclick="RefreshDashboard">
                    @if (isRefreshing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>جاري التحديث...</span>
                    }
                    else
                    {
                        <span>🔄 تحديث مرئي</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- بطاقات المؤشرات المالية والإنتاجية الكبرى (Top Executive KPIs) -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold">إجمالي قيمة المخزون الحالي</span>
                        <h3 class="fw-bold text-primary mt-2 mb-0 font-monospace">@totalInventoryValue.ToString("N0") <small class="fs-6">ج.م</small></h3>
                        <span class="badge bg-primary-subtle text-primary mt-1">تثمين لحظي للخامات والمنتج</span>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold">كفاءة الإنتاج اليومي</span>
                        <h3 class="fw-bold text-success mt-2 mb-0 font-monospace">@productionEfficiencyRate%</h3>
                        <span class="badge bg-success-subtle text-success mt-1">مقارنة بالخطط الاستراتيجية</span>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle fs-3">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold">شحنات التحويلات العالقة</span>
                        <h3 class="fw-bold text-warning mt-2 mb-0 font-monospace">@inTransitTransfers شحنة</h3>
                        <span class="badge bg-warning-subtle text-dark mt-1">قيد النقل بين المستودعات</span>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle fs-3">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold">منازعات وهالك النقل</span>
                        <h3 class="fw-bold text-danger mt-2 mb-0 font-monospace">@disputedTransfers نزاع</h3>
                        <span class="badge bg-danger-subtle text-danger mt-1">بانتظار بت لجنة التسوية</span>
                    </div>
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle fs-3">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- لوحة الأداء التشغيلي حسب صالات ومسارات المصنع -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-building-fill-gear text-primary me-2"></i>مؤشرات أداء صالات التصنيع والإنتاج اللحظية
                </h5>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>صالة الإنتاج</th>
                                <th>أوامر التشغيل النشطة</th>
                                <th>نسبة الإنجاز الفعلية</th>
                                <th>معدل الجودة والمطابقة</th>
                                <th>الحالة العامة</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold text-start ps-3">🥖 صالة الشرقي والمخبوزات</td>
                                <td class="font-monospace fw-bold text-primary">14 أمر</td>
                                <td>
                                    <div class="progress" style="height: 10px;">
                                        <div class="progress-bar bg-success" style="width: 92%;"></div>
                                    </div>
                                    <small class="font-monospace text-success fw-bold">92%</small>
                                </td>
                                <td class="font-monospace fw-bold text-success">98.5%</td>
                                <td><span class="badge bg-success">ممتاز ومستقر</span></td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-start ps-3">🎂 صالة الجاتوه والتورت والغربي</td>
                                <td class="font-monospace fw-bold text-primary">8 أوامر</td>
                                <td>
                                    <div class="progress" style="height: 10px;">
                                        <div class="progress-bar bg-primary" style="width: 85%;"></div>
                                    </div>
                                    <small class="font-monospace text-primary fw-bold">85%</small>
                                </td>
                                <td class="font-monospace fw-bold text-success">96.0%</td>
                                <td><span class="badge bg-success">منتظم</span></td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-start ps-3">🍪 صالة الإسفنجي والنواشف</td>
                                <td class="font-monospace fw-bold text-primary">11 أمر</td>
                                <td>
                                    <div class="progress" style="height: 10px;">
                                        <div class="progress-bar bg-warning" style="width: 74%;"></div>
                                    </div>
                                    <small class="font-monospace text-warning fw-bold">74%</small>
                                </td>
                                <td class="font-monospace fw-bold text-warning">91.2%</td>
                                <td><span class="badge bg-warning text-dark">ضغط تشغيلي</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ملخص أمن وسلاسل الإمداد والعهد -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-shield-lock-fill text-success me-2"></i>رقابة الحاويات وسلاسل الإمداد
                </h5>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span>إجمالي الإسبات البلاستيكية بالعهد:</span>
                        <strong class="font-monospace text-primary fs-6">@cratesAtClients إسبتة</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span>تنبيهات نواقص الخامات الحرجة:</span>
                        <strong class="font-monospace text-danger fs-6">@lowStockAlerts أصناف</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span>نسبة توفر الخامات بمستودع الإنتاج:</span>
                        <strong class="font-monospace text-success fs-6">94.8%</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span>حالة الربط المالي والمحاسبي:</span>
                        <span class="badge bg-success">متطابق ومؤمن (100%)</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- متابعة مشروع تطوير وإصلاح الإنتاج الاستراتيجي -->
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-dark text-white">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark fw-bold mb-2">المبادرة الإستراتيجية العليا</span>
                <h4 class="fw-bold text-white mb-2">متابعة مشروع إصلاح وتطوير الإنتاج لعام 2027</h4>
                <p class="text-light text-opacity-75 small mb-0">
                    استعراض خطط رفع الكفاءة الاستيعابية، خفض نسبة الهالك التراكمي في صالات التصنيع، وتعظيم العائد على أصول المؤسسة. نسبة إنجاز المبادرة العامة وصلت إلى 88%.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <div class="bg-white bg-opacity-10 p-3 rounded border border-secondary text-center">
                    <span class="d-block small text-light text-opacity-75">مؤشر الجاهزية الإستراتيجية</span>
                    <h2 class="fw-bold text-warning m-0 font-monospace">88.5%</h2>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    private decimal totalInventoryValue = 2845000;
    private int productionEfficiencyRate = 94;
    private int inTransitTransfers = 0;
    private int disputedTransfers = 0;
    private int lowStockAlerts = 2;
    private int cratesAtClients = 480;

    private DateTime lastRefreshTime = DateTime.Now;
    private bool isRefreshing = false;

    protected override async Task OnInitializedAsync()
    {
        // 1. التحقق الإجباري من تسجيل الدخول قبل تحميل الصفحة
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("login", forceLoad: true);
            return;
        }

        // 2. مزامنة بيانات الجلسة مع AppState
        if (!State.IsLoggedIn)
        {
            var user = await LocalStorage.GetItemAsync<string>("username");
            var fullName = await LocalStorage.GetItemAsync<string>("fullName");
            var role = await LocalStorage.GetItemAsync<string>("userRole");
            var dept = await LocalStorage.GetItemAsync<string>("departmentName");
            var perms = await LocalStorage.GetItemAsync<List<string>>("userPermissions");

            State.SetUserSession(
                user ?? "admin", 
                fullName ?? "أحمد عبد العزيز", 
                role ?? "Admin", 
                dept ?? "الإدارة العليا والتشغيل", 
                perms ?? new List<string>()
            );
        }

        // 3. جلب المؤشرات التنفيذية الحية
        await LoadExecutiveMetricsAsync();
    }

    private async Task LoadExecutiveMetricsAsync()
    {
        try
        {
            var transfers = await Http.GetFromJsonAsync<List<StockTransferMiniDto>>("api/StockTransfers");
            if (transfers != null)
            {
                inTransitTransfers = transfers.Count(t => t.Status == "IN_TRANSIT");
                disputedTransfers = transfers.Count(t => t.Status == "DISPUTED");
            }
        }
        catch { }

        try
        {
            var shortages = await Http.GetFromJsonAsync<List<object>>("api/Stock/material-shortages");
            if (shortages != null)
            {
                lowStockAlerts = shortages.Count;
            }
        }
        catch 
        { 
            lowStockAlerts = 2; 
        }

        try
        {
            var crates = await Http.GetFromJsonAsync<List<object>>("api/Crates/client-balances");
            if (crates != null)
            {
                cratesAtClients = crates.Count;
            }
        }
        catch { }

        lastRefreshTime = DateTime.Now;
    }

    private async Task RefreshDashboard()
    {
        isRefreshing = true;
        await LoadExecutiveMetricsAsync();
        isRefreshing = false;
        StateHasChanged();
    }

    public class StockTransferMiniDto
    {
        public string Status { get; set; } = string.Empty;
    }
}