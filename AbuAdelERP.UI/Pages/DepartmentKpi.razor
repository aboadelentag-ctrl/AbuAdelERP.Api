@page "/department-kpi"
@inject HttpClient Http
@using System.Net.Http.Json

<div class="container-fluid mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="text-primary m-0 mb-1">🎯 لوحة مؤشرات الأداء (KPIs) للأقسام</h3>
            <span class="text-muted">مراقبة حية لكفاءة الإنتاج ونسب الهالك لكل قسم تشغيلي</span>
        </div>
        <button class="btn btn-outline-primary fw-bold shadow-sm" @onclick="LoadKpiData">
            🔄 تحديث المؤشرات
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger fw-bold shadow-sm mb-3">❌ @errorMessage</div>
    }

    <!-- فلاتر سريعة للمؤشرات -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <div class="row align-items-end">
                <div class="col-md-4 mb-2 mb-md-0">
                    <label class="form-label fw-bold small text-secondary">تحليل الأداء للفترة من</label>
                    <input type="date" class="form-control border-primary fw-bold" @bind="startDate" />
                </div>
                <div class="col-md-4 mb-2 mb-md-0">
                    <label class="form-label fw-bold small text-secondary">إلى تاريخ</label>
                    <input type="date" class="form-control border-primary fw-bold" @bind="endDate" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary fw-bold w-100 shadow" @onclick="LoadKpiData">📊 تطبيق الفلتر</button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-5 text-center text-primary fw-bold">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            ⏳ جاري حساب الكفاءة والمؤشرات...
        </div>
    }
    else
    {
        <!-- مؤشر الكفاءة العام للمصنع -->
        <div class="card border-0 shadow-lg mb-5 bg-primary text-white" style="border-radius: 15px;">
            <div class="card-body p-4 text-center">
                <h5 class="fw-bold mb-3">متوسط الكفاءة العامة للمصنع</h5>
                <div class="display-3 fw-bold mb-2">@summaryKpi.AverageEfficiency%</div>
                <div class="d-flex justify-content-center gap-4 mt-3">
                    <div class="bg-white bg-opacity-25 px-4 py-2 rounded">
                        <span class="d-block small">الأوامر المنجزة</span>
                        <span class="fw-bold fs-5">@summaryKpi.TotalCompletedOrders أمر</span>
                    </div>
                    <div class="bg-white bg-opacity-25 px-4 py-2 rounded">
                        <span class="d-block small">إجمالي الهالك</span>
                        <span class="fw-bold fs-5 text-warning">@summaryKpi.TotalWaste كجم</span>
                    </div>
                    <div class="bg-white bg-opacity-25 px-4 py-2 rounded">
                        <span class="d-block small">ساعات التشغيل</span>
                        <span class="fw-bold fs-5">@summaryKpi.TotalWorkingHours ساعة</span>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">🏢 كفاءة الأقسام التشغيلية (تفصيلي)</h5>

        @if (!departmentEfficiencies.Any())
        {
            <div class="alert alert-warning text-center fw-bold shadow-sm">
                ⚠️ لا توجد أوامر تشغيل مكتملة في هذه الفترة لحساب كفاءة الأقسام.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var dept in departmentEfficiencies)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm border-0 border-top border-4 @(dept.EfficiencyPercentage >= 90 ? "border-success" : (dept.EfficiencyPercentage >= 75 ? "border-warning" : "border-danger"))">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold text-dark m-0">@dept.DepartmentName</h5>
                                    @if (dept.EfficiencyPercentage >= 90)
                                    {
                                        <span class="badge bg-success">ممتاز</span>
                                    }
                                    else if (dept.EfficiencyPercentage >= 75)
                                    {
                                        <span class="badge bg-warning text-dark">مقبول</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">حرج</span>
                                    }
                                </div>

                                <div class="mb-4 text-center">
                                    <div class="display-5 fw-bold @(dept.EfficiencyPercentage >= 90 ? "text-success" : (dept.EfficiencyPercentage >= 75 ? "text-warning" : "text-danger"))">
                                        @dept.EfficiencyPercentage%
                                    </div>
                                    <span class="text-muted small fw-bold">نسبة الكفاءة</span>
                                </div>

                                <div class="progress mb-3 shadow-sm" style="height: 15px; border-radius: 10px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated @(dept.EfficiencyPercentage >= 90 ? "bg-success" : (dept.EfficiencyPercentage >= 75 ? "bg-warning" : "bg-danger"))"
                                         role="progressbar"
                                         style="width: @(dept.EfficiencyPercentage > 100 ? 100 : dept.EfficiencyPercentage)%;"
                                         aria-valuenow="@dept.EfficiencyPercentage" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>

                                <div class="row text-center mt-4">
                                    <div class="col-4 border-end">
                                        <span class="d-block text-muted small fw-bold">المخطط</span>
                                        <span class="fw-bold text-dark">@dept.TotalPlanned</span>
                                    </div>
                                    <div class="col-4 border-end">
                                        <span class="d-block text-muted small fw-bold">المنفذ</span>
                                        <span class="fw-bold text-success">@dept.TotalProduced</span>
                                    </div>
                                    <div class="col-4">
                                        <span class="d-block text-muted small fw-bold">الهالك</span>
                                        <span class="fw-bold text-danger">@dept.TotalWaste</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private string errorMessage = "";

    // افتراضياً: نجلب بيانات الشهر الحالي
    private DateOnly startDate = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateOnly endDate = DateOnly.FromDateTime(DateTime.Now);

    private List<DepartmentEfficiencyDto> departmentEfficiencies = new();
    private KpiSummaryDto summaryKpi = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadKpiData();
    }

    private async Task LoadKpiData()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            // نستخدم نفس الـ API الخاص بالتقارير لأن الحسابات واحدة (DepartmentId = 0 لجلب جميع الأقسام دائماً)
            string url = $"api/Reports/efficiency?startDate={startDate:yyyy-MM-dd}&endDate={endDate:yyyy-MM-dd}&departmentId=0";
            var result = await Http.GetFromJsonAsync<ReportResultDto>(url);

            if (result != null)
            {
                summaryKpi = result.Summary;
                departmentEfficiencies = result.DepartmentEfficiencies;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "حدث خطأ أثناء الاتصال بالخادم لجلب مؤشرات الأداء.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ==========================================
    // DTOs (متطابقة مع الـ ReportsController)
    // ==========================================
    public class ReportResultDto
    {
        public KpiSummaryDto Summary { get; set; } = new();
        public List<DepartmentEfficiencyDto> DepartmentEfficiencies { get; set; } = new();
    }

    public class KpiSummaryDto
    {
        public int TotalCompletedOrders { get; set; }
        public decimal AverageEfficiency { get; set; }
        public decimal TotalWaste { get; set; }
        public decimal TotalWorkingHours { get; set; }
    }

    public class DepartmentEfficiencyDto
    {
        public string DepartmentName { get; set; } = string.Empty;
        public decimal TotalPlanned { get; set; }
        public decimal TotalProduced { get; set; }
        public decimal EfficiencyPercentage { get; set; }
        public decimal TotalWaste { get; set; }
    }
}