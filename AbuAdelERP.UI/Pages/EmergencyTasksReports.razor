@page "/emergency-tasks-reports"
@using System.Net.Http.Json
@using System.Text
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>تقارير ومؤشرات أداء المهام الطارئة - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة وأزرار التصدير والطباعة -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold m-0 text-warning">📊 تقارير ومؤشرات قياس أداء الاستجابة الطارئة (SLA Analytics)</h4>
                <small class="text-light text-opacity-75">
                    تحليل معدلات الالتزام الزمني، سرعة استجابة الأقسام، وسجل أداء الفنيين في حل الأعطال وملاحظات الجودة والنظافة.
                </small>
            </div>
            <div class="d-flex gap-2">
                <a href="emergency-tasks" class="btn btn-outline-light btn-sm fw-bold px-3 py-2 shadow-sm">
                    🚨 العودة لغرفة العمليات
                </a>
                <button class="btn btn-outline-success btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="ExportToExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل
                </button>
                <button class="btn btn-primary btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="PrintReportAsync">
                    <i class="bi bi-printer me-1"></i> طباعة التقرير
                </button>
            </div>
        </div>
    </div>

    <!-- شريط فلاتر الفترة والأقسام -->
    <div class="card shadow-sm border-0 mb-3 bg-white">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">من تاريخ:</label>
                    <input type="date" class="form-control form-control-sm" @bind="fromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">إلى تاريخ:</label>
                    <input type="date" class="form-control form-control-sm" @bind="toDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">القسم المسؤول:</label>
                    <select class="form-select form-select-sm" @bind="targetDeptFilter">
                        <option value="">-- كل الإدارات المسؤولة --</option>
                        @foreach (var d in distinctTargetDepartments)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-sm w-100 fw-bold" @onclick="ResetFilters">🔄 إعادة ضبط الفلاتر</button>
                </div>
            </div>
        </div>
    </div>

    <!-- بطاقات مؤشرات الأداء الحيوية (KPIs) -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-primary border-4">
                <small class="text-muted fw-bold">إجمالي البلاغات المسجلة</small>
                <h3 class="fw-bold text-primary mt-1 mb-0 font-monospace">@FilteredTasks.Count() بلاغ</h3>
                <small class="text-muted">مكتمل: @FilteredTasks.Count(t => t.Status == "CLOSED") | معلق: @FilteredTasks.Count(t => t.Status != "CLOSED")</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-success border-4">
                <small class="text-muted fw-bold">نسبة الالتزام بالمهلة (SLA)</small>
                <h3 class="fw-bold text-success mt-1 mb-0 font-monospace">@CalculateSlaRate()%</h3>
                <small class="text-success">منجز في الموعد: @CountOnTimeTasks() بلاغ</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-warning border-4">
                <small class="text-muted fw-bold">متوسط وقت الإنجاز الفعلي</small>
                <h3 class="fw-bold text-warning mt-1 mb-0 font-monospace">@CalculateAvgResolutionTime() دقيقة</h3>
                <small class="text-muted">لجميع المهام المغلقة والمؤكدة</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-danger border-4">
                <small class="text-muted fw-bold">بلاغات متأخرة عن وقتها</small>
                <h3 class="fw-bold text-danger mt-1 mb-0 font-monospace">@CountOverdueTasks() بلاغ</h3>
                <small class="text-danger">تجاوزت المهلة المستهدفة</small>
            </div>
        </div>
    </div>

    <!-- جدول تقرير كفاءة الإدارات والأقسام -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-header bg-white py-2">
            <h6 class="fw-bold text-dark m-0">🏢 تقرير كفاءة الإدارات المسؤولة وسرعة استجابتها</h6>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-bordered table-striped mb-0 text-center align-middle small">
                <thead class="table-light">
                    <tr>
                        <th>الإدارة المسؤولة</th>
                        <th>البلاغات الواردة</th>
                        <th>المنجز بالدليل</th>
                        <th>قيد التنفيذ / معلق</th>
                        <th>المنجز في الموعد المحدد</th>
                        <th>المتأخر عن المهلة</th>
                        <th>متوسط وقت الحل</th>
                        <th>معدل الالتزام</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var deptGroup in GetDepartmentAnalytics())
                    {
                        <tr>
                            <td class="fw-bold text-start ps-3">@deptGroup.DepartmentName</td>
                            <td class="font-monospace fw-bold">@deptGroup.TotalReceived</td>
                            <td class="text-success font-monospace fw-bold">@deptGroup.CompletedCount</td>
                            <td class="text-warning font-monospace fw-bold">@deptGroup.PendingCount</td>
                            <td class="text-success font-monospace">@deptGroup.OnTimeCount</td>
                            <td class="text-danger font-monospace fw-bold">@deptGroup.OverdueCount</td>
                            <td class="font-monospace">@deptGroup.AvgResolutionMinutes دقيقة</td>
                            <td>
                                <div class="progress" style="height: 18px;">
                                    <div class="progress-bar @(deptGroup.SlaRate >= 80 ? "bg-success" : deptGroup.SlaRate >= 50 ? "bg-warning text-dark" : "bg-danger") fw-bold" 
                                         role="progressbar" 
                                         style="width: @deptGroup.SlaRate%;">
                                        @deptGroup.SlaRate%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- جدول السجل التاريخي التفصيلي الشامل مع حساب التوقيتات -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-dark m-0">📜 السجل التاريخي التفصيلي لحساب أوقات الإنجاز</h6>
            <span class="badge bg-secondary font-monospace">@FilteredTasks.Count() بلاغ</span>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                <thead class="table-dark">
                    <tr>
                        <th>رقم البلاغ</th>
                        <th>عنوان المهمة</th>
                        <th>القسم الطالب</th>
                        <th>القسم المسؤول / الفني</th>
                        <th>تاريخ الإطلاق</th>
                        <th>المهلة المحددة</th>
                        <th>وقت الإغلاق</th>
                        <th>الزمن المستغرق فعلياً</th>
                        <th>تقييم الالتزام (SLA)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredTasks.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-muted py-4 fw-bold">لا توجد سجلات مطابقة للفترة المحددة.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in FilteredTasks)
                        {
                            var hasCompleted = t.CompletedAt.HasValue;
                            var durationMinutes = hasCompleted ? (int)(t.CompletedAt!.Value - t.CreatedAt).TotalMinutes : 0;
                            var isOverdue = hasCompleted ? durationMinutes > t.TargetResolutionMinutes : (DateTime.UtcNow - t.CreatedAt).TotalMinutes > t.TargetResolutionMinutes;

                            <tr>
                                <td class="font-monospace fw-bold text-primary">@t.TaskNumber</td>
                                <td class="fw-bold text-start ps-2">@t.Title</td>
                                <td>@t.SenderDepartment</td>
                                <td class="text-start ps-2">
                                    <div>@t.TargetDepartment</div>
                                    @if (!string.IsNullOrEmpty(t.AssignedTechnicianName))
                                    {
                                        <small class="text-muted">المنفذ: @t.AssignedTechnicianName</small>
                                    }
                                </td>
                                <td class="font-monospace">@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="font-monospace">@t.TargetResolutionMinutes دقيقة</td>
                                <td class="font-monospace">@(t.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "قيد التنفيذ")</td>
                                <td class="font-monospace fw-bold @(hasCompleted ? (durationMinutes <= t.TargetResolutionMinutes ? "text-success" : "text-danger") : "text-muted")">
                                    @(hasCompleted ? $"{durationMinutes} دقيقة" : "-")
                                </td>
                                <td>
                                    @if (t.Status == "CLOSED")
                                    {
                                        if (durationMinutes <= t.TargetResolutionMinutes)
                                        {
                                            <span class="badge bg-success">منجز في الموعد ✓</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">تأخر (@(durationMinutes - t.TargetResolutionMinutes) دقيقة)</span>
                                        }
                                    }
                                    else
                                    {
                                        if (isOverdue)
                                        {
                                            <span class="badge bg-danger animate-pulse">تجاوز المهلة! ⚠️</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">جارٍ في المهلة</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@code {
    public class EmergencyTaskDto
    {
        public long Id { get; set; }
        public string? TaskNumber { get; set; }
        public string Title { get; set; } = string.Empty;
        public string SenderDepartment { get; set; } = string.Empty;
        public string SenderEmployeeName { get; set; } = string.Empty;
        public string TargetDepartment { get; set; } = string.Empty;
        public string? TargetEmployeeName { get; set; }
        public string? AssignedTechnicianName { get; set; }
        public string Priority { get; set; } = "NORMAL";
        public DateTime CreatedAt { get; set; }
        public int TargetResolutionMinutes { get; set; } = 30;
        public DateTime? RespondedAt { get; set; }
        public DateTime? CompletedAt { get; set; }
        public string Status { get; set; } = "PENDING";
        public string? ClosureNotes { get; set; }
        public string? ClosedBy { get; set; }
    }

    public class DepartmentAnalyticsDto
    {
        public string DepartmentName { get; set; } = string.Empty;
        public int TotalReceived { get; set; }
        public int CompletedCount { get; set; }
        public int PendingCount { get; set; }
        public int OnTimeCount { get; set; }
        public int OverdueCount { get; set; }
        public int AvgResolutionMinutes { get; set; }
        public int SlaRate { get; set; }
    }

    private List<EmergencyTaskDto> allTasks = new();
    private DateTime? fromDate;
    private DateTime? toDate;
    private string targetDeptFilter = "";
    private List<string> distinctTargetDepartments = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadReportData();
    }

    private async Task LoadReportData()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<EmergencyTaskDto>>("api/EmergencyTasks");
            if (res != null)
            {
                allTasks = res;
                distinctTargetDepartments = allTasks.Select(t => t.TargetDepartment).Where(d => !string.IsNullOrEmpty(d)).Distinct().ToList();
            }
        }
        catch { }
    }

    private IEnumerable<EmergencyTaskDto> FilteredTasks
    {
        get
        {
            var list = allTasks.AsEnumerable();

            if (fromDate.HasValue)
            {
                list = list.Where(t => t.CreatedAt.Date >= fromDate.Value.Date);
            }

            if (toDate.HasValue)
            {
                list = list.Where(t => t.CreatedAt.Date <= toDate.Value.Date);
            }

            if (!string.IsNullOrEmpty(targetDeptFilter))
            {
                list = list.Where(t => t.TargetDepartment == targetDeptFilter);
            }

            return list;
        }
    }

    private void ResetFilters()
    {
        fromDate = null;
        toDate = null;
        targetDeptFilter = "";
    }

    private int CountOnTimeTasks()
    {
        return FilteredTasks.Count(t => t.CompletedAt.HasValue && (t.CompletedAt.Value - t.CreatedAt).TotalMinutes <= t.TargetResolutionMinutes);
    }

    private int CountOverdueTasks()
    {
        return FilteredTasks.Count(t =>
            (t.CompletedAt.HasValue && (t.CompletedAt.Value - t.CreatedAt).TotalMinutes > t.TargetResolutionMinutes) ||
            (!t.CompletedAt.HasValue && (DateTime.UtcNow - t.CreatedAt).TotalMinutes > t.TargetResolutionMinutes));
    }

    private int CalculateSlaRate()
    {
        var completed = FilteredTasks.Where(t => t.CompletedAt.HasValue).ToList();
        if (!completed.Any()) return 100;
        var onTime = completed.Count(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes <= t.TargetResolutionMinutes);
        return (int)Math.Round((double)onTime / completed.Count * 100);
    }

    private int CalculateAvgResolutionTime()
    {
        var completed = FilteredTasks.Where(t => t.CompletedAt.HasValue).ToList();
        if (!completed.Any()) return 0;
        var avg = completed.Average(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes);
        return (int)Math.Round(avg);
    }

    private List<DepartmentAnalyticsDto> GetDepartmentAnalytics()
    {
        var list = new List<DepartmentAnalyticsDto>();
        var depts = FilteredTasks.Select(t => t.TargetDepartment).Distinct().ToList();

        foreach (var d in depts)
        {
            var dTasks = FilteredTasks.Where(t => t.TargetDepartment == d).ToList();
            var dCompleted = dTasks.Where(t => t.CompletedAt.HasValue).ToList();
            var onTime = dCompleted.Count(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes <= t.TargetResolutionMinutes);
            var overdue = dTasks.Count(t => 
                (t.CompletedAt.HasValue && (t.CompletedAt.Value - t.CreatedAt).TotalMinutes > t.TargetResolutionMinutes) ||
                (!t.CompletedAt.HasValue && (DateTime.UtcNow - t.CreatedAt).TotalMinutes > t.TargetResolutionMinutes));

            var avgMins = dCompleted.Any() ? (int)Math.Round(dCompleted.Average(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes)) : 0;
            var sla = dCompleted.Any() ? (int)Math.Round((double)onTime / dCompleted.Count * 100) : 100;

            list.Add(new DepartmentAnalyticsDto
            {
                DepartmentName = d,
                TotalReceived = dTasks.Count,
                CompletedCount = dCompleted.Count,
                PendingCount = dTasks.Count - dCompleted.Count,
                OnTimeCount = onTime,
                OverdueCount = overdue,
                AvgResolutionMinutes = avgMins,
                SlaRate = sla
            });
        }

        return list.OrderByDescending(x => x.TotalReceived).ToList();
    }

    private async Task ExportToExcelAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine("رقم_البلاغ,عنوان_المهمة,القسم_الطالب,القسم_المسؤول,الفني_المكلف,تاريخ_الإطلاق,المهلة_بالدقائق,تاريخ_الإغلاق,المدة_الفعلية_بالدقائق,الحالة,تقييم_الالتزام");

        foreach (var t in FilteredTasks)
        {
            var dur = t.CompletedAt.HasValue ? (int)(t.CompletedAt.Value - t.CreatedAt).TotalMinutes : 0;
            var eval = t.CompletedAt.HasValue ? (dur <= t.TargetResolutionMinutes ? "في الموعد" : "متأخر") : "قيد المعالجة";

            sb.AppendLine($"\"{t.TaskNumber}\",\"{t.Title}\",\"{t.SenderDepartment}\",\"{t.TargetDepartment}\",\"{t.AssignedTechnicianName}\",\"{t.CreatedAt:yyyy-MM-dd HH:mm}\",{t.TargetResolutionMinutes},\"{t.CompletedAt?.ToString("yyyy-MM-dd HH:mm")}\",{dur},\"{t.Status}\",\"{eval}\"");
        }

        var fileName = $"تقرير_أوقات_المهام_الطارئة_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        var utf8WithBom = "\uFEFF" + sb.ToString();
        var js = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", js);
    }

    private async Task PrintReportAsync()
    {
        await JS.InvokeVoidAsync("eval", "window.print();");
    }
}