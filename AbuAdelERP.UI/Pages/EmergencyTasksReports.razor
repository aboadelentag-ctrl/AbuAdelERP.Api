@page "/emergency-tasks-reports"
@using System.Net.Http.Json
@using AbuAdelERP.UI.Services
@using Blazored.LocalStorage
@inject HttpClient Http
@inject AppState State
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>غرفة عمليات المهام الطارئة (SOS) - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-3 py-3" dir="rtl">

    <!-- رأس الصفحة التنفيذي -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-danger">🚨 غرفة عمليات المهام الطارئة والاستجابة السريعة (SOS)</h4>
                    <span class="badge bg-danger px-2 py-1 small">بث لحظي مباشر</span>
                </div>
                <small class="text-light text-opacity-75">
                    إدارة بلاغات الصيانة، نظافة الصالات (GMP/ISO)، ومخالفات الجودة مع التكليف الفوري والإغلاق المشروط بالدليل المصور.
                </small>
            </div>
            <div class="d-flex gap-2">
                <AuthorizePermission Permission="Emergency.Reports">
                    <a href="emergency-tasks-reports" class="btn btn-outline-warning btn-sm fw-bold px-3 py-2 shadow-sm">
                        📊 تقارير ومؤشرات الإنجاز (SLA)
                    </a>
                </AuthorizePermission>

                <AuthorizePermission Permission="Emergency.Create">
                    <button class="btn btn-danger fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenNewTaskModal">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>إطلاق بلاغ طارئ جديد (SOS)</span>
                    </button>
                </AuthorizePermission>
            </div>
        </div>
    </div>

    <!-- رسائل التنبيه والنجاح -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccessMessage ? "alert-success" : "alert-danger") py-2 small fw-bold alert-dismissible fade show shadow-sm" role="alert">
            @statusMessage
            <button type="button" class="btn-close py-2" @onclick='() => statusMessage = ""'></button>
        </div>
    }

    <!-- كروت إحصائيات البلاغات السريعة -->
    <div class="row g-2 mb-3">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-top border-danger border-4 text-center">
                <small class="text-muted fw-bold d-block">جديدة (بانتظار الإجراء)</small>
                <h3 class="fw-bold text-danger mt-1 mb-0 font-monospace">@tasksList.Count(t => t.Status == "NEW" || t.Status == "PENDING") <span class="fs-6">بلاغ</span></h3>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-top border-primary border-4 text-center">
                <small class="text-muted fw-bold d-block">محالة ومكلفة لفني</small>
                <h3 class="fw-bold text-primary mt-1 mb-0 font-monospace">@tasksList.Count(t => t.Status == "ASSIGNED") <span class="fs-6">بلاغ</span></h3>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-top border-warning border-4 text-center">
                <small class="text-muted fw-bold d-block">قيد التنفيذ الميداني</small>
                <h3 class="fw-bold text-warning mt-1 mb-0 font-monospace">@tasksList.Count(t => t.Status == "IN_PROGRESS") <span class="fs-6">بلاغ</span></h3>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-top border-success border-4 text-center">
                <small class="text-muted fw-bold d-block">مغلقة ومؤكدة بالدليل</small>
                <h3 class="fw-bold text-success mt-1 mb-0 font-monospace">@tasksList.Count(t => t.Status == "CLOSED") <span class="fs-6">بلاغ</span></h3>
            </div>
        </div>
    </div>

    <!-- شريط البحث والتصفية -->
    <div class="card shadow-sm border-0 mb-3 bg-white rounded-3">
        <div class="card-body p-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 500px;">
                <input type="text" class="form-control form-control-sm" placeholder="بحث برقم البلاغ، العنوان، الموظف، أو التفاصيل..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" @bind="statusFilter" style="width: 160px;">
                    <option value="">-- كل الحالات --</option>
                    <option value="NEW">جديد (بانتظار الإجراء)</option>
                    <option value="ASSIGNED">محال لفني</option>
                    <option value="IN_PROGRESS">قيد التنفيذ</option>
                    <option value="CLOSED">مغلق بالدليل</option>
                </select>
                <button class="btn btn-outline-secondary btn-sm fw-bold px-3" @onclick="LoadTasks">🔄 تحديث السجل</button>
            </div>
        </div>
    </div>

    <!-- جدول البلاغات الحية مع تطبيق قواعد الرقابة وفصل المهام -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-dark m-0">📋 سجل بلاغات الأقسام (المعروض: @FilteredTasks.Count())</h6>
            <small class="text-muted">محددة وفق هوية المستخدم وصلاحياته الميدانية</small>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered table-sm mb-0 text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>رقم البلاغ</th>
                        <th>عنوان المشكلة</th>
                        <th>الجهة الطالبة / الراسل</th>
                        <th>القسم المسؤول / الفني المكلف</th>
                        <th>الأولوية</th>
                        <th>التوقيت والمهلة</th>
                        <th>الحالة</th>
                        <th style="min-width: 220px;">إجراءات التكليف والاستجابة الرقابية</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredTasks.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-muted py-4 fw-bold">لا توجد بلاغات مسجلة تطابق خيارات البحث الحالية.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var task in FilteredTasks)
                        {
                            // فحص الهوية الرقابية بكود الموظف
                            var isCreator = !string.IsNullOrEmpty(task.SenderEmployeeCode) && 
                                            task.SenderEmployeeCode.Equals(State.EmployeeCode, StringComparison.OrdinalIgnoreCase);

                            // فحص هل الموظف الحالي يتبع الإدارة المستهدفة للحل (صيانة / نظافة)
                            var isTargetDept = !string.IsNullOrEmpty(task.TargetDepartment) && 
                                               task.TargetDepartment.Equals(State.DepartmentName, StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td class="font-monospace fw-bold text-primary">@task.TaskNumber</td>
                                <td class="fw-bold text-start ps-3">@task.Title</td>
                                <td>
                                    <span class="badge bg-light text-dark border d-block mb-1">@task.SenderDepartment</span>
                                    <small class="text-muted font-monospace">[@task.SenderEmployeeCode] @task.SenderEmployeeName</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary d-block mb-1">@task.TargetDepartment</span>
                                    @if (!string.IsNullOrEmpty(task.AssignedTechnicianName))
                                    {
                                        <small class="text-primary fw-bold font-monospace">
                                            🛠️️ [@task.AssignedTechnicianCode] @task.AssignedTechnicianName
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted fst-italic">لم يكلف فني بعد</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(task.Priority == "CRITICAL" ? "bg-danger" : task.Priority == "HIGH" ? "bg-warning text-dark" : "bg-info text-dark")">
                                        @task.Priority
                                    </span>
                                </td>
                                <td>
                                    <div class="font-monospace small">@task.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                    <small class="text-muted">مهلة: @task.TargetResolutionMinutes دقيقة</small>
                                </td>
                                <td>
                                    <span class="badge @(task.Status == "CLOSED" ? "bg-success" : task.Status == "IN_PROGRESS" ? "bg-warning text-dark" : task.Status == "ASSIGNED" ? "bg-primary" : "bg-danger")">
                                        @(task.Status == "CLOSED" ? "مغلقة ومؤكدة ✓" : task.Status == "IN_PROGRESS" ? "قيد التنفيذ ⚙️" : task.Status == "ASSIGNED" ? "محالة لفني 🛠️" : "جديدة (انتظار)")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center align-items-center gap-1 flex-wrap">

                                        <!-- 1. زر التكليف والإحالة: مسموح لرئيس/مسؤول القسم المكلف بالحل فقط، وممنوع لمنشئ البلاغ -->
                                        @if ((task.Status == "NEW" || task.Status == "PENDING") && (isTargetDept || State.Role == "Admin") && !isCreator && State.HasPermission("Emergency.Delegate"))
                                        {
                                            <button class="btn btn-sm btn-primary py-1 px-2 fw-bold" @onclick="() => OpenDelegateModal(task)">
                                                🛠️ تكليف فني
                                            </button>
                                        }

                                        <!-- 2. زر بدء التنفيذ الميداني: متاح للفني المختص فقط وممنوع لمنشئ البلاغ للرد على نفسه -->
                                        @if (task.Status == "ASSIGNED" && (isTargetDept || State.Role == "Admin") && !isCreator && State.HasPermission("Emergency.Respond"))
                                        {
                                            <button class="btn btn-sm btn-warning text-dark py-1 px-2 fw-bold" @onclick="() => StartExecution(task)">
                                                ⚡ بدء التنفيذ
                                            </button>
                                        }

                                        <!-- 3. زر إغلاق البلاغ بالدليل المصور: مخصص للفني المنفذ وممنوع لمنشئ البلاغ -->
                                        @if (task.Status == "IN_PROGRESS" && (isTargetDept || State.Role == "Admin") && !isCreator && State.HasPermission("Emergency.Close"))
                                        {
                                            <button class="btn btn-sm btn-success py-1 px-2 fw-bold" @onclick="() => OpenCloseModal(task)">
                                                📷 إغلاق بالدليل
                                            </button>
                                        }

                                        <!-- 4. مؤشر إشعار منشئ البلاغ (لمنع الرد الذاتي) -->
                                        @if (isCreator && task.Status != "CLOSED")
                                        {
                                            <span class="badge bg-light text-muted border py-1 px-2 small">
                                                ⏳ بلاغك قيد المتابعة لدى @task.TargetDepartment
                                            </span>
                                        }

                                        <!-- 5. زر استعراض التفاصيل والدليل متاح للجميع -->
                                        <button class="btn btn-sm btn-outline-secondary py-1 px-2" @onclick="() => OpenDetailsModal(task)">
                                            🔍 التفاصيل
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- 1. نافذة إطلاق بلاغ طارئ جديد (تم إلغاء القوائم المنسدلة والتثبيت التلقائي بكود الموظف) -->
@if (isNewTaskModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">🚨 إطلاق بلاغ طارئ واستدعاء فوري (SOS)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isNewTaskModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">

                    <!-- بطاقة الهوية الرقابية المثبتة آلياً لمنع انتحال الشخصية والتشابه -->
                    <div class="card border-0 shadow-sm p-3 bg-white rounded-3 mb-3 border-start border-4 border-danger">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-4">
                                <label class="small text-muted d-block fw-bold">الصالة / الجهة الطالبة (المثبتة بالنظام)</label>
                                <span class="badge bg-primary px-3 py-2 fs-6">🏭 @State.DepartmentName</span>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted d-block fw-bold">كود الموظف المسؤول (المرجع الرقابي)</label>
                                <span class="badge bg-dark font-monospace px-3 py-2 fs-6">🆔 @State.EmployeeCode</span>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted d-block fw-bold">اسم منشئ البلاغ</label>
                                <div class="fw-bold text-dark mt-1">👤 @State.FullName</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">عنوان المشكلة أو العطل *</label>
                            <input type="text" class="form-control fw-bold" placeholder="مثال: توقف مفاجئ لسير خط الخبز، أو تسريب زيت هيدروليك..." @bind="newTaskModel.Title" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">الإدارة المسؤولة عن التدخل والإصلاح *</label>
                            <select class="form-select fw-bold" @bind="newTaskModel.TargetDepartment">
                                <option value="إدارة الصيانة والتشغيل">إدارة الصيانة والتشغيل (كهرباء / ميكانيكا)</option>
                                <option value="إدارة الإشراف الداخلي والنظافة">إدارة النظافة والتطهير (GMP Sanitation)</option>
                                <option value="إدارة الجودة وسلامة الغذاء">إدارة توكيد الجودة (ISO 22000)</option>
                                <option value="إدارة المخازن والمستودعات">إدارة المخازن (توفير خامات عاجلة)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">درجة الأهمية والخطورة *</label>
                            <select class="form-select fw-bold" @bind="newTaskModel.Priority">
                                <option value="CRITICAL">حرجة جداً (توقف خط إنتاج أو خطر سلامة غذاء)</option>
                                <option value="HIGH">عالية (تأثير مباشر على كفاءة الوردية)</option>
                                <option value="NORMAL">عادية (أعمال صيانة ومعايرة دورية)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">الوصف التفصيلي لموقع العطل والملاحظات الميدانية</label>
                            <textarea class="form-control" rows="3" placeholder="اشرح تفاصيل العطل، رقم الماكينة، أو سبب الاستدعاء العاجل..." @bind="newTaskModel.Description"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="() => isNewTaskModalOpen = false">إلغاء</button>
                    <button type="button" class="btn btn-danger btn-sm px-4 fw-bold shadow-sm" disabled="@isSubmitting" @onclick="SubmitNewTask">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري البث...</span>
                        }
                        else
                        {
                            <span>🚨 إرسال البلاغ الطارئ فوراً</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 2. نافذة تكليف فني (خاصة بمسؤولي القسم المستهدف بالحل) -->
@if (isDelegateModalOpen && selectedTask != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">🛠️️ تكليف فني بالمهمة (@selectedTask.TaskNumber)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isDelegateModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">كود واسم الفني المكلف ميدانياً *</label>
                        <input type="text" class="form-control fw-bold" placeholder="مثال: EMP-103 - فني ميكانيكا محمد علي" @bind="delegateTechnicianInput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">المهلة المقررة للحل (بالدقائق) *</label>
                        <input type="number" class="form-control font-monospace fw-bold" @bind="selectedTask.TargetResolutionMinutes" />
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="() => isDelegateModalOpen = false">إلغاء</button>
                    <button type="button" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="ConfirmDelegation">
                        ✓ اعتماد التكليف وتوجيه المهمة
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 3. نافذة إغلاق البلاغ وتوثيق الدليل (مخصصة للفني المنفذ) -->
@if (isCloseModalOpen && selectedTask != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">📷 إغلاق البلاغ وتوثيق الإنجاز بالدليل (@selectedTask.TaskNumber)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isCloseModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <!-- تثبيت هوية الفني القائم بالإغلاق آلياً -->
                    <div class="alert alert-info py-2 small mb-3">
                        القائم بالإغلاق المعتمد: <strong>[@State.EmployeeCode] @State.FullName</strong> (@State.DepartmentName)
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">تقرير ما تم إنجازه والإصلاحات المنفذة *</label>
                        <textarea class="form-control" rows="3" placeholder="اكتب بياناً بما تم إصلاحه أو تنظيفه أو الإجراء المتبع..." @bind="closureNotesInput"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">إرفاق رابط أو مسار صورة الدليل (بعد الإصلاح) *</label>
                        <input type="text" class="form-control font-monospace" placeholder="مثال: /proofs/repair_oven_01.jpg أو صورة الكاميرا" @bind="closureProofInput" />
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="() => isCloseModalOpen = false">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="ConfirmClosure">
                        ✓ تأكيد الإغلاق وترحيل البلاغ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 4. نافذة تفاصيل البلاغ والدليل المصور -->
@if (isDetailsModalOpen && selectedTask != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">🔍 تفاصيل البلاغ: @selectedTask.TaskNumber</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isDetailsModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <div class="card p-3 border-0 shadow-sm bg-white mb-3">
                        <h5 class="fw-bold text-danger mb-2">@selectedTask.Title</h5>
                        <p class="text-muted small">@selectedTask.Description</p>
                    </div>

                    <div class="row g-2 small">
                        <div class="col-md-6">
                            <ul class="list-group">
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>الجهة الطالبة:</span>
                                    <strong class="text-primary">@selectedTask.SenderDepartment</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>كود واسم الراسل:</span>
                                    <strong>[@selectedTask.SenderEmployeeCode] @selectedTask.SenderEmployeeName</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>تاريخ الإطلاق:</span>
                                    <strong class="font-monospace">@selectedTask.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</strong>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-group">
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>الجهة المنفذة:</span>
                                    <strong>@selectedTask.TargetDepartment</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>الفني المكلف:</span>
                                    <strong class="text-success">[@selectedTask.AssignedTechnicianCode] @selectedTask.AssignedTechnicianName</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>الحالة الحالية:</span>
                                    <strong class="badge bg-dark">@selectedTask.Status</strong>
                                </li>
                            </ul>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(selectedTask.ClosureNotes))
                    {
                        <div class="card p-3 border-0 shadow-sm bg-white mt-3">
                            <h6 class="fw-bold text-success mb-1">بيان إغلاق البلاغ وإثبات الحل:</h6>
                            <p class="small text-muted mb-1">@selectedTask.ClosureNotes</p>
                            <small class="text-secondary font-monospace">مغلق بواسطة: [@selectedTask.ClosedByCode] @selectedTask.ClosedBy</small>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-white py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => isDetailsModalOpen = false">إغلاق</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public class EmergencyTaskModel
    {
        public long Id { get; set; }
        public string? TaskNumber { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string SenderDepartment { get; set; } = string.Empty;
        public string SenderEmployeeCode { get; set; } = string.Empty;
        public string SenderEmployeeName { get; set; } = string.Empty;
        public string TargetDepartment { get; set; } = "إدارة الصيانة والتشغيل";
        public string? AssignedTechnicianCode { get; set; }
        public string? AssignedTechnicianName { get; set; }
        public string Priority { get; set; } = "HIGH";
        public DateTime CreatedAt { get; set; } = DateTime.UtcNow;
        public int TargetResolutionMinutes { get; set; } = 30;
        public DateTime? RespondedAt { get; set; }
        public DateTime? CompletedAt { get; set; }
        public string Status { get; set; } = "NEW";
        public string? ClosureNotes { get; set; }
        public string? ClosureProofMediaUrl { get; set; }
        public string? ClosedBy { get; set; }
        public string? ClosedByCode { get; set; }
    }

    private List<EmergencyTaskModel> tasksList = new();
    private EmergencyTaskModel newTaskModel = new();
    private EmergencyTaskModel? selectedTask;

    private bool isNewTaskModalOpen = false;
    private bool isDelegateModalOpen = false;
    private bool isCloseModalOpen = false;
    private bool isDetailsModalOpen = false;
    private bool isSubmitting = false;

    private string delegateTechnicianInput = "";
    private string closureNotesInput = "";
    private string closureProofInput = "";

    private string searchTerm = "";
    private string statusFilter = "";
    private string statusMessage = "";
    private bool isSuccessMessage = true;

    protected override async Task OnInitializedAsync()
    {
        // 1. التحقق من تسجيل الدخول
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("login", forceLoad: true);
            return;
        }

        // 2. مزامنة كائن الحالة
        if (!State.IsLoggedIn)
        {
            var user = await LocalStorage.GetItemAsync<string>("username");
            var fullName = await LocalStorage.GetItemAsync<string>("fullName");
            var role = await LocalStorage.GetItemAsync<string>("userRole");
            var dept = await LocalStorage.GetItemAsync<string>("departmentName");
            var perms = await LocalStorage.GetItemAsync<List<string>>("userPermissions");

            State.SetUserSession(0, user ?? "admin", user ?? "admin", fullName ?? "أحمد عبد العزيز", role ?? "Admin", null, dept ?? "إدارة الإنتاج", perms ?? new List<string>());
        }

        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<EmergencyTaskModel>>("api/EmergencyTasks");
            if (res != null)
            {
                tasksList = res.OrderByDescending(t => t.CreatedAt).ToList();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ في تحميل البلاغات: {ex.Message}";
            isSuccessMessage = false;
        }
    }

    private IEnumerable<EmergencyTaskModel> FilteredTasks
    {
        get
        {
            var list = tasksList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(statusFilter))
                list = list.Where(t => t.Status == statusFilter);

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                list = list.Where(t => 
                    (t.TaskNumber ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    t.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    t.SenderDepartment.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    t.SenderEmployeeName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (t.AssignedTechnicianName ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return list;
        }
    }

    private void OpenNewTaskModal()
    {
        newTaskModel = new EmergencyTaskModel
        {
            SenderDepartment = State.DepartmentName,
            SenderEmployeeCode = State.EmployeeCode,
            SenderEmployeeName = State.FullName,
            TargetDepartment = "إدارة الصيانة والتشغيل",
            Priority = "HIGH",
            TargetResolutionMinutes = 30
        };
        isNewTaskModalOpen = true;
    }

    private async Task SubmitNewTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskModel.Title))
        {
            statusMessage = "⚠️ يرجى كتابة عنوان المشكلة أو العطل!";
            isSuccessMessage = false;
            return;
        }

        isSubmitting = true;
        try
        {
            // تثبيت الهوية الرقابية آلياً من كائن الجلسة لمنع أي تلاعب
            newTaskModel.SenderDepartment = State.DepartmentName;
            newTaskModel.SenderEmployeeCode = State.EmployeeCode;
            newTaskModel.SenderEmployeeName = State.FullName;
            newTaskModel.CreatedAt = DateTime.UtcNow;
            newTaskModel.Status = "NEW";

            var response = await Http.PostAsJsonAsync("api/EmergencyTasks", newTaskModel);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = "✅ تم إطلاق البلاغ الطارئ وبثه للإدارة المختصة بنجاح!";
                isSuccessMessage = true;
                isNewTaskModalOpen = false;
                await LoadTasks();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                statusMessage = $"❌ تعذر الإرسال: {err}";
                isSuccessMessage = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccessMessage = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenDelegateModal(EmergencyTaskModel task)
    {
        selectedTask = task;
        delegateTechnicianInput = "";
        isDelegateModalOpen = true;
    }

    private async Task ConfirmDelegation()
    {
        if (selectedTask == null || string.IsNullOrWhiteSpace(delegateTechnicianInput)) return;

        try
        {
            selectedTask.AssignedTechnicianName = delegateTechnicianInput;
            selectedTask.AssignedTechnicianCode = "TECH-" + new Random().Next(100, 999);
            selectedTask.Status = "ASSIGNED";

            var res = await Http.PutAsJsonAsync($"api/EmergencyTasks/{selectedTask.Id}", selectedTask);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = $"✅ تم تكليف الفني ({delegateTechnicianInput}) بالبلاغ بنجاح!";
                isSuccessMessage = true;
                isDelegateModalOpen = false;
                await LoadTasks();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccessMessage = false;
        }
    }

    private async Task StartExecution(EmergencyTaskModel task)
    {
        try
        {
            task.Status = "IN_PROGRESS";
            task.RespondedAt = DateTime.UtcNow;

            var res = await Http.PutAsJsonAsync($"api/EmergencyTasks/{task.Id}", task);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = $"⚡ تم تسجيل بدء التنفيذ الميداني للبلاغ ({task.TaskNumber})!";
                isSuccessMessage = true;
                await LoadTasks();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccessMessage = false;
        }
    }

    private void OpenCloseModal(EmergencyTaskModel task)
    {
        selectedTask = task;
        closureNotesInput = "";
        closureProofInput = "";
        isCloseModalOpen = true;
    }

    private async Task ConfirmClosure()
    {
        if (selectedTask == null || string.IsNullOrWhiteSpace(closureNotesInput))
        {
            statusMessage = "⚠️ يرجى كتابة بيان الإنجاز وإجراء الإصلاح المنفذ!";
            isSuccessMessage = false;
            return;
        }

        try
        {
            selectedTask.Status = "CLOSED";
            selectedTask.CompletedAt = DateTime.UtcNow;
            selectedTask.ClosureNotes = closureNotesInput;
            selectedTask.ClosureProofMediaUrl = closureProofInput;
            selectedTask.ClosedBy = State.FullName;
            selectedTask.ClosedByCode = State.EmployeeCode;

            var res = await Http.PutAsJsonAsync($"api/EmergencyTasks/{selectedTask.Id}", selectedTask);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = $"✅ تم توثيق إغلاق البلاغ ({selectedTask.TaskNumber}) بالدليل الميداني بنجاح!";
                isSuccessMessage = true;
                isCloseModalOpen = false;
                await LoadTasks();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccessMessage = false;
        }
    }

    private void OpenDetailsModal(EmergencyTaskModel task)
    {
        selectedTask = task;
        isDetailsModalOpen = true;
    }
}