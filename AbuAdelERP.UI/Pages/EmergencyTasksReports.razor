@page "/emergency-tasks-reports"
@using System.Net.Http.Json
@using System.Text
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>لوحة مؤشرات الأداء والتقارير التنفيذية (KPIs) - حلواني أبو عادل</PageTitle>

<!-- أنماط مخصصة لإصلاح الطباعة وإخفاء القائمة الجانبية تماماً وتنسيق A4 بالعرض -->
<style>
    @@media print {
        /* إخفاء القائمة الجانبية والشريط العلوي وجميع الأزرار والفلاتر تلقائياً */
        .sidebar, .top-row, .navbar, header, nav, .no-print, button, a.btn, .input-group, select, input {
            display: none !important;
        }

        /* تمديد المحتوى ليأخذ 100% من مساحة الورقة البيضاء */
        body, html, main, .main, article, .content, .container-fluid {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            background: #ffffff !important;
            box-shadow: none !important;
        }

        /* فرض طباعة الخلفيات والألوان والحدود بدقة تامة */
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        @@page {
            size: A4 landscape; /* طباعة أفقية واسعة ومنسقة */
            margin: 10mm 8mm;
        }

        .print-only-header {
            display: block !important;
        }

        .card {
            border: 1px solid #ccc !important;
            box-shadow: none !important;
            page-break-inside: avoid;
        }

        table {
            width: 100% !important;
            font-size: 11px !important;
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        thead {
            display: table-header-group;
        }
    }

    .print-only-header {
        display: none;
    }
</style>

<div class="container-fluid px-3 py-3" dir="rtl">

    <!-- ترويسة التقرير الرسمية للطباعة فقط -->
    <div class="print-only-header mb-3 border-bottom pb-2">
        <div class="d-flex justify-content-between align-items-center">
            <div class="text-start">
                <small class="text-muted d-block">نظام إدارة العمليات AbuAdelERP</small>
                <small class="text-muted d-block">تاريخ الاستخراج: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</small>
            </div>
            <div class="text-center">
                <h4 class="fw-bold m-0 text-dark">مؤسسة حلواني أبو عادل للحلويات والمخبوزات</h4>
                <h5 class="fw-bold text-danger m-0">تقرير مؤشرات قياس الأداء التشغيلي للمهام الطارئة (Executive Incident & SLA KPIs)</h5>
            </div>
            <div class="text-end">
                <span class="badge bg-dark px-3 py-2">اعتماد الجودة والسلامة</span>
            </div>
        </div>
    </div>

    <!-- رأس الصفحة للشاشة العادية -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3 no-print">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-warning">📈 لوحة مؤشرات الأداء التشغيلية (Executive KPIs & SLA)</h4>
                    <span class="badge bg-warning text-dark px-2 py-1 small fw-bold">إدارة العمليات والاستجابة</span>
                </div>
                <small class="text-light text-opacity-75">
                    التحليل الرقمي لزمن الإصلاح (MTTR)، سرعة التكليف، ومعدلات امتثال الإدارات لمعايير الجودة والسلامة بمصنع حلواني أبو عادل.
                </small>
            </div>
            <div class="d-flex gap-2">
                <a href="emergency-tasks" class="btn btn-outline-light btn-sm fw-bold px-3 py-2 shadow-sm">
                    🚨 غرفة العمليات الحية
                </a>
                <button class="btn btn-success btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="ExportToExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل
                </button>
                <button class="btn btn-primary btn-sm fw-bold px-4 py-2 shadow-sm" @onclick="PrintReportAsync">
                    <i class="bi bi-printer-fill me-1"></i> طباعة التقرير الرسمي
                </button>
            </div>
        </div>
    </div>

    <!-- شريط الفلاتر (لا يظهر في الطباعة) -->
    <div class="card shadow-sm border-0 mb-3 bg-light no-print">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">من تاريخ:</label>
                    <input type="date" class="form-control form-control-sm" @bind="fromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">إلى تاريخ:</label>
                    <input type="date" class="form-control form-control-sm" @bind="toDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">تصفية حسب الإدارة المسؤولة:</label>
                    <select class="form-select form-select-sm" @bind="targetDeptFilter">
                        <option value="">-- كل الإدارات المكلفة --</option>
                        @foreach (var d in distinctTargetDepartments)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-sm w-100 fw-bold" @onclick="ResetFilters">🔄 إعادة ضبط الفلاتر</button>
                </div>
            </div>
        </div>
    </div>

    <!-- مصفوفة مؤشرات الأداء التنفيذية العليا (Executive KPI Cards) -->
    <div class="row g-2 mb-3">
        <!-- 1. معدل الالتزام بالـ SLA -->
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-2 bg-white border-top border-success border-4 h-100">
                <small class="text-muted fw-bold d-block">نسبة الالتزام بالمهلة (SLA)</small>
                <h3 class="fw-bold text-success mt-1 mb-0 font-monospace">@CalculateSlaRate()%</h3>
                <small class="text-success small fw-bold">@CountOnTimeTasks() منجز في الموعد</small>
            </div>
        </div>

        <!-- 2. متوسط زمن الإصلاح MTTR -->
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-2 bg-white border-top border-warning border-4 h-100">
                <small class="text-muted fw-bold d-block">متوسط زمن الإصلاح (MTTR)</small>
                <h3 class="fw-bold text-warning mt-1 mb-0 font-monospace">@CalculateMttr() <span class="fs-6">دقيقة</span></h3>
                <small class="text-muted small">من الإطلاق حتى الإغلاق</small>
            </div>
        </div>

        <!-- 3. متوسط سرعة الاستجابة والتكليف MTTA -->
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-2 bg-white border-top border-info border-4 h-100">
                <small class="text-muted fw-bold d-block">سرعة الاستجابة (MTTA)</small>
                <h3 class="fw-bold text-info mt-1 mb-0 font-monospace">@CalculateMtta() <span class="fs-6">دقيقة</span></h3>
                <small class="text-muted small">زمن استلام وتكليف البلاغ</small>
            </div>
        </div>

        <!-- 4. نسبة الإغلاق الموثق بالدليل المصور -->
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-2 bg-white border-top border-primary border-4 h-100">
                <small class="text-muted fw-bold d-block">الإغلاق بالدليل المصور</small>
                <h3 class="fw-bold text-primary mt-1 mb-0 font-monospace">@CalculateProofClosureRate()%</h3>
                <small class="text-muted small">مطابقة معايير الرقابة</small>
            </div>
        </div>

        <!-- 5. معدل البلاغات الحرجة -->
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-2 bg-white border-top border-danger border-4 h-100">
                <small class="text-muted fw-bold d-block">البلاغات الحرجة (Critical)</small>
                <h3 class="fw-bold text-danger mt-1 mb-0 font-monospace">@FilteredTasks.Count(t => t.Priority == "CRITICAL") <span class="fs-6">بلاغ</span></h3>
                <small class="text-danger small">توقف صالة أو خطر جودة</small>
            </div>
        </div>

        <!-- 6. إجمالي البلاغات ونسبة الإنجاز -->
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm rounded-3 p-2 bg-white border-top border-dark border-4 h-100">
                <small class="text-muted fw-bold d-block">معدل الإغلاق الكلي</small>
                <h3 class="fw-bold text-dark mt-1 mb-0 font-monospace">@CalculateClosureRate()%</h3>
                <small class="text-muted small">@FilteredTasks.Count(t => t.Status == "CLOSED") من @FilteredTasks.Count() بلاغ</small>
            </div>
        </div>
    </div>

    <!-- جدول تقرير كفاءة الإدارات والأقسام (Departmental KPI Scorecard) -->
    <div class="card shadow-sm border-0 mb-3 rounded-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-dark m-0">🏢 بطاقة الأداء المتوازن للإدارات (Departmental Scorecard)</h6>
            <small class="text-muted">مرتبة حسب معدل كفاءة الاستجابة</small>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-bordered table-sm mb-0 text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>الإدارة المسؤولة</th>
                        <th>البلاغات الواردة</th>
                        <th>المنجز بالدليل</th>
                        <th>المعلق / قيد العمل</th>
                        <th>منجز في الموعد (SLA)</th>
                        <th>المتأخر عن المهلة</th>
                        <th>متوسط وقت الإصلاح (MTTR)</th>
                        <th>معدل الالتزام</th>
                        <th>تقييم الأداء العام</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in GetDepartmentAnalytics())
                    {
                        <tr>
                            <td class="fw-bold text-start ps-3">@d.DepartmentName</td>
                            <td class="font-monospace fw-bold">@d.TotalReceived</td>
                            <td class="text-success font-monospace fw-bold">@d.CompletedCount</td>
                            <td class="text-warning font-monospace fw-bold">@d.PendingCount</td>
                            <td class="text-success font-monospace">@d.OnTimeCount</td>
                            <td class="text-danger font-monospace fw-bold">@d.OverdueCount</td>
                            <td class="font-monospace">@d.AvgResolutionMinutes دقيقة</td>
                            <td>
                                <div class="progress" style="height: 18px;">
                                    <div class="progress-bar @(d.SlaRate >= 80 ? "bg-success" : d.SlaRate >= 50 ? "bg-warning text-dark" : "bg-danger") fw-bold small" 
                                         role="progressbar" 
                                         style="width: @d.SlaRate%;">
                                        @d.SlaRate%
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(d.Score >= 85 ? "bg-success" : d.Score >= 65 ? "bg-primary" : "bg-danger") px-2 py-1">
                                    @(d.Score >= 85 ? "ممتاز 🌟" : d.Score >= 65 ? "جيد جداً ✓" : "بحاجة لمتابعة ⚠️") (@d.Score%)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- جدول كفاءة وسرعة الفنيين (Technician Performance Ranking) -->
    <div class="card shadow-sm border-0 mb-3 rounded-3">
        <div class="card-header bg-white py-2">
            <h6 class="fw-bold text-primary m-0">🛠️ سجل أداء وسرعة الفنيين والمنفذين الميدانيين</h6>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-bordered table-sm mb-0 text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>اسم الفني / القائم بالإغلاق</th>
                        <th>المهام المكلف بها</th>
                        <th>المهام المنجزة</th>
                        <th>منجز في الموعد المحدد</th>
                        <th>متوسط وقت الحل الفعلي</th>
                        <th>معدل الانضباط</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!GetTechnicianAnalytics().Any())
                    {
                        <tr>
                            <td colspan="6" class="text-muted py-3">لا توجد بيانات فنيين منجزة مسجلة حالياً.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var tech in GetTechnicianAnalytics())
                        {
                            <tr>
                                <td class="fw-bold text-start ps-3">@tech.TechnicianName</td>
                                <td class="font-monospace">@tech.AssignedCount</td>
                                <td class="text-success font-monospace fw-bold">@tech.CompletedCount</td>
                                <td class="text-success font-monospace">@tech.OnTimeCount</td>
                                <td class="font-monospace">@tech.AvgResolutionMinutes دقيقة</td>
                                <td>
                                    <span class="badge @(tech.DisciplineRate >= 80 ? "bg-success" : "bg-warning text-dark")">
                                        @tech.DisciplineRate%
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- السجل التفصيلي الشامل لحساب التوقيتات الفردية لكل مهمة -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-dark m-0">📜 السجل التفصيلي لحساب أوقات الإنجاز الفردية للبلاغات</h6>
            <span class="badge bg-secondary font-monospace">عدد البلاغات: @FilteredTasks.Count()</span>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered table-sm mb-0 text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>رقم البلاغ</th>
                        <th>عنوان المشكلة</th>
                        <th>القسم الطالب / الراسل</th>
                        <th>القسم المسؤول / الفني المكلف</th>
                        <th>تاريخ الإطلاق</th>
                        <th>المهلة المحددة</th>
                        <th>تاريخ الإغلاق</th>
                        <th>الزمن الفعلي</th>
                        <th>مؤشر تقييم الـ SLA</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredTasks.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-muted py-4 fw-bold">لا توجد بلاغات مسجلة في النطاق المحدد.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in FilteredTasks)
                        {
                            var hasCompleted = t.CompletedAt.HasValue;
                            var durationMinutes = hasCompleted ? (int)(t.CompletedAt!.Value - t.CreatedAt).TotalMinutes : 0;
                            var isOverdue = hasCompleted 
                                ? durationMinutes > t.TargetResolutionMinutes 
                                : (DateTime.UtcNow - t.CreatedAt).TotalMinutes > t.TargetResolutionMinutes;

                            <tr>
                                <td class="font-monospace fw-bold text-primary">@t.TaskNumber</td>
                                <td class="fw-bold text-start ps-2">@t.Title</td>
                                <td>
                                    <div>@t.SenderDepartment</div>
                                    <small class="text-muted">@t.SenderEmployeeName</small>
                                </td>
                                <td>
                                    <div>@t.TargetDepartment</div>
                                    @if (!string.IsNullOrEmpty(t.AssignedTechnicianName))
                                    {
                                        <small class="text-primary fw-bold">🛠️ @t.AssignedTechnicianName</small>
                                    }
                                </td>
                                <td class="font-monospace">@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="font-monospace">@t.TargetResolutionMinutes دقيقة</td>
                                <td class="font-monospace">@(t.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "قيد المعالجة")</td>
                                <td class="font-monospace fw-bold @(hasCompleted ? (durationMinutes <= t.TargetResolutionMinutes ? "text-success" : "text-danger") : "text-muted")">
                                    @(hasCompleted ? $"{durationMinutes} دقيقة" : "-")
                                </td>
                                <td>
                                    @if (t.Status == "CLOSED")
                                    {
                                        if (durationMinutes <= t.TargetResolutionMinutes)
                                        {
                                            <span class="badge bg-success">منجز في الموعد ✓</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">تأخر (@(durationMinutes - t.TargetResolutionMinutes) دقيقة) ⚠️</span>
                                        }
                                    }
                                    else
                                    {
                                        if (isOverdue)
                                        {
                                            <span class="badge bg-danger">متأخر عن المهلة! 🚨</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">جارٍ ضمن المهلة</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- تذييل التوقيعات للطباعة الرسمية فقط -->
    <div class="print-only-header mt-4 pt-3 border-top">
        <div class="row text-center">
            <div class="col-4">
                <strong>مشرف العمليات / منسق الإنتاج</strong>
                <div class="mt-4 text-muted">....................................</div>
            </div>
            <div class="col-4">
                <strong>مدير توكيد الجودة والسلامة</strong>
                <div class="mt-4 text-muted">....................................</div>
            </div>
            <div class="col-4">
                <strong>مدير المصنع / الإدارة العليا</strong>
                <div class="mt-4 text-muted">....................................</div>
            </div>
        </div>
    </div>

</div>

@code {
    public class EmergencyTaskDto
    {
        public long Id { get; set; }
        public string? TaskNumber { get; set; }
        public string Title { get; set; } = string.Empty;
        public string SenderDepartment { get; set; } = string.Empty;
        public string SenderEmployeeName { get; set; } = string.Empty;
        public string TargetDepartment { get; set; } = string.Empty;
        public string? TargetEmployeeName { get; set; }
        public string? AssignedTechnicianName { get; set; }
        public string Priority { get; set; } = "NORMAL";
        public DateTime CreatedAt { get; set; }
        public int TargetResolutionMinutes { get; set; } = 30;
        public DateTime? RespondedAt { get; set; }
        public DateTime? CompletedAt { get; set; }
        public string Status { get; set; } = "PENDING";
        public string? ClosureNotes { get; set; }
        public string? ClosureProofMediaUrl { get; set; }
        public string? ClosedBy { get; set; }
    }

    public class DepartmentAnalyticsDto
    {
        public string DepartmentName { get; set; } = string.Empty;
        public int TotalReceived { get; set; }
        public int CompletedCount { get; set; }
        public int PendingCount { get; set; }
        public int OnTimeCount { get; set; }
        public int OverdueCount { get; set; }
        public int AvgResolutionMinutes { get; set; }
        public int SlaRate { get; set; }
        public int Score { get; set; }
    }

    public class TechnicianAnalyticsDto
    {
        public string TechnicianName { get; set; } = string.Empty;
        public int AssignedCount { get; set; }
        public int CompletedCount { get; set; }
        public int OnTimeCount { get; set; }
        public int AvgResolutionMinutes { get; set; }
        public int DisciplineRate { get; set; }
    }

    private List<EmergencyTaskDto> allTasks = new();
    private DateTime? fromDate;
    private DateTime? toDate;
    private string targetDeptFilter = "";
    private List<string> distinctTargetDepartments = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadReportData();
    }

    private async Task LoadReportData()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<EmergencyTaskDto>>("api/EmergencyTasks");
            if (res != null)
            {
                allTasks = res;
                distinctTargetDepartments = allTasks.Select(t => t.TargetDepartment).Where(d => !string.IsNullOrEmpty(d)).Distinct().ToList();
            }
        }
        catch { }
    }

    private IEnumerable<EmergencyTaskDto> FilteredTasks
    {
        get
        {
            var list = allTasks.AsEnumerable();

            if (fromDate.HasValue)
                list = list.Where(t => t.CreatedAt.Date >= fromDate.Value.Date);

            if (toDate.HasValue)
                list = list.Where(t => t.CreatedAt.Date <= toDate.Value.Date);

            if (!string.IsNullOrEmpty(targetDeptFilter))
                list = list.Where(t => t.TargetDepartment == targetDeptFilter);

            return list;
        }
    }

    private void ResetFilters()
    {
        fromDate = null;
        toDate = null;
        targetDeptFilter = "";
    }

    private int CountOnTimeTasks()
    {
        return FilteredTasks.Count(t => t.CompletedAt.HasValue && (t.CompletedAt.Value - t.CreatedAt).TotalMinutes <= t.TargetResolutionMinutes);
    }

    private int CalculateSlaRate()
    {
        var completed = FilteredTasks.Where(t => t.CompletedAt.HasValue).ToList();
        if (!completed.Any()) return 100;
        var onTime = completed.Count(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes <= t.TargetResolutionMinutes);
        return (int)Math.Round((double)onTime / completed.Count * 100);
    }

    private int CalculateMttr()
    {
        var completed = FilteredTasks.Where(t => t.CompletedAt.HasValue).ToList();
        if (!completed.Any()) return 0;
        var avg = completed.Average(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes);
        return (int)Math.Round(avg);
    }

    private int CalculateMtta()
    {
        var responded = FilteredTasks.Where(t => t.RespondedAt.HasValue).ToList();
        if (!responded.Any())
        {
            // استرشاد بزمن التكليف أو الإغلاق
            responded = FilteredTasks.Where(t => t.CompletedAt.HasValue).ToList();
            if (!responded.Any()) return 0;
            return (int)Math.Round(responded.Average(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes * 0.3));
        }
        return (int)Math.Round(responded.Average(t => (t.RespondedAt!.Value - t.CreatedAt).TotalMinutes));
    }

    private int CalculateProofClosureRate()
    {
        var completed = FilteredTasks.Where(t => t.CompletedAt.HasValue).ToList();
        if (!completed.Any()) return 100;
        var withProof = completed.Count(t => !string.IsNullOrEmpty(t.ClosureProofMediaUrl));
        return (int)Math.Round((double)withProof / completed.Count * 100);
    }

    private int CalculateClosureRate()
    {
        var total = FilteredTasks.Count();
        if (total == 0) return 100;
        var closed = FilteredTasks.Count(t => t.Status == "CLOSED");
        return (int)Math.Round((double)closed / total * 100);
    }

    private List<DepartmentAnalyticsDto> GetDepartmentAnalytics()
    {
        var list = new List<DepartmentAnalyticsDto>();
        var depts = FilteredTasks.Select(t => t.TargetDepartment).Distinct().Where(d => !string.IsNullOrEmpty(d)).ToList();

        foreach (var d in depts)
        {
            var dTasks = FilteredTasks.Where(t => t.TargetDepartment == d).ToList();
            var dCompleted = dTasks.Where(t => t.CompletedAt.HasValue).ToList();
            var onTime = dCompleted.Count(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes <= t.TargetResolutionMinutes);
            var overdue = dTasks.Count(t => 
                (t.CompletedAt.HasValue && (t.CompletedAt.Value - t.CreatedAt).TotalMinutes > t.TargetResolutionMinutes) ||
                (!t.CompletedAt.HasValue && (DateTime.UtcNow - t.CreatedAt).TotalMinutes > t.TargetResolutionMinutes));

            var avgMins = dCompleted.Any() ? (int)Math.Round(dCompleted.Average(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes)) : 0;
            var sla = dCompleted.Any() ? (int)Math.Round((double)onTime / dCompleted.Count * 100) : 100;
            
            // معادلة تقييم شاملة من 100
            var score = (int)Math.Round((sla * 0.7) + (dCompleted.Count * 100.0 / (dTasks.Count > 0 ? dTasks.Count : 1) * 0.3));
            if (score > 100) score = 100;

            list.Add(new DepartmentAnalyticsDto
            {
                DepartmentName = d,
                TotalReceived = dTasks.Count,
                CompletedCount = dCompleted.Count,
                PendingCount = dTasks.Count - dCompleted.Count,
                OnTimeCount = onTime,
                OverdueCount = overdue,
                AvgResolutionMinutes = avgMins,
                SlaRate = sla,
                Score = score
            });
        }

        return list.OrderByDescending(x => x.Score).ToList();
    }

    private List<TechnicianAnalyticsDto> GetTechnicianAnalytics()
    {
        var list = new List<TechnicianAnalyticsDto>();
        var techs = FilteredTasks
            .Select(t => !string.IsNullOrEmpty(t.AssignedTechnicianName) ? t.AssignedTechnicianName : t.ClosedBy)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct()
            .ToList();

        foreach (var tech in techs)
        {
            var techTasks = FilteredTasks.Where(t => t.AssignedTechnicianName == tech || t.ClosedBy == tech).ToList();
            var completed = techTasks.Where(t => t.CompletedAt.HasValue).ToList();
            var onTime = completed.Count(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes <= t.TargetResolutionMinutes);
            var avgMins = completed.Any() ? (int)Math.Round(completed.Average(t => (t.CompletedAt!.Value - t.CreatedAt).TotalMinutes)) : 0;
            var rate = completed.Any() ? (int)Math.Round((double)onTime / completed.Count * 100) : 100;

            list.Add(new TechnicianAnalyticsDto
            {
                TechnicianName = tech!,
                AssignedCount = techTasks.Count,
                CompletedCount = completed.Count,
                OnTimeCount = onTime,
                AvgResolutionMinutes = avgMins,
                DisciplineRate = rate
            });
        }

        return list.OrderByDescending(x => x.CompletedCount).ToList();
    }

    private async Task ExportToExcelAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine("رقم_البلاغ,عنوان_المهمة,القسم_الطالب,الراسل,القسم_المسؤول,الفني_المكلف,تاريخ_الإطلاق,المهلة_بالدقائق,تاريخ_الإغلاق,المدة_الفعلية_بالدقائق,الحالة,تقييم_الـ_SLA");

        foreach (var t in FilteredTasks)
        {
            var dur = t.CompletedAt.HasValue ? (int)(t.CompletedAt.Value - t.CreatedAt).TotalMinutes : 0;
            var eval = t.CompletedAt.HasValue ? (dur <= t.TargetResolutionMinutes ? "منجز في الموعد" : "متأخر عن المهلة") : "قيد المعالجة";

            sb.AppendLine($"\"{t.TaskNumber}\",\"{t.Title}\",\"{t.SenderDepartment}\",\"{t.SenderEmployeeName}\",\"{t.TargetDepartment}\",\"{t.AssignedTechnicianName}\",\"{t.CreatedAt:yyyy-MM-dd HH:mm}\",{t.TargetResolutionMinutes},\"{t.CompletedAt?.ToString("yyyy-MM-dd HH:mm")}\",{dur},\"{t.Status}\",\"{eval}\"");
        }

        var fileName = $"تقرير_مؤشرات_المهام_الطارئة_حلواني_أبو_عادل_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        var utf8WithBom = "\uFEFF" + sb.ToString();
        var js = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", js);
    }

    private async Task PrintReportAsync()
    {
        await JS.InvokeVoidAsync("eval", "window.print();");
    }
}