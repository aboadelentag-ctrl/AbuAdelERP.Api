@page "/departments"
@using System.Net.Http.Json
@using System.Text
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container-fluid px-4 py-3" dir="rtl">
    
    <!-- رأس الصفحة وأزرار التصدير والاستيراد -->
    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border-start border-primary border-4">
        <div>
            <h4 class="mb-1 text-dark fw-bold">🏢 إدارة الأقسام والإدارات</h4>
            <small class="text-muted">تعريف وتصفية الهيكل التنظيمي للمصنع (إدارة عليا ──> إدارة ──> صالة / قسم إنتاجي)</small>
        </div>
        <div class="d-flex gap-2">
            <!-- أزرار الإكسيل الاحترافية -->
            <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportToExcelAsync">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل
            </button>
            <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                <i class="bi bi-download me-1"></i> تحميل قالب الإكسيل
            </button>
            <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد من إكسيل
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadDepartmentsAsync">
                <i class="bi bi-arrow-clockwise"></i> تحديث
            </button>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-1"></i> @successMessage
            <button type="button" class="btn-close py-2" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
            <button type="button" class="btn-close py-2" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="row g-3">
        <!-- 1. شريط الفلاتر وجدول عرض الأقسام والإدارات (الجانب الأيمن) -->
        <div class="col-lg-8">
            
            <!-- شريط الفلاتر الشامل للهيكل التنظيمي -->
            <div class="card shadow-sm border-0 mb-3 bg-white border-top border-primary border-3">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        
                        <!-- 1. بحث بالاسم أو الكود -->
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary mb-1">🔍 بحث (اسم، كود، أو وصف)</label>
                            <input type="text" class="form-control form-control-sm" placeholder="ابحث باسم القسم أو الكود..." 
                                   @bind="searchTerm" @bind:event="oninput" />
                        </div>

                        <!-- 2. فلتر المستوى الهيكلي -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-secondary mb-1">👑 المستوى الهيكلي</label>
                            <select class="form-select form-select-sm" @bind="selectedLevelFilter">
                                <option value="all">-- كل المستويات --</option>
                                <option value="root">👑 إدارات رئيسية فقط</option>
                                <option value="sub">└── صالات وأقسام فرعية</option>
                            </select>
                        </div>

                        <!-- 3. فلتر الإدارة الأب -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-secondary mb-1">🏢 تتبع لإدارة</label>
                            <select class="form-select form-select-sm" @bind="selectedParentFilter">
                                <option value="-1">-- كل الجهات --</option>
                                @foreach (var parent in departments.Where(d => d.ParentDepartmentId == null))
                                {
                                    <option value="@parent.Id">@parent.DepartmentName</option>
                                }
                            </select>
                        </div>

                        <!-- 4. فلتر الحالة -->
                        <div class="col-md-2">
                            <label class="form-label small fw-bold text-secondary mb-1">⚡ الحالة</label>
                            <select class="form-select form-select-sm" @bind="selectedStatusFilter">
                                <option value="all">كل الحالات</option>
                                <option value="active">🟢 مفعل فقط</option>
                                <option value="inactive">🔴 معطل</option>
                            </select>
                        </div>

                    </div>

                    <!-- شريط معلومات التصفية النشطة -->
                    @if (HasActiveFilters)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                            <span class="small text-primary fw-bold">
                                <i class="bi bi-funnel-fill me-1"></i> نتائج التصفية: (@FilteredDepartments.Count() من إجمالي @departments.Count هيكل مسجل)
                            </span>
                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" style="font-size: 0.78rem;" @onclick="ResetFilters">
                                ✕ إلغاء الفلاتر وعرض الكل
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- بطاقة جدول الأقسام -->
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
                    <span class="small fw-bold">قائمة الأقسام المسجلة بالهيكل التنظيمي</span>
                    <span class="badge bg-primary">المعروض: @FilteredDepartments.Count() هيكل</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center small">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">الكود</th>
                                <th class="text-start">الاسم</th>
                                <th>الجهة التابع لها (الأب)</th>
                                <th>الوصف / الملاحظات</th>
                                <th>الحالة</th>
                                <th style="width: 140px;">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="6" class="py-4 text-muted">
                                        <div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري تحميل الهيكل التنظيمي...
                                    </td>
                                </tr>
                            }
                            else if (!FilteredDepartments.Any())
                            {
                                <tr>
                                    <td colspan="6" class="py-4 text-muted">
                                        <i class="bi bi-search fs-3 d-block mb-2 text-secondary"></i>
                                        لا توجد سجلات مطابقة لشروط البحث والفلترة.
                                        <div class="mt-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="ResetFilters">إعادة ضبط الفلاتر</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var dept in FilteredDepartments)
                                {
                                    <tr class="@(dept.Id == currentDept.Id ? "table-primary" : "")" @key="dept.Id">
                                        <td class="font-monospace fw-bold text-secondary">@dept.DepartmentCode</td>
                                        <td class="text-start fw-bold text-dark">
                                            @if (dept.ParentDepartmentId == null)
                                            {
                                                <span class="badge bg-primary me-1">إدارة رئيسية</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted me-2">└──</span>
                                            }
                                            @dept.DepartmentName
                                        </td>
                                        <td>
                                            @if (dept.ParentDepartmentId != null)
                                            {
                                                <span class="badge bg-light text-dark border">
                                                    @GetParentName(dept.ParentDepartmentId)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">👑 إدارة رئيسية</span>
                                            }
                                        </td>
                                        <td class="text-muted">@(string.IsNullOrEmpty(dept.Description) ? "-" : dept.Description)</td>
                                        <td>
                                            <span class="badge @(dept.Active ? "bg-success" : "bg-danger")">
                                                @(dept.Active ? "مفعل" : "معطل")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-outline-primary btn-sm py-0 px-2 me-1" @onclick="() => EditDepartment(dept)">
                                                <i class="bi bi-pencil"></i> تعديل
                                            </button>
                                            <button class="btn btn-outline-@(dept.Active ? "danger" : "success") btn-sm py-0 px-2" 
                                                    @onclick="() => ToggleDepartmentStatus(dept)">
                                                @(dept.Active ? "إيقاف" : "تفعيل")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. بطاقة إضافة / تعديل هيكل (الجانب الأيسر) -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 border-top border-primary border-3">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0 fw-bold text-primary">
                        @(currentDept.Id > 0 ? "✏️ تعديل بيانات هيكل" : "➕ إضافة هيكل جديد")
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary">كود القسم / الإدارة <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm font-monospace fw-bold" placeholder="مثال: 101 أو 300" 
                               @bind="currentDept.DepartmentCode" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary">اسم القسم / الإدارة <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm fw-bold" placeholder="مثال: قسم الشرقي / الإدارة المالية" 
                               @bind="currentDept.DepartmentName" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary">يتبع لإدارة (اختياري)</label>
                        <select class="form-select form-select-sm" @bind="currentDept.ParentDepartmentId">
                            <option value="">-- إدارة رئيسية (لا تتبع جهة أخرى) --</option>
                            @foreach (var parent in departments.Where(d => d.Id != currentDept.Id))
                            {
                                <option value="@parent.Id">@parent.DepartmentName (@parent.DepartmentCode)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">ملاحظات / وصف</label>
                        <textarea class="form-control form-control-sm" rows="3" placeholder="توصيف نشاط القسم أو اختصاصاته..." 
                                  @bind="currentDept.Description"></textarea>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="activeCheck" @bind="currentDept.Active" />
                        <label class="form-check-label small fw-bold" for="activeCheck">مفعل في النظام</label>
                    </div>

                    <div class="d-flex gap-2">
                        @if (currentDept.Id > 0)
                        {
                            <button type="button" class="btn btn-secondary btn-sm flex-fill" @onclick="ResetForm">إلغاء</button>
                        }
                        <button type="button" class="btn btn-primary btn-sm flex-fill fw-bold shadow-sm" 
                                disabled="@isSaving" @onclick="SaveDepartmentAsync">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-check2-circle"></i> @(currentDept.Id > 0 ? "تحديث البيانات" : "حفظ وإضافة")</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- نافذة استيراد الإكسيل الذكية (EXCEL IMPORT MODAL)              -->
<!-- ============================================================== -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد الهيكل التنظيمي من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> 
                        يمكنك حفظ شيت الإكسيل بصيغة <strong>CSV (UTF-8)</strong> ثم رفعه هنا مباشرة. 
                        أو استخدم 
                        <a href="javascript:void(0)" class="fw-bold text-decoration-underline" @onclick="DownloadTemplateAsync">تحميل القالب النموذجي</a>
                        لتعبئة البيانات بدقة.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة البيانات المقروءة من الملف (@importedPreviewList.Count سجل):</span>
                            <span class="badge bg-success">جاهز للاستيراد</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>الكود</th>
                                        <th class="text-start">الاسم</th>
                                        <th>كود الإدارة الأب</th>
                                        <th>الوصف</th>
                                        <th>الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@row.DepartmentCode</td>
                                            <td class="text-start fw-bold">@row.DepartmentName</td>
                                            <td>@(string.IsNullOrEmpty(row.ParentCode) ? "إدارة رئيسية" : row.ParentCode)</td>
                                            <td class="text-muted">@row.Description</td>
                                            <td>
                                                <span class="badge @(row.Active ? "bg-success" : "bg-secondary")">
                                                    @(row.Active ? "مفعل" : "معطل")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@(isSavingImport || !importedPreviewList.Any())" 
                            @onclick="ProcessAndSaveImportAsync">
                        @if (isSavingImport)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري حفظ السجلات في قاعدة البيانات...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check-circle"></i> تأكيد وحفظ كافة السجلات (@importedPreviewList.Count)</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    // ==========================================
    // DTOs & Models
    // ==========================================
    public class DepartmentItemDto
    {
        public long Id { get; set; }
        public long CompanyId { get; set; } = 1;
        public long? ParentDepartmentId { get; set; }
        public string DepartmentCode { get; set; } = string.Empty;
        public string DepartmentName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool Active { get; set; } = true;
    }

    public class DepartmentImportRowDto
    {
        public string DepartmentCode { get; set; } = string.Empty;
        public string DepartmentName { get; set; } = string.Empty;
        public string ParentCode { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public bool Active { get; set; } = true;
    }

    // ==========================================
    // States & Filter Variables
    // ==========================================
    private List<DepartmentItemDto> departments = new();
    private DepartmentItemDto currentDept = new();
    private List<DepartmentImportRowDto> importedPreviewList = new();

    // متغيرات الفلاتر
    private string searchTerm = "";
    private string selectedLevelFilter = "all";
    private long selectedParentFilter = -1;
    private string selectedStatusFilter = "all";

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isSavingImport = false;
    private bool isImportModalOpen = false;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartmentsAsync();
    }

    private async Task LoadDepartmentsAsync()
    {
        isLoading = true;
        try
        {
            departments = await Http.GetFromJsonAsync<List<DepartmentItemDto>>("api/departments") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب الأقسام: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ==========================================
    // محرك الفلترة المتعددة الذكي
    // ==========================================
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        selectedLevelFilter != "all" ||
        selectedParentFilter != -1 ||
        selectedStatusFilter != "all";

    private void ResetFilters()
    {
        searchTerm = "";
        selectedLevelFilter = "all";
        selectedParentFilter = -1;
        selectedStatusFilter = "all";
    }

    private IEnumerable<DepartmentItemDto> FilteredDepartments
    {
        get
        {
            var query = departments.AsEnumerable();

            // 1. فلتر البحث السريع (الاسم أو الكود أو الوصف)
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(d =>
                    d.DepartmentName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    d.DepartmentCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(d.Description) && d.Description.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            // 2. فلتر المستوى الهيكلي (إدارة رئيسية vs صالة/قسم فرعي)
            if (selectedLevelFilter == "root")
            {
                query = query.Where(d => d.ParentDepartmentId == null);
            }
            else if (selectedLevelFilter == "sub")
            {
                query = query.Where(d => d.ParentDepartmentId != null);
            }

            // 3. فلتر الإدارة الأب
            if (selectedParentFilter != -1)
            {
                query = query.Where(d => d.ParentDepartmentId == selectedParentFilter);
            }

            // 4. فلتر الحالة (مفعل / معطل)
            if (selectedStatusFilter == "active")
            {
                query = query.Where(d => d.Active);
            }
            else if (selectedStatusFilter == "inactive")
            {
                query = query.Where(d => !d.Active);
            }

            return query;
        }
    }

    private string GetParentName(long? parentId)
    {
        if (parentId == null) return "إدارة رئيسية";
        var parent = departments.FirstOrDefault(d => d.Id == parentId);
        return parent != null ? parent.DepartmentName : "جهة غير معروفة";
    }

    private void EditDepartment(DepartmentItemDto dept)
    {
        currentDept = new DepartmentItemDto
        {
            Id = dept.Id,
            CompanyId = dept.CompanyId,
            ParentDepartmentId = dept.ParentDepartmentId,
            DepartmentCode = dept.DepartmentCode,
            DepartmentName = dept.DepartmentName,
            Description = dept.Description,
            Active = dept.Active
        };
        errorMessage = null;
    }

    private void ResetForm()
    {
        currentDept = new DepartmentItemDto();
        errorMessage = null;
    }

    private async Task SaveDepartmentAsync()
    {
        if (string.IsNullOrWhiteSpace(currentDept.DepartmentName) || string.IsNullOrWhiteSpace(currentDept.DepartmentCode))
        {
            errorMessage = "يرجى إدخال كود واسم القسم بشكل صحيح.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        try
        {
            HttpResponseMessage res;
            if (currentDept.Id > 0)
            {
                res = await Http.PutAsJsonAsync($"api/departments/{currentDept.Id}", currentDept);
            }
            else
            {
                res = await Http.PostAsJsonAsync("api/departments", currentDept);
            }

            if (res.IsSuccessStatusCode)
            {
                successMessage = currentDept.Id > 0 ? "تم تحديث بيانات القسم بنجاح." : "تمت إضافة الهيكل الجديد بنجاح.";
                ResetForm();
                await LoadDepartmentsAsync();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                errorMessage = $"فشل الحفظ: {err}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء الاتصال: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleDepartmentStatus(DepartmentItemDto dept)
    {
        dept.Active = !dept.Active;
        try
        {
            var res = await Http.PutAsJsonAsync($"api/departments/{dept.Id}", dept);
            if (res.IsSuccessStatusCode)
            {
                successMessage = $"تم تغيير حالة القسم إلى: {(dept.Active ? "مفعل" : "معطل")}";
                await LoadDepartmentsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر تعديل الحالة: {ex.Message}";
        }
    }

    // ==========================================
    // محرك التصدير إلى إكسيل (يدعم نتائج الفلترة المحددة)
    // ==========================================
    private async Task ExportToExcelAsync()
    {
        var listToExport = FilteredDepartments.ToList();

        if (!listToExport.Any())
        {
            errorMessage = "لا توجد سجلات مطابقة للفلترة لتصديرها.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("الكود,الاسم,الجهة_التابع_لها,الوصف,الحالة");

            foreach (var d in listToExport)
            {
                var parentName = GetParentName(d.ParentDepartmentId).Replace(",", " - ");
                var desc = (d.Description ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");
                var status = d.Active ? "مفعل" : "معطل";
                sb.AppendLine($"{EscapeCsv(d.DepartmentCode)},{EscapeCsv(d.DepartmentName)},{EscapeCsv(parentName)},{EscapeCsv(desc)},{status}");
            }

            var fileName = $"الهيكل_التنظيمي_أبو_عادل_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            successMessage = $"تم تصدير ({listToExport.Count}) قسماً إلى إكسيل بنجاح.";
        }
        catch (Exception ex)
        {
            errorMessage = $"حدث خطأ أثناء التصدير: {ex.Message}";
        }
    }

    private async Task DownloadTemplateAsync()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("كود_القسم,اسم_القسم,كود_الإدارة_الأب,الوصف,الحالة");
            sb.AppendLine("1,الإدارة العليا,,الإدارة العامة للمؤسسة,1");
            sb.AppendLine("2,إدارة الإنتاج,1,إدارة شؤون التصنيع,1");
            sb.AppendLine("300,قسم الشرقي,2,صالة تصنيع الحلويات الشرقية,1");

            var fileName = "قالب_استيراد_الأقسام_أبو_عادل.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل تحميل القالب: {ex.Message}";
        }
    }

    private async Task TriggerBrowserDownload(string fileName, string content)
    {
        var utf8WithBom = "\uFEFF" + content;
        var jsCommand = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", jsCommand);
    }

    private string EscapeCsv(string val)
    {
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n"))
        {
            return $"\"{val.Replace("\"", "\"\"")}\"";
        }
        return val;
    }

    // ==========================================
    // محرك الاستيراد من الإكسيل (Excel / CSV Parser)
    // ==========================================
    private void OpenImportModal()
    {
        importedPreviewList.Clear();
        errorMessage = null;
        isImportModalOpen = true;
    }

    private void CloseImportModal()
    {
        isImportModalOpen = false;
        importedPreviewList.Clear();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        errorMessage = null;

        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1)
            {
                errorMessage = "الملف المرفوع فارغ أو لا يحتوي على صفوف بيانات.";
                return;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = ParseCsvLine(line);
                if (cols.Count >= 2)
                {
                    importedPreviewList.Add(new DepartmentImportRowDto
                    {
                        DepartmentCode = cols[0].Trim(),
                        DepartmentName = cols[1].Trim(),
                        ParentCode = cols.Count > 2 ? cols[2].Trim() : "",
                        Description = cols.Count > 3 ? cols[3].Trim() : "",
                        Active = cols.Count <= 4 || (cols[4].Trim() == "1" || cols[4].Trim().Equals("مفعل", StringComparison.OrdinalIgnoreCase) || cols[4].Trim().Equals("true", StringComparison.OrdinalIgnoreCase))
                    });
                }
            }

            if (!importedPreviewList.Any())
            {
                errorMessage = "تعذر استخراج بيانات من الملف. يرجى التأكد من التنسيق.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل قراءة الملف: {ex.Message}";
        }
    }

    private List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var curVal = new StringBuilder();

        foreach (char c in line)
        {
            if (c == '\"') inQuotes = !inQuotes;
            else if (c == ',' && !inQuotes)
            {
                result.Add(curVal.ToString());
                curVal.Clear();
            }
            else curVal.Append(c);
        }
        result.Add(curVal.ToString());
        return result;
    }

    private async Task ProcessAndSaveImportAsync()
    {
        if (!importedPreviewList.Any()) return;

        isSavingImport = true;
        errorMessage = null;

        try
        {
            int successCount = 0;

            var roots = importedPreviewList.Where(r => string.IsNullOrEmpty(r.ParentCode)).ToList();
            var children = importedPreviewList.Where(r => !string.IsNullOrEmpty(r.ParentCode)).ToList();

            foreach (var r in roots)
            {
                var dto = new DepartmentItemDto
                {
                    CompanyId = 1,
                    DepartmentCode = r.DepartmentCode,
                    DepartmentName = r.DepartmentName,
                    Description = r.Description,
                    Active = r.Active
                };
                var res = await Http.PostAsJsonAsync("api/departments", dto);
                if (res.IsSuccessStatusCode) successCount++;
            }

            await LoadDepartmentsAsync();

            foreach (var c in children)
            {
                var parent = departments.FirstOrDefault(d => d.DepartmentCode == c.ParentCode);
                var dto = new DepartmentItemDto
                {
                    CompanyId = 1,
                    ParentDepartmentId = parent?.Id,
                    DepartmentCode = c.DepartmentCode,
                    DepartmentName = c.DepartmentName,
                    Description = c.Description,
                    Active = c.Active
                };
                var res = await Http.PostAsJsonAsync("api/departments", dto);
                if (res.IsSuccessStatusCode) successCount++;
            }

            successMessage = $"تم استيراد ({successCount}) قسماً وإدراجها بالهيكل التنظيمي بنجاح.";
            CloseImportModal();
            await LoadDepartmentsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء حفظ المستورد: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }
