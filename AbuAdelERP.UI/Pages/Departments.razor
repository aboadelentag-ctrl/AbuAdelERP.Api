@page "/departments"
@inject HttpClient Http
@using System.Net.Http.Json

<div class="container-fluid mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="text-primary m-0 mb-1">🏢 إدارة الأقسام والإدارات</h3>
            <span class="text-muted">تعريف الهيكل التنظيمي (إدارة عليا ⬅️ إدارة ⬅️ قسم)</span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-top border-primary border-4">
                <div class="card-header bg-white py-3">
                    <h5 class="text-primary m-0 fw-bold">@(isEditMode ? "تعديل بيانات" : "إضافة هيكل جديد")</h5>
                </div>
                <div class="card-body bg-light">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger fw-bold shadow-sm">@errorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">كود القسم / الإدارة</label>
                        <input type="text" class="form-control border-primary" @bind="currentDepartment.DepartmentCode" placeholder="مثال: 101" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">الاسم</label>
                        <input type="text" class="form-control border-primary" @bind="currentDepartment.DepartmentName" placeholder="مثال: الإدارة المالية" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">يتبع لإدارة (اختياري)</label>
                        <select class="form-select border-primary" @bind="currentDepartment.ParentDepartmentId">
                            <option value="">-- إدارة رئيسية (لا تتبع جهة أخرى) --</option>
                            @foreach (var dept in departments.Where(d => d.Id != currentDepartment.Id))
                            {
                                <option value="@dept.Id">@dept.DepartmentName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">ملاحظات / وصف</label>
                        <textarea class="form-control border-primary" @bind="currentDepartment.Description" rows="2"></textarea>
                    </div>
                    <div class="mb-4 form-check mt-3">
                        <input type="checkbox" class="form-check-input border-primary" id="isActive" @bind="currentDepartment.Active" style="transform: scale(1.4); margin-left: 10px;" />
                        <label class="form-check-label fw-bold text-dark" for="isActive">مفعل</label>
                    </div>

                    <div class="d-grid gap-2">
                        <!-- تعطيل الزر أثناء الحفظ لمنع النقرات المزدوجة -->
                        <button class="btn btn-primary fw-bold shadow" @onclick="SaveDepartment" disabled="@isSubmitting">
                            @(isSubmitting ? "⏳ جاري الحفظ..." : (isEditMode ? "💾 حفظ التعديلات" : "➕ حفظ وإضافة"))
                        </button>
                        @if (isEditMode)
                        {
                            <button class="btn btn-outline-secondary fw-bold" @onclick="ResetForm" disabled="@isSubmitting">❌ إلغاء التعديل</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0 table-responsive">
                    @if (isLoading)
                    {
                        <div class="p-5 text-center text-primary fw-bold">
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            ⏳ جاري تحميل الهيكل...
                        </div>
                    }
                    else if (departments == null || !departments.Any())
                    {
                        <div class="p-5 text-center text-muted fw-bold">⚠️ لا توجد إدارات أو أقسام مسجلة حالياً.</div>
                    }
                    else
                    {
                        <table class="table table-hover table-bordered mb-0 text-center align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>الكود</th>
                                    <th>الاسم</th>
                                    <th>الجهة التابع لها (الأب)</th>
                                    <th>الوصف</th>
                                    <th>الحالة</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in departments.OrderBy(d => d.ParentDepartmentId).ThenBy(d => d.DepartmentCode))
                                {
                                    <tr class="@(dept.Active ? "" : "bg-light text-muted")">
                                        <td class="fw-bold">@dept.DepartmentCode</td>
                                        <td class="text-primary fw-bold">@dept.DepartmentName</td>
                                        <td class="fw-bold text-secondary">
                                            @(string.IsNullOrEmpty(dept.ParentDepartmentName) ? "👑 إدارة رئيسية" : dept.ParentDepartmentName)
                                        </td>
                                        <td>@dept.Description</td>
                                        <td>
                                            @if (dept.Active)
                                            {
                                                <span class="badge bg-success">مفعل</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">موقوف</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary m-1" @onclick="() => EditDepartment(dept)">✏️ تعديل</button>
                                            <button class="btn btn-sm @(dept.Active ? "btn-outline-danger" : "btn-outline-success") m-1" @onclick="() => ToggleActiveStatus(dept)">
                                                @(dept.Active ? "⏸️ إيقاف" : "▶️ تفعيل")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<DepartmentDto> departments = new();
    private DepartmentDto currentDepartment = new DepartmentDto { Active = true };

    private bool isLoading = true;
    private bool isEditMode = false;
    private bool isSubmitting = false; // المتغير الجديد لمنع الدبل كليك

    private string errorMessage = "";
    private string apiUrl = "api/Departments";

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartments();
    }

    private async Task LoadDepartments()
    {
        isLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<DepartmentDto>>(apiUrl);
            if (result != null)
            {
                departments = result;
                foreach (var dept in departments)
                {
                    if (dept.ParentDepartmentId.HasValue)
                    {
                        var parent = departments.FirstOrDefault(d => d.Id == dept.ParentDepartmentId.Value);
                        if (parent != null)
                        {
                            dept.ParentDepartmentName = parent.DepartmentName;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ في الاتصال بالسيرفر.";
        }
        isLoading = false;
    }

    private async Task SaveDepartment()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(currentDepartment.DepartmentName) || string.IsNullOrWhiteSpace(currentDepartment.DepartmentCode))
        {
            errorMessage = "الرجاء إدخال اسم وكود الإدارة أولاً.";
            return;
        }

        isSubmitting = true; // تعطيل الزر

        try
        {
            if (isEditMode)
            {
                var response = await Http.PutAsJsonAsync($"{apiUrl}/{currentDepartment.Id}", currentDepartment);
                if (response.IsSuccessStatusCode)
                {
                    await LoadDepartments();
                    ResetForm();
                }
                else
                {
                    var errorDetails = await response.Content.ReadAsStringAsync();
                    errorMessage = string.IsNullOrWhiteSpace(errorDetails) ? "❌ حدث خطأ أثناء التعديل." : $"❌ {errorDetails}";
                }
            }
            else
            {
                var response = await Http.PostAsJsonAsync(apiUrl, currentDepartment);
                if (response.IsSuccessStatusCode)
                {
                    await LoadDepartments();
                    ResetForm();
                }
                else
                {
                    var errorDetails = await response.Content.ReadAsStringAsync();
                    errorMessage = string.IsNullOrWhiteSpace(errorDetails) ? "❌ حدث خطأ أثناء الحفظ." : $"❌ {errorDetails}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "خطأ: " + ex.Message;
        }
        finally
        {
            isSubmitting = false; // إعادة تفعيل الزر في كل الأحوال
        }
    }

    private void EditDepartment(DepartmentDto dept)
    {
        currentDepartment = new DepartmentDto
        {
            Id = dept.Id,
            DepartmentName = dept.DepartmentName,
            DepartmentCode = dept.DepartmentCode,
            Description = dept.Description,
            CompanyId = dept.CompanyId,
            Active = dept.Active,
            ParentDepartmentId = dept.ParentDepartmentId
        };
        isEditMode = true;
        errorMessage = "";
    }

    private async Task ToggleActiveStatus(DepartmentDto dept)
    {
        dept.Active = !dept.Active;
        try
        {
            await Http.PutAsJsonAsync($"{apiUrl}/{dept.Id}", dept);
            await LoadDepartments();
        }
        catch
        {
            dept.Active = !dept.Active; // التراجع في حالة الخطأ
        }
    }

    private void ResetForm()
    {
        currentDepartment = new DepartmentDto { Active = true };
        isEditMode = false;
        errorMessage = "";
    }

    public class DepartmentDto
    {
        public long Id { get; set; }
        public long CompanyId { get; set; }
        public bool Active { get; set; }
        public string DepartmentName { get; set; } = string.Empty;
        public string DepartmentCode { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public long? ParentDepartmentId { get; set; }
        public string ParentDepartmentName { get; set; } = string.Empty;
    }
}