@page "/item-categories"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>تصنيفات الأصناف والمواد - حلواني أبو عادل</PageTitle>

<div class="container-fluid mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-2">
        <div>
            <h3 class="text-warning m-0 mb-1 fw-bold" style="color:#d39e00 !important;">
                <i class="bi bi-tags-fill me-2"></i>تصنيفات ومجموعات الأصناف
            </h3>
            <span class="text-muted small">إدارة مجموعات وتصنيفات المواد الخام والمنتجات التامة والوسيطة ومواد التعبئة</span>
        </div>
        <button class="btn btn-outline-secondary btn-sm fw-bold shadow-sm" @onclick="LoadCategories" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise me-1"></i> تحديث
        </button>
    </div>

    <div class="row">
        <!-- نموذج الإضافة / التعديل -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-top border-warning border-4 rounded-3">
                <div class="card-header bg-white py-3">
                    <h5 class="text-warning m-0 fw-bold" style="color:#d39e00 !important;">
                        @(isEditMode ? "✏️ تعديل بيانات التصنيف" : "➕ إضافة تصنيف جديد")
                    </h5>
                </div>
                <div class="card-body bg-light p-3">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger fw-bold shadow-sm py-2 mb-3">@errorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success fw-bold shadow-sm py-2 mb-3">@successMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">الشركة التابع لها التصنيف <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm border-warning fw-bold" @bind="currentCategory.CompanyId">
                            <option value="0">-- اختر الشركة --</option>
                            @foreach (var comp in companiesList)
                            {
                                <option value="@comp.Id">@comp.CompanyName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">كود التصنيف <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm font-monospace fw-bold border-warning" @bind="currentCategory.CategoryCode" placeholder="مثال: CAT-01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">اسم التصنيف <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm fw-bold border-warning" @bind="currentCategory.CategoryName" placeholder="مثال: خامات التعبئة / حلويات شرقية" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">نوع الأصناف في هذا التصنيف <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm border-warning fw-bold" @bind="currentCategory.ItemType">
                            <option value="">-- اختر النوع --</option>
                            <option value="منتج تام">🍰 منتج تام (حلويات وتام)</option>
                            <option value="نصف مصنع">🥣 نصف مصنع / خلطات وتجهيزات</option>
                            <option value="خامات">🌾 خامات ومستلزمات أولية</option>
                            <option value="مواد تعبئة وتغليف">📦 مواد تعبئة وتغليف</option>
                            <option value="أصول / حاويات تداول">🛒 أصول / حاويات تداول (أسبات وصواني)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">الوصف / ملاحظات</label>
                        <textarea class="form-control form-control-sm" @bind="currentCategory.Description" rows="2" placeholder="ملاحظات توضيحية عن التصنيف..."></textarea>
                    </div>

                    <div class="mb-4 form-check mt-3">
                        <input type="checkbox" class="form-check-input border-warning" id="isActive" @bind="currentCategory.Active" style="transform: scale(1.3); margin-left: 10px;" />
                        <label class="form-check-label fw-bold text-dark small" for="isActive">التصنيف مفعل ومتاح للاستخدام</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-warning fw-bold shadow text-dark" @onclick="SaveCategory" disabled="@isProcessing">
                            @(isProcessing ? "⏳ جاري الحفظ..." : (isEditMode ? "💾 حفظ التعديلات" : "➕ إضافة التصنيف"))
                        </button>
                        @if (isEditMode)
                        {
                            <button class="btn btn-outline-secondary btn-sm fw-bold" @onclick="ResetForm">❌ إلغاء التعديل</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- جدول العرض -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="mb-0 fw-bold text-dark">سجل التصنيفات المسجلة (@FilteredCategories.Count())</h6>
                    <div style="max-width: 250px;">
                        <input type="text" class="form-control form-control-sm" placeholder="بحث بالاسم أو الكود..." 
                               @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="card-body p-0 table-responsive">
                    @if (isLoading)
                    {
                        <div class="p-5 text-center text-warning fw-bold">
                            <div class="spinner-border spinner-border-sm me-2"></div> جاري تحميل التصنيفات...
                        </div>
                    }
                    else if (!FilteredCategories.Any())
                    {
                        <div class="p-5 text-center text-muted fw-bold">⚠️ لا توجد تصنيفات مطابقة.</div>
                    }
                    else
                    {
                        <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 70px;">ID</th>
                                    <th>الكود</th>
                                    <th class="text-start ps-3">اسم التصنيف</th>
                                    <th>النوع المرتبط</th>
                                    <th>الحالة</th>
                                    <th style="width: 150px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in FilteredCategories)
                                {
                                    <tr class="@(cat.Active ? "" : "bg-light text-muted")">
                                        <td class="font-monospace text-secondary fw-bold">@cat.Id</td>
                                        <td class="font-monospace fw-bold">@cat.CategoryCode</td>
                                        <td class="text-start ps-3 fw-bold" style="color:#d39e00 !important;">@cat.CategoryName</td>
                                        <td><span class="badge @GetTypeBadge(cat.ItemType)">@cat.ItemType</span></td>
                                        <td>
                                            <span class="badge @(cat.Active ? "bg-success" : "bg-danger")">
                                                @(cat.Active ? "مفعل" : "موقوف")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning text-dark fw-bold py-0 px-2 me-1" @onclick="() => EditCategory(cat)">
                                                ✏️ تعديل
                                            </button>
                                            <button class="btn btn-sm btn-outline-@(cat.Active ? "danger" : "success") fw-bold py-0 px-2" @onclick="() => ToggleCategoryStatus(cat)">
                                                @(cat.Active ? "إيقاف" : "تفعيل")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ItemCategoryDto> categories = new();
    private List<CompanyDropdownDto> companiesList = new();

    private ItemCategoryDto currentCategory = new ItemCategoryDto { Active = true };
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool isEditMode = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string searchTerm = "";

    private IEnumerable<ItemCategoryDto> FilteredCategories =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? categories
            : categories.Where(c => (c.CategoryName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                   (c.CategoryCode?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
        await LoadCategories();
    }

    private async Task LoadCompanies()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<CompanyDropdownDto>>("api/Companies");
            if (result != null && result.Any())
            {
                companiesList = result;
                if (currentCategory.CompanyId == 0)
                {
                    currentCategory.CompanyId = companiesList.First().Id;
                }
            }
            else
            {
                companiesList = new List<CompanyDropdownDto> { new CompanyDropdownDto { Id = 1, CompanyName = "شركة حلواني أبو عادل" } };
                currentCategory.CompanyId = 1;
            }
        }
        catch
        {
            companiesList = new List<CompanyDropdownDto> { new CompanyDropdownDto { Id = 1, CompanyName = "شركة حلواني أبو عادل" } };
            currentCategory.CompanyId = 1;
        }
    }

    private async Task LoadCategories()
    {
        isLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<ItemCategoryDto>>("api/ItemCategories");
            if (result != null) categories = result;
        }
        catch (Exception ex) 
        { 
            errorMessage = "خطأ في الاتصال: " + ex.Message; 
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveCategory()
    {
        errorMessage = "";
        successMessage = "";

        if (currentCategory.CompanyId == 0)
        {
            errorMessage = "الرجاء اختيار الشركة أولاً.";
            return;
        }

        if (string.IsNullOrWhiteSpace(currentCategory.CategoryName) || string.IsNullOrWhiteSpace(currentCategory.CategoryCode) || string.IsNullOrWhiteSpace(currentCategory.ItemType))
        {
            errorMessage = "الرجاء إدخال الكود والاسم ونوع التصنيف.";
            return;
        }

        isProcessing = true;
        try
        {
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await Http.PutAsJsonAsync($"api/ItemCategories/{currentCategory.Id}", currentCategory);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/ItemCategories", currentCategory);
            }

            if (response.IsSuccessStatusCode)
            {
                successMessage = "✅ تم حفظ التصنيف بنجاح!";
                await LoadCategories();
                ResetForm();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex) 
        { 
            errorMessage = "خطأ: " + ex.Message; 
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ToggleCategoryStatus(ItemCategoryDto cat)
    {
        try
        {
            var res = await Http.PatchAsync($"api/ItemCategories/{cat.Id}/toggle-status", null);
            if (res.IsSuccessStatusCode)
            {
                cat.Active = !cat.Active;
                successMessage = $"تم تغيير حالة التصنيف [{cat.CategoryName}] بنجاح.";
            }
            else
            {
                errorMessage = "تعذر تغيير حالة التصنيف.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ: {ex.Message}";
        }
    }

    private void EditCategory(ItemCategoryDto cat)
    {
        currentCategory = new ItemCategoryDto
        {
            Id = cat.Id,
            CompanyId = cat.CompanyId > 0 ? cat.CompanyId : (companiesList.FirstOrDefault()?.Id ?? 1),
            CategoryCode = cat.CategoryCode,
            CategoryName = cat.CategoryName,
            ItemType = cat.ItemType,
            Description = cat.Description,
            Active = cat.Active
        };
        isEditMode = true;
        errorMessage = "";
        successMessage = "";
    }

    private void ResetForm()
    {
        currentCategory = new ItemCategoryDto 
        { 
            Active = true,
            CompanyId = companiesList.FirstOrDefault()?.Id ?? 1
        };
        isEditMode = false;
    }

    private string GetTypeBadge(string type) => type switch
    {
        "منتج تام" => "bg-primary",
        "نصف مصنع" => "bg-warning text-dark",
        "خامات" => "bg-success",
        "مواد تعبئة وتغليف" => "bg-info text-dark",
        "أصول / حاويات تداول" => "bg-secondary",
        _ => "bg-dark"
    };

    public class ItemCategoryDto
    {
        public long Id { get; set; }
        public long CompanyId { get; set; }
        public string CategoryName { get; set; } = string.Empty;
        public string CategoryCode { get; set; } = string.Empty;
        public string ItemType { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool Active { get; set; } = true;
    }

    public class CompanyDropdownDto
    {
        public long Id { get; set; }
        public string CompanyName { get; set; } = string.Empty;
    }
}