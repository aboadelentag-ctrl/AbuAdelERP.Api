                else
                {
                    sb.AppendLine($"{EscapeCsv(inv.OrderNumber)},{EscapeCsv(inv.SupplierName)},{inv.OrderDate:yyyy-MM-dd},-,-,-,-,-,-,-,-,{inv.TotalAmount:F2},معتمدة للاستلام المخزني");
