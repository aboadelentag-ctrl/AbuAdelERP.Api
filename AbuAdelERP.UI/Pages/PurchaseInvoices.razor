    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1) return;

            var header = lines[0].Split(',');
            int invIdx = 0, supIdx = 1, dateIdx = 2, codeIdx = 3, nameIdx = 4, qtyIdx = 5, priceIdx = 6, notesIdx = 7;

            for (int i = 0; i < header.Length; i++)
            {
                var h = header[i].Trim().ToLower();
                if (h.Contains("فاتورة") || h.Contains("امر") || h.Contains("order")) invIdx = i;
                else if (h.Contains("مورد") || h.Contains("supplier")) supIdx = i;
                else if (h.Contains("تاريخ") || h.Contains("date")) dateIdx = i;
                else if (h.Contains("كود") || h.Contains("code")) codeIdx = i;
                else if (h.Contains("اسم") || h.Contains("صنف") || h.Contains("خام")) nameIdx = i;
                else if (h.Contains("كمي") || h.Contains("qty")) qtyIdx = i;
                else if (h.Contains("سعر") || h.Contains("price")) priceIdx = i;
                else if (h.Contains("ملاحظ") || h.Contains("notes")) notesIdx = i;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = line.Split(',');
                if (cols.Length >= 4)
                {
                    decimal.TryParse(qtyIdx < cols.Length ? cols[qtyIdx].Trim() : "1", out var qty);
                    decimal.TryParse(priceIdx < cols.Length ? cols[priceIdx].Trim() : "0", out var price);

                    DateTime invDate = DateTime.Today;
                    if (dateIdx < cols.Length && DateTime.TryParse(cols[dateIdx].Trim(), out var parsedDate))
                    {
                        invDate = parsedDate;
                    }

                    importedPreviewList.Add(new InvoiceImportRowDto
                    {
                        OrderNumber = invIdx < cols.Length ? cols[invIdx].Trim() : $"INV-{DateTime.Now:yyyyMMdd}",
                        SupplierName = supIdx < cols.Length ? cols[supIdx].Trim() : "",
                        OrderDate = invDate,
                        ItemCode = codeIdx < cols.Length ? cols[codeIdx].Trim() : "",
                        ItemName = nameIdx < cols.Length ? cols[nameIdx].Trim() : "",
                        Quantity = qty,
                        UnitPrice = price,
                        Notes = (notesIdx != -1 && notesIdx < cols.Length) ? cols[notesIdx].Trim() : ""
                    });
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ في قراءة ملف الإكسيل: {ex.Message}";
        }
    }

    private async Task ProcessAndSaveImportAsync()
    {
        if (!importedPreviewList.Any()) return;

        isSavingImport = true;
        try
        {
            var groups = importedPreviewList.GroupBy(x => x.OrderNumber).ToList();
            int count = 0;

            foreach (var group in groups)
            {
                var first = group.First();
                var sup = suppliers.FirstOrDefault(s => s.SupplierName.Contains(first.SupplierName) || first.SupplierName.Contains(s.SupplierName));

                var orderPayload = new
                {
                    CompanyId = 1,
                    SupplierId = sup?.Id ?? 0,
                    WarehouseId = 1,
                    OrderNumber = group.Key,
                    OrderDate = first.OrderDate,
                    Status = "Approved",
                    Lines = group.Select(row =>
                    {
                        var itm = items.FirstOrDefault(i => (!string.IsNullOrEmpty(row.ItemCode) && i.ItemCode == row.ItemCode) || i.ItemName.Contains(row.ItemName));
                        return new
                        {
                            ItemId = itm?.Id ?? 1,
                            Quantity = row.Quantity,
                            UnitPrice = row.UnitPrice,
                            Notes = row.Notes
                        };
                    }).ToList()
                };

                var res = await Http.PostAsJsonAsync("api/PurchaseOrders", orderPayload);
                if (res.IsSuccessStatusCode) count++;
            }

            isSuccess = true;
            statusMessage = $"تم استيراد واعتماد ({count}) فاتورة بنجاح!";
            CloseImportModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"خطأ أثناء حفظ الفواتير: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }

    private async Task TriggerBrowserDownload(string fileName, string content)
    {
        var utf8WithBom = "\uFEFF" + content;
        var jsCommand = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", jsCommand);
    }

    private string EscapeCsv(string val)
    {
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n"))
            return $"\"{val.Replace("\"", "\"\"")}\"";
        return val;
    }

