        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("رقم_الفاتورة,اسم_المورد,تاريخ_الفاتورة,كود_الصنف,اسم_الصنف_الخامة,نوع_الخامة,الوحدة,الكمية,سعر_الوحدة,إجمالي_البند,ملاحظات_البند,إجمالي_الفاتورة,الحالة");

            foreach (var inv in list)
            {
                if (inv.Lines != null && inv.Lines.Any())
                {
                    foreach (var line in inv.Lines)
                    {
                        var itm = items.FirstOrDefault(i => i.Id == line.ItemId);
                        var itemCode = !string.IsNullOrEmpty(line.ItemCode) ? line.ItemCode : (itm?.ItemCode ?? "-");
                        var itemName = !string.IsNullOrEmpty(line.ItemName) ? line.ItemName : (itm?.ItemName ?? "خامة");
                        var itemType = itm?.ItemType ?? "خامات";
                        var unit = !string.IsNullOrEmpty(line.Unit) ? line.Unit : (itm?.Unit ?? "-");
                        var lineTotal = line.LineTotal > 0 ? line.LineTotal : (line.Quantity * line.UnitPrice);
                        var cleanNotes = (line.Notes ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");

                        sb.AppendLine($"{EscapeCsv(inv.OrderNumber)},{EscapeCsv(inv.SupplierName)},{inv.OrderDate:yyyy-MM-dd},{EscapeCsv(itemCode)},{EscapeCsv(itemName)},{EscapeCsv(itemType)},{EscapeCsv(unit)},{line.Quantity},{line.UnitPrice},{lineTotal},{EscapeCsv(cleanNotes)},{inv.TotalAmount:F2},معتمدة للاستلام المخزني");
