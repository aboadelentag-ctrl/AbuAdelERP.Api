@page "/purchase-invoices"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<!-- تنسيقات الطباعة الرسمية النظيفة لمنع إخفاء محتويات الفاتورة -->
<style>
    @@media print {
        /* إخفاء عناصر التحكم والأزرار والقوائم */
        .d-print-none, 
        .card-header button, 
        .btn, 
        .alert, 
        .nav, 
        .sidebar, 
        header {
            display: none !important;
        }
        
        body {
            background-color: #fff !important;
            font-size: 11pt !important;
            color: #000 !important;
            direction: rtl !important;
        }

        .print-invoice-sheet {
            display: block !important;
            page-break-after: always;
            margin-bottom: 25px;
            padding: 15px;
            border: 2px solid #333 !important;
            border-radius: 6px;
        }

        .table-print {
            width: 100% !important;
            border-collapse: collapse !important;
            margin-top: 15px;
            margin-bottom: 15px;
        }

        .table-print th, .table-print td {
            border: 1px solid #333 !important;
            padding: 6px 8px !important;
            text-align: center !important;
            font-size: 10.5pt !important;
        }

        .table-print th {
            background-color: #f2f2f2 !important;
            font-weight: bold !important;
            -webkit-print-color-adjust: exact;
        }
    }
</style>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة وأزرار التصدير والاستيراد والتحديث -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-start border-primary border-4 d-print-none">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="mb-1 text-dark fw-bold">🧾 مراجعة أوامر الشراء واعتماد فواتير التوريد</h4>
                <small class="text-muted">تحديد المورد وتعديل سعر الوحدة وتدوين ملاحظات كل صنف بشكل مستقل قبل التوجيه للاستلام المخزني</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportApprovedInvoicesToExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير تفاصيل الفواتير (إكسيل)
                </button>
                <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                    <i class="bi bi-download me-1"></i> تحميل قالب الفواتير
                </button>
                <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                    <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد فواتير من إكسيل
                </button>
                <button class="btn btn-outline-warning text-dark btn-sm fw-bold shadow-sm" @onclick="ExportPendingOrdersToExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير الأوامر المعلقة
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadData">
                    <i class="bi bi-arrow-clockwise"></i> تحديث
                </button>
            </div>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mb-3 py-2 fw-bold d-print-none" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>
            <strong>@(isSuccess ? "نجاح:" : "تنبيه:")</strong> @statusMessage
            <button type="button" class="btn-close py-2" @onclick='() => statusMessage = string.Empty'></button>
        </div>
    }

    <!-- بطاقات الإحصائيات المالية اللحظية (Financial KPIs) -->
    <div class="row g-3 mb-3 d-print-none">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-warning border-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold">أوامر معلقة بانتظار التسعير</small>
                        <h4 class="mb-0 fw-bold text-warning mt-1">@(pendingOrders?.Count ?? 0) أمر</h4>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-hourglass-split fs-4 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold">فواتير معتمدة جاهزة للاستلام</small>
                        <h4 class="mb-0 fw-bold text-success mt-1">@(approvedOrders?.Count ?? 0) فاتورة</h4>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-receipt-cutoff fs-4 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold">إجمالي قيمة الفواتير المعتمدة</small>
                        <h4 class="mb-0 fw-bold text-primary mt-1 font-monospace">@((approvedOrders?.Sum(x => x.TotalAmount) ?? 0).ToString("N2")) ج.م</h4>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-cash-stack fs-4 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- شريط فلاتر البحث المتقدمة + زر الطباعة الشاملة بجوار الفلاتر -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-top border-primary border-3 d-print-none">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <!-- 1. بحث برقم الأمر أو المورد -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">🔍 بحث (رقم الفاتورة / اسم المورد)</label>
                    <input type="text" class="form-control form-control-sm" placeholder="ابحث برقم الفاتورة أو المورد..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>

                <!-- 2. فلتر المورد -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">🏢 تصفية بمورد محدد</label>
                    <select class="form-select form-select-sm fw-bold" @bind="selectedSupplierFilter">
                        <option value="0">-- كل الموردين --</option>
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.Id">@s.SupplierName</option>
                        }
                    </select>
                </div>

                <!-- 3. من تاريخ -->
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">من تاريخ</label>
                    <input type="date" class="form-control form-control-sm font-monospace" @bind="filterDateFrom" />
                </div>

                <!-- 4. إلى تاريخ -->
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">إلى تاريخ</label>
                    <input type="date" class="form-control form-control-sm font-monospace" @bind="filterDateTo" />
                </div>

                <!-- 5. زر الطباعة بجوار الفلاتر -->
                <div class="col-md-2 d-flex align-items-end gap-1">
                    <button class="btn btn-primary btn-sm flex-fill fw-bold shadow-sm" title="طباعة كافة الفواتير وبنودها" @onclick="PrintAllDetailedInvoices">
                        🖨️ طباعة الكشف
                    </button>
                    <button class="btn btn-outline-danger btn-sm" title="تفريغ الفلاتر" @onclick="ResetFilters">✕</button>
                </div>
            </div>

            @if (HasActiveFilters)
            {
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    <span class="small text-primary fw-bold">
                        <i class="bi bi-funnel-fill me-1"></i> نتائج الفلترة: (@FilteredApprovedOrders.Count() فاتورة معتمدة | @FilteredPendingOrders.Count() أمر معلق)
                    </span>
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" style="font-size: 0.78rem;" @onclick="ResetFilters">
                        ✕ إلغاء الفلاتر وعرض الكل
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- كارت الأوامر المعلقة بانتظار التسعير وتحديد الموردين -->
    <div class="card shadow-sm border-0 border-top border-warning border-3 mb-4 bg-white d-print-none">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">⏳ أوامر شراء بانتظار المراجعة والتسعير وتحديد الموردين</h6>
            <span class="badge bg-warning text-dark fs-6">@FilteredPendingOrders.Count() أوامر معلقة</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle text-center small">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 15%;">رقم الأمر</th>
                            <th class="text-start ps-3" style="width: 25%;">المورد المبدئي</th>
                            <th style="width: 15%;">تاريخ الأمر</th>
                            <th style="width: 15%;">عدد البنود</th>
                            <th style="width: 15%;">القيمة التقديرية</th>
                            <th style="width: 15%;">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pendingOrders == null)
                        {
                            <tr><td colspan="6" class="py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري تحميل الأوامر المعلقة...</td></tr>
                        }
                        else if (!FilteredPendingOrders.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    لا توجد أوامر شراء معلقة بحاجة إلى تسعير حالياً مطابقة لخيارات الفلترة.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var po in FilteredPendingOrders)
                            {
                                <tr class="@(selectedOrder?.Id == po.Id ? "table-primary" : "")" @key="po.Id">
                                    <td class="fw-bold font-monospace text-primary">@po.OrderNumber</td>
                                    <td class="text-start ps-3 fw-bold">@(string.IsNullOrEmpty(po.SupplierName) ? "غير محدد" : po.SupplierName)</td>
                                    <td class="font-monospace text-muted">@po.OrderDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-secondary">@(po.Lines?.Count ?? 1) بنود</span></td>
                                    <td class="fw-bold text-success font-monospace">@po.TotalAmount.ToString("N2") ج.م</td>
                                    <td>
                                        <button class="btn btn-warning btn-sm fw-bold px-3 shadow-sm" @onclick="() => SelectOrderForPricing(po.Id)">
                                            ✏️ مراجعة وتسعير وتحديد المورد
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- بطاقة فتح الأمر وتخصيص الموردين والأسعار والملاحظات لكل صنف -->
    @if (selectedOrder != null)
    {
        <div class="card shadow border-primary mb-4 border-2 d-print-none">
            <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">📦 تخصيص الموردين وتسعير البنود للأمر: [@selectedOrder.OrderNumber]</h6>
                <span class="badge bg-white text-primary fw-bold">تاريخ الأمر: @selectedOrder.OrderDate.ToString("yyyy-MM-dd")</span>
            </div>
            <div class="card-body p-3 bg-light">
                
                <div class="p-3 bg-white border rounded mb-3 shadow-sm">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-0 text-dark">تحديد مورد موحد لكل الأصناف دفعة واحدة:</label>
                        </div>
                        <div class="col-md-5">
                            <select class="form-select form-select-sm border-primary fw-bold" @bind="bulkSupplierId">
                                <option value="0">-- اختر مورد لتطبيقه على كل الأصناف --</option>
                                @foreach (var s in suppliers)
                                {
                                    <option value="@s.Id">@s.SupplierName @(s.IsApproved ? "🛡️ (معتمد)" : "(غير معتمد)")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 fw-bold" @onclick="ApplyBulkSupplier">
                                ⚡ تطبيق المورد على جميع الأصناف أدناه
                            </button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive bg-white rounded border shadow-sm">
                    <table class="table table-bordered align-middle text-center mb-0 small">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 10%;">كود الصنف</th>
                                <th class="text-start ps-3" style="width: 18%;">اسم الصنف / الخامة</th>
                                <th style="width: 12%;">نوع الخامة</th>
                                <th style="width: 20%;">المورد المحدد للصنف *</th>
                                <th style="width: 8%;">الكمية</th>
                                <th style="width: 10%;">سعر الوحدة (ج.م) *</th>
                                <th style="width: 10%;">إجمالي البند</th>
                                <th class="text-start ps-2" style="width: 12%;">ملاحظات البند</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in editLines)
                            {
                                var itm = items.FirstOrDefault(i => i.Id == line.ItemId);
                                <tr>
                                    <td><code class="fw-bold font-monospace">@(itm?.ItemCode ?? line.ItemId.ToString())</code></td>
                                    <td class="text-start ps-3 fw-bold text-primary">@(itm?.ItemName ?? "خامة")</td>
                                    <td>
                                        <span class="badge @GetTypeBadgeClass(itm?.ItemType)">
                                            @(itm?.ItemType ?? "خامات")
                                        </span>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm border-primary fw-bold" @bind="line.SupplierId">
                                            <option value="0">-- اختر مورد هذا الصنف --</option>
                                            @foreach (var s in suppliers)
                                            {
                                                <option value="@s.Id">@s.SupplierName @(s.IsApproved ? "🛡️ (معتمد)" : "")</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold font-monospace" @bind="line.Quantity" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold text-success font-monospace" @bind="line.UnitPrice" />
                                    </td>
                                    <td class="fw-bold text-dark font-monospace">
                                        @((line.Quantity * line.UnitPrice).ToString("N2")) ج.م
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm text-start" placeholder="ملاحظات البند..." @bind="line.Notes" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end gap-4 p-3 bg-white rounded my-3 border shadow-sm">
                    <div>
                        <small class="text-muted d-block fw-bold">إجمالي قيمة الفاتورة المعتمدة:</small>
                        <span class="badge bg-success fs-5 font-monospace">@editLines.Sum(l => l.Quantity * l.UnitPrice).ToString("N2") ج.م</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <button class="btn btn-outline-secondary fw-bold btn-sm px-3" @onclick="() => selectedOrder = null">إلغاء المراجعة</button>
                    <button class="btn btn-success px-4 py-2 fw-bold shadow-sm" @onclick="ApproveAndForwardToReceipt" disabled="@isSubmitting">
                        @(isSubmitting ? "⏳ جاري الاعتماد والتوجيه..." : "🚀 اعتماد الفاتورة وتوجيهها فوراً للاستلام المخزني")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- سجل فواتير الشراء المعتمدة الجاهزة للاستلام المخزني (الجدول الرئيسي على الشاشة) -->
    <div class="card shadow-sm border-0 bg-white d-print-none">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold small">📋 سجل فواتير وأوامر الشراء المعتمدة الجاهزة للاستلام</h6>
            <span class="badge bg-success">المعروض: @FilteredApprovedOrders.Count() فاتورة</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle text-center small">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 20%;">رقم الفاتورة / الأمر</th>
                            <th class="text-start ps-3" style="width: 25%;">اسم المورد</th>
                            <th style="width: 15%;">تاريخ الفاتورة</th>
                            <th style="width: 15%;">القيمة الإجمالية</th>
                            <th style="width: 10%;">الحالة</th>
                            <th style="width: 15%;">إجراء الطباعة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (approvedOrders == null)
                        {
                            <tr><td colspan="6" class="py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري التحميل...</td></tr>
                        }
                        else if (!FilteredApprovedOrders.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">لا توجد فواتير معتمدة مطابقة لخيارات الفلترة.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var inv in FilteredApprovedOrders)
                            {
                                <tr @key="inv.Id">
                                    <td class="fw-bold font-monospace text-primary">@inv.OrderNumber</td>
                                    <td class="text-start ps-3 fw-bold text-dark">@inv.SupplierName</td>
                                    <td class="font-monospace text-muted">@inv.OrderDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-success fw-bold font-monospace">@inv.TotalAmount.ToString("N2") ج.م</td>
                                    <td><span class="badge bg-success px-2 py-1">معتمدة للاستلام</span></td>
                                    <td>
                                        <!-- زر طباعة الفاتورة الواحدة بكافة تفاصيلها -->
                                        <button class="btn btn-primary btn-sm py-0 px-2 fw-bold" @onclick="() => PrintSingleInvoice(inv)">
                                            🖨️ طباعة الفاتورة
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- منطقة إخراج الطباعة الرسمية: تظهر فقط عند الضغط على الطباعة وتخفى من الشاشة -->
    <!-- ========================================================================= -->
    <div class="d-none d-print-block">
        @if (orderToPrint != null)
        {
            <!-- طباعة فاتورة توريد محددة بكافة تفاصيلها وبنودها -->
            @RenderInvoicePrintSheet(orderToPrint)
        }
        else
        {
            <!-- طباعة كشف شامل لكافة الفواتير وبنودها المفلترة -->
            @foreach (var inv in FilteredApprovedOrders)
            {
                @RenderInvoicePrintSheet(inv)
            }
        }
    </div>

</div>

<!-- ============================================================== -->
<!-- نافذة استيراد الفواتير من ملف إكسيل (EXCEL IMPORT MODAL)       -->
<!-- ============================================================== -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد فواتير وعروض التوريد من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> 
                        يمكنك رفع ملف إكسيل / CSV يتضمن أرقام الفواتير، أسماء الموردين، الأصناف، الأسعار، والكميات. يتعرف النظام على الأعمدة تلقائياً.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة بنود الفواتير المقروءة من الملف (@importedPreviewList.Count بند):</span>
                            <span class="badge bg-success">جاهز للاستيراد</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>رقم الفاتورة</th>
                                        <th>المورد</th>
                                        <th>كود الصنف</th>
                                        <th>اسم الخامة</th>
                                        <th>الكمية</th>
                                        <th>سعر الوحدة</th>
                                        <th>الإجمالي</th>
                                        <th>الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@row.OrderNumber</td>
                                            <td class="fw-bold">@row.SupplierName</td>
                                            <td class="font-monospace">@row.ItemCode</td>
                                            <td class="fw-bold text-primary">@row.ItemName</td>
                                            <td class="font-monospace">@row.Quantity.ToString("N2")</td>
                                            <td class="font-monospace text-success">@row.UnitPrice.ToString("N2")</td>
                                            <td class="font-monospace fw-bold">@((row.Quantity * row.UnitPrice).ToString("N2"))</td>
                                            <td class="text-muted">@row.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@(isSavingImport || !importedPreviewList.Any())" 
                            @onclick="ProcessAndSaveImportAsync">
                        @if (isSavingImport)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري تسجيل واعتماد الفواتير...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check-circle"></i> تأكيد واعتماد كافة الفواتير (@importedPreviewList.Count بند)</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private List<PurchaseOrderDto>? pendingOrders;
    private List<PurchaseOrderDto>? approvedOrders;
    private List<SupplierLookupDto> suppliers = new();
    private List<ItemLookupDto> items = new();

    private PurchaseOrderDto? selectedOrder;
    private PurchaseOrderDto? orderToPrint = null;
    private List<EditLineDto> editLines = new();
    private long bulkSupplierId = 0;

    private string statusMessage = string.Empty;
    private bool isSuccess = false;
    private bool isSubmitting = false;
    private bool isSavingImport = false;
    private bool isImportModalOpen = false;

    // فلاتر البحث
    private string searchTerm = "";
    private long selectedSupplierFilter = 0;
    private DateTime? filterDateFrom;
    private DateTime? filterDateTo;

    public class InvoiceImportRowDto
    {
        public string OrderNumber { get; set; } = string.Empty;
        public string SupplierName { get; set; } = string.Empty;
        public DateTime OrderDate { get; set; } = DateTime.Today;
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; } = 0;
        public string Notes { get; set; } = string.Empty;
    }

    private List<InvoiceImportRowDto> importedPreviewList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            List<PurchaseOrderDto>? allOrders = null;
            try
            {
                allOrders = await Http.GetFromJsonAsync<List<PurchaseOrderDto>>("api/PurchaseOrders");
            }
            catch
            {
                allOrders = await Http.GetFromJsonAsync<List<PurchaseOrderDto>>("https://localhost:7273/api/PurchaseOrders");
            }

            if (allOrders != null)
            {
                pendingOrders = allOrders.Where(o => o.Status == "Pending_Procurement").ToList();
                approvedOrders = allOrders.Where(o => o.Status == "Approved" || o.Status == "Invoiced").ToList();
            }

            List<SupplierLookupDto>? sups = null;
            try
            {
                sups = await Http.GetFromJsonAsync<List<SupplierLookupDto>>("api/Suppliers");
            }
            catch
            {
                sups = await Http.GetFromJsonAsync<List<SupplierLookupDto>>("https://localhost:7273/api/Suppliers");
            }

            if (sups != null) suppliers = sups.Where(s => s.Active).ToList();

            List<ItemLookupDto>? itms = null;
            try
            {
                itms = await Http.GetFromJsonAsync<List<ItemLookupDto>>("api/Items");
            }
            catch
            {
                itms = await Http.GetFromJsonAsync<List<ItemLookupDto>>("https://localhost:7273/api/Items");
            }

            if (itms != null) items = itms;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading procurement data: {ex.Message}");
        }
    }

    private string GetTypeBadgeClass(string? type) => type switch
    {
        "خامات" => "bg-success",
        "مواد تعبئة وتغليف" => "bg-info text-dark",
        "نصف مصنع" => "bg-warning text-dark",
        "أصول / حاويات تداول" => "bg-secondary",
        "منتج تام" => "bg-primary",
        _ => "bg-dark"
    };

    // ==========================================
    // محرك الفلترة المتعددة
    // ==========================================
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        selectedSupplierFilter > 0 ||
        filterDateFrom.HasValue ||
        filterDateTo.HasValue;

    private void ResetFilters()
    {
        searchTerm = "";
        selectedSupplierFilter = 0;
        filterDateFrom = null;
        filterDateTo = null;
    }

    private IEnumerable<PurchaseOrderDto> FilteredPendingOrders
    {
        get
        {
            if (pendingOrders == null) return Enumerable.Empty<PurchaseOrderDto>();
            var query = pendingOrders.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(o =>
                    o.OrderNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(o.SupplierName) && o.SupplierName.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (selectedSupplierFilter > 0)
                query = query.Where(o => o.SupplierId == selectedSupplierFilter);

            if (filterDateFrom.HasValue)
                query = query.Where(o => o.OrderDate.Date >= filterDateFrom.Value.Date);

            if (filterDateTo.HasValue)
                query = query.Where(o => o.OrderDate.Date <= filterDateTo.Value.Date);

            return query;
        }
    }

    private IEnumerable<PurchaseOrderDto> FilteredApprovedOrders
    {
        get
        {
            if (approvedOrders == null) return Enumerable.Empty<PurchaseOrderDto>();
            var query = approvedOrders.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(o =>
                    o.OrderNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(o.SupplierName) && o.SupplierName.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (selectedSupplierFilter > 0)
                query = query.Where(o => o.SupplierId == selectedSupplierFilter);

            if (filterDateFrom.HasValue)
                query = query.Where(o => o.OrderDate.Date >= filterDateFrom.Value.Date);

            if (filterDateTo.HasValue)
                query = query.Where(o => o.OrderDate.Date <= filterDateTo.Value.Date);

            return query;
        }
    }

    private async Task SelectOrderForPricing(long orderId)
    {
        try
        {
            PurchaseOrderDto? order = null;
            try
            {
                order = await Http.GetFromJsonAsync<PurchaseOrderDto>($"api/PurchaseOrders/{orderId}");
            }
            catch
            {
                order = await Http.GetFromJsonAsync<PurchaseOrderDto>($"https://localhost:7273/api/PurchaseOrders/{orderId}");
            }

            selectedOrder = order;
            if (selectedOrder != null)
            {
                editLines = selectedOrder.Lines?.Select(l => new EditLineDto
                {
                    LineId = l.Id,
                    ItemId = l.ItemId,
                    SupplierId = selectedOrder.SupplierId > 0 ? selectedOrder.SupplierId : (suppliers.FirstOrDefault()?.Id ?? 0),
                    Quantity = l.Quantity,
                    UnitPrice = l.UnitPrice,
                    Notes = l.Notes
                }).ToList() ?? new List<EditLineDto>();
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"خطأ في جلب تفاصيل الأمر: {ex.Message}";
        }
    }

    private void ApplyBulkSupplier()
    {
        if (bulkSupplierId > 0 && editLines.Any())
        {
            foreach (var line in editLines)
            {
                line.SupplierId = bulkSupplierId;
            }
        }
    }

    private async Task ApproveAndForwardToReceipt()
    {
        if (selectedOrder == null || editLines.Count == 0) return;

        if (editLines.Any(l => l.SupplierId <= 0))
        {
            isSuccess = false;
            statusMessage = "يرجى تحديد المورد أمام كل صنف قبل الاعتماد.";
            return;
        }

        if (editLines.Any(l => l.UnitPrice <= 0))
        {
            isSuccess = false;
            statusMessage = "يجب تحديد سعر توريد أكبر من الصفر لكل الأصناف.";
            return;
        }

        isSubmitting = true;
        try
        {
            var updatePayload = new
            {
                OrderId = selectedOrder.Id,
                Status = "Approved",
                Lines = editLines
            };

            HttpResponseMessage res;
            try
            {
                res = await Http.PostAsJsonAsync("api/PurchaseOrders/approve-invoice", updatePayload);
            }
            catch
            {
                res = await Http.PostAsJsonAsync("https://localhost:7273/api/PurchaseOrders/approve-invoice", updatePayload);
            }

            if (res.IsSuccessStatusCode)
            {
                isSuccess = true;
                statusMessage = "تم اعتماد الفاتورة وتوجيه الأصناف للموردين بنجاح! الشحنة جاهزة الآن في شاشة استلام الخامات.";
                selectedOrder = null;
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                statusMessage = !string.IsNullOrWhiteSpace(err) ? err : $"فشل الاعتماد (كود: {res.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"خطأ في الاتصال: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

