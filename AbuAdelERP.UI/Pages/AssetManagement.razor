@code {
    public class FixedAssetModel
    {
        public long Id { get; set; }
        public string AssetCode { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string? Category { get; set; } = "أفران وتسوية";
        public string? BrandModel { get; set; } = string.Empty;
        public string? SerialNumber { get; set; } = string.Empty;
        public string CustodianCode { get; set; } = string.Empty;
        public string CustodianName { get; set; } = string.Empty;
        public DateTime InstallationDate { get; set; } = DateTime.UtcNow;
        public string Status { get; set; } = "OPERATIONAL";
        public string? ActiveSOSTaskNumber { get; set; }
        public List<AssetHistoryEvent> HistoryLogs { get; set; } = new();
    }

    public class AssetHistoryEvent
    {
        public DateTime Date { get; set; }
        public string EventType { get; set; } = "صيانة";
        public string Description { get; set; } = string.Empty;
        public string PerformedByCode { get; set; } = string.Empty;
        public string PerformedByName { get; set; } = string.Empty;
        public string CostImpact { get; set; } = "---";
    }

    public class CirculatingContainerModel
    {
        public int Id { get; set; }
        public string ContainerName { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public int TotalFactoryQuantity { get; set; }
        public int InProductionFloorQuantity { get; set; }
        public int InPackagingWarehouseQuantity { get; set; }
        public int WithDriversAndBranchesQuantity { get; set; }
        public int DisputedQuantity { get; set; }
        public int DamagedQuantity { get; set; }
    }

    public class CrateHandoverMovementModel
    {
        public long Id { get; set; }
        public string MovementNumber { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; } = DateTime.UtcNow;
        public string MovementType { get; set; } = "DISPATCH_BRANCH";
        public string ContainerName { get; set; } = string.Empty;
        public int DispatchedQuantity { get; set; }
        public string SourceLocation { get; set; } = string.Empty;
        public string DispatchedByCode { get; set; } = string.Empty;
        public string DispatchedByName { get; set; } = string.Empty;
        public string DestinationLocation { get; set; } = string.Empty;
        public string? Notes { get; set; }

        public int? ReceivedQuantity { get; set; }
        public int ShortageQuantity { get; set; } = 0;
        public int DamagedCount { get; set; } = 0;
        public DateTime? ReceivedAt { get; set; }
        public string? ReceivedByCode { get; set; }
        public string? ReceivedByName { get; set; }
        public string? ReceiveNotes { get; set; }
        public string Status { get; set; } = "PENDING_RECEIPT";

        public string? ArbitrationDecision { get; set; }
        public string? ArbitrationText { get; set; }
        public string? ArbitratedByCode { get; set; }
        public string? ArbitratedByName { get; set; }
        public string? FinancialPenalty { get; set; }
    }

    public class DepartmentApiDto
    {
        public long Id { get; set; }
        public string? DepartmentName { get; set; }
        public string? Name { get; set; }
        public string DisplayName => !string.IsNullOrEmpty(DepartmentName) ? DepartmentName : (!string.IsNullOrEmpty(Name) ? Name : $"قسم #{Id}");
    }

    public class ItemQuickDto
    {
        public long Id { get; set; }
        [JsonPropertyName("itemCode")] public string? ItemCode { get; set; }
        [JsonPropertyName("code")] public string? Code { get; set; }
        [JsonPropertyName("itemName")] public string? ItemName { get; set; }
        [JsonPropertyName("name")] public string? Name { get; set; }
        [JsonPropertyName("itemType")] public string? ItemType { get; set; }
        [JsonPropertyName("isContainer")] public bool? IsContainer { get; set; }

        public string DisplayCode => !string.IsNullOrWhiteSpace(ItemCode) ? ItemCode : (!string.IsNullOrWhiteSpace(Code) ? Code : $"ITEM-{Id}");
        public string DisplayName => !string.IsNullOrWhiteSpace(ItemName) ? ItemName : (!string.IsNullOrWhiteSpace(Name) ? Name : $"صنف #{Id}");
    }

    public class EmployeeQuickDto
    {
        public long Id { get; set; }
        [JsonPropertyName("code")] public string? Code { get; set; }
        [JsonPropertyName("employeeCode")] public string? EmployeeCode { get; set; }
        [JsonPropertyName("empCode")] public string? EmpCode { get; set; }
        [JsonPropertyName("fullName")] public string? FullName { get; set; }
        [JsonPropertyName("employeeName")] public string? EmployeeName { get; set; }
        [JsonPropertyName("name")] public string? Name { get; set; }
        [JsonPropertyName("departmentName")] public string? DepartmentName { get; set; }

        public string DisplayCode => !string.IsNullOrWhiteSpace(Code) ? Code
            : (!string.IsNullOrWhiteSpace(EmployeeCode) ? EmployeeCode
            : (!string.IsNullOrWhiteSpace(EmpCode) ? EmpCode : $"EMP-{Id:D3}"));

        public string DisplayName => !string.IsNullOrWhiteSpace(FullName) ? FullName
            : (!string.IsNullOrWhiteSpace(EmployeeName) ? EmployeeName
            : (!string.IsNullOrWhiteSpace(Name) ? Name : $"عامل #{Id}"));

        public string DisplayDepartment => !string.IsNullOrWhiteSpace(DepartmentName) ? DepartmentName : "قسم الإنتاج";
    }

    private string activeTab = "fixed";
    private string fixedAssetSearch = "";
    private string fixedDeptFilter = "";
    private string fixedCategoryFilter = "";
    private string fixedStatusFilter = "";
    private string movementStatusFilter = "";
    private string selectedCustodyDept = "قسم الشرقي والمخبوزات";

    private string feedbackMessage = "";
    private bool isSuccessFeedback = true;
    private string modalErrorMessage = "";
    private bool isSavingAsset = false;

    // متغيرات نافذة نقل الماكينات (الدائرة المغلقة)
    private bool isMachineTransferModalOpen = false;
    private string selectedMachineTransferCode = "";
    private FixedAssetModel? selectedMachineToTransfer;
    private string targetTransferDept = "";
    private string targetTransferEmpCode = "";
    private string machineTransferReason = "";

    // متغيرات نافذة صرف الأوعية والأسبات
    private string crateSourceDept = "";
    private string crateSourceEmpCode = "";
    private string crateDestLocation = "";
    private string crateDestEmpCode = "";

    private bool isFixedAssetModalOpen = false;
    private bool isDirectSOSModalOpen = false;
    private bool isAssetHistoryModalOpen = false;
    private bool isDispatchModalOpen = false;
    private bool isReceiveModalOpen = false;
    private bool isSettleDisputeModalOpen = false;
    private bool isDetailsModalOpen = false;

    private FixedAssetModel editingFixedAsset = new();
    private FixedAssetModel? assetForSOS;
    private FixedAssetModel? selectedHistoryAsset;
    private CrateHandoverMovementModel newDispatch = new();
    private CrateHandoverMovementModel? selectedMovementForReceive;
    private CrateHandoverMovementModel? selectedMovementForDispute;
    private CrateHandoverMovementModel? selectedMovementForDetails;

    private int actualReceivedQtyInput = 0;
    private int damagedQtyInput = 0;
    private string receiveNotesInput = "";

    private string arbitrationDecision = "CHARGE_CARRIER";
    private string arbitrationFinancialImpact = "";
    private string arbitrationText = "";

    private string directSOSTitle = "";
    private string directSOSDescription = "";

    private List<DepartmentApiDto> dbDepartments = new();
    private List<ItemQuickDto> itemMasterCatalog = new();
    private List<EmployeeQuickDto> employeesCatalog = new();
    private List<FixedAssetModel> fixedAssetsList = new();
    private List<CirculatingContainerModel> circulatingAssetsList = new();
    private List<CrateHandoverMovementModel> crateMovementsHistory = new();

    private IEnumerable<ItemQuickDto> AvailableContainerItems
    {
        get
        {
            var filtered = itemMasterCatalog.Where(i =>
                (i.IsContainer == true) ||
                (!string.IsNullOrWhiteSpace(i.ItemType) && (
                    i.ItemType.Contains("أصول") || 
                    i.ItemType.Contains("حاويات") || 
                    i.ItemType.Contains("تداول") ||
                    i.ItemType.Equals("CONTAINER", StringComparison.OrdinalIgnoreCase) ||
                    i.ItemType.Equals("ASSET", StringComparison.OrdinalIgnoreCase)
                )) ||
                (!string.IsNullOrWhiteSpace(i.DisplayName) && (
                    i.DisplayName.Contains("سبت") || 
                    i.DisplayName.Contains("صينية") || 
                    i.DisplayName.Contains("صاج") ||
                    i.DisplayName.Contains("حاوية") ||
                    i.DisplayName.Contains("ترولي")
                ))
            ).ToList();

            return filtered.Any() ? filtered : itemMasterCatalog;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartmentsFromApi();
        await LoadCatalogsFromApi();
        await RefreshAllData();
    }

    private void SwitchTab(string tab) => activeTab = tab;

    private async Task RefreshAllData()
    {
        await LoadFixedAssets();
        await LoadCrateData();
    }

    private async Task LoadDepartmentsFromApi()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<DepartmentApiDto>>("api/Departments");
            if (res != null && res.Any()) dbDepartments = res;
        }
        catch { }

        if (!dbDepartments.Any())
        {
            dbDepartments = new List<DepartmentApiDto>
            {
                new() { Id = 100, DepartmentName = "قسم الشرقي والمخبوزات" },
                new() { Id = 200, DepartmentName = "قسم الجاتوه والتورت والحلويات الغربية" },
                new() { Id = 400, DepartmentName = "مستودع التعبئة والتغليف والتوزيع" },
                new() { Id = 500, DepartmentName = "إدارة الصيانة والتشغيل المركزي" }
            };
        }
        selectedCustodyDept = dbDepartments.FirstOrDefault()?.DisplayName ?? "قسم الشرقي والمخبوزات";
    }

    private async Task LoadCatalogsFromApi()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<ItemQuickDto>>("api/Items");
            if (items != null && items.Any()) itemMasterCatalog = items;
        }
        catch { }

        try
        {
            var emps = await Http.GetFromJsonAsync<List<EmployeeQuickDto>>("api/Employees");
            if (emps != null && emps.Any()) employeesCatalog = emps;
        }
        catch { }
    }

    private async Task LoadFixedAssets()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<FixedAssetModel>>("api/FixedAssets");
            if (res != null) fixedAssetsList = res;
        }
        catch { }
    }

    private async Task LoadCrateData()
    {
        try
        {
            var invRes = await Http.GetFromJsonAsync<List<CirculatingContainerModel>>("api/Crates/inventory");
            if (invRes != null && invRes.Any())
            {
                circulatingAssetsList = invRes;
            }
        }
        catch { }

        if (!circulatingAssetsList.Any() && AvailableContainerItems.Any())
        {
            circulatingAssetsList = AvailableContainerItems.Select(item => new CirculatingContainerModel
            {
                Id = (int)item.Id,
                ContainerName = item.DisplayName,
                Specification = $"كود: {item.DisplayCode} (أصل معتمد بالـ Item Master)",
                TotalFactoryQuantity = 1000,
                InProductionFloorQuantity = 350,
                InPackagingWarehouseQuantity = 450,
                WithDriversAndBranchesQuantity = 200,
                DisputedQuantity = 0,
                DamagedQuantity = 0
            }).ToList();
        }

        try
        {
            var movRes = await Http.GetFromJsonAsync<List<CrateHandoverMovementModel>>("api/Crates/movements");
            if (movRes != null) crateMovementsHistory = movRes;
        }
        catch { }
    }

    private IEnumerable<CrateHandoverMovementModel> FilteredMovements
    {
        get
        {
            var list = crateMovementsHistory.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(movementStatusFilter))
                list = list.Where(m => m.Status == movementStatusFilter);
            return list.OrderByDescending(m => m.CreatedAt);
        }
    }

    private IEnumerable<FixedAssetModel> FilteredFixedAssets
    {
        get
        {
            var list = fixedAssetsList.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(fixedDeptFilter))
                list = list.Where(a => a.Department.Equals(fixedDeptFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(fixedCategoryFilter))
                list = list.Where(a => a.Category != null && a.Category.Equals(fixedCategoryFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(fixedStatusFilter))
                list = list.Where(a => a.Status.Equals(fixedStatusFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(fixedAssetSearch))
            {
                var term = fixedAssetSearch.Trim();
                list = list.Where(a => 
                    a.AssetCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    a.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (a.BrandModel != null && a.BrandModel.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (a.SerialNumber != null && a.SerialNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    a.CustodianName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    a.Department.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return list;
        }
    }

    private IEnumerable<FixedAssetModel> DepartmentFixedAssets => fixedAssetsList.Where(a => a.Department.Equals(selectedCustodyDept, StringComparison.OrdinalIgnoreCase));

    private void ResetFixedFilters()
    {
        fixedAssetSearch = "";
        fixedDeptFilter = "";
        fixedCategoryFilter = "";
        fixedStatusFilter = "";
