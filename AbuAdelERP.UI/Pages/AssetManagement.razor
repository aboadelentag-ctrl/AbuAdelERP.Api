        sb.AppendLine("رقم الإذن,التاريخ,نوع الحركة,نوع الحاوية,المنصرف,المصدر,المُسلِّم,المستقبل,المستلم,الكمية المستلمة,العجز,الكسر,الحالة");
        foreach (var m in crateMovementsHistory)
            sb.AppendLine($"\"{m.MovementNumber}\",\"{m.CreatedAt:yyyy-MM-dd HH:mm}\",\"{m.MovementType}\",\"{m.ContainerName}\",{m.DispatchedQuantity},\"{m.SourceLocation}\",\"{m.DispatchedByName}\",\"{m.DestinationLocation}\",\"{m.ReceivedByName}\",{m.ReceivedQuantity},{m.ShortageQuantity},{m.DamagedCount},\"{TranslateCrateStatus(m.Status)}\"");

        await DownloadCsvFile(sb.ToString(), $"سجل_تداول_الأسبات_{DateTime.Now:yyyyMMdd_HHmm}.csv");
    }

    private async Task DownloadCsvFile(string csvContent, string fileName)
    {
        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csvContent)).ToArray();
        var base64 = Convert.ToBase64String(bytes);
        var js = $"const link = document.createElement('a'); link.href = 'data:text/csv;charset=utf-8;base64,{base64}'; link.download = '{fileName}'; document.body.appendChild(link); link.click(); document.body.removeChild(link);";
        await JS.InvokeVoidAsync("eval", js);
    }

    private async Task PrintCustodyCard() => await JS.InvokeVoidAsync("eval", "window.print();");

    private string GetAssetStatusBadge(string s) => s == "OPERATIONAL" ? "bg-success" : (s == "UNDER_MAINTENANCE" ? "bg-warning text-dark" : "bg-danger");
    private string TranslateAssetStatus(string s) => s == "OPERATIONAL" ? "تعمل بكفاءة ✓" : (s == "UNDER_MAINTENANCE" ? "تحت الصيانة والإصلاح ⚙️" : "معطلة ⛔");

    private string GetCrateStatusBadge(string s) => s switch
    {
        "COMPLETED" => "bg-success",
        "DISPUTED" => "bg-danger",
        "PENDING_RECEIPT" => "bg-warning text-dark",
        "RESOLVED" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private string TranslateCrateStatus(string s) => s switch
    {
        "COMPLETED" => "مكتمل ومستلم بالكامل ✓",
        "DISPUTED" => "نزاع عجز وكسر معلق ⚠️",
        "PENDING_RECEIPT" => "بانتظار تأكيد المستلم ⏳",
        "RESOLVED" => "تم التحكيم وفض النزاع ⚖️",
        _ => s
    };
