    private async Task ConfirmReceiveHandshake()
    {
        if (selectedMovementForReceive == null) return;
        var shortage = selectedMovementForReceive.DispatchedQuantity - actualReceivedQtyInput;

        try
        {
            var dto = new
            {
                ActualReceivedQuantity = actualReceivedQtyInput,
                DamagedCount = damagedQtyInput,
                ReceiveNotes = receiveNotesInput
            };

            var res = await Http.PostAsJsonAsync($"api/Crates/movements/{selectedMovementForReceive.Id}/receive", dto);
            if (res.IsSuccessStatusCode)
            {
                await LoadCrateData();
                feedbackMessage = shortage > 0 ? "⚠️ تم فتح محضر نزاع رسمي لوجود عجز في الأسبات!" : "✅ تم تأكيد استلام الأوعية وتحديث الأرصدة بنجاح!";
                isSuccessFeedback = shortage == 0;
                isReceiveModalOpen = false;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"خطأ: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

