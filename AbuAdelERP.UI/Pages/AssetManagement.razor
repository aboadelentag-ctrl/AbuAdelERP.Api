@page "/asset-management"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@page "/crate-tracking"
@page "/crates-tracking"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json.Serialization
@using System.IO
@using AbuAdelERP.UI.Services
@using Blazored.LocalStorage
@inject HttpClient Http
@inject AppState State
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>إدارة الأصول والماكينات وتتبع الحاويات - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الشاشة التنفيذي -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-warning">🏭 حوكمة الأصول والماكينات ورقابة دورة استلام وتسليم الأسبات</h4>
                    <span class="badge bg-warning text-dark px-2 py-1 small fw-bold">نظام الفصل المؤسسي والرقابة الميدانية</span>
                </div>
                <small class="text-light text-opacity-75">
                    فصل كامل بين نقل عهدة الماكينات الرأسمالية (كمية = 1) ودورة تداول الأسبات والصواني المجمعة مع محاضر فض النزاعات.
                </small>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @if (activeTab == "fixed")
                {
                    <AuthorizePermission Permission="FixedAssets.Manage">
                        <button class="btn btn-warning text-dark btn-sm fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenNewFixedAssetModal">
                            <i class="bi bi-plus-circle-fill"></i> قيد أصل / ماكينة جديدة
                        </button>
                    </AuthorizePermission>

                    <AuthorizePermission Permission="FixedAssets.Manage">
                        <button class="btn btn-primary btn-sm fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenMachineTransferModal">
                            <i class="bi bi-arrow-left-right"></i> نقل عهدة ماكينة / أصل رأسمالي
                        </button>
                    </AuthorizePermission>

                    <AuthorizePermission Permission="FixedAssets.View">
                        <button class="btn btn-outline-light btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="ExportAssetsToExcel">
                            <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> تصدير إكسيل
                        </button>
                    </AuthorizePermission>
                }
                else if (activeTab == "circulating")
                {
                    <AuthorizePermission Permission="Crates.Dispatch">
                        <button class="btn btn-primary btn-sm fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenCrateDispatchModal">
                            <i class="bi bi-box-arrow-up-right"></i> إصدار إذن تسليم وصرف أسبات وأوعية
                        </button>
                    </AuthorizePermission>

                    <AuthorizePermission Permission="Crates.Export">
                        <button class="btn btn-outline-light btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="ExportCrateMovementsToExcel">
                            <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> تصدير سجل الحركات
                        </button>
                    </AuthorizePermission>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccessFeedback ? "alert-success" : "alert-danger") border-0 shadow-sm alert-dismissible fade show py-2 mb-3 fw-bold" role="alert">
            @feedbackMessage
            <button type="button" class="btn-close py-2" @onclick='() => feedbackMessage = ""'></button>
        </div>
    }

    <!-- التبويبات -->
    <ul class="nav nav-tabs fw-bold mb-3 border-bottom-2" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "fixed" ? "active text-dark border-warning border-bottom-0 fw-bold bg-white" : "text-muted")" @onclick='() => SwitchTab("fixed")'>
                🏭 سجل الأصول والماكينات الرأسمالية (@fixedAssetsList.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "circulating" ? "active text-primary border-primary border-bottom-0 fw-bold bg-white" : "text-muted")" @onclick='() => SwitchTab("circulating")'>
                🧺 رقابة دورة استلام وتسليم الأسبات والأوعية (@crateMovementsHistory.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "custody" ? "active text-success border-success border-bottom-0 fw-bold bg-white" : "text-muted")" @onclick='() => SwitchTab("custody")'>
                📑 بطاقة جرد وعهدة الأقسام والصالات
            </button>
        </li>
    </ul>

    <!-- التبويب 1: الأصول الثابتة -->
    @if (activeTab == "fixed")
    {
        <div class="row g-2 mb-3">
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-success text-center">
                    <small class="text-muted fw-bold">ماكينات تعمل بكفاءة تامة</small>
                    <h4 class="fw-bold text-success mt-1 mb-0 font-monospace">@fixedAssetsList.Count(a => a.Status == "OPERATIONAL") أصل</h4>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-warning text-center">
                    <small class="text-muted fw-bold">تحت الصيانة والإصلاح (SOS)</small>
                    <h4 class="fw-bold text-warning mt-1 mb-0 font-monospace">@fixedAssetsList.Count(a => a.Status == "UNDER_MAINTENANCE") أصل</h4>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-danger text-center">
                    <small class="text-muted fw-bold">متوقفة / عطل حرج في الصالة</small>
                    <h4 class="fw-bold text-danger mt-1 mb-0 font-monospace">@fixedAssetsList.Count(a => a.Status == "OUT_OF_SERVICE") أصل</h4>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-dark text-center">
                    <small class="text-muted fw-bold">إجمالي الأصول والماكينات</small>
                    <h4 class="fw-bold text-dark mt-1 mb-0 font-monospace">@fixedAssetsList.Count أصل</h4>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-3 bg-light">
            <div class="card-body p-2">
                <div class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="بحث بكود الأصل، الماكينة، الموديل، السريال..." @bind="fixedAssetSearch" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm fw-bold" @bind="fixedDeptFilter">
                            <option value="">-- كل الإدارات والأقسام المعتمدة --</option>
                            @foreach (var dept in dbDepartments)
                            {
                                <option value="@dept.DisplayName">@dept.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" @bind="fixedCategoryFilter">
                            <option value="">-- كل التصنيفات --</option>
                            <option value="أفران وتسوية">أفران وخطوط تسوية</option>
                            <option value="عجانات ومضارب">عجانات ومضارب خفق</option>
                            <option value="ثلاجات وتبريد">ثلاجات وتبريد وتجميد</option>
                            <option value="تغليف وتعبئة">تعبئة وتغليف وسيلر</option>
                            <option value="سيارات توزيع">سيارات ولوجستيات</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" @bind="fixedStatusFilter">
                            <option value="">-- كل الحالات الفنية --</option>
                            <option value="OPERATIONAL">تعمل بكفاءة</option>
                            <option value="UNDER_MAINTENANCE">تحت الصيانة (SOS)</option>
                            <option value="OUT_OF_SERVICE">معطلة تماماً</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-outline-secondary btn-sm w-100 fw-bold" @onclick="ResetFixedFilters">إلغاء</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark m-0">📋 سجل الأصول والماكينات الرأسمالية (المعروض: @FilteredFixedAssets.Count())</h6>
                <small class="text-muted">محدث تلقائياً مع قاعدة بيانات PostgreSQL</small>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>كود الأصل (Tag)</th>
                            <th>اسم الأصل / الماكينة</th>
                            <th>القسم / الصالة الفعلية</th>
                            <th>الماركة والموديل</th>
                            <th>الرقم التسلسلي (S/N)</th>
                            <th>مسؤول العهدة (HR)</th>
                            <th>الحالة الفنية</th>
                            <th style="min-width: 240px;">الإجراءات والربط الميداني</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredFixedAssets.Any())
                        {
                            <tr><td colspan="8" class="text-muted py-4 fw-bold">لا توجد أصول مسجلة تطابق شروط البحث.</td></tr>
                        }
                        else
                        {
                            @foreach (var asset in FilteredFixedAssets)
                            {
                                var hasActiveSOS = !string.IsNullOrEmpty(asset.ActiveSOSTaskNumber) || asset.Status == "UNDER_MAINTENANCE";
                                <tr>
                                    <td class="font-monospace fw-bold text-primary">@asset.AssetCode</td>
                                    <td class="fw-bold text-start ps-3 text-dark">
                                        @asset.Name
                                        @if (!string.IsNullOrEmpty(asset.Category))
                                        {
                                            <span class="badge bg-light text-secondary border ms-1">@asset.Category</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-primary">@asset.Department</span></td>
                                    <td>@(!string.IsNullOrEmpty(asset.BrandModel) ? asset.BrandModel : "---")</td>
                                    <td class="font-monospace text-muted">@(!string.IsNullOrEmpty(asset.SerialNumber) ? asset.SerialNumber : "---")</td>
                                    <td>
                                        <div class="fw-bold text-dark">@asset.CustodianName</div>
                                        <small class="text-muted font-monospace">[@asset.CustodianCode]</small>
                                    </td>
                                    <td>
                                        <span class="badge @GetAssetStatusBadge(asset.Status) px-2 py-1 d-block mb-1">
                                            @TranslateAssetStatus(asset.Status)
                                        </span>
                                        @if (hasActiveSOS && !string.IsNullOrEmpty(asset.ActiveSOSTaskNumber))
                                        {
                                            <span class="badge bg-danger font-monospace" style="font-size: 10px;">
                                                🚨 @asset.ActiveSOSTaskNumber
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center align-items-center gap-1">
                                            <button class="btn btn-sm btn-outline-success fw-bold py-1 px-2 shadow-sm" title="نقل عهدة هذه الماكينة لصالة أخرى" @onclick="() => OpenTransferForSpecificMachine(asset)">
                                                🔄 نقل
                                            </button>

                                            <AuthorizePermission Permission="Emergency.Create">
                                                <button class="btn btn-sm btn-danger fw-bold py-1 px-2 shadow-sm" title="إطلاق بلاغ طارئ واستدعاء صيانة" @onclick="() => OpenDirectSOSModal(asset)">
                                                    🚨 عطل
                                                </button>
                                            </AuthorizePermission>

                                            <AuthorizePermission Permission="FixedAssets.History, FixedAssets.View">
                                                <button class="btn btn-sm btn-outline-dark fw-bold py-1 px-2" title="استعراض الأرشيف الكامل" @onclick="() => OpenAssetHistoryModal(asset)">
                                                    📜 السجل
                                                </button>
                                            </AuthorizePermission>

                                            <AuthorizePermission Permission="FixedAssets.Manage">
                                                <button class="btn btn-sm btn-outline-primary fw-bold py-1 px-2" @onclick="() => EditFixedAsset(asset)">
                                                    تعديل
                                                </button>
                                            </AuthorizePermission>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- التبويب 2: دورة تداول الأسبات والمحاضر الميدانية -->
    @if (activeTab == "circulating")
    {
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark m-0">🧺 موقف الأرصدة اللحظية للحاويات والأسبات بالمصنع</h6>
                <button class="btn btn-outline-primary btn-sm py-0 fw-bold" @onclick="LoadCrateData">🔄 تحديث الأرصدة</button>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered mb-0 text-center align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>نوع الوعاء / الحاوية</th>
                            <th>المواصفة الفنية</th>
                            <th>الرصيد الكلي بالمصنع</th>
                            <th>بصالات الإنتاج</th>
                            <th>بمستودع التعبئة</th>
                            <th>عهدة خارجية بالفروع/المندوبين</th>
                            <th>حاويات متنازع عليها (عجز)</th>
                            <th>توالف وكسر</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in circulatingAssetsList)
                        {
                            <tr>
                                <td class="fw-bold text-start ps-3 text-primary fs-6">@c.ContainerName</td>
                                <td class="text-muted font-monospace">@c.Specification</td>
                                <td class="font-monospace fw-bold fs-6">@c.TotalFactoryQuantity</td>
                                <td class="font-monospace text-success fw-bold">@c.InProductionFloorQuantity</td>
                                <td class="font-monospace text-info fw-bold">@c.InPackagingWarehouseQuantity</td>
                                <td class="font-monospace text-warning fw-bold">@c.WithDriversAndBranchesQuantity</td>
                                <td class="font-monospace text-danger fw-bold">@c.DisputedQuantity</td>
                                <td class="font-monospace text-secondary fw-bold">@c.DamagedQuantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3 mb-4 border-top border-4 border-primary">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark m-0">🚚 سجل أذون صرف واستلام الأسبات ومحاضر النزاع (@crateMovementsHistory.Count حركة)</h6>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm font-monospace" style="width: 200px;" @bind="crateFilterStatus" @bind:after="LoadCrateData">
                        <option value="">-- كل الحالات --</option>
                        <option value="PENDING_RECEIPT">بانتظار تأكيد المستلم ⏳</option>
                        <option value="DISPUTED">نزاع عجز وكسر معلق ⚠️</option>
                        <option value="COMPLETED">مكتمل ومستلم بالكامل ✓</option>
                        <option value="RESOLVED">تم التحكيم وفض النزاع ⚖️</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم الإذن</th>
                            <th>تاريخ الحركة</th>
                            <th>نوع الحركة</th>
                            <th>نوع الوعاء</th>
                            <th>المنصرف</th>
                            <th>الموقع المُرسل</th>
                            <th>القائم بالصرف (HR)</th>
                            <th>الموقع المستلم</th>
                            <th>المستلم الفعلي (HR)</th>
                            <th>المستلم</th>
                            <th>العجز والكسر</th>
                            <th>الحالة</th>
                            <th>الإجراء الميداني</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!crateMovementsHistory.Any())
                        {
                            <tr><td colspan="13" class="text-muted py-4 fw-bold">لا توجد حركات تداول مسجلة حالياً.</td></tr>
                        }
                        else
                        {
                            @foreach (var m in crateMovementsHistory)
                            {
                                <tr>
                                    <td><code class="fw-bold font-monospace">@m.MovementNumber</code></td>
                                    <td class="font-monospace">@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <span class="badge @(m.MovementType == "DISPATCH_BRANCH" ? "bg-primary" : "bg-success")">
                                            @(m.MovementType == "DISPATCH_BRANCH" ? "صرف خارجي / للفروع" : "مرتجع للمصنع")
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark">@m.ContainerName</td>
                                    <td class="font-monospace fw-bold fs-6">@m.DispatchedQuantity</td>
                                    <td><span class="badge bg-light text-dark border">@m.SourceLocation</span></td>
                                    <td>
                                        <div class="small fw-bold">@m.DispatchedByName</div>
                                        <small class="text-muted font-monospace">[@m.DispatchedByCode]</small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@m.DestinationLocation</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(m.ReceivedByName))
                                        {
                                            <div class="small fw-bold">@m.ReceivedByName</div>
                                            <small class="text-muted font-monospace">[@m.ReceivedByCode]</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td class="font-monospace fw-bold text-success">@(m.ReceivedQuantity > 0 ? m.ReceivedQuantity.ToString() : "-")</td>
                                    <td>
                                        @if (m.ShortageQuantity > 0 || m.DamagedCount > 0)
                                        {
                                            <span class="badge bg-danger font-monospace">عجز: @m.ShortageQuantity | كسر: @m.DamagedCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @GetCrateStatusBadge(m.Status) px-2 py-1">
                                            @TranslateCrateStatus(m.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            @if (m.Status == "PENDING_RECEIPT")
                                            {
                                                <button class="btn btn-sm btn-success fw-bold py-1 px-2 shadow-sm" @onclick="() => OpenReceiveCrateModal(m)">
                                                    📥 تأكيد الاستلام
                                                </button>
                                            }
                                            @if (m.Status == "DISPUTED")
                                            {
                                                <AuthorizePermission Permission="Crates.SettleDispute, Roles.Manage">
                                                    <button class="btn btn-sm btn-danger fw-bold py-1 px-2 shadow-sm" @onclick="() => OpenSettleDisputeModal(m)">
                                                        ⚖️ فض النزاع
                                                    </button>
                                                </AuthorizePermission>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- التبويب 3: بطاقة جرد الأقسام -->
    @if (activeTab == "custody")
    {
        <div class="card shadow-sm border-0 rounded-3 mb-3 bg-light">
            <div class="card-body p-3">
                <div class="row align-items-center g-2">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-dark mb-1">اختر الصالة أو القسم الفعلي:</label>
                        <select class="form-select fw-bold border-success" @bind="selectedCustodyDept">
                            @foreach (var d in dbDepartments)
                            {
                                <option value="@d.DisplayName">@d.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-7 text-md-end pt-3">
                        <button class="btn btn-outline-dark btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="PrintCustodyCard">
                            <i class="bi bi-printer-fill me-1"></i> طباعة محضر جرد وعهدة القسم (رسمي)
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-2">
                <h6 class="fw-bold text-dark m-0">🏭 الماكينات والمعدات بعهدة (@selectedCustodyDept)</h6>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered mb-0 text-center align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>كود الأصل</th>
                            <th>اسم الماكينة</th>
                            <th>الماركة والموديل</th>
                            <th>الرقم التسلسلي</th>
                            <th>الحالة الفنية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in DepartmentFixedAssets)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@a.AssetCode</td>
                                <td class="fw-bold text-start ps-2">@a.Name</td>
                                <td>@a.BrandModel</td>
                                <td class="font-monospace text-muted">@a.SerialNumber</td>
                                <td><span class="badge @GetAssetStatusBadge(a.Status)">@TranslateAssetStatus(a.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

<!-- مودال 1: صرف أسبات -->
@if (isCrateDispatchModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">📦 إصدار إذن تسليم وصرف أسبات / صواني (طرف أول مُسلِّم)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isCrateDispatchModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">نوع الوعاء / الحاوية *</label>
                            <select class="form-select fw-bold border-primary" @bind="newCrateDispatch.ContainerName">
                                @foreach (var c in circulatingAssetsList)
                                {
                                    <option value="@c.ContainerName">@c.ContainerName (@c.Specification)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">نوع الحركة *</label>
                            <select class="form-select fw-bold border-primary" @bind="newCrateDispatch.MovementType">
                                <option value="DISPATCH_BRANCH">صرف للفروع وسيارات التوزيع 📤</option>
                                <option value="RETURN_FACTORY">استلام ومرتجع للمصنع 📥</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">الكمية المنصرفة (بالعدد) *</label>
                            <input type="number" min="1" class="form-control text-center fw-bold font-monospace fs-5 border-primary" @bind="newCrateDispatch.DispatchedQuantity" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1 d-flex justify-content-between">
                                <span>القائم بالصرف والتسليم (المُسلِّم):</span>
                                <span class="badge bg-secondary font-monospace">🔒 موثق تلقائياً</span>
                            </label>
                            <input type="text" class="form-control fw-bold bg-white text-primary" value="@CurrentCustodianDisplayName" readonly disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">الموقع المُرسل (المصدر) *</label>
                            <input type="text" class="form-control" placeholder="مثال: مستودع التعبئة المركزي" @bind="newCrateDispatch.SourceLocation" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">الموقع المستلم (الجهة / الفرع) *</label>
                            <input type="text" class="form-control" placeholder="مثال: فرع الدقي / سيارة رقم 5" @bind="newCrateDispatch.DestinationLocation" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-secondary mb-1">ملاحظات إذن التسليم</label>
                            <input type="text" class="form-control" placeholder="أرقام سيارات، أذون تسليم، أو تعليمات خاصة..." @bind="newCrateDispatch.Notes" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isCrateDispatchModalOpen = false">إلغاء</button>
                    <button class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" disabled="@isSubmittingCrate" @onclick="SubmitCrateDispatch">
                        @(isSubmittingCrate ? "⏳ جاري الاعتماد..." : "💾 حفظ وإصدار إذن التسليم")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال 2: تأكيد الاستلام الميداني للأسبات (مرن للمسؤولين) -->
@if (isCrateReceiveModalOpen && selectedMovementForReceive != null)
{
    var isSameUser = !string.IsNullOrWhiteSpace(State.EmployeeCode) && selectedMovementForReceive.DispatchedByCode.Equals(State.EmployeeCode, StringComparison.OrdinalIgnoreCase);
    var canBypassSoD = State.HasAnyPermission("Roles.Manage", "Crates.SettleDispute") || (State.EmployeeCode?.Contains("ADMIN") == true);

    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">📥 فحص وتأكيد الاستلام الميداني: إذن رقم (@selectedMovementForReceive.MovementNumber)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isCrateReceiveModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    @if (isSameUser && !canBypassSoD)
                    {
                        <div class="alert alert-danger py-2 small fw-bold mb-3 border-danger">
                            ⛔ <strong>حظر رقابي (Segregation of Duties):</strong> أنت مسجل كـ "المُسلِّم" لهذا الإذن، ولا يجوز لك قانوناً ورقابياً تأكيد الاستلام لنفسك. يجب أن يدخل الطرف المستلم بحسابه لتأكيد الاستلام.
                        </div>
                    }
                    else if (isSameUser && canBypassSoD)
                    {
                        <div class="alert alert-info py-2 small fw-bold mb-3 border-info">
                            ℹ️ <strong>تنبيه إداري:</strong> تم تمكين تأكيد الاستلام بحساب المسؤول لأغراض الاختبار والمطابقة الشاملة.
                        </div>
                    }

                    <div class="card p-3 bg-white border-0 shadow-sm mb-3">
                        <div class="row g-2 small">
                            <div class="col-md-4">
                                <span class="text-muted d-block">نوع الوعاء:</span>
                                <strong class="fs-6 text-primary">@selectedMovementForReceive.ContainerName</strong>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted d-block">الكمية المنصرفة من المُسلِّم:</span>
                                <strong class="fs-6 font-monospace text-dark">@selectedMovementForReceive.DispatchedQuantity وعاء</strong>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted d-block">المُسلِّم المعتمد:</span>
                                <strong class="text-secondary">@selectedMovementForReceive.DispatchedByName</strong>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-success mb-1">الكمية المستلمة السليمة فعلياً *</label>
                            <input type="number" min="0" class="form-control text-center fw-bold font-monospace fs-5 border-success" @bind="receiveCrateDto.ActualReceivedQuantity" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-danger mb-1">عدد الأوعية المكسورة والتالفة *</label>
                            <input type="number" min="0" class="form-control text-center fw-bold font-monospace fs-5 border-danger" @bind="receiveCrateDto.DamagedCount" />
                        </div>

                        @{
                            var calcShortage = selectedMovementForReceive.DispatchedQuantity - receiveCrateDto.ActualReceivedQuantity;
                        }
                        @if (calcShortage > 0 || receiveCrateDto.DamagedCount > 0)
                        {
                            <div class="col-12">
                                <div class="alert alert-warning py-2 small fw-bold mb-0">
                                    ⚠️ <strong>تنبيه عجز وكسر:</strong> يوجد عجز بمقدار (@calcShortage) وعاء مفقود، و (@receiveCrateDto.DamagedCount) وعاء تالف. سيتم تحويل الإذن فوراً إلى <strong>(نزاع رسمي DISPUTED)</strong> للإحالة إلى لجنة فض المنازعات.
                                </div>
                            </div>
                        }

                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark mb-1">ملاحظات الاستلام وأسباب الكسر أو العجز</label>
                            <input type="text" class="form-control" placeholder="اكتب ملاحظات المعاينة الميدانية بدقة..." @bind="receiveCrateDto.ReceiveNotes" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isCrateReceiveModalOpen = false">إلغاء</button>
                    <button class="btn btn-success btn-sm px-4 fw-bold shadow-sm"
                            disabled="@(isSubmittingCrate || (isSameUser && !canBypassSoD))"
                            @onclick="SubmitCrateReceive">
                        @(isSubmittingCrate ? "⏳ جاري المعالجة..." : "✅ تأكيد المعاينة والاستلام")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال 3: فض وتسوية النزاع والعجز -->
@if (isCrateSettleModalOpen && selectedMovementForSettle != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger text-white py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">⚖️ محضر فض وتسوية نزاع الحاويات: إذن (@selectedMovementForSettle.MovementNumber)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isCrateSettleModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    <div class="alert alert-danger py-2 small mb-3 border-danger">
                        📌 <strong>واقعة النزاع:</strong> من منصرف (@selectedMovementForSettle.DispatchedQuantity) تم استلام (@selectedMovementForSettle.ReceivedQuantity)، بعجز قدره <strong>(@selectedMovementForSettle.ShortageQuantity) مفقود</strong> و <strong>(@selectedMovementForSettle.DamagedCount) تالف/مكسور</strong>.
                        <br />
                        <span class="text-muted">ملاحظة المستلم: @selectedMovementForSettle.ReceiveNotes</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">قرار لجنة التحكيم المعتمد *</label>
                            <select class="form-select fw-bold border-danger" @bind="settleDisputeDto.ArbitrationDecision">
                                <option value="تحميل العجز على المستلم (إهمال)">تحميل العجز والكسر على المستلم (إهمال)</option>
                                <option value="تحميل العجز على السائق والمُسلِّم">تحميل العجز على السائق والمُسلِّم (نقل)</option>
                                <option value="إقرار هدر تشغيلي مسموح به (استهلاك)">إقرار هدر تشغيلي طبيعي معتمد</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">الجزاء أو التعويض المالي المقدر (ج.م)</label>
                            <input type="number" min="0" step="10" class="form-control font-monospace fw-bold text-center border-danger text-danger fs-5" @bind="settleDisputeDto.FinancialPenalty" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark mb-1">نص منطوق القرار ومحضر التسوية النهائي *</label>
                            <textarea class="form-control" rows="3" placeholder="اكتب حيثيات قرار لجنة فض المنازعات والخصم المالي المعتمد..." @bind="settleDisputeDto.ArbitrationText"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isCrateSettleModalOpen = false">إلغاء</button>
                    <button class="btn btn-danger btn-sm px-4 fw-bold shadow-sm" disabled="@isSubmittingCrate" @onclick="SubmitCrateSettle">
                        @(isSubmittingCrate ? "⏳ جاري الاعتماد..." : "⚖️ اعتماد القرار وتسوية العهدة")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال 4: إطلاق بلاغ طوارئ مباشر (SOS) -->
@if (isDirectSOSModalOpen && assetForSOS != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">🚨 إطلاق بلاغ طارئ واستدعاء صيانة فوري: @assetForSOS.Name</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isDirectSOSModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    <div class="alert alert-danger py-2 small mb-3 border-danger">
                        ⚠️ <strong>تنبيه تشغيلي:</strong> سيتم تحويل حالة الماكينة <strong>[@assetForSOS.AssetCode]</strong> فوراً إلى <strong>(تحت الصيانة والإصلاح UNDER_MAINTENANCE)</strong> وإحالتها لغرفة العمليات.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">عنوان المشكلة أو العطل الطارئ *</label>
                        <input type="text" class="form-control fw-bold border-danger" @bind="directSOSTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">شرح مظهر العطل</label>
                        <textarea class="form-control" rows="3" @bind="directSOSDescription"></textarea>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isDirectSOSModalOpen = false">إلغاء</button>
                    <button class="btn btn-danger btn-sm px-4 fw-bold shadow-sm" @onclick="SubmitDirectSOS">🚨 إرسال البلاغ وتثبيت حالة العطل</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال 5: نقل عهدة ماكينة -->
@if (isMachineTransferModalOpen && selectedMachineToTransfer != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">🔄 نقل عهدة ماكينة: @selectedMachineToTransfer.Name</h6>
                    <button type="button" class="btn-close" @onclick="() => isMachineTransferModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="small text-muted fw-bold">الصالة الحالية (المصدر):</label>
                            <input type="text" class="form-control fw-bold bg-light" value="@selectedMachineToTransfer.Department" readonly disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="small text-muted fw-bold">مسؤول العهدة الحالي:</label>
                            <input type="text" class="form-control fw-bold bg-light font-monospace" value="@($"[{selectedMachineToTransfer.CustodianCode}] {selectedMachineToTransfer.CustodianName}")" readonly disabled />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">الصالة المستلمة الجديدة *</label>
                            <select class="form-select fw-bold border-success" @bind="targetTransferDept">
                                @foreach (var d in dbDepartments)
                                {
                                    <option value="@d.DisplayName">@d.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">المشرف المستلم الجديد (من HR) *</label>
                            <select class="form-select fw-bold border-success font-monospace" @bind="targetTransferEmpCode">
                                <option value="">-- اضغط لاختيار المستلم الجديد --</option>
                                @foreach (var emp in employeesCatalog)
                                {
                                    <option value="@emp.DisplayCode">[@emp.DisplayCode] - @emp.DisplayName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isMachineTransferModalOpen = false">إلغاء</button>
                    <button class="btn btn-warning text-dark btn-sm px-4 fw-bold shadow-sm" @onclick="SubmitMachineTransfer">🔄 ترحيل وتثبيت النقل</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال 6: قيد / تعديل أصل ثابت -->
@if (isFixedAssetModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">@(editingFixedAsset.Id == 0 ? "🏭 قيد أصل / ماكينة جديدة" : $"🛠 تعديل أصل: {editingFixedAsset.Name}")</h6>
                    <button type="button" class="btn-close" @onclick="() => isFixedAssetModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">كود الأصل (Tag) *</label>
                            <input type="text" class="form-control font-monospace fw-bold text-primary" @bind="editingFixedAsset.AssetCode" />
                        </div>
                        <div class="col-md-8">
                            <label class="small fw-bold text-dark mb-1">اسم الماكينة *</label>
                            <input type="text" class="form-control fw-bold" @bind="editingFixedAsset.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">القسم / الصالة المخصصة *</label>
                            <select class="form-select fw-bold border-primary" @bind="editingFixedAsset.Department">
                                @foreach (var d in dbDepartments)
                                {
                                    <option value="@d.DisplayName">@d.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">مسؤول العهدة (من HR) *</label>
                            <select class="form-select fw-bold border-info font-monospace" @onchange="OnCustodianSelected">
                                <option value="">-- اختر الموظف المسؤول --</option>
                                @foreach (var emp in employeesCatalog)
                                {
                                    var isSelected = emp.DisplayCode == editingFixedAsset.CustodianCode;
                                    <option value="@emp.DisplayCode" selected="@isSelected">[@emp.DisplayCode] - @emp.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">الماركة والموديل</label>
                            <input type="text" class="form-control" @bind="editingFixedAsset.BrandModel" />
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">الرقم التسلسلي (S/N)</label>
                            <input type="text" class="form-control font-monospace" @bind="editingFixedAsset.SerialNumber" />
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">الحالة التشغيلية</label>
                            <select class="form-select fw-bold" @bind="editingFixedAsset.Status">
                                <option value="OPERATIONAL">تعمل بكفاءة تامة ✓</option>
                                <option value="UNDER_MAINTENANCE">تحت الصيانة والإصلاح ⚙️</option>
                                <option value="OUT_OF_SERVICE">معطلة تماماً ⛔</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isFixedAssetModalOpen = false">إلغاء</button>
                    <button class="btn btn-warning text-dark btn-sm px-4 fw-bold shadow-sm" @onclick="SaveFixedAsset">💾 حفظ الأصل</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال 7: سجل عمليات الماكينة -->
@if (isAssetHistoryModalOpen && selectedHistoryAsset != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">📜 سجل عمليات الماكينة: @selectedHistoryAsset.Name</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isAssetHistoryModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    <table class="table table-bordered bg-white text-center small">
                        <thead><tr><th>التاريخ</th><th>النوع</th><th>البيان</th><th>المسؤول</th><th>الأثر</th></tr></thead>
                        <tbody>
                            @if (!selectedHistoryAsset.HistoryLogs.Any())
                            {
                                <tr><td colspan="5" class="text-muted py-3">لا توجد عمليات مسجلة في الأرشيف لهذه الماكينة.</td></tr>
                            }
                            else
                            {
                                @foreach (var log in selectedHistoryAsset.HistoryLogs)
                                {
                                    <tr><td>@log.Date.ToString("yyyy-MM-dd")</td><td>@log.EventType</td><td>@log.Description</td><td>[@log.PerformedByCode] @log.PerformedByName</td><td>@log.CostImpact</td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
