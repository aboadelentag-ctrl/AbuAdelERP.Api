    private async Task ExportBalancesToExcelAsync()
    {
        var list = FilteredBalances.ToList();
        if (!list.Any())
        {
            errorMessage = "لا توجد أرصدة عهد لتصديرها.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("كود_الأصل,اسم_الأصل_العهدة,نوع_الجهة,اسم_الجهة_الحائزة,الرصيد_الفعلي,تاريخ_آخر_تحديث");

            foreach (var b in list)
            {
                var partyType = TranslatePartyType(b.PartyType);
                var partyName = GetPartyName(b.PartyType, b.PartyId);
                sb.AppendLine($"{EscapeCsv(b.ItemCode)},{EscapeCsv(b.ItemName)},{EscapeCsv(partyType)},{EscapeCsv(partyName)},{b.Quantity},{b.LastUpdatedAt:yyyy-MM-dd HH:mm}");
            }

            var fileName = $"كشف_ارصدة_العهد_والأسبات_أبو_عادل_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            successMessage = $"تم تصدير ({list.Count}) رصيد عهدة بنجاح.";
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل التصدير: {ex.Message}";
        }
    }

