    }

    private async Task ImportAssetsFromExcel(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream());
            string? header = await reader.ReadLineAsync();
            int count = 0;

            while (!reader.EndOfStream)
            {
                var line = await reader.ReadLineAsync();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = line.Split(',');
                if (cols.Length >= 2)
                {
                    var assetCode = cols[0].Trim().Replace("\"", "");
                    var name = cols[1].Trim().Replace("\"", "");
                    var dept = cols.Length > 2 ? cols[2].Trim().Replace("\"", "") : "قسم الشرقي والمخبوزات";
                    var cat = cols.Length > 3 ? cols[3].Trim().Replace("\"", "") : "أفران وتسوية";
                    var model = cols.Length > 4 ? cols[4].Trim().Replace("\"", "") : "";
                    var serial = cols.Length > 5 ? cols[5].Trim().Replace("\"", "") : "";
                    var custName = cols.Length > 6 ? cols[6].Trim().Replace("\"", "") : State.FullName;
                    var custCode = cols.Length > 7 ? cols[7].Trim().Replace("\"", "") : State.EmployeeCode;

                    var dto = new
                    {
                        AssetCode = assetCode,
                        Name = name,
                        Department = dept,
                        Category = cat,
                        BrandModel = model,
                        SerialNumber = serial,
                        CustodianCode = custCode,
                        CustodianName = custName,
                        InstallationDate = DateTime.UtcNow
                    };

                    var res = await Http.PostAsJsonAsync("api/FixedAssets", dto);
                    if (res.IsSuccessStatusCode) count++;
                }
            }

            await LoadFixedAssets();
            feedbackMessage = $"✅ تم استيراد ({count}) ماكينة وأصل بنجاح وترحيلها لقاعدة البيانات!";
            isSuccessFeedback = true;
        }
        catch (Exception ex)
        {
            feedbackMessage = $"❌ خطأ أثناء الاستيراد: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

