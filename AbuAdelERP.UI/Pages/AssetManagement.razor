    private void OpenCrateDispatchModal()
    {
        crateSourceDept = !string.IsNullOrEmpty(State.DepartmentName) ? State.DepartmentName : "مستودع التعبئة والتغليف والتوزيع";
        crateSourceEmpCode = employeesCatalog.FirstOrDefault(e => e.DisplayCode == State.EmployeeCode)?.DisplayCode ?? (employeesCatalog.FirstOrDefault()?.DisplayCode ?? "");
        
        crateDestLocation = "سيارة توزيع رقم 1 (سائق)";
        crateDestEmpCode = employeesCatalog.FirstOrDefault(e => e.DisplayCode != crateSourceEmpCode)?.DisplayCode ?? "";

        var defaultCrateName = AvailableContainerItems.FirstOrDefault()?.DisplayName ?? "سبت بلاستيك كبير";

        newDispatch = new CrateHandoverMovementModel
        {
            MovementNumber = $"CRT-{DateTime.Now:yyyyMMdd}-{new Random().Next(100, 999)}",
            ContainerName = defaultCrateName,
            DispatchedQuantity = 50,
            MovementType = "DISPATCH_BRANCH",
            Notes = ""
        };
        isDispatchModalOpen = true;
    }

    private async Task SubmitCrateDispatch()
    {
        if (newDispatch.DispatchedQuantity <= 0 || string.IsNullOrWhiteSpace(crateDestLocation))
        {
            feedbackMessage = "⚠️ يرجى تحديد كمية صحيحة وتحديد الجهة أو السيارة المستلمة للأسبات!";
            isSuccessFeedback = false;
            return;
        }

        try
        {
            var sourceEmp = employeesCatalog.FirstOrDefault(e => e.DisplayCode == crateSourceEmpCode);
            var destEmp = employeesCatalog.FirstOrDefault(e => e.DisplayCode == crateDestEmpCode);

            newDispatch.SourceLocation = $"{crateSourceDept}";
            newDispatch.DispatchedByCode = sourceEmp?.DisplayCode ?? State.EmployeeCode;
            newDispatch.DispatchedByName = sourceEmp?.DisplayName ?? State.FullName;

            string destWorkerInfo = destEmp != null ? $" - [{destEmp.DisplayCode}] {destEmp.DisplayName}" : "";
            newDispatch.DestinationLocation = $"{crateDestLocation}{destWorkerInfo}";

            var dto = new
            {
                MovementType = newDispatch.MovementType,
                ContainerName = newDispatch.ContainerName,
                DispatchedQuantity = newDispatch.DispatchedQuantity,
                SourceLocation = newDispatch.SourceLocation,
                DestinationLocation = newDispatch.DestinationLocation,
                Notes = newDispatch.Notes
            };

            var res = await Http.PostAsJsonAsync("api/Crates/dispatch", dto);
            if (res.IsSuccessStatusCode)
            {
                await LoadCrateData();
                feedbackMessage = $"🚀 تم إصدار إذن صرف الأوعية ({newDispatch.MovementNumber}) بكمية ({newDispatch.DispatchedQuantity}) بنجاح!";
                isSuccessFeedback = true;
                isDispatchModalOpen = false;
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                feedbackMessage = $"❌ فشل إصدار الإذن: {err}";
                isSuccessFeedback = false;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"خطأ: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

