    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1) return;

            var header = lines[0].Split(',');
            int codeIdx = 0, nameIdx = 1, partyTypeIdx = 2, partyNameIdx = 3, qtyIdx = 4, notesIdx = 5;

            for (int i = 0; i < header.Length; i++)
            {
                var h = header[i].Trim().ToLower();
                if (h.Contains("كود") || h.Contains("code")) codeIdx = i;
                else if (h.Contains("أصل") || h.Contains("صنف") || h.Contains("item")) nameIdx = i;
                else if (h.Contains("نوع") && (h.Contains("جهة") || h.Contains("type"))) partyTypeIdx = i;
                else if (h.Contains("جهة") || h.Contains("party")) partyNameIdx = i;
                else if (h.Contains("كمي") || h.Contains("رصيد") || h.Contains("qty")) qtyIdx = i;
                else if (h.Contains("ملاحظ") || h.Contains("notes")) notesIdx = i;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = line.Split(',');
                if (cols.Length >= 3)
                {
                    string code = codeIdx < cols.Length ? cols[codeIdx].Trim() : "";
                    string name = nameIdx < cols.Length ? cols[nameIdx].Trim() : "";
                    string rawType = partyTypeIdx < cols.Length ? cols[partyTypeIdx].Trim() : "";
                    string rawParty = partyNameIdx < cols.Length ? cols[partyNameIdx].Trim() : "";
                    decimal.TryParse(qtyIdx < cols.Length ? cols[qtyIdx].Trim() : "0", out var qty);
                    string notes = notesIdx < cols.Length ? cols[notesIdx].Trim() : "جرد واستيراد آلي";

                    // مطابقة نوع الجهة
                    string resolvedType = "DEPARTMENT";
                    if (rawType.Contains("عميل") || rawType.Contains("مندوب") || rawType.Equals("CUSTOMER", StringComparison.OrdinalIgnoreCase)) resolvedType = "CUSTOMER";
                    else if (rawType.Contains("مخزن") || rawType.Equals("WAREHOUSE", StringComparison.OrdinalIgnoreCase)) resolvedType = "WAREHOUSE";
                    else if (rawType.Contains("نظام") || rawType.Equals("SYSTEM", StringComparison.OrdinalIgnoreCase)) resolvedType = "SYSTEM";

                    // مطابقة الأصل في الدليل
                    var matchedItem = items.FirstOrDefault(it =>
                        (!string.IsNullOrEmpty(code) && it.ItemCode.Equals(code, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(name) && it.ItemName.Contains(name, StringComparison.OrdinalIgnoreCase)));

                    // مطابقة الجهة
                    var matchedParty = parties.FirstOrDefault(p =>
                        p.PartyType == resolvedType &&
                        (!string.IsNullOrEmpty(rawParty) && (p.PartyName.Contains(rawParty, StringComparison.OrdinalIgnoreCase) || rawParty.Contains(p.PartyName))));

                    importedPreviewList.Add(new AssetImportRowPreview
                    {
                        RawItemName = !string.IsNullOrEmpty(name) ? name : code,
                        MatchedItemId = matchedItem?.Id ?? 0,
                        MatchedItemName = matchedItem?.ItemName ?? "غير مطابق",
                        PartyType = resolvedType,
                        RawPartyName = rawParty,
                        MatchedPartyId = matchedParty?.PartyId ?? (resolvedType == "SYSTEM" ? 0 : -1),
                        MatchedPartyName = matchedParty?.PartyName ?? (resolvedType == "SYSTEM" ? "النظام" : "غير مطابقة"),
                        Quantity = qty,
                        Notes = notes
                    });
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في قراءة ملف الإكسيل: {ex.Message}";
        }
    }

    private async Task ProcessAndSaveImportAsync()
    {
        var validRows = importedPreviewList.Where(r => r.MatchedItemId > 0 && r.MatchedPartyId >= 0).ToList();
        if (!validRows.Any()) return;

        isSavingImport = true;
        try
        {
            var payload = validRows.Select(x => new
            {
                ItemId = x.MatchedItemId,
                PartyType = x.PartyType,
                PartyId = x.MatchedPartyId,
                Quantity = x.Quantity,
                Notes = x.Notes
            }).ToList();

            var res = await Http.PostAsJsonAsync($"{apiUrl}/import-balances", payload);
            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<ImportResultDto>();
                successMessage = result?.Message ?? "تم استيراد وتحديث أرصدة العهد بنجاح!";
                CloseImportModal();
                await LoadBalances();
            }
            else
            {
                errorMessage = "❌ " + await res.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء حفظ البيانات: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }

