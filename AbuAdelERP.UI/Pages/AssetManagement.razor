@page "/asset-management"
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.IO

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة وأزرار التصدير والاستيراد والتحديث -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-start border-primary border-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="text-primary mb-1 fw-bold">📦 إدارة حركة الأصول والعهد (تتبع الأسبات والصواني)</h4>
                <small class="text-muted">نظام متكامل لتتبع الأسبات، الصيجان، الباليتات، والتروليات بين كافة الأقسام، المخازن، والعملاء</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (activeTab == "balances")
                {
                    <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportBalancesToExcelAsync">
                        <i class="bi bi-file-earmark-excel me-1"></i> تصدير كشف الأرصدة (إكسيل)
                    </button>
                    <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                        <i class="bi bi-download me-1"></i> تحميل قالب استيراد العهد
                    </button>
                    <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد عهد من إكسيل
                    </button>
                }
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadDataAsync">
                    <i class="bi bi-arrow-clockwise"></i> تحديث البيانات
                </button>
            </div>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger fw-bold shadow-sm mb-3 py-2 alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
            <button type="button" class="btn-close py-2" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success fw-bold shadow-sm mb-3 py-2 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @successMessage
            <button type="button" class="btn-close py-2" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    <!-- بطاقات المؤشرات اللحظية (KPIs) -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي أصول العهد المسجلة</small>
                <h4 class="mb-0 fw-bold text-primary mt-1 font-monospace">@balances.Sum(b => b.Quantity).ToString("N0") قطعة</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-info border-4 p-3 bg-white">
                <small class="text-muted fw-bold">عهد في صالات وأقسام الإنتاج</small>
                <h4 class="mb-0 fw-bold text-dark mt-1 font-monospace">@balances.Where(b => b.PartyType == "DEPARTMENT").Sum(b => b.Quantity).ToString("N0") قطعة</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 p-3 bg-white">
                <small class="text-muted fw-bold">عهد طرف العملاء والمناديب</small>
                <h4 class="mb-0 fw-bold text-warning mt-1 font-monospace">@balances.Where(b => b.PartyType == "CUSTOMER").Sum(b => b.Quantity).ToString("N0") قطعة</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3 bg-white">
                <small class="text-muted fw-bold">أصول متواجدة بالمخازن الرئيسية</small>
                <h4 class="mb-0 fw-bold text-success mt-1 font-monospace">@balances.Where(b => b.PartyType == "WAREHOUSE").Sum(b => b.Quantity).ToString("N0") قطعة</h4>
            </div>
        </div>
    </div>

    <!-- نظام التبويبات (Tabs) -->
    <ul class="nav nav-tabs mb-3 fw-bold border-bottom" role="tablist">
        <li class="nav-item">
            <button class="nav-link py-2 px-4 @(activeTab == "balances" ? "active text-primary border-primary border-bottom-0 bg-white" : "text-muted")"
                    @onclick="@(() => ChangeTab("balances"))">
                📊 أرصدة العهد الحالية
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-2 px-4 @(activeTab == "movement" ? "active text-primary border-primary border-bottom-0 bg-white" : "text-muted")"
                    @onclick="@(() => ChangeTab("movement"))">
                🔄 تسجيل حركة جديدة (صرف / استلام / نقل)
            </button>
        </li>
    </ul>

    <!-- محتوى التبويبات -->
    <div class="tab-content">

        <!-- ============================================================== -->
        <!-- التبويب الأول: كشف الأرصدة المتداولة والفلاتر                   -->
        <!-- ============================================================== -->
        @if (activeTab == "balances")
        {
            <!-- شريط فلاتر البحث المتقدمة -->
            <div class="card shadow-sm border-0 mb-3 bg-white border-top border-primary border-3">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        <!-- 1. بحث بالاسم أو الكود -->
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary mb-1">🔍 البحث باسم الأصل أو الجهة الحائزة</label>
                            <input type="text" class="form-control form-control-sm" placeholder="اكتب اسم العهدة (سبت، صاج...) أو اسم القسم/العميل..." 
                                   @bind="searchTerm" @bind:event="oninput" />
                        </div>

                        <!-- 2. تصفية بنوع الجهة -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-secondary mb-1">🏢 نوع الجهة الحائزة</label>
                            <select class="form-select form-select-sm fw-bold" @bind="selectedPartyTypeFilter">
                                <option value="all">-- كل أنواع الجهات --</option>
                                <option value="DEPARTMENT">أقسام وصالات الإنتاج</option>
                                <option value="WAREHOUSE">المخازن والمستودعات</option>
                                <option value="CUSTOMER">العملاء والمناديب</option>
                                <option value="SYSTEM">النظام / رصيد افتتاحي</option>
                            </select>
                        </div>

                        <!-- 3. تصفية بحالة الرصيد -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-secondary mb-1">⚖️ حالة الرصيد</label>
                            <select class="form-select form-select-sm" @bind="selectedBalanceStatusFilter">
                                <option value="all">كل الأرصدة</option>
                                <option value="positive">أرصدة فعلية متوفرة (موجب)</option>
                                <option value="negative">أرصدة سالبة (مطلوب استردادها)</option>
                            </select>
                        </div>

                        <!-- 4. زر تفريغ الفلاتر -->
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-outline-danger btn-sm w-100 fw-bold" @onclick="ResetFilters">
                                ✕ إلغاء الفلاتر
                            </button>
                        </div>
                    </div>

                    @if (HasActiveFilters)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                            <span class="small text-primary fw-bold">
                                <i class="bi bi-funnel-fill me-1"></i> نتائج التصفية: (@FilteredBalances.Count() رصيد عهدة مطابق من أصل @balances.Count)
                            </span>
                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" style="font-size: 0.78rem;" @onclick="ResetFilters">
                                عرض الكل
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- جدول الأرصدة المتداولة -->
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold small">📋 كشف توزيع الأرصدة المتداولة</h6>
                    <span class="badge bg-primary">المعروض: @FilteredBalances.Count() سجل</span>
                </div>
                <div class="card-body p-0 table-responsive">
                    @if (isLoading)
                    {
                        <div class="p-5 text-center text-primary fw-bold">
                            <span class="spinner-border spinner-border-sm me-2"></span> جاري تحميل كشف العهد والأصول...
                        </div>
                    }
                    else if (!FilteredBalances.Any())
                    {
                        <div class="p-5 text-center text-muted fw-bold">لا توجد أرصدة عهد مسجلة مطابقة لخيارات الفلترة.</div>
                    }
                    else
                    {
                        <table class="table table-hover table-bordered text-center align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%;">كود الأصل</th>
                                    <th class="text-start ps-3" style="width: 25%;">نوع الأصل (العهدة)</th>
                                    <th style="width: 20%;">نوع الجهة الحائزة</th>
                                    <th class="text-start ps-3" style="width: 20%;">الجهة الحائزة</th>
                                    <th style="width: 10%;">الرصيد الحالي</th>
                                    <th style="width: 10%;">آخر تحديث</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in FilteredBalances)
                                {
                                    <tr @key="b.Id">
                                        <td class="font-monospace fw-bold text-muted">@(!string.IsNullOrEmpty(b.ItemCode) ? b.ItemCode : "-")</td>
                                        <td class="fw-bold text-start ps-3 text-primary">@b.ItemName</td>
                                        <td>
                                            <span class="badge @GetPartyTypeBadgeClass(b.PartyType)">
                                                @TranslatePartyType(b.PartyType)
                                            </span>
                                        </td>
                                        <td class="fw-bold text-start ps-3 text-dark">@GetPartyName(b.PartyType, b.PartyId)</td>
                                        <td>
                                            <span class="badge @(b.Quantity < 0 ? "bg-danger" : "bg-success") fs-6 px-3 py-1 rounded-pill font-monospace shadow-sm">
                                                @b.Quantity.ToString("N0")
                                            </span>
                                        </td>
                                        <td class="text-muted font-monospace">@b.LastUpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        <!-- ============================================================== -->
        <!-- التبويب الثاني: تسجيل حركة جديدة                                -->
        <!-- ============================================================== -->
        @if (activeTab == "movement")
        {
            <div class="row justify-content-center">
                <div class="col-md-9">
                    <div class="card border-0 shadow-sm border-top border-primary border-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="m-0 fw-bold text-primary">📝 إصدار إذن حركة أصل وعُهدة (صرف / استلام / نقل)</h6>
                        </div>
                        <div class="card-body bg-light p-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-secondary">تاريخ الحركة *</label>
                                    <input type="date" class="form-control border-primary fw-bold font-monospace" @bind="newMovement.MovementDate" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-secondary">نوع الأصل (العهدة) *</label>
                                    <select class="form-select border-primary fw-bold" @bind="newMovement.ItemId">
                                        <option value="0">-- اختر الأصل / العهدة --</option>
                                        @foreach (var item in items)
                                        {
                                            <option value="@item.Id">@item.ItemName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row bg-white p-3 rounded border my-3 mx-0 shadow-sm">
                                <div class="col-md-5">
                                    <label class="form-label fw-bold small text-danger">📤 من جهة (المُسَلِّم) *</label>
                                    <select class="form-select fw-bold border-danger" value="@($"{newMovement.FromPartyType}|{newMovement.FromPartyId}")" @onchange="OnFromPartyChanged">
                                        <option value="">-- اختر المُسَلِّم --</option>
                                        @foreach (var party in parties)
                                        {
                                            <option value="@($"{party.PartyType}|{party.PartyId}")">@party.PartyName (@TranslatePartyType(party.PartyType))</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2 d-flex align-items-center justify-content-center text-primary fs-3">
                                    ➡️
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold small text-success">📥 إلى جهة (المُستَلِم) *</label>
                                    <select class="form-select fw-bold border-success" value="@($"{newMovement.ToPartyType}|{newMovement.ToPartyId}")" @onchange="OnToPartyChanged">
                                        <option value="">-- اختر المُستَلِم --</option>
                                        @foreach (var party in parties)
                                        {
                                            <option value="@($"{party.PartyType}|{party.PartyId}")">@party.PartyName (@TranslatePartyType(party.PartyType))</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-secondary">نوع الحركة *</label>
                                    <select class="form-select border-primary fw-bold" @bind="newMovement.MovementType">
                                        <option value="ISSUE">صرف عهدة</option>
                                        <option value="RETURN">استرداد عهدة</option>
                                        <option value="TRANSFER">نقل عهدة بين الأقسام</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-secondary">الكمية *</label>
                                    <input type="number" class="form-control fw-bold text-center fs-5 border-primary font-monospace" @bind="newMovement.Quantity" min="1" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-secondary">رقم الإذن / الملاحظات</label>
                                    <input type="text" class="form-control border-primary" @bind="newMovement.Notes" placeholder="مثال: إذن تسليم مندوب رقم 102" />
                                </div>
                            </div>

                            <div class="mt-4">
                                <button class="btn btn-primary fw-bold w-100 py-2 shadow-sm" @onclick="SaveMovement" disabled="@isSubmitting">
                                    @(isSubmitting ? "⏳ جاري الاعتماد والتسجيل..." : "💾 اعتماد وتسجيل الحركة وتحديث الأرصدة")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ============================================================== -->
<!-- نافذة استيراد أرصدة العهد من إكسيل (IMPORT MODAL)              -->
<!-- ============================================================== -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد وتحديث أرصدة العهد من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> 
                        يتعرف النظام تلقائياً على اسم العهدة (الأصل) والجهة الحائزة والكمية، ويقوم بتسجيل الحركة وتحديث الرصيد التراكمي آلياً.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة بنود العهد المقروءة من الملف (@importedPreviewList.Count بند):</span>
                            <span class="badge bg-success">جاهز للتحديث</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>كود/اسم الأصل المقروء</th>
                                        <th>الأصل المطابق بالدليل</th>
                                        <th>نوع الجهة</th>
                                        <th>الجهة الحائزة المطابقة</th>
                                        <th>الكمية الفعلية</th>
                                        <th>الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@row.RawItemName</td>
                                            <td>
                                                @if (row.MatchedItemId > 0)
                                                {
                                                    <span class="text-success fw-bold">✔ @row.MatchedItemName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger fw-bold">✖ غير مطابق</span>
                                                }
                                            </td>
                                            <td><span class="badge @GetPartyTypeBadgeClass(row.PartyType)">@TranslatePartyType(row.PartyType)</span></td>
                                            <td class="fw-bold">
                                                @if (row.MatchedPartyId >= 0)
                                                {
                                                    <span class="text-success">✔ @row.MatchedPartyName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger">✖ غير مطابقة</span>
                                                }
                                            </td>
                                            <td class="font-monospace fw-bold text-primary">@row.Quantity.ToString("N0")</td>
                                            <td class="text-muted text-start ps-2">@row.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@(isSavingImport || !importedPreviewList.Any(r => r.MatchedItemId > 0 && r.MatchedPartyId >= 0))" 
                            @onclick="ProcessAndSaveImportAsync">
                        @if (isSavingImport)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري معالجة وتحديث الأرصدة...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check-circle"></i> تأكيد استيراد وتحديث الأرصدة (@importedPreviewList.Count(r => r.MatchedItemId > 0 && r.MatchedPartyId >= 0))</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "balances";
    private string successMessage = "";
    private string errorMessage = "";

    private List<PartyDto> parties = new();
    private List<ItemDto> items = new();
    private List<AssetBalanceDto> balances = new();
    private List<AssetImportRowPreview> importedPreviewList = new();

    private AssetMovementDto newMovement = new() { MovementDate = DateOnly.FromDateTime(DateTime.Now), MovementType = "ISSUE", Quantity = 1 };

    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isSavingImport = false;
    private bool isImportModalOpen = false;

    // فلاتر البحث
    private string searchTerm = "";
    private string selectedPartyTypeFilter = "all";
    private string selectedBalanceStatusFilter = "all";

    private string apiUrl = "api/AssetTracking";
    private string apiItemsUrl = "api/Items";

    public class AssetImportRowPreview
    {
        public string RawItemName { get; set; } = string.Empty;
        public long MatchedItemId { get; set; }
        public string MatchedItemName { get; set; } = string.Empty;
        public string PartyType { get; set; } = "DEPARTMENT";
        public string RawPartyName { get; set; } = string.Empty;
        public long MatchedPartyId { get; set; } = -1;
        public string MatchedPartyName { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public string Notes { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            await LoadParties();
            await LoadItems();
            await LoadBalances();
        }
        catch (Exception ex)
        {
            errorMessage = "❌ تعذر تحميل البيانات من السيرفر: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ChangeTab(string tab)
    {
        activeTab = tab;
        successMessage = ""; 
        errorMessage = "";
        if (tab == "balances") { InvokeAsync(LoadBalances); }
    }

    private async Task LoadParties()
    {
        try { parties = await Http.GetFromJsonAsync<List<PartyDto>>($"{apiUrl}/parties") ?? new(); } catch { }
    }

    private async Task LoadItems()
    {
        try
        {
            var allItems = await Http.GetFromJsonAsync<List<ItemDto>>(apiItemsUrl) ?? new();
            // تصفية أصول وحاويات التداول أو جلب كافة الأصناف
            items = allItems.Where(i => i.ItemType == "أصول / حاويات تداول" || i.ItemType.Contains("أصول") || i.ItemType == "خامات" || i.ItemType == "منتج تام").ToList();
            if (!items.Any()) items = allItems;
        }
        catch { }
    }

    private async Task LoadBalances()
    {
        try { balances = await Http.GetFromJsonAsync<List<AssetBalanceDto>>($"{apiUrl}/balances") ?? new(); } catch { }
    }

    // ==========================================
    // محرك الفلترة المتعددة
    // ==========================================
    private IEnumerable<AssetBalanceDto> FilteredBalances
    {
        get
        {
            var query = balances.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(b =>
                    b.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(b.ItemCode) && b.ItemCode.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    GetPartyName(b.PartyType, b.PartyId).Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedPartyTypeFilter != "all")
            {
                query = query.Where(b => b.PartyType.Equals(selectedPartyTypeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedBalanceStatusFilter == "positive")
            {
                query = query.Where(b => b.Quantity > 0);
            }
            else if (selectedBalanceStatusFilter == "negative")
            {
                query = query.Where(b => b.Quantity < 0);
            }

            return query;
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        selectedPartyTypeFilter != "all" ||
        selectedBalanceStatusFilter != "all";

    private void ResetFilters()
    {
        searchTerm = "";
        selectedPartyTypeFilter = "all";
        selectedBalanceStatusFilter = "all";
    }

