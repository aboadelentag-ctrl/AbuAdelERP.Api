    private async Task SaveFixedAsset()
    {
        modalErrorMessage = "";
        if (string.IsNullOrWhiteSpace(editingFixedAsset.Name) || string.IsNullOrWhiteSpace(editingFixedAsset.AssetCode))
        {
            modalErrorMessage = "⚠️ يرجى إدخال كود الأصل واسم الماكينة!";
            return;
        }

        isSavingAsset = true;
        try
        {
            if (editingFixedAsset.Id == 0)
            {
                var dto = new
                {
                    AssetCode = editingFixedAsset.AssetCode.Trim(),
                    Name = editingFixedAsset.Name.Trim(),
                    Department = editingFixedAsset.Department,
                    Category = editingFixedAsset.Category ?? "أفران وتسوية",
                    BrandModel = editingFixedAsset.BrandModel ?? "",
                    SerialNumber = editingFixedAsset.SerialNumber ?? "",
                    CustodianCode = editingFixedAsset.CustodianCode,
                    CustodianName = editingFixedAsset.CustodianName,
                    InstallationDate = DateTime.UtcNow
                };

                var res = await Http.PostAsJsonAsync("api/FixedAssets", dto);
                if (res.IsSuccessStatusCode)
                {
                    await LoadFixedAssets();
                    feedbackMessage = $"✅ تم قيد الماكينة ({editingFixedAsset.Name}) وتثبيت العهدة بنجاح!";
                    isSuccessFeedback = true;
                    isFixedAssetModalOpen = false;
                }
                else
                {
                    var err = await res.Content.ReadAsStringAsync();
                    modalErrorMessage = $"❌ فشل الحفظ: {err}";
                }
            }
            else
            {
                var dto = new
                {
                    Name = editingFixedAsset.Name.Trim(),
                    Department = editingFixedAsset.Department,
                    Category = editingFixedAsset.Category ?? "أفران وتسوية",
                    BrandModel = editingFixedAsset.BrandModel ?? "",
                    SerialNumber = editingFixedAsset.SerialNumber ?? "",
                    CustodianCode = editingFixedAsset.CustodianCode,
                    CustodianName = editingFixedAsset.CustodianName,
                    Status = editingFixedAsset.Status
                };

                var res = await Http.PutAsJsonAsync($"api/FixedAssets/{editingFixedAsset.Id}", dto);
                if (res.IsSuccessStatusCode)
                {
                    await LoadFixedAssets();
                    feedbackMessage = $"✅ تم تحديث بيانات الماكينة بنجاح!";
                    isSuccessFeedback = true;
                    isFixedAssetModalOpen = false;
                }
            }
        }
        catch (Exception ex)
        {
            modalErrorMessage = $"❌ خطأ: {ex.Message}";
        }
        finally
        {
            isSavingAsset = false;
        }
    }

