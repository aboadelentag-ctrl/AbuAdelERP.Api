    private IEnumerable<FixedAssetModel> FilteredFixedAssets
    {
        get
        {
            var list = fixedAssetsList.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(fixedDeptFilter))
                list = list.Where(a => a.Department.Equals(fixedDeptFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(fixedCategoryFilter))
                list = list.Where(a => a.Category != null && a.Category.Equals(fixedCategoryFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(fixedStatusFilter))
                list = list.Where(a => a.Status.Equals(fixedStatusFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(fixedAssetSearch))
            {
                var term = fixedAssetSearch.Trim();
                list = list.Where(a =>
                    a.AssetCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    a.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    a.CustodianName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    a.Department.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return list;
        }
    }

