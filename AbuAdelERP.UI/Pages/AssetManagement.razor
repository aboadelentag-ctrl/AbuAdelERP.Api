    private void UpdateSelectedMachineInfo()
    {
        selectedMachineToTransfer = fixedAssetsList.FirstOrDefault(m => m.AssetCode == selectedMachineTransferCode);
        if (selectedMachineToTransfer != null)
        {
            targetTransferDept = dbDepartments.FirstOrDefault(d => d.DisplayName != selectedMachineToTransfer.Department)?.DisplayName ?? dbDepartments.FirstOrDefault()?.DisplayName ?? "";
            targetTransferEmpCode = employeesCatalog.FirstOrDefault(e => e.DisplayCode != selectedMachineToTransfer.CustodianCode)?.DisplayCode ?? "";
            machineTransferReason = $"نقل عهدة الماكينة من {selectedMachineToTransfer.Department} إلى {targetTransferDept}";
        }
    }

    private async Task SubmitMachineTransfer()
    {
        if (selectedMachineToTransfer == null) return;

        if (string.IsNullOrWhiteSpace(targetTransferDept) || string.IsNullOrWhiteSpace(targetTransferEmpCode))
        {
            feedbackMessage = "⚠️ يرجى تحديد الصالة الجديدة والمشرف المستلم للماكينة!";
            isSuccessFeedback = false;
            return;
        }

        try
        {
            var targetEmp = employeesCatalog.FirstOrDefault(e => e.DisplayCode == targetTransferEmpCode);

            // تحديث الأصل مباشرة في قاعدة البيانات
            selectedMachineToTransfer.Department = targetTransferDept;
            selectedMachineToTransfer.CustodianCode = targetTransferEmpCode;
            selectedMachineToTransfer.CustodianName = targetEmp?.DisplayName ?? "مشرف الصالة الجديدة";

            var updateDto = new
            {
                Name = selectedMachineToTransfer.Name,
                Department = selectedMachineToTransfer.Department,
                Category = selectedMachineToTransfer.Category ?? "أفران وتسوية",
                BrandModel = selectedMachineToTransfer.BrandModel ?? "",
                SerialNumber = selectedMachineToTransfer.SerialNumber ?? "",
                CustodianCode = selectedMachineToTransfer.CustodianCode,
                CustodianName = selectedMachineToTransfer.CustodianName,
                Status = selectedMachineToTransfer.Status
            };

            var res = await Http.PutAsJsonAsync($"api/FixedAssets/{selectedMachineToTransfer.Id}", updateDto);
            if (res.IsSuccessStatusCode)
            {
                await LoadFixedAssets();
                feedbackMessage = $"✅ تم نقل عهدة الماكينة ({selectedMachineToTransfer.Name}) رسمياً إلى ({targetTransferDept}) بذمة ({selectedMachineToTransfer.CustodianName})!";
                isSuccessFeedback = true;
                isMachineTransferModalOpen = false;
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                feedbackMessage = $"❌ فشل ترحيل النقل: {err}";
                isSuccessFeedback = false;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"خطأ: {ex.Message}";
            isSuccessFeedback = false;
        }
    }

