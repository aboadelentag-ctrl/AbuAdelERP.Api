    private async Task SaveMovement()
    {
        errorMessage = ""; successMessage = "";

        if (newMovement.ItemId == 0) { errorMessage = "⚠️ يرجى اختيار الأصل / العهدة المستهدفة."; return; }
        if (string.IsNullOrEmpty(newMovement.FromPartyType) || string.IsNullOrEmpty(newMovement.ToPartyType)) { errorMessage = "⚠️ يرجى تحديد الجهة المُسَلِّمة والجهة المُستَلِمة."; return; }
        if (newMovement.FromPartyType == newMovement.ToPartyType && newMovement.FromPartyId == newMovement.ToPartyId) { errorMessage = "⚠️ لا يمكن أن تكون الجهة المُسَلِّمة هي نفسها المُستَلِمة."; return; }
        if (newMovement.Quantity <= 0) { errorMessage = "⚠️ يرجى إدخال كمية صالحة أكبر من الصفر."; return; }

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"{apiUrl}/move", newMovement);
            if (response.IsSuccessStatusCode)
            {
                successMessage = "✅ تم تسجيل الحركة وتحديث أرصدة العهد بنجاح!";
                newMovement = new AssetMovementDto { MovementDate = DateOnly.FromDateTime(DateTime.Now), MovementType = "ISSUE", Quantity = 1 };
                await LoadBalances();
            }
            else
            {
                errorMessage = "❌ " + await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ خطأ في الاتصال: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetPartyName(string type, long id)
    {
        var party = parties.FirstOrDefault(p => p.PartyType == type && p.PartyId == id);
        if (party != null) return $"{party.PartyName}";
        return "غير محدد";
    }

    private string TranslatePartyType(string type) => type switch
    {
        "CUSTOMER" => "عميل / مندوب",
        "DEPARTMENT" => "قسم إنتاج",
        "WAREHOUSE" => "مخزن",
        "SYSTEM" => "النظام / رصيد افتتاحي",
        _ => type
    };

