    private async Task SubmitDirectSOS()
    {
        if (assetForSOS == null) return;
        var taskNum = $"EMG-{DateTime.Now:yyyyMMdd}-{new Random().Next(100, 999)}";

        try
        {
            var taskDto = new
            {
                TaskNumber = taskNum,
                Title = directSOSTitle,
                Description = directSOSDescription,
                SenderDepartment = assetForSOS.Department,
                SenderEmployeeCode = State.EmployeeCode,
                SenderEmployeeName = State.FullName,
                TargetDepartment = "إدارة الصيانة والتشغيل المركزي",
                Priority = "CRITICAL",
                TargetResolutionMinutes = 30,
                Status = "PENDING",
                CreatedAt = DateTime.UtcNow,
                AssetCode = assetForSOS.AssetCode
            };

            await Http.PostAsJsonAsync("api/EmergencyTasks", taskDto);

            var updateAssetDto = new
            {
                Name = assetForSOS.Name,
                Department = assetForSOS.Department,
                Category = assetForSOS.Category ?? "أفران وتسوية",
                BrandModel = assetForSOS.BrandModel ?? "",
                SerialNumber = assetForSOS.SerialNumber ?? "",
                CustodianCode = assetForSOS.CustodianCode,
                CustodianName = assetForSOS.CustodianName,
                Status = "UNDER_MAINTENANCE"
            };

            await Http.PutAsJsonAsync($"api/FixedAssets/{assetForSOS.Id}", updateAssetDto);
            await LoadFixedAssets();

            feedbackMessage = $"🚨 تم بث بلاغ الطوارئ ({taskNum}) وتحويل الماكينة إلى حالة (تحت الصيانة والإصلاح) بنجاح!";
            isSuccessFeedback = true;
            isDirectSOSModalOpen = false;
