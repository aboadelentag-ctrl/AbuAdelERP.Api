@page "/asset-management"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json.Serialization
@using System.IO
@using AbuAdelERP.UI.Services
@using Blazored.LocalStorage
@inject HttpClient Http
@inject AppState State
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>إدارة الأصول والماكينات وتتبع الحاويات - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الشاشة التنفيذي -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-warning">🏭 حوكمة الأصول والماكينات ورقابة دورة استلام وتسليم الأسبات</h4>
                    <span class="badge bg-warning text-dark px-2 py-1 small fw-bold">نظام الفصل المؤسسي والرقابة الميدانية</span>
                </div>
                <small class="text-light text-opacity-75">
                    فصل كامل بين نقل عهدة الماكينات الرأسمالية (كمية = 1) ودورة تداول الأسبات والصواني المجمعة مع محاضر فض النزاعات.
                </small>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @if (activeTab == "fixed")
                {
                    <AuthorizePermission Permission="FixedAssets.Manage">
                        <button class="btn btn-warning text-dark btn-sm fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenNewFixedAssetModal">
                            <i class="bi bi-plus-circle-fill"></i> قيد أصل / ماكينة جديدة
                        </button>
                    </AuthorizePermission>

                    <AuthorizePermission Permission="FixedAssets.Manage">
                        <button class="btn btn-primary btn-sm fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenMachineTransferModal">
                            <i class="bi bi-arrow-left-right"></i> نقل عهدة ماكينة / أصل رأسمالي (1)
                        </button>
                    </AuthorizePermission>

                    <AuthorizePermission Permission="FixedAssets.View">
                        <button class="btn btn-outline-light btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="ExportAssetsToExcel">
                            <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> تصدير إكسيل
                        </button>
                    </AuthorizePermission>

                    <AuthorizePermission Permission="FixedAssets.Manage">
                        <label class="btn btn-outline-info btn-sm fw-bold px-3 py-2 shadow-sm mb-0 cursor-pointer">
                            <i class="bi bi-file-earmark-arrow-up-fill me-1"></i> استيراد أصول من إكسيل
                            <InputFile OnChange="ImportAssetsFromExcel" class="d-none" accept=".csv" />
                        </label>
                    </AuthorizePermission>
                }
                else if (activeTab == "circulating")
                {
                    <AuthorizePermission Permission="Crates.Dispatch">
                        <button class="btn btn-primary btn-sm fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenCrateDispatchModal">
                            <i class="bi bi-box-arrow-up-right"></i> إصدار إذن تسليم وصرف أسبات وأوعية (كميات)
                        </button>
                    </AuthorizePermission>

                    <AuthorizePermission Permission="Crates.Export">
                        <button class="btn btn-outline-light btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="ExportCrateMovementsToExcel">
                            <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> تصدير سجل الحركات
                        </button>
                    </AuthorizePermission>
                }
            </div>
        </div>
    </div>

    <!-- رسائل التنبيه والنجاح العامة -->
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccessFeedback ? "alert-success" : "alert-danger") border-0 shadow-sm alert-dismissible fade show py-2 mb-3 fw-bold" role="alert">
            @feedbackMessage
            <button type="button" class="btn-close py-2" @onclick='() => feedbackMessage = ""'></button>
        </div>
    }

    <!-- نظام التبويبات الرئيسي -->
    <ul class="nav nav-tabs fw-bold mb-3 border-bottom-2" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "fixed" ? "active text-dark border-warning border-bottom-0 fw-bold bg-white" : "text-muted")" @onclick='() => SwitchTab("fixed")'>
                🏭 سجل الأصول والماكينات الرأسمالية (@fixedAssetsList.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "circulating" ? "active text-primary border-primary border-bottom-0 fw-bold bg-white" : "text-muted")" @onclick='() => SwitchTab("circulating")'>
                🧺 رقابة دورة استلام وتسليم الأسبات والأوعية (@crateMovementsHistory.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "custody" ? "active text-success border-success border-bottom-0 fw-bold bg-white" : "text-muted")" @onclick='() => SwitchTab("custody")'>
                📑 بطاقة جرد وعهدة الأقسام والصالات
            </button>
        </li>
    </ul>

    <!-- ======================================================== -->
    <!-- التبويب 1: الأصول والماكينات الرأسمالية بالصالات -->
    <!-- ======================================================== -->
    @if (activeTab == "fixed")
    {
        <div class="row g-2 mb-3">
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-success text-center">
                    <small class="text-muted fw-bold">ماكينات تعمل بكفاءة تامة</small>
                    <h4 class="fw-bold text-success mt-1 mb-0 font-monospace">@fixedAssetsList.Count(a => a.Status == "OPERATIONAL") أصل</h4>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-warning text-center">
                    <small class="text-muted fw-bold">تحت الصيانة والإصلاح (SOS)</small>
                    <h4 class="fw-bold text-warning mt-1 mb-0 font-monospace">@fixedAssetsList.Count(a => a.Status == "UNDER_MAINTENANCE") أصل</h4>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-danger text-center">
                    <small class="text-muted fw-bold">متوقفة / عطل حرج في الصالة</small>
                    <h4 class="fw-bold text-danger mt-1 mb-0 font-monospace">@fixedAssetsList.Count(a => a.Status == "OUT_OF_SERVICE") أصل</h4>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm p-3 bg-white border-top border-4 border-dark text-center">
                    <small class="text-muted fw-bold">إجمالي الأصول والماكينات</small>
                    <h4 class="fw-bold text-dark mt-1 mb-0 font-monospace">@fixedAssetsList.Count أصل</h4>
                </div>
            </div>
        </div>

        <!-- فلاتر البحث -->
        <div class="card shadow-sm border-0 mb-3 bg-light">
            <div class="card-body p-2">
                <div class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="بحث بكود الأصل، الماكينة، الموديل، السريال..." @bind="fixedAssetSearch" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm fw-bold" @bind="fixedDeptFilter">
                            <option value="">-- كل الإدارات والأقسام المعتمدة --</option>
                            @foreach (var dept in dbDepartments)
                            {
                                <option value="@dept.DisplayName">@dept.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" @bind="fixedCategoryFilter">
                            <option value="">-- كل التصنيفات --</option>
                            <option value="أفران وتسوية">أفران وخطوط تسوية</option>
                            <option value="عجانات ومضارب">عجانات ومضارب خفق</option>
                            <option value="ثلاجات وتبريد">ثلاجات وتبريد وتجميد</option>
                            <option value="تغليف وتعبئة">تعبئة وتغليف وسيلر</option>
                            <option value="سيارات توزيع">سيارات ولوجستيات</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" @bind="fixedStatusFilter">
                            <option value="">-- كل الحالات الفنية --</option>
                            <option value="OPERATIONAL">تعمل بكفاءة</option>
                            <option value="UNDER_MAINTENANCE">تحت الصيانة (SOS)</option>
                            <option value="OUT_OF_SERVICE">معطلة تماماً</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-outline-secondary btn-sm w-100 fw-bold" @onclick="ResetFixedFilters">إلغاء</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- جدول الماكينات الرأسمالية -->
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark m-0">📋 سجل الأصول والماكينات الرأسمالية (المعروض: @FilteredFixedAssets.Count())</h6>
                <small class="text-muted">محدث تلقائياً مع قاعدة بيانات PostgreSQL</small>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>كود الأصل (Tag)</th>
                            <th>اسم الأصل / الماكينة</th>
                            <th>القسم / الصالة الفعلية</th>
                            <th>الماركة والموديل</th>
                            <th>الرقم التسلسلي (S/N)</th>
                            <th>مسؤول العهدة (HR)</th>
                            <th>الحالة الفنية</th>
                            <th style="min-width: 240px;">الإجراءات والربط الميداني</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredFixedAssets.Any())
                        {
                            <tr><td colspan="8" class="text-muted py-4 fw-bold">لا توجد أصول مسجلة تطابق شروط البحث.</td></tr>
                        }
                        else
                        {
                            @foreach (var asset in FilteredFixedAssets)
                            {
                                var hasActiveSOS = !string.IsNullOrEmpty(asset.ActiveSOSTaskNumber);
                                <tr>
                                    <td class="font-monospace fw-bold text-primary">@asset.AssetCode</td>
                                    <td class="fw-bold text-start ps-3 text-dark">
                                        @asset.Name
                                        @if (!string.IsNullOrEmpty(asset.Category))
                                        {
                                            <span class="badge bg-light text-secondary border ms-1">@asset.Category</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-primary">@asset.Department</span></td>
                                    <td>@(!string.IsNullOrEmpty(asset.BrandModel) ? asset.BrandModel : "---")</td>
                                    <td class="font-monospace text-muted">@(!string.IsNullOrEmpty(asset.SerialNumber) ? asset.SerialNumber : "---")</td>
                                    <td>
                                        <div class="fw-bold text-dark">@asset.CustodianName</div>
                                        <small class="text-muted font-monospace">[@asset.CustodianCode]</small>
                                    </td>
                                    <td>
                                        <span class="badge @GetAssetStatusBadge(asset.Status) px-2 py-1 d-block mb-1">
                                            @TranslateAssetStatus(asset.Status)
                                        </span>
                                        @if (hasActiveSOS)
                                        {
                                            <span class="badge bg-danger font-monospace" style="font-size: 10px;">
                                                🚨 @asset.ActiveSOSTaskNumber
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center align-items-center gap-1">
                                            <button class="btn btn-sm btn-outline-success fw-bold py-1 px-2 shadow-sm" title="نقل عهدة هذه الماكينة لصالة أخرى" @onclick="() => OpenTransferForSpecificMachine(asset)">
                                                🔄 نقل
                                            </button>

                                            <AuthorizePermission Permission="Emergency.Create">
                                                <button class="btn btn-sm btn-danger fw-bold py-1 px-2 shadow-sm" title="إطلاق بلاغ طارئ واستدعاء صيانة" @onclick="() => OpenDirectSOSModal(asset)">
                                                    🚨 عطل
                                                </button>
                                            </AuthorizePermission>

                                            <AuthorizePermission Permission="FixedAssets.History, FixedAssets.View">
                                                <button class="btn btn-sm btn-outline-dark fw-bold py-1 px-2" title="استعراض الأرشيف الكامل" @onclick="() => OpenAssetHistoryModal(asset)">
                                                    📜 السجل
                                                </button>
                                            </AuthorizePermission>

                                            <AuthorizePermission Permission="FixedAssets.Manage">
                                                <button class="btn btn-sm btn-outline-primary fw-bold py-1 px-2" @onclick="() => EditFixedAsset(asset)">
                                                    تعديل
                                                </button>
                                            </AuthorizePermission>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- التبويب 2: دورة استلام وتسليم الأسبات والأوعية المتداولة -->
    <!-- ======================================================== -->
    @if (activeTab == "circulating")
    {
        <div class="card shadow-sm border-0 rounded-3 mb-3">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark m-0">🧺 موقف الأرصدة اللحظية للحاويات والأسبات بالمصنع (من مركز الأصناف)</h6>
                <span class="badge bg-secondary font-monospace">أوعية تداول كمية</span>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered mb-0 text-center align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>نوع الوعاء / الحاوية</th>
                            <th>كود الصنف والمواصفة</th>
                            <th>الرصيد الكلي بالمصنع</th>
                            <th>بصالات الإنتاج</th>
                            <th>بمستودع التعبئة</th>
                            <th>عهدة خارجية بالفروع/السيارات</th>
                            <th>معلق بمحاضر نزاع ⚠️</th>
                            <th>الهالك والكسر</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!circulatingAssetsList.Any())
                        {
                            <tr><td colspan="8" class="text-muted py-3">جاري مزامنة أرصدة الحاويات من مركز الأصناف...</td></tr>
                        }
                        else
                        {
                            @foreach (var c in circulatingAssetsList)
                            {
                                <tr>
                                    <td class="fw-bold text-start ps-3 text-primary fs-6">@c.ContainerName</td>
                                    <td class="text-muted font-monospace">@c.Specification</td>
                                    <td class="font-monospace fw-bold fs-6">@c.TotalFactoryQuantity</td>
                                    <td class="font-monospace text-success fw-bold">@c.InProductionFloorQuantity</td>
                                    <td class="font-monospace text-info fw-bold">@c.InPackagingWarehouseQuantity</td>
                                    <td class="font-monospace text-warning fw-bold">@c.WithDriversAndBranchesQuantity</td>
                                    <td class="font-monospace text-danger fw-bold">@c.DisputedQuantity</td>
                                    <td class="font-monospace text-secondary fw-bold">@c.DamagedQuantity</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h6 class="fw-bold text-dark m-0">📋 سجل دورات الاستلام والتسليم وتأكيد الأطراف (Chain of Custody)</h6>
                    <small class="text-muted">توثيق تسليم واستلام الأوعية والأسبات ومحاضر النزاع والعجز الميداني</small>
                </div>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" @bind="movementStatusFilter" style="width: 200px;">
                        <option value="">-- كل الحالات --</option>
                        <option value="PENDING_RECEIPT">بانتظار تأكيد المستلم ⏳</option>
                        <option value="COMPLETED">مكتمل ومؤكد من الطرفين ✓</option>
                        <option value="DISPUTED">معلق بنزاع وعجز ⚠️</option>
                        <option value="RESOLVED">تم فض النزاع والتسوية ⚖️</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم الإذن</th>
                            <th>التاريخ</th>
                            <th>نوع الحركة والوعاء</th>
                            <th>الكمية المنصرفة</th>
                            <th>الطرف المُسلِّم (المصدر)</th>
                            <th>الطرف المُستلِم (الوجهة)</th>
                            <th>الكمية المستلمة فعلياً</th>
                            <th>حالة الاستلام</th>
                            <th style="min-width: 220px;">الإجراء الرقابي المصرح به</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredMovements.Any())
                        {
                            <tr><td colspan="9" class="text-muted py-4 fw-bold">لا توجد حركات تداول مسجلة تطابق شروط العرض.</td></tr>
                        }
                        else
                        {
                            @foreach (var move in FilteredMovements)
                            {
                                var isSender = !string.IsNullOrEmpty(move.DispatchedByCode) && move.DispatchedByCode.Equals(State.EmployeeCode, StringComparison.OrdinalIgnoreCase);

                                <tr>
                                    <td class="font-monospace fw-bold text-primary">@move.MovementNumber</td>
                                    <td class="font-monospace">@move.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <span class="badge @GetMovementBadge(move.MovementType) d-block mb-1">
                                            @TranslateMovementType(move.MovementType)
                                        </span>
                                        <small class="fw-bold text-dark">@move.ContainerName</small>
                                    </td>
                                    <td class="font-monospace fw-bold fs-6 text-primary">@move.DispatchedQuantity</td>
                                    <td class="text-start ps-2">
                                        <div class="fw-bold">@move.SourceLocation</div>
                                        <small class="text-muted font-monospace">[@move.DispatchedByCode] @move.DispatchedByName</small>
                                    </td>
                                    <td class="text-start ps-2">
                                        <div class="fw-bold text-primary">@move.DestinationLocation</div>
                                        @if (!string.IsNullOrEmpty(move.ReceivedByName))
                                        {
                                            <small class="text-success font-monospace">[@move.ReceivedByCode] @move.ReceivedByName</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted fst-italic">بانتظار توقيع المستلم</small>
                                        }
                                    </td>
                                    <td>
                                        @if (move.ReceivedQuantity.HasValue)
                                        {
                                            <span class="font-monospace fw-bold @(move.ReceivedQuantity.Value == move.DispatchedQuantity ? "text-success" : "text-danger") fs-6">
                                                @move.ReceivedQuantity.Value
                                            </span>
                                            @if (move.ShortageQuantity > 0)
                                            {
                                                <small class="text-danger d-block fw-bold font-monospace">(عجز: @move.ShortageQuantity)</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted font-monospace">---</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @GetHandoverStatusBadge(move.Status) px-2 py-1">
                                            @TranslateHandoverStatus(move.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center align-items-center gap-1 flex-wrap">
                                            @if (move.Status == "PENDING_RECEIPT")
                                            {
                                                if (!isSender)
                                                {
                                                    <AuthorizePermission Permission="Crates.Receive">
                                                        <button class="btn btn-sm btn-success fw-bold py-1 px-2 shadow-sm" @onclick="() => OpenReceiveHandshakeModal(move)">
                                                            📥 فحص وتأكيد الاستلام
                                                        </button>
                                                    </AuthorizePermission>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border py-1 px-2 small">
                                                        ⏳ بانتظار توقيع المستلم
                                                    </span>
                                                }
                                            }

                                            @if (move.Status == "DISPUTED")
                                            {
                                                <AuthorizePermission Permission="Crates.SettleDispute">
                                                    <button class="btn btn-sm btn-danger fw-bold py-1 px-2 shadow-sm" @onclick="() => OpenSettleDisputeModal(move)">
                                                        ⚖️ فض وتسوية النزاع
                                                    </button>
                                                </AuthorizePermission>
                                            }

                                            <AuthorizePermission Permission="Crates.View">
                                                <button class="btn btn-sm btn-outline-dark py-1 px-2" @onclick="() => OpenMovementDetailsModal(move)">
                                                    🔍 المحضر
                                                </button>
                                            </AuthorizePermission>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- التبويب 3: بطاقة جرد وعهدة الأقسام والصالات المعتمدة -->
    <!-- ======================================================== -->
    @if (activeTab == "custody")
    {
        <div class="card shadow-sm border-0 rounded-3 mb-3 bg-light">
            <div class="card-body p-3">
                <div class="row align-items-center g-2">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-dark mb-1">اختر الصالة أو القسم الفعلي من الهيكل المعتمد:</label>
                        <select class="form-select fw-bold border-success" @bind="selectedCustodyDept">
                            @foreach (var d in dbDepartments)
                            {
                                <option value="@d.DisplayName">@d.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-7 text-md-end pt-3">
                        <button class="btn btn-outline-dark btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="PrintCustodyCard">
                            <i class="bi bi-printer-fill me-1"></i> طباعة محضر جرد وعهدة القسم (رسمي)
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-7">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-dark m-0">🏭 الماكينات والمعدات الرأسمالية في عهدة (@selectedCustodyDept)</h6>
                        <span class="badge bg-dark font-monospace">@DepartmentFixedAssets.Count() ماكينة</span>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-bordered mb-0 text-center align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th>كود الأصل</th>
                                    <th>اسم الماكينة</th>
                                    <th>الماركة والموديل</th>
                                    <th>الرقم التسلسلي</th>
                                    <th>الحالة الفنية</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!DepartmentFixedAssets.Any())
                                {
                                    <tr><td colspan="5" class="text-muted py-3">لا توجد ماكينات مسجلة بعهدة هذا القسم.</td></tr>
                                }
                                else
                                {
                                    @foreach (var a in DepartmentFixedAssets)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold text-primary">@a.AssetCode</td>
                                            <td class="fw-bold text-start ps-2">@a.Name</td>
                                            <td>@a.BrandModel</td>
                                            <td class="font-monospace text-muted">@a.SerialNumber</td>
                                            <td><span class="badge @GetAssetStatusBadge(a.Status)">@TranslateAssetStatus(a.Status)</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-primary m-0">🧺 الأسبات والصواني المتداولة المسجلة بالمصنع</h6>
                        <span class="badge bg-primary">الرصيد الكلي</span>
                    </div>
                    <div class="card-body p-3">
                        <ul class="list-group list-group-flush small">
                            @foreach (var cont in circulatingAssetsList)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                    <span>@cont.ContainerName</span>
                                    <strong class="badge bg-dark fs-6 font-monospace">@cont.TotalFactoryQuantity وعاء</strong>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

<!-- ======================================================== -->
<!-- نافذة (أ): نقل عهدة وتغيير صالة ماكينة رأسمالية (مغلقة ومحكومة) -->
<!-- ======================================================== -->
@if (isMachineTransferModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">🔄 نقل عهدة وتغيير صالة ماكينة / أصل رأسمالي (دائرة مغلقة)</h6>
                    <button type="button" class="btn-close" @onclick="() => isMachineTransferModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">

                    <!-- اختيار الماكينة -->
                    <div class="card p-3 mb-3 border-0 shadow-sm bg-white">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-9">
                                <label class="form-label small fw-bold text-dark mb-1">اختر الماكينة الرأسمالية المطلوب نقل عهدتها *</label>
                                <select class="form-select fw-bold border-warning" value="@selectedMachineTransferCode" @onchange="OnMachineTransferSelectionChanged">
                                    <option value="">-- اضغط لاختيار الماكينة من واقع الصالات --</option>
                                    @foreach (var m in fixedAssetsList)
                                    {
                                        <option value="@m.AssetCode">[@m.AssetCode] - @m.Name (@m.Department)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-dark mb-1">الكمية المنقولة</label>
                                <input type="text" class="form-control font-monospace fw-bold text-center bg-light text-danger" value="1 فقط (مسريل)" readonly disabled />
                            </div>
                        </div>
                    </div>

                    @if (selectedMachineToTransfer != null)
                    {
                        <!-- 🔒 المصدر الحالي (مغلق ومحكوم آلياً من واقع الماكينة) -->
                        <div class="card p-3 mb-3 border-0 shadow-sm bg-white border-start border-4 border-danger">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-dark small m-0">
                                    <i class="bi bi-lock-fill text-danger me-1"></i> 1. المصدر والعهدة الحالية (مغلقة ومسحوبة آلياً من ملف الأصل):
                                </h6>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 small fw-bold">
                                    🔒 غير قابلة للتلاعب
                                </span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="small text-muted fw-bold">الصالة الحالية المقيدة بها الماكينة:</label>
                                    <input type="text" class="form-control fw-bold bg-light" value="@selectedMachineToTransfer.Department" readonly disabled />
                                </div>
                                <div class="col-md-6">
                                    <label class="small text-muted fw-bold">المشرف المسؤول حالياً عن العهدة:</label>
                                    <input type="text" class="form-control fw-bold bg-light font-monospace" value="@($"[{selectedMachineToTransfer.CustodianCode}] {selectedMachineToTransfer.CustodianName}")" readonly disabled />
                                </div>
                            </div>
                        </div>

                        <!-- 🔓 الوجهة الجديدة والمشرف المستلم (اختيار حر) -->
                        <div class="card p-3 mb-3 border-0 shadow-sm bg-white border-start border-4 border-success">
                            <h6 class="fw-bold text-success small mb-2">
                                <i class="bi bi-geo-alt-fill text-success me-1"></i> 2. الوجهة الجديدة والمشرف المستلم للعهدة:
                            </h6>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="small fw-bold text-dark mb-1">الصالة / القسم المستلم الجديد *</label>
                                    <select class="form-select fw-bold border-success" @bind="targetTransferDept">
                                        @foreach (var d in dbDepartments)
                                        {
                                            <option value="@d.DisplayName">@d.DisplayName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="small fw-bold text-dark mb-1">المشرف / الفني المستلم للعهدة (من HR) *</label>
                                    <select class="form-select fw-bold border-success font-monospace" @bind="targetTransferEmpCode">
                                        <option value="">-- اضغط لاختيار المستلم الجديد للماكينة --</option>
                                        @foreach (var emp in employeesCatalog)
                                        {
                                            <option value="@emp.DisplayCode">[@emp.DisplayCode] - @emp.DisplayName (@emp.DisplayDepartment)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="small fw-bold text-dark mb-1">أسباب وملاحظات نقل الماكينة (لتوثيق سجل الأصل)</label>
                            <textarea class="form-control" rows="2" @bind="machineTransferReason" placeholder="مثال: نقل الماكينة لصالة الجاتوه لتوسيع خط الإنتاج، صيانة دورية..."></textarea>
                        </div>
                    }

                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isMachineTransferModalOpen = false">إلغاء</button>
                    <button class="btn btn-warning text-dark btn-sm px-4 fw-bold shadow-sm" disabled="@(selectedMachineToTransfer == null)" @onclick="SubmitMachineTransfer">
                        🔄 ترحيل وتثبيت نقل عهدة الماكينة
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ======================================================== -->
<!-- نافذة (ب): إصدار إذن تسليم وصرف أسبات وأوعية تداول (كميات) -->
<!-- ======================================================== -->
@if (isDispatchModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">🧺 إصدار إذن تسليم وصرف أسبات وأوعية تداول (طرف أول مُسلِّم)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isDispatchModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">

                    <!-- نوع الحركة والحاوية والكمية المجمعة -->
                    <div class="card p-3 mb-3 border-0 shadow-sm bg-white">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-dark mb-1">نوع حركة الصرف *</label>
                                <select class="form-select fw-bold border-primary" @bind="newDispatch.MovementType">
                                    <option value="DISPATCH_BRANCH">صرف أسبات محملة بالبضاعة لفرع / سيارة توزيع 🚚</option>
                                    <option value="FLOOR_TRANSFER">تحويل صواني / أسبات بين صالات المصنع الداخلية 🔄</option>
                                    <option value="RETURN_FACTORY">إذن إرجاع أسبات فارغة من الفرع أو السيارة للمصنع 📥</option>
                                </select>
                            </div>
                            
                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-primary mb-1">نوع وعاء التداول (من مركز الأصناف) *</label>
                                <select class="form-select fw-bold border-primary" @bind="newDispatch.ContainerName">
                                    <option value="">-- اضغط لاختيار نوع السبت أو الصينية --</option>
                                    @foreach (var c in AvailableContainerItems)
                                    {
                                        <option value="@c.DisplayName">[@c.DisplayCode] - @c.DisplayName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label small fw-bold text-dark mb-1">الكمية المنصرفة *</label>
                                <input type="number" class="form-control font-monospace fw-bold fs-6 text-primary text-center" @bind="newDispatch.DispatchedQuantity" min="1" />
                            </div>
                        </div>
                    </div>

                    <!-- الجهة المسلِّمة (المصدر) -->
                    <div class="card p-3 mb-3 border-0 shadow-sm bg-white border-start border-4 border-info">
                        <h6 class="fw-bold text-dark small mb-2">1. الجهة المسلِّمة (طرف أول مُسلِّم - المستودع/المصنع):</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted mb-1">القسم / المستودع المُسلِّم *</label>
                                <select class="form-select fw-bold border-info" @bind="crateSourceDept">
                                    @foreach (var d in dbDepartments)
                                    {
                                        <option value="@d.DisplayName">@d.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted mb-1">الموظف / أمين المستودع المُسلِّم (HR) *</label>
                                <select class="form-select fw-bold border-info font-monospace" @bind="crateSourceEmpCode">
                                    @foreach (var emp in employeesCatalog)
                                    {
                                        <option value="@emp.DisplayCode">[@emp.DisplayCode] - @emp.DisplayName (@emp.DisplayDepartment)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- الجهة المستلِمة (الوجهة / السائق) -->
                    <div class="card p-3 mb-3 border-0 shadow-sm bg-white border-start border-4 border-primary">
                        <h6 class="fw-bold text-primary small mb-2">2. الجهة المستلِمة (طرف ثانٍ مُستلِم - الفرع / السائق):</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted mb-1">الفرع / الصالة / سيارة التوزيع المستلمة *</label>
                                <input type="text" class="form-control fw-bold border-primary" list="crateDestList" @bind="crateDestLocation" placeholder="اختر من القائمة أو اكتب الوجهة..." />
                                <datalist id="crateDestList">
                                    @foreach (var d in dbDepartments)
                                    {
                                        <option value="@d.DisplayName">@d.DisplayName</option>
                                    }
                                    <option value="فرع الهرم (توزيع)">فرع الهرم (توزيع)</option>
                                    <option value="فرع التجمع الخامس">فرع التجمع الخامس</option>
                                    <option value="فرع المعادي">فرع المعادي</option>
                                    <option value="فرع مدينة نصر">فرع مدينة نصر</option>
                                    <option value="سيارة توزيع رقم 1 (سائق)">سيارة توزيع رقم 1 (سائق)</option>
                                    <option value="سيارة توزيع رقم 2 (سائق)">سيارة توزيع رقم 2 (سائق)</option>
                                    <option value="سيارة توزيع رقم 3 (سائق)">سيارة توزيع رقم 3 (سائق)</option>
                                    <option value="سيارة توزيع رقم 4 (سائق)">سيارة توزيع رقم 4 (سائق)</option>
                                </datalist>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted mb-1">المستلم / السائق الميداني (من HR) *</label>
                                <select class="form-select fw-bold border-primary font-monospace" @bind="crateDestEmpCode">
                                    <option value="">-- اضغط لاختيار الموظف أو السائق المستلم --</option>
                                    @foreach (var emp in employeesCatalog)
                                    {
                                        <option value="@emp.DisplayCode">[@emp.DisplayCode] - @emp.DisplayName (@emp.DisplayDepartment)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-1">
                        <label class="form-label small fw-bold text-dark mb-1">ملاحظات ورقم إذن الخروج</label>
                        <textarea class="form-control" rows="2" @bind="newDispatch.Notes" placeholder="اكتب رقم فاتورة البضاعة، رقم لوحة السيارة، أو أي تفاصيل إضافية..."></textarea>
                    </div>

                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isDispatchModalOpen = false">إلغاء</button>
                    <button class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="SubmitCrateDispatch">
                        🚀 اعتماد وخروج الإذن (بانتظار تأكيد المستلم)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- نافذة قيد أصل جديد -->
@if (isFixedAssetModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">@(editingFixedAsset.Id == 0 ? "🏭 قيد أصل / ماكينة جديدة بالصالة" : $"🛠 تعديل أصل: {editingFixedAsset.Name}")</h6>
                    <button type="button" class="btn-close" @onclick="() => isFixedAssetModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    
                    @if (!string.IsNullOrEmpty(modalErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small fw-bold mb-3">@modalErrorMessage</div>
                    }

                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">كود الأصل (Asset Tag) *</label>
                            <input type="text" class="form-control font-monospace fw-bold text-primary" @bind="editingFixedAsset.AssetCode" placeholder="مثال: AST-OVN-01" />
                        </div>

                        <div class="col-md-8">
                            <label class="small fw-bold text-dark mb-1">📦 اسم الماكينة (اختر من مركز الأصناف أو اكتب مباشرة) *</label>
                            <input type="text" class="form-control fw-bold" list="itemMasterList" @bind="editingFixedAsset.Name" placeholder="ابحث أو اكتب: فرن دوار، عجانة..." />
                            <datalist id="itemMasterList">
                                @foreach (var item in itemMasterCatalog)
                                {
                                    <option value="@item.DisplayName">[@item.DisplayCode] - @item.DisplayName</option>
                                }
                            </datalist>
                        </div>

                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">القسم / الصالة المخصصة *</label>
                            <select class="form-select fw-bold border-primary" @bind="editingFixedAsset.Department">
                                @foreach (var d in dbDepartments)
                                {
                                    <option value="@d.DisplayName">@d.DisplayName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">👤 مسؤول العهدة الميداني (من HR) *</label>
                            <select class="form-select fw-bold border-info font-monospace" @onchange="OnCustodianSelected">
                                <option value="">-- اضغط لاختيار الموظف المسؤول --</option>
                                @foreach (var emp in employeesCatalog)
                                {
                                    var isSelected = emp.DisplayCode == editingFixedAsset.CustodianCode;
                                    <option value="@emp.DisplayCode" selected="@isSelected">
                                        [@emp.DisplayCode] - @emp.DisplayName (@emp.DisplayDepartment)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">تصنيف الماكينة</label>
                            <select class="form-select" @bind="editingFixedAsset.Category">
                                <option value="أفران وتسوية">أفران وخطوط تسوية</option>
                                <option value="عجانات ومضارب">عجانات ومضارب خفق</option>
                                <option value="ثلاجات وتبريد">ثلاجات وغرف تبريد</option>
                                <option value="تغليف وتعبئة">تغليف وسيلر</option>
                                <option value="سيارات توزيع">سيارات ولوجستيات</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">الماركة والموديل</label>
                            <input type="text" class="form-control" @bind="editingFixedAsset.BrandModel" placeholder="مثال: Polin Italy" />
                        </div>

                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">الرقم التسلسلي (S/N)</label>
                            <input type="text" class="form-control font-monospace" @bind="editingFixedAsset.SerialNumber" placeholder="S/N من لوحة الماكينة" />
                        </div>

                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">الحالة التشغيلية</label>
                            <select class="form-select fw-bold" @bind="editingFixedAsset.Status">
                                <option value="OPERATIONAL">تعمل بكفاءة تامة ✓</option>
                                <option value="UNDER_MAINTENANCE">تحت الصيانة والإصلاح (SOS) ⚙️</option>
                                <option value="OUT_OF_SERVICE">معطلة تماماً ⛔</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isFixedAssetModalOpen = false">إلغاء</button>
                    <button class="btn btn-warning text-dark btn-sm px-4 fw-bold shadow-sm" disabled="@isSavingAsset" @onclick="SaveFixedAsset">
                        💾 حفظ وتثبيت الأصل
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- نافذة فحص وتأكيد الاستلام الميداني للأوعية والأسبات -->
@if (isReceiveModalOpen && selectedMovementForReceive != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" dir="rtl">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">📥 فحص وتأكيد استلام الأوعية/الأسبات (@selectedMovementForReceive.MovementNumber)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isReceiveModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    <div class="card p-3 mb-3 border-0 shadow-sm bg-white border-start border-4 border-success">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted">نوع الوعاء:</span>
                            <strong class="text-dark">@selectedMovementForReceive.ContainerName</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted">الكمية المسلمة من المصدر:</span>
                            <strong class="text-primary font-monospace fs-6">@selectedMovementForReceive.DispatchedQuantity وعاء</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-muted">المُسلِّم:</span>
                            <small class="font-monospace">[@selectedMovementForReceive.DispatchedByCode] @selectedMovementForReceive.DispatchedByName</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">الكمية المستلمة السليمة فعلياً *</label>
                        <input type="number" class="form-control font-monospace fw-bold fs-5 text-success text-center" @bind="actualReceivedQtyInput" min="0" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-danger">الكمية التالفة / المكسورة (إن وجدت)</label>
                        <input type="number" class="form-control font-monospace fw-bold fs-6 text-danger text-center" @bind="damagedQtyInput" min="0" />
                    </div>

                    @if (actualReceivedQtyInput < selectedMovementForReceive.DispatchedQuantity || damagedQtyInput > 0)
                    {
                        var shortage = selectedMovementForReceive.DispatchedQuantity - actualReceivedQtyInput;
                        <div class="alert alert-danger py-2 small mb-3">
                            ⚠️ <strong>تنبيه رقابي:</strong> يوجد عجز قدره (<strong>@shortage</strong>) وتلف قدره (<strong>@damagedQtyInput</strong>). سيتم فتح محضر نزاع رسمي.
                        </div>
                    }

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-dark">تقرير وملاحظات المستلم</label>
                        <textarea class="form-control" rows="2" @bind="receiveNotesInput"></textarea>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isReceiveModalOpen = false">إلغاء</button>
                    <button class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="ConfirmReceiveHandshake">✓ تأكيد الاستلام الميداني</button>
                </div>
            </div>
        </div>
    </div>
}

