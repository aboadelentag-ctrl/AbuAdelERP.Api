    private async Task TriggerBrowserDownload(string fileName, string content)
    {
        var utf8WithBom = "\uFEFF" + content;
        var jsCommand = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", jsCommand);
    }

    private string EscapeCsv(string val)
    {
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n"))
        {
            return $"\"{val.Replace("\"", "\"\"")}\"";
        }
        return val;
    }

    private void OpenImportModal()
    {
        importedPreviewList.Clear();
        errorMessage = null;
        isImportModalOpen = true;
    }

    private void CloseImportModal()
    {
        isImportModalOpen = false;
        importedPreviewList.Clear();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        errorMessage = null;

        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1)
            {
                errorMessage = "الملف فارغ أو لا يحتوي على صفوف بيانات.";
                return;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = ParseCsvLine(line);
                if (cols.Count >= 2)
                {
                    decimal.TryParse(cols.Count > 3 ? cols[3].Trim() : "0", out var credit);

                    var approvalStr = cols.Count > 4 ? cols[4].Trim() : "";
                    bool isApp = approvalStr.Contains("معتمد") && !approvalStr.Contains("غير");

                    var activeStr = cols.Count > 6 ? cols[6].Trim() : "1";
                    bool isActive = activeStr == "1" || activeStr.Equals("نشط", StringComparison.OrdinalIgnoreCase) || activeStr.Equals("true", StringComparison.OrdinalIgnoreCase);

                    importedPreviewList.Add(new SupplierImportRowDto
                    {
                        SupplierCode = cols[0].Trim(),
                        SupplierName = cols[1].Trim(),
                        Phone = cols.Count > 2 ? cols[2].Trim() : "",
                        CreditLimit = credit,
                        IsApproved = isApp,
                        QualityNotes = cols.Count > 5 ? cols[5].Trim() : "",
                        Active = isActive
                    });
                }
            }

            if (!importedPreviewList.Any())
            {
                errorMessage = "تعذر استخراج بيانات الموردين من الملف.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل قراءة الملف: {ex.Message}";
        }
    }

    private List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var curVal = new StringBuilder();

        foreach (char c in line)
        {
            if (c == '\"') inQuotes = !inQuotes;
            else if (c == ',' && !inQuotes)
            {
                result.Add(curVal.ToString());
                curVal.Clear();
            }
            else curVal.Append(c);
        }
        result.Add(curVal.ToString());
        return result;
    }

    private async Task ProcessAndSaveImportAsync()
    {
        if (!importedPreviewList.Any()) return;

        isSavingImport = true;
        errorMessage = null;

        try
        {
            int updatedCount = 0;
            int createdCount = 0;

            foreach (var row in importedPreviewList)
            {
                var existing = suppliers.FirstOrDefault(s =>
                    s.SupplierCode.Equals(row.SupplierCode, StringComparison.OrdinalIgnoreCase) ||
                    s.SupplierName.Equals(row.SupplierName, StringComparison.OrdinalIgnoreCase));

                var payload = new
                {
                    Id = existing?.Id ?? 0,
                    CompanyId = 1,
                    SupplierCode = row.SupplierCode,
                    Code = row.SupplierCode,
                    SupplierName = row.SupplierName,
                    Name = row.SupplierName,
                    Phone = row.Phone,
                    CreditLimit = row.CreditLimit,
                    Active = row.Active,
                    IsApproved = row.IsApproved,
                    QualityStatus = row.IsApproved ? "مورد معتمد" : "تحت التقييم (غير معتمد)",
                    QualityNotes = row.QualityNotes,
                    Notes = row.QualityNotes
                };

                HttpResponseMessage res;
                if (existing != null)
                {
                    res = await Http.PutAsJsonAsync($"api/suppliers/{existing.Id}", payload);
                    if (res.IsSuccessStatusCode) updatedCount++;
                }
                else
                {
                    res = await Http.PostAsJsonAsync("api/suppliers", payload);
                    if (res.IsSuccessStatusCode) createdCount++;
                }
            }

            successMessage = $"اكتملت المعالجة: تم تحديث ({updatedCount}) وإضافة ({createdCount}) مورد جديد بنجاح.";
            CloseImportModal();
            await LoadSuppliersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء حفظ الموردين: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }
