    private void ResetForm()
    {
        currentSupplier = new SupplierDto();
        errorMessage = null;
    }

    private async Task SaveSupplierAsync()
    {
        if (string.IsNullOrWhiteSpace(currentSupplier.SupplierName) || string.IsNullOrWhiteSpace(currentSupplier.SupplierCode))
        {
            errorMessage = "يرجى كتابة كود المورد واسم الشركة بشكل صحيح.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var payload = new
            {
                Id = currentSupplier.Id,
                CompanyId = currentSupplier.CompanyId > 0 ? currentSupplier.CompanyId : 1,
                SupplierCode = currentSupplier.SupplierCode.Trim(),
                Code = currentSupplier.SupplierCode.Trim(),
                SupplierName = currentSupplier.SupplierName.Trim(),
                Name = currentSupplier.SupplierName.Trim(),
                Phone = currentSupplier.Phone?.Trim(),
                CreditLimit = currentSupplier.CreditLimit,
                Active = currentSupplier.Active,
                IsApproved = currentSupplier.IsApprovedStatus,
                QualityStatus = currentSupplier.QualityStatus,
                QualityNotes = currentSupplier.QualityNotes,
                Notes = currentSupplier.QualityNotes
            };

            HttpResponseMessage res;
            if (currentSupplier.Id > 0)
            {
                res = await Http.PutAsJsonAsync($"api/suppliers/{currentSupplier.Id}", payload);
            }
            else
            {
                res = await Http.PostAsJsonAsync("api/suppliers", payload);
            }

            if (res.IsSuccessStatusCode)
            {
                successMessage = currentSupplier.Id > 0 ? "تم تحديث بيانات المورد بنجاح." : "تم تسجيل المورد الجديد بنجاح.";
                ResetForm();
                await LoadSuppliersAsync();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                errorMessage = $"فشل الحفظ: {err}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في الاتصال: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleApprovalStatus(SupplierDto sup)
