    // دالة الحذف المحصنة بدقة
    private async Task DeleteSupplierAsync(SupplierDto sup)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"هل أنت متأكد من حذف المورد ({sup.SupplierName}) نهائياً من قاعدة البيانات؟");
        if (!confirm) return;

        try
        {
            var res = await Http.DeleteAsync($"api/suppliers/{sup.Id}");
            if (res.IsSuccessStatusCode)
            {
                suppliers.RemoveAll(s => s.Id == sup.Id);
                successMessage = $"تم حذف المورد ({sup.SupplierName}) بنجاح.";
                errorMessage = null;
                StateHasChanged();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(err))
                {
                    err = $"كود الخطأ ({res.StatusCode}) - يرجى التأكد من إضافة مسار الحذف في كود السيرفر SuppliersController.cs";
                }
                errorMessage = $"تعذر الحذف: {err}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ أثناء محاولة الحذف: {ex.Message}";
        }
    }

    private async Task ExportToExcelAsync()
    {
        var listToExport = FilteredSuppliers.ToList();
        if (!listToExport.Any())
        {
            errorMessage = "لا يوجد موردين مطابقين لتصديرهم.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("كود_المورد,اسم_المورد,الهاتف,حد_الائتمان,حالة_التعامل,اعتماد_الجودة,الملاحظات");

            foreach (var s in listToExport)
            {
                var activeStr = s.Active ? "نشط" : "موقوف";
                var approvalStr = s.IsApprovedStatus ? "مورد معتمد" : "غير معتمد";
                var notes = (s.QualityNotes ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");
                sb.AppendLine($"{EscapeCsv(s.SupplierCode)},{EscapeCsv(s.SupplierName)},{EscapeCsv(s.Phone ?? "")},{s.CreditLimit},{activeStr},{approvalStr},{EscapeCsv(notes)}");
            }

            var fileName = $"سجل_الموردين_أبو_عادل_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            successMessage = $"تم تصدير ({listToExport.Count}) مورد إلى إكسيل بنجاح.";
        }
        catch (Exception ex)
        {
            errorMessage = $"حدث خطأ أثناء التصدير: {ex.Message}";
        }
    }

