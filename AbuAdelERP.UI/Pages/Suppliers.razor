@page "/suppliers"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة وأزرار التصدير والاستيراد (مضبوط بدون تداخل) -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-start border-primary border-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="mb-1 text-dark fw-bold">🤝 إدارة الموردين واعتماد الجودة</h4>
                <small class="text-muted">التحكم في الموردين النشطين والمعتمدين لضمان سلامة التوريدات وإصدار أوامر الشراء</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportToExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل
                </button>
                <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                    <i class="bi bi-download me-1"></i> تحميل قالب الإكسيل
                </button>
                <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                    <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد من إكسيل
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadSuppliersAsync">
                    <i class="bi bi-arrow-clockwise"></i> تحديث البيانات
                </button>
            </div>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle me-1"></i> @successMessage
            <button type="button" class="btn-close py-2" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
            <button type="button" class="btn-close py-2" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- بطاقة إضافة / تعديل مورد -->
    <div class="card shadow-sm border-0 border-top border-primary border-3 mb-3 bg-white">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-primary">
                @(currentSupplier.Id > 0 ? "✏️ تعديل بيانات مورد" : "➕ إضافة مورد جديد")
            </h6>
            @if (currentSupplier.Id > 0)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="ResetForm">إلغاء التعديل</button>
            }
        </div>
        <div class="card-body p-3">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">كود المورد <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm font-monospace fw-bold" placeholder="مثال: SUP-010"
                           @bind="currentSupplier.SupplierCode" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">اسم المورد أو الشركة <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm fw-bold" placeholder="اسم الشركة / المصنع المورد"
                           @bind="currentSupplier.SupplierName" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">حد الائتمان (ج.م)</label>
                    <input type="number" step="100" class="form-control form-control-sm font-monospace"
                           @bind="currentSupplier.CreditLimit" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">رقم الهاتف</label>
                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="01xxxxxxxxx"
                           @bind="currentSupplier.Phone" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">اعتماد الجودة</label>
                    <select class="form-select form-select-sm fw-bold" @bind="currentSupplier.QualityStatus">
                        <option value="تحت التقييم (غير معتمد)">تحت التقييم (غير معتمد)</option>
                        <option value="مورد معتمد">مورد معتمد</option>
                    </select>
                </div>

                <div class="col-md-10">
                    <label class="form-label small fw-bold text-secondary mb-1">ملاحظات والتزامات الجودة</label>
                    <input type="text" class="form-control form-control-sm" placeholder="شهادات الجودة (ISO/HACCP)، أصناف التوريد الأساسية..."
                           @bind="currentSupplier.QualityNotes" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm"
                            disabled="@isSaving" @onclick="SaveSupplierAsync">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-save me-1"></i> @(currentSupplier.Id > 0 ? "تحديث المورد" : "حفظ المورد")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- بطاقات الإحصائيات (KPI Cards) -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold">إجمالي الموردين</small>
                        <h4 class="mb-0 fw-bold text-dark mt-1">@suppliers.Count</h4>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-people fs-4 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold">الموردين المعتمدين (Approved)</small>
                        <h4 class="mb-0 fw-bold text-success mt-1">@suppliers.Count(s => s.IsApprovedStatus)</h4>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-shield-check fs-4 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold">قيد التقييم / غير معتمدين</small>
                        <h4 class="mb-0 fw-bold text-warning mt-1">@suppliers.Count(s => !s.IsApprovedStatus)</h4>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-hourglass-split fs-4 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-danger border-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold">موردين موقوفين (غير نشط)</small>
                        <h4 class="mb-0 fw-bold text-danger mt-1">@suppliers.Count(s => !s.Active)</h4>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-slash-circle fs-4 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- شريط الفلاتر المتقدمة الشامل -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-top border-primary border-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">

                <div class="col-md-5">
                    <label class="form-label small fw-bold text-secondary mb-1">🔍 بحث سريع (اسم، كود، أو هاتف)</label>
                    <input type="text" class="form-control form-control-sm" placeholder="اكتب اسم المورد، الكود، أو رقم الهاتف..."
                           @bind="searchTerm" @bind:event="oninput" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">🎖️ اعتماد الجودة</label>
                    <select class="form-select form-select-sm" @bind="selectedApprovalFilter">
                        <option value="all">-- كل الموردين --</option>
                        <option value="approved">🛡️ مورد معتمد فقط</option>
                        <option value="pending">⏳ قيد التقييم / غير معتمد</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">⚡ حالة التعامل</label>
                    <select class="form-select form-select-sm" @bind="selectedStatusFilter">
                        <option value="all">كل الحالات</option>
                        <option value="active">🟢 نشط فقط</option>
                        <option value="inactive">🔴 موقوف</option>
                    </select>
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-outline-danger btn-sm w-100" title="تفريغ الفلاتر" @onclick="ResetFilters">✕</button>
                </div>

            </div>

            @if (HasActiveFilters)
            {
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    <span class="small text-primary fw-bold">
                        <i class="bi bi-funnel-fill me-1"></i> نتائج التصفية: (@FilteredSuppliers.Count() من إجمالي @suppliers.Count مورد)
                    </span>
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" style="font-size: 0.78rem;" @onclick="ResetFilters">
                        ✕ إلغاء الفلاتر وعرض الكل
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- جدول سجل الموردين -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <span class="small fw-bold">📋 سجل الموردين</span>
            <span class="badge bg-primary">المعروض: @FilteredSuppliers.Count() مورد</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center small">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">الكود</th>
                        <th class="text-start">اسم المورد</th>
                        <th>الهاتف</th>
                        <th>حد الائتمان</th>
                        <th>حالة التعامل</th>
                        <th>اعتماد الجودة</th>
                        <th>الملاحظات</th>
                        <th style="width: 240px;">إجراءات سريعة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="8" class="py-4 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري تحميل سجل الموردين...
                            </td>
                        </tr>
                    }
                    else if (!FilteredSuppliers.Any())
                    {
                        <tr>
                            <td colspan="8" class="py-4 text-muted">
                                <i class="bi bi-search fs-3 d-block mb-2 text-secondary"></i>
                                لا يوجد موردين مطابقين لشروط البحث والفلترة المحددة.
                                <div class="mt-2">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="ResetFilters">إعادة ضبط الفلاتر</button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var sup in FilteredSuppliers)
                        {
                            <tr class="@(sup.Id == currentSupplier.Id ? "table-primary" : "")" @key="sup.Id">
                                <td class="font-monospace fw-bold text-secondary">@sup.SupplierCode</td>
                                <td class="text-start fw-bold text-dark">@sup.SupplierName</td>
                                <td class="font-monospace text-muted">@(!string.IsNullOrEmpty(sup.Phone) ? sup.Phone : "-")</td>
                                <td class="font-monospace fw-bold">@sup.CreditLimit.ToString("N2") ج.م</td>
                                <td>
                                    <span class="badge @(sup.Active ? "bg-success" : "bg-danger")">
                                        @(sup.Active ? "نشط" : "موقوف")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(sup.IsApprovedStatus ? "bg-primary" : "bg-warning text-dark")">
                                        @(sup.IsApprovedStatus ? "مورد معتمد" : "غير معتمد")
                                    </span>
                                </td>
                                <td class="text-muted text-truncate" style="max-width: 180px;">
                                    @(string.IsNullOrEmpty(sup.QualityNotes) ? "-" : sup.QualityNotes)
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm py-0 px-2 fw-bold me-1" @onclick="() => EditSupplier(sup)">
                                        تعديل
                                    </button>

                                    <button class="btn btn-outline-@(sup.IsApprovedStatus ? "warning text-dark" : "info") btn-sm py-0 px-2 fw-bold me-1"
                                            @onclick="() => ToggleApprovalStatus(sup)">
                                        @(sup.IsApprovedStatus ? "إلغاء الاعتماد" : "اعتماد المورد")
                                    </button>

                                    <button class="btn btn-outline-@(sup.Active ? "danger" : "success") btn-sm py-0 px-2 fw-bold me-1"
                                            @onclick="() => ToggleActiveStatus(sup)">
                                        @(sup.Active ? "إيقاف" : "تنشيط")
                                    </button>

                                    <button class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" @onclick="() => DeleteSupplierAsync(sup)">
                                        حذف
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- نافذة استيراد الموردين من ملف إكسيل -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">

                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد سجل الموردين من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        يمكنك حفظ شيت الإكسيل بصيغة <strong>CSV (UTF-8)</strong> ثم رفعه هنا مباشرة.
                        يقوم النظام بالتحقق من كود أو اسم المورد لمنع التكرار وتحديث البيانات السابقة آلياً.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة الموردين المقروءة من الملف (@importedPreviewList.Count مورد):</span>
                            <span class="badge bg-success">جاهز للاستيراد</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>الكود</th>
                                        <th class="text-start">اسم المورد</th>
                                        <th>الهاتف</th>
                                        <th>حد الائتمان</th>
                                        <th>اعتماد الجودة</th>
                                        <th>الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@row.SupplierCode</td>
                                            <td class="text-start fw-bold">@row.SupplierName</td>
                                            <td class="font-monospace">@row.Phone</td>
                                            <td class="font-monospace">@row.CreditLimit.ToString("N2")</td>
                                            <td>
                                                <span class="badge @(row.IsApproved ? "bg-primary" : "bg-warning text-dark")">
                                                    @(row.IsApproved ? "مورد معتمد" : "غير معتمد")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(row.Active ? "bg-success" : "bg-danger")">
                                                    @(row.Active ? "نشط" : "موقوف")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm"
                            disabled="@(isSavingImport || !importedPreviewList.Any())"
                            @onclick="ProcessAndSaveImportAsync">
                        @if (isSavingImport)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري حفظ وتحديث بيانات الموردين...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check-circle"></i> تأكيد واستيراد كافة الموردين (@importedPreviewList.Count)</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    public class SupplierDto
    {
        public long Id { get; set; }
        public long CompanyId { get; set; } = 1;

        [JsonPropertyName("supplierCode")]
        public string? SupplierCodeProp { get; set; }

        [JsonPropertyName("code")]
        public string? CodeProp { get; set; }

        [JsonIgnore]
        public string SupplierCode
        {
            get => !string.IsNullOrWhiteSpace(SupplierCodeProp) ? SupplierCodeProp
                 : (!string.IsNullOrWhiteSpace(CodeProp) ? CodeProp : "");
            set => SupplierCodeProp = value;
        }

        [JsonPropertyName("supplierName")]
        public string? SupplierNameProp { get; set; }

        [JsonPropertyName("name")]
        public string? NameProp { get; set; }

        [JsonIgnore]
        public string SupplierName
        {
            get => !string.IsNullOrWhiteSpace(SupplierNameProp) ? SupplierNameProp
                 : (!string.IsNullOrWhiteSpace(NameProp) ? NameProp : "");
            set => SupplierNameProp = value;
        }

        public string? Phone { get; set; }
        public decimal CreditLimit { get; set; } = 0;
        public bool Active { get; set; } = true;

        [JsonPropertyName("isApproved")]
        public bool? IsApproved { get; set; }

        [JsonPropertyName("qualityStatus")]
        public string? QualityStatusProp { get; set; }

        [JsonIgnore]
        public string QualityStatus
        {
            get => !string.IsNullOrWhiteSpace(QualityStatusProp) ? QualityStatusProp
                 : ((IsApproved.HasValue && IsApproved.Value) ? "مورد معتمد" : "تحت التقييم (غير معتمد)");
            set
            {
                QualityStatusProp = value;
                IsApproved = value == "مورد معتمد";
            }
        }

        [JsonIgnore]
        public bool IsApprovedStatus => QualityStatus == "مورد معتمد" || (IsApproved.HasValue && IsApproved.Value);

        [JsonPropertyName("qualityNotes")]
        public string? QualityNotesProp { get; set; }

        [JsonPropertyName("notes")]
        public string? NotesProp { get; set; }

        [JsonIgnore]
        public string? QualityNotes
        {
            get => !string.IsNullOrWhiteSpace(QualityNotesProp) ? QualityNotesProp : NotesProp;
            set => QualityNotesProp = value;
        }
    }

    public class SupplierImportRowDto
    {
        public string SupplierCode { get; set; } = string.Empty;
        public string SupplierName { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public decimal CreditLimit { get; set; } = 0;
        public bool IsApproved { get; set; } = false;
        public string QualityNotes { get; set; } = string.Empty;
        public bool Active { get; set; } = true;
    }

    private List<SupplierDto> suppliers = new();
    private SupplierDto currentSupplier = new();
    private List<SupplierImportRowDto> importedPreviewList = new();

    private string searchTerm = "";
    private string selectedApprovalFilter = "all";
    private string selectedStatusFilter = "all";

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isSavingImport = false;
    private bool isImportModalOpen = false;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliersAsync();
    }

    private async Task LoadSuppliersAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            suppliers = await Http.GetFromJsonAsync<List<SupplierDto>>("api/suppliers") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب بيانات الموردين: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        selectedApprovalFilter != "all" ||
        selectedStatusFilter != "all";

    private void ResetFilters()
    {
        searchTerm = "";
        selectedApprovalFilter = "all";
        selectedStatusFilter = "all";
    }

    private IEnumerable<SupplierDto> FilteredSuppliers
    {
        get
        {
            var query = suppliers.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(s =>
                    s.SupplierName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    s.SupplierCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(s.Phone) && s.Phone.Contains(term)));
            }

            if (selectedApprovalFilter == "approved")
            {
                query = query.Where(s => s.IsApprovedStatus);
            }
            else if (selectedApprovalFilter == "pending")
            {
                query = query.Where(s => !s.IsApprovedStatus);
            }

            if (selectedStatusFilter == "active")
            {
                query = query.Where(s => s.Active);
            }
            else if (selectedStatusFilter == "inactive")
            {
                query = query.Where(s => !s.Active);
            }

            return query;
        }
    }

