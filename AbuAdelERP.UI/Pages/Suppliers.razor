@page "/suppliers"
@using System.Net.Http.Json
@using AbuAdelERP.UI.DTOs
@inject HttpClient Http

<div class="container-fluid py-4" dir="rtl">
    <!-- رأس الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-truck-flatbed me-2"></i>دليل الموردين وسلاسل الإمداد
            </h3>
            <p class="text-muted small mb-0">إدارة موردي الخامات ومواد التعبئة، شروط السداد، والبيانات الضريبية</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary px-4 shadow-sm" @onclick="OpenCreateModal">
                <i class="bi bi-person-plus-fill me-1"></i> تسجيل مورد جديد
            </button>
            <button class="btn btn-outline-secondary px-3" @onclick="LoadSuppliers" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- رسائل التنبيه -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- بطاقات الإحصائيات السريعة -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-primary">
                <span class="text-muted small fw-bold d-block">إجمالي الموردين المسجلين</span>
                <h4 class="fw-bold text-dark mb-0">@suppliers.Count</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-success">
                <span class="text-muted small fw-bold d-block">الموردين النشطين</span>
                <h4 class="fw-bold text-success mb-0">@suppliers.Count(s => s.Active)</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-warning">
                <span class="text-muted small fw-bold d-block">موردين آجل (تسهيلات سداد)</span>
                <h4 class="fw-bold text-warning mb-0">@suppliers.Count(s => s.PaymentTerms != null && s.PaymentTerms.Contains("آجل"))</h4>
            </div>
        </div>
    </div>

    <!-- شريط البحث والفلترة -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-8">
                    <input type="text" class="form-control" placeholder="بحث باسم المورد، الكود، الهاتف، أو الرقم الضريبي..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <select class="form-select" @bind="activeFilter" @bind:after="LoadSuppliers">
                        <option value="">كافة الموردين (نشط ومعطل)</option>
                        <option value="true">الموردين النشطين فقط</option>
                        <option value="false">الموردين المعطلين فقط</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول الموردين -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2 mb-0">جاري تحميل بيانات الموردين...</p>
                </div>
            }
            else if (!FilteredSuppliers.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-people fs-1 d-block mb-2"></i>
                    لا يوجد موردين مطابقين لمعايير البحث.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th>كود المورد</th>
                                <th class="text-start ps-3">اسم المورد</th>
                                <th>الهاتف والتواصل</th>
                                <th>العنوان</th>
                                <th>الرقم الضريبي</th>
                                <th>شروط السداد</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in FilteredSuppliers)
                            {
                                <tr>
                                    <td class="fw-bold font-monospace text-primary">@s.SupplierCode</td>
                                    <td class="text-start ps-3 fw-bold text-dark">
                                        @s.SupplierName
                                        @if (!string.IsNullOrEmpty(s.Notes))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 200px;">@s.Notes</div>
                                        }
                                    </td>
                                    <td class="small">
                                        <div><i class="bi bi-telephone me-1 text-muted"></i>@(s.Phone ?? "---")</div>
                                        @if (!string.IsNullOrEmpty(s.Email))
                                        {
                                            <div class="text-muted"><i class="bi bi-envelope me-1"></i>@s.Email</div>
                                        }
                                    </td>
                                    <td class="small text-muted">@(s.Address ?? "---")</td>
                                    <td class="font-monospace small">@(s.TaxNumber ?? "---")</td>
                                    <td>
                                        <span class="badge @(s.PaymentTerms == "نقدي" ? "bg-light text-dark border" : "bg-info text-dark")">
                                            @(s.PaymentTerms ?? "نقدي")
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm @(s.Active ? "btn-outline-success" : "btn-outline-danger")"
                                                @onclick="() => ToggleSupplierStatus(s.Id)">
                                            @(s.Active ? "نشط" : "معطل")
                                        </button>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(s)" title="تعديل">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: إضافة / تعديل مورد -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered" dir="rtl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(editingId > 0 ? "bi-pencil-square" : "bi-person-plus-fill") me-2"></i>
                        @(editingId > 0 ? "تعديل بيانات مورد" : "تسجيل مورد جديد")
                    </h5>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@modalError</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">اسم المورد / الشركة <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="مثال: مطاحن ومضارب الغربية" @bind="currentSupplier.SupplierName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">كود المورد (اتركه فارغاً للتوليد التلقائي)</label>
                            <input type="text" class="form-control font-monospace" placeholder="مثال: SUP-0012" @bind="currentSupplier.SupplierCode" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">رقم الهاتف / المحمول</label>
                            <input type="text" class="form-control" placeholder="01xxxxxxxxx" @bind="currentSupplier.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">البريد الإلكتروني</label>
                            <input type="email" class="form-control" placeholder="supplier@domain.com" @bind="currentSupplier.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">الرقم الضريبي</label>
                            <input type="text" class="form-control font-monospace" placeholder="رقم التسجيل الضريبي" @bind="currentSupplier.TaxNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">شروط السداد المعتمدة</label>
                            <select class="form-select" @bind="currentSupplier.PaymentTerms">
                                <option value="نقدي">نقدي عند الاستلام</option>
                                <option value="آجل 15 يوم">آجل 15 يوم</option>
                                <option value="آجل 30 يوم">آجل 30 يوم</option>
                                <option value="آجل 60 يوم">آجل 60 يوم</option>
                                <option value="دفعة مقدمة">دفعة مقدمة مع التوريد</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">العنوان ومقر التوريد</label>
                            <input type="text" class="form-control" placeholder="المحافظة - المركز - العنوان بالتفصيل" @bind="currentSupplier.Address" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">ملاحظات ومواصفات التوريد</label>
                            <textarea class="form-control" rows="2" placeholder="أي شروط جودة خاصة، أصناف التوريد، أو بنود الاتفاق..." @bind="currentSupplier.Notes"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" id="supplierActiveSwitch" @bind="currentSupplier.Active" />
                                <label class="form-check-label fs-6 fw-bold ms-2" for="supplierActiveSwitch">المورد نشط ومتاح لأوامر الشراء</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-4" @onclick="CloseModal">إلغاء</button>
                    <button type="button" class="btn btn-success px-4" @onclick="SaveSupplier" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span>حفظ المورد</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<SupplierViewDto> suppliers = new();
    private SupplierCreateUpdateDto currentSupplier = new();
    private long editingId = 0;
    private string searchTerm = string.Empty;
    private string activeFilter = "";
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showModal = false;
    private string? statusMessage;
    private string? errorMessage;
    private string? modalError;

    private IEnumerable<SupplierViewDto> FilteredSuppliers =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? suppliers
            : suppliers.Where(s => (s.SupplierName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                                || (s.SupplierCode?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                                || (s.Phone?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                                || (s.TaxNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliers();
    }

    private async Task LoadSuppliers()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            string url = "api/suppliers";
            if (!string.IsNullOrEmpty(activeFilter))
            {
                url += $"?active={activeFilter}";
            }
            suppliers = await Http.GetFromJsonAsync<List<SupplierViewDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل تحميل الموردين: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        editingId = 0;
        currentSupplier = new SupplierCreateUpdateDto { Active = true, PaymentTerms = "نقدي" };
        modalError = null;
        showModal = true;
    }

    private void OpenEditModal(SupplierViewDto item)
    {
        editingId = item.Id;
        currentSupplier = new SupplierCreateUpdateDto
        {
            SupplierCode = item.SupplierCode,
            SupplierName = item.SupplierName,
            Phone = item.Phone,
            Email = item.Email,
            Address = item.Address,
            TaxNumber = item.TaxNumber,
            PaymentTerms = item.PaymentTerms,
            Active = item.Active,
            Notes = item.Notes
        };
        modalError = null;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task SaveSupplier()
    {
        if (string.IsNullOrWhiteSpace(currentSupplier.SupplierName))
        {
            modalError = "اسم المورد مطلوب.";
            return;
        }

        isSaving = true;
        modalError = null;
        try
        {
            HttpResponseMessage response;
            if (editingId > 0)
                response = await Http.PutAsJsonAsync($"api/suppliers/{editingId}", currentSupplier);
            else
                response = await Http.PostAsJsonAsync("api/suppliers", currentSupplier);

            if (response.IsSuccessStatusCode)
            {
                statusMessage = editingId > 0 ? "تم تحديث بيانات المورد بنجاح." : "تم تسجيل المورد بنجاح.";
                CloseModal();
                await LoadSuppliers();
            }
            else
            {
                modalError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            modalError = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleSupplierStatus(long id)
    {
        try
        {
            var response = await Http.PatchAsync($"api/suppliers/{id}/toggle-status", null);
            if (response.IsSuccessStatusCode)
            {
                var s = suppliers.FirstOrDefault(x => x.Id == id);
                if (s != null) s.Active = !s.Active;
                statusMessage = "تم تحديث حالة المورد.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل تغيير الحالة: {ex.Message}";
        }
    }
}