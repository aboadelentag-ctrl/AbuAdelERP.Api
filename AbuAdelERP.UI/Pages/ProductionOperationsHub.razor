    private async Task SubmitFinalizeOrderComplete()
    {
        if (currentExecutionOrder == null) return;
        isSubmittingExecution = true;
        try
        {
            var payload = new
            {
                OrderId = currentExecutionOrder.Id,
                Items = currentExecutionOrder.Items.Select(i => new
                {
                    DetailId = i.DetailId,
                    ProducedQuantity = i.ProducedQuantity,
                    BatchNumber = i.BatchNumber,
                    NormalScrapQuantity = i.NormalScrapQuantity,
                    AbnormalScrapQuantity = i.AbnormalScrapQuantity,
                    ScrapReason = i.ScrapReason,
                    Materials = i.Materials.Select(m => new
                    {
                        ComponentItemId = m.ComponentItemId,
                        ActualConsumedQuantity = m.ActualConsumedQuantity
                    }).ToList()
                }).ToList()
            };

            var res = await Http.PostAsJsonAsync("api/productionoperations/finalize-order-complete", payload);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = "✅ تم تقفيل واعتماد جميع أصناف الأمر وترصيد اللوطات وخصم الخامات المستهلكة بنجاح!";
                isSuccess = true;
                currentExecutionOrder = null;
                selectedExecutionOrderId = 0;
                await LoadOrders();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                statusMessage = $"❌ فشل اعتماد التقفيل: {err}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
        finally { isSubmittingExecution = false; }
    }

    private async Task SubmitShiftAndProductivity()
    {
        var presentCrew = FilteredShiftCrew.Where(c => c.AttendanceStatus == "حاضر" && c.HoursWorked > 0).ToList();
        if (!presentCrew.Any())
        {
            statusMessage = "⚠️ يرجى تحديد العمال الحاضرين في الصالة والتأكد من وجود ساعات عمل أكبر من صفر.";
            isSuccess = false;
            return;
        }

        isSubmittingShift = true;
        try
        {
            long orderIdToSend = shiftSelectedOrderId > 0
                ? shiftSelectedOrderId
                : (FilteredOrdersForShiftDept.FirstOrDefault()?.OrderId ?? (ordersList.FirstOrDefault()?.OrderId ?? 0));

            var payload = new
            {
                ProductionOrderId = orderIdToSend,
                ShiftName = shiftNameInput,
                StartTime = shiftStartTime,
                EndTime = shiftEndTime,
                TotalProducedQuantity = shiftProducedTotal,
                CrewMembers = FilteredShiftCrew.Select(c => new { c.EmployeeId, c.HoursWorked, c.AttendanceStatus }).ToList()
            };

            var res = await Http.PostAsJsonAsync("api/productionoperations/submit-shift-productivity", payload);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = $"✅ تم اعتماد الوردية واحتساب معدل الإنتاجية بالساعة لـ ({presentCrew.Count}) حاضرين في صالة [{SelectedShiftDeptName}] بنجاح!";
                isSuccess = true;
                await LoadAllReportsData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                statusMessage = $"❌ فشل اعتماد الوردية: {err}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSubmittingShift = false;
        }
    }

