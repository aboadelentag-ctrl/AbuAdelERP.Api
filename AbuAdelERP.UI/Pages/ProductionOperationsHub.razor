                statusMessage = $"❌ فشل إصدار الأمر: {err}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task ImportOrdersFromCsv(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        try
        {
            using var reader = new StreamReader(file.OpenReadStream());
            string? header = await reader.ReadLineAsync();
            var lines = new List<NewOrderItemLine>();

            while (!reader.EndOfStream)
            {
                var line = await reader.ReadLineAsync();
                if (string.IsNullOrWhiteSpace(line)) continue;
                var cols = line.Split(',');
                if (cols.Length >= 2)
                {
                    var itemCode = cols[0].Trim().Replace("\"", "");
                    var qty = decimal.TryParse(cols[1].Trim(), out var q) ? q : 10m;
                    var itm = allItemsList.FirstOrDefault(i => i.ItemCode.Equals(itemCode, StringComparison.OrdinalIgnoreCase) || i.ItemName.Contains(itemCode));
                    if (itm != null)
                    {
                        lines.Add(new NewOrderItemLine { ItemId = itm.Id, ItemName = itm.ItemName, PlannedQuantity = qty, Unit = itm.Unit });
                    }
                }
            }

            if (lines.Any())
            {
                newOrderLines = lines;
                OpenCreateOrderModal();
                statusMessage = $"✅ تم استيراد ({lines.Count}) أصناف من الملف بنجاح!";
                isSuccess = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ أثناء قراءة الملف: {ex.Message}";
            isSuccess = false;
        }
    }

