    private async Task SubmitCreateOrder()
    {
        try
        {
            var payload = new
            {
                WarehouseId = newOrderWarehouseId,
                DepartmentId = newOrderDeptId,
                OrderDate = DateOnly.FromDateTime(newOrderDate),
                Items = newOrderLines.Select(l => new { l.ItemId, l.PlannedQuantity, l.Unit }).ToList()
            };

            var res = await Http.PostAsJsonAsync("api/productionoperations/create-order", payload);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = "✅ تم إصدار أمر التشغيل بنجاح وربطه بمخزن الصالة آلياً!";
                isSuccess = true;
                isCreateModalOpen = false;
