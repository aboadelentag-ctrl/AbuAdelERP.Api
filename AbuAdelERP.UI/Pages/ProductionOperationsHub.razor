    private async Task ExportOrdersToExcel()
    {
        var sb = new StringBuilder();
        sb.AppendLine("رقم الأمر,تاريخ التشغيل,صالة الإنتاج,مخزن الصالة,الأصناف,الحالة");
        foreach (var o in FilteredOrders)
        {
            var itemsNames = string.Join(" | ", o.Details.Select(d => $"{d.ItemName} ({d.PlannedQuantity})"));
            sb.AppendLine($"\"{o.OrderNumber}\",\"{o.OrderDate:yyyy-MM-dd}\",\"{o.DepartmentName}\",\"{o.WarehouseName}\",\"{itemsNames}\",\"{o.Status}\"");
        }
        await DownloadCsvFile(sb.ToString(), $"أوامر_الإنتاج_{DateTime.Now:yyyyMMdd}.csv");
    }

    private async Task ExportAttendanceLogsToCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("التاريخ,كود العامل,اسم العامل,صالة الإنتاج,ساعات العمل,الإنتاج المنجز,المعدل بالساعة,الملاحظات");
        foreach (var l in FilteredDetailedLogs)
        {
            sb.AppendLine($"\"{l.LogDate:yyyy-MM-dd}\",\"{l.EmployeeCode}\",\"{l.EmployeeName}\",\"{l.DepartmentName}\",{l.HoursWorked},{l.ProducedQuantity},{l.ProductivityPerHour},\"{l.Notes}\"");
        }
        await DownloadCsvFile(sb.ToString(), $"يوميات_حضور_وإنتاجية_العمال_{DateTime.Now:yyyyMMdd}.csv");
    }

    private async Task DownloadCsvFile(string csvContent, string fileName)
    {
        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csvContent)).ToArray();
        var base64 = Convert.ToBase64String(bytes);
        var js = $"const link = document.createElement('a'); link.href = 'data:text/csv;charset=utf-8;base64,{base64}'; link.download = '{fileName}'; document.body.appendChild(link); link.click(); document.body.removeChild(link);";
        await JS.InvokeVoidAsync("eval", js);
    }

