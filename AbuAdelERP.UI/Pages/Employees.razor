@page "/employees"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json.Serialization
@using System.IO
@using AbuAdelERP.UI.Services
@using Blazored.LocalStorage
@inject HttpClient Http
@inject AppState State
@inject IJSRuntime JS

<PageTitle>إدارة العمال والورديات (HR) - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الشاشة التنفيذي -->
    <div class="card shadow-sm border-0 mb-3 bg-dark text-white rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold m-0 text-info">👥 إدارة العمال والفنيين والورديات (HR Master)</h4>
                    <span class="badge bg-info text-dark px-2 py-1 small fw-bold">شؤون العاملين</span>
                </div>
                <small class="text-light text-opacity-75">
                    حصر الكوادر الميدانية وربطهم بالأقسام وصالات الإنتاج وتثبيت العهد والماكينات بالكود الوظيفي الرسمي.
                </small>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <AuthorizePermission Permission="Employees.Manage, Users.View">
                    <button class="btn btn-info btn-sm fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2 text-dark" @onclick="OpenNewEmployeeModal">
                        <i class="bi bi-person-plus-fill"></i> تسجيل موظف / عامل جديد
                    </button>
                </AuthorizePermission>

                <button class="btn btn-outline-light btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="ExportEmployeesToExcel">
                    <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> تصدير إكسيل
                </button>

                <AuthorizePermission Permission="Employees.Manage">
                    <label class="btn btn-outline-info btn-sm fw-bold px-3 py-2 shadow-sm mb-0 cursor-pointer">
                        <i class="bi bi-file-earmark-arrow-up-fill me-1"></i> استيراد من إكسيل
                        <InputFile OnChange="ImportEmployeesFromExcel" class="d-none" accept=".csv" />
                    </label>
                </AuthorizePermission>
            </div>
        </div>
    </div>

    <!-- رسائل النظام -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") py-2 small fw-bold alert-dismissible fade show shadow-sm" role="alert">
            @statusMessage
            <button type="button" class="btn-close py-2" @onclick='() => statusMessage = ""'></button>
        </div>
    }

    <!-- شريط فلاتر البحث والفرز الذكي -->
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body p-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="بحث بكود الموظف، الاسم، أو المسمى..." @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm fw-bold" @bind="selectedDeptFilter">
                        <option value="">-- كل الأقسام والصالات المعتمدة --</option>
                        @foreach (var dept in dbDepartments)
                        {
                            <option value="@dept.DisplayName">@dept.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="selectedJobFilter">
                        <option value="">-- كل المسميات الوظيفية --</option>
                        @foreach (var job in distinctJobTitles)
                        {
                            <option value="@job">@job</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary btn-sm w-100 fw-bold" @onclick="ResetFilters">إلغاء الفلاتر</button>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول العاملين -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="fw-bold text-dark m-0">📋 سجل القوى العاملة بالصالات والمصنع (المعروض: @FilteredEmployees.Count() من أصل @employeesList.Count)</h6>
            <span class="badge bg-dark font-monospace">محدث من قاعدة البيانات</span>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">الكود الوظيفي</th>
                        <th>الاسم الرباعي الرسمي</th>
                        <th>القسم / الصالة</th>
                        <th>المسمى الوظيفي المعتمد</th>
                        <th style="width: 120px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredEmployees.Any())
                    {
                        <tr><td colspan="5" class="text-muted py-4 fw-bold">لا يوجد عاملون يطابقون شروط البحث.</td></tr>
                    }
                    else
                    {
                        @foreach (var emp in FilteredEmployees)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary fs-6">@emp.DisplayCode</td>
                                <td class="fw-bold text-start ps-3 text-dark fs-6">@emp.DisplayName</td>
                                <td><span class="badge bg-primary px-2 py-1">@emp.DisplayDepartment</span></td>
                                <td class="text-muted fw-bold">@emp.DisplayJobTitle</td>
                                <td>
                                    <AuthorizePermission Permission="Employees.Manage, Users.View">
                                        <button class="btn btn-sm btn-outline-primary py-1 px-3 fw-bold" @onclick="() => EditEmployee(emp)">
                                            تعديل
                                        </button>
                                    </AuthorizePermission>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal إضافة/تعديل عامل (مربوط بقاعدة البيانات والأقسام والمسميات) -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-info text-dark py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="modal-title fw-bold">@(editingEmp.Id == 0 ? "👤 قيد عامل / موظف جديد" : $"🛠 تعديل بيانات الموظف: {editingEmp.DisplayName}")</h6>
                    <button type="button" class="btn-close" @onclick="() => isModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2 small fw-bold mb-3">@modalError</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="small fw-bold text-dark mb-1">الكود الوظيفي *</label>
                            <input type="text" class="form-control font-monospace fw-bold text-primary" @bind="inputCode" placeholder="مثال: EMP-045" />
                        </div>
                        <div class="col-md-8">
                            <label class="small fw-bold text-dark mb-1">الاسم الرباعي الرسمي *</label>
                            <input type="text" class="form-control fw-bold" @bind="inputFullName" placeholder="الاسم ثلاثي أو رباعي كما في مسيرات الرواتب" />
                        </div>

                        <!-- القسم / الصالة مسحوب من إدارة الأقسام api/Departments -->
                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">القسم / الصالة (مرتبط بالهيكل المعتمد) *</label>
                            <select class="form-select fw-bold border-primary" @bind="inputDepartmentName">
                                @foreach (var d in dbDepartments)
                                {
                                    <option value="@d.DisplayName">@d.DisplayName</option>
                                }
                            </select>
                        </div>

                        <!-- المسمى الوظيفي مرتبط بقائمة المسميات مع دعم الإدخال الحر -->
                        <div class="col-md-6">
                            <label class="small fw-bold text-dark mb-1">المسمى الوظيفي المعتمد *</label>
                            <input type="text" class="form-control fw-bold" list="jobTitlesDatalist" @bind="inputJobTitle" placeholder="اختر من القائمة أو اكتب مسمى جديد..." />
                            <datalist id="jobTitlesDatalist">
                                @foreach (var job in distinctJobTitles)
                                {
                                    <option value="@job">@job</option>
                                }
                            </datalist>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isModalOpen = false">إلغاء</button>
                    <button class="btn btn-info text-dark btn-sm px-4 fw-bold shadow-sm" disabled="@isSaving" @onclick="SaveEmployee">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري الحفظ بالخادم...</span>
                        }
                        else
                        {
                            <span>💾 حفظ بيانات العامل</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // نموذج بيانات الموظف المرن (يقرأ كافة التسميات المحتملة من الـ API)
    public class EmployeeDto
    {
        public long Id { get; set; }

        [JsonPropertyName("code")] public string? Code { get; set; }
        [JsonPropertyName("employeeCode")] public string? EmployeeCode { get; set; }

        [JsonPropertyName("fullName")] public string? FullName { get; set; }
        [JsonPropertyName("employeeName")] public string? EmployeeName { get; set; }
        [JsonPropertyName("name")] public string? Name { get; set; }

        [JsonPropertyName("departmentId")] public long? DepartmentId { get; set; }
        [JsonPropertyName("departmentName")] public string? DepartmentName { get; set; }
        [JsonPropertyName("department")] public DepartmentSimpleDto? DepartmentNav { get; set; }

        [JsonPropertyName("jobTitle")] public string? JobTitle { get; set; }
        [JsonPropertyName("jobTitleId")] public long? JobTitleId { get; set; }

        // خصائص ذكية لضمان العرض دائماً مهما كانت تسمية الحقل في الـ JSON
        [JsonIgnore]
        public string DisplayCode => !string.IsNullOrWhiteSpace(Code) ? Code
            : (!string.IsNullOrWhiteSpace(EmployeeCode) ? EmployeeCode : $"EMP-{Id:D3}");

        [JsonIgnore]
        public string DisplayName => !string.IsNullOrWhiteSpace(FullName) ? FullName
            : (!string.IsNullOrWhiteSpace(EmployeeName) ? EmployeeName
            : (!string.IsNullOrWhiteSpace(Name) ? Name : $"عامل #{Id}"));

        [JsonIgnore]
        public string DisplayDepartment => !string.IsNullOrWhiteSpace(DepartmentName) ? DepartmentName
            : (DepartmentNav != null && !string.IsNullOrWhiteSpace(DepartmentNav.DepartmentName) ? DepartmentNav.DepartmentName : "قسم الشرقي والمخبوزات");

        [JsonIgnore]
        public string DisplayJobTitle => !string.IsNullOrWhiteSpace(JobTitle) ? JobTitle : "فني تشغيل";
    }

    public class DepartmentSimpleDto
    {
        public long Id { get; set; }
        public string? DepartmentCode { get; set; }
        public string? DepartmentName { get; set; }
        public string? Name { get; set; }
        public string DisplayName => !string.IsNullOrWhiteSpace(DepartmentName) ? DepartmentName
            : (!string.IsNullOrWhiteSpace(Name) ? Name : $"قسم #{Id}");
    }

    public class JobTitleSimpleDto
    {
        public long Id { get; set; }
        public string? TitleName { get; set; }
        public string? Name { get; set; }
        public string DisplayTitle => !string.IsNullOrWhiteSpace(TitleName) ? TitleName
            : (!string.IsNullOrWhiteSpace(Name) ? Name : $"مسمى #{Id}");
    }

    private List<EmployeeDto> employeesList = new();
    private List<DepartmentSimpleDto> dbDepartments = new();
    private List<string> distinctJobTitles = new();

    private string searchTerm = "";
    private string selectedDeptFilter = "";
    private string selectedJobFilter = "";

    private bool isModalOpen = false;
    private bool isSaving = false;
    private string statusMessage = "";
    private string modalError = "";
    private bool isSuccess = true;

    private EmployeeDto editingEmp = new();
    private string inputCode = "";
    private string inputFullName = "";
    private string inputDepartmentName = "";
    private string inputJobTitle = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartments();
        await LoadJobTitles();
        await LoadEmployees();
    }

    private async Task LoadDepartments()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<DepartmentSimpleDto>>("api/Departments");
            if (res != null && res.Any()) dbDepartments = res;
        }
        catch { }

        if (!dbDepartments.Any())
        {
            dbDepartments = new List<DepartmentSimpleDto>
            {
                new() { Id = 1, DepartmentName = "إدارة الإنتاج" },
                new() { Id = 2, DepartmentName = "قسم الشرقي والمخبوزات" },
                new() { Id = 3, DepartmentName = "قسم الجاتوه والتورت والحلويات الغربية" },
                new() { Id = 4, DepartmentName = "قسم النواشف والبتيفور والكرواسون" },
                new() { Id = 5, DepartmentName = "مستودع التعبئة والتغليف والتوزيع" },
                new() { Id = 6, DepartmentName = "إدارة الصيانة والتشغيل المركزي" },
                new() { Id = 7, DepartmentName = "إدارة الجودة وسلامة الغذاء" }
            };
        }
    }

    private async Task LoadJobTitles()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<JobTitleSimpleDto>>("api/JobTitles");
            if (res != null && res.Any())
            {
                distinctJobTitles = res.Select(j => j.DisplayTitle).Distinct().ToList();
            }
        }
        catch { }

        if (!distinctJobTitles.Any())
        {
            distinctJobTitles = new List<string>
            {
                "مهندس انتاج",
                "شيف صالة إنتاج",
                "شيف جاتوه وتورت",
                "شيف شرقي ومخبوزات",
                "منسق انتاج",
                "فني صيانة ميكانيكية",
                "فني صيانة كهربائية",
                "أمين مخزن خامات",
                "أمين مستودع مركزي",
                "مراقب جودة (ISO/GMP)",
                "نائب مدير اداره الجوده",
                "عامل تشغيل وتعبئة"
            };
        }
    }

    private async Task LoadEmployees()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<EmployeeDto>>("api/Employees");
            if (res != null && res.Any())
            {
                employeesList = res;

                // تحديث قائمة المسميات الوظيفية من البيانات الفعلية
                var jobsFromData = employeesList.Select(e => e.DisplayJobTitle).Where(j => !string.IsNullOrWhiteSpace(j));
                distinctJobTitles = distinctJobTitles.Union(jobsFromData).Distinct().ToList();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ في جلب بيانات العاملين: {ex.Message}";
            isSuccess = false;
        }
    }

    private IEnumerable<EmployeeDto> FilteredEmployees => employeesList.Where(e =>
    {
        if (!string.IsNullOrWhiteSpace(selectedDeptFilter) && !e.DisplayDepartment.Equals(selectedDeptFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(selectedJobFilter) && !e.DisplayJobTitle.Equals(selectedJobFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            return e.DisplayCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                   e.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                   e.DisplayDepartment.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                   e.DisplayJobTitle.Contains(term, StringComparison.OrdinalIgnoreCase);
        }

        return true;
    });

    private void ResetFilters()
    {
        searchTerm = "";
        selectedDeptFilter = "";
        selectedJobFilter = "";
    }

    private void OpenNewEmployeeModal()
    {
        modalError = "";
        editingEmp = new EmployeeDto();
        inputCode = $"EMP-{new Random().Next(100, 999)}";
        inputFullName = "";
        inputDepartmentName = dbDepartments.FirstOrDefault()?.DisplayName ?? "قسم الشرقي والمخبوزات";
        inputJobTitle = distinctJobTitles.FirstOrDefault() ?? "فني تشغيل";
        isModalOpen = true;
    }

    private void EditEmployee(EmployeeDto emp)
    {
        modalError = "";
        editingEmp = emp;
        inputCode = emp.DisplayCode;
        inputFullName = emp.DisplayName;
        inputDepartmentName = emp.DisplayDepartment;
        inputJobTitle = emp.DisplayJobTitle;
        isModalOpen = true;
    }

    private async Task SaveEmployee()
    {
        modalError = "";

        if (string.IsNullOrWhiteSpace(inputFullName) || string.IsNullOrWhiteSpace(inputCode))
        {
            modalError = "⚠️ يرجى إدخال الكود الوظيفي والاسم الرسمي كاملاً!";
            return;
        }

        isSaving = true;

        try
        {
            var matchedDept = dbDepartments.FirstOrDefault(d => d.DisplayName == inputDepartmentName);

            var payload = new
            {
                Code = inputCode,
                EmployeeCode = inputCode,
                FullName = inputFullName,
                EmployeeName = inputFullName,
                Name = inputFullName,
                DepartmentId = matchedDept?.Id,
                DepartmentName = inputDepartmentName,
                JobTitle = inputJobTitle
            };

            HttpResponseMessage res;

            if (editingEmp.Id == 0)
            {
                res = await Http.PostAsJsonAsync("api/Employees", payload);
            }
            else
            {
                res = await Http.PutAsJsonAsync($"api/Employees/{editingEmp.Id}", payload);
            }

            if (res.IsSuccessStatusCode)
            {
                await LoadEmployees();
                statusMessage = $"✅ تم حفظ بيانات الموظف [{inputCode}] {inputFullName} بنجاح في قاعدة البيانات!";
                isSuccess = true;
                isModalOpen = false;
            }
            else
            {
                var errContent = await res.Content.ReadAsStringAsync();
                modalError = $"❌ فشل الحفظ من الخادم: {errContent}";
            }
        }
        catch (Exception ex)
        {
            modalError = $"❌ خطأ في الاتصال: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    // ============================================
    // تصدير واستيراد الإكسيل (CSV بترميز UTF-8 مع BOM)
    // ============================================
    private async Task ExportEmployeesToExcel()
    {
        var sb = new StringBuilder();
        sb.AppendLine("الكود الوظيفي,الاسم الرباعي الرسمي,القسم والصالة,المسمى الوظيفي المعتمد");

        foreach (var emp in FilteredEmployees)
        {
            sb.AppendLine($"\"{emp.DisplayCode}\",\"{emp.DisplayName}\",\"{emp.DisplayDepartment}\",\"{emp.DisplayJobTitle}\"");
        }

        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"سجل_العمال_والورديات_{DateTime.Now:yyyyMMdd_HHmm}.csv";

        var js = $@"
            const link = document.createElement('a');
            link.href = 'data:text/csv;charset=utf-8;base64,{base64}';
            link.download = '{fileName}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ";
        await JS.InvokeVoidAsync("eval", js);
    }

    private async Task ImportEmployeesFromExcel(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream());
            string? header = await reader.ReadLineAsync();
            int count = 0;

            while (!reader.EndOfStream)
            {
                var line = await reader.ReadLineAsync();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = line.Split(',');
                if (cols.Length >= 2)
                {
                    var code = cols[0].Trim().Replace("\"", "");
                    var name = cols[1].Trim().Replace("\"", "");
                    var dept = cols.Length > 2 ? cols[2].Trim().Replace("\"", "") : "قسم الشرقي والمخبوزات";
                    var job = cols.Length > 3 ? cols[3].Trim().Replace("\"", "") : "فني تشغيل";

                    var payload = new
                    {
                        Code = code,
                        EmployeeCode = code,
                        FullName = name,
                        EmployeeName = name,
                        Name = name,
                        DepartmentName = dept,
                        JobTitle = job
                    };

                    var res = await Http.PostAsJsonAsync("api/Employees", payload);
                    if (res.IsSuccessStatusCode) count++;
                }
            }

            await LoadEmployees();
            statusMessage = $"✅ تم استيراد ({count}) موظف وإضافتهم بنجاح لقاعدة البيانات!";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            statusMessage = $"❌ خطأ أثناء استيراد الملف: {ex.Message}";
            isSuccess = false;
        }
    }
}