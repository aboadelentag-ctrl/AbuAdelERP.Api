    private void OpenNewUserModal()
    {
        editingUser = new UserDto { IsActive = true };
        selectedEmployeeCode = "";
        isUserModalOpen = true;
    }

    private void EditUser(UserDto user)
    {
        editingUser = new UserDto
        {
            Id = user.Id,
            EmployeeCode = user.EmployeeCode,
            EmployeeName = user.EmployeeName,
            Department = user.Department,
            JobTitle = user.JobTitle,
            Username = user.Username,
            Password = user.Password,
            RoleId = user.RoleId,
            RoleName = user.RoleName,
            IsActive = user.IsActive
        };
        selectedEmployeeCode = user.EmployeeCode;
        isUserModalOpen = true;
    }

    private void OnEmployeeCodeSelected(ChangeEventArgs e)
    {
        selectedEmployeeCode = e.Value?.ToString() ?? "";
        var emp = employeesCatalog.FirstOrDefault(x => x.Code == selectedEmployeeCode);
        if (emp != null)
        {
            editingUser.EmployeeCode = emp.Code;
            editingUser.EmployeeName = emp.FullName;
            editingUser.Department = emp.Department;
            editingUser.JobTitle = emp.JobTitle;

            if (string.IsNullOrEmpty(editingUser.Username))
            {
                editingUser.Username = emp.Code.Replace("EMP-", "").ToLower();
            }
        }
        else
        {
            editingUser.EmployeeCode = "";
            editingUser.EmployeeName = "";
            editingUser.Department = "";
            editingUser.JobTitle = "";
        }
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(editingUser.EmployeeCode))
        {
            statusMessage = "⚠️ يجب اختيار كود الموظف من سجل العاملين أولاً!";
            isSuccessMessage = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(editingUser.Username) || editingUser.RoleId == 0)
        {
            statusMessage = "⚠️ يرجى إدخال اسم المستخدم واختيار قالب الدور الوظيفي!";
            isSuccessMessage = false;
            return;
        }

        var role = rolesList.FirstOrDefault(r => r.Id == editingUser.RoleId);
        if (role != null)
        {
            editingUser.RoleName = role.Name;
        }

        if (editingUser.Id == 0)
        {
            editingUser.Id = usersList.Any() ? usersList.Max(u => u.Id) + 1 : 1;
            usersList.Add(editingUser);
            statusMessage = $"✅ تم ربط الموظف [{editingUser.EmployeeCode}] بحساب ({editingUser.Username}) ومنحه قالب ({editingUser.RoleName}) بنجاح!";
        }
        else
        {
            var existing = usersList.FirstOrDefault(u => u.Id == editingUser.Id);
            if (existing != null)
            {
                existing.EmployeeCode = editingUser.EmployeeCode;
                existing.EmployeeName = editingUser.EmployeeName;
                existing.Department = editingUser.Department;
                existing.JobTitle = editingUser.JobTitle;
                existing.Username = editingUser.Username;
                existing.Password = editingUser.Password;
                existing.RoleId = editingUser.RoleId;
                existing.RoleName = editingUser.RoleName;
                existing.IsActive = editingUser.IsActive;
                statusMessage = $"✅ تم تحديث بيانات وصلاحيات المستخدم ({existing.Username}) بنجاح!";
            }
        }

        isSuccessMessage = true;
        isUserModalOpen = false;
    }

