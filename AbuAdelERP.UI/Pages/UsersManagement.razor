@page "/users-management"
@using System.Net.Http.Json
@using AbuAdelERP.UI.Services
@using Blazored.LocalStorage
@inject HttpClient Http
@inject AppState State
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>إدارة المستخدمين ومصفوفة الحوكمة (RBAC) - حلواني أبو عادل</PageTitle>

@if (isAccessDenied)
{
    <!-- شاشة الحظر عند محاولة الدخول غير المصرح به -->
    <div class="container py-5 text-center" dir="rtl">
        <div class="card shadow-sm border-0 mx-auto p-5 rounded-4" style="max-width: 600px;">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-slash-fill" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">عذراً، غير مصرح لك بالوصول!</h4>
            <p class="text-muted small mb-4">
                شاشة إدارة المستخدمين وهندسة الصلاحيات مقصورة حصراً على الإدارة العليا ومديري النظام المعتمدين (<strong class="text-danger">Users.View</strong>).
            </p>
            <div>
                <a href="emergency-tasks" class="btn btn-primary fw-bold px-4 py-2 shadow-sm">
                    🚨 الانتقال لغرفة المهام المصرح بها
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3" dir="rtl">

        <!-- رأس الشاشة التنفيذي -->
        <div class="card shadow-sm border-0 mb-4 bg-dark text-white rounded-3">
            <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h4 class="fw-bold m-0 text-info">🛡️ حوكمة الحسابات ومحرك قوالب الصلاحيات الميدانية (RBAC)</h4>
                        <span class="badge bg-danger px-2 py-1 small">معايير الفصل بين المهام SoD</span>
                    </div>
                    <small class="text-light text-opacity-75">
                        الربط الإجباري لحسابات الدخول بسجلات شؤون العاملين (HR) بناءً على الكود الوظيفي، وتوزيع صلاحيات كل مرحلة تشغيلية بالزر المخصص لها.
                    </small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-white bg-opacity-10 text-white border p-2 small font-monospace">
                        المستخدم الحالي: [@State.EmployeeCode] @State.FullName
                    </span>
                </div>
            </div>
        </div>

        <!-- رسائل النظام والتنبيهات -->
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert @(isSuccessMessage ? "alert-success" : "alert-danger") py-2 small fw-bold alert-dismissible fade show shadow-sm" role="alert">
                @statusMessage
                <button type="button" class="btn-close py-2" @onclick='() => statusMessage = ""'></button>
            </div>
        }

        <!-- نظام التبويبات (Tabs) -->
        <ul class="nav nav-tabs fw-bold mb-3 border-bottom-2" id="rbacTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "users" ? "active text-primary border-primary border-bottom-0 fw-bold" : "text-muted")" @onclick='() => activeTab = "users"'>
                    👥 حسابات المستخدمين المربوطة بالـ HR (@usersList.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "roles" ? "active text-danger border-danger border-bottom-0 fw-bold" : "text-muted")" @onclick='() => activeTab = "roles"'>
                    ⚙️ مصفوفة قوالب الأدوار الوظيفية Dynamic Roles (@rolesList.Count)
                </button>
            </li>
        </ul>

        <!-- ======================================================== -->
        <!-- التبويب الأول: إدارة حسابات المستخدمين المربوطة بالموظفين -->
        <!-- ======================================================== -->
        @if (activeTab == "users")
        {
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 400px;">
                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="بحث بكود الموظف، الاسم، أو اسم المستخدم..." @bind="userSearchTerm" @bind:event="oninput" />
                    </div>
                    <button class="btn btn-primary btn-sm fw-bold px-3 shadow-sm d-flex align-items-center gap-2" @onclick="OpenNewUserModal">
                        <i class="bi bi-person-plus-fill fs-6"></i> إضافة حساب مستخدم (ربط بكود موظف)
                    </button>
                </div>
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>الكود الوظيفي (HR)</th>
                                <th>الاسم الرباعي الرسمي</th>
                                <th>الإدارة / الصالة</th>
                                <th>المسمى الوظيفي المعتمد</th>
                                <th>اسم الدخول (Username)</th>
                                <th>الدور الوظيفي (القالب الموروث)</th>
                                <th>الحالة</th>
                                <th>إجراءات الحساب</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredUsers.Any())
                            {
                                <tr><td colspan="8" class="text-muted py-4 fw-bold">لا يوجد مستخدمون مطابقون لمعايير البحث.</td></tr>
                            }
                            else
                            {
                                @foreach (var user in FilteredUsers)
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold text-primary">@user.EmployeeCode</td>
                                        <td class="fw-bold text-start ps-3 text-dark">@user.EmployeeName</td>
                                        <td><span class="badge bg-light text-dark border">@user.Department</span></td>
                                        <td class="text-muted small">@user.JobTitle</td>
                                        <td class="font-monospace fw-bold text-danger">@user.Username</td>
                                        <td><span class="badge bg-dark px-2 py-1">@user.RoleName</span></td>
                                        <td>
                                            <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                                @(user.IsActive ? "نشط ومفعل ✓" : "موقوف ⛔")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary py-1 px-2 fw-bold" @onclick="() => EditUser(user)">
                                                🛠 تعديل الصلاحيات والقالب
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ======================================================== -->
        <!-- التبويب الثاني: هندسة قوالب الأدوار الوظيفية الشاملة -->
        <!-- ======================================================== -->
        @if (activeTab == "roles")
        {
            <div class="card shadow-sm border-0 rounded-3 mb-4 border-top border-danger border-3">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold text-dark m-0">قوالب الأدوار الوظيفية المعيارية</h6>
                        <small class="text-muted">تخصيص صلاحيات كل مرحلة عمل وزر تشغيلي بدقة متناهية</small>
                    </div>
                    <button class="btn btn-danger btn-sm fw-bold px-3 shadow-sm d-flex align-items-center gap-2" @onclick="OpenNewRoleModal">
                        <i class="bi bi-shield-plus fs-6"></i> بناء وتصميم قالب دور جديد
                    </button>
                </div>
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>اسم القالب / الدور الوظيفي</th>
                                <th>عدد الصلاحيات الممنوحة</th>
                                <th>عدد العاملين المرتبطين بهذا القالب</th>
                                <th>إجراءات تصميم القالب</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in rolesList)
                            {
                                <tr>
                                    <td class="font-monospace">@role.Id</td>
                                    <td class="fw-bold text-danger text-start ps-3 fs-6">@role.Name</td>
                                    <td>
                                        <span class="badge bg-primary font-monospace px-2 py-1">@role.Permissions.Count صلاحية مفعلة</span>
                                    </td>
                                    <td class="font-monospace fw-bold">
                                        @usersList.Count(u => u.RoleId == role.Id) موظف
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger py-1 px-3 fw-bold" @onclick="() => EditRole(role)">
                                            ⚙️ تعديل مصفوفة الصلاحيات
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
}

<!-- ======================================================== -->
<!-- نافذة 1: إنشاء/تعديل مستخدم مع الربط التلقائي بكود الموظف -->
<!-- ======================================================== -->
@if (isUserModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">@(editingUser.Id == 0 ? "👤 ربط موظف جديد بحساب نظام (User)" : $"🛠 تعديل حساب: {editingUser.EmployeeName}")</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isUserModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    
                    <div class="card p-3 mb-3 border-0 shadow-sm border-start border-4 border-info bg-white">
                        <label class="form-label fw-bold small text-dark mb-1">
                            1. ابحث واختر الموظف الرسمي (مسحوب حياً من قاعدة بيانات العاملين) *
                        </label>
                        <select class="form-select fw-bold font-monospace border-primary mb-2" 
                                value="@selectedEmployeeCode" 
                                @onchange="OnEmployeeCodeSelected">
                            <option value="">-- اضغط للبحث بكود الموظف أو الاسم الرباعي --</option>
                            @foreach (var emp in employeesCatalog)
                            {
                                <option value="@emp.Code">[@emp.Code] - @emp.FullName - (@emp.Department)</option>
                            }
                        </select>
                        
                        <div class="row g-2 mt-2 bg-light p-2 rounded border">
                            <div class="col-md-4">
                                <label class="small text-muted mb-0 d-block">الاسم الرسمي الكامل:</label>
                                <strong class="text-dark small">@(!string.IsNullOrEmpty(editingUser.EmployeeName) ? editingUser.EmployeeName : "---")</strong>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted mb-0 d-block">الإدارة / الصالة التابع لها:</label>
                                <span class="badge bg-primary">@(!string.IsNullOrEmpty(editingUser.Department) ? editingUser.Department : "---")</span>
                            </div>
                            <div class="col-md-4">
                                <label class="small text-muted mb-0 d-block">المسمى الميداني المعتمد:</label>
                                <strong class="text-secondary small">@(!string.IsNullOrEmpty(editingUser.JobTitle) ? editingUser.JobTitle : "---")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="card p-3 border-0 shadow-sm bg-white">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark">اسم الدخول للنظام (Username) *</label>
                                <input type="text" class="form-control fw-bold font-monospace" @bind="editingUser.Username" placeholder="مثال: emp102 أو كود الموظف" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark">كلمة المرور (Password) *</label>
                                <input type="password" class="form-control fw-bold" @bind="editingUser.Password" placeholder="••••••••" />
                            </div>

                            <div class="col-12 mt-2">
                                <label class="form-label fw-bold small text-danger">2. قالب الدور الوظيفي المعتمد بالـ ERP *</label>
                                <select class="form-select fw-bold border-danger" @bind="editingUser.RoleId">
                                    <option value="0">-- اختر القالب المناسب ليرث صلاحياته آلياً --</option>
                                    @foreach (var role in rolesList)
                                    {
                                        <option value="@role.Id">@role.Name (@role.Permissions.Count صلاحية معتمدة)</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 mt-3 pt-2 border-top">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="userActiveCheck" @bind="editingUser.IsActive">
                                    <label class="form-check-label fw-bold small" for="userActiveCheck">تفعيل الحساب والسماح بتسجيل الدخول الفوري</label>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isUserModalOpen = false">إلغاء</button>
                    <button class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="SaveUser">💾 حفظ وتأكيد ربط الموظف</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ======================================================== -->
<!-- نافذة 2: مصمم مصفوفة الصلاحيات وقوالب الأدوار الشاملة -->
<!-- ======================================================== -->
@if (isRoleModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">@(editingRole.Id == 0 ? "✨ هندسة قالب دور وظيفي جديد" : $"⚙ تعديل مصفوفة القالب: {editingRole.Name}")</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isRoleModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    
                    <div class="card p-3 border-0 shadow-sm bg-white mb-3">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark mb-1">اسم الدور الوظيفي / القالب *</label>
                                <input type="text" class="form-control form-control-lg fw-bold text-danger" placeholder="مثال: فني صيانة، أمين مستودع، شيف صالة..." @bind="editingRole.Name" />
                            </div>
                            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                                <span class="badge bg-dark fs-6 font-monospace p-2">
                                    عدد الصلاحيات المحددة: @editingRole.Permissions.Count
                                </span>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        📋 اختر الشاشات والمراحل التشغيلية المصرح بها لهذا القالب:
                    </h6>

                    <div class="row g-3">
                        @foreach (var module in systemModules)
                        {
                            <div class="col-lg-4 col-md-6">
                                <div class="card border-0 shadow-sm h-100 bg-white">
                                    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center border-bottom">
                                        <strong class="text-primary small">@module.ModuleName</strong>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 11px;" @onclick="() => ToggleModulePermissions(module, true)">تحديد الكل</button>
                                            <button class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 11px;" @onclick="() => ToggleModulePermissions(module, false)">إلغاء</button>
                                        </div>
                                    </div>
                                    <div class="card-body p-2" style="max-height: 320px; overflow-y: auto;">
                                        @foreach (var perm in module.Permissions)
                                        {
                                            var isGranted = editingRole.Permissions.Contains(perm.Code);
                                            <div class="form-check form-switch mb-2 p-2 rounded @(isGranted ? "bg-primary text-white bg-opacity-75" : "bg-light")" style="transition: 0.2s;">
                                                <input class="form-check-input ms-2 float-end" type="checkbox" id="@perm.Code" 
                                                       checked="@isGranted" 
                                                       @onchange="(e) => TogglePermission(perm.Code, (bool)(e.Value ?? false))">
                                                <label class="form-check-label small fw-bold" for="@perm.Code" style="cursor:pointer;">
                                                    @perm.Title
                                                    <span class="d-block text-opacity-75 fw-normal font-monospace" style="font-size: 10px;">@perm.Code</span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isRoleModalOpen = false">إلغاء</button>
                    <button class="btn btn-danger btn-sm px-4 fw-bold shadow-sm" @onclick="SaveRole">💾 حفظ واعتماد القالب المحدث</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public class RoleDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public HashSet<string> Permissions { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    }

    public class UserDto
    {
        public int Id { get; set; }
        public string EmployeeCode { get; set; } = string.Empty;
        public string EmployeeName { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string JobTitle { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public int RoleId { get; set; }
        public string RoleName { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
    }

    public class EmployeeApiDto
    {
        public long Id { get; set; }
        public string? Code { get; set; }
        public string? FullName { get; set; }
        public string? Name { get; set; }
        public string? DepartmentName { get; set; }
        public string? JobTitle { get; set; }
    }

    public class EmployeeCatalogItem
    {
        public string Code { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string JobTitle { get; set; } = string.Empty;
    }

    public class SystemModule
    {
        public string ModuleName { get; set; } = string.Empty;
        public List<PermissionItem> Permissions { get; set; } = new();
    }

    public class PermissionItem
    {
        public string Code { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
    }

    private string activeTab = "users";
    private string userSearchTerm = "";
    private bool isAccessDenied = false;

    private List<UserDto> usersList = new();
    private List<RoleDto> rolesList = new();
    private List<EmployeeCatalogItem> employeesCatalog = new();
    private List<SystemModule> systemModules = new();

    private bool isUserModalOpen = false;
    private bool isRoleModalOpen = false;

    private UserDto editingUser = new();
    private RoleDto editingRole = new();
    private string selectedEmployeeCode = "";

    private string statusMessage = "";
    private bool isSuccessMessage = true;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("login", forceLoad: true);
            return;
        }

        if (!State.IsLoggedIn)
        {
            var user = await LocalStorage.GetItemAsync<string>("username");
            var empCode = await LocalStorage.GetItemAsync<string>("employeeCode");
            var fullName = await LocalStorage.GetItemAsync<string>("fullName");
            var role = await LocalStorage.GetItemAsync<string>("userRole");
            var dept = await LocalStorage.GetItemAsync<string>("departmentName");
            var perms = await LocalStorage.GetItemAsync<List<string>>("userPermissions");

            State.SetUserSession(0, empCode ?? (user ?? "EMP"), user ?? "admin", fullName ?? "أحمد عبد العزيز", role ?? "Admin", null, dept ?? "الإدارة", perms ?? new List<string>());
        }

        if (!State.HasPermission("Users.View"))
        {
            isAccessDenied = true;
            return;
        }

        BuildComprehensivePermissionsMatrix();
        await LoadEmployeesFromApi();
        await LoadRolesAndUsers();
    }

    private void BuildComprehensivePermissionsMatrix()
    {
        // مصفوفة الصلاحيات الموحدة المكتملة بدون أي تكرار
        systemModules = new List<SystemModule>
        {
            new SystemModule
            {
                ModuleName = "👑 الإدارة العليا والرقابة التنفيذية",
                Permissions = new()
                {
                    new PermissionItem { Code = "Dashboard.View", Title = "استعراض لوحة المؤشرات التنفيذية المباشرة" },
                    new PermissionItem { Code = "Dashboard.Financial", Title = "استعراض تثمين المخزون والبيانات المالية الحساسة" },
                    new PermissionItem { Code = "Audit.ViewLogs", Title = "سجل التدقيق الرقمي ومراقبة حركات المستخدمين" }
                }
            },
            new SystemModule
            {
                ModuleName = "🏭 الأصول الثابتة والماكينات بالصالات (Fixed Assets)",
                Permissions = new()
                {
                    new PermissionItem { Code = "FixedAssets.View", Title = "استعراض سجل الماكينات وخطوط الإنتاج بالصالات" },
                    new PermissionItem { Code = "FixedAssets.Manage", Title = "زر قيد وتعديل ماكينة وتثبيت ونقل العهدة" },
                    new PermissionItem { Code = "FixedAssets.History", Title = "زر استعراض السجل التاريخي للماكينة (Asset Dossier)" }
                }
            },
            new SystemModule
            {
                ModuleName = "🧺 دورة استلام وتسليم الأسبات وفض المنازعات (Chain of Custody)",
                Permissions = new()
                {
                    new PermissionItem { Code = "Crates.View", Title = "استعراض أرصدة الأسبات والصواني وسجل التداول (للقراءة)" },
