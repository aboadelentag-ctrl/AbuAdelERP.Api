    private IEnumerable<UserDto> FilteredUsers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(userSearchTerm))
                return usersList;

            var term = userSearchTerm.Trim();
            return usersList.Where(u =>
                u.EmployeeCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                u.EmployeeName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                u.Username.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                u.Department.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                u.RoleName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }

