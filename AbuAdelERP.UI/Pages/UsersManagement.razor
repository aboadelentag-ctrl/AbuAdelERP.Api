@page "/users-management"
@page "/users"
@layout AbuAdelERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using AbuAdelERP.UI.Services
@using Blazored.LocalStorage
@inject HttpClient Http
@inject AppState State
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>إدارة المستخدمين ومصفوفة الحوكمة (RBAC) - حلواني أبو عادل</PageTitle>

@if (isAccessDenied)
{
    <div class="container py-5 text-center" dir="rtl">
        <div class="card shadow-sm border-0 mx-auto p-5 rounded-4" style="max-width: 600px;">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-slash-fill" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">عذراً، غير مصرح لك بالوصول!</h4>
            <p class="text-muted small mb-4">
                شاشة إدارة المستخدمين وهندسة الصلاحيات مقصورة حصراً على الإدارة العليا ومديري النظام المعتمدين (<strong class="text-danger">Users.View</strong>).
            </p>
            <div>
                <a href="production-operations-hub" class="btn btn-primary fw-bold px-4 py-2 shadow-sm">
                    🚨 الانتقال لغرفة عمليات الإنتاج
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3" dir="rtl">
        <!-- رأس الشاشة التنفيذي -->
        <div class="card shadow-sm border-0 mb-4 bg-dark text-white rounded-3">
            <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h4 class="fw-bold m-0 text-info">🛡️ حوكمة الحسابات ومحرك قوالب الصلاحيات الميدانية (RBAC)</h4>
                    <small class="text-light text-opacity-75">إدارة حسابات المستخدمين وصلاحياتهم المعتمدة لمصانع أبو عادل.</small>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert @(isSuccessMessage ? "alert-success" : "alert-danger") py-2 small fw-bold alert-dismissible fade show shadow-sm" role="alert">
                @statusMessage
                <button type="button" class="btn-close py-2" @onclick='() => statusMessage = ""'></button>
            </div>
        }

        <!-- التبويبات -->
        <ul class="nav nav-tabs fw-bold mb-3 border-bottom-2" role="tablist">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "users" ? "active text-primary border-primary border-bottom-0 fw-bold bg-white" : "text-muted")" @onclick='() => activeTab = "users"'>
                    👥 حسابات المستخدمين المعتمدة (@usersList.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "roles" ? "active text-danger border-danger border-bottom-0 fw-bold bg-white" : "text-muted")" @onclick='() => activeTab = "roles"'>
                    ⚙️ مصفوفة قوالب الأدوار الوظيفية (@rolesList.Count)
                </button>
            </li>
        </ul>

        @if (activeTab == "users")
        {
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 400px;">
                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="بحث باسم المستخدم أو الاسم الكامل..." @bind="userSearchTerm" @bind:event="oninput" />
                    </div>
                    <button class="btn btn-primary btn-sm fw-bold px-3 shadow-sm d-flex align-items-center gap-2" @onclick="OpenNewUserModal">
                        ➕ إضافة حساب مستخدم جديد
                    </button>
                </div>
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th class="text-start ps-3">الاسم الكامل</th>
                                <th>اسم الدخول</th>
                                <th>القسم / الصالة</th>
                                <th>الدور الوظيفي</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredUsers.Any())
                            {
                                <tr><td colspan="7" class="text-muted py-4 fw-bold">لا توجد حسابات مطابقة للبحث.</td></tr>
                            }
                            else
                            {
                                @foreach (var user in FilteredUsers)
                                {
                                    <tr>
                                        <td class="font-monospace">@user.Id</td>
                                        <td class="fw-bold text-start ps-3 text-dark">@user.FullName</td>
                                        <td class="font-monospace text-primary">@user.Username</td>
                                        <td><span class="badge bg-light text-dark border">@(!string.IsNullOrEmpty(user.DepartmentName) ? user.DepartmentName : "عام")</span></td>
                                        <td><span class="badge bg-info text-dark">@user.Role</span></td>
                                        <td>
                                            <span class="badge @(user.IsActive ? "bg-success" : "bg-danger") px-2 py-1">
                                                @(user.IsActive ? "نشط ✓" : "معطل ✕")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary py-1 px-2 fw-bold" @onclick="() => EditUser(user)">
                                                ✏️ تعديل وحفظ
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (activeTab == "roles")
        {
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark m-0">قوالب الأدوار الوظيفية وصلاحياتها</h6>
                </div>
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>اسم الدور</th>
                                <th>الصلاحيات المتاحة</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in rolesList)
                            {
                                <tr>
                                    <td class="font-monospace">@role.Id</td>
                                    <td class="fw-bold text-danger text-start ps-3 fs-6">@role.Name</td>
                                    <td class="text-start ps-3 text-secondary font-monospace small" style="max-width: 500px; word-break: break-all;">
                                        @role.Permissions
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger py-1 px-3 fw-bold" @onclick="() => EditRole(role)">
                                            ⚙️ تعديل الصلاحيات
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- مودال المستخدم -->
    @if (isUserModalOpen)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
            <div class="modal-dialog modal-md modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-primary text-white py-2 px-3">
                        <h6 class="modal-title fw-bold">@(editingUser.Id == 0 ? "➕ إضافة حساب مستخدم جديد" : $"✏️ تعديل حساب: {editingUser.FullName}")</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => isUserModalOpen = false"></button>
                    </div>
                    <div class="modal-body bg-light p-3">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">اسم المستخدم (Username) *</label>
                            <input type="text" class="form-control form-control-sm font-monospace fw-bold" @bind="editingUser.Username" disabled="@(editingUser.Id > 0)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">الاسم الكامل *</label>
                            <input type="text" class="form-control form-control-sm fw-bold" @bind="editingUser.FullName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">اسم القسم / الصالة</label>
                            <input type="text" class="form-control form-control-sm" @bind="editingUser.DepartmentName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">الدور الرئيسي *</label>
                            <select class="form-select form-select-sm fw-bold border-primary" @bind="editingUser.Role">
                                <option value="Admin">مدير نظام (Admin)</option>
                                <option value="ProductionChef">شيف إنتاج (Production Chef)</option>
                                <option value="Storekeeper">أمين مخزن (Storekeeper)</option>
                                <option value="QualityOfficer">مراقب جودة (Quality Officer)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">كلمة المرور الجديدة</label>
                            <input type="password" class="form-control form-control-sm font-monospace" @bind="editingUser.PasswordHash" placeholder="اتركها فارغة إن لم ترد تغييرها" />
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActiveCheck" @bind="editingUser.IsActive">
                            <label class="form-check-label small fw-bold" for="isActiveCheck">حساب نشط ومفعل</label>
                        </div>
                    </div>
                    <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                        <button class="btn btn-secondary btn-sm px-3" @onclick="() => isUserModalOpen = false">إلغاء</button>
                        <button class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="SaveUserAsync">💾 حفظ البيانات</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- مودال الدور والصلاحيات -->
    @if (isRoleModalOpen)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" dir="rtl">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-danger text-white py-2 px-3">
                        <h6 class="modal-title fw-bold">⚙️ تعديل صلاحيات الدور: @editingRole.Name</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => isRoleModalOpen = false"></button>
                    </div>
                    <div class="modal-body bg-light p-3">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">الصلاحيات مفصولة بفواصل (Comma-separated permissions):</label>
                            <textarea class="form-control font-monospace small" rows="5" @bind="editingRole.Permissions"></textarea>
                            <small class="text-muted d-block mt-1">مثال: Users.View, Production.OperationsHub, Production.OrdersView, Requisition.Create</small>
                        </div>
                    </div>
                    <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                        <button class="btn btn-secondary btn-sm px-3" @onclick="() => isRoleModalOpen = false">إلغاء</button>
                        <button class="btn btn-danger btn-sm px-4 fw-bold shadow-sm" @onclick="SaveRolePermissionsAsync">💾 حفظ الصلاحيات</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private string activeTab = "users";
    private string userSearchTerm = "";
    private bool isAccessDenied = false;
    private string statusMessage = "";
    private bool isSuccessMessage = true;

    private List<UserDto> usersList = new();
    private List<RoleDto> rolesList = new();

    private bool isUserModalOpen = false;
    private bool isRoleModalOpen = false;

    private UserDto editingUser = new();
    private RoleDto editingRole = new();

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("login", forceLoad: true);
            return;
        }

        if (!State.IsLoggedIn)
        {
            var user = await LocalStorage.GetItemAsync<string>("username");
            var empCode = await LocalStorage.GetItemAsync<string>("employeeCode");
            var fullName = await LocalStorage.GetItemAsync<string>("fullName");
            var role = await LocalStorage.GetItemAsync<string>("userRole");
            var dept = await LocalStorage.GetItemAsync<string>("departmentName");
            var perms = await LocalStorage.GetItemAsync<List<string>>("userPermissions");

            State.SetUserSession(0, empCode ?? "EMP", user ?? "admin", fullName ?? "أحمد عبد العزيز", role ?? "Admin", null, dept ?? "الإدارة", perms ?? new List<string>());
        }

        if (!State.HasPermission("Users.View"))
        {
            isAccessDenied = true;
            return;
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            usersList = await Http.GetFromJsonAsync<List<UserDto>>("api/UsersManagement/users") ?? new();
            rolesList = await Http.GetFromJsonAsync<List<RoleDto>>("api/UsersManagement/roles") ?? new();
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ في جلب البيانات من الخادم: {ex.Message}";
            isSuccessMessage = false;
        }
    }

    private IEnumerable<UserDto> FilteredUsers => usersList.Where(u =>
        string.IsNullOrWhiteSpace(userSearchTerm) ||
        u.FullName.Contains(userSearchTerm, StringComparison.OrdinalIgnoreCase) ||
        u.Username.Contains(userSearchTerm, StringComparison.OrdinalIgnoreCase)
    );

    private void OpenNewUserModal()
    {
        editingUser = new UserDto { IsActive = true, Role = "ProductionChef" };
        isUserModalOpen = true;
    }

    private void EditUser(UserDto user)
    {
        editingUser = new UserDto
        {
            Id = user.Id,
            Username = user.Username,
            FullName = user.FullName,
            DepartmentId = user.DepartmentId,
            DepartmentName = user.DepartmentName,
            Role = user.Role,
            IsActive = user.IsActive,
            PasswordHash = user.PasswordHash,
            CustomPermissions = user.CustomPermissions
        };
        isUserModalOpen = true;
    }

    private async Task SaveUserAsync()
    {
        try
        {
            HttpResponseMessage res;
            if (editingUser.Id == 0)
            {
                res = await Http.PostAsJsonAsync("api/UsersManagement/users", editingUser);
            }
            else
            {
                res = await Http.PutAsJsonAsync($"api/UsersManagement/users/{editingUser.Id}", editingUser);
            }

            if (res.IsSuccessStatusCode)
            {
                statusMessage = "✅ تم حفظ بيانات المستخدم بنجاح!";
                isSuccessMessage = true;
                isUserModalOpen = false;
                await LoadDataAsync();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                statusMessage = $"❌ فشل الحفظ: {err}";
                isSuccessMessage = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ اتصال: {ex.Message}";
            isSuccessMessage = false;
        }
    }

    private void EditRole(RoleDto role)
    {
        editingRole = new RoleDto
        {
            Id = role.Id,
            Name = role.Name,
            Permissions = role.Permissions
        };
        isRoleModalOpen = true;
    }

    private async Task SaveRolePermissionsAsync()
    {
        try
        {
            var res = await Http.PutAsJsonAsync($"api/UsersManagement/roles/{editingRole.Id}/permissions", editingRole.Permissions);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = "✅ تم تحديث صلاحيات الدور بنجاح!";
                isSuccessMessage = true;
                isRoleModalOpen = false;
                await LoadDataAsync();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                statusMessage = $"❌ فشل التحديث: {err}";
                isSuccessMessage = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ اتصال: {ex.Message}";
            isSuccessMessage = false;
        }
    }

    public class UserDto
    {
        public long Id { get; set; }
        public string Username { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Role { get; set; } = "Admin";
        public string DepartmentName { get; set; } = string.Empty;
        public long? DepartmentId { get; set; }
        public bool IsActive { get; set; } = true;
        public string PasswordHash { get; set; } = string.Empty;
        public string CustomPermissions { get; set; } = string.Empty;
    }

    public class RoleDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Permissions { get; set; } = string.Empty;
    }
}