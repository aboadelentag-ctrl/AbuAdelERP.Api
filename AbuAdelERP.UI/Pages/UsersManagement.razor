    // دوال قوالب الأدوار ومصفوفة الصلاحيات
    // ============================================
    private void OpenNewRoleModal()
    {
        editingRole = new RoleDto { Permissions = new HashSet<string>(StringComparer.OrdinalIgnoreCase) };
        isRoleModalOpen = true;
    }

    private void EditRole(RoleDto role)
    {
        editingRole = new RoleDto
        {
            Id = role.Id,
            Name = role.Name,
            Permissions = new HashSet<string>(role.Permissions, StringComparer.OrdinalIgnoreCase)
        };
        isRoleModalOpen = true;
    }

    private void TogglePermission(string code, bool isGranted)
    {
        if (isGranted)
            editingRole.Permissions.Add(code);
        else
            editingRole.Permissions.Remove(code);
    }

    private void ToggleModulePermissions(SystemModule module, bool grantAll)
    {
        foreach (var perm in module.Permissions)
        {
            TogglePermission(perm.Code, grantAll);
        }
    }

    private void SaveRole()
    {
        if (string.IsNullOrWhiteSpace(editingRole.Name))
        {
            statusMessage = "⚠️ يرجى كتابة اسم الدور الوظيفي!";
            isSuccessMessage = false;
            return;
        }

        if (editingRole.Id == 0)
        {
            editingRole.Id = rolesList.Any() ? rolesList.Max(r => r.Id) + 1 : 1;
            rolesList.Add(editingRole);
            statusMessage = $"✅ تم إنشاء قالب الدور الجديد ({editingRole.Name}) وتضمين {editingRole.Permissions.Count} صلاحية بنجاح!";
        }
        else
        {
            var existing = rolesList.FirstOrDefault(r => r.Id == editingRole.Id);
            if (existing != null)
            {
                existing.Name = editingRole.Name;
                existing.Permissions = new HashSet<string>(editingRole.Permissions, StringComparer.OrdinalIgnoreCase);

                foreach (var user in usersList.Where(u => u.RoleId == existing.Id))
                {
                    user.RoleName = existing.Name;
                }
                statusMessage = $"✅ تم اعتماد تحديث مصفوفة قالب ({existing.Name}) بنجاح!";
            }
        }

        isSuccessMessage = true;
        isRoleModalOpen = false;
    }
