    private async Task LoadEmployeesFromApi()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<EmployeeApiDto>>("api/Employees");
            if (res != null && res.Any())
            {
                employeesCatalog = res.Select(e => new EmployeeCatalogItem
                {
                    Code = !string.IsNullOrEmpty(e.Code) ? e.Code : $"EMP-{e.Id:D3}",
                    FullName = !string.IsNullOrEmpty(e.FullName) ? e.FullName : (!string.IsNullOrEmpty(e.Name) ? e.Name : $"موظف #{e.Id}"),
                    Department = !string.IsNullOrEmpty(e.DepartmentName) ? e.DepartmentName : "عام",
                    JobTitle = !string.IsNullOrEmpty(e.JobTitle) ? e.JobTitle : "موظف تشغيل"
                }).ToList();
            }
        }
        catch { }

        if (!employeesCatalog.Any())
        {
            employeesCatalog = new List<EmployeeCatalogItem>
            {
                new() { Code = "EMP-001", FullName = "أحمد عبد العزيز", Department = "الإدارة العليا والتشغيل", JobTitle = "مدير المصنع" },
