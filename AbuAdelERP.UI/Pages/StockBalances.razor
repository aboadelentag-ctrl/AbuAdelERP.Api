    private void OpenImportModal()
    {
        importedPreviewList.Clear();
        isImportModalOpen = true;
    }

    private void CloseImportModal()
    {
        isImportModalOpen = false;
        importedPreviewList.Clear();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        importedPreviewList.Clear();
        var file = e.File;
        if (file == null) return;

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024), Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            if (lines.Length <= 1) return;

            var header = lines[0].Split(',');
            int codeIdx = 0, nameIdx = 1, whIdx = 2, qtyIdx = 3, notesIdx = 4;

            for (int i = 0; i < header.Length; i++)
            {
                var h = header[i].Trim().ToLower();
                if (h.Contains("كود") || h.Contains("code")) codeIdx = i;
                else if (h.Contains("صنف") || h.Contains("item")) nameIdx = i;
                else if (h.Contains("مخزن") || h.Contains("warehouse")) whIdx = i;
                else if (h.Contains("كمي") || h.Contains("qty")) qtyIdx = i;
                else if (h.Contains("ملاحظ") || h.Contains("notes")) notesIdx = i;
            }

            for (int i = 1; i < lines.Length; i++)
            {
                var line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = line.Split(',');
                if (cols.Length >= 3)
                {
                    string code = codeIdx < cols.Length ? cols[codeIdx].Trim() : "";
                    string name = nameIdx < cols.Length ? cols[nameIdx].Trim() : "";
                    string whName = whIdx < cols.Length ? cols[whIdx].Trim() : "";
                    decimal.TryParse(qtyIdx < cols.Length ? cols[qtyIdx].Trim() : "0", out var qty);

                    var matchedItem = items.FirstOrDefault(it => 
                        (!string.IsNullOrEmpty(code) && it.ItemCode.Equals(code, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(name) && it.ItemName.Contains(name, StringComparison.OrdinalIgnoreCase)));

                    var matchedWh = warehouses.FirstOrDefault(w => 
                        (!string.IsNullOrEmpty(whName) && w.WarehouseName.Contains(whName, StringComparison.OrdinalIgnoreCase))) 
                        ?? warehouses.FirstOrDefault();

                    if (matchedItem != null && matchedWh != null)
                    {
                        importedPreviewList.Add(new StockImportRowPreview
                        {
                            ItemId = matchedItem.Id,
                            ItemCode = matchedItem.ItemCode,
                            ItemName = matchedItem.ItemName,
                            WarehouseId = matchedWh.Id,
                            WarehouseName = matchedWh.WarehouseName,
                            Quantity = qty,
                            Notes = (notesIdx < cols.Length) ? cols[notesIdx].Trim() : "تحديث جرد آلي"
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ في قراءة ملف الإكسيل: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task ProcessAndSaveImportAsync()
    {
        if (!importedPreviewList.Any()) return;

        isSavingImport = true;
        try
        {
            var payload = importedPreviewList.Select(x => new
            {
                x.ItemId,
                x.WarehouseId,
                x.Quantity,
                x.Notes
            }).ToList();

            var res = await Http.PostAsJsonAsync("api/inventory/import-balances", payload);
            if (res.IsSuccessStatusCode)
            {
                isSuccess = true;
                statusMessage = $"تم تحديث أرصدة ({importedPreviewList.Count}) صنف في المخازن بنجاح!";
                CloseImportModal();
                await LoadDataAsync();
            }
            else
            {
                isSuccess = false;
                statusMessage = "تعذر تحديث الأرصدة بالسيرفر.";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"خطأ أثناء حفظ الأرصدة: {ex.Message}";
        }
        finally
        {
            isSavingImport = false;
        }
    }

    private async Task TriggerBrowserDownload(string fileName, string content)
    {
        var utf8WithBom = "\uFEFF" + content;
        var jsCommand = $@"
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(`{utf8WithBom}`);
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";
        await JS.InvokeVoidAsync("eval", jsCommand);
    }

    private string EscapeCsv(string val)
    {
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n"))
            return $"\"{val.Replace("\"", "\"\"")}\"";
        return val;
    }
