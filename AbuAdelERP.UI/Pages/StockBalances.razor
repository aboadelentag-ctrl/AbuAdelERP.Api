@page "/stock-balances"
@inject HttpClient Http
@using System.Net.Http.Json

<div class="container-fluid mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="text-primary m-0 mb-1">📦 أرصدة المخازن والأصناف</h3>
            <span class="text-muted">متابعة الأرصدة الحالية، الكميات المحجوزة، والتاحية في المخازن الرئيسية والفرعية</span>
        </div>
        <button class="btn btn-outline-primary fw-bold shadow-sm" @onclick="LoadStockData">
            🔄 تحديث الأرصدة
        </button>
    </div>

    <!-- كارت الفلاتر والبحث -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <div class="row align-items-end">
                <div class="col-md-5 mb-2 mb-md-0">
                    <label class="form-label fw-bold small text-secondary">اختر المخزن (يدعم تجميع الفروع تلقائياً)</label>
                    <select class="form-select border-primary fw-bold" @bind="selectedWarehouseId">
                        <option value="">-- كل المخازن والمستودعات --</option>
                        @foreach (var w in warehousesList)
                        {
                            <option value="@w.Id">@w.WarehouseName (@w.WarehouseCode)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 mb-2 mb-md-0">
                    <label class="form-label fw-bold small text-secondary">البحث برمز أو اسم الصنف</label>
                    <input type="text" class="form-control border-primary" @bind="searchKeyword" placeholder="اكتب للبحث..." />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary fw-bold w-100 shadow" @onclick="LoadStockData">🔍 استعلام الأرصدة</button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger fw-bold shadow-sm mb-3">❌ @errorMessage</div>
    }

    <!-- جدول عرض الأرصدة -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0 table-responsive">
            @if (isLoading)
            {
                <div class="p-5 text-center text-primary fw-bold">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    جاري جلب الأرصدة الحالية من المخازن...
                </div>
            }
            else if (!filteredStockList.Any())
            {
                <div class="p-5 text-center text-muted fw-bold">⚠️ لا توجد أصناف برصيد متاح في هذا المخزن حالياً.</div>
            }
            else
            {
                <table class="table table-hover mb-0 text-center align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>كود الصنف</th>
                            <th>اسم الصنف</th>
                            <th>الرصيد الفعلي الإجمالي</th>
                            <th>الكمية المحجوزة</th>
                            <th>الرصيد المتاح للبيع/الإنتاج</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in filteredStockList)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.ItemCode</td>
                                <td class="fw-bold text-start ps-3">@item.ItemName</td>
                                <td class="fw-bold fs-6 text-dark">@item.TotalQuantity</td>
                                <td class="text-warning fw-bold">@item.TotalReserved</td>
                                <td class="text-success fw-bold fs-6">@item.TotalAvailable</td>
                                <td>
                                    @if (item.TotalAvailable > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">متوفر</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">رصيد نفذ / سالب</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private List<StockBalanceViewDto> stockList = new();
    private List<WarehouseLookupDto> warehousesList = new();

    private long? selectedWarehouseId;
    private string searchKeyword = "";

    private bool isLoading = true;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehousesLookup();
        await LoadStockData();
    }

    private async Task LoadWarehousesLookup()
    {
        try
        {
            warehousesList = await Http.GetFromJsonAsync<List<WarehouseLookupDto>>("api/Warehouses") ?? new();
        }
        catch
        {
            // تجاهل خطأ اللوكوب المؤقت
        }
    }

    private async Task LoadStockData()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            string url = "api/StockBalances";
            if (selectedWarehouseId.HasValue && selectedWarehouseId.Value > 0)
            {
                url += $"?warehouseId={selectedWarehouseId.Value}";
            }

            stockList = await Http.GetFromJsonAsync<List<StockBalanceViewDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = "❌ تعذر الاتصال بالخادم لجلب أرصدة المخازن.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<StockBalanceViewDto> filteredStockList =>
        string.IsNullOrWhiteSpace(searchKeyword)
            ? stockList
            : stockList.Where(s => s.ItemName.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) ||
                                   s.ItemCode.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase));

    public class StockBalanceViewDto
    {
        public long ItemId { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public decimal TotalQuantity { get; set; }
        public decimal TotalReserved { get; set; }
        public decimal TotalAvailable { get; set; }
    }

    public class WarehouseLookupDto
    {
        public long Id { get; set; }
        public string WarehouseCode { get; set; } = string.Empty;
        public string WarehouseName { get; set; } = string.Empty;
    }
}