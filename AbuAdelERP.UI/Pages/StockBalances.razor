@page "/stock-balances"
@using System.Net.Http.Json
@using System.Text
@using AbuAdelERP.UI.DTOs
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="container-fluid py-4" dir="rtl">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-boxes me-2"></i>أرصدة المخازن اللحظية والرقابة على المخزون
            </h3>
            <p class="text-muted small mb-0">متابعة الأرصدة الحالية والمحجوزة والمتاحة عبر كافة مستودعات وفروع المصنع</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success px-3 shadow-sm fw-bold btn-sm" @onclick="ExportToCsv" disabled="@(isLoading || !FilteredBalances.Any())">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير الأرصدة (Excel)
            </button>
            <button class="btn btn-outline-primary px-3 shadow-sm fw-bold btn-sm" @onclick="LoadData" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i> تحديث الأرصدة اللحظية
            </button>
        </div>
    </div>

    <!-- رسائل الأخطاء -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- بطاقات الـ KPIs الإحصائية -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-4 border-primary p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold d-block">إجمالي الأصناف المسجلة</span>
                        <h4 class="fw-bold text-dark mb-0">@kpis.TotalItemsCount</h4>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="bi bi-collection fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-4 border-success p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold d-block">الكمية الإجمالية المتاحة</span>
                        <h4 class="fw-bold text-success mb-0">@kpis.TotalAvailableQuantity.ToString("N0")</h4>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-check2-all fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-4 border-warning p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold d-block">أصناف قاربت على النفاد (حد الطلب)</span>
                        <h4 class="fw-bold text-warning mb-0">@kpis.LowStockCount</h4>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-4 border-danger p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold d-block">أصناف نفد رصيدها تماماً</span>
                        <h4 class="fw-bold text-danger mb-0">@kpis.OutOfStockCount</h4>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- شريط الفلاتر المتقدمة -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">الفرع:</label>
                    <select class="form-select form-select-sm fw-bold" @bind="selectedBranchId" @bind:after="OnBranchChanged">
                        <option value="0">كافة الفروع</option>
                        @foreach (var b in branches)
                        {
                            <option value="@b.Id">@b.BranchName (@b.BranchCode)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">المستودع:</label>
                    <select class="form-select form-select-sm fw-bold" @bind="selectedWarehouseId" @bind:after="LoadData">
                        <option value="0">كافة المستودعات</option>
                        @foreach (var w in availableWarehouses)
                        {
                            <option value="@w.Id">@w.WarehouseName (@w.WarehouseCode)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">بحث سريع:</label>
                    <input type="text" class="form-control form-control-sm" placeholder="ابحث باسم الصنف أو الكود..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-2 pt-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="lowStockOnlySwitch" 
                               @bind="lowStockOnly" @bind:after="LoadData" />
                        <label class="form-check-label small fw-bold ms-1" for="lowStockOnlySwitch">النواقص فقط ⚠️</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول الأرصدة اللحظية -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2 mb-0">جاري احتساب ومطابقة الأرصدة اللحظية...</p>
                </div>
            }
            else if (!FilteredBalances.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    لا توجد أرصدة مخزنية مطابقة للفلاتر المحددة.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center small">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th>كود الصنف</th>
                                <th class="text-start ps-3">اسم الصنف</th>
                                <th>التصنيف</th>
                                <th>المستودع والفرع</th>
                                <th>الرصيد الفعلي</th>
                                <th>المحجوز</th>
                                <th>الرصيد المتاح</th>
                                <th>حد الطلب</th>
                                <th>الحالة</th>
                                <th>كارت الصنف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in FilteredBalances)
                            {
                                <tr>
                                    <td class="fw-bold font-monospace text-muted">@s.ItemCode</td>
                                    <td class="text-start ps-3 fw-bold text-dark">
                                        @s.ItemName
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">@s.CategoryName</span>
                                    </td>
                                    <td>
                                        <div class="small fw-bold text-dark">@s.WarehouseName</div>
                                        <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@s.BranchName</div>
                                    </td>
                                    <td class="fw-bold fs-6">
                                        @s.Quantity.ToString("N1") <span class="small text-muted fw-normal">@s.Unit</span>
                                    </td>
                                    <td class="text-warning fw-bold">
                                        @(s.ReservedQuantity > 0 ? s.ReservedQuantity.ToString("N1") : "---")
                                    </td>
                                    <td class="fw-bold text-success fs-6">
                                        @s.AvailableQuantity.ToString("N1") <span class="small text-muted fw-normal">@s.Unit</span>
                                    </td>
                                    <td class="text-muted small">
                                        @(s.ReorderLevel > 0 ? s.ReorderLevel.ToString("N0") : "غير محدد")
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadge(s.Status)">
                                            @s.Status
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-info btn-sm py-0 px-2 fw-bold" title="عرض الحركات التاريخية لكارت الصنف" @onclick="() => NavigateToStockCard(s.ItemId, s.WarehouseId)">
                                            📊 حركات الصنف
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<StockBalanceViewDto> balances = new();
    private StockKpiSummaryDto kpis = new();
    private List<BranchLookupDto> branches = new();
    private List<WarehouseDto> allWarehouses = new();
    private List<WarehouseDto> availableWarehouses = new();

    private long selectedBranchId = 0;
    private long selectedWarehouseId = 0;
    private bool lowStockOnly = false;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private string? errorMessage;

    private IEnumerable<StockBalanceViewDto> FilteredBalances =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? balances
            : balances.Where(b => (b.ItemName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                               || (b.ItemCode?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                               || (b.WarehouseName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadData();
    }

    private async Task LoadLookups()
    {
        try
        {
            var lookups = await Http.GetFromJsonAsync<SalesLookupsDto>("api/sales/lookups");
            if (lookups?.Branches != null)
            {
                branches = lookups.Branches.Select(b => new BranchLookupDto
                {
                    Id = b.Id,
                    BranchCode = b.BranchCode,
                    BranchName = b.BranchName
                }).ToList();
            }

            allWarehouses = await Http.GetFromJsonAsync<List<WarehouseDto>>("api/warehouses") ?? new();
            availableWarehouses = allWarehouses;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lookups: {ex.Message}");
        }
    }

    private void OnBranchChanged()
    {
        if (selectedBranchId > 0)
        {
            availableWarehouses = allWarehouses.Where(w => w.BranchId == selectedBranchId).ToList();
            selectedWarehouseId = 0;
        }
        else
        {
            availableWarehouses = allWarehouses;
        }
        LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var queryParams = new List<string>();
            if (selectedBranchId > 0) queryParams.Add($"branchId={selectedBranchId}");
            if (selectedWarehouseId > 0) queryParams.Add($"warehouseId={selectedWarehouseId}");
            if (lowStockOnly) queryParams.Add("lowStockOnly=true");

            string queryString = queryParams.Any() ? "?" + string.Join("&", queryParams) : "";

            balances = await Http.GetFromJsonAsync<List<StockBalanceViewDto>>($"api/stockbalances{queryString}") ?? new();
            kpis = await Http.GetFromJsonAsync<StockKpiSummaryDto>($"api/stockbalances/kpis{queryString}") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب الأرصدة اللحظية: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToStockCard(long itemId, long warehouseId)
    {
        Navigation.NavigateTo($"/stock-card?itemId={itemId}&warehouseId={warehouseId}");
    }

    private async Task ExportToCsv()
    {
        var list = FilteredBalances.ToList();
        if (!list.Any()) return;

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("كود_الصنف,اسم_الصنف,التصنيف,المستودع,الفرع,الرصيد_الفعلي,المحجوز,الرصيد_المتاح,الوحدة,حد_الطلب,الحالة");

            foreach (var s in list)
            {
                sb.AppendLine($"\"{s.ItemCode}\",\"{s.ItemName}\",\"{s.CategoryName}\",\"{s.WarehouseName}\",\"{s.BranchName}\",{s.Quantity:F2},{s.ReservedQuantity:F2},{s.AvailableQuantity:F2},\"{s.Unit}\",{s.ReorderLevel:F0},\"{s.Status}\"");
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"تقرير_أرصدة_المخازن_اللحظية_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await JS.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:text/csv;base64,{base64}'; a.download = '{fileName}'; document.body.appendChild(a); a.click(); document.body.removeChild(a);");
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل تصدير التقرير: {ex.Message}";
        }
    }

    private string GetStatusBadge(string status) => status switch
    {
        "نفد الرصيد" => "bg-danger text-white",
        "حد الطلب" => "bg-warning text-dark",
        _ => "bg-success text-white"
    };
}