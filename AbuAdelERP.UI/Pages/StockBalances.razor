    private async Task ExportDetailedExcelAsync()
    {
        var list = FilteredGroupedItems.ToList();
        if (!list.Any())
        {
            statusMessage = "لا توجد أرصدة لتصديرها.";
            isSuccess = false;
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("كود_الصنف,اسم_الصنف,الوحدة,الرصيد_الاجمالي,المحجوز_الاجمالي,المتاح_الاجمالي,المخزن,الرصيد_بالمخزن,المحجوز_بالمخزن,المتاح_بالمخزن,تاريخ_التحديث");

            foreach (var item in list)
            {
                foreach (var wh in item.WarehouseBreakdowns)
                {
                    sb.AppendLine($"{EscapeCsv(item.ItemCode)},{EscapeCsv(item.ItemName)},{EscapeCsv(item.Unit)},{item.TotalQuantity:F3},{item.TotalReserved:F3},{item.TotalAvailable:F3},{EscapeCsv(wh.WarehouseName)},{wh.Quantity:F3},{wh.ReservedQuantity:F3},{wh.AvailableQuantity:F3},{wh.LastUpdatedAt:yyyy-MM-dd HH:mm}");
                }
            }

            var fileName = $"تقرير_ارصدة_المخازن_الشامل_أبو_عادل_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, sb.ToString());
            statusMessage = $"تم تصدير أرصدة ({list.Count}) صنف مع تفاصيل مخازنها بنجاح.";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            statusMessage = $"فشل التصدير: {ex.Message}";
            isSuccess = false;
        }
    }

