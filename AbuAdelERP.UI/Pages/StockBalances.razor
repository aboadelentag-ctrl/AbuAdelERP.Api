@page "/stock-balances"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة وأزرار التصدير والاستيراد -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-start border-primary border-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="mb-1 text-primary fw-bold">📦 أرصدة المخازن والأصناف اللحظية</h4>
                <small class="text-muted">متابعة الأرصدة الإجمالية، الكميات المحجوزة، وتوزيع الرصيد التفصيلي في المخازن الرئيسية والفرعية</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportDetailedExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل تفصيلي
                </button>
                <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="DownloadTemplateAsync">
                    <i class="bi bi-download me-1"></i> تحميل قالب الجرد / الأرصدة
                </button>
                <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenImportModal">
                    <i class="bi bi-file-earmark-arrow-up me-1"></i> استيراد وتحديث الأرصدة
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadDataAsync">
                    <i class="bi bi-arrow-clockwise"></i> تحديث الأرصدة
                </button>
            </div>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mb-3 py-2 fw-bold" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>
            <strong>@(isSuccess ? "نجاح:" : "تنبيه:")</strong> @statusMessage
            <button type="button" class="btn-close py-2" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- بطاقات المؤشرات اللحظية (KPIs) -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي الأصناف المسجلة</small>
                <h4 class="mb-0 fw-bold text-primary mt-1">@GroupedItemBalances.Count() صنف</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3 bg-white">
                <small class="text-muted fw-bold">أصناف متوفرة بالمخازن</small>
                <h4 class="mb-0 fw-bold text-success mt-1">@GroupedItemBalances.Count(i => i.TotalAvailable > 0) صنف</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي الكميات المحجوزة</small>
                <h4 class="mb-0 fw-bold text-warning mt-1 font-monospace">@GroupedItemBalances.Sum(i => i.TotalReserved).ToString("N2")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-danger border-4 p-3 bg-white">
                <small class="text-muted fw-bold">أصناف نفدت / رصيد سالب</small>
                <h4 class="mb-0 fw-bold text-danger mt-1">@GroupedItemBalances.Count(i => i.TotalAvailable <= 0) صنف</h4>
            </div>
        </div>
    </div>

    <!-- شريط فلاتر البحث المتقدمة -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-top border-primary border-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-secondary mb-1">🔍 البحث برمز أو اسم الصنف</label>
                    <input type="text" class="form-control form-control-sm" placeholder="اكتب اسم الصنف أو الكود (مثال: سكر، سميد، 101001)..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">🏢 اختر المخزن (يدعم تجميع الفروع تلقائياً)</label>
                    <select class="form-select form-select-sm fw-bold border-primary" @bind="selectedWarehouseFilter">
                        <option value="0">-- كل المخازن والمستودعات --</option>
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.WarehouseName</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">⚡ حالة التوفر المخزني</label>
                    <select class="form-select form-select-sm" @bind="selectedStatusFilter">
                        <option value="all">كل الحالات والأرصدة</option>
                        <option value="available">✅ متوفر فقط (رصيد موجب)</option>
                        <option value="negative">❌ رصيد نفد / سالب</option>
                        <option value="reserved">⚠️ به كميات محجوزة</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-outline-danger btn-sm w-100 fw-bold" @onclick="ResetFilters">
                        ✕ إلغاء الفلاتر
                    </button>
                </div>
            </div>

            @if (HasActiveFilters)
            {
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    <span class="small text-primary fw-bold">
                        <i class="bi bi-funnel-fill me-1"></i> نتائج التصفية: (@FilteredGroupedItems.Count() صنف مطابق)
                    </span>
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" style="font-size: 0.78rem;" @onclick="ResetFilters">
                        عرض الكل
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- جدول الأرصدة الشامل (مع إمكانية توسيع رصيد كل مخزن) -->
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <span class="small fw-bold">📋 سجل أرصدة الأصناف وتوزيعها المخزني</span>
            <span class="badge bg-primary">المعروض: @FilteredGroupedItems.Count() صنف</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center small">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 6%;">توزيع المخازن</th>
                            <th style="width: 12%;">كود الصنف</th>
                            <th class="text-start ps-3" style="width: 25%;">اسم الصنف</th>
                            <th style="width: 8%;">الوحدة</th>
                            <th style="width: 15%;">الرصيد الفعلي الإجمالي</th>
                            <th style="width: 11%;">الكمية المحجوزة</th>
                            <th style="width: 15%;">الرصيد المتاح للبيع/الإنتاج</th>
                            <th style="width: 8%;">الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="8" class="py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري تحميل وتجميع أرصدة المخازن...
                                </td>
                            </tr>
                        }
                        else if (!FilteredGroupedItems.Any())
                        {
                            <tr>
                                <td colspan="8" class="py-4 text-muted">لا توجد أصناف مطابقة لشروط البحث والفلترة.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in FilteredGroupedItems)
                            {
                                bool isExpanded = expandedItemIds.Contains(item.ItemId);
                                <tr class="@(isExpanded ? "table-primary" : "")" @key="item.ItemId">
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 fw-bold" @onclick="() => ToggleExpand(item.ItemId)">
                                            @(isExpanded ? "▲ إخفاء" : "▼ تفصيل")
                                        </button>
                                    </td>

                                    <td class="font-monospace fw-bold text-primary">@item.ItemCode</td>
                                    
                                    <td class="text-start ps-3">
                                        <div class="fw-bold text-dark">@item.ItemName</div>
                                        <small class="text-muted">@item.ItemType</small>
                                    </td>

                                    <td><span class="badge bg-light text-dark border">@item.Unit</span></td>

                                    <td class="fw-bold font-monospace fs-6 @(item.TotalQuantity > 0 ? "text-dark" : "text-danger")">
                                        @item.TotalQuantity.ToString("N3")
                                    </td>

                                    <td class="font-monospace text-warning fw-bold">
                                        @item.TotalReserved.ToString("N3")
                                    </td>

                                    <td class="fw-bold font-monospace fs-6 @(item.TotalAvailable > 0 ? "text-success" : "text-danger")">
                                        @item.TotalAvailable.ToString("N3")
                                    </td>

                                    <td>
                                        @if (item.TotalAvailable > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">متوفر</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white px-2 py-1">رصيد نفد / سالب</span>
                                        }
                                    </td>
                                </tr>

                                @if (isExpanded)
                                {
                                    <!-- السطر 219 تم تصحيحه هنا بدقة -->
                                    <tr class="bg-light" @key="@($"sub-{item.ItemId}")">
                                        <td colspan="8" class="p-3">
                                            <div class="card border shadow-sm">
                                                <div class="card-header bg-secondary text-white py-1 px-3 d-flex justify-content-between align-items-center">
                                                    <small class="fw-bold">🏢 تفاصيل تواجد خامة [@item.ItemName] في كل مخزن مستقلاً:</small>
                                                    <button class="btn btn-outline-light btn-sm py-0 px-2 fw-bold" style="font-size: 0.75rem;" 
                                                            @onclick="() => OpenBreakdownModal(item)">
                                                        📊 فتح بطاقة التوزيع الشاملة
                                                    </button>
                                                </div>
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-bordered text-center align-middle mb-0 bg-white small">
                                                        <thead class="table-secondary">
                                                            <tr>
                                                                <th class="text-start ps-3" style="width: 30%;">اسم المخزن المستودع</th>
                                                                <th style="width: 20%;">الرصيد الفعلي بالمخزن</th>
                                                                <th style="width: 15%;">الكمية المحجوزة</th>
                                                                <th style="width: 20%;">الرصيد المتاح بالمخزن</th>
                                                                <th style="width: 15%;">آخر تحديث</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var wh in item.WarehouseBreakdowns)
                                                            {
                                                                <tr>
                                                                    <td class="text-start ps-3 fw-bold text-primary">
                                                                        <i class="bi bi-building me-1"></i> @wh.WarehouseName
                                                                    </td>
                                                                    <td class="font-monospace fw-bold">@wh.Quantity.ToString("N3") @item.Unit</td>
                                                                    <td class="font-monospace text-warning">@wh.ReservedQuantity.ToString("N3")</td>
                                                                    <td class="font-monospace fw-bold @(wh.AvailableQuantity > 0 ? "text-success" : "text-danger")">
                                                                        @wh.AvailableQuantity.ToString("N3") @item.Unit
                                                                    </td>
                                                                    <td class="font-monospace text-muted">@wh.LastUpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- بطاقة التوزيع المنبثقة -->
@if (selectedItemForModal != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        📊 بطاقة التوزيع المخزني للصنف: [@selectedItemForModal.ItemCode] - @selectedItemForModal.ItemName
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => selectedItemForModal = null"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <div class="border rounded p-2 text-center bg-light">
                                <small class="text-muted fw-bold d-block">إجمالي الرصيد الفعلي</small>
                                <span class="fs-5 fw-bold text-dark font-monospace">@selectedItemForModal.TotalQuantity.ToString("N2") @selectedItemForModal.Unit</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-2 text-center bg-light">
                                <small class="text-muted fw-bold d-block">إجمالي المحجوز للتشغيل</small>
                                <span class="fs-5 fw-bold text-warning font-monospace">@selectedItemForModal.TotalReserved.ToString("N2") @selectedItemForModal.Unit</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-2 text-center bg-light">
                                <small class="text-muted fw-bold d-block">الصافي المتاح للإنتاج</small>
                                <span class="fs-5 fw-bold text-success font-monospace">@selectedItemForModal.TotalAvailable.ToString("N2") @selectedItemForModal.Unit</span>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold small text-secondary mb-2">توزيع الكميات ونسب تواجدها في المخازن:</h6>
                    <div class="list-group shadow-sm">
                        @foreach (var wh in selectedItemForModal.WarehouseBreakdowns)
                        {
                            var percentage = selectedItemForModal.TotalQuantity > 0 
                                ? (wh.Quantity / selectedItemForModal.TotalQuantity) * 100 
                                : 0;
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark">🏢 @wh.WarehouseName</span>
                                    <span class="font-monospace fw-bold text-primary">@wh.Quantity.ToString("N2") @selectedItemForModal.Unit (@percentage.ToString("F1")%)</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @percentage%"></div>
                                </div>
                                <div class="d-flex justify-content-between small text-muted mt-1">
                                    <span>المتاح: @wh.AvailableQuantity.ToString("N2")</span>
                                    <span>المحجوز: @wh.ReservedQuantity.ToString("N2")</span>
                                    <span>آخر حركة: @wh.LastUpdatedAt.ToString("yyyy-MM-dd")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-4 fw-bold" @onclick="() => selectedItemForModal = null">إغلاق</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- نافذة استيراد الأرصدة من إكسيل -->
@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" dir="rtl">
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h5 class="modal-title fw-bold fs-6">
                        <i class="bi bi-file-earmark-excel me-1"></i> استيراد وتحديث أرصدة المخازن من ملف إكسيل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> 
                        يتعرف النظام تلقائياً على كود الصنف والمخزن والكمية لتحديث الرصيد الفعلي وإثبات حركة تسوية مخزنية رسمية.
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <label class="form-label small fw-bold text-dark">اختر ملف الإكسيل / CSV من جهازك:</label>
                        <InputFile OnChange="HandleFileSelected" accept=".csv, text/csv" class="form-control form-control-sm" />
                    </div>

                    @if (importedPreviewList.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark">معاينة الأرصدة المقروءة من الملف (@importedPreviewList.Count صنف):</span>
                            <span class="badge bg-success">جاهز للتحديث</span>
                        </div>
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>كود الصنف</th>
                                        <th>اسم الصنف المطابق</th>
                                        <th>المخزن المستهدف</th>
                                        <th>الكمية الفعلية</th>
                                        <th>الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importedPreviewList)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@row.ItemCode</td>
                                            <td class="fw-bold text-primary">@row.ItemName</td>
                                            <td class="fw-bold">@row.WarehouseName</td>
                                            <td class="font-monospace fw-bold text-success">@row.Quantity.ToString("N3")</td>
                                            <td class="text-muted">@row.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseImportModal">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" 
                            disabled="@(isSavingImport || !importedPreviewList.Any())" 
                            @onclick="ProcessAndSaveImportAsync">
                        @if (isSavingImport)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري تحديث الأرصدة...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check-circle"></i> تأكيد وتحديث الأرصدة في المخازن (@importedPreviewList.Count)</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public class StockBalanceItemDto
    {
        public long Id { get; set; }
        public long ItemId { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string ItemType { get; set; } = string.Empty;
        public string Unit { get; set; } = "كجم";
        public long WarehouseId { get; set; }
        public string WarehouseName { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public decimal ReservedQuantity { get; set; }
        public decimal AvailableQuantity { get; set; }
        public DateTime LastUpdatedAt { get; set; }
    }

    public class GroupedStockItemViewModel
    {
        public long ItemId { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string ItemType { get; set; } = string.Empty;
        public string Unit { get; set; } = "كجم";
        public decimal TotalQuantity { get; set; }
        public decimal TotalReserved { get; set; }
        public decimal TotalAvailable { get; set; }
        public List<StockBalanceItemDto> WarehouseBreakdowns { get; set; } = new();
    }

    public class WarehouseLookupDto
    {
        public long Id { get; set; }
        public string WarehouseName { get; set; } = string.Empty;
    }

    public class ItemLookupDto
    {
        public long Id { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string Unit { get; set; } = "كجم";
    }

    public class StockImportRowPreview
    {
        public long ItemId { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public long WarehouseId { get; set; }
        public string WarehouseName { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public string Notes { get; set; } = string.Empty;
    }

    private List<StockBalanceItemDto> rawBalances = new();
    private List<WarehouseLookupDto> warehouses = new();
    private List<ItemLookupDto> items = new();
    private List<StockImportRowPreview> importedPreviewList = new();

    private HashSet<long> expandedItemIds = new();
    private GroupedStockItemViewModel? selectedItemForModal = null;

    private string searchTerm = "";
    private long selectedWarehouseFilter = 0;
    private string selectedStatusFilter = "all";

    private bool isLoading = true;
    private bool isSavingImport = false;
    private bool isImportModalOpen = false;
    private string? statusMessage;
    private bool isSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        statusMessage = null;

        try
        {
            warehouses = await Http.GetFromJsonAsync<List<WarehouseLookupDto>>("api/warehouses") ?? new();
            if (!warehouses.Any())
            {
                warehouses = new List<WarehouseLookupDto>
                {
                    new WarehouseLookupDto { Id = 1, WarehouseName = "مخزن الخامات الرئيسي" },
                    new WarehouseLookupDto { Id = 2, WarehouseName = "مخزن التعبئة والتغليف" },
                    new WarehouseLookupDto { Id = 3, WarehouseName = "مخزن صالة الإنتاج" }
                };
            }

            try { items = await Http.GetFromJsonAsync<List<ItemLookupDto>>("api/items") ?? new(); } catch { }

            rawBalances = await Http.GetFromJsonAsync<List<StockBalanceItemDto>>("api/inventory/balances") ?? new();
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ في جلب بيانات الأرصدة: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<GroupedStockItemViewModel> GroupedItemBalances
    {
        get
        {
            return rawBalances
                .GroupBy(b => b.ItemId)
                .Select(g =>
                {
                    var first = g.First();
                    return new GroupedStockItemViewModel
                    {
                        ItemId = g.Key,
                        ItemCode = first.ItemCode,
                        ItemName = first.ItemName,
                        ItemType = first.ItemType,
                        Unit = first.Unit,
                        TotalQuantity = g.Sum(x => x.Quantity),
                        TotalReserved = g.Sum(x => x.ReservedQuantity),
                        TotalAvailable = g.Sum(x => x.AvailableQuantity),
                        WarehouseBreakdowns = g.ToList()
                    };
                })
                .OrderBy(x => x.ItemCode);
        }
    }

    private IEnumerable<GroupedStockItemViewModel> FilteredGroupedItems
    {
        get
        {
            var query = GroupedItemBalances.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(i =>
                    i.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    i.ItemCode.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedWarehouseFilter > 0)
            {
                query = query.Where(i => i.WarehouseBreakdowns.Any(w => w.WarehouseId == selectedWarehouseFilter));
            }

            if (selectedStatusFilter == "available")
                query = query.Where(i => i.TotalAvailable > 0);
            else if (selectedStatusFilter == "negative")
                query = query.Where(i => i.TotalAvailable <= 0);
            else if (selectedStatusFilter == "reserved")
                query = query.Where(i => i.TotalReserved > 0);

            return query;
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        selectedWarehouseFilter > 0 ||
        selectedStatusFilter != "all";

    private void ResetFilters()
    {
        searchTerm = "";
        selectedWarehouseFilter = 0;
        selectedStatusFilter = "all";
    }

