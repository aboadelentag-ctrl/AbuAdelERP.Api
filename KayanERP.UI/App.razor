<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>الصفحة غير موجودة - حلواني أبو عادل</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="container py-5 text-center" dir="rtl">
                <div class="card shadow-sm border-0 mx-auto p-5 rounded-3" style="max-width: 600px;">
                    <h1 class="display-1 fw-bold text-danger font-monospace">404</h1>
                    <h4 class="fw-bold text-dark mb-2">عذراً، الصفحة المطلوبة غير موجودة!</h4>
                    <a href="" class="btn btn-primary fw-bold px-4 py-2 shadow-sm">
                        🏠 العودة إلى لوحة التحكم الرئيسية
                    </a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>