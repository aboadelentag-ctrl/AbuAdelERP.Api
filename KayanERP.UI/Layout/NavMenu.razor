@using KayanERP.UI.Services
@implements IDisposable
@inject AppState State

<div class="top-row ps-3 navbar navbar-dark bg-dark border-bottom border-secondary">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2 m-0" href="">
            <span class="fs-4 text-warning">KayanERP</span>
        </a>
    </div>
</div>

<div class="nav-scrollable" dir="rtl" style="max-height: calc(100vh - 56px); overflow-y: auto;">
    <nav class="flex-column p-2">

        <!-- ==================================================== -->
        <!-- شريط البحث السريع والذكي في القائمة -->
        <!-- ==================================================== -->
        <div class="px-2 pt-1 pb-2 mb-2 border-bottom border-secondary border-opacity-50">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" 
                       placeholder="بحث سريع بالشاشات..." @bind="menuSearch" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(menuSearch))
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick='() => menuSearch = ""'>✕</button>
                }
            </div>
        </div>

        <!-- ==================================================== -->
        <!-- 1. الرئيسية ولوحات المؤشرات والـ KPIs -->
        <!-- ==================================================== -->
        @if (MatchesSearch("الرئيسية لوحة المؤشرات مؤشرات أداء الأقسام تقارير أرشيف"))
        {
            <AuthorizePermission Permission="Dashboard.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-speedometer2 me-2 text-info" aria-hidden="true"></span>
                        <span>الرئيسية (لوحة المؤشرات)</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Dashboard.View, DepartmentKPIS.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-info" href="department-kpis">
                        <span class="bi bi-graph-up-arrow me-2" aria-hidden="true"></span>
                        <span>مؤشرات أداء الأقسام (KPIs) 📈</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Reports.View, ReportsArchive.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="reports-archive">
                        <span class="bi bi-archive-fill me-2" aria-hidden="true"></span>
                        <span>أرشيف التقارير والسجلات 🗄️</span>
                    </NavLink>
                </div>
            </AuthorizePermission>
        }

        <!-- ==================================================== -->
        <!-- 2. العمليات الصناعية والتصنيع الموحد (MES Hub) -->
        <!-- ==================================================== -->
        @if (MatchesSearch("الإنتاج العمليات الصناعية غرفة عمليات التكاليف وصفات BOM طلب وصرف خامات كتالوج تسليم"))
        {
            <div class="nav-heading text-warning text-opacity-75 px-3 mt-3 mb-1 small fw-bold">
                ─── الإنتاج والعمليات الصناعية (MES) ───
            </div>

            <AuthorizePermission Permission="Production.OperationsHub, Production.OrdersView, Production.Execution, Productivity.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-warning fw-bold border border-warning border-opacity-25 bg-dark bg-opacity-50" href="production-operations-hub">
                        <span class="bi bi-cpu-fill me-2 text-warning" aria-hidden="true"></span>
                        <span>غرفة عمليات الإنتاج والتكاليف 🏭</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="BOM.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="recipes">
                        <span class="bi bi-journal-bookmark me-2" aria-hidden="true"></span>
                        <span>(BOM) وصفات التصنيع المعيارية</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Requisition.View, MaterialRequisition.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="material-requisitions">
                        <span class="bi bi-cart-check me-2" aria-hidden="true"></span>
                        <span>طلب وصرف خامات الصالة</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="FinishedGoods.Catalog, Warehouse.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="finished-goods-catalog">
                        <span class="bi bi-cake2-fill me-2 text-info" aria-hidden="true"></span>
                        <span>كتالوج المنتجات التامة 🎂</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="FinishedGoods.Transfer, Warehouse.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="finished-goods-transfer">
                        <span class="bi bi-truck-flatbed me-2" aria-hidden="true"></span>
                        <span>تحويل وتسليم المنتج التام 🚚</span>
                    </NavLink>
                </div>
            </AuthorizePermission>
        }

        <!-- ==================================================== -->
        <!-- 3. المبيعات والتوزيع والعملاء (Sales & Distribution) -->
        <!-- ==================================================== -->
        @if (MatchesSearch("المبيعات التوزيع فواتير سجل العملاء والمنافذ التجار الفروع"))
        {
            <div class="nav-heading text-success text-opacity-75 px-3 mt-3 mb-1 small fw-bold">
                ─── المبيعات والتوزيع والشجرة ───
            </div>

            <div class="nav-item px-2 mb-1">
                <NavLink class="nav-link rounded-2 text-success fw-bold border border-success border-opacity-25" href="customers">
                    <span class="bi bi-people-fill me-2 text-success" aria-hidden="true"></span>
                    <span>سجل العملاء والتجار والمنافذ 👥</span>
                </NavLink>
            </div>

            <div class="nav-item px-2 mb-1">
                <NavLink class="nav-link rounded-2 text-info" href="branches">
                    <span class="bi bi-shop me-2" aria-hidden="true"></span>
                    <span>إدارة الفروع ومنافذ التوزيع 🏢</span>
                </NavLink>
            </div>

            <div class="nav-item px-2 mb-1">
                <NavLink class="nav-link rounded-2 text-light" href="sales-invoices">
                    <span class="bi bi-receipt me-2" aria-hidden="true"></span>
                    <span>فواتير المبيعات اليومية 🧾</span>
                </NavLink>
            </div>
        }

        <!-- ==================================================== -->
        <!-- 4. المستودعات وسلاسل الإمداد وتتبع الأصول -->
        <!-- ==================================================== -->
        @if (MatchesSearch("المخازن المستودعات فحص استلام أرصدة كارت الصنف تحويلات الأسبات حوكمة الأصول تتبع الحاويات"))
        {
            <div class="nav-heading text-light text-opacity-50 px-3 mt-3 mb-1 small fw-bold">
                ─── المخازن واللوجستيات والأصول ───
            </div>

            <AuthorizePermission Permission="Warehouse.View, Dashboard.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="inventory-dashboard">
                        <span class="bi bi-grid-1x2-fill me-2" aria-hidden="true"></span>
                        <span>لوحة مؤشرات المخزون 🏬</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Receipt.Create, Receipt.QCAssess, MaterialReceipt.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="material-receipt">
                        <span class="bi bi-check2-square me-2" aria-hidden="true"></span>
                        <span>فحص واستلام الخامات (GMP)</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Warehouse.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="warehouses">
                        <span class="bi bi-house-door me-2" aria-hidden="true"></span>
                        <span>إدارة المخازن والمستودعات</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="StockCard.View, Warehouse.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="stock-card">
                        <span class="bi bi-card-list me-2" aria-hidden="true"></span>
                        <span>كارت الصنف وتتبع اللوطات</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Warehouse.View, StockBalances.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="stock-balances">
                        <span class="bi bi-boxes me-2" aria-hidden="true"></span>
                        <span>أرصدة المخازن اللحظية</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Transfers.View, StockTransfers.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="stock-transfers">
                        <span class="bi bi-arrow-left-right me-2" aria-hidden="true"></span>
                        <span>التحويلات وفض المنازعات ⚖️</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Crates.View, AssetTracking.View, FixedAssets.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-warning fw-bold" href="asset-management">
                        <span class="bi bi-basket3-fill me-2" aria-hidden="true"></span>
                        <span>حوكمة الأصول والماكينات والأسبات 🏭</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Crates.View, AssetTracking.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="crate-tracking">
                        <span class="bi bi-arrow-repeat me-2" aria-hidden="true"></span>
                        <span>تتبع دوران وحركة الحاويات 🔄</span>
                    </NavLink>
                </div>
            </AuthorizePermission>
        }

        <!-- ==================================================== -->
        <!-- 5. دليل الأصناف والمواد الشامل -->
        <!-- ==================================================== -->
        @if (MatchesSearch("الأصناف دليل المواد الهيكل الشجري تصنيفات"))
        {
            <div class="nav-heading text-light text-opacity-50 px-3 mt-3 mb-1 small fw-bold">
                ─── دليل الأصناف والمواد ───
            </div>

            <AuthorizePermission Permission="Items.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-warning" href="items">
                        <span class="bi bi-box-seam me-2" aria-hidden="true"></span>
                        <span>مركز إدارة الأصناف الشامل 📦</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Items.View, Categories.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="item-hierarchy">
                        <span class="bi bi-diagram-2 me-2" aria-hidden="true"></span>
                        <span>الهيكل الشجري للأصناف 🌳</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Categories.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="item-categories">
                        <span class="bi bi-tags me-2" aria-hidden="true"></span>
                        <span>تصنيفات الأصناف</span>
                    </NavLink>
                </div>
            </AuthorizePermission>
        }

        <!-- ==================================================== -->
        <!-- 6. المشتريات وإدارة الموردين والجودة -->
        <!-- ==================================================== -->
        @if (MatchesSearch("المشتريات الموردين أسعار التوريد أوامر الشراء PO فواتير تقييم جودة COA"))
        {
            <div class="nav-heading text-light text-opacity-50 px-3 mt-3 mb-1 small fw-bold">
                ─── المشتريات والموردين ───
            </div>

            <AuthorizePermission Permission="Suppliers.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="suppliers">
                        <span class="bi bi-truck me-2" aria-hidden="true"></span>
                        <span>إدارة الموردين</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="SupplierPrices.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="supplier-prices">
                        <span class="bi bi-tag me-2" aria-hidden="true"></span>
                        <span>قوائم أسعار التوريد</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="PurchaseOrders.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="purchase-orders">
                        <span class="bi bi-file-earmark-text me-2" aria-hidden="true"></span>
                        <span>(PO) أوامر الشراء</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="PurchaseInvoices.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="purchase-invoices">
                        <span class="bi bi-receipt me-2" aria-hidden="true"></span>
                        <span>فواتير الشراء والتسعير</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="SupplierQuality.View, Suppliers.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-success fw-bold" href="supplier-quality">
                        <span class="bi bi-patch-check-fill me-2" aria-hidden="true"></span>
                        <span>تقييم جودة الموردين (COA) 🛡</span>
                    </NavLink>
                </div>
            </AuthorizePermission>
        }
        <div class="nav-heading text-warning text-opacity-75 px-3 mt-3 mb-1 small fw-bold">
    ─── الإدارة المالية والحسابات العامة ───
</div>

<div class="nav-item px-2 mb-1">
    <NavLink class="nav-link rounded-2 text-warning fw-bold border border-warning border-opacity-25" href="chart-of-accounts">
        <span class="bi bi-bank2 me-2 text-warning" aria-hidden="true"></span>
        <span>شجرة الحسابات والمركز المالي 🏛️</span>
    </NavLink>
</div>
<div class="nav-item px-2 mb-1">
    <NavLink class="nav-link rounded-2 text-success fw-bold border border-success border-opacity-25" href="treasury-vouchers">
        <span class="bi bi-cash-coin me-2 text-success" aria-hidden="true"></span>
        <span>سندات القبض والصرف والخزائن 💵</span>
    </NavLink>
</div>
<div class="nav-item px-2 mb-1">
    <NavLink class="nav-link rounded-2 text-info fw-bold border border-info border-opacity-25" href="journal-entries">
        <span class="bi bi-book-half me-2 text-info" aria-hidden="true"></span>
        <span>دفتر قيود اليومية العامة 📖</span>
    </NavLink>
</div>
<div class="nav-item px-2 mb-1">
    <NavLink class="nav-link rounded-2 text-danger fw-bold border border-danger border-opacity-25" href="expenses-payables">
        <span class="bi bi-wallet2 me-2 text-danger" aria-hidden="true"></span>
        <span>الموردين والغاز ومصروفات التشغيل 🏭</span>
    </NavLink>
</div>
<div class="nav-item px-2 mb-1">
    <NavLink class="nav-link rounded-2 text-warning fw-bold border border-warning border-opacity-50" href="financial-statements">
        <span class="bi bi-graph-up me-2 text-warning" aria-hidden="true"></span>
        <span>القوائم المالية والأرباح والمركز المالي 📊</span>
    </NavLink>
</div>

        <!-- ==================================================== -->
        <!-- 7. منظومة النماذج ومحاضر الفحص الرقمية (HACCP) -->
        <!-- ==================================================== -->
        @if (MatchesSearch("النماذج محاضر الفحص مصمم النماذج تعبئة تقارير استجابات HACCP"))
        {
            <div class="nav-heading text-light text-opacity-50 px-3 mt-3 mb-1 small fw-bold">
                ─── النماذج ومحاضر الفحص الرقمية ───
            </div>

            <AuthorizePermission Permission="DynamicForms.Manage, DynamicForms.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-info fw-bold" href="dynamic-forms">
                        <span class="bi bi-ui-checks-grid me-2" aria-hidden="true"></span>
                        <span>مصمم وإدارة النماذج 📋</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="DynamicForms.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="form-viewer">
                        <span class="bi bi-pencil-fill me-2 text-warning" aria-hidden="true"></span>
                        <span>تعبئة نماذج الفحص الميداني ✍️</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="DynamicForms.Reports, DynamicForms.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="form-reports">
                        <span class="bi bi-file-earmark-spreadsheet-fill me-2 text-success" aria-hidden="true"></span>
                        <span>تقارير استجابات النماذج 📊</span>
                    </NavLink>
                </div>
            </AuthorizePermission>
        }

        <!-- ==================================================== -->
        <!-- 8. منظومة الطوارئ والتدخل السريع (SOS) -->
        <!-- ==================================================== -->
        @if (MatchesSearch("الطوارئ المهام الطارئة الأعطال SOS مؤشرات SLA"))
        {
            <div class="nav-heading text-danger text-opacity-75 px-3 mt-3 mb-1 small fw-bold">
                ─── الطوارئ والتدخل السريع (SOS) ───
            </div>

            <AuthorizePermission Permission="Emergency.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-danger fw-bold" href="emergency-tasks">
                        <span class="bi bi-bell-fill me-2" aria-hidden="true"></span>
                        <span>(SOS) المهام الطارئة والأعطال 🚨</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Emergency.Reports">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-warning fw-bold" href="emergency-tasks-reports">
                        <span class="bi bi-bar-chart-line-fill me-2" aria-hidden="true"></span>
                        <span>تقارير مؤشرات الطوارئ (SLA) 📊</span>
                    </NavLink>
                </div>
            </AuthorizePermission>
        }

        <!-- ==================================================== -->
        <!-- 9. الهيكل الإداري والموارد البشرية (HR) -->
        <!-- ==================================================== -->
        @if (MatchesSearch("الهيكل الإداري الشركات الكيانات الفروع الأقسام الصالات العاملين الورديات جدول"))
        {
            <div class="nav-heading text-light text-opacity-50 px-3 mt-3 mb-1 small fw-bold">
                ─── الهيكل الإداري (HR) ───
            </div>

            <AuthorizePermission Permission="Companies.Manage, Companies.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="companies">
                        <span class="bi bi-buildings me-2" aria-hidden="true"></span>
                        <span>إدارة الشركات والكيانات</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Departments.Manage, Departments.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="departments">
                        <span class="bi bi-diagram-3 me-2" aria-hidden="true"></span>
                        <span>إدارة الأقسام والصالات</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Employees.Manage, Employees.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2" href="employees">
                        <span class="bi bi-people me-2" aria-hidden="true"></span>
                        <span>سجل العاملين والورديات</span>
                    </NavLink>
                </div>
            </AuthorizePermission>

            <AuthorizePermission Permission="Employees.Manage, Employees.View">
                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-light" href="employees-management">
                        <span class="bi bi-person-gear me-2" aria-hidden="true"></span>
                        <span>توزيع وجدولة العمال 👥</span>
                    </NavLink>
                </div>
            </AuthorizePermission>
        }

        <!-- ==================================================== -->
        <!-- 10. أمن النظام والصلاحيات (RBAC) -->
        <!-- ==================================================== -->
        @if (MatchesSearch("أمن النظام الصلاحيات المستخدمين RBAC الأدوار"))
        {
            <AuthorizePermission Permission="Users.View">
                <div class="nav-heading text-light text-opacity-50 px-3 mt-3 mb-1 small fw-bold">
                    ─── أمن النظام والصلاحيات ───
                </div>

                <div class="nav-item px-2 mb-1">
                    <NavLink class="nav-link rounded-2 text-info fw-bold" href="users-management">
                        <span class="bi bi-shield-lock-fill me-2" aria-hidden="true"></span>
                        <span>المستخدمين والصلاحيات 🛡️</span>
                    </NavLink>
                </div>
            </AuthorizePermission>
        }

    </nav>
</div>

@code {
    private string menuSearch = "";

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private bool MatchesSearch(string sectionKeywords)
    {
        if (string.IsNullOrWhiteSpace(menuSearch)) return true;

        var term = menuSearch.Trim();
        return sectionKeywords.Contains(term, StringComparison.OrdinalIgnoreCase);
    }
}