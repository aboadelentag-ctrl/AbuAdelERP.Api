@page "/purchase-invoices"
@page "/purchase-orders"
@layout KayanERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using System.Text
@using KayanERP.UI.DTOs
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>أوامر وفواتير الشراء والتوريد - حلواني أبو عادل</PageTitle>

<div class="container-fluid py-4" dir="rtl">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-cart-check me-2"></i>أوامر وفواتير الشراء والتوريد
            </h3>
            <p class="text-muted small mb-0">إصدار أوامر الشراء، اعتماد فواتير الموردين، وتجهيز الشحنات للفحص المخزني (GMP)</p>
        </div>
        <div class="d-flex gap-2">
            @if (orders.Any())
            {
                <button class="btn btn-outline-success px-3 shadow-sm btn-sm fw-bold" @onclick="ExportOrdersToExcel">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير (Excel)
                </button>
            }
            <button class="btn btn-primary px-4 shadow-sm btn-sm fw-bold" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle me-1"></i> أمر شراء جديد
            </button>
            <button class="btn btn-outline-secondary px-3 btn-sm" @onclick="LoadOrders" disabled="@isLoading" title="تحديث">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- رسائل التنبيه -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm py-2 fw-bold" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@statusMessage
            <button type="button" class="btn-close py-2" @onclick="() => statusMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2 fw-bold" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close py-2" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- بطاقات الـ KPIs السريعة -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-primary">
                <span class="text-muted small fw-bold d-block">إجمالي أوامر الشراء</span>
                <h4 class="fw-bold text-dark mb-0 font-monospace mt-1">@orders.Count</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-warning">
                <span class="text-muted small fw-bold d-block">قيد المراجعة والاعتماد</span>
                <h4 class="fw-bold text-warning mb-0 font-monospace mt-1">@orders.Count(o => o.Status == "Pending_Procurement")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-success">
                <span class="text-muted small fw-bold d-block">فواتير معتمدة للتوريد</span>
                <h4 class="fw-bold text-success mb-0 font-monospace mt-1">@orders.Count(o => o.Status == "Approved" || o.Status == "Partially_Received")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-info">
                <span class="text-muted small fw-bold d-block">إجمالي القيمة المالية للمشتريات</span>
                <h4 class="fw-bold text-info mb-0 font-monospace mt-1">@orders.Sum(o => o.Lines.Sum(l => l.Quantity * l.UnitPrice)).ToString("N0") <span class="fs-6 text-muted">ج.م</span></h4>
            </div>
        </div>
    </div>

    <!-- فلاتر العرض والبحث -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 bg-light">
        <div class="card-body p-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="btn-group w-100" role="group">
                        <button type="button" class="btn btn-sm @(selectedStatus == null ? "btn-primary" : "btn-outline-primary") fw-bold" 
                                @onclick="() => FilterByStatus(null)">الكل (@orders.Count)</button>
                        <button type="button" class="btn btn-sm @(selectedStatus == "Pending_Procurement" ? "btn-warning" : "btn-outline-warning") fw-bold" 
                                @onclick='() => FilterByStatus("Pending_Procurement")'>قيد الاعتماد ⏳</button>
                        <button type="button" class="btn btn-sm @(selectedStatus == "Approved" ? "btn-success" : "btn-outline-success") fw-bold" 
                                @onclick='() => FilterByStatus("Approved")'>معتمد للتوريد ✅</button>
                        <button type="button" class="btn btn-sm @(selectedStatus == "Partially_Received" ? "btn-info" : "btn-outline-info") fw-bold" 
                                @onclick='() => FilterByStatus("Partially_Received")'>توريد جزئي 🚚</button>
                        <button type="button" class="btn btn-sm @(selectedStatus == "Closed" ? "btn-secondary" : "btn-outline-secondary") fw-bold" 
                                @onclick='() => FilterByStatus("Closed")'>مكتمل ومغلق 🔒</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <input type="text" class="form-control form-control-sm" placeholder="ابحث برقم الأمر، اسم المورد..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </div>

    <!-- جدول أوامر وفواتير الشراء -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2 mb-0">جاري تحميل أوامر الشراء...</p>
                </div>
            }
            else if (!FilteredOrders.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
                    لا توجد فواتير أو أوامر شراء مطابقة للبحث.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center small">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th>رقم الأمر / الفاتورة</th>
                                <th>التاريخ</th>
                                <th class="text-start ps-3">المورد</th>
                                <th>عدد البنود</th>
                                <th>إجمالي القيمة التقديرية</th>
                                <th>الحالة الرقابية</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in FilteredOrders)
                            {
                                var orderTotal = o.Lines.Sum(l => l.Quantity * l.UnitPrice);
                                <tr>
                                    <td class="fw-bold font-monospace text-primary">@o.OrderNumber</td>
                                    <td class="small text-muted font-monospace">@o.OrderDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-start ps-3 fw-bold text-dark">
                                        <i class="bi bi-building me-1 text-muted"></i>@o.SupplierName
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary font-monospace">@o.Lines.Count أصناف</span>
                                    </td>
                                    <td class="fw-bold fs-6 text-dark font-monospace">
                                        @orderTotal.ToString("N2") <span class="small text-muted fw-normal">ج.م</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadge(o.Status) px-2 py-1">
                                            @GetStatusLabel(o.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <button class="btn btn-sm btn-outline-info py-0 px-2 fw-bold" @onclick="() => OpenDetailsModal(o.Id)" title="عرض التفاصيل">
                                                <i class="bi bi-eye"></i> التفاصيل
                                            </button>
                                            @if (o.Status == "Pending_Procurement")
                                            {
                                                <button class="btn btn-sm btn-success py-0 px-2 fw-bold" @onclick="() => OpenApproveModal(o)" title="اعتماد الفاتورة والأسعار">
                                                    <i class="bi bi-check2-circle"></i> اعتماد
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal 1: إنشاء أمر شراء جديد -->
@if (showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" dir="rtl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-cart-plus me-2"></i>إنشاء أمر شراء وتوريد خامات
                    </h6>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body p-3 bg-light">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2 small mb-3 fw-bold">@modalError</div>
                    }

                    <div class="row g-2 mb-3 bg-white p-3 rounded-3 border">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-dark mb-1">المورد المعتمد <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm fw-bold border-primary" @bind="newOrder.SupplierId">
                                <option value="0">-- اختر المورد --</option>
                                @foreach (var s in lookups.Suppliers)
                                {
                                    <option value="@s.Id">@s.SupplierName (@s.SupplierCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-dark mb-1">مستودع الاستلام المستهدف <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm fw-bold border-primary" @bind="newOrder.WarehouseId">
                                <option value="0">-- اختر المستودع --</option>
                                @foreach (var w in lookups.Warehouses)
                                {
                                    <option value="@w.Id">@w.WarehouseName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-dark mb-1">تاريخ إصدار الطلب</label>
                            <input type="date" class="form-control form-control-sm font-monospace" @bind="newOrder.OrderDate" />
                        </div>
                    </div>

                    <!-- بنود الطلب -->
                    <div class="card border rounded-3 mb-3 bg-white">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                            <h6 class="mb-0 fw-bold text-dark">📋 بنود الخامات ومواد التعبئة المطلوبة</h6>
                            <button type="button" class="btn btn-sm btn-success fw-bold py-1 px-3 shadow-sm" @onclick="AddNewLine">
                                <i class="bi bi-plus-circle me-1"></i> إضافة بند خامة
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0 text-center small">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-start ps-3" style="width: 45%;">الصنف / الخامة</th>
                                            <th style="width: 20%;">الكمية المطلوبة</th>
                                            <th style="width: 20%;">سعر الوحدة التقديري</th>
                                            <th style="width: 15%;">الإجمالي</th>
                                            <th style="width: 10%;">إجراء</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!newOrder.Lines.Any())
                                        {
                                            <tr>
                                                <td colspan="5" class="py-4 text-muted fw-bold">انقر على "إضافة بند خامة" لإدراج الخامات في أمر الشراء.</td>
                                            </tr>
                                        }
                                        @foreach (var line in newOrder.Lines)
                                        {
                                            var itemTotal = line.Quantity * line.UnitPrice;
                                            <tr>
                                                <td class="text-start ps-3">
                                                    <select class="form-select form-select-sm fw-bold" @bind="line.ItemId" @bind:after="() => OnItemChanged(line)">
                                                        <option value="0">-- اختر الصنف --</option>
                                                        @foreach (var itm in lookups.Items)
                                                        {
                                                            <option value="@itm.Id">@itm.ItemName (@itm.ItemCode) - [@itm.CategoryName]</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="number" step="0.5" min="0.1" class="form-control form-control-sm text-center fw-bold font-monospace" @bind="line.Quantity" />
                                                </td>
                                                <td>
                                                    <input type="number" step="0.1" min="0" class="form-control form-control-sm text-center font-monospace" @bind="line.UnitPrice" />
                                                </td>
                                                <td class="fw-bold font-monospace text-primary">
                                                    @itemTotal.ToString("N2") ج.م
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => newOrder.Lines.Remove(line)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- إجماليات الطلب الحية -->
                    <div class="row justify-content-end text-end">
                        <div class="col-md-5">
                            <div class="bg-white p-3 rounded-3 border shadow-sm">
                                <div class="d-flex justify-content-between fs-6 fw-bold text-primary">
                                    <span>الإجمالي الكلي التقديري:</span>
                                    <span class="font-monospace">@newOrder.Lines.Sum(l => l.Quantity * l.UnitPrice).ToString("N2") ج.م</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => showCreateModal = false">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="SaveOrder" disabled="@isSaving">
                        @(isSaving ? "جاري الحفظ..." : "💾 حفظ وإصدار أمر الشراء")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 2: عرض تفاصيل أمر الشراء -->
@if (showDetailsModal && selectedOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered" dir="rtl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-file-earmark-text me-2"></i>تفاصيل أمر الشراء: @selectedOrder.OrderNumber
                    </h6>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="() => showDetailsModal = false"></button>
                </div>
                <div class="modal-body p-3 bg-light">
                    <div class="row g-2 mb-3 small bg-white p-3 rounded-3 border">
                        <div class="col-md-4"><strong>المورد:</strong> @selectedOrder.SupplierName</div>
                        <div class="col-md-4"><strong>التاريخ:</strong> @selectedOrder.OrderDate.ToString("yyyy-MM-dd")</div>
                        <div class="col-md-4"><strong>الحالة:</strong> <span class="badge @GetStatusBadge(selectedOrder.Status)">@GetStatusLabel(selectedOrder.Status)</span></div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center mb-0 small bg-white">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start ps-3">الصنف</th>
                                    <th>الكمية المطلوبة</th>
                                    <th>سعر الوحدة</th>
                                    <th>المستلم مخزنياً</th>
                                    <th>الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedOrder.Lines)
                                {
                                    <tr>
                                        <td class="text-start ps-3 fw-bold">
                                            @line.ItemName
                                            <div class="small text-muted font-monospace">@line.ItemCode</div>
                                        </td>
                                        <td class="fw-bold font-monospace">@line.Quantity.ToString("N1") @line.Unit</td>
                                        <td class="font-monospace">@line.UnitPrice.ToString("N2") ج.م</td>
                                        <td class="text-success fw-bold font-monospace">
                                            @(line.ReceivedQuantity > 0 ? $"{line.ReceivedQuantity:N1} {line.Unit}" : "---")
                                        </td>
                                        <td class="fw-bold font-monospace text-primary">
                                            @((line.Quantity * line.UnitPrice).ToString("N2")) ج.م
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-white py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => showDetailsModal = false">إغلاق</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 3: اعتماد أمر الشراء والفاتورة -->
@if (showApproveModal && approveModel != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-lg modal-dialog-centered" dir="rtl">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-check2-all me-2"></i>اعتماد الفاتورة وتثبيت أسعار التوريد النهائية
                    </h6>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="() => showApproveModal = false"></button>
                </div>
                <div class="modal-body p-3 bg-light">
                    <div class="alert alert-info py-2 small mb-3">
                        مراجعة الأسعار المعتمدة مع المورد لترحيل أمر الشراء مباشرة إلى محطة <strong>فحص الجودة واستلام الخامات (GMP)</strong>:
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle text-center mb-0 small bg-white">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start ps-3">الصنف</th>
                                    <th>الكمية المعتمدة</th>
                                    <th>سعر الوحدة النهائي</th>
                                    <th>ملاحظات الاعتماد</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in approveModel.Lines)
                                {
                                    var itemInfo = lookups.Items.FirstOrDefault(i => i.Id == line.ItemId);
                                    <tr>
                                        <td class="text-start ps-3 fw-bold">@(itemInfo?.ItemName ?? $"صنف {line.ItemId}")</td>
                                        <td>
                                            <input type="number" step="0.5" class="form-control form-control-sm text-center fw-bold font-monospace" @bind="line.Quantity" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.1" class="form-control form-control-sm text-center fw-bold text-success font-monospace" @bind="line.UnitPrice" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" placeholder="ملاحظة أو اتفاق خاص..." @bind="line.Notes" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="() => showApproveModal = false">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="SubmitApproval" disabled="@isSaving">
                        ✓ تأكيد الاعتماد وترحيل الأمر لمحطة الاستلام
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PurchaseOrderDto> orders = new();
    private PurchaseOrderLookupsDto lookups = new();
    private PurchaseOrderDto? selectedOrder;
    private PurchaseOrderCreateDto newOrder = new();
    private PoApproveDto? approveModel;

    private string? selectedStatus;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? statusMessage;
    private string? errorMessage;
    private string? modalError;

    private bool showCreateModal = false;
    private bool showDetailsModal = false;
    private bool showApproveModal = false;

    private IEnumerable<PurchaseOrderDto> FilteredOrders =>
        orders.Where(o =>
        {
            if (!string.IsNullOrEmpty(selectedStatus) && o.Status != selectedStatus)
                return false;

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                return (o.OrderNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (o.SupplierName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
            }

            return true;
        });

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadOrders();
    }

    private async Task LoadLookups()
    {
        try
        {
            lookups = await Http.GetFromJsonAsync<PurchaseOrderLookupsDto>("api/purchaseorders/lookups") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lookups: {ex.Message}");
        }
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            orders = await Http.GetFromJsonAsync<List<PurchaseOrderDto>>("api/purchaseorders") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب أوامر الشراء: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterByStatus(string? status)
    {
        selectedStatus = status;
    }

    private void OpenCreateModal()
    {
        newOrder = new PurchaseOrderCreateDto
        {
            OrderDate = DateTime.Today,
            SupplierId = lookups.Suppliers.FirstOrDefault()?.Id ?? 0,
            WarehouseId = lookups.Warehouses.FirstOrDefault()?.Id ?? 0,
            Lines = new List<PurchaseOrderCreateLineDto>()
        };
        modalError = null;
        showCreateModal = true;
    }

    private void AddNewLine()
    {
        newOrder.Lines.Add(new PurchaseOrderCreateLineDto
        {
            Quantity = 1,
            UnitPrice = 0
        });
    }

    private void OnItemChanged(PurchaseOrderCreateLineDto line)
    {
        if (line.ItemId <= 0) return;
        var item = lookups.Items.FirstOrDefault(i => i.Id == line.ItemId);
        if (item != null)
        {
            line.UnitPrice = item.BasePrice;
        }
    }

    private async Task SaveOrder()
    {
        if (newOrder.SupplierId <= 0 || newOrder.WarehouseId <= 0)
        {
            modalError = "يرجى تحديد المورد ومستودع الاستلام.";
            return;
        }
        if (!newOrder.Lines.Any(l => l.ItemId > 0 && l.Quantity > 0))
        {
            modalError = "يجب إضافة صنف واحد على الأقل بكمية صالحة.";
            return;
        }

        isSaving = true;
        modalError = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/purchaseorders", newOrder);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = "تم إنشاء أمر الشراء بنجاح وهو الآن قيد المراجعة والاعتماد.";
                showCreateModal = false;
                await LoadOrders();
            }
            else
            {
                modalError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            modalError = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OpenDetailsModal(long id)
    {
        try
        {
            selectedOrder = await Http.GetFromJsonAsync<PurchaseOrderDto>($"api/purchaseorders/{id}");
            showDetailsModal = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب تفاصيل الأمر: {ex.Message}";
        }
    }

    private void OpenApproveModal(PurchaseOrderDto order)
    {
        approveModel = new PoApproveDto
        {
            OrderId = order.Id,
            Status = "Approved",
            Lines = order.Lines.Select(l => new PoApproveLineDto
            {
                LineId = l.Id,
                ItemId = l.ItemId,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                Notes = l.Notes
            }).ToList()
        };
        showApproveModal = true;
    }

    private async Task SubmitApproval()
    {
        if (approveModel == null) return;

        isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/purchaseorders/approve-invoice", approveModel);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = "تم اعتماد أمر الشراء والفاتورة بنجاح، وتم ترحيله لمحطة فحص الجودة والاستلام المخزني.";
                showApproveModal = false;
                await LoadOrders();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في الاعتماد: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ExportOrdersToExcel()
    {
        var list = FilteredOrders.ToList();
        if (!list.Any()) return;

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("رقم_الأمر,التاريخ,المورد,عدد_البنود,القيمة_الإجمالية,الحالة");

            foreach (var o in list)
            {
                var total = o.Lines.Sum(l => l.Quantity * l.UnitPrice);
                sb.AppendLine($"\"{o.OrderNumber}\",\"{o.OrderDate:yyyy-MM-dd}\",\"{o.SupplierName}\",{o.Lines.Count},{total:F2},\"{GetStatusLabel(o.Status)}\"");
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"أوامر_وفواتير_الشراء_{DateTime.Now:yyyyMMdd_HHmm}.csv";

            var js = $@"
                const link = document.createElement('a');
                link.href = 'data:text/csv;charset=utf-8;base64,{base64}';
                link.download = '{fileName}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ";
            await JS.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل التصدير: {ex.Message}";
        }
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Pending_Procurement" => "bg-warning text-dark",
        "Approved" => "bg-success text-white",
        "Partially_Received" => "bg-info text-dark",
        "Closed" => "bg-secondary text-white",
        "Rejected" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "Pending_Procurement" => "قيد الاعتماد ⏳",
        "Approved" => "معتمد للتوريد ✅",
        "Partially_Received" => "توريد جزئي 🚚",
        "Closed" => "مكتمل التوريد 🔒",
        "Rejected" => "مرفوض فني ❌",
        _ => status
    };
}