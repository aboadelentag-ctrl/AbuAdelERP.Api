    // ========================================================
    // تصدير سجل أذونات تحويل المنتج التام إلى ملف Excel (CSV)
    // ========================================================
    private async Task ExportTransfersToCsv()
    {
        if (transfers == null || !transfers.Any())
        {
            alertMessage = "لا توجد أذونات لتصديرها.";
            isSuccess = false;
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("رقم_الإذن,التاريخ,الصنف,كود_الصنف,رقم_اللوط,تاريخ_الصلاحية,صالة_المصدر,مخزن_الكنترول,تسليم_الصالة_وزن,تسليم_الصالة_صاج,ميزان_التكاليف_وزن,ميزان_التكاليف_صاج,صافي_مقبول_الجودة,عينات_الجودة,مرتجع_تعديل_الصالة,تالف_جودة,مستلم_الكنترول_وزن,مستلم_الكنترول_صاج,الحالة_الرقابية,ملاحظات_التسليم");

            foreach (var t in transfers)
            {
                var expDate = t.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-";
                var notes = (t.ProdNotes ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");
                var statusText = TranslateStatus(t.Status);

                sb.AppendLine($"{EscapeCsv(t.TransferNumber)},{t.TransferDate:yyyy-MM-dd},{EscapeCsv(t.ItemName)},{EscapeCsv(t.ItemCode)},{EscapeCsv(t.BatchNumber)},{expDate},{EscapeCsv(t.SourceWarehouseName)},{EscapeCsv(t.DestinationWarehouseName)},{t.ProdDispatchedQty:F2},{t.ProdDispatchedCount},{t.CostingActualQty ?? 0:F2},{t.CostingActualCount ?? 0},{t.QcApprovedQty:F2},{t.QcSampleQty:F2},{t.QcReworkQty:F2},{t.QcScrapQty:F2},{t.ReceivedActualQty ?? 0:F2},{t.ReceivedActualCount ?? 0},{EscapeCsv(statusText)},{EscapeCsv(notes)}");
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"سجل_تحويلات_المنتج_التام_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            var js = $"const a = document.createElement('a'); a.href = 'data:text/csv;base64,{base64}'; a.download = '{fileName}'; document.body.appendChild(a); a.click(); document.body.removeChild(a);";
            await JS.InvokeVoidAsync("eval", js);

            alertMessage = $"✅ تم تصدير بيانات ({transfers.Count}) إذن تحويل إلى Excel بنجاح.";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            alertMessage = $"❌ فشل التصدير: {ex.Message}";
            isSuccess = false;
        }
    }

    private string TranslateStatus(string? status) => status switch
    {
        "PENDING_COSTING" => "1. بانتظار ميزان التكاليف",
        "DISPUTE_COSTING" => "🚨 نزاع: إنتاج وتكاليف",
        "PENDING_QC" => "2. بانتظار فحص الجودة",
        "PENDING_RECEIPT" => "3. بانتظار استلام الكنترول",
        "IN_DISPUTE" => "🚨 نزاع: جودة وكنترول",
        "REWORK_IN_PRODUCTION" => "🔄 قيد التعديل بالصالة",
        "COMPLETED" => "✓ تم الاستلام والترصيد",
        _ => status ?? "غير محدد"
    };

    private string EscapeCsv(string val)
    {
        if (string.IsNullOrEmpty(val)) return "";
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n") || val.Contains("\r"))
            return $"\"{val.Replace("\"", "\"\"")}\"";
        return val;
    }
