@using KayanERP.UI.Services
@inject AppState State

@if (IsAuthorized)
{
    @ChildContent
}
else if (RenderDisabled && ChildContent != null)
{
    <span class="d-inline-block text-muted opacity-50" title="ليس لديك صلاحية لهذا الإجراء (@Permission)" style="cursor: not-allowed;">
        @ChildContent
    </span>
}

@code {
    [Parameter] public string Permission { get; set; } = string.Empty;
    [Parameter] public bool RenderDisabled { get; set; } = false; // لو true يظهر الزر معطلاً بدلاً من إخفائه
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsAuthorized => State.HasPermission(Permission);
}