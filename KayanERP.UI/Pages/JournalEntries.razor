@page "/journal-entries"
@page "/finance/journal"
@layout KayanERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>دفتر قيود اليومية العامة - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">
    <!-- رأس الشاشة المالي -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h4 class="text-primary m-0 mb-1 fw-bold">📖 دفتر قيود اليومية العامة ومحرك الترحيل (Journal Hub)</h4>
            <span class="text-muted small">استعراض القيود المحاسبية المتولدة آلياً من دورات التشغيل والتوزيع وإثبات التسويات اليدوية</span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm fw-bold shadow-sm px-3" @onclick="LoadEntriesAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> تحديث القيود
            </button>
            <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenNewEntryModal">
                ➕ إنشاء قيد تسوية يدوي
            </button>
        </div>
    </div>

    <!-- بطاقات المؤشرات المالية للقيود -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي القيود المسجلة</small>
                <h4 class="mb-0 fw-bold text-primary mt-1 font-monospace">@entriesList.Count قيد</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3 bg-white">
                <small class="text-muted fw-bold">حجم التداول المحاسبي المتزن</small>
                <h4 class="mb-0 fw-bold text-success mt-1 font-monospace">@totalDebitVolume.ToString("N0") ج.م</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-info border-4 p-3 bg-white">
                <small class="text-muted fw-bold">قيود آلية من دورات التشغيل</small>
                <h4 class="mb-0 fw-bold text-info mt-1 font-monospace">
                    @entriesList.Count(e => e.ReferenceType != "MANUAL") قيد آلي
                </h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 p-3 bg-white">
                <small class="text-muted fw-bold">حالة توازن الدفتر العام</small>
                <h4 class="mb-0 fw-bold text-dark mt-1 font-monospace">
                    متزن 100% ✓
                </h4>
            </div>
        </div>
    </div>

    <!-- شريط الفلاتر والبحث السريع -->
    <div class="card shadow-sm border-0 mb-3 bg-white">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="ابحث برقم القيد، البيان، أو اسم الحساب..." @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm fw-bold border-primary" @bind="selectedSourceFilter">
                        <option value="">-- كافة مصادر القيود --</option>
                        <option value="SALES_INVOICE">فواتير مبيعات التوزيع</option>
                        <option value="RECEIPT_VOUCHER">سندات تحصيل الخزينة</option>
                        <option value="MATERIAL_REQUISITION">صرف خامات الصالات (MES)</option>
                        <option value="MANUAL">قيود تسوية يدوية</option>
                    </select>
                </div>
                <div class="col-md-5 text-md-end text-muted small">
                    القيود المطابقة: <strong class="text-primary font-monospace">@FilteredEntries.Count()</strong> قيد
                </div>
            </div>
        </div>
    </div>

    <!-- جدول عرض القيود اليومية مع التفاصيل المزدوجة -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered mb-0 align-middle small">
                <thead class="table-dark text-center">
                    <tr>
                        <th style="width: 120px;">رقم القيد</th>
                        <th style="width: 100px;">التاريخ</th>
                        <th>مصدر القيد والمرجع</th>
                        <th class="text-start ps-3">البيان والشرح العام</th>
                        <th>الفرع التابع</th>
                        <th>إجمالي القيد</th>
                        <th>الحالة</th>
                        <th style="width: 100px;">الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredEntries.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4 fw-bold">لا توجد قيود يومية مطابقة للبحث.</td></tr>
                    }
                    else
                    {
                        @foreach (var entry in FilteredEntries)
                        {
                            <tr class="text-center">
                                <td class="font-monospace fw-bold text-primary">@entry.EntryNumber</td>
                                <td class="font-monospace">@entry.EntryDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge @GetSourceBadge(entry.ReferenceType)">
                                        @GetSourceArabic(entry.ReferenceType)
                                    </span>
                                    @if (!string.IsNullOrEmpty(entry.ReferenceNumber))
                                    {
                                        <small class="d-block font-monospace text-muted">@entry.ReferenceNumber</small>
                                    }
                                </td>
                                <td class="text-start ps-3 fw-bold text-dark">@entry.Description</td>
                                <td><span class="badge bg-light text-dark border">@entry.BranchName</span></td>
                                <td class="font-monospace fw-bold text-success fs-6">
                                    @entry.TotalDebit.ToString("N0") ج.م
                                </td>
                                <td><span class="badge bg-success px-2 py-1">مرحل ومعتمد ✓</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary py-0 px-2 fw-bold" @onclick="() => ViewEntryDetails(entry)">
                                        👁️ فحص الأطراف
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- مودال فحص أطراف القيد المحاسبي -->
@if (isDetailsModalOpen && selectedEntry != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        🔍 تفاصيل القيد المزدوج: @selectedEntry.EntryNumber
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isDetailsModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <div class="card p-3 border-0 shadow-sm bg-white mb-3">
                        <div class="row g-2 small">
                            <div class="col-md-4"><strong>التاريخ:</strong> @selectedEntry.EntryDate.ToString("yyyy-MM-dd")</div>
                            <div class="col-md-4"><strong>الفرع:</strong> @selectedEntry.BranchName</div>
                            <div class="col-md-4"><strong>المصدر:</strong> @GetSourceArabic(selectedEntry.ReferenceType)</div>
                            <div class="col-12 mt-2"><strong>البيان:</strong> @selectedEntry.Description</div>
                        </div>
                    </div>

                    <div class="card p-0 border-0 shadow-sm bg-white overflow-hidden">
                        <table class="table table-bordered text-center align-middle small mb-0 font-monospace">
                            <thead class="table-light">
                                <tr>
                                    <th>رقم الحساب</th>
                                    <th class="text-start ps-3">اسم الحساب في الدليل</th>
                                    <th>مدين (Debit)</th>
                                    <th>دائن (Credit)</th>
                                    <th>الشرح التحليلي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedEntry.Lines)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@line.AccountCode</td>
                                        <td class="text-start ps-3 fw-bold text-dark font-sans-serif">@line.AccountName</td>
                                        <td class="fw-bold text-success">@(line.Debit > 0 ? line.Debit.ToString("N0") : "-")</td>
                                        <td class="fw-bold text-danger">@(line.Credit > 0 ? line.Credit.ToString("N0") : "-")</td>
                                        <td class="text-muted font-sans-serif small">@line.Memo</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-secondary fw-bold">
                                <tr>
                                    <td colspan="2" class="text-start ps-3">الإجمالي المتزن</td>
                                    <td class="text-success">@selectedEntry.TotalDebit.ToString("N0") ج.م</td>
                                    <td class="text-danger">@selectedEntry.TotalCredit.ToString("N0") ج.م</td>
                                    <td><span class="badge bg-success">متزن ✓</span></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isDetailsModalOpen = false">إغلاق</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال إنشاء قيد تسوية يدوي بأسطر متغيرة وقاعدة اتزان صارمة -->
@if (isNewModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">➕ إنشاء قيد تسوية محاسبي يدوي متزن</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isNewModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3 fw-bold">@errorMessage</div>
                    }

                    <div class="card p-3 border-0 shadow-sm bg-white mb-3">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">تاريخ القيد *</label>
                                <input type="date" class="form-control form-control-sm font-monospace fw-bold" @bind="newEntry.EntryDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">الفرع التابع</label>
                                <select class="form-select form-select-sm fw-bold" @bind="newEntry.BranchName">
                                    <option value="المركز الرئيسي (المصنع)">المركز الرئيسي (المصنع)</option>
                                    <option value="فرع المبيعات الخارجية والتوزيع">فرع المبيعات الخارجية والتوزيع</option>
                                    <option value="فرع وسط البلد">فرع وسط البلد</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">رقم المستند المرجعي (إن وجد)</label>
                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="مثال: تسوية-جرد-01" @bind="newEntry.ReferenceNumber" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">البيان والشرح العام للقيد *</label>
                                <input type="text" class="form-control form-control-sm fw-bold" placeholder="مثال: تسوية فروق الجرد الدوري لمخزن الخامات..." @bind="newEntry.Description" />
                            </div>
                        </div>
                    </div>

                    <!-- جدول أسطر القيد الديناميكية -->
                    <div class="card p-3 border-0 shadow-sm bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="m-0 fw-bold small text-dark">📋 أطراف القيد (المدين والدائن):</h6>
                            <button class="btn btn-outline-primary btn-sm py-1 px-3 fw-bold" @onclick="AddLine">
                                ➕ إضافة طرف جديد
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered text-center align-middle small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 140px;">كود الحساب</th>
                                        <th style="width: 250px;">اسم الحساب</th>
                                        <th style="width: 150px;">مدين (Debit)</th>
                                        <th style="width: 150px;">دائن (Credit)</th>
                                        <th>الشرح والبيان التحليلي</th>
                                        <th style="width: 50px;">حذف</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in newEntry.Lines)
                                    {
                                        <tr>
                                            <td>
                                                <input type="text" class="form-control form-control-sm font-monospace text-center fw-bold" @bind="line.AccountCode" placeholder="كود الحساب" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm fw-bold" @bind="line.AccountName" placeholder="اسم الحساب المالي" />
                                            </td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm font-monospace text-success fw-bold text-center" @bind="line.Debit" />
                                            </td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm font-monospace text-danger fw-bold text-center" @bind="line.Credit" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="line.Memo" placeholder="ملاحظات السطر" />
                                            </td>
                                            <td>
                                                @if (newEntry.Lines.Count > 2)
                                                {
                                                    <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => RemoveLine(line)">✕</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-bold font-monospace">
                                    <tr>
                                        <td colspan="2" class="text-start ps-3">الإجماليات والفارق:</td>
                                        <td class="text-success fs-6">@newEntryTotalDebit.ToString("N0")</td>
                                        <td class="text-danger fs-6">@newEntryTotalCredit.ToString("N0")</td>
                                        <td>
                                            @if (newEntryTotalDebit == newEntryTotalCredit && newEntryTotalDebit > 0)
                                            {
                                                <span class="badge bg-success">متزن وجاهز للاعتماد ✓</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">فارق عدم اتزان: @Math.Abs(newEntryTotalDebit - newEntryTotalCredit).ToString("N0") ج.م</span>
                                            }
                                        </td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-4" @onclick="() => isNewModalOpen = false">إلغاء</button>
                    <button class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" @onclick="SaveNewEntryAsync" disabled="@(newEntryTotalDebit != newEntryTotalCredit || newEntryTotalDebit <= 0)">
                        💾 ترحيل واعتماد القيد
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<JournalEntryViewDto> entriesList = new();
    private string searchTerm = "";
    private string selectedSourceFilter = "";
    private decimal totalDebitVolume = 0;

    private bool isDetailsModalOpen = false;
    private JournalEntryViewDto? selectedEntry;

    private bool isNewModalOpen = false;
    private JournalEntryViewDto newEntry = new();
    private string errorMessage = "";

    private decimal newEntryTotalDebit => newEntry.Lines.Sum(l => l.Debit);
    private decimal newEntryTotalCredit => newEntry.Lines.Sum(l => l.Credit);

    protected override async Task OnInitializedAsync()
    {
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        try
        {
            entriesList = await Http.GetFromJsonAsync<List<JournalEntryViewDto>>("api/JournalEntries") ?? new();
            totalDebitVolume = entriesList.SelectMany(e => e.Lines).Sum(l => l.Debit);
        }
        catch { }
    }

    private IEnumerable<JournalEntryViewDto> FilteredEntries => entriesList.Where(e =>
        (string.IsNullOrEmpty(selectedSourceFilter) || e.ReferenceType == selectedSourceFilter) &&
        (string.IsNullOrWhiteSpace(searchTerm) ||
         e.EntryNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
         e.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
         e.Lines.Any(l => l.AccountName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
    );

    private void ViewEntryDetails(JournalEntryViewDto entry)
    {
        selectedEntry = entry;
        isDetailsModalOpen = true;
    }

    private void OpenNewEntryModal()
    {
        errorMessage = "";
        newEntry = new JournalEntryViewDto
        {
            EntryDate = DateTime.Today,
            BranchName = "المركز الرئيسي (المصنع)",
            ReferenceType = "MANUAL",
            Lines = new List<JournalEntryLineViewDto>
            {
                new() { AccountCode = "54", AccountName = "هالك تشغيل غير طبيعي", Debit = 0, Credit = 0 },
                new() { AccountCode = "1231", AccountName = "مخزن المواد الخام والتعبئة", Debit = 0, Credit = 0 }
            }
        };
        isNewModalOpen = true;
    }

    private void AddLine()
    {
        newEntry.Lines.Add(new JournalEntryLineViewDto());
    }

    private void RemoveLine(JournalEntryLineViewDto line)
    {
        if (newEntry.Lines.Count > 2)
        {
            newEntry.Lines.Remove(line);
        }
    }

    private async Task SaveNewEntryAsync()
    {
        if (string.IsNullOrWhiteSpace(newEntry.Description))
        {
            errorMessage = "⚠️ يرجى إدخال بيان وشرح القيد.";
            return;
        }

        if (newEntryTotalDebit != newEntryTotalCredit || newEntryTotalDebit <= 0)
        {
            errorMessage = "⚠️ لا يمكن حفظ قيد غير متزن.";
            return;
        }

        try
        {
            var res = await Http.PostAsJsonAsync("api/JournalEntries", newEntry);
            if (res.IsSuccessStatusCode)
            {
                isNewModalOpen = false;
                await LoadEntriesAsync();
            }
            else
            {
                errorMessage = await res.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ: {ex.Message}";
        }
    }

    private string GetSourceBadge(string refType) => refType switch
    {
        "SALES_INVOICE" => "bg-primary text-white",
        "RECEIPT_VOUCHER" => "bg-success text-white",
        "MATERIAL_REQUISITION" => "bg-warning text-dark",
        _ => "bg-secondary text-white"
    };

    private string GetSourceArabic(string refType) => refType switch
    {
        "SALES_INVOICE" => "فاتورة مبيعات",
        "RECEIPT_VOUCHER" => "تحصيل خزينة",
        "MATERIAL_REQUISITION" => "صرف خامات MES",
        _ => "تسوية يدوية"
    };

    public class JournalEntryViewDto
    {
        public long Id { get; set; }
        public string EntryNumber { get; set; } = string.Empty;
        public DateTime EntryDate { get; set; } = DateTime.Today;
        public string Description { get; set; } = string.Empty;
        public string ReferenceType { get; set; } = "MANUAL";
        public string? ReferenceNumber { get; set; }
        public string BranchName { get; set; } = string.Empty;
        public bool IsPosted { get; set; } = true;
        public decimal TotalDebit => Lines?.Sum(l => l.Debit) ?? 0;
        public decimal TotalCredit => Lines?.Sum(l => l.Credit) ?? 0;
        public List<JournalEntryLineViewDto> Lines { get; set; } = new();
    }

    public class JournalEntryLineViewDto
    {
        public long Id { get; set; }
        public string AccountCode { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public decimal Debit { get; set; } = 0;
        public decimal Credit { get; set; } = 0;
        public string? CostCenterName { get; set; }
        public string? Memo { get; set; }
    }
}