@page "/material-receipt"
@layout KayanERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using System.Text
@using KayanERP.UI.DTOs
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>فحص الجودة واستلام الخامات الموردة (GMP) - حلواني أبو عادل</PageTitle>

<div class="container-fluid py-4" dir="rtl">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-shield-check me-2"></i>فحص الجودة واستلام الخامات الموردة (GMP)
            </h3>
            <p class="text-muted small mb-0">مطابقة الشحنات الموردة، توثيق شهادات التحليل (COA)، تسجيل أرقام اللوطات والصلاحيات، وترحيل الأرصدة</p>
        </div>
        <div class="d-flex gap-2">
            @if (pendingInvoices.Any())
            {
                <button class="btn btn-outline-success px-3 shadow-sm btn-sm fw-bold" @onclick="ExportPendingToExcel">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير (Excel)
                </button>
            }
            <button class="btn btn-outline-primary px-3 shadow-sm btn-sm fw-bold" @onclick="LoadData" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i> تحديث الفواتير المنتظرة
            </button>
        </div>
    </div>

    <!-- رسائل التنبيه -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm py-2 fw-bold" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@statusMessage
            <button type="button" class="btn-close py-2" @onclick="() => statusMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2 fw-bold" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close py-2" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- بطاقات الإحصائيات -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-warning">
                <span class="text-muted small fw-bold d-block">شحنات معتمدة في انتظار الفحص</span>
                <h4 class="fw-bold text-warning mb-0 font-monospace mt-1">@pendingInvoices.Count</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-info">
                <span class="text-muted small fw-bold d-block">إجمالي بنود الخامات المطلوب استلامها</span>
                <h4 class="fw-bold text-info mb-0 font-monospace mt-1">@pendingInvoices.Sum(p => p.Lines.Count)</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-success">
                <span class="text-muted small fw-bold d-block">مستودعات الخامات الجاهزة للاستقبال</span>
                <h4 class="fw-bold text-success mb-0 font-monospace mt-1">@lookups.Warehouses.Count</h4>
            </div>
        </div>
    </div>

    <!-- شريط الفلترة والبحث -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 bg-light">
        <div class="card-body p-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <select class="form-select form-select-sm fw-bold border-primary" @bind="selectedSupplierId" @bind:after="LoadInvoices">
                        <option value="0">كافة الموردين</option>
                        @foreach (var s in lookups.Suppliers)
                        {
                            <option value="@s.Id">@s.SupplierName</option>
                        }
                    </select>
                </div>
                <div class="col-md-7">
                    <input type="text" class="form-control form-control-sm" placeholder="ابحث برقم أمر الشراء، اسم المورد..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </div>

    <!-- جدول أوامر الشراء المعتمدة الجاهزة للاستلام -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2 mb-0">جاري فحص وتحديث أوامر الشراء الجاهزة للاستلام...</p>
                </div>
            }
            else if (!FilteredInvoices.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                    لا توجد شحنات معتمدة في انتظار الاستلام والفحص حالياً.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center small">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th>رقم أمر الشراء</th>
                                <th>تاريخ الأمر</th>
                                <th class="text-start ps-3">اسم المورد</th>
                                <th>عدد البنود المتبقية</th>
                                <th>إجمالي القيمة</th>
                                <th>الحالة</th>
                                <th>الإجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in FilteredInvoices)
                            {
                                <tr>
                                    <td class="fw-bold font-monospace text-primary">@inv.OrderNumber</td>
                                    <td class="small text-muted font-monospace">@inv.OrderDate</td>
                                    <td class="text-start ps-3 fw-bold text-dark">
                                        <i class="bi bi-truck me-1 text-muted"></i>@inv.SupplierName
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary font-monospace">@inv.Lines.Count بنود</span>
                                    </td>
                                    <td class="fw-bold text-dark font-monospace">
                                        @inv.TotalAmount.ToString("N2") ج.م
                                    </td>
                                    <td>
                                        <span class="badge @(inv.Status == "Approved" ? "bg-warning text-dark" : "bg-info text-dark")">
                                            @(inv.Status == "Approved" ? "جاهز للتوريد" : "توريد جزئي")
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-success px-3 shadow-sm fw-bold" @onclick="() => OpenInspectionModal(inv)">
                                            <i class="bi bi-clipboard2-check me-1"></i> فحص واستلام مخزني
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: محضر الفحص الفني والاستلام المخزني -->
@if (showInspectionModal && selectedInvoice != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.55);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" dir="rtl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-clipboard2-pulse me-2"></i>محضر استلام وفحص جودة أمر الشراء: @selectedInvoice.OrderNumber
                    </h6>
                    <button type="button" class="btn-close btn-close-white ms-0 me-auto" @onclick="() => showInspectionModal = false"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2 small mb-3 fw-bold">@modalError</div>
                    }

                    <!-- بيانات محضر الاستلام والـ QC -->
                    <div class="row g-2 mb-3 bg-white p-3 rounded-3 border">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-dark mb-1">مستودع التسكين الفعلي <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm fw-bold border-primary" @bind="receiptPostDto.WarehouseId">
                                @foreach (var w in lookups.Warehouses)
                                {
                                    <option value="@w.Id">@w.WarehouseName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-dark mb-1">رقم شهادة التحليل (COA)</label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="مثال: COA-2026-88" @bind="receiptPostDto.CoaNumber" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-dark mb-1">اسم مفتش الجودة</label>
                            <input type="text" class="form-control form-control-sm" @bind="receiptPostDto.InspectorName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-dark mb-1">كود المفتش</label>
                            <input type="text" class="form-control form-control-sm font-monospace" @bind="receiptPostDto.InspectorCode" />
                        </div>
                    </div>

                    <!-- جدول فحص البنود واللوطات -->
                    <h6 class="fw-bold mb-2 text-dark">مطابقة بنود الشحنة والكميات الواردة:</h6>
                    <div class="table-responsive bg-white rounded border">
                        <table class="table table-bordered align-middle text-center mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start ps-3" style="width: 22%;">الصنف</th>
                                    <th>المتبقي بالطلب</th>
                                    <th style="width: 12%;">الكمية المقبولة</th>
                                    <th style="width: 10%;">المرفوض</th>
                                    <th style="width: 15%;">رقم التشغيلة (اللوط)</th>
                                    <th style="width: 14%;">تاريخ الصلاحية</th>
                                    <th>قرار الجودة / الملاحظات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in receiptPostDto.Items)
                                {
                                    <tr>
                                        <td class="text-start ps-3 fw-bold">
                                            @item.ItemName
                                            <div class="small text-muted font-monospace">@item.ItemCode</div>
                                        </td>
                                        <td class="font-monospace fw-bold text-secondary">
                                            @item.RemainingQuantity.ToString("N1") @item.Unit
                                        </td>
                                        <td>
                                            <input type="number" step="0.5" min="0" max="@item.RemainingQuantity"
                                                   class="form-control form-control-sm text-center fw-bold text-success font-monospace"
                                                   @bind="item.AcceptedQuantity" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.5" min="0" max="@item.RemainingQuantity"
                                                   class="form-control form-control-sm text-center text-danger font-monospace"
                                                   @bind="item.RejectedQuantity" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm font-monospace"
                                                   placeholder="LOT-xxxxx" @bind="item.BatchNumber" />
                                        </td>
                                        <td>
                                            <input type="date" class="form-control form-control-sm font-monospace"
                                                   @bind="item.ExpiryDate" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="مطابق للمواصفة..." @bind="item.RejectionReason" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-white py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => showInspectionModal = false">إلغاء</button>
                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="SubmitMaterialReceipt" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري التسكين والترصيد...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-1"></i>
                            <span>اعتماد الاستلام وتسكين المخزن</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PendingInvoiceDto> pendingInvoices = new();
    private MaterialReceiptLookupsDto lookups = new();
    private PendingInvoiceDto? selectedInvoice;
    private MaterialReceiptPostDto receiptPostDto = new();

    private long selectedSupplierId = 0;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showInspectionModal = false;

    private string? statusMessage;
    private string? errorMessage;
    private string? modalError;

    private IEnumerable<PendingInvoiceDto> FilteredInvoices =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? pendingInvoices
            : pendingInvoices.Where(p => (p.OrderNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                                      || (p.SupplierName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            lookups = await Http.GetFromJsonAsync<MaterialReceiptLookupsDto>("api/materialreceipt/lookups") ?? new();
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تحميل بيانات محطة الاستلام: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadInvoices()
    {
        try
        {
            string url = selectedSupplierId > 0
                ? $"api/materialreceipt/pending-invoices?supplierId={selectedSupplierId}"
                : "api/materialreceipt/pending-invoices";

            pendingInvoices = await Http.GetFromJsonAsync<List<PendingInvoiceDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر جلب أوامر الشراء المعتمدة: {ex.Message}";
        }
    }

    private void OpenInspectionModal(PendingInvoiceDto invoice)
    {
        selectedInvoice = invoice;
        receiptPostDto = new MaterialReceiptPostDto
        {
            InvoiceId = invoice.Id,
            WarehouseId = invoice.WarehouseId > 0 ? invoice.WarehouseId : (lookups.Warehouses.FirstOrDefault()?.Id ?? 0),
            CoaNumber = $"COA-{DateTime.UtcNow:yyyyMM}-{invoice.Id}",
            InspectorCode = "QC-01",
            InspectorName = "مفتش الجودة المخزنية",
            Items = invoice.Lines.Select(l => new MaterialReceiptItemPostDto
            {
                ItemId = l.ItemId,
                ItemName = l.ItemName,
                ItemCode = l.ItemCode,
                Unit = l.Unit,
                RemainingQuantity = l.RemainingQuantity,
                AcceptedQuantity = l.RemainingQuantity,
                RejectedQuantity = 0,
                UnitPrice = l.UnitPrice,
                BatchNumber = $"LOT-{l.ItemId}-{DateTime.UtcNow:yyyyMMdd}",
                ExpiryDate = DateTime.Today.AddYears(1),
                QcDecision = "Accepted",
                RejectionReason = "مطابق للمواصفة"
            }).ToList()
        };

        modalError = null;
        showInspectionModal = true;
    }

    private async Task SubmitMaterialReceipt()
    {
        if (receiptPostDto.WarehouseId <= 0)
        {
            modalError = "يرجى تحديد مستودع التسكين الفعلي.";
            return;
        }

        if (!receiptPostDto.Items.Any(i => i.AcceptedQuantity > 0 || i.RejectedQuantity > 0))
        {
            modalError = "يجب إدخال كمية مقبولة أو مرفوضة لبند واحد على الأقل.";
            return;
        }

        foreach (var item in receiptPostDto.Items)
        {
            if (item.AcceptedQuantity + item.RejectedQuantity > item.RemainingQuantity)
            {
                modalError = $"مجموع الكميات (المقبولة والمرفوضة) للصنف [{item.ItemName}] يتجاوز الكمية المتبقية ({item.RemainingQuantity}).";
                return;
            }

            if (item.AcceptedQuantity > 0 && string.IsNullOrWhiteSpace(item.BatchNumber))
            {
                modalError = $"يرجى إدخال رقم التشغيلة (اللوط) للصنف المقبول [{item.ItemName}].";
                return;
            }
        }

        isSaving = true;
        modalError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/materialreceipt", receiptPostDto);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<MaterialReceiptResultDto>();
                statusMessage = result?.Message ?? "تم استلام الخامات وتسكين الأرصدة المخزنية بنجاح!";
                showInspectionModal = false;
                await LoadInvoices();
            }
            else
            {
                modalError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            modalError = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ExportPendingToExcel()
    {
        var list = FilteredInvoices.ToList();
        if (!list.Any()) return;

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("رقم_أمر_الشراء,تاريخ_الأمر,المورد,عدد_البنود_المتبقية,إجمالي_القيمة,الحالة");

            foreach (var inv in list)
            {
                var statusText = inv.Status == "Approved" ? "جاهز للتوريد" : "توريد جزئي";
                sb.AppendLine($"\"{inv.OrderNumber}\",\"{inv.OrderDate}\",\"{inv.SupplierName}\",{inv.Lines.Count},{inv.TotalAmount:F2},\"{statusText}\"");
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"الشحنات_المعتمدة_للاستلام_{DateTime.Now:yyyyMMdd_HHmm}.csv";

            var js = $@"
                const link = document.createElement('a');
                link.href = 'data:text/csv;charset=utf-8;base64,{base64}';
                link.download = '{fileName}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ";
            await JS.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            errorMessage = $"فشل التصدير: {ex.Message}";
        }
    }
}