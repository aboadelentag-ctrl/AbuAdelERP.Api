@page "/vendor-qc-rating"
@layout KayanERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.IO
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>مؤشرات جودة الموردين وسجل الفحص الفني - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">

    <!-- رأس الصفحة وأزرار التصدير والتحديث -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-start border-primary border-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="mb-1 text-dark fw-bold">📊 مؤشرات جودة الموردين وسجل الفحص الفني</h4>
                <small class="text-muted">متابعة نسب القبول والرفض وتصنيف الموردين وفق معايير فحص استلام الخامات (ISO 22000 / HACCP)</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-success btn-sm fw-bold shadow-sm" @onclick="ExportRatingsToExcelAsync">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير تقرير تقييم الموردين
                </button>
                <button class="btn btn-outline-info btn-sm fw-bold shadow-sm" @onclick="ExportHistoryToExcelAsync">
                    <i class="bi bi-file-earmark-text me-1"></i> تصدير سجل الفحوصات التفصيلي
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadData" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise"></i> تحديث المؤشرات
                </button>
            </div>
        </div>
    </div>

    <!-- تنبيهات النظام -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mb-3 py-2 fw-bold" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i> @statusMessage
            <button type="button" class="btn-close py-2" @onclick='() => statusMessage = null'></button>
        </div>
    }

    <!-- كروت ملخص الأداء العام للجودة (KPIs) -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold">إجمالي الموردين المفحوصين</div>
                        <div class="fs-3 fw-bold text-success mt-1 font-monospace">@FilteredRatings.Count()</div>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-truck fs-4 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold">موردين بتصنيف ممتاز (Grade A)</div>
                        <div class="fs-3 fw-bold text-primary mt-1 font-monospace">@FilteredRatings.Count(r => r.QualityGrade == "A")</div>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-award fs-4 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold">موردين تحت الملاحظة (Grade B)</div>
                        <div class="fs-3 fw-bold text-warning mt-1 font-monospace">@FilteredRatings.Count(r => r.QualityGrade == "B")</div>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-exclamation-circle fs-4 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold">موردين ذوو خطورة جودة (Grade C)</div>
                        <div class="fs-3 fw-bold text-danger mt-1 font-monospace">@FilteredRatings.Count(r => r.QualityGrade == "C")</div>
                    </div>
                    <div class="bg-light p-2 rounded-circle border">
                        <i class="bi bi-shield-slash fs-4 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- شريط البحث والفلترة المتعددة -->
    <div class="card shadow-sm border-0 mb-3 bg-white border-top border-primary border-3 rounded-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">🔍 بحث (مورد، خامة، LOT، أو ملاحظات)</label>
                    <input type="text" class="form-control form-control-sm" placeholder="ابحث باسم المورد أو الخامة أو رقم التشغيلة..." 
                           @bind="searchTerm" @bind:event="oninput" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">🏆 تصنيف الجودة</label>
                    <select class="form-select form-select-sm fw-bold" @bind="selectedGradeFilter">
                        <option value="all">-- كل التصنيفات --</option>
                        <option value="A">Grade A (ممتاز ≥ 95%)</option>
                        <option value="B">Grade B (تحت الملاحظة 85%-94%)</option>
                        <option value="C">Grade C (مرفوض / خطر &lt; 85%)</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">⚖️ القرار الفني للفحص</label>
                    <select class="form-select form-select-sm fw-bold" @bind="selectedDecisionFilter">
                        <option value="all">-- كل القرارات --</option>
                        <option value="PURCHASE_RECEIPT">✅ إفراج ومقبول فقط</option>
                        <option value="REJECTED">❌ مرفوض فني فقط</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">📅 من تاريخ</label>
                    <input type="date" class="form-control form-control-sm font-monospace" @bind="fromDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">📅 إلى تاريخ</label>
                    <input type="date" class="form-control form-control-sm font-monospace" @bind="toDate" />
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-outline-danger btn-sm w-100 fw-bold" title="تفريغ الفلاتر" @onclick="ResetFilter">✕</button>
                </div>
            </div>

            @if (HasActiveFilters)
            {
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    <span class="small text-primary fw-bold">
                        <i class="bi bi-funnel-fill me-1"></i> نتائج التصفية: (@FilteredRatings.Count() مورد مطابق | @FilteredHistory.Count() حركة فحص فني)
                    </span>
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 fw-bold" style="font-size: 0.78rem;" @onclick="ResetFilter">
                        ✕ إلغاء الفلاتر وعرض الكل
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- جدول تقييم أداء الموردين ومعدل مطابقة الجودة -->
    <div class="card shadow-sm border-0 mb-4 bg-white rounded-3">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold small">🏆 تقييم أداء الموردين ومعدل مطابقة الجودة (% Acceptance Rate)</h6>
            <span class="badge bg-primary">المعروض: @FilteredRatings.Count() مورد</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0 align-middle text-center small">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%;" class="text-start ps-3">اسم المورد</th>
                            <th style="width: 12%;">عدد الشحنات</th>
                            <th style="width: 13%;">إجمالي الوارد</th>
                            <th style="width: 13%;">الكمية المقبولة</th>
                            <th style="width: 13%;">الكمية المرفوضة</th>
                            <th style="width: 12%;">معدل القبول %</th>
                            <th style="width: 12%;">تصنيف الجودة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && ratings == null)
                        {
                            <tr><td colspan="7" class="py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري حساب التقييمات للفترة المحددة...</td></tr>
                        }
                        else if (!FilteredRatings.Any())
                        {
                            <tr><td colspan="7" class="text-muted py-4">لا توجد حركات استلام وفحص جودة مسجلة مطابقة للفلاتر الحالية.</td></tr>
                        }
                        else
                        {
                            @foreach (var r in FilteredRatings)
                            {
                                <tr>
                                    <td class="text-start ps-3 fw-bold text-primary">@r.SupplierName</td>
                                    <td><span class="badge bg-secondary font-monospace">@r.TotalShipments شحنة</span></td>
                                    <td class="fw-bold font-monospace">@r.TotalReceivedQty.ToString("N2")</td>
                                    <td class="text-success fw-bold font-monospace">@r.TotalAcceptedQty.ToString("N2")</td>
                                    <td class="text-danger fw-bold font-monospace">@r.TotalRejectedQty.ToString("N2")</td>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @(r.AcceptanceRate >= 95 ? "bg-success" : r.AcceptanceRate >= 85 ? "bg-warning text-dark" : "bg-danger") fw-bold font-monospace"
                                                 role="progressbar" style="width: @(Math.Min(r.AcceptanceRate, 100))%;">
                                                @r.AcceptanceRate.ToString("N1")%
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (r.QualityGrade == "A")
                                        {
                                            <span class="badge bg-success fs-6 px-3">A - ممتاز</span>
                                        }
                                        else if (r.QualityGrade == "B")
                                        {
                                            <span class="badge bg-warning text-dark fs-6 px-3">B - تحت الملاحظة</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6 px-3">C - غير مطابق</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- سجل الفحوصات التفصيلية وأسباب الرفض -->
    <div class="card shadow-sm border-0 mb-3 bg-white rounded-3">
        <div class="card-header bg-secondary text-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold small">📜 سجل الفحوصات الفنية للخامات وأسباب الرفض</h6>
            <span class="badge bg-light text-dark">المعروض: @FilteredHistory.Count() حركة استلام وفحص</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle text-center small">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 14%;">تاريخ الفحص</th>
                            <th style="width: 18%;" class="text-start ps-3">المورد</th>
                            <th style="width: 20%;" class="text-start ps-3">الصنف / الخامة</th>
                            <th style="width: 12%;">الكمية</th>
                            <th style="width: 12%;">القرار الفني</th>
                            <th style="width: 24%;" class="text-start ps-3">ملاحظات ومفتش الجودة والشهادات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && history == null)
                        {
                            <tr><td colspan="6" class="py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> جاري تحميل السجل...</td></tr>
                        }
                        else if (!FilteredHistory.Any())
                        {
                            <tr><td colspan="6" class="text-muted py-4">لا يوجد سجل فحوصات خلال هذه الفترة مطابق للفلاتر المحددة.</td></tr>
                        }
                        else
                        {
                            @foreach (var h in FilteredHistory)
                            {
                                <tr>
                                    <td class="font-monospace text-muted">@h.InspectionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-start ps-3 fw-bold text-dark">@h.SupplierName</td>
                                    <td class="text-start ps-3">
                                        <div class="fw-bold text-primary">@h.ItemName</div>
                                        <small class="text-muted font-monospace">@h.ItemCode</small>
                                    </td>
                                    <td class="fw-bold font-monospace">@h.Quantity.ToString("N2")</td>
                                    <td>
                                        @if (h.MovementType == "PURCHASE_RECEIPT")
                                        {
                                            <span class="badge bg-success px-3 py-1">✅ إفراج ومقبول</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-1">❌ مرفوض فني</span>
                                        }
                                    </td>
                                    <td class="text-start ps-3 small text-muted">@(string.IsNullOrEmpty(h.Notes) ? "-" : h.Notes)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<VendorQcScoreDto>? ratings;
    private List<QcInspectionHistoryDto>? history;

    private DateTime? fromDate = DateTime.Today.AddDays(-30);
    private DateTime? toDate = DateTime.Today;

    private string searchTerm = "";
    private string selectedGradeFilter = "all";
    private string selectedDecisionFilter = "all";

    private bool isLoading = false;
    private string? statusMessage;
    private bool isSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            var queryList = new List<string>();
            if (fromDate.HasValue) queryList.Add($"fromDate={fromDate.Value:yyyy-MM-dd}");
            if (toDate.HasValue) queryList.Add($"toDate={toDate.Value:yyyy-MM-dd}");

            string queryString = queryList.Any() ? "?" + string.Join("&", queryList) : "";

            ratings = await Http.GetFromJsonAsync<List<VendorQcScoreDto>>($"api/VendorQc/ratings{queryString}") ?? new();
            history = await Http.GetFromJsonAsync<List<QcInspectionHistoryDto>>($"api/VendorQc/history{queryString}") ?? new();
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"خطأ في جلب بيانات الفحص والجودة: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResetFilter()
    {
        searchTerm = "";
        selectedGradeFilter = "all";
        selectedDecisionFilter = "all";
        fromDate = null;
        toDate = null;
        await LoadData();
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        selectedGradeFilter != "all" ||
        selectedDecisionFilter != "all" ||
        fromDate.HasValue ||
        toDate.HasValue;

    private IEnumerable<VendorQcScoreDto> FilteredRatings
    {
        get
        {
            if (ratings == null) return Enumerable.Empty<VendorQcScoreDto>();
            var query = ratings.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(r => r.SupplierName.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedGradeFilter != "all")
            {
                query = query.Where(r => r.QualityGrade.Equals(selectedGradeFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private IEnumerable<QcInspectionHistoryDto> FilteredHistory
    {
        get
        {
            if (history == null) return Enumerable.Empty<QcInspectionHistoryDto>();
            var query = history.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(h =>
                    h.SupplierName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    h.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    h.ItemCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(h.Notes) && h.Notes.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (selectedDecisionFilter != "all")
            {
                query = query.Where(h => h.MovementType.Equals(selectedDecisionFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private async Task ExportRatingsToExcelAsync()
    {
        var list = FilteredRatings.ToList();
        if (!list.Any())
        {
            isSuccess = false;
            statusMessage = "لا توجد تقييمات مطابقة لتصديرها.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("اسم_المورد,عدد_الشحنات,إجمالي_الوارد,الكمية_المقبولة,الكمية_المرفوضة,معدل_القبول_النسبة,تصنيف_الجودة");

            foreach (var r in list)
            {
                var gradeTitle = r.QualityGrade switch
                {
                    "A" => "A - ممتاز",
                    "B" => "B - تحت الملاحظة",
                    _ => "C - غير مطابق"
                };
                sb.AppendLine($"{EscapeCsv(r.SupplierName)},{r.TotalShipments},{r.TotalReceivedQty:F2},{r.TotalAcceptedQty:F2},{r.TotalRejectedQty:F2},{r.AcceptanceRate:F1}%,{gradeTitle}");
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"تقرير_تقييم_جودة_الموردين_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await JS.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8;base64,{base64}'; a.download = '{fileName}'; document.body.appendChild(a); a.click(); document.body.removeChild(a);");

            isSuccess = true;
            statusMessage = $"تم تصدير تقييم ({list.Count}) مورد إلى إكسيل بنجاح.";
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"فشل التصدير: {ex.Message}";
        }
    }

    private async Task ExportHistoryToExcelAsync()
    {
        var list = FilteredHistory.ToList();
        if (!list.Any())
        {
            isSuccess = false;
            statusMessage = "لا يوجد سجل فحوصات مطابق لتصديره.";
            return;
        }

        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("تاريخ_الفحص,اسم_المورد,كود_الخامة,اسم_الخامة,الكمية,القرار_الفني,ملاحظات_مفتش_الجودة_والتشغيل");

            foreach (var h in list)
            {
                var decision = h.MovementType == "PURCHASE_RECEIPT" ? "إفراج ومقبول" : "مرفوض فني";
                var notes = (h.Notes ?? "").Replace(",", " - ").Replace("\r", " ").Replace("\n", " ");
                sb.AppendLine($"{h.InspectionDate:yyyy-MM-dd HH:mm},{EscapeCsv(h.SupplierName)},{EscapeCsv(h.ItemCode)},{EscapeCsv(h.ItemName)},{h.Quantity:F2},{decision},{EscapeCsv(notes)}");
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"سجل_الفحوصات_الفنية_للخامات_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await JS.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8;base64,{base64}'; a.download = '{fileName}'; document.body.appendChild(a); a.click(); document.body.removeChild(a);");

            isSuccess = true;
            statusMessage = $"تم تصدير ({list.Count}) حركة فحص واستلام إلى إكسيل بنجاح.";
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"فشل التصدير: {ex.Message}";
        }
    }

    private string EscapeCsv(string val)
    {
        if (string.IsNullOrEmpty(val)) return "";
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n") || val.Contains("\r"))
            return $"\"{val.Replace("\"", "\"\"")}\"";
        return val;
    }

    public class VendorQcScoreDto
    {
        public long SupplierId { get; set; }
        public string SupplierName { get; set; } = string.Empty;
        public int TotalShipments { get; set; }
        public decimal TotalReceivedQty { get; set; }
        public decimal TotalAcceptedQty { get; set; }
        public decimal TotalRejectedQty { get; set; }
        public decimal AcceptanceRate { get; set; }
        public string QualityGrade { get; set; } = "A";
        public int RejectionIncidentsCount { get; set; }
    }

    public class QcInspectionHistoryDto
    {
        public long MovementId { get; set; }
        public DateTime InspectionDate { get; set; }
        public long SupplierId { get; set; }
        public string SupplierName { get; set; } = string.Empty;
        public long ItemId { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemName { get; set; } = string.Empty;
        public string MovementType { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public string Notes { get; set; } = string.Empty;
    }
}