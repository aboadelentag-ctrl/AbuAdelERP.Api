@code {
    private string activeTab = "ROLES";
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isSubmittingModal = false;
    private string? statusMessage;
    private string permSearchTerm = "";

    private List<RoleDto> rolesList = new();
    private List<UserRowDto> usersList = new();
    private List<EmployeeLookupDto> employeesList = new();
    private List<PermissionGroupDto> permissionCatalog = new();

    private int selectedRoleId = 0;
    private RoleDto? selectedRole;
    private HashSet<string> activePermissionsSet = new(StringComparer.OrdinalIgnoreCase);

    // متغيرات الـ Modals
    private bool showCreateRoleModal = false;
    private string newRoleDisplayName = "";
    private string newRoleName = "";
    private string newRoleDescription = "";
    private int cloneFromRoleId = 0;

    private bool showCreateUserModal = false;
    private string newUsername = "";
    private string newUserPassword = "";
    private string newUserFullName = "";
    private string newUserDepartmentName = "";
    private long? selectedEmployeeId;
    private string? selectedEmployeeCode;
    private int newUserRoleId = 0;

    private bool showResetPassModal = false;
    private UserRowDto? targetUser;
    private string resetPassNew = "";

    private bool showCustomPermsModal = false;
    private HashSet<string> userCustomPermsSet = new(StringComparer.OrdinalIgnoreCase);

    // فلترة الأزرار بالبحث السريع
    private IEnumerable<PermissionGroupDto> FilteredCatalog
    {
        get
        {
            if (string.IsNullOrWhiteSpace(permSearchTerm)) return permissionCatalog;
            string term = permSearchTerm.Trim();

            return permissionCatalog.Select(g => new PermissionGroupDto
            {
                GroupCode = g.GroupCode,
                GroupName = g.GroupName,
                Permissions = g.Permissions.Where(p => 
                    p.Title.Contains(term, StringComparison.OrdinalIgnoreCase) || 
                    p.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.Code.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList()
            }).Where(g => g.Permissions.Any());
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            long companyId = State.CompanyId > 0 ? State.CompanyId : 1;

            // 1. تحميل فهرس الصلاحيات الكامل
            var catalogResponse = await Http.GetFromJsonAsync<List<PermissionGroupDto>>("api/roles/catalog");
            if (catalogResponse != null) permissionCatalog = catalogResponse;

            // 2. تحميل أدوار المنشأة
            var rolesResponse = await Http.GetFromJsonAsync<List<RoleDto>>($"api/roles/company/{companyId}");
            if (rolesResponse != null && rolesResponse.Any())
            {
                rolesList = rolesResponse;
                SelectRole(rolesList.First());
            }

            // 3. تحميل مستخدمي المنشأة
            var usersResponse = await Http.GetFromJsonAsync<List<UserRowDto>>($"api/roles/users/{companyId}");
            if (usersResponse != null) usersList = usersResponse;

            // 4. تحميل العاملين لملء القوائم المنسدلة
            var employeesResponse = await Http.GetFromJsonAsync<List<EmployeeLookupDto>>($"api/roles/employees/{companyId}");
            if (employeesResponse != null) employeesList = employeesResponse;
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ في جلب البيانات: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectRole(RoleDto role)
    {
        selectedRole = role;
        selectedRoleId = role.Id;

        activePermissionsSet.Clear();
        if (!string.IsNullOrWhiteSpace(role.Permissions))
        {
            var perms = role.Permissions.Split(new[] { ',', ';', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            foreach (var p in perms) activePermissionsSet.Add(p.Trim());
        }
    }

    private void TogglePermission(string code)
    {
        if (activePermissionsSet.Contains(code)) activePermissionsSet.Remove(code);
        else activePermissionsSet.Add(code);
    }

    private void SelectAllPermissions()
    {
        foreach (var grp in permissionCatalog)
        {
            foreach (var p in grp.Permissions) activePermissionsSet.Add(p.Code);
        }
    }

    private void ClearAllPermissions() => activePermissionsSet.Clear();

    private async Task SaveRolePermissions()
    {
        if (selectedRole == null) return;
        isSaving = true;
        try
        {
            var payload = new { Permissions = activePermissionsSet.ToList() };
            var response = await Http.PutAsJsonAsync($"api/roles/{selectedRole.Id}/permissions", payload);

            if (response.IsSuccessStatusCode)
            {
                selectedRole.Permissions = string.Join(",", activePermissionsSet);
                statusMessage = $"✓ تم حفظ وتحديث مصفوفة أزرار ({selectedRole.DisplayName}) بنجاح.";
            }
        }
        catch (Exception ex) { statusMessage = $"خطأ: {ex.Message}"; }
        finally { isSaving = false; }
    }

    // Modal 1: إنشاء دور جديد
    private void OpenCreateRoleModal()
    {
        newRoleDisplayName = "";
        newRoleName = "";
        newRoleDescription = "";
        cloneFromRoleId = 0;
        showCreateRoleModal = true;
    }

    private async Task SubmitCreateRole()
    {
        if (string.IsNullOrWhiteSpace(newRoleDisplayName))
        {
            statusMessage = "يرجى كتابة اسم الدور بالعربية.";
            return;
        }

        isSubmittingModal = true;
        try
        {
            var initialPerms = new List<string>();
            if (cloneFromRoleId > 0)
            {
                var cloneSource = rolesList.FirstOrDefault(r => r.Id == cloneFromRoleId);
                if (cloneSource != null && !string.IsNullOrEmpty(cloneSource.Permissions))
                    initialPerms = cloneSource.Permissions.Split(',').Select(p => p.Trim()).ToList();
            }

            var payload = new
            {
                DisplayName = newRoleDisplayName.Trim(),
                Name = newRoleName.Trim(),
                Description = newRoleDescription,
                CompanyId = State.CompanyId > 0 ? State.CompanyId : 1,
                Permissions = initialPerms
            };

            var res = await Http.PostAsJsonAsync("api/roles", payload);
            if (res.IsSuccessStatusCode)
            {
                showCreateRoleModal = false;
                statusMessage = "✓ تم إنشاء الدور والمصفوفة بنجاح.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex) { statusMessage = $"خطأ: {ex.Message}"; }
        finally { isSubmittingModal = false; }
    }

    // Modal 2: إنشاء مستخدم جديد
    private void OpenCreateUserModal()
    {
        newUsername = "";
        newUserPassword = "";
        newUserFullName = "";
        newUserDepartmentName = "";
        selectedEmployeeId = null;
        selectedEmployeeCode = null;
        newUserRoleId = rolesList.FirstOrDefault()?.Id ?? 0;
        showCreateUserModal = true;
    }

    private void OnEmployeeSelected(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out long empId) && empId > 0)
        {
            var emp = employeesList.FirstOrDefault(x => x.Id == empId);
            if (emp != null)
            {
                selectedEmployeeId = emp.Id;
                selectedEmployeeCode = emp.EmployeeCode;
                newUserFullName = emp.FullName;
                newUserDepartmentName = emp.DepartmentName;
                if (string.IsNullOrEmpty(newUsername))
                    newUsername = emp.EmployeeCode.ToLower();
            }
        }
    }

    private async Task SubmitCreateUser()
    {
        if (string.IsNullOrWhiteSpace(newUsername) || string.IsNullOrWhiteSpace(newUserPassword))
        {
            statusMessage = "اسم المستخدم وكلمة المرور مطلوبان.";
            return;
        }

        isSubmittingModal = true;
        try
        {
            var selectedRoleObj = rolesList.FirstOrDefault(r => r.Id == newUserRoleId);
            var payload = new
            {
                Username = newUsername.Trim(),
                Password = newUserPassword.Trim(),
                FullName = newUserFullName,
                DepartmentName = newUserDepartmentName,
                CompanyId = State.CompanyId > 0 ? State.CompanyId : 1,
                RoleId = (long?)newUserRoleId,
                RoleName = selectedRoleObj?.DisplayName ?? "User",
                EmployeeId = selectedEmployeeId,
                EmployeeCode = selectedEmployeeCode
            };

            var res = await Http.PostAsJsonAsync("api/roles/users", payload);
            if (res.IsSuccessStatusCode)
            {
                showCreateUserModal = false;
                statusMessage = "✓ تم إنشاء حساب المستخدم وربطه بالعامل بنجاح.";
                await LoadDataAsync();
            }
            else
            {
                statusMessage = await res.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex) { statusMessage = $"خطأ: {ex.Message}"; }
        finally { isSubmittingModal = false; }
    }

    // Modal 3: إعادة تعيين كلمة المرور
    private void OpenResetPassModal(UserRowDto user)
    {
        targetUser = user;
        resetPassNew = "";
        showResetPassModal = true;
    }

    private async Task SubmitResetPassword()
    {
        if (targetUser == null || string.IsNullOrWhiteSpace(resetPassNew)) return;
        isSubmittingModal = true;
        try
        {
            var payload = new { IsActive = targetUser.IsActive, NewPassword = resetPassNew.Trim() };
            var res = await Http.PutAsJsonAsync($"api/roles/users/{targetUser.Id}/status", payload);
            if (res.IsSuccessStatusCode)
            {
                showResetPassModal = false;
                statusMessage = $"✓ تم تغيير كلمة المرور للمستخدم ({targetUser.Username}) بنجاح.";
            }
        }
        catch (Exception ex) { statusMessage = $"خطأ: {ex.Message}"; }
        finally { isSubmittingModal = false; }
    }

    // تفعيل / تعطيل الحساب
    private async Task ToggleUserStatus(UserRowDto user)
    {
        try
        {
            var payload = new { IsActive = !user.IsActive, NewPassword = (string?)null };
            var res = await Http.PutAsJsonAsync($"api/roles/users/{user.Id}/status", payload);
            if (res.IsSuccessStatusCode)
            {
                user.IsActive = !user.IsActive;
                statusMessage = $"✓ تم تحديث حالة حساب ({user.Username}).";
            }
        }
        catch (Exception ex) { statusMessage = $"خطأ: {ex.Message}"; }
    }

    // Modal 4: الصلاحيات الاستثنائية
    private void OpenCustomPermsModal(UserRowDto user)
    {
        targetUser = user;
        userCustomPermsSet.Clear();
        if (!string.IsNullOrWhiteSpace(user.CustomPermissions))
        {
            var perms = user.CustomPermissions.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
            foreach (var p in perms) userCustomPermsSet.Add(p.Trim());
        }
        showCustomPermsModal = true;
    }

    private void ToggleUserCustomPerm(string code)
    {
        if (userCustomPermsSet.Contains(code)) userCustomPermsSet.Remove(code);
        else userCustomPermsSet.Add(code);
    }

    private async Task SubmitSaveUserCustomPerms()
    {
        if (targetUser == null) return;
        isSubmittingModal = true;
        try
        {
            var payload = new { Permissions = userCustomPermsSet.ToList() };
            var res = await Http.PutAsJsonAsync($"api/roles/users/{targetUser.Id}/custom-permissions", payload);
            if (res.IsSuccessStatusCode)
            {
                targetUser.CustomPermissions = string.Join(",", userCustomPermsSet);
                showCustomPermsModal = false;
                statusMessage = $"✓ تم حفظ الصلاحيات الاستثنائية للمستخدم ({targetUser.Username}) بنجاح.";
            }
        }
        catch (Exception ex) { statusMessage = $"خطأ: {ex.Message}"; }
        finally { isSubmittingModal = false; }
    }

    // نماذج البيانات للـ UI (محفوظة داخلياً لضمان عدم وجود أخطاء Reference)
    public class RoleDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string? Description { get; set; }
        public string? Permissions { get; set; }
        public bool Active { get; set; }
        public int UsersCount { get; set; }
    }

    public class UserRowDto
    {
        public long Id { get; set; }
        public string Username { get; set; } = "";
        public string? FullName { get; set; }
        public long? EmployeeId { get; set; }
        public string? EmployeeCode { get; set; }
        public string Role { get; set; } = "";
        public long? RoleId { get; set; }
        public string? DepartmentName { get; set; }
        public bool IsActive { get; set; }
        public string? CustomPermissions { get; set; }
    }

    public class EmployeeLookupDto
    {
        public long Id { get; set; }
        public string EmployeeCode { get; set; } = "";
        public string FullName { get; set; } = "";
        public string DepartmentName { get; set; } = "";
    }

    public class PermissionGroupDto
    {
        public string GroupCode { get; set; } = string.Empty;
        public string GroupName { get; set; } = string.Empty;
        public List<PermissionItemDto> Permissions { get; set; } = new();
    }

    public class PermissionItemDto
    {
        public string Code { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}