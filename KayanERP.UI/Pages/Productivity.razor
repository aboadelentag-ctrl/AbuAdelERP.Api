@page "/productivity"
@layout KayanERP.UI.Pages.EmptyLayout

<PageTitle>إنتاجية الأقسام - أبو عادل</PageTitle>

<div class="container mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-primary fw-bold mb-0">
            <span class="bi bi-bar-chart-line-fill me-2"></span> لوحة إنتاجية العمال والأقسام (بالساعة)
        </h3>
        <div class="d-flex gap-2">
            <!-- ربط القائمة بالمتغير selectedDepartment -->
            <select class="form-select border-primary" style="width: 200px;" @bind="selectedDepartment">
                <option value="الشرقي">قسم الشرقي</option>
                <option value="المخبوزات">قسم المخبوزات</option>
                <option value="الجاتوه">قسم الجاتوه والتورت</option>
                <option value="الإسفنجي">الإسفنجي والنواشف</option>
            </select>
            <!-- ربط الزر بدالة التصفية -->
            <button class="btn btn-primary shadow-sm" @onclick="FilterData">
                <span class="bi bi-funnel-fill"></span> تصفية
            </button>
        </div>
    </div>

    <!-- البطاقات التلخيصية -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title">إجمالي المستهدف (اليوم)</h6>
                    <h3 class="fw-bold mb-0">@filteredWorkers.Sum(w => w.TargetPerHour) <span class="fs-6 fw-normal">وحدة</span></h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title">الإنتاج الفعلي (حتى الآن)</h6>
                    <h3 class="fw-bold mb-0">@filteredWorkers.Sum(w => w.ActualPerHour) <span class="fs-6 fw-normal">وحدة</span></h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark text-white shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title">متوسط كفاءة القسم</h6>
                    <h3 class="fw-bold mb-0 text-warning">
                        @(filteredWorkers.Any() ? Math.Round(filteredWorkers.Average(w => w.Efficiency), 1) : 0)%
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول تفاصيل إنتاجية العمال -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
            <h5 class="fw-bold text-dark">تفاصيل الأداء بالساعة (قسم @selectedDepartment)</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mt-3 mb-0 text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>اسم العامل/الشيف</th>
                        <th>الصنف</th>
                        <th>المستهدف/ساعة</th>
                        <th>الفعلي/ساعة</th>
                        <th>الكفاءة</th>
                        <th>تقييم الأداء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!filteredWorkers.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-4">لا توجد بيانات مسجلة لهذا القسم حالياً.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var worker in filteredWorkers)
                        {
                            <tr>
                                <td>@worker.WorkerName</td>
                                <td>@worker.ItemName</td>
                                <td>@worker.TargetPerHour</td>
                                <td>@worker.ActualPerHour</td>
                                <td>@worker.Efficiency%</td>
                                <td>
                                    <!-- تغيير لون المؤشر والتقييم برمجياً بناءً على الكفاءة -->
                                    <span class="badge @GetBadgeClass(worker.Efficiency) px-3 py-2">
                                        @GetEvaluation(worker.Efficiency)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string selectedDepartment = "الشرقي"; // القسم الافتراضي
    private List<WorkerProductivityDto> allWorkers = new();
    private List<WorkerProductivityDto> filteredWorkers = new();

    protected override void OnInitialized()
    {
        // محاكاة قاعدة البيانات وتغذية النظام بأقسام مختلفة
        allWorkers = new List<WorkerProductivityDto>
        {
            // قسم الشرقي
            new WorkerProductivityDto { Department = "الشرقي", WorkerName = "أحمد محمود", ItemName = "بسبوسة سادة", TargetPerHour = 50, ActualPerHour = 48 },
            new WorkerProductivityDto { Department = "الشرقي", WorkerName = "سيد مصطفى", ItemName = "كنافة بالكريمة", TargetPerHour = 40, ActualPerHour = 42 },
            new WorkerProductivityDto { Department = "الشرقي", WorkerName = "محمود حسن", ItemName = "بقلاوة", TargetPerHour = 30, ActualPerHour = 22 },

// قسم المخبوزات
            new WorkerProductivityDto { Department = "المخبوزات", WorkerName = "إبراهيم علي", ItemName = "باتيه بالجبنة", TargetPerHour = 100, ActualPerHour = 100 },
            new WorkerProductivityDto { Department = "المخبوزات", WorkerName = "مصطفى كامل", ItemName = "كرواسون", TargetPerHour = 80, ActualPerHour = 65 },
            new WorkerProductivityDto { Department = "المخبوزات", WorkerName = "علي جابر", ItemName = "دنش", TargetPerHour = 50, ActualPerHour = 30 },

// قسم الجاتوه
            new WorkerProductivityDto { Department = "الجاتوه", WorkerName = "شيف طارق", ItemName = "جاتوه شيكولاتة", TargetPerHour = 60, ActualPerHour = 65 }
        };

        // تنفيذ التصفية فور فتح الشاشة
        FilterData();
    }

    // دالة التصفية عند الضغط على الزر
    private void FilterData()
    {
        filteredWorkers = allWorkers.Where(w => w.Department == selectedDepartment).ToList();
    }

    // دوال مساعدة لتحديد الألوان والتقييمات
    private string GetBadgeClass(double efficiency)
    {
        if (efficiency >= 100) return "bg-primary";
        if (efficiency >= 90) return "bg-success";
        return "bg-danger";
    }

    private string GetEvaluation(double efficiency)
    {
        if (efficiency >= 100) return "فوق المتوقع";
        if (efficiency >= 90) return "ممتاز";
        return "يحتاج مراجعة";
    }

    // كلاس البيانات (يقوم بحساب نسبة الكفاءة تلقائياً)
    public class WorkerProductivityDto
    {
        public string Department { get; set; } = "";
        public string WorkerName { get; set; } = "";
        public string ItemName { get; set; } = "";
        public int TargetPerHour { get; set; }
        public int ActualPerHour { get; set; }

        // معادلة حساب الكفاءة
        public double Efficiency => TargetPerHour > 0 ? Math.Round((double)ActualPerHour / TargetPerHour * 100, 1) : 0;
    }
}