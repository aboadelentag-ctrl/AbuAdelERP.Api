@page "/financial-statements"
@page "/finance/reports"
@layout KayanERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>القوائم والتقارير المالية والمركز المالي - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">
    <!-- رأس الشاشة المالي الختامي -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h4 class="text-primary m-0 mb-1 fw-bold">📊 القوائم والتقارير المالية الختامية والمركز المالي</h4>
            <span class="text-muted small">عرض ميزان المراجعة، قائمة الدخل والأرباح والخسائر، والميزانية العمومية لمصانع ومنافذ أبو عادل</span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm fw-bold shadow-sm px-3" @onclick="LoadAllReportsAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> تحديث القوائم
            </button>
            <button class="btn btn-outline-secondary btn-sm fw-bold shadow-sm px-3" @onclick="PrintReport">
                🖨️ طباعة التقرير
            </button>
        </div>
    </div>

    <!-- أزرار التبديل بين القوائم المالية الثلاث (Tabs) -->
    <div class="d-flex gap-2 mb-3 border-bottom pb-2">
        <button class="btn btn-sm fw-bold px-4 py-2 @(activeTab == 1 ? "btn-primary shadow-sm" : "btn-light text-dark")" @onclick="() => activeTab = 1">
            📈 قائمة الدخل والأرباح والخسائر (P&L)
        </button>
        <button class="btn btn-sm fw-bold px-4 py-2 @(activeTab == 2 ? "btn-primary shadow-sm" : "btn-light text-dark")" @onclick="() => activeTab = 2">
            🏛️ قائمة المركز المالي (الميزانية العمومية)
        </button>
        <button class="btn btn-sm fw-bold px-4 py-2 @(activeTab == 3 ? "btn-primary shadow-sm" : "btn-light text-dark")" @onclick="() => activeTab = 3">
            ⚖️ ميزان المراجعة بالمجاميع والأرصدة
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">جاري احتساب المؤشرات المالية وتدقيق التوازن...</p>
        </div>
    }
    else
    {
        <!-- ==================================================== -->
        <!-- TAB 1: قائمة الدخل والأرباح والخسائر (Income Statement) -->
        <!-- ==================================================== -->
        @if (activeTab == 1 && incomeData != null)
        {
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold small">📈 قائمة الأرباح والخسائر التشغيلية - حلواني ومصانع أبو عادل</h6>
                    <span class="badge bg-success font-monospace">صافي ربح الفترة: @incomeData.NetProfit.ToString("N0") ج.م</span>
                </div>
                <div class="card-body p-4 bg-white">
                    <!-- 1. إيرادات النشاط -->
                    <h6 class="fw-bold text-success border-bottom pb-2 mb-3">1. إيرادات النشاط والمبيعات</h6>
                    <table class="table table-sm table-hover align-middle mb-3 small">
                        <tbody>
                            @foreach (var item in incomeData.Revenues)
                            {
                                <tr>
                                    <td class="font-monospace text-muted" style="width: 100px;">@item.Code</td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    <td class="text-end font-monospace fw-bold text-success" style="width: 200px;">@item.Amount.ToString("N0") ج.م</td>
                                </tr>
                            }
                            <tr class="table-success fw-bold">
                                <td colspan="2" class="ps-3">إجمالي إيرادات المبيعات</td>
                                <td class="text-end font-monospace fs-6">@incomeData.TotalRevenues.ToString("N0") ج.م</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 2. تكلفة الإنتاج والخامات (COGS) -->
                    <h6 class="fw-bold text-danger border-bottom pb-2 mb-3 mt-4">2. تكلفة البضاعة المباعة والإنتاج المباشر (COGS)</h6>
                    <table class="table table-sm table-hover align-middle mb-3 small">
                        <tbody>
                            @foreach (var item in incomeData.CostOfGoodsSold)
                            {
                                <tr>
                                    <td class="font-monospace text-muted" style="width: 100px;">@item.Code</td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    <td class="text-end font-monospace text-danger" style="width: 200px;">@item.Amount.ToString("N0") ج.م</td>
                                </tr>
                            }
                            <tr class="table-light fw-bold text-danger">
                                <td colspan="2" class="ps-3">إجمالي تكاليف الإنتاج والخامات المباشرة</td>
                                <td class="text-end font-monospace fs-6">@incomeData.TotalCOGS.ToString("N0") ج.م</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- مجمل الربح -->
                    <div class="p-3 my-3 bg-light rounded border d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold text-primary m-0">مجمل ربح التصنيع (Gross Profit):</h5>
                        <h4 class="font-monospace fw-bold text-primary m-0">@incomeData.GrossProfit.ToString("N0") ج.م</h4>
                    </div>

                    <!-- 3. مصاريف التشغيل والطاقة والإيجارات -->
                    <h6 class="fw-bold text-warning text-dark border-bottom pb-2 mb-3 mt-4">3. مصاريف التشغيل، الطاقة، وأجور الخدمات (OPEX)</h6>
                    <table class="table table-sm table-hover align-middle mb-3 small">
                        <tbody>
                            @foreach (var item in incomeData.OperatingExpenses)
                            {
                                <tr>
                                    <td class="font-monospace text-muted" style="width: 100px;">@item.Code</td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    <td class="text-end font-monospace text-secondary" style="width: 200px;">@item.Amount.ToString("N0") ج.م</td>
                                </tr>
                            }
                            <tr class="table-light fw-bold text-secondary">
                                <td colspan="2" class="ps-3">إجمالي مصاريف التشغيل والطاقة والإيجار</td>
                                <td class="text-end font-monospace fs-6">@incomeData.TotalOperatingExpenses.ToString("N0") ج.م</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- صافي الربح النهائي -->
                    <div class="p-3 mt-4 bg-success bg-opacity-10 rounded border border-success d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="fw-bold text-success m-0">🏆 صافي الأرباح التشغيلية النهائية (Net Profit):</h4>
                            <small class="text-muted">بعد خصم كافة الخامات، أجور العمال، فواتير الغاز والكهرباء، والإيجارات</small>
                        </div>
                        <h3 class="font-monospace fw-bold text-success m-0">@incomeData.NetProfit.ToString("N0") ج.م</h3>
                    </div>
                </div>
            </div>
        }

        <!-- ==================================================== -->
        <!-- TAB 2: قائمة المركز المالي (Balance Sheet) -->
        <!-- ==================================================== -->
        @if (activeTab == 2 && balanceSheetData != null)
        {
            <div class="row g-4 mb-4">
                <!-- جانب الأصول -->
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-3 h-100">
                        <div class="card-header bg-primary text-white py-2">
                            <h6 class="m-0 fw-bold small">🏦 الأصول وممتلكات المصنع (Assets)</h6>
                        </div>
                        <div class="card-body p-3 bg-white">
                            <h6 class="fw-bold text-secondary border-bottom pb-1 mb-2 small">الأصول الثابتة (Fixed Assets)</h6>
                            <table class="table table-sm table-bordered text-center align-middle small mb-3">
                                <tbody>
                                    @foreach (var item in balanceSheetData.FixedAssets)
                                    {
                                        <tr>
                                            <td class="font-monospace text-start ps-2" style="width: 70%;">@item.Name</td>
                                            <td class="font-monospace fw-bold text-end pe-2">@item.Amount.ToString("N0") ج.م</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <h6 class="fw-bold text-secondary border-bottom pb-1 mb-2 small">الأصول المتداولة (Current Assets)</h6>
                            <table class="table table-sm table-bordered text-center align-middle small mb-3">
                                <tbody>
                                    @foreach (var item in balanceSheetData.CurrentAssets)
                                    {
                                        <tr>
                                            <td class="font-monospace text-start ps-2" style="width: 70%;">@item.Name</td>
                                            <td class="font-monospace fw-bold text-end pe-2 text-primary">@item.Amount.ToString("N0") ج.م</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="p-3 bg-primary bg-opacity-10 rounded border border-primary d-flex justify-content-between align-items-center mt-4">
                                <h6 class="fw-bold text-primary m-0">إجمالي الأصول (Total Assets):</h6>
                                <h5 class="font-monospace fw-bold text-primary m-0">@balanceSheetData.TotalAssets.ToString("N0") ج.م</h5>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- جانب الالتزامات وحقوق الملكية -->
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-3 h-100">
                        <div class="card-header bg-dark text-white py-2">
                            <h6 class="m-0 fw-bold small">📑 الالتزامات وحقوق الملكية (Liabilities & Equity)</h6>
                        </div>
                        <div class="card-body p-3 bg-white">
                            <h6 class="fw-bold text-secondary border-bottom pb-1 mb-2 small">الالتزامات المتداولة (Liabilities)</h6>
                            <table class="table table-sm table-bordered text-center align-middle small mb-3">
                                <tbody>
                                    @foreach (var item in balanceSheetData.CurrentLiabilities)
                                    {
                                        <tr>
                                            <td class="font-monospace text-start ps-2" style="width: 70%;">@item.Name</td>
                                            <td class="font-monospace fw-bold text-end pe-2 text-danger">@item.Amount.ToString("N0") ج.م</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <h6 class="fw-bold text-secondary border-bottom pb-1 mb-2 small">حقوق الملكية ورأس المال (Equity)</h6>
                            <table class="table table-sm table-bordered text-center align-middle small mb-3">
                                <tbody>
                                    @foreach (var item in balanceSheetData.Equity)
                                    {
                                        <tr>
                                            <td class="font-monospace text-start ps-2" style="width: 70%;">@item.Name</td>
                                            <td class="font-monospace fw-bold text-end pe-2">@item.Amount.ToString("N0") ج.م</td>
                                        </tr>
                                    }
                                    <tr class="table-success fw-bold">
                                        <td class="text-start ps-2">صافي أرباح تشغيل الفترة الحالية</td>
                                        <td class="font-monospace text-end pe-2 text-success">@balanceSheetData.CurrentYearNetProfit.ToString("N0") ج.م</td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="p-3 bg-dark bg-opacity-10 rounded border border-dark d-flex justify-content-between align-items-center mt-4">
                                <h6 class="fw-bold text-dark m-0">إجمالي الالتزامات وحقوق الملكية:</h6>
                                <h5 class="font-monospace fw-bold text-dark m-0">@balanceSheetData.TotalLiabilitiesAndEquity.ToString("N0") ج.م</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- مؤشر توازن المركز المالي -->
            <div class="alert @(balanceSheetData.IsBalanced ? "alert-success" : "alert-danger") text-center fw-bold shadow-sm py-2">
                @if (balanceSheetData.IsBalanced)
                {
                    <span>⚖️ الميزانية العمومية متزنة تماماً: الأصول (@balanceSheetData.TotalAssets.ToString("N0") ج.م) = الالتزامات وحقوق الملكية (@balanceSheetData.TotalLiabilitiesAndEquity.ToString("N0") ج.م) ✓</span>
                }
                else
                {
                    <span>⚠️ يوجد فارق عدم اتزان في الميزانية بمقدار: @Math.Abs(balanceSheetData.TotalAssets - balanceSheetData.TotalLiabilitiesAndEquity).ToString("N0") ج.م</span>
                }
            </div>
        }

        <!-- ==================================================== -->
        <!-- TAB 3: ميزان المراجعة بالمجاميع والأرصدة (Trial Balance) -->
        <!-- ==================================================== -->
        @if (activeTab == 3 && trialBalanceList != null)
        {
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold small">⚖️ ميزان المراجعة بالأرصدة لمصانع ومنافذ أبو عادل</h6>
                    <span class="badge bg-primary">كافة الحسابات متزنة ✓</span>
                </div>
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover table-bordered mb-0 text-center align-middle small font-monospace">
                        <thead class="table-light font-sans-serif">
                            <tr>
                                <th style="width: 130px;">كود الحساب</th>
                                <th class="text-start ps-3">اسم الحساب المالي</th>
                                <th style="width: 200px;">أرصدة مدينة (Debit)</th>
                                <th style="width: 200px;">أرصدة دائنة (Credit)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in trialBalanceList)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@item.AccountCode</td>
                                    <td class="text-start ps-3 fw-bold text-dark font-sans-serif">@item.AccountName</td>
                                    <td class="fw-bold @(item.Debit > 0 ? "text-success" : "text-muted")">
                                        @(item.Debit > 0 ? item.Debit.ToString("N0") : "-")
                                    </td>
                                    <td class="fw-bold @(item.Credit > 0 ? "text-danger" : "text-muted")">
                                        @(item.Credit > 0 ? item.Credit.ToString("N0") : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary fw-bold fs-6">
                            <tr>
                                <td colspan="2" class="text-start ps-3 font-sans-serif">إجمالي ميزان المراجعة المتوازن:</td>
                                <td class="text-success">@trialBalanceList.Sum(t => t.Debit).ToString("N0") ج.م</td>
                                <td class="text-danger">@trialBalanceList.Sum(t => t.Credit).ToString("N0") ج.م</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private int activeTab = 1; // 1: P&L, 2: Balance Sheet, 3: Trial Balance
    private bool isLoading = true;

    private IncomeStatementDto? incomeData;
    private BalanceSheetDto? balanceSheetData;
    private List<TrialBalanceItemDto>? trialBalanceList;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllReportsAsync();
    }

    private async Task LoadAllReportsAsync()
    {
        isLoading = true;
        try
        {
            incomeData = await Http.GetFromJsonAsync<IncomeStatementDto>("api/FinancialReports/income-statement");
            balanceSheetData = await Http.GetFromJsonAsync<BalanceSheetDto>("api/FinancialReports/balance-sheet");
            trialBalanceList = await Http.GetFromJsonAsync<List<TrialBalanceItemDto>>("api/FinancialReports/trial-balance");
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    public class IncomeStatementDto
    {
        public DateTime ReportDate { get; set; } = DateTime.Today;
        public string PeriodName { get; set; } = string.Empty;
        public string BranchFilter { get; set; } = string.Empty;
        public List<FinancialLineItem> Revenues { get; set; } = new();
        public List<FinancialLineItem> CostOfGoodsSold { get; set; } = new();
        public List<FinancialLineItem> OperatingExpenses { get; set; } = new();
        public decimal TotalRevenues => Revenues.Sum(r => r.Amount);
        public decimal TotalCOGS => CostOfGoodsSold.Sum(c => c.Amount);
        public decimal GrossProfit => TotalRevenues - TotalCOGS;
        public decimal TotalOperatingExpenses => OperatingExpenses.Sum(o => o.Amount);
        public decimal NetProfit => GrossProfit - TotalOperatingExpenses;
    }

    public class BalanceSheetDto
    {
        public DateTime AsOfDate { get; set; } = DateTime.Today;
        public List<FinancialLineItem> FixedAssets { get; set; } = new();
        public List<FinancialLineItem> CurrentAssets { get; set; } = new();
        public List<FinancialLineItem> CurrentLiabilities { get; set; } = new();
        public List<FinancialLineItem> Equity { get; set; } = new();
        public decimal CurrentYearNetProfit { get; set; }
        public decimal TotalFixedAssets => FixedAssets.Sum(f => f.Amount);
        public decimal TotalCurrentAssets => CurrentAssets.Sum(c => c.Amount);
        public decimal TotalAssets => TotalFixedAssets + TotalCurrentAssets;
        public decimal TotalLiabilities => CurrentLiabilities.Sum(l => l.Amount);
        public decimal TotalEquity => Equity.Sum(e => e.Amount) + CurrentYearNetProfit;
        public decimal TotalLiabilitiesAndEquity => TotalLiabilities + TotalEquity;
        public bool IsBalanced => TotalAssets == TotalLiabilitiesAndEquity;
    }

    public class FinancialLineItem
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }

    public class TrialBalanceItemDto
    {
        public string AccountCode { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
    }
}