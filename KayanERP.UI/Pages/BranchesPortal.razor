@page "/branches-portal"
@layout KayanERP.UI.Pages.EmptyLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject KayanERP.UI.Services.IBranchContextService BranchContext

<PageTitle>نظام كيان - بوابة عمليات الفروع V2.0</PageTitle>

<div class="branches-portal-screen" dir="rtl">
    <!-- الشريط العلوي مع زر الرجوع لمساحة العمل -->
    <header class="portal-top-bar">
        <div class="system-meta">
            <span>نظام كيان - لوحة التحكم المركزية</span>
        </div>
        <button class="launchpad-return-btn" @onclick="@(() => Navigation.NavigateTo("/workspace"))" title="العودة لمساحة عمل كيان">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1.5" />
                <rect x="14" y="3" width="7" height="7" rx="1.5" />
                <rect x="14" y="14" width="7" height="7" rx="1.5" />
                <rect x="3" y="14" width="7" height="7" rx="1.5" />
            </svg>
        </button>
    </header>

    <!-- رأس الصفحة المركزي -->
    <section class="portal-hero">
        <h1 class="portal-main-heading">BRANCHES OPERATIONS</h1>
        <p class="portal-sub-heading">KAYAN ENTERPRISE SYSTEM V2.0</p>
    </section>

    <!-- شبكة كروت الفروع الـ 12 التنفيذية -->
    <main class="branches-container">
        @if (isLoading)
        {
            <div class="loading-state">
                <div class="neon-pulse-spinner"></div>
                <p>جاري تحميل شبكة فروع ومنافذ كيان...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-box">
                <p>تنبيه: @errorMessage</p>
            </div>
        }
        else
        {
            <div class="branches-cards-grid">
                @foreach (var branch in branches)
                {
                    <div class="executive-branch-card @GetBranchThemeClass(branch.Code)"
                         @onclick="() => SelectBranch(branch)">

                        <div class="branch-info-stack">
                            <h3 class="branch-title">@branch.NameAr</h3>
                            <span class="branch-id-code">ID: @branch.Code</span>
                        </div>

                        <div class="branch-badge-icon">
                            @((MarkupString)GetBranchIconSvg(branch.Code))
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>

<style>
    .branches-portal-screen {
        min-height: 100vh;
        width: 100vw;
        background-color: #0D0F12;
        background-image: radial-gradient(circle at 50% 20%, rgba(20, 24, 33, 0.9) 0%, #080A0D 100%);
        color: #FFFFFF;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        box-sizing: border-box;
        overflow-x: hidden;
        padding-bottom: 4rem;
    }

    .portal-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 3rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .system-meta {
        font-size: 0.85rem;
        color: #94A3B8;
        letter-spacing: 0.02em;
    }

    .launchpad-return-btn {
        width: 44px;
        height: 44px;
        background: #151922;
        border: 1px solid #2A3241;
        border-radius: 12px;
        color: #60A5FA;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .launchpad-return-btn:hover {
            background: #1E293B;
            border-color: #3B82F6;
            color: #93C5FD;
            transform: scale(1.05);
        }

        .launchpad-return-btn svg {
            width: 22px;
            height: 22px;
        }

    .portal-hero {
        text-align: center;
        padding: 3rem 1rem 2.5rem 1rem;
    }

    .portal-main-heading {
        font-size: 2.25rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        margin: 0;
        color: #F8FAFC;
    }

    .portal-sub-heading {
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        color: #64748B;
        margin: 0.5rem 0 0 0;
    }

    .branches-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .branches-cards-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    @@media (max-width: 1200px) {
        .branches-cards-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 860px) {
        .branches-cards-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 540px) {
        .branches-cards-grid {
            grid-template-columns: 1fr;
        }
    }

    .executive-branch-card {
        background: #14171F;
        border: 1px solid #1E232E;
        border-radius: 14px;
        padding: 1.75rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .executive-branch-card:hover {
            transform: translateY(-4px);
            background: #191E29;
            border-color: #334155;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
        }

    .branch-info-stack {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .branch-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #FFFFFF;
        margin: 0;
    }

    .branch-id-code {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748B;
        letter-spacing: 0.05em;
        font-family: monospace;
    }

    .branch-badge-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
    }

    .executive-branch-card:hover .branch-badge-icon {
        transform: scale(1.1);
    }

    .branch-badge-icon svg {
        width: 24px;
        height: 24px;
    }

    /* ألوان وهوية الأيقونات والكروت المطابقة للتصميم */
    .theme-retail .branch-badge-icon {
        background: rgba(30, 41, 59, 0.8);
        color: #38BDF8;
    }

    .theme-purple .branch-badge-icon {
        background: rgba(88, 28, 135, 0.2);
        color: #C084FC;
    }

    .theme-emerald .branch-badge-icon {
        background: rgba(6, 78, 59, 0.25);
        color: #34D399;
    }

    .theme-factory .branch-badge-icon {
        background: rgba(120, 53, 15, 0.25);
        color: #FBBF24;
    }

    .theme-logistics .branch-badge-icon {
        background: rgba(30, 58, 138, 0.25);
        color: #60A5FA;
    }

    .loading-state {
        text-align: center;
        padding: 5rem 1rem;
        color: #94A3B8;
    }

    .neon-pulse-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #1E293B;
        border-top-color: #3B82F6;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 1.5rem auto;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private List<KayanERP.UI.Services.ActiveBranchDto> branches = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var result = await Http.GetFromJsonAsync<List<KayanERP.UI.Services.ActiveBranchDto>>("api/v1/Branches/operations-summary");
            if (result is not null && result.Any())
            {
                branches = result;
            }
            else
            {
                errorMessage = "لم يتم العثور على فروع مسجلة بقاعدة البيانات.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "تعذر الاتصال بالخادم: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectBranch(KayanERP.UI.Services.ActiveBranchDto branch)
    {
        // 1. تثبيت سياق الفرع في الـ Context
        await BranchContext.SetActiveBranchAsync(branch);

        // 2. التوجيه لشاشة فواتير المبيعات للفرع المختار (أو لوحة المتابعة المعزولة)
        Navigation.NavigateTo($"/SalesInvoices?branchId={branch.Id}");
    }

    private string GetBranchThemeClass(string code) => code switch
    {
        "BRANCH1" => "theme-purple",
        "BRANCH3" or "BRANCH4" or "BRANCH8" => "theme-emerald",
        "BRANCH5" or "BRANCH9" => "theme-purple",
        "BRANCH11" => "theme-logistics",
        "BRANCH12" => "theme-factory",
        _ => "theme-retail"
    };

    private string GetBranchIconSvg(string code) => code switch
    {
        "BRANCH1" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>",
        "BRANCH2" or "BRANCH10" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='2' y='7' width='20' height='14' rx='2'/><path d='M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16'/></svg>",
        "BRANCH3" or "BRANCH4" or "BRANCH6" or "BRANCH8" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z'/><rect x='3' y='4' width='18' height='16' rx='2'/></svg>",
        "BRANCH7" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='9' cy='21' r='1'/><circle cx='20' cy='21' r='1'/><path d='M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6'/></svg>",
        "BRANCH9" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M2 20h20'/><path d='M5 20V8l5 4V4l5 4v12'/></svg>",
        "BRANCH11" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='1' y='3' width='15' height='13'/><polygon points='16 8 20 8 23 11 23 16 16 16 16 8'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/></svg>",
        "BRANCH12" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M12 2v4'/><path d='M12 18v4'/><path d='M4.93 4.93l2.83 2.83'/><path d='M16.24 16.24l2.83 2.83'/><path d='M2 12h4'/><path d='M18 12h4'/><circle cx='12' cy='12' r='4'/></svg>",
        _ => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M9 3v18'/></svg>"
    };
}