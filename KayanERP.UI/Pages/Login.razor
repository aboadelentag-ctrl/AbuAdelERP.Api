@page "/login"
@layout KayanERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@using KayanERP.UI.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AppState State

<PageTitle>تسجيل الدخول الموحد - منصة كيان السحابية</PageTitle>

<div class="kayan-login-viewport" dir="rtl">
    <div class="network-canvas-bg"></div>

    <div class="login-center-card shadow-lg">
        
        <!-- الهيدر والشعار -->
        <div class="text-center mb-4">
            <div class="glowing-logo-container mb-2">
                <svg class="kayan-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                </svg>
            </div>
            <h3 class="fw-bold text-white mb-0">منصة كيان السحابية</h3>
            <span class="text-muted small">KAYAN ENTERPRISE • ANTIGRAVITY v2.0</span>
        </div>

        <!-- مؤشر مسار الخطوتين -->
        <div class="step-indicator-wrapper mb-4">
            <div class="step-item @(currentStep == 1 ? "active" : "completed")">
                <span class="step-circle">1</span>
                <span class="step-label">اعتماد المنشأة</span>
            </div>
            <div class="step-connector @(currentStep == 2 ? "active" : "")"></div>
            <div class="step-item @(currentStep == 2 ? "active" : "")">
                <span class="step-circle">2</span>
                <span class="step-label">دخول المستخدم</span>
            </div>
        </div>

        <!-- رسائل الخطأ -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 small fw-bold text-center border-0 shadow-sm mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
            </div>
        }

        <!-- ============================================== -->
        <!-- المرحلة 1: التحقق من هوية المنشأة المستأجرة    -->
        <!-- ============================================== -->
        @if (currentStep == 1)
        {
            <form @onsubmit="VerifyTenantAsync">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-light">كود / اسم المنشأة المستأجرة <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-buildings"></i></span>
                        <input type="text" class="form-control bg-dark text-white border-secondary fw-bold" 
                               placeholder="مثال: ABUADEL" @bind="tenantCode" required autofocus />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-light">مفتاح الدخول السري للمنشأة (Tenant Key) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-warning"><i class="bi bi-key-fill"></i></span>
                        <input type="password" class="form-control bg-dark text-white border-secondary font-monospace" 
                               placeholder="••••••••••••" @bind="tenantKey" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>جاري التحقق من ترخيص المنشأة...</span>
                    }
                    else
                    {
                        <span>التالي: اعتماد المنشأة والمتابعة ⭢</span>
                    }
                </button>
            </form>
        }
        else
        {
            <!-- ============================================== -->
            <!-- المرحلة 2: تسجيل دخول المستخدم التابع للمنشأة   -->
            <!-- ============================================== -->
            <div class="verified-tenant-banner mb-3 p-2 rounded-2 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small d-block" style="font-size: 10px;">المنشأة المعتمدة:</span>
                    <strong class="text-success small">🏢 @verifiedCompanyName</strong>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;" @onclick="ResetToTenantStep">
                    تغيير المنشأة
                </button>
            </div>

            <form @onsubmit="LoginUserAsync">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-light">اسم المستخدم الشخصي <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-light"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control bg-dark text-white border-secondary fw-bold" 
                               placeholder="اسم المستخدم" @bind="username" required autofocus />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-light">كلمة المرور الشخصية <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-light"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control bg-dark text-white border-secondary font-monospace" 
                               placeholder="••••••••" @bind="password" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 fw-bold shadow-sm" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>جاري تفعيل الصلاحيات...</span>
                    }
                    else
                    {
                        <span>تسجيل الدخول لمنظومة كيان ✓</span>
                    }
                </button>
            </form>
        }

        <div class="text-center mt-4">
            <span class="text-muted small" style="font-size: 11px;">نظام الرقابة والحوكمة السحابية الصارم © 2026</span>
        </div>
    </div>
</div>

<style>
    .kayan-login-viewport {
        min-height: 100vh;
        width: 100vw;
        background-color: #030712;
        background-image: 
            radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.15) 0%, transparent 60%),
            radial-gradient(circle at 80% 80%, rgba(168, 85, 247, 0.1) 0%, transparent 50%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        position: relative;
    }

    .network-canvas-bg {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(147, 51, 234, 0.2) 1px, transparent 1px);
        background-size: 40px 40px;
        opacity: 0.6;
        pointer-events: none;
    }

    .login-center-card {
        position: relative;
        z-index: 5;
        width: 100%;
        max-width: 440px;
        background: rgba(17, 24, 39, 0.85);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 2.25rem;
    }

    .glowing-logo-container {
        width: 56px;
        height: 56px;
        margin: 0 auto;
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.3), rgba(99, 102, 241, 0.2));
        border: 1px solid rgba(192, 132, 252, 0.4);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #C084FC;
        box-shadow: 0 0 25px rgba(168, 85, 247, 0.3);
    }

    .kayan-icon-svg { width: 30px; height: 30px; }

    .step-indicator-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .step-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: #64748B;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .step-item.active { color: #818CF8; }
    .step-item.completed { color: #10B981; }

    .step-circle {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #1E293B;
        border: 1px solid #334155;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
    }

    .step-item.active .step-circle {
        background: #4F46E5;
        border-color: #6366F1;
        color: #FFF;
        box-shadow: 0 0 10px rgba(99, 102, 241, 0.5);
    }

    .step-item.completed .step-circle {
        background: #10B981;
        border-color: #10B981;
        color: #FFF;
    }

    .step-connector {
        flex: 1;
        height: 2px;
        background: #334155;
        max-width: 40px;
    }

    .step-connector.active { background: #10B981; }

    .verified-tenant-banner {
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.25);
    }
</style>

@code {
    private int currentStep = 1;
    private bool isLoading = false;
    private string? errorMessage;

    // مدخلات الخطوة 1
    private string tenantCode = "ABUADEL";
    private string tenantKey = "AbuAdel@2026";
    private long verifiedCompanyId = 0;
    private string verifiedCompanyName = "";

    // مدخلات الخطوة 2
    private string username = "";
    private string password = "";

    private async Task VerifyTenantAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var payload = new { TenantCode = tenantCode.Trim(), TenantKey = tenantKey.Trim() };
            var response = await Http.PostAsJsonAsync("api/auth/verify-tenant", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<TenantVerifyResult>();
                if (result != null && result.Success)
                {
                    verifiedCompanyId = result.CompanyId;
                    verifiedCompanyName = result.CompanyName;
                    currentStep = 2; // الانتقال التلقائي للخطوة الثانية
                }
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ اتصال: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoginUserAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var payload = new 
            { 
                CompanyId = verifiedCompanyId, 
                Username = username.Trim(), 
                Password = password.Trim() 
            };

            var response = await Http.PostAsJsonAsync("api/auth/login-user", payload);

            if (response.IsSuccessStatusCode)
            {
                var userResult = await response.Content.ReadFromJsonAsync<UserLoginResult>();
                if (userResult != null && userResult.Success)
                {
                    // حفظ الجلسة والصلاحيات التفصيلية للأزرار
                    State.SetUserSession(
                        userResult.UserId,
                        userResult.Username,
                        userResult.FullName,
                        userResult.CompanyId,
                        userResult.CompanyName,
                        userResult.Role,
                        userResult.EmployeeCode,
                        userResult.DepartmentName,
                        userResult.Permissions
                    );

                    Navigation.NavigateTo("/workspace", forceLoad: true);
                }
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetToTenantStep()
    {
        currentStep = 1;
        errorMessage = null;
        password = "";
    }

    public class TenantVerifyResult
    {
        public bool Success { get; set; }
        public long CompanyId { get; set; }
        public string CompanyName { get; set; } = "";
    }

    public class UserLoginResult
    {
        public bool Success { get; set; }
        public long UserId { get; set; }
        public string Username { get; set; } = "";
        public string FullName { get; set; } = "";
        public long CompanyId { get; set; }
        public string CompanyName { get; set; } = "";
        public string Role { get; set; } = "";
        public string EmployeeCode { get; set; } = "";
        public string DepartmentName { get; set; } = "";
        public List<string> Permissions { get; set; } = new();
    }
}