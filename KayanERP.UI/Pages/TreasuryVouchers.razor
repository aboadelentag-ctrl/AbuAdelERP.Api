@page "/treasury-vouchers"
@page "/finance/vouchers"
@layout KayanERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>إدارة الخزائن وسندات القبض والصرف - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">
    <!-- رأس الشاشة التنفيذي -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h4 class="text-primary m-0 mb-1 fw-bold">💵 إدارة الخزائن وسندات القبض والصرف</h4>
            <span class="text-muted small">إثبات تحصيلات التجار، سداد المصروفات، والربط التلقائي بشجرة الحسابات والعملاء</span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm fw-bold shadow-sm px-3" @onclick="LoadDataAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> تحديث
            </button>
            <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick='() => OpenVoucherModal("RECEIPT")'>
                📥 إصدار سند قبض (تحصيل)
            </button>
            <button class="btn btn-danger btn-sm fw-bold shadow-sm px-3" @onclick='() => OpenVoucherModal("PAYMENT")'>
                📤 إصدار سند صرف (مصروفات)
            </button>
        </div>
    </div>

    <!-- رسائل النظام -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") py-2 small fw-bold alert-dismissible fade show shadow-sm" role="alert">
            @statusMessage
            <button type="button" class="btn-close py-2" @onclick='() => statusMessage = ""'></button>
        </div>
    }

    <!-- بطاقات المؤشرات اللحظية للسيولة النقدية -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي المقبوضات والتحصيلات</small>
                <h4 class="mb-0 fw-bold text-success mt-1 font-monospace">@totalReceipts.ToString("N0") ج.م</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-danger border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي المصروفات والمدفوعات</small>
                <h4 class="mb-0 fw-bold text-danger mt-1 font-monospace">@totalPayments.ToString("N0") ج.م</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <small class="text-muted fw-bold">صافي السيولة النقدية بالخزائن</small>
                <h4 class="mb-0 fw-bold text-primary mt-1 font-monospace">@netLiquidity.ToString("N0") ج.م</h4>
            </div>
        </div>
    </div>

    <!-- شريط البحث والتصفية -->
    <div class="card shadow-sm border-0 mb-3 bg-white">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="ابحث برقم السند، اسم التاجر، أو البيان..." @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm fw-bold border-primary" @bind="selectedTypeFilter">
                        <option value="">-- كافة السندات (قبض وصرف) --</option>
                        <option value="RECEIPT">سندات القبض (تحصيلات النقدية)</option>
                        <option value="PAYMENT">سندات الصرف (المدفوعات والمصروفات)</option>
                    </select>
                </div>
                <div class="col-md-5 text-md-end text-muted small">
                    إجمالي السندات المعروضة: <strong class="text-primary font-monospace">@FilteredVouchers.Count()</strong> سند
                </div>
            </div>
        </div>
    </div>

    <!-- جدول عرض السندات النقدية -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold small">📋 دفتر حركة الخزينة وسندات القيود المعتمدة</h6>
            <span class="badge bg-primary font-monospace">القيود متزنة آلياً ✓</span>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                <thead class="table-light">
                    <tr>
                        <th style="width: 120px;">رقم السند</th>
                        <th>النوع</th>
                        <th>التاريخ</th>
                        <th>المبلغ المسدد</th>
                        <th>الخزينة المودع/المنصرف منها</th>
                        <th class="text-start ps-3">الطرف المعني (التاجر / المصروف)</th>
                        <th>الفرع التابع</th>
                        <th>طريقة السداد</th>
                        <th class="text-start ps-3">البيان والشرح</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredVouchers.Any())
                    {
                        <tr><td colspan="9" class="text-muted py-4 fw-bold">لا توجد سندات مسجلة تطابق خيارات البحث.</td></tr>
                    }
                    else
                    {
                        @foreach (var v in FilteredVouchers)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@v.VoucherNumber</td>
                                <td>
                                    <span class="badge @(v.VoucherType == "RECEIPT" ? "bg-success" : "bg-danger") px-2 py-1">
                                        @(v.VoucherType == "RECEIPT" ? "سند قبض 📥" : "سند صرف 📤")
                                    </span>
                                </td>
                                <td class="font-monospace">@v.VoucherDate.ToString("yyyy-MM-dd")</td>
                                <td class="font-monospace fw-bold @(v.VoucherType == "RECEIPT" ? "text-success" : "text-danger") fs-6">
                                    @v.Amount.ToString("N0") ج.م
                                </td>
                                <td><span class="badge bg-light text-dark border font-monospace">@v.TreasuryName</span></td>
                                <td class="text-start ps-3 fw-bold text-dark">@v.PartyName</td>
                                <td><span class="badge bg-info text-dark">@v.BranchName</span></td>
                                <td><span class="badge bg-secondary">@v.PaymentMethod</span></td>
                                <td class="text-start ps-3 text-muted text-truncate" style="max-width: 240px;" title="@v.Description">
                                    @v.Description
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- نافذة إصدار سند جديد مع مصفوفة القيد المحاسبي المزدوج -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header @(activeVoucher.VoucherType == "RECEIPT" ? "bg-success" : "bg-danger") text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">
                        @(activeVoucher.VoucherType == "RECEIPT" ? "📥 إصدار سند قبض نقدي (تحصيل من تاجر / عميل)" : "📤 إصدار سند صرف نقدي (سداد مصروفات تشغيل)")
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <div class="card p-3 border-0 shadow-sm bg-white mb-3">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">المبلغ المطلوب سداده (ج.م) *</label>
                                <input type="number" class="form-control form-control-lg font-monospace fw-bold text-primary" @bind="activeVoucher.Amount" placeholder="0.00" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">تاريخ السند *</label>
                                <input type="date" class="form-control form-control-sm font-monospace fw-bold" @bind="activeVoucher.VoucherDate" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">الخزينة المودع بها / المنصرف منها *</label>
                                <select class="form-select form-select-sm fw-bold border-primary" @bind="activeVoucher.TreasuryCode" @bind:after="OnTreasuryChanged">
                                    <option value="1212">1212 - خزينة فرع التوزيع الخارجي</option>
                                    <option value="1211">1211 - الخزينة الرئيسية (المصنع)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">الفرع التابع للسند</label>
                                <select class="form-select form-select-sm fw-bold" @bind="activeVoucher.BranchName">
                                    <option value="فرع المبيعات الخارجية والتوزيع">فرع المبيعات الخارجية والتوزيع</option>
                                    <option value="المعرض الرئيسي (المصنع)">المعرض الرئيسي (المصنع)</option>
                                    <option value="فرع وسط البلد">فرع وسط البلد</option>
                                </select>
                            </div>

                            @if (activeVoucher.VoucherType == "RECEIPT")
                            {
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-dark">اختيار التاجر / العميل (من الشجرة) *</label>
                                    <select class="form-select form-select-sm fw-bold border-success" @bind="selectedPartyId" @bind:after="OnCustomerSelected">
                                        <option value="0">-- اختر التاجر من القائمة --</option>
                                        @foreach (var p in partiesList)
                                        {
                                            <option value="@p.Id">[@p.Code] @p.Name</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-dark">بند المصروف / الجهة المستفيدة *</label>
                                    <input type="text" class="form-control form-control-sm fw-bold" @bind="activeVoucher.PartyName" placeholder="مثال: غاز صالة الشرقي، قطع غيار عجانة" />
                                </div>
                            }

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">طريقة الدفع والتحصيل</label>
                                <select class="form-select form-select-sm" @bind="activeVoucher.PaymentMethod">
                                    <option value="نقدي (كاش)">نقدي (كاش)</option>
                                    <option value="تحويل بنكي / محفظة إلكترونية">تحويل بنكي / فودافون كاش</option>
                                    <option value="شيك بنكي">شيك بنكي</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">البيان والشرح التفصيلي للحركة *</label>
                                <input type="text" class="form-control form-control-sm" @bind="activeVoucher.Description" placeholder="مثال: سداد دفعة نقدية عن طلبيات الأسبوع الجاري..." />
                            </div>
                        </div>
                    </div>

                    <!-- معاينة القيد المحاسبي المزدوج الآلي -->
                    <div class="card p-3 border-0 shadow-sm bg-white border-start border-4 border-info">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-info small m-0">⚖️ القيد المحاسبي المتولد آلياً (Double-Entry Verification):</h6>
                            <span class="badge bg-success">متزن 100%</span>
                        </div>
                        <table class="table table-sm table-bordered text-center align-middle small mb-0 font-monospace">
                            <thead class="table-light">
                                <tr>
                                    <th>طرف القيد</th>
                                    <th>كود الحساب</th>
                                    <th>اسم الحساب المالي</th>
                                    <th>مدين (Debit)</th>
                                    <th>دائن (Credit)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (activeVoucher.VoucherType == "RECEIPT")
                                {
                                    <tr>
                                        <td class="fw-bold text-success">من حـ/ (مدين)</td>
                                        <td>@activeVoucher.TreasuryCode</td>
                                        <td>@activeVoucher.TreasuryName</td>
                                        <td class="fw-bold text-success">@activeVoucher.Amount.ToString("N0")</td>
                                        <td>0</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-primary">إلى حـ/ (دائن)</td>
                                        <td>1221</td>
                                        <td>@(!string.IsNullOrEmpty(activeVoucher.PartyName) ? activeVoucher.PartyName : "حسابات كبار التجار الموزعين")</td>
                                        <td>0</td>
                                        <td class="fw-bold text-primary">@activeVoucher.Amount.ToString("N0")</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td class="fw-bold text-danger">من حـ/ (مدين)</td>
                                        <td>53</td>
                                        <td>@(!string.IsNullOrEmpty(activeVoucher.PartyName) ? activeVoucher.PartyName : "مصاريف غاز وصيانة الصالات")</td>
                                        <td class="fw-bold text-danger">@activeVoucher.Amount.ToString("N0")</td>
                                        <td>0</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-primary">إلى حـ/ (دائن)</td>
                                        <td>@activeVoucher.TreasuryCode</td>
                                        <td>@activeVoucher.TreasuryName</td>
                                        <td>0</td>
                                        <td class="fw-bold text-primary">@activeVoucher.Amount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-3" @onclick="() => isModalOpen = false">إلغاء</button>
                    <button class="btn @(activeVoucher.VoucherType == "RECEIPT" ? "btn-success" : "btn-danger") btn-sm px-4 fw-bold shadow-sm" @onclick="SaveVoucherAsync">
                        💾 ترحيل السند واعتماد الأثر المالي
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TreasuryVoucherDto> vouchersList = new();
    private List<PartyLookupDto> partiesList = new();
    private string searchTerm = "";
    private string selectedTypeFilter = "";
    private bool isModalOpen = false;
    private TreasuryVoucherDto activeVoucher = new();
    private long selectedPartyId = 0;

    private decimal totalReceipts = 0;
    private decimal totalPayments = 0;
    private decimal netLiquidity = 0;
    private string statusMessage = "";
    private bool isSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await LoadPartiesLookup();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            vouchersList = await Http.GetFromJsonAsync<List<TreasuryVoucherDto>>("api/TreasuryVouchers") ?? new();
            CalculateSummary();
        }
        catch { }
    }

    private async Task LoadPartiesLookup()
    {
        try
        {
            partiesList = await Http.GetFromJsonAsync<List<PartyLookupDto>>("api/TreasuryVouchers/parties-lookup") ?? new();
        }
        catch { }
    }

    private void CalculateSummary()
    {
        totalReceipts = vouchersList.Where(v => v.VoucherType == "RECEIPT").Sum(v => v.Amount);
        totalPayments = vouchersList.Where(v => v.VoucherType == "PAYMENT").Sum(v => v.Amount);
        netLiquidity = totalReceipts - totalPayments;
    }

    private IEnumerable<TreasuryVoucherDto> FilteredVouchers => vouchersList.Where(v =>
        (string.IsNullOrEmpty(selectedTypeFilter) || v.VoucherType == selectedTypeFilter) &&
        (string.IsNullOrWhiteSpace(searchTerm) ||
         v.VoucherNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
         v.PartyName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
         v.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
    );

    private void OpenVoucherModal(string type)
    {
        activeVoucher = new TreasuryVoucherDto
        {
            VoucherType = type,
            VoucherDate = DateTime.Today,
            Amount = 0,
            TreasuryCode = "1212",
            TreasuryName = "خزينة فرع التوزيع الخارجي",
            BranchName = "فرع المبيعات الخارجية والتوزيع",
            PaymentMethod = "نقدي (كاش)",
            PartyName = type == "RECEIPT" ? "" : "مصاريف صيانة صالة الشرقي",
            Description = type == "RECEIPT" ? "سداد دفعة نقدية من التاجر" : "سداد مصروفات تشغيلية للصالة"
        };
        selectedPartyId = 0;
        isModalOpen = true;
    }

    private void OnTreasuryChanged()
    {
        if (activeVoucher.TreasuryCode == "1211")
        {
            activeVoucher.TreasuryName = "الخزينة الرئيسية - المصنع";
            activeVoucher.BranchName = "المعرض الرئيسي (المصنع)";
        }
        else
        {
            activeVoucher.TreasuryName = "خزينة فرع التوزيع الخارجي";
            activeVoucher.BranchName = "فرع المبيعات الخارجية والتوزيع";
        }
    }

    private void OnCustomerSelected()
    {
        var cust = partiesList.FirstOrDefault(p => p.Id == selectedPartyId);
        if (cust != null)
        {
            activeVoucher.PartyId = cust.Id;
            activeVoucher.PartyName = cust.Name;
            activeVoucher.Description = $"تحصيل دفعة نقدية من التاجر [{cust.Name}]";
        }
    }

    private async Task SaveVoucherAsync()
    {
        if (activeVoucher.Amount <= 0)
        {
            statusMessage = "⚠️ يرجى إدخال مبلغ صحيح أكبر من الصفر.";
            isSuccess = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(activeVoucher.PartyName))
        {
            statusMessage = "⚠️ يرجى تحديد اسم التاجر أو بند المصروف.";
            isSuccess = false;
            return;
        }

        try
        {
            var res = await Http.PostAsJsonAsync("api/TreasuryVouchers", activeVoucher);
            if (res.IsSuccessStatusCode)
            {
                statusMessage = $"✅ تم ترحيل السند واعتماد أثره المالي بنجاح!";
                isSuccess = true;
                isModalOpen = false;
                await LoadDataAsync();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                statusMessage = $"❌ تعذر الحفظ: {err}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ اتصال: {ex.Message}";
            isSuccess = false;
        }
    }

    public class TreasuryVoucherDto
    {
        public long Id { get; set; }
        public string VoucherNumber { get; set; } = string.Empty;
        public string VoucherType { get; set; } = "RECEIPT";
        public DateTime VoucherDate { get; set; } = DateTime.Today;
        public decimal Amount { get; set; }
        public string TreasuryCode { get; set; } = "1212";
        public string TreasuryName { get; set; } = "خزينة فرع التوزيع الخارجي";
        public string BranchName { get; set; } = "فرع المبيعات الخارجية والتوزيع";
        public string PartyType { get; set; } = "CUSTOMER";
        public long? PartyId { get; set; }
        public string PartyName { get; set; } = string.Empty;
        public string OppositeAccountCode { get; set; } = "1221";
        public string OppositeAccountName { get; set; } = "حسابات كبار التجار والعملاء";
        public string PaymentMethod { get; set; } = "نقدي (كاش)";
        public string Description { get; set; } = string.Empty;
        public string CreatedBy { get; set; } = "System";
    }

    public class PartyLookupDto
    {
        public long Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
    }
}