@page "/chart-of-accounts"
@page "/finance/accounts"
@layout KayanERP.UI.Pages.EmptyLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>دليل شجرة الحسابات والمركز المالي - حلواني أبو عادل</PageTitle>

<div class="container-fluid px-4 py-3" dir="rtl">
    <!-- رأس الشاشة المالي -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <h4 class="text-primary m-0 mb-1 fw-bold">🏛️ دليل شجرة الحسابات والرقابة المالية (COA)</h4>
            <span class="text-muted small">هندسة الحسابات العامة، مراقبة تكاليف الإنتاج، وأرصدة الأصول والالتزامات اللحظية</span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm fw-bold shadow-sm px-3" @onclick="LoadAccounts">
                <i class="bi bi-arrow-clockwise me-1"></i> تحديث الأرصدة
            </button>
            <button class="btn btn-success btn-sm fw-bold shadow-sm px-3" @onclick="OpenAddModal">
                ➕ إضافة حساب مالي جديد
            </button>
        </div>
    </div>

    <!-- بطاقات المؤشرات المالية اللحظية (Financial Overview) -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي الأصول (Assets)</small>
                <h4 class="mb-0 fw-bold text-primary mt-1 font-monospace">@totalAssets.ToString("N0") ج.م</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-danger border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي الالتزامات (Liabilities)</small>
                <h4 class="mb-0 fw-bold text-danger mt-1 font-monospace">@totalLiabilities.ToString("N0") ج.م</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3 bg-white">
                <small class="text-muted fw-bold">إجمالي الإيرادات المحققة</small>
                <h4 class="mb-0 fw-bold text-success mt-1 font-monospace">@totalRevenues.ToString("N0") ج.م</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 p-3 bg-white">
                <small class="text-muted fw-bold">صافي أرباح التشغيل الحالية</small>
                <h4 class="mb-0 fw-bold text-dark mt-1 font-monospace">@netProfit.ToString("N0") ج.م</h4>
            </div>
        </div>
    </div>

    <!-- شريط البحث والتصفية -->
    <div class="card shadow-sm border-0 mb-3 bg-white">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-sm" placeholder="ابحث برقم الحساب أو الاسم..." @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <select class="form-select form-select-sm fw-bold border-primary" @bind="selectedTypeFilter">
                        <option value="0">-- كافة أنواع الحسابات --</option>
                        <option value="1">الأصول (Assets)</option>
                        <option value="2">الالتزامات (Liabilities)</option>
                        <option value="3">حقوق الملكية (Equity)</option>
                        <option value="4">الإيرادات (Revenues)</option>
                        <option value="5">التكاليف والمصروفات (Expenses)</option>
                    </select>
                </div>
                <div class="col-md-4 text-md-end text-muted small">
                    إجمالي الحسابات بالدليل: <strong class="text-primary font-monospace">@accountsList.Count</strong> حساب
                </div>
            </div>
        </div>
    </div>

    <!-- جدول عرض شجرة الحسابات التفاعلي -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold small">📋 الدليل المحاسبي العام الموحد لمصانع ومنافذ أبو عادل</h6>
            <span class="badge bg-primary">ميزان مالي متوازن ✓</span>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered mb-0 text-center align-middle small">
                <thead class="table-light">
                    <tr>
                        <th style="width: 120px;">رقم الحساب</th>
                        <th class="text-start ps-4">اسم الحساب في الشجرة</th>
                        <th>التصنيف المالي</th>
                        <th>مستوى الحساب</th>
                        <th>طبيعة الحساب</th>
                        <th>الرصيد الجاري الحالي</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in FilteredAccounts)
                    {
                        <tr class="@(!acc.IsSubAccount ? "table-light fw-bold" : "")">
                            <td class="font-monospace text-primary fw-bold">@acc.AccountCode</td>
                            <td class="text-start" style="padding-right: @(acc.Level * 22)px;">
                                @if (!acc.IsSubAccount)
                                {
                                    <span class="text-dark"><i class="bi bi-folder2-open text-warning me-1"></i> @acc.AccountName</span>
                                }
                                else
                                {
                                    <span class="text-secondary"><i class="bi bi-file-earmark-text text-primary me-1"></i> @acc.AccountName</span>
                                }
                            </td>
                            <td>
                                <span class="badge @GetTypeBadge(acc.Type)">@GetTypeArabic(acc.Type)</span>
                            </td>
                            <td class="font-monospace">مستوى @acc.Level</td>
                            <td>
                                @if (acc.IsSubAccount)
                                {
                                    <span class="badge bg-light text-dark border">فرعي (يقبل قيود)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">رئيسي (تجميعي)</span>
                                }
                            </td>
                            <td class="font-monospace fw-bold @(acc.CurrentBalance > 0 ? "text-dark" : "text-muted")">
                                @acc.CurrentBalance.ToString("N0") ج.م
                            </td>
                            <td>
                                <span class="badge bg-success px-2 py-1">نشط ✓</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- مودال إضافة حساب مالي جديد -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" dir="rtl">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white py-2 px-3">
                    <h6 class="modal-title fw-bold">➕ إضافة حساب مالي جديد بالدليل</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isModalOpen = false"></button>
                </div>
                <div class="modal-body bg-light p-3">
                    <div class="card p-3 border-0 shadow-sm bg-white">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">رقم / كود الحساب *</label>
                                <input type="text" class="form-control form-control-sm font-monospace fw-bold" @bind="newAccount.AccountCode" placeholder="مثال: 1215" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">التصنيف المالي *</label>
                                <select class="form-select form-select-sm fw-bold border-primary" @bind="newAccount.Type">
                                    <option value="1">أصول (Assets)</option>
                                    <option value="2">التزامات (Liabilities)</option>
                                    <option value="3">حقوق ملكية (Equity)</option>
                                    <option value="4">إيرادات (Revenues)</option>
                                    <option value="5">مصروفات وتكاليف (Expenses)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">اسم الحساب العربي المعياري *</label>
                                <input type="text" class="form-control form-control-sm fw-bold" @bind="newAccount.AccountName" placeholder="مثال: عهدة سيارة توزيع رقم 3" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">مستوى الحساب</label>
                                <input type="number" class="form-control form-control-sm font-monospace" @bind="newAccount.Level" min="1" max="5" />
                            </div>
                            <div class="col-md-6 d-flex align-items-center pt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="isSub" @bind="newAccount.IsSubAccount" />
                                    <label class="form-check-label small fw-bold" for="isSub">حساب فرعي يقبل القيود</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-white d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm px-3" @onclick="() => isModalOpen = false">إلغاء</button>
                    <button class="btn btn-success btn-sm px-4 fw-bold shadow-sm" @onclick="SaveAccountAsync">💾 تثبيت الحساب</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AccountDto> accountsList = new();
    private string searchTerm = "";
    private int selectedTypeFilter = 0;
    private bool isModalOpen = false;
    private AccountDto newAccount = new();

    private decimal totalAssets = 0;
    private decimal totalLiabilities = 0;
    private decimal totalRevenues = 0;
    private decimal netProfit = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        try
        {
            accountsList = await Http.GetFromJsonAsync<List<AccountDto>>("api/Accounts") ?? new();
            CalculateTotals();
        }
        catch { }
    }

    private void CalculateTotals()
    {
        totalAssets = accountsList.Where(a => a.Type == 1 && a.IsSubAccount).Sum(a => a.CurrentBalance);
        totalLiabilities = accountsList.Where(a => a.Type == 2 && a.IsSubAccount).Sum(a => a.CurrentBalance);
        totalRevenues = accountsList.Where(a => a.Type == 4 && a.IsSubAccount).Sum(a => a.CurrentBalance);
        var totalExpenses = accountsList.Where(a => a.Type == 5 && a.IsSubAccount).Sum(a => a.CurrentBalance);
        netProfit = totalRevenues - totalExpenses;
    }

    private IEnumerable<AccountDto> FilteredAccounts => accountsList.Where(a =>
        (selectedTypeFilter == 0 || (int)a.Type == selectedTypeFilter) &&
        (string.IsNullOrWhiteSpace(searchTerm) ||
         a.AccountName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
         a.AccountCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
    );

    private void OpenAddModal()
    {
        newAccount = new AccountDto { Level = 4, IsSubAccount = true, Type = 1 };
        isModalOpen = true;
    }

    private async Task SaveAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(newAccount.AccountName) || string.IsNullOrWhiteSpace(newAccount.AccountCode))
            return;

        try
        {
            var res = await Http.PostAsJsonAsync("api/Accounts", newAccount);
            if (res.IsSuccessStatusCode)
            {
                isModalOpen = false;
                await LoadAccounts();
            }
        }
        catch { }
    }

    private string GetTypeBadge(int type) => type switch
    {
        1 => "bg-primary text-white",
        2 => "bg-danger text-white",
        3 => "bg-info text-dark",
        4 => "bg-success text-white",
        5 => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string GetTypeArabic(int type) => type switch
    {
        1 => "أصول (Assets)",
        2 => "التزامات (Liabilities)",
        3 => "حقوق ملكية (Equity)",
        4 => "إيرادات (Revenues)",
        5 => "مصروفات (Expenses)",
        _ => "عام"
    };

    public class AccountDto
    {
        public long Id { get; set; }
        public string AccountCode { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public int Type { get; set; }
        public long? ParentId { get; set; }
        public int Level { get; set; } = 1;
        public bool IsSubAccount { get; set; } = true;
        public decimal CurrentBalance { get; set; }
        public bool IsActive { get; set; } = true;
    }
}