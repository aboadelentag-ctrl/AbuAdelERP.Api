@code {
    private string searchTerm = "";
    private string selectedCategory = "ALL";

    private void NavigateTo(string url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            Navigation.NavigateTo(url);
        }
    }

    private bool IsVisible(string categoryCode, string searchKeywords)
    {
        // 1. فحص فلتر التبويب
        if (selectedCategory != "ALL" && selectedCategory != categoryCode)
        {
            return false;
        }

        // 2. فحص نص البحث
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        return searchKeywords.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase);
    }
}