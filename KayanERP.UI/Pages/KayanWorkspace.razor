@page "/"
@page "/workspace"
@layout KayanERP.UI.Pages.EmptyLayout
@inject NavigationManager Navigation

<PageTitle>منصة كيان المركزية - لوحة التحكم الشاملة (Enterprise Command Center)</PageTitle>

<div class="kayan-command-viewport" dir="rtl">
    <!-- خلفية الشبكة الهندسية العصبية -->
    <div class="network-canvas-bg"></div>

    <!-- 1. الشريط التنفيذي العلوي -->
    <header class="top-command-bar">
        <div class="d-flex align-items-center gap-3">
            <div class="brand-tag-box">
                <span class="brand-tag">KAYAN</span>
                <span class="brand-sub">ENTERPRISE</span>
            </div>
            <div class="tenant-tag">
                <span class="live-status-pulse"></span>
                <span>مجموعة حلواني أبو عادل • بيئة التشغيل الصناعي الموحدة</span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="quick-stats-badge">
                <span class="text-muted small">إجمالي القطاعات:</span>
                <span class="text-warning fw-bold font-monospace">10 قطاعات</span>
                <span class="text-muted small ms-1">| 35 موديول نشط</span>
            </div>
            <button class="logout-btn" @onclick='() => NavigateTo("/login")' title="تسجيل الخروج">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                <span>خروج</span>
            </button>
        </div>
    </header>

    <!-- 2. منطقة البحث والفلترة السريعة -->
    <div class="search-command-area container-fluid px-4 pt-4">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">
                <div class="search-input-wrapper shadow-lg">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="search-input" 
                           placeholder="ابحث فوراً بالاسم عن أي شاشة أو وظيفة (مثال: فواتير، كارت الصنف، أجور، خزينة، نزاع، خامات، وصفات)..." 
                           @bind="searchTerm" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="clear-search-btn" @onclick='() => searchTerm = ""'>✕</button>
                    }
                </div>

                <!-- أزرار الفلترة السريعة للقطاعات -->
                <div class="category-pills-bar mt-3 d-flex flex-wrap justify-content-center gap-2">
                    <button class="filter-pill @(selectedCategory == "ALL" ? "active" : "")" @onclick='() => selectedCategory = "ALL"'>
                        🌐 كافة القطاعات
                    </button>
                    <button class="filter-pill @(selectedCategory == "MES" ? "active" : "")" @onclick='() => selectedCategory = "MES"'>
                        🏭 الإنتاج والتصنيع
                    </button>
                    <button class="filter-pill @(selectedCategory == "SCM" ? "active" : "")" @onclick='() => selectedCategory = "SCM"'>
                        🚚 المخازن واللوجستيات
                    </button>
                    <button class="filter-pill @(selectedCategory == "SALES" ? "active" : "")" @onclick='() => selectedCategory = "SALES"'>
                        🧾 المبيعات والفروع
                    </button>
                    <button class="filter-pill @(selectedCategory == "FINANCE" ? "active" : "")" @onclick='() => selectedCategory = "FINANCE"'>
                        💵 الإدارة المالية
                    </button>
                    <button class="filter-pill @(selectedCategory == "PROCUREMENT" ? "active" : "")" @onclick='() => selectedCategory = "PROCUREMENT"'>
                        📦 المشتريات والموردين
                    </button>
                    <button class="filter-pill @(selectedCategory == "HR" ? "active" : "")" @onclick='() => selectedCategory = "HR"'>
                        👥 الموارد البشرية
                    </button>
                    <button class="filter-pill @(selectedCategory == "QUALITY" ? "active" : "")" @onclick='() => selectedCategory = "QUALITY"'>
                        🔬 الجودة وHACCP
                    </button>
                    <button class="filter-pill @(selectedCategory == "EMERGENCY" ? "active" : "")" @onclick='() => selectedCategory = "EMERGENCY"'>
                        🚨 الطوارئ والـ SOS
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. شبكة قطاعات وموديولات المنظومة -->
    <main class="container-fluid px-4 py-4">
        <div class="row g-4">

            <!-- 1. قطاع الإنتاج والعمليات الصناعية (MES) -->
            @if (IsVisible("MES", "الإنتاج التصنيع تشغيل غرف عمليات وصفات BOM خامات كتالوج تحويل"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-amber">
                        <div class="domain-header">
                            <div class="domain-icon-box text-warning">
                                <i class="bi bi-cpu-fill fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">العمليات الصناعية والتشغيل (MES)</h5>
                                <span class="domain-subtitle">إدارة أوامر التصنيع، وصفات الخلط، والتحويل</span>
                            </div>
                        </div>
                        <div class="domain-links-list">
                            <button class="module-link-btn highlight-link" @onclick='() => NavigateTo("/production-operations-hub")'>
                                <i class="bi bi-speedometer2"></i>
                                <span>غرفة عمليات الإنتاج والتكاليف</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/finished-goods-transfer")'>
                                <i class="bi bi-truck-flatbed"></i>
                                <span>تحويل وتسليم المنتج التام (المراحل الخمس)</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/recipes")'>
                                <i class="bi bi-journal-bookmark"></i>
                                <span>وصفات التصنيع المعيارية (BOM)</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/material-requisitions")'>
                                <i class="bi bi-cart-check"></i>
                                <span>طلب وصرف خامات صالة التشغيل</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/finished-goods-catalog")'>
                                <i class="bi bi-cake2"></i>
                                <span>كتالوج المنتجات التامة والمواصفات</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 2. قطاع المستودعات وسلاسل الإمداد اللوجستية -->
            @if (IsVisible("SCM", "المخازن المستودعات أرصدة كارت الصنف إمداد الفروع شحنات خامات أصول حاويات"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-cyan">
                        <div class="domain-header">
                            <div class="domain-icon-box text-info">
                                <i class="bi bi-boxes fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">المخازن وسلاسل الإمداد اللوجستية</h5>
                                <span class="domain-subtitle">الأرصدة اللحظية، تتبع اللوطات، وتحويلات الفروع</span>
                            </div>
                        </div>
                        <div class="domain-links-list">
                            <button class="module-link-btn highlight-link" @onclick='() => NavigateTo("/stock-balances")'>
                                <i class="bi bi-graph-up-arrow"></i>
                                <span>أرصدة المخازن اللحظية والرقابة</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/stock-card")'>
                                <i class="bi bi-card-list"></i>
                                <span>كارت الصنف والمسار المخزني التراكمي</span>
                            </button>
                            <button class="module-link-btn highlight-link-amber" @onclick='() => NavigateTo("/branch-transfers")'>
                                <i class="bi bi-truck"></i>
                                <span>إمداد الفروع واستلام المنافذ ولجنة النزاع</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/material-receipt")'>
                                <i class="bi bi-box-arrow-in-down"></i>
                                <span>فحص واستلام الخامات الموردة (GMP)</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/warehouses")'>
                                <i class="bi bi-house-door"></i>
                                <span>إدارة وتعريف المستودعات والصالات</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/asset-management")'>
                                <i class="bi bi-tools"></i>
                                <span>حوكمة الأصول الثابتة والماكينات</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/crate-tracking")'>
                                <i class="bi bi-arrow-repeat"></i>
                                <span>تتبع دوران وحركة الصناديق والأسبات</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 3. قطاع المبيعات والتوزيع وإدارة الفروع -->
            @if (IsVisible("SALES", "المبيعات الفروع فواتير العملاء التجار منافذ الكاشير توزيع"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-emerald">
                        <div class="domain-header">
                            <div class="domain-icon-box text-success">
                                <i class="bi bi-shop fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">المبيعات والتوزيع وشبكة الفروع</h5>
                                <span class="domain-subtitle">الفواتير اللحظية، حسابات العملاء، ونقاط البيع</span>
                            </div>
                        </div>
                        <div class="domain-links-list">
                            <button class="module-link-btn highlight-link-emerald" @onclick='() => NavigateTo("/branches-portal")'>
                                <i class="bi bi-grid-3x3-gap-fill"></i>
                                <span>بوابة الفروع والعمليات (سياق التشغيل المعزول)</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/sales-invoices")'>
                                <i class="bi bi-receipt"></i>
                                <span>إدارة فواتير المبيعات والترحيل المالي المباشر</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/customers")'>
                                <i class="bi bi-people-fill"></i>
                                <span>سجل العملاء والتجار ومديونيات المنافذ</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/branches")'>
                                <i class="bi bi-building"></i>
                                <span>إدارة بيانات الفروع ومنافذ المعارض</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 4. قطاع الإدارة المالية والحسابات العامة -->
            @if (IsVisible("FINANCE", "المالية الحسابات شجرة الخزينة سندات قيود يومية مصروفات قوائم أرباح"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-purple">
                        <div class="domain-header">
                            <div class="domain-icon-box text-purple">
                                <i class="bi bi-bank2 fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">الإدارة المالية والمحاسبة العامة</h5>
                                <span class="domain-subtitle">دليل الحسابات، الخزائن، والقيود الآلية المزدوجة</span>
                            </div>
                        </div>
                        <div class="domain-links-list">
                            <button class="module-link-btn" @onclick='() => NavigateTo("/chart-of-accounts")'>
                                <i class="bi bi-diagram-3"></i>
                                <span>شجرة الحسابات ودليل المركز المالي</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/treasury-vouchers")'>
                                <i class="bi bi-cash-coin"></i>
                                <span>سندات القبض والصرف وخزائن الفروع</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/journal-entries")'>
                                <i class="bi bi-book-half"></i>
                                <span>دفتر قيود اليومية العامة والأستاذ</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/expenses-payables")'>
                                <i class="bi bi-wallet2"></i>
                                <span>مصروفات التشغيل، الغاز، ومستحقات الموردين</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/financial-statements")'>
                                <i class="bi bi-graph-up"></i>
                                <span>القوائم المالية وميزان المراجعة والأرباح</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 5. قطاع إدارة الأصناف والمواد الخام -->
            @if (IsVisible("SCM", "الأصناف المواد خامات هيكل تصنيفات كود"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-blue">
                        <div class="domain-header">
                            <div class="domain-icon-box text-primary">
                                <i class="bi bi-box-seam-fill fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">دليل الأصناف والخامات المعيارية</h5>
                                <span class="domain-subtitle">بطاقات الأصناف، التسعير، والهيكل الشجري</span>
                            </div>
                        </div>
                        <div class="domain-links-list">
                            <button class="module-link-btn highlight-link" @onclick='() => NavigateTo("/items")'>
                                <i class="bi bi-boxes"></i>
                                <span>مركز إدارة الأصناف والأسعار الشامل</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/item-hierarchy")'>
                                <i class="bi bi-diagram-2"></i>
                                <span>الهيكل الشجري للأصناف والخامات</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/item-categories")'>
                                <i class="bi bi-tags"></i>
                                <span>تصنيفات وبنود المجموعات السلعية</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 6. قطاع المشتريات وإدارة الموردين -->
            @if (IsVisible("PROCUREMENT", "المشتريات الموردين أوامر الشراء PO فواتير الشراء أسعار التوريد تقييم"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-indigo">
                        <div class="domain-header">
                            <div class="domain-icon-box text-indigo">
                                <i class="bi bi-truck fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">إدارة المشتريات والموردين</h5>
                                <span class="domain-subtitle">أوامر التوريد، التسعير، وتقييم جودة الموردين</span>
                            </div>
                        </div>
                        <div class="domain-links-list">
                            <button class="module-link-btn" @onclick='() => NavigateTo("/suppliers")'>
                                <i class="bi bi-person-lines-fill"></i>
                                <span>سجل الموردين المعتمدين وبياناتهم</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/purchase-orders")'>
                                <i class="bi bi-file-earmark-text"></i>
                                <span>أوامر الشراء والتوريد (Purchase Orders)</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/purchase-invoices")'>
                                <i class="bi bi-receipt-cutoff"></i>
                                <span>فواتير الشراء والتكاليف المباشرة</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/supplier-prices")'>
                                <i class="bi bi-tags-fill"></i>
                                <span>قوائم أسعار التوريد وعروض الأسعار</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/supplier-quality")'>
                                <i class="bi bi-patch-check-fill text-success"></i>
                                <span>تقييم جودة الموردين والشهادات (COA)</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 7. قطاع الجودة والنماذج الرقمية (HACCP) -->
            @if (IsVisible("QUALITY", "الجودة النماذج محاضر الفحص HACCP استمارات تفتيش معمل"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-teal">
                        <div class="domain-header">
                            <div class="domain-icon-box text-teal">
                                <i class="bi bi-ui-checks-grid fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">منظومة الجودة ونماذج التفتيش (HACCP)</h5>
                                <span class="domain-subtitle">تصميم الاستمارات، الفحص الميداني، ومحاضر الجودة</span>
                            </div>
                        </div>
                        <div class="domain-links-list">
                            <button class="module-link-btn" @onclick='() => NavigateTo("/dynamic-forms")'>
                                <i class="bi bi-sliders"></i>
                                <span>مصمم وإدارة النماذج التفاعلية</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/form-viewer")'>
                                <i class="bi bi-pencil-square"></i>
                                <span>تعبئة نماذج الفحص الميداني والمعملي</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/form-reports")'>
                                <i class="bi bi-file-earmark-spreadsheet"></i>
                                <span>تقارير واستجابات نماذج الجودة</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 8. قطاع الطوارئ والتدخل السريع (SOS) -->
            @if (IsVisible("EMERGENCY", "الطوارئ الأعطال SOS التدخل السريع بلاغات SLA صيانة"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-rose">
                        <div class="domain-header">
                            <div class="domain-icon-box text-danger">
                                <i class="bi bi-bell-fill fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">منظومة الطوارئ والأعطال (SOS Hub)</h5>
                                <span class="domain-subtitle">البلاغات الفورية، استجابة الصيانة، ومؤشرات SLA</span>
                            </div>
                        </div>
                        <div class="domain-links-list">
                            <button class="module-link-btn highlight-link-rose" @onclick='() => NavigateTo("/emergency-tasks")'>
                                <i class="bi bi-exclamation-octagon-fill"></i>
                                <span>غرفة المهام الطارئة والأعطال (SOS)</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/emergency-tasks-reports")'>
                                <i class="bi bi-bar-chart-line-fill"></i>
                                <span>تقارير مؤشرات سرعة الاستجابة (SLA)</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 9. قطاع الموارد البشرية وإدارة الهيكل (HR) -->
            @if (IsVisible("HR", "الموارد البشرية العاملين الموظفين الورديات الشركات الأقسام الهيكل"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-slate">
                        <div class="domain-header">
                            <div class="domain-icon-box text-secondary">
                                <i class="bi bi-people fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">الموارد البشرية والهيكل الإداري</h5>
                                <span class="domain-subtitle">بيانات الكيانات، الصالات، والورديات وجدولة العمال</span>
                            </div>
                        </div>
                        <div class="domain-links-list">
                            <button class="module-link-btn" @onclick='() => NavigateTo("/companies")'>
                                <i class="bi bi-buildings"></i>
                                <span>إدارة الشركات والكيانات القانونية</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/departments")'>
                                <i class="bi bi-diagram-3-fill"></i>
                                <span>إدارة الأقسام وصالات التشغيل</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/employees")'>
                                <i class="bi bi-person-badge"></i>
                                <span>سجل العاملين وملفات الموظفين</span>
                            </button>
                            <button class="module-link-btn" @onclick='() => NavigateTo("/employees-management")'>
                                <i class="bi bi-calendar-check"></i>
                                <span>جدولة وتوزيع الورديات اليومية</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- 10. قطاع التقارير والأمان وإعدادات النظام (Admin & KPIs) -->
            @if (IsVisible("ALL", "التقارير المؤشرات KPIs المستخدمين الصلاحيات الأمان الإعدادات"))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="domain-card h-100 border-start-zinc">
                        <div class="domain-header">
                            <div class="domain-icon-box text-light">
                                <i class="bi bi-shield-lock-fill fs-4"></i>
                            </div>
                            <div>
                                <h5 class="domain-title">التحليلات الذكية وأمن المنظومة (RBAC)</h5>
